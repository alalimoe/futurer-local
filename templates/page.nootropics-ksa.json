    "ksa_arabic": {
      "type": "ksa-arabic",
      "blocks": {
        "ar_shipping": {
          "type": "faq",
          "settings": {
            "question": "هل تشحن نوتروبيكس إلى السعودية؟",
            "answer": "<p>نعم. تُشحن الطلبات من دبي إلى عناوين المملكة العربية السعودية عبر الشحن السريع.</p>"
          }
        },
        "ar_time": {
          "type": "faq",
          "settings": {
            "question": "كم يستغرق التوصيل إلى السعودية؟",
            "answer": "<p>يستغرق التوصيل ٣ أيام في المتوسط بعد شحن الطلب في اليوم نفسه. هذه مدة متوسطة وليست ضماناً، وقد تختلف حسب الوجهة ووقت الطلب.</p>"
          }
        },
        "ar_free": {
          "type": "faq",
          "settings": {
            "question": "متى يكون الشحن السريع مجانياً؟",
            "answer": "<p>يكون الشحن السريع إلى السعودية مجانياً عندما تبلغ قيمة الطلب ٣٠٠ ريال سعودي أو أكثر.</p>"
          }
        },
        "ar_location": {
          "type": "faq",
          "settings": {
            "question": "هل لدى نوتروبيكس متجر أو مستودع في السعودية؟",
            "answer": "<p>لا. نوتروبيكس متجر إلكتروني مقره دبي، وتُشحن طلبات السعودية من دبي.</p>"
          }
        },
        "ar_definition": {
          "type": "faq",
          "settings": {
            "question": "ما هي النوتروبيكس؟",
            "answer": "<p>النوتروبيكس مصطلح عام لمنتجات يضيفها بعض الأشخاص إلى روتين يرتبط بالتركيز أو الذاكرة أو المزاج أو الطاقة أو النوم أو العافية طويلة المدى. تختلف المنتجات حسب المكونات والشكل.</p>"
          }
        },
        "ar_choose": {
          "type": "faq",
          "settings": {
            "question": "كيف أختار المنتج؟",
            "answer": "<p>ابدأ بهدف واحد واضح، وقارن قائمة المكونات الكاملة وإرشادات الاستخدام والتحذيرات والسعر والتوفر الحالي، ثم اتبع تعليمات ملصق المنتج.</p>"
          }
        },
        "ar_coa": {
          "type": "faq",
          "settings": {
            "question": "هل تتوفر شهادات التحليل؟",
            "answer": "<p>تتوفر شهادات التحليل للمنتجات المؤهلة. راجع مكتبة الشهادات أو تواصل مع الدعم للحصول على معلومات خاصة بالمنتج.</p>"
          }
        },
        "ar_advice": {
          "type": "faq",
          "settings": {
            "question": "هل هذه الصفحة نصيحة طبية؟",
            "answer": "<p>لا. هذه الصفحة للتثقيف فقط وليست نصيحة طبية. استشر مختصاً صحياً مؤهلاً عند الحاجة إلى إرشاد طبي شخصي.</p>"
          }
        }
      },
