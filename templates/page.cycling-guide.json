        "127774dfc34a41ab": {
          "type": "rule",
          "settings": {
            "title": "Start low and go slow.",
            "body": "Begin at the low end of a suggested range and hold it there long enough to judge honestly."
          }
        },
        "9c3123c26b1d4609": {
          "type": "rule",
          "settings": {
            "title": "Days-per-week beats days-in-a-row.",
            "body": "For tolerance-prone compounds, two or three non-consecutive days per week preserves response far better than the same number of consecutive days."
          }
        },
        "48d89618e85c46e1": {
          "type": "rule",
          "settings": {
            "title": "Off-days are part of the protocol, not a failure of it.",
            "body": "If skipping a day feels difficult, that is itself useful information. Treat it as a signal to extend the break, not shorten it."
          }
        },
        "9baf284636fc4da9": {
          "type": "rule",
          "settings": {
            "title": "One new compound at a time.",
            "body": "If you change two things at once, you cannot tell which one did what."
          }
        },
