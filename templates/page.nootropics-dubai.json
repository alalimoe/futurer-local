    "dubai_arabic": {
      "type": "dubai-arabic",
      "blocks": {
        "ar_shipping": {
          "type": "faq",
          "settings": {
            "question": "\u0647\u0644 \u062a\u0648\u0635\u0644\u0648\u0646 \u062f\u0627\u062e\u0644 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\u061f",
            "answer": "<p>\u0646\u0639\u0645. \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0645\u062d\u0644\u064a \u062f\u0627\u062e\u0644 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0645\u062c\u0627\u0646\u064a\u060c \u0633\u0648\u0627\u0621 \u0643\u0627\u0646 \u062a\u0648\u0635\u064a\u0644\u0627\u064b \u062e\u0644\u0627\u0644 \u0664 \u0633\u0627\u0639\u0627\u062a \u062f\u0627\u062e\u0644 \u062f\u0628\u064a \u0623\u0648 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062a\u0627\u0644\u064a \u0644\u0628\u0627\u0642\u064a \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0641\u064a \u0623\u063a\u0644\u0628 \u0627\u0644\u062d\u0627\u0644\u0627\u062a.</p>"
          }
        },
        "ar_time": {
          "type": "faq",
          "settings": {
            "question": "\u0643\u0645 \u064a\u0633\u062a\u063a\u0631\u0642 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u062f\u0627\u062e\u0644 \u062f\u0628\u064a\u061f",
            "answer": "<p>\u063a\u0627\u0644\u0628\u0627\u064b \u062e\u0644\u0627\u0644 \u0664 \u0633\u0627\u0639\u0627\u062a \u062d\u0633\u0628 \u0648\u0642\u062a \u0627\u0644\u0637\u0644\u0628 \u0648\u0627\u0644\u0645\u0648\u0642\u0639. \u0647\u0630\u0647 \u0645\u062f\u0629 \u0645\u0639\u062a\u0627\u062f\u0629 \u0648\u0644\u064a\u0633\u062a \u0636\u0645\u0627\u0646\u0627\u064b.</p>"
          }
        },
        "ar_free": {
          "type": "faq",
          "settings": {
            "question": "\u0647\u0644 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0645\u062d\u0644\u064a \u0645\u062c\u0627\u0646\u064a\u061f",
            "answer": "<p>\u0646\u0639\u0645. \u0643\u0644 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0627\u0644\u0645\u062d\u0644\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0645\u062c\u0627\u0646\u064a\u0629.</p>"
          }
        },
        "ar_location": {
          "type": "faq",
          "settings": {
            "question": "\u0647\u0644 \u062a\u0634\u062d\u0646\u0648\u0646 \u062f\u0648\u0644\u064a\u0627\u064b\u061f",
            "answer": "<p>\u0646\u0639\u0645. \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u062f\u0648\u0644\u064a \u0627\u0644\u0633\u0631\u064a\u0639 \u0645\u062a\u0627\u062d \u0645\u0639 \u0627\u0644\u062a\u062a\u0628\u0639. \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0633\u0631\u064a\u0639 \u0645\u062c\u0627\u0646\u064a \u0644\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062f\u0648\u0644\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u062a\u062c\u0627\u0648\u0632 \u0663\u0660\u0660 \u062f\u0631\u0647\u0645.</p>"
          }
        },
        "ar_definition": {
          "type": "faq",
          "settings": {
            "question": "\u0645\u0627 \u0647\u064a \u0627\u0644\u0646\u0648\u062a\u0631\u0648\u0628\u064a\u0643\u0633\u061f",
            "answer": "<p>\u0627\u0644\u0646\u0648\u062a\u0631\u0648\u0628\u064a\u0643\u0633 \u0645\u0635\u0637\u0644\u062d \u0639\u0627\u0645 \u0644\u0645\u0646\u062a\u062c\u0627\u062a \u064a\u0636\u064a\u0641\u0647\u0627 \u0628\u0639\u0636 \u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u0625\u0644\u0649 \u0631\u0648\u062a\u064a\u0646 \u064a\u0631\u062a\u0628\u0637 \u0628\u0627\u0644\u062a\u0631\u0643\u064a\u0632 \u0623\u0648 \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0623\u0648 \u0627\u0644\u0645\u0632\u0627\u062c \u0623\u0648 \u0627\u0644\u0637\u0627\u0642\u0629 \u0623\u0648 \u0627\u0644\u0646\u0648\u0645 \u0623\u0648 \u0627\u0644\u0639\u0627\u0641\u064a\u0629 \u0637\u0648\u064a\u0644\u0629 \u0627\u0644\u0645\u062f\u0649. \u062a\u062e\u062a\u0644\u0641 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u062d\u0633\u0628 \u0627\u0644\u0645\u0643\u0648\u0646\u0627\u062a \u0648\u0627\u0644\u0634\u0643\u0644.</p>"
          }
        },
        "ar_choose": {
          "type": "faq",
          "settings": {
            "question": "\u0643\u064a\u0641 \u0623\u062e\u062a\u0627\u0631 \u0627\u0644\u0645\u0646\u062a\u062c\u061f",
            "answer": "<p>\u0627\u0628\u062f\u0623 \u0628\u0647\u062f\u0641 \u0648\u0627\u062d\u062f \u0648\u0627\u0636\u062d\u060c \u0648\u0642\u0627\u0631\u0646 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0643\u0648\u0646\u0627\u062a \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0648\u0625\u0631\u0634\u0627\u062f\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u0627\u0644\u062a\u062d\u0630\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0633\u0639\u0631 \u0648\u0627\u0644\u062a\u0648\u0641\u0631 \u0627\u0644\u062d\u0627\u0644\u064a\u060c \u062b\u0645 \u0627\u062a\u0628\u0639 \u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0645\u0644\u0635\u0642 \u0627\u0644\u0645\u0646\u062a\u062c.</p>"
          }
        },
        "ar_coa": {
          "type": "faq",
          "settings": {
            "question": "\u0647\u0644 \u062a\u062a\u0648\u0641\u0631 \u0634\u0647\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u062d\u0644\u064a\u0644\u061f",
            "answer": "<p>\u062a\u062a\u0648\u0641\u0631 \u0634\u0647\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0644\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0645\u0624\u0647\u0644\u0629. \u0631\u0627\u062c\u0639 \u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0634\u0647\u0627\u062f\u0627\u062a \u0623\u0648 \u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0627\u0644\u062f\u0639\u0645 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062e\u0627\u0635\u0629 \u0628\u0627\u0644\u0645\u0646\u062a\u062c.</p>"
