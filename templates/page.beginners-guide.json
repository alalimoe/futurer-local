      "blocks": {
        "faq_stacks_1": {
          "type": "faq",
          "settings": {
            "question": "Should a beginner start with a stack?",
            "answer": "<p>No universal stack is appropriate for every person. Starting with several products makes interactions and unwanted effects harder to assess. Review one label and one evidence question at a time.</p>"
          }
        },
        "faq_stacks_2": {
          "type": "faq",
          "settings": {
            "question": "Does this guide provide a dose or cycle?",
            "answer": "<p>No. Follow the current product label and ask a qualified healthcare professional when medication, a health condition, pregnancy or nursing, age, or another contraindication is relevant.</p>"
          }
        },
        "faq_stacks_3": {
          "type": "faq",
          "settings": {
            "question": "Which interactions deserve extra attention?",
            "answer": "<p>Interactions depend on the specific ingredient and person. Ask about prescription and over-the-counter medicines, including antidepressants, stimulants, sedatives, anticoagulants, and blood-pressure medicines.</p>"
          }
        }
      },
