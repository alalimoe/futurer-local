    "nx01_faqs": {
      "type": "nx01-faqs",
      "blocks": {
        "faq_1": {
          "type": "question",
          "settings": {
            "question": "What is NX-01 Baseline?",
            "answer": "<p>NX-01 is Nootropix’s caffeine-free daily supplement for adults. It combines nine ingredients in one formula: ALCAR, citicoline, NMN, L-theanine, Rhodiola, CoQ10, vitamin B6, vitamin B12 and folate.</p>",
            "open_by_default": false
          }
        },
        "faq_2": {
          "type": "question",
          "settings": {
            "question": "How do I take it?",
            "answer": "<p>The labelled daily serving is <strong>3 capsules</strong>. Follow the directions and precautions on your bottle, and do not exceed the stated serving.</p>",
            "open_by_default": false
          }
        },
        "faq_3": {
          "type": "question",
          "settings": {
            "question": "How long will one bottle last?",
            "answer": "<p>Each bottle contains <strong>90 capsules — 30 daily servings</strong> at 3 capsules per serving.</p>",
            "open_by_default": false
          }
        },
        "faq_4": {
          "type": "question",
          "settings": {
            "question": "Does NX-01 contain caffeine?",
            "answer": "<p>No. NX-01 is a caffeine-free formula.</p>",
            "open_by_default": false
          }
        },
        "faq_5": {
          "type": "question",
          "settings": {
            "question": "What results should I expect?",
            "answer": "<p>Responses vary, and there is no guaranteed effect or time to notice a change. Research on individual ingredients does not establish the effect of the finished NX-01 formula.</p>",
            "open_by_default": false
          }
        },
        "faq_6": {
          "type": "question",
          "settings": {
            "question": "Can I combine it with my current supplements?",
            "answer": "<p>Check for overlapping ingredients before adding NX-01, especially if you already take a multivitamin or individual nootropics. Compare the amounts on both labels and ask a pharmacist or healthcare professional to review the combination.</p>",
            "open_by_default": false
          }
        },
        "faq_7": {
          "type": "question",
          "settings": {
            "question": "Are there any side effects?",
            "answer": "<p>Side effects are possible, and individual reactions vary. If you notice an unwanted reaction, stop taking NX-01 and contact a healthcare professional. Seek urgent care for severe symptoms.</p><p><a href=\"https://www.nccih.nih.gov/health/using-dietary-supplements-wisely\" target=\"_blank\" rel=\"noopener\">Read independent supplement safety guidance.</a></p>",
            "open_by_default": false
          }
        },
        "faq_8": {
          "type": "question",
          "settings": {
            "question": "Can I take it with medication?",
            "answer": "<p>Ask your doctor or pharmacist before starting NX-01 if you take prescription or over-the-counter medicine. Show them the full ingredient label so they can check for interactions. Do not change prescribed treatment to take NX-01.</p>",
            "open_by_default": false
          }
        },
        "faq_9": {
          "type": "question",
          "settings": {
            "question": "Is NX-01 suitable for everyone?",
            "answer": "<p>NX-01 is intended for adults. If you are pregnant, breastfeeding, have a medical condition or have surgery planned, speak to your healthcare professional before use. Check the complete label for ingredients you need to avoid.</p>",
            "open_by_default": false
          }
        },
        "faq_10": {
          "type": "question",
          "settings": {
            "question": "Can I adjust the individual ingredient doses?",
            "answer": "<p>NX-01 has fixed ingredient proportions. Taking fewer capsules lowers every ingredient together; it does not let you change one ingredient on its own. Separate products offer more flexibility if you need to adjust individual amounts.</p>",
            "open_by_default": false
          }
        },
        "faq_11": {
          "type": "question",
          "settings": {
            "question": "How should I store it?",
            "answer": "<p>Follow the storage instructions on your bottle. Keep it in its original container, close the lid firmly after use and keep it out of reach of children.</p>",
            "open_by_default": false
          }
        }
      },
