    "phenibut_what_is": {
      "type": "phenibut-what-is",
      "name": "What is Phenibut",
      "settings": {
        "anchor_id": "what-is-phenibut",
        "heading": "What is Phenibut?",
        "definition": "<p>Phenibut is a derivative of the neurotransmitter GABA. It's designed to support calm, social ease, and sleep quality when used <strong>occasionally</strong> and responsibly. It commonly comes as <strong>FAA</strong> (free amino acid) and <strong>HCl</strong> forms.</p>",
        "show_basics": false,
        "scientific_body": "<p><strong>Compound:</strong> \u03b2\u2011phenyl\u2011\u03b3\u2011aminobutyric acid. The phenyl ring helps it cross the blood\u2013brain barrier more readily than GABA itself. Primary action is at <strong>GABA\u2011B receptors</strong>, which can moderate excitability and promote relaxation. Onset is typically 1\u20133 hours with effects that may last several hours; timing varies by form and individual. Common forms: <strong>HCl</strong> (highly water\u2011soluble; faster to mix) and <strong>FAA</strong> (free amino acid; neutral taste when encapsulated). Avoid combining with alcohol, benzodiazepines, or other sedatives.</p><ul><li><strong>Mechanism:</strong> GABA\u2011B receptor agonism (with minimal GABA\u2011A activity).</li><li><strong>Rationale:</strong> Phenyl group increases lipophilicity (BBB permeability).</li><li><strong>Forms:</strong> FAA vs HCl differ mainly in solubility and handling; potency per mg can feel similar when dosed equivalently.</li></ul><p><em>Informational only. Not medical advice.</em></p>",
        "scientific_collapsed": true,
        "molecule_alt": "Phenibut molecule diagram",
        "molecule_decorative": false,
        "hide_image_mobile": false,
        "max_width": 1200,
        "center_on_mobile": false,
        "show_note": true,
        "note_text": "This content is educational and not medical advice. Phenibut is for adult, occasional use only. Do not combine with alcohol or sedatives. Use responsibly.",
        "padding_top": 96,
        "padding_bottom": 96,
        "kicker": "The basics",
        "color_scheme": "background-1"
      }
    },
