    "compound_faq": {
      "type": "compound-faq",
      "blocks": {
        "qa_hcl_faa": {
          "type": "qa",
          "settings": {
            "group": "product",
            "question": "What is the difference between HCl and FAA?",
            "answer": "<p>HCl is the hydrochloride salt and mixes more readily with water. FAA is the free amino acid form and is less water-soluble. They are different chemical forms, not a ranking of strength.</p>"
          }
        },
        "qa_capsules_powder": {
          "type": "qa",
          "settings": {
            "group": "product",
            "question": "What is the difference between capsules and powder?",
            "answer": "<p>Capsules and powder are product formats. Check the product page and the pack for the labeled amount, count or net weight.</p>"
          }
        },
        "qa_label": {
          "type": "qa",
          "settings": {
            "group": "product",
            "question": "Where do I find pack and label information?",
            "answer": "<p>Open the product page for the current label details. The pack itself is the source for amount, count and batch information.</p>"
          }
        },
        "qa_docs": {
          "type": "qa",
          "settings": {
            "group": "product",
            "question": "How do I view batch documentation?",
            "answer": "<p>A signed BT Labs report for a Phenibut HCl sample is in <a href=\"#compound-quality\">Check the details behind the product</a>. That report is for the sample received, not a finished pack. Use the <a href=\"/pages/quality-and-trust-certificate-of-analysis\">quality and COA library</a> or request a document if you need a report for another form or pack.</p>"
          }
        },
        "qa_risks": {
          "type": "qa",
          "settings": {
            "group": "safety",
            "question": "What are the main risks?",
            "answer": "<p>Phenibut carries risks of dependence, withdrawal and sedation. Read the <a href=\"#safety\">safety information</a> before you choose.</p>"
          }
        },
        "qa_alcohol": {
          "type": "qa",
          "settings": {
            "group": "safety",
            "question": "Can I take Phenibut with alcohol or sedatives?",
            "answer": "<p>No. Do not combine Phenibut with alcohol, benzodiazepines or other sedatives.</p>"
          }
        },
        "qa_clinician": {
          "type": "qa",
          "settings": {
            "group": "safety",
            "question": "When should I speak with a clinician?",
            "answer": "<p>Speak with a clinician before use if you have a medical condition, take other medicines, or have used Phenibut regularly. Do not stop established regular use suddenly without medical guidance.</p>"
          }
        },
        "qa_delivery": {
          "type": "qa",
          "settings": {
            "group": "ordering",
            "question": "How fast is delivery?",
            "answer": "<p>Dubai: 4-hour delivery if you order by 6pm. Rest of the UAE: next-day. International orders ship with Aramex tracking from Dubai. See <a href=\"#compound-delivery\">delivery details</a>.</p>"
          }
        },
