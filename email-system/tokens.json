{
  "name": "Nootropix Email Design System",
  "version": "1.0.0",
  "source": "welcome-series email (canonical)",
  "colors": {
    "canvas": { "light": "#ECEDE9", "dark": "#0E0F0D", "use": "Full email background" },
    "shell": { "light": "#F9FAF7", "dark": "#151613", "use": "600px email container" },
    "heading": { "light": "#11120F", "dark": "#F3F4EF", "use": "Headlines and strong labels" },
    "text": { "light": "#30312E", "dark": "#F3F4EF", "use": "Primary copy" },
    "muted": { "light": "#74766F", "dark": "#A7A9A2", "use": "Notes, metadata" },
    "footerMuted": { "light": "#8B8E86", "dark": "#A7A9A2", "use": "Footer legal copy" },
    "footerLink": { "light": "#5D6059", "dark": "#A7A9A2", "use": "Footer domain link" },
    "yellow": { "light": "#FFD007", "dark": "#FFD007", "use": "Eyebrow chips, CTA accent bar" },
    "softCard": { "light": "#F7F8F5", "dark": "#272825", "use": "Soft panels and proof blocks" },
    "softCardBorder": { "light": "#E1E3DD", "dark": "#363832", "use": "Soft card borders and rules" },
    "cardInner": { "light": "#FFFFFF", "dark": "#1D1E1B", "use": "White goal/product cards" },
    "cardInnerBorder": { "light": "#E1E3DD", "dark": "#343630", "use": "White card borders" },
    "yellowCard": { "light": "#FFF7D3", "dark": "#342F16", "use": "Priority notes and offers" },
    "yellowCardBorder": { "light": "#EFD56A", "dark": "#66591C", "use": "Yellow card border" },
    "link": { "light": "#2B16B7", "dark": "#A9A2FF", "use": "Underlined text links" },
    "ctaBg": { "light": "#151613", "dark": "#FFD007", "use": "Primary button background" },
    "ctaFg": { "light": "#FFFFFF", "dark": "#11120F", "use": "Primary button text" },
    "headerMeta": { "light": "#666666", "dark": "#A7A9A2", "use": "Delivery badge text" }
  },
  "typography": {
    "fontFamily": "Lexend, -apple-system, BlinkMacSystemFont, Segoe UI, Arial, sans-serif",
    "heroMobile": { "size": "31px", "lineHeight": "1.12", "weight": 700 },
    "heroDesktop": { "size": "38px", "lineHeight": "1.08", "weight": 700 },
    "sectionTitle": { "size": "20px", "lineHeight": "1.25", "weight": 700 },
    "body": { "size": "16px", "lineHeight": "1.65", "weight": 400 },
    "label": { "size": "10px", "lineHeight": "1", "weight": 700, "letterSpacing": "1px", "transform": "uppercase" },
    "footer": { "size": "11px", "lineHeight": "1.6", "weight": 400 },
    "footerLegal": { "size": "10px", "lineHeight": "1.6", "weight": 400 }
  },
  "spacing": {
    "maxWidth": "600px",
    "outerDesktop": "14px",
    "outerMobile": "0px",
    "shellRadius": "18px",
    "gutterMobile": "22px",
    "gutterDesktop": "36px",
    "headerTop": "20px",
    "headerDividerGap": "16px",
    "heroGap": "30px",
    "sectionGap": "36px",
    "cardRadius": "16px",
    "cardInnerRadius": "18px",
    "ctaRadius": "12px",
    "ctaPaddingV": "14px",
    "ctaPaddingH": "22px",
    "ctaAccentWidth": "5px",
    "chipPadding": "7px 9px",
    "chipRadius": "8px",
    "chipRadiusSmall": "6px"
  },
  "assets": {
    "logoUrl": "https://cdn.shopify.com/s/files/1/0700/6883/0404/files/Logo_a363b63c-0bb9-42a0-b1c7-96d85b2467d2.png?v=1780099409",
    "logoWidth": 132,
    "logoHeight": 28,
    "storeUrl": "https://nootropix.ae"
  },
  "klaviyo": {
    "unsubscribe": "{% unsubscribe 'Unsubscribe' %}",
    "managePreferences": "{% manage_preferences 'Manage preferences' %}"
  },
  "utmDefaults": {
    "source": "klaviyo",
    "medium": "email"
  }
}
