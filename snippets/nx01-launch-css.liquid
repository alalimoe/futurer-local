{% doc %}
Shared NX-01 launch tokens and utilities. Render once per section.
@example
{% render 'nx01-launch-css' %}
{% enddoc %}

{% stylesheet %}
  .nx01 {
    scroll-margin-top: 9.6rem;
    --nx01-navy: 31, 57, 138;
    --nx01-navy-deep: 28, 52, 120;
    --nx01-navy-soft: 62, 91, 178;
    --nx01-ink: 10, 10, 10;
    --nx01-body: 32, 32, 34;
    --nx01-muted: 107, 106, 102;
    --nx01-line: 232, 231, 225;
    --nx01-rule: 36, 36, 41;
    --nx01-field: 249, 249, 249;
    --nx01-surface: 255, 255, 255;
    --nx01-radius: 0.2rem;
    background: rgb(var(--nx01-field));
    color: rgb(var(--nx01-ink));
    font-family: var(--font-body-family);
    box-sizing: border-box;
  }

  .nx01 *,
  .nx01 *::before,
  .nx01 *::after {
    box-sizing: border-box;
  }

  .nx01__inner {
    width: 100%;
    max-width: 128rem;
    margin: 0 auto;
    padding: 6.4rem var(--page-gap, 2.4rem);
  }

  .nx01__label {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    line-height: 1.6rem;
    text-transform: uppercase;
    color: rgb(var(--nx01-navy-deep));
  }

  .nx01__label-rule {
    display: block;
    width: 2rem;
    height: 0.1rem;
    background: rgb(var(--nx01-navy-deep));
  }

  .nx01__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(3.2rem, 5vw, 5.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
    color: rgb(var(--nx01-ink));
  }

  .nx01__sub {
    margin: 0;
    max-width: 72rem;
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.6;
    color: rgb(var(--nx01-body));
  }

  .nx01__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.6rem;
    margin-bottom: 4.8rem;
  }

  .nx01__intro--center {
    align-items: center;
    text-align: center;
  }

  .nx01__intro--center .nx01__sub {
    margin-inline: auto;
  }

  .nx01 .xo-btn {
    min-height: 4.8rem;
    padding-inline: 2.8rem;
    border-radius: var(--nx01-radius);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .nx01 .xo-btn--primary {
    background: rgb(var(--nx01-navy));
    border-color: rgb(var(--nx01-navy));
    color: rgb(var(--nx01-surface));
  }

  .nx01 .xo-btn--secondary {
    background: transparent;
    border: 0.1rem solid rgb(var(--nx01-rule));
    color: rgb(var(--nx01-navy));
  }

  .nx01__text-link {
    display: inline-flex;
    align-items: center;
    min-height: 4.8rem;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: rgb(var(--nx01-navy-deep));
  }

  .nx01__text-link:hover,
  .nx01__text-link:focus-visible {
    color: rgb(var(--nx01-ink));
  }

  .nx01__text-link:focus-visible {
    outline: 0.2rem solid rgb(var(--nx01-navy));
    outline-offset: 0.4rem;
  }

  @media screen and (min-width: 768px) {
    .nx01__inner {
      padding: 10rem 8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nx01 *,
    .nx01 *::before,
    .nx01 *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
{% endstylesheet %}
