{% comment %}
  Renders an image

  Accepts:
  - image: {Image} Image source (required)
  - lazyload: {Boolean} Lazyload image. Default: true (optional)
  - container_class: {String} Class of the image (required)
  - class: {String} Class of the image (required)
  - placeholder: {String} Placeholder SVG. Default: "detailed-apparel-1" (optional)
  - attrs: {String} Additional attributes of the image. Default: "" (optional)
  - aspect_ratio: {Number} Aspect ratio of the image (optional)
  - width_range: {Number} Fallback width of the image (optional)

  Usage:
  {% render 'image',
    image: section.settings.image,
  %}
{% endcomment %}

{% liquid
  assign global_lazyload = settings.image_lazyload
  if lazyload == null
    assign lazyload = global_lazyload
  endif
  if aspect_ratio == blank
    assign aspect_ratio = image.aspect_ratio
  endif
  assign responsive_sizes = sizes | default: '100vw'
  assign responsive_widths = widths | default: image_widths | default: width_range
  if responsive_widths == blank
    assign responsive_widths = '165, 360, 533, 720, 940, 1066, 1500, 2000'
  endif
  assign render_width = image.width | at_most: 2000
  if width != blank and width != '100%'
    assign requested_width = width | plus: 0
    if requested_width > 0
      assign render_width = requested_width | at_most: image.width
    endif
  endif
  assign wc = 'xo-lazyload'
  if lazyload
    assign loading = 'lazy'
  else
    assign loading = 'eager'
  endif
  assign fetch_priority = 'auto'
  if fetchpriority != blank
    assign fetch_priority = fetchpriority
    if fetchpriority == 'high'
      assign loading = 'eager'
      assign lazyload = false
    endif
  endif

  assign alt = alt | default: image.alt
  if disable_alt
    assign alt = ''
  endif

  if show_placeholder_product == null
    assign show_placeholder_product = false
  endif

  assign final_container_class = container_class | default: 'xo-image'
  unless final_container_class contains 'xo-image'
    assign final_container_class = 'xo-image ' | append: final_container_class
  endunless
  assign container_style = '--xo-ratio-percent: ' | append: aspect_ratio | append: '; --x-pos: ' | append: image.presentation.focal_point.x | append: '%; --y-pos: ' | append: image.presentation.focal_point.y | append: '%'
  if class
    assign final_container_class = final_container_class | append: ' ' | append: class
  endif
%}

<div class="{{ final_container_class }}" style="{{ container_style }}">
  {%- if image != blank -%}
    {{
      image
      | image_url: width: render_width
      | image_tag:
        is: wc,
        loading: loading,
        width: image.width,
        height: image.height,
        class: class,
        sizes: responsive_sizes,
        widths: responsive_widths,
        fetchpriority: fetch_priority,
        decoding: 'async',
        xo-intrinsic-width: image.width,
        xo-intrinsic-height: image.height,
        xo-width-range: width_range,
        alt: alt
    }}
    {%- if lazyload -%}
      <div class="xo-image__overlay xo-lazyload-overlay">
        <div class="xo-image__loading">
          {% liquid
            case settings.image_lazyload_loading
              when 'loader-1'
                render 'loader-1', color: 'rgb(var(--color-foreground))'
              when 'loader-2'
                render 'loader-2', color: 'rgb(var(--color-foreground))'
              when 'loader-3'
                render 'loader-3', color: 'rgb(var(--color-foreground))'
              else
                render 'loader-3', color: 'rgb(var(--color-foreground))'
            endcase
          %}
        </div>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="xo-image__placeholder" style="--xo-ratio-percent: {{ aspect_ratio }}">
      {% if show_placeholder_product %}
        {{ placeholder | default: 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% else %}
        {{ placeholder | default: 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>
  {%- endif -%}
</div>
