{% doc %}
  Weekend promo strip for the announcement bar. Countdown powered by ships-today-bar.js.

  @param {string} template - Message with __TIME__ placeholder for JS countdown

  @example
  {% render 'announcement-weekend-promo', template: promo_message %}
{% enddoc %}

<div
  class="xo-announcement-weekend-promo"
  data-weekend-promo
  data-tz="Asia/Dubai"
  data-template="{{ template | escape }}"
  hidden
>
  <p class="xo-announcement-weekend-promo__bar" role="status" aria-live="polite">
    <span data-ships-today-label></span>
  </p>
</div>
