{% doc %}
  Renders a message about free shipping in the cart.
  UAE orders show free delivery. International orders show destination-based thresholds.

  @example
  {% render 'cart-free-shipping' %}
{% enddoc %}

{{ 'cart-free-shipping.css' | asset_url | stylesheet_tag }}

{% liquid
  assign country_code = localization.country.iso_code | upcase
  assign shipping_url = shop.shipping_policy.url
  if shipping_url == blank
    assign shipping_url = pages['shipping-and-returns'].url
  endif
  if shipping_url == blank
    assign shipping_url = routes.root_url | append: 'pages/shipping-and-returns'
  endif
%}

{% if settings.show_cart_free_shipping %}
  {%- if country_code == 'AE' -%}
    <div class="xo-cart-free-shipping">
      <div class="xo-cart-free-shipping__text">
        {{ 'general.cart.uae_delivery_free' | t }}
      </div>
      <div class="xo-cart-mini-footer__separator-pd pb-0">
        <div class="xo-cart-mini-footer__separator"></div>
      </div>
    </div>
  {%- else -%}
    <div class="xo-cart-free-shipping">
      <div class="xo-cart-free-shipping__text">
        {{ 'general.cart.international_shipping_notice_html' | t: link: shipping_url }}
      </div>
      <div class="xo-cart-mini-footer__separator-pd pb-0">
        <div class="xo-cart-mini-footer__separator"></div>
      </div>
    </div>
  {%- endif -%}
{% endif %}
