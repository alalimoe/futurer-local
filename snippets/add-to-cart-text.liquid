{% comment %}
  Renders add to cart text

  @param {object} product - product object.

  @example
    {% liquid
      capture add_cart_text
        render 'add-to-cart-text', product: product
      endcapture
    %}

    {% render 'button', text: add_cart_text %}
{% endcomment %}

{% liquid
  assign is_bundle = is_bundle | default: false
  assign is_select_options = is_select_options | default: true, allow_false: true

  assign variant = product.selected_or_first_available_variant
  assign is_preorder = false
  if variant.inventory_quantity <= 0 and variant.inventory_policy == 'continue'
    assign is_preorder = true
  endif
%}

{% if product.variants.size > 1 and is_select_options %}
  {% if is_bundle %}
    {{ 'products.product.button_bundle_text' | t }}
  {% else %}
    {{ 'products.product.add_to_cart' | t }}
  {% endif %}
{% else %}
  {%- if is_preorder -%}
    {{ 'products.product.pre_order_text' | t }}
  {%- elsif variant.available == false -%}
    {{ 'products.product.sold_out' | t }}
  {%- else -%}
    {% if is_bundle %}
      {{ 'products.product.button_bundle_text' | t }}
    {% else %}
      {{ 'products.product.add_to_cart' | t }}
    {% endif %}
  {%- endif -%}
{% endif %}
