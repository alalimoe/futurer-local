{% doc %}
  Outputs 1 when a variant or option value should stay off the storefront picker.

  Only Phenylpiracetam Hydrazide 150mg capsules 100ct is hidden.
  The variant stays published so cart permalinks still add it.

  @param {product} product - Product Liquid object
  @param {object} [value] - Option value from option.values
  @param {object} [variant] - Variant object

  @example
  {% capture hide_v %}{% render 'variant-hidden-on-storefront', product: product, variant: variant %}{% endcapture %}
{% enddoc %}

{%- liquid
  assign hidden = false
  if product.handle == 'phenylpiracetam-hydrazide-150mg-capsules'
    if variant != blank
      assign vtitle = variant.title | downcase | strip
      assign vopt = variant.option1 | downcase | strip
      if variant.id == 46515999441092 or vtitle == '100ct' or vopt == '100ct'
        assign hidden = true
      endif
    elsif value != blank
      assign option_label = value.name | default: value | downcase | strip
      if option_label == '100ct'
        assign hidden = true
      endif
      if value.variant.id == 46515999441092
        assign hidden = true
      endif
    endif
  endif
-%}
{%- if hidden -%}1{%- endif -%}
