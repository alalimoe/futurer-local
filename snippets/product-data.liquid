{% comment %}
  Renders a product data

  Accepts:
  - product: {Object} Product Liquid object

  Usage:
  {% render 'product-data', product: product %}
{% endcomment %}

<xo-product-data>
  <template>
    <script type="application/json">
      {
        "id": {{ product.id }},
        "handle": {{ product.handle | json }},
        "variants": [
          {%- assign json_first = true -%}
          {%- for variant in product.variants -%}
            {%- assign skip_variant = false -%}
            {%- if product.handle == 'phenylpiracetam-hydrazide-150mg-capsules' -%}
              {%- if variant.id == 46515999441092 -%}
                {%- assign skip_variant = true -%}
              {%- endif -%}
            {%- endif -%}
            {%- unless skip_variant -%}
              {%- unless json_first -%},{%- endunless -%}
              {{ variant | json }}
              {%- assign json_first = false -%}
            {%- endunless -%}
          {%- endfor -%}
        ],
        "media": {{ product.media | json }},
        "options": {{ product.options | json }},
        "available": {{ product.available }}
      }
    </script>
  </template>
</xo-product-data>
{% if product.handle == 'phenylpiracetam-hydrazide-150mg-capsules' %}
  <style>
    .xo-field-radio[aria-label="100ct"],
    .xo-field-radio:has([xo-variant-id="46515999441092"]),
    .xo-field-select-custom__check:has([xo-variant-id="46515999441092"]) {
      display: none !important;
    }
  </style>
{% endif %}
