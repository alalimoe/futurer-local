{% doc %}
  Caption under the product price: split in 4 payments of the selected variant.

  @example
  {% render 'bnpl-box' %}
{% enddoc %}

{%- liquid
  assign variant_price = product.selected_or_first_available_variant.price
  assign installment_amount = variant_price | divided_by: 4.0 | round | money
  if settings.currency_code_enabled
    assign installment_amount = variant_price | divided_by: 4.0 | round | money_with_currency
  endif
-%}
<div class="premium-bnpl-box">
  <p class="premium-bnpl-box__caption">
    <span class="premium-bnpl-box__caption-text">
      {{ 'products.bnpl.split_html' | t: amount: installment_amount }}
    </span>
    <span class="premium-bnpl-box__logos">
      <img
        class="premium-bnpl-box__logo"
        src="{{ 'bnpl-tabby-badge.png' | asset_url }}"
        alt="{{ 'products.bnpl.logo_tabby' | t | escape }}"
        width="45"
        height="18"
        loading="eager"
      >
      {%- if request.locale.iso_code == 'ar' -%}
        <img
          class="premium-bnpl-box__logo"
          src="{{ 'bnpl-tamara-badge-ar.png' | asset_url }}"
          alt="{{ 'products.bnpl.logo_tamara' | t | escape }}"
          width="55"
          height="18"
          loading="eager"
        >
      {%- else -%}
        <img
          class="premium-bnpl-box__logo"
          src="{{ 'bnpl-tamara-badge-en.png' | asset_url }}"
          alt="{{ 'products.bnpl.logo_tamara' | t | escape }}"
          width="55"
          height="18"
          loading="eager"
        >
      {%- endif -%}
    </span>
  </p>
  <script type="application/json" data-bnpl-installments>
    {
      {%- for variant in product.variants -%}
        {%- liquid
          assign bnpl_inst = variant.price | divided_by: 4.0 | round | money
          if settings.currency_code_enabled
            assign bnpl_inst = variant.price | divided_by: 4.0 | round | money_with_currency
          endif
        -%}
        "{{ variant.id }}": {{ bnpl_inst | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>
  <div class="premium-bnpl-box__widgets">
    {% render 'tabby-installments' %}
    {% render 'tamara' %}
  </div>
</div>
<script>
  (function () {
    const box = document.querySelector('.premium-bnpl-box');
    if (!box) return;
    const caption = box.querySelector('.premium-bnpl-box__caption-text');
    const mapEl = box.querySelector('[data-bnpl-installments]');
    const productEl = box.closest('xo-product');
    if (!caption || !mapEl || !productEl) return;

    let installments = {};
    try {
      installments = JSON.parse(mapEl.textContent);
    } catch (e) {
      return;
    }

    const template = {{ 'products.bnpl.split_html' | t: amount: '__AMOUNT__' | json }};

    const update = () => {
      const idInput = productEl.querySelector('input[name="id"]');
      const variantId = idInput && idInput.value;
      const amount = variantId && installments[variantId];
      if (!amount) return;
      caption.innerHTML = template.replace('__AMOUNT__', amount);
    };

    productEl.addEventListener('change', update, true);
    const idInput = productEl.querySelector('input[name="id"]');
    if (idInput && typeof MutationObserver !== 'undefined') {
      new MutationObserver(update).observe(idInput, { attributes: true, attributeFilter: ['value'] });
    }
    update();
  })();
</script>
