{% doc %}
  Compact buy-now-pay-later caption with Tabby and Tamara widgets.

  @example
  {% render 'bnpl-box' %}
{% enddoc %}

{%- liquid
  assign installment_amount = product.selected_or_first_available_variant.price | divided_by: 4.0 | round | money
-%}
<div class="premium-bnpl-box">
  <div class="premium-bnpl-box__label">
    <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="1" y="3" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M1 6.5h14" stroke="currentColor" stroke-width="1.5"/>
    </svg>
    <span>{{ 'products.bnpl.eyebrow' | t }}</span>
  </div>
  <p class="premium-bnpl-box__tagline">{{ 'products.bnpl.tagline' | t }}</p>
  <p class="premium-bnpl-box__caption">
    {{ 'products.bnpl.caption_prefix' | t }}
    {{ installment_amount }}
  </p>
  <div class="premium-bnpl-box__merged" aria-hidden="true">
    <div class="premium-bnpl-box__col premium-bnpl-box__col--tabby">
      {% render 'tabby-installments' %}
    </div>
    <span class="premium-bnpl-box__divider" aria-hidden="true"></span>
    <div class="premium-bnpl-box__col premium-bnpl-box__col--tamara">
      {% render 'tamara' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .premium-bnpl-box {
    position: relative;
    margin: 0.8rem 0 0;
    padding: 0;
    border: none;
    background: none;
  }

  .premium-bnpl-box__label,
  .premium-bnpl-box__tagline,
  .premium-bnpl-box__divider {
    display: none;
  }

  .premium-bnpl-box__caption {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.6rem;
    color: rgba(var(--color-foreground-3));
  }

  .premium-bnpl-box__merged {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .premium-bnpl-box #TabbyPromo,
  .premium-bnpl-box #TabbyPromo > div,
  .premium-bnpl-box tamara-widget,
  .premium-bnpl-box .tamara-widget-container {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    max-height: 1.6rem;
    overflow: hidden;
  }

  .premium-bnpl-box tamara-widget::part(container),
  .premium-bnpl-box tabby-promo::part(container) {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
{% endstylesheet %}
