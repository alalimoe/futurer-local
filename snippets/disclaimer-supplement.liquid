{% doc %}
  Canonical supplement disclaimer (FDA-style).
  Single source of truth — render on PDPs, footer, and guide pages in later phases.

  @param {string} [class] - Optional wrapper class

  @example
  {% render 'disclaimer-supplement' %}
{% enddoc %}

{% liquid
  assign wrapper_class = class | default: 'policy-canonical policy-canonical--disclaimer disclaimer-supplement'
%}

{{ 'policy-canonical.css' | asset_url | stylesheet_tag }}

<p class="{{ wrapper_class }}" role="note">
  {{ 'policies.canonical.disclaimer_supplement' | t }}
</p>
