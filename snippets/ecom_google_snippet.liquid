{%- liquid
  assign schema_allowed = false
  if request.page_type == 'index' or request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'page' or request.page_type == 'blog' or request.page_type == 'article'
    assign schema_allowed = true
  endif

  assign organization_id = shop.secure_url | append: '#organization'
  assign website_id = shop.secure_url | append: '#website'
  assign organization_logo_url = ''
  if settings.logo != blank
    assign organization_logo_url = settings.logo | image_url: width: 600 | prepend: 'https:'
  endif
-%}

{%- capture same_as_json -%}
  {%- assign social_first = true -%}
  {%- if settings.social_twitter_link != blank -%}
    {{ settings.social_twitter_link | json }}
    {%- assign social_first = false -%}
  {%- endif -%}
  {%- if settings.social_facebook_link != blank -%}
    {%- unless social_first -%},{%- endunless -%}{{ settings.social_facebook_link | json }}
    {%- assign social_first = false -%}
  {%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}
    {%- unless social_first -%},{%- endunless -%}{{ settings.social_pinterest_link | json }}
    {%- assign social_first = false -%}
  {%- endif -%}
  {%- if settings.social_instagram_link != blank -%}
    {%- unless social_first -%},{%- endunless -%}{{ settings.social_instagram_link | json }}
    {%- assign social_first = false -%}
  {%- endif -%}
  {%- if settings.social_tiktok_link != blank -%}
    {%- unless social_first -%},{%- endunless -%}{{ settings.social_tiktok_link | json }}
    {%- assign social_first = false -%}
  {%- endif -%}
  {%- if settings.social_tumblr_link != blank -%}
    {%- unless social_first -%},{%- endunless -%}{{ settings.social_tumblr_link | json }}
    {%- assign social_first = false -%}
  {%- endif -%}
  {%- if settings.social_snapchat_link != blank -%}
    {%- unless social_first -%},{%- endunless -%}{{ settings.social_snapchat_link | json }}
    {%- assign social_first = false -%}
  {%- endif -%}
  {%- if settings.social_youtube_link != blank -%}
    {%- unless social_first -%},{%- endunless -%}{{ settings.social_youtube_link | json }}
    {%- assign social_first = false -%}
  {%- endif -%}
  {%- if settings.social_vimeo_link != blank -%}
    {%- unless social_first -%},{%- endunless -%}{{ settings.social_vimeo_link | json }}
  {%- endif -%}
{%- endcapture -%}
{%- assign same_as_json = same_as_json | strip -%}

{%- if schema_allowed -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": {{ organization_id | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.secure_url | json }}
      {%- if organization_logo_url != blank -%}
        ,"logo": {
          "@type": "ImageObject",
          "url": {{ organization_logo_url | json }}
        }
      {%- endif -%}
      {%- if shop.description != blank -%}
        ,"description": {{ shop.description | strip_html | strip | json }}
      {%- endif -%}
      {%- if shop.phone != blank -%}
        ,"telephone": {{ shop.phone | json }}
      {%- endif -%}
      {%- if shop.address.country_code != blank -%}
        ,"address": {
          "@type": "PostalAddress"
          {%- if shop.address.street != blank -%},"streetAddress": {{ shop.address.street | json }}{%- endif -%}
          {%- if shop.address.city != blank -%},"addressLocality": {{ shop.address.city | json }}{%- endif -%}
          {%- if shop.address.province != blank -%},"addressRegion": {{ shop.address.province | json }}{%- endif -%}
          {%- if shop.address.zip != blank -%},"postalCode": {{ shop.address.zip | json }}{%- endif -%}
          ,"addressCountry": {{ shop.address.country_code | json }}
        }
      {%- endif -%}
      {%- if same_as_json != blank -%}
        ,"sameAs": [{{ same_as_json }}]
      {%- endif -%}
    }
  </script>

  {%- if request.page_type == 'index' -%}
    {%- assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": {{ website_id | json }},
        "name": {{ shop.name | json }},
        "url": {{ shop.secure_url | json }},
        "publisher": { "@id": {{ organization_id | json }} },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {{ search_target | json }},
          "query-input": "required name=search_term_string"
        }
      }
    </script>
  {%- elsif request.page_type == 'product' and product != blank -%}
    {% render 'product-jsonld', product: product, schema_owner: 'ecom_google_snippet' %}
    {% render 'breadcrumbs', show_nav: false, emit_schema: true, load_styles: false %}
  {%- elsif request.page_type == 'article' and article != blank -%}
    {%- liquid
      assign custom_author = article.metafields.custom.author.value
      assign article_author_name = custom_author.name.value | default: custom_author.name | default: custom_author | default: article.author
      assign reviewer = article.metafields.custom.reviewed_by.value
      assign reviewer_name = reviewer.name.value | default: reviewer.name | default: reviewer
      assign review_status = article.metafields.custom.review_status.value | default: article.metafields.custom.review_status
      assign article_description = article.excerpt | strip_html | strip
      if article_description == blank
        assign article_description = article.content | strip_html | strip | truncate: 5000
      endif
      assign article_body = article.content | strip_html | strip
      assign article_url = canonical_url
    -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "@id": {{ article_url | append: '#article' | json }},
        "mainEntityOfPage": { "@type": "WebPage", "@id": {{ article_url | json }} },
        "url": {{ article_url | json }},
        "headline": {{ article.title | json }},
        "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
        "dateModified": {{ article.updated_at | date: '%Y-%m-%d' | json }},
        "publisher": { "@id": {{ organization_id | json }} }
        {%- if article_author_name != blank -%}
          ,"author": {
            "@type": "Person",
            "name": {{ article_author_name | strip | json }}
          }
        {%- endif -%}
        {%- if reviewer_name != blank and review_status == 'reviewed' -%}
          ,"reviewedBy": {
            "@type": "Person",
            "name": {{ reviewer_name | strip | json }}
          }
        {%- endif -%}
        {%- if blog.title != blank -%}
          ,"articleSection": {{ blog.title | json }}
        {%- endif -%}
        {%- if article_description != blank -%}
          ,"description": {{ article_description | json }}
        {%- endif -%}
        {%- if article_body != blank -%}
          ,"articleBody": {{ article_body | json }}
        {%- endif -%}
        {%- if article.image != blank -%}
          ,"image": {
            "@type": "ImageObject",
            "url": {{ article.image | image_url: width: 1600 | prepend: 'https:' | json }},
            "width": {{ article.image.width | json }},
            "height": {{ article.image.height | json }}
          }
        {%- endif -%}
        {%- if request.locale.iso_code != blank -%}
          ,"inLanguage": {{ request.locale.iso_code | json }}
        {%- endif -%}
      }
    </script>
  {%- elsif request.page_type == 'blog' and blog != blank -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Blog",
        "@id": {{ canonical_url | append: '#blog' | json }},
        "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical_url | json }} },
        "url": {{ canonical_url | json }},
        "name": {{ blog.title | json }},
        "publisher": { "@id": {{ organization_id | json }} }
      }
    </script>
  {%- endif -%}
{%- endif -%}
