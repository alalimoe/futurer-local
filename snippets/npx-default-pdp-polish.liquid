{% doc %}
  Refines the default product template without changing the theme's product controls.

  @param {object} section - The main product section being styled

  @example
  {% render 'npx-default-pdp-polish', section: section %}
{% enddoc %}

{% style %}
  #shopify-section-{{ section.id }} .main-product__container {
    max-width: 124rem;
    margin-inline: auto;
  }
  #shopify-section-{{ section.id }} .main-product__grid { align-items: start; }
  #shopify-section-{{ section.id }} .main-product__image-content {
    max-width: 56rem;
    margin-inline: auto;
  }
  #shopify-section-{{ section.id }} .main-product__content {
    min-width: 0;
    padding: 2.4rem 0 0;
  }
  #shopify-section-{{ section.id }} .xo-product-info-content__title.h4 {
    width: 100%;
    max-width: 22ch;
    font-size: clamp(2.6rem, 2.6vw, 3.8rem);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -.035em;
    padding-bottom: 1rem;
  }
  #shopify-section-{{ section.id }} .xo-product-info-content__benefit {
    max-width: 52ch;
    font-size: 1.5rem;
    line-height: 1.6;
    margin-top: .8rem;
  }
  #shopify-section-{{ section.id }} .xo-product-info-content .shopify-app-block { padding-block: 1.2rem; }
  #shopify-section-{{ section.id }} .xo-product-info-content__price { margin-block: .6rem; }
  #shopify-section-{{ section.id }} .xo-product-info-content__price .xo-price__item:not(.xo-price__item--del) {
    font-size: 2.4rem;
    font-weight: 500;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .xo-product-info-content__variant--pd { padding-top: 1.4rem; }
  #shopify-section-{{ section.id }} .xo-product-info-content__variant .xo-product-variant__inner-value { gap: .8rem; }
  #shopify-section-{{ section.id }} .xo-product-info-content__variant .xo-field-radio--boxed { padding-inline-end: 0; }
  #shopify-section-{{ section.id }} .xo-product-info-content__variant .xo-field-radio--boxed .xo-field-radio__label { min-width: 9.4rem; }
  #shopify-section-{{ section.id }} .xo-product-info-content__buy-form {
    --pdp-cta-height: 5.2rem;
    margin-block: 1.6rem 2.4rem;
  }
  #shopify-section-{{ section.id }} .xo-product-info-content__buy-row { gap: 1rem; }
  #shopify-section-{{ section.id }} .xo-product-info-content__add .xo-btn { font-weight: 600; }
  #shopify-section-{{ section.id }} .npx-desc-acc { display: block; margin-top: 2.4rem; }
  #shopify-section-{{ section.id }} .npx-desc-acc__divider {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-bottom: 1.2rem;
  }
  #shopify-section-{{ section.id }} .npx-desc-acc__divider-line {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: .12;
  }
  #shopify-section-{{ section.id }} .npx-desc-acc__divider-label {
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: .12em;
    text-transform: uppercase;
    opacity: .6;
  }
  #shopify-section-{{ section.id }} .npx-desc-acc__item { border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent); }
  #shopify-section-{{ section.id }} .npx-desc-acc__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    min-height: 5.2rem;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
  }
  #shopify-section-{{ section.id }} .npx-desc-acc__summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .npx-desc-acc__summary:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: .2rem;
  }
  #shopify-section-{{ section.id }} .npx-desc-acc__lead { display: flex; align-items: baseline; gap: 1.4rem; min-width: 0; }
  #shopify-section-{{ section.id }} .npx-desc-acc__index { font-size: 1rem; opacity: .45; font-variant-numeric: tabular-nums; }
  #shopify-section-{{ section.id }} .npx-desc-acc__headline { font-size: 1.4rem; font-weight: 500; line-height: 1.5; }
  #shopify-section-{{ section.id }} .npx-desc-acc__icon { flex: 0 0 1.4rem; opacity: .65; }
  #shopify-section-{{ section.id }} .npx-desc-acc__icon svg { display: block; }
  #shopify-section-{{ section.id }} .npx-desc-acc__item[open] .npx-desc-acc__icon line:first-child { display: none; }
  #shopify-section-{{ section.id }} .npx-desc-acc__tag {
    display: inline-block;
    margin-inline-start: .6rem;
    padding: .15rem .5rem;
    border: 1px solid currentColor;
    border-radius: .3rem;
    font-size: .9rem;
    font-weight: 500;
    line-height: 1.4;
    vertical-align: middle;
  }
  #shopify-section-{{ section.id }} .npx-desc-acc__body {
    padding: .2rem 0 2rem 2.9rem;
    padding-inline: 2.9rem 0;
    font-size: 1.4rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} .npx-desc-acc__body p { margin: 0 0 1rem; }
  #shopify-section-{{ section.id }} .npx-desc-acc__body p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .npx-desc-acc__body ul,
  #shopify-section-{{ section.id }} .npx-desc-acc__body ol { margin-block: 0 1rem; padding-inline-start: 1.8rem; }
  #shopify-section-{{ section.id }} .npx-desc-acc__body li + li { margin-top: .6rem; }
  #shopify-section-{{ section.id }} .npx-desc-acc__body a { text-decoration: underline; text-underline-offset: .2em; }
  #shopify-section-{{ section.id }} .npx-desc-acc__rows { display: grid; gap: 1.2rem; }
  #shopify-section-{{ section.id }} .npx-desc-acc__row { display: grid; gap: .3rem; }
  #shopify-section-{{ section.id }} .npx-desc-acc__row-label,
  #shopify-section-{{ section.id }} .npx-desc-acc__subhead { font-weight: 600; }
  #shopify-section-{{ section.id }} .npx-desc-acc__note { margin-top: 1.2rem; opacity: .75; }
  #shopify-section-{{ section.id }} .xo-sticky-cart__inner {
    max-width: 124rem;
    margin-inline: auto;
    padding-block: .8rem max(.8rem, env(safe-area-inset-bottom));
  }
  #shopify-section-{{ section.id }} .xo-sticky-cart__grid { padding-block: .4rem; }
  #shopify-section-{{ section.id }} .xo-sticky-cart__info-box { gap: .4rem; padding-bottom: 0; justify-content: center; }
  #shopify-section-{{ section.id }} .xo-sticky-cart { --pdp-cta-height: 4.8rem; }
  @media (min-width: 992px) {
    #shopify-section-{{ section.id }} .main-product__grid { column-gap: clamp(2.4rem, 4vw, 6.4rem); }
    #shopify-section-{{ section.id }} .main-product__content { padding: 1.2rem 0 2.4rem; }
    #shopify-section-{{ section.id }} .main-product__image-content { position: sticky; top: 10rem; }
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .main-product__image-content { max-width: 44rem; }
    #shopify-section-{{ section.id }} .xo-product-info-content__title.h4 { max-width: none; }
    #shopify-section-{{ section.id }} .xo-product-info-media-carousel__content { padding-top: 1rem; }
    #shopify-section-{{ section.id }} .xo-product-info-content__quantity { width: 11.4rem; min-width: 11.4rem; flex-basis: 11.4rem; }
    #shopify-section-{{ section.id }} .xo-product-info-content__variant .xo-field-radio--boxed .xo-field-radio__label { min-width: 8.4rem; }
    #shopify-section-{{ section.id }} .npx-desc-acc__body { padding-inline-start: 0; }
    #shopify-section-{{ section.id }} .xo-sticky-cart__info-title { font-size: 1.3rem; }
  }
{% endstyle %}
