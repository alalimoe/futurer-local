{{ 'login-form.css' | asset_url | stylesheet_tag }}

<div class='login-form'>
  <div class='login-form__content'>
    {% form 'customer_login' %}
      {% assign success_message = 'customer.login_page.success_message' | t %}
      {% render 'form-error', form: form %}
      {% render 'form-success', form: form, message: success_message %}
      <xo-animate xo-cascade>
        <div class='login-form__item'>
          <div class='login-form__item-input'>
            {% assign email_input_id = 'Email-input--' | append: section.id %}
            {% assign email_label = 'customer.login_page.email' | t %}
            {% render 'field-input', type: 'text', name: 'customer[email]', value: '', label: email_label, id: email_input_id, required: 'required' %}
          </div>
          <div class='login-form__item-icon'>
            {% render 'icon', name: 'mail', size: '1.8rem', type: 'button' %}
          </div>
        </div>
        {% render 'space', spacing_dt: 8, spacing_mb: 6 %}
        <div class='login-form__item'>
          <div class='login-form__item-input'>
            {% assign password_input_id = 'passwordField--' | append: section.id %}
            {% assign password_label = 'customer.login_page.password' | t %}
            {% assign show_password_key = 'customer.login_page.show_password' %}
            {% assign hide_password_key = 'customer.login_page.hide_password' %}
            {% assign show_password_label = show_password_key | t %}
            {% assign hide_password_label = hide_password_key | t %}
            {% assign password_toggle_language = '' %}
            {% if show_password_label contains 'translation missing' %}
              {% assign show_password_label = 'Show password' %}
              {% assign password_toggle_language = 'en' %}
            {% endif %}
            {% if hide_password_label contains 'translation missing' %}
              {% assign hide_password_label = 'Hide password' %}
              {% assign password_toggle_language = 'en' %}
            {% endif %}
            {% render 'field-input', type: 'password', name: 'customer[password]', value: '', label: password_label, id: password_input_id, required: 'required' %}
          </div>
          <button
            type='button'
            class='login-form__item-icon'
            data-password-toggle
            aria-controls='{{ password_input_id }}'
            aria-label='{{ show_password_label | escape }}'
            aria-pressed='false'
            {% if password_toggle_language != blank %}
              lang='{{ password_toggle_language }}'
            {% endif %}
            data-label-show='{{ show_password_label | escape }}'
            data-label-hide='{{ hide_password_label | escape }}'
          >
            <span class='login-form__icon-hide' aria-hidden='true'>
              {% render 'icon', name: 'eye-hide', size: '2.4rem' %}
            </span>
            <span class='login-form__icon-open' aria-hidden='true'>
              {% render 'icon', name: 'eye', size: '2.4rem' %}
            </span>
          </button>
        </div>
      </xo-animate>
      <xo-animate xo-cascade>
        <div class='login-form__sign-in'>
          {% assign btn_sign_in_text = 'customer.login_page.sign_in' | t %}
          {% render 'button', text: btn_sign_in_text, size: 'md', block: true, effect: 'slide-up', style: 'primary' %}
        </div>
      </xo-animate>
    {% endform %}
    {% render 'space', spacing_dt: 20, spacing_mb: 20 %}
    <xo-animate xo-cascade>
      <div class='login-form__footer'>
        <div class='login-form__footer-left'>
          <span class='login-form__left-title'>{{ 'customer.login_page.dont_have' | t }}</span>
          {% assign button_text = 'customer.login_page.sign_up' | t %}
          {% render 'button', text: button_text, link: routes.account_register_url, style: 'link', size: 'sm' %}
        </div>
        <div class='login-form__footer-right'>
          <xo-modal-trigger xo-name='forgot-your-password'>
            {% assign button_text = 'customer.login_page.forgot_password' | t %}
            {% render 'button', text: button_text, style: 'link', size: 'sm' %}
          </xo-modal-trigger>
        </div>
      </div>
    </xo-animate>
  </div>
</div>

<script>
  (() => {
    const init = (togglePassword) => {
      if (togglePassword.dataset.passwordToggleReady === 'true') return;
      togglePassword.dataset.passwordToggleReady = 'true';
      const passwordField = document.getElementById(togglePassword.getAttribute('aria-controls'));
      const eyeOpenPassword = togglePassword.querySelector('.login-form__icon-open');
      const eyeHidePassword = togglePassword.querySelector('.login-form__icon-hide');
      if (!passwordField) return;

      togglePassword.addEventListener('click', () => {
        const isVisible = passwordField.type === 'text';
        passwordField.type = isVisible ? 'password' : 'text';
        togglePassword.setAttribute('aria-pressed', String(!isVisible));
        togglePassword.setAttribute('aria-label', isVisible ? togglePassword.dataset.labelShow : togglePassword.dataset.labelHide);
        eyeOpenPassword?.classList.toggle('active', !isVisible);
        eyeHidePassword?.classList.toggle('active', !isVisible);
      });
    };

    document.querySelectorAll('[data-password-toggle]').forEach(init);
    if (!window.nootropixPasswordToggleBound) {
      window.nootropixPasswordToggleBound = true;
      document.addEventListener('shopify:section:load', (event) => {
        event.target.querySelectorAll('[data-password-toggle]').forEach(init);
      });
    }
  })();
</script>
