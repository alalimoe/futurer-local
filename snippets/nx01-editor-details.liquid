{% doc %}
  Renders the editable NX-01 formula and product detail blocks.
  @param {object} section - NX-01 opening section
  @example
  {% render 'nx01-editor-details', section: section %}
{% enddoc %}

{{ 'product-description-accordion.css' | asset_url | stylesheet_tag }}
{{ 'nx01-ingredients-table.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-description-accordion.js' | asset_url }}" defer></script>

<npx-desc-accordion class="npx-desc-acc" data-acc-group="nx01-editor-{{ section.id }}">
  {% if section.settings.details_heading != blank %}
    <div class="npx-desc-acc__divider">
      <span class="npx-desc-acc__divider-line"></span>
      <span class="npx-desc-acc__divider-label">{{ section.settings.details_heading | escape }}</span>
      <span class="npx-desc-acc__divider-line"></span>
    </div>
  {% endif %}
  <div class="npx-desc-acc__list">
    {% assign panel_index = 0 %}
    {% assign has_open_panel = false %}
    {% for block in section.blocks %}
      {% if block.type == 'formula_table' or block.type == 'detail' or block.type == 'directions' or block.type == 'safety' %}
        {% if block.settings.title != blank %}
          {% assign panel_index = panel_index | plus: 1 %}
          <details class="npx-desc-acc__item" id="nx01-detail-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}{% if block.settings.open_by_default and has_open_panel == false %} open{% assign has_open_panel = true %}{% endif %}>
            <summary class="npx-desc-acc__summary">
              <span class="npx-desc-acc__lead">
                <span class="npx-desc-acc__index" dir="ltr">{{ panel_index | prepend: '00' | slice: -2, 2 }}</span>
                <span class="npx-desc-acc__headline">
                  {{ block.settings.title | escape }}
                  {% if block.settings.tag != blank %}<span class="npx-desc-acc__tag">{{ block.settings.tag | escape }}</span>{% endif %}
                </span>
              </span>
              <span class="npx-desc-acc__icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" focusable="false">
                  <line x1="7" y1="0" x2="7" y2="14" stroke="currentColor" stroke-width="1.5"></line>
                  <line x1="0" y1="7" x2="14" y2="7" stroke="currentColor" stroke-width="1.5"></line>
                </svg>
              </span>
            </summary>
            <div class="npx-desc-acc__panel">
              <div class="npx-desc-acc__body">
                {% case block.type %}
                  {% when 'formula_table' %}
                    {% render 'nx01-editor-table', section: section, block: block %}
                  {% when 'detail' %}
                    {{ block.settings.content }}
                    {% if block.settings.note != blank %}<div class="npx-desc-acc__note">{{ block.settings.note }}</div>{% endif %}
                  {% when 'directions' %}
                    <div class="npx-desc-acc__rows">
                      {% for i in (1..3) %}
                        {% assign label_key = 'label_' | append: i %}
                        {% assign text_key = 'text_' | append: i %}
                        {% if block.settings[text_key] != blank %}
                          <div class="npx-desc-acc__row">
                            {% if block.settings[label_key] != blank %}<span class="npx-desc-acc__row-label">{{ block.settings[label_key] | escape }}</span>{% endif %}
                            <span>{{ block.settings[text_key] | escape | newline_to_br }}</span>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                    {% if block.settings.link != blank and block.settings.link_label != blank %}
                      <a class="npx-desc-acc__link" href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>
                    {% endif %}
                  {% when 'safety' %}
                    {% if block.settings.important != blank %}
                      <p class="npx-desc-acc__lead-copy">
                        {% if block.settings.important_label != blank %}<strong>{{ block.settings.important_label | escape }}:</strong>{% endif %}
                        {{ block.settings.important | escape | newline_to_br }}
                      </p>
                    {% endif %}
                    {% if block.settings.general != blank %}
                      {% if block.settings.general_label != blank %}<p class="npx-desc-acc__subhead">{{ block.settings.general_label | escape }}</p>{% endif %}
                      <p>{{ block.settings.general | escape | newline_to_br }}</p>
                    {% endif %}
                    {% if block.settings.disclaimer != blank %}<p class="npx-desc-acc__disclaimer">{{ block.settings.disclaimer | escape | newline_to_br }}</p>{% endif %}
                {% endcase %}
              </div>
            </div>
          </details>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</npx-desc-accordion>
