{% doc %}
  Supplement-facts table for the NX-01 Baseline product template.
  @example
  {% render 'nx01-ingredients-table' %}
{% enddoc %}

<div class="nx01-ing-panel">
<table class="nx01-ing-table">
  <caption class="xo-visually-hidden">{{ 'products.product.description_accordion.table_caption' | t }}</caption>
  <thead>
    <tr>
      <th scope="col">
        <span class="nx01-ing-table__serving">
          <span>{{ 'products.product.description_accordion.serving_size' | t: size: '3 capsules' }}</span>
          <span>{{ 'products.product.description_accordion.servings_per_container' | t: count: 30 }}</span>
        </span>
      </th>
      <th scope="col" class="nx01-ing-table__amount">{{ 'products.product.description_accordion.amount_per_serving' | t }}</th>
      <th scope="col" class="nx01-ing-table__dv">{{ 'products.product.description_accordion.dv_percent' | t }}</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <th scope="row">Vitamin B6 (as Pyridoxal-5-Phosphate)</th>
      <td class="nx01-ing-table__amount">5 mg</td>
      <td class="nx01-ing-table__dv">294%</td>
    </tr>
    <tr>
      <th scope="row">Folate (as L-5-MTHF)</th>
      <td class="nx01-ing-table__amount">400 µg DFE</td>
      <td class="nx01-ing-table__dv">100%</td>
    </tr>
    <tr>
      <th scope="row">Vitamin B12 (as Methylcobalamin)</th>
      <td class="nx01-ing-table__amount">500 µg</td>
      <td class="nx01-ing-table__dv">20,833%</td>
    </tr>
    <tr>
      <th scope="row">Acetyl-L-Carnitine</th>
      <td class="nx01-ing-table__amount">500 mg</td>
      <td class="nx01-ing-table__dv">†</td>
    </tr>
    <tr>
      <th scope="row">CDP-Choline (Citicoline)</th>
      <td class="nx01-ing-table__amount">250 mg</td>
      <td class="nx01-ing-table__dv">†</td>
    </tr>
    <tr>
      <th scope="row">NMN (Nicotinamide mononucleotide)</th>
      <td class="nx01-ing-table__amount">250 mg</td>
      <td class="nx01-ing-table__dv">†</td>
    </tr>
    <tr>
      <th scope="row">L-Theanine</th>
      <td class="nx01-ing-table__amount">200 mg</td>
      <td class="nx01-ing-table__dv">†</td>
    </tr>
    <tr>
      <th scope="row">Rhodiola rosea extract (standardized 3% rosavins)</th>
      <td class="nx01-ing-table__amount">200 mg</td>
      <td class="nx01-ing-table__dv">†</td>
    </tr>
    <tr>
      <th scope="row">CoQ10 (as Ubiquinol)</th>
      <td class="nx01-ing-table__amount">100 mg</td>
      <td class="nx01-ing-table__dv">†</td>
    </tr>
  </tbody>
  <tfoot>
    <tr>
      <td>{{ 'products.product.description_accordion.dv_legend' | t }}</td>
      <td colspan="2" class="nx01-ing-table__dv">{{ 'products.product.description_accordion.dv_na' | t }}</td>
    </tr>
    <tr>
      <td colspan="3">{{ 'products.product.description_accordion.other_ingredients' | t }}</td>
    </tr>
  </tfoot>
</table>
</div>

{% stylesheet %}
  .nx01-ing-panel {
    overflow-x: auto;
    padding: 0.4rem 1.2rem 1.2rem;
    border: 0.2rem solid #000;
    background: #fff;
    color: #111;
  }

  .nx01-ing-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.3rem;
    line-height: 1.45;
    color: inherit;
  }

  .nx01-ing-table caption {
    text-align: start;
  }

  .nx01-ing-table th,
  .nx01-ing-table td {
    padding: 1rem 0.8rem;
    border-block-end: 0.1rem solid #000;
    font-weight: 400;
    text-align: start;
    vertical-align: top;
  }

  .nx01-ing-table thead th {
    font-weight: 500;
    color: #111;
    border-block-end: 0.2rem solid #000;
  }

  .nx01-ing-table tbody th {
    font-weight: 400;
  }

  .nx01-ing-table__serving {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: #111;
    font-weight: 500;
  }

  .nx01-ing-table__amount,
  .nx01-ing-table__dv {
    text-align: end;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .nx01-ing-table tfoot td {
    border-block-end: 0;
    padding-block-start: 1.2rem;
    font-size: 1.2rem;
    color: #333;
  }

  .npx-desc-acc__body:has(.nx01-ing-panel) {
    padding-inline-start: 0;
  }
{% endstylesheet %}
