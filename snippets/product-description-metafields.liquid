{%- comment -%}
Nootropix — Product description renderer from metafields
{%- endcomment -%}

{%- assign tldr_src = product.metafields.npx.tl_dr | default: product.metafields.npx.tldr -%}
{%- assign tldr = nil -%}
{%- if tldr_src and tldr_src.value -%}
  {%- assign tldr = tldr_src.value -%}
{%- elsif tldr_src -%}
  {%- assign tldr = tldr_src -%}
{%- endif -%}

{%- assign what_it_is = product.metafields.npx.what_it_is.value | default: product.metafields.npx.what_it_is -%}
{%- assign feel_raw = product.metafields.npx.feel_timeline.value | default: product.metafields.npx.feel_timeline -%}
{%- assign feel_first_json = feel_raw | json | slice: 0, 1 -%}
{%- assign feel_first_raw = feel_raw | strip | slice: 0, 1 -%}
{%- assign feel = feel_raw -%}
{%- assign feel_note = product.metafields.npx.feel_note.value | default: product.metafields.npx.feel_note -%}
{%- assign how = product.metafields.npx.how_to_use.value -%}
{%- assign why = product.metafields.npx.why.value -%}
{%- assign safety_important = product.metafields.npx.safety_important.value | default: product.metafields.npx.safety_important -%}
{%- assign safety_general = product.metafields.npx.safety_general.value | default: product.metafields.npx.safety_general -%}
{%- assign disclaimer = product.metafields.npx.disclaimer.value | default: product.metafields.npx.disclaimer -%}
{%- assign faq = product.metafields.npx.faq.value -%}
{%- assign how_it_works_text = product.metafields.npx.how_it_works.value | default: product.metafields.npx.how_it_works -%}

{%- comment -%} friendly heading for “Why … ?” {%- endcomment -%}
{%- assign form_label = 'capsules' -%}
{%- if product.title contains 'Powder' -%}{% assign form_label = 'powder' %}{%- endif -%}

<div class="product-prose">

  {%- if tldr != blank -%}
    <h3>TL;DR</h3>
    {%- assign tldr_first = tldr | json | slice: 0, 1 -%}
    {%- if tldr_first == '[' -%}
      <ul>
        {%- for item in tldr -%}<li>{{ item }}</li>{%- endfor -%}
      </ul>
    {%- else -%}
      <p>{{ tldr | newline_to_br }}</p>
    {%- endif -%}
  {%- endif -%}

  {%- if what_it_is != blank -%}
    <h3>What it is</h3>
    <p>{{ what_it_is }}</p>
  {%- endif -%}

  {%- if feel != blank -%}
    <h3>What you’ll feel (and when)</h3>
    {%- assign feel_first = feel | json | slice: 0, 1 -%}
    {%- if feel_first == '[' -%}
      <ul>
        {%- for f in feel -%}
          <li>{% if f.label %}<strong>{{ f.label }}:</strong> {% endif %}{{ f.description | default: f.text | default: f }}</li>
        {%- endfor -%}
      </ul>
    {%- elsif feel_first_raw == '[' -%}
      <ul>
        {%- assign feel_chunks = feel_raw | append: '' | split: '"label":"' -%}
        {%- for chunk in feel_chunks -%}
          {%- unless forloop.first -%}
            {%- assign f_label = chunk | split: '"' | first -%}
            {%- assign desc_split = chunk | split: '"description":"' -%}
            {%- assign f_desc = '' -%}
            {%- if desc_split.size > 1 -%}
              {%- assign f_desc = desc_split.last | split: '"' | first -%}
            {%- endif -%}
            {%- if f_desc == blank -%}
              {%- assign text_split = chunk | split: '"text":"' -%}
              {%- if text_split.size > 1 -%}
                {%- assign f_desc = text_split.last | split: '"' | first -%}
              {%- endif -%}
            {%- endif -%}
            <li>{% if f_label != blank %}<strong>{{ f_label }}:</strong> {% endif %}{{ f_desc }}</li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p>{{ feel | newline_to_br }}</p>
    {%- endif -%}
    {% # region agent log %}
    <script>
      (function () {
        var heading = Array.prototype.find.call(document.querySelectorAll('.product-prose h3'), function (el) { return /feel/i.test(el.textContent || ''); });
        var next = heading && heading.nextElementSibling;
        var data = {
          handle: {{ product.handle | json }},
          feelFirstJson: {{ feel_first_json | json }},
          feelFirstRaw: {{ feel_first_raw | json }},
          feelFirstAfterParse: {{ feel_first | json }},
          itemCount: {{ feel.size | default: 0 }},
          nextTag: next && next.tagName,
          nextIsList: !!(next && next.tagName === 'UL'),
          nextText: next && (next.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 180)
        };
        fetch('http://127.0.0.1:7906/ingest/73d01807-f919-4550-a2d5-12c9f0435bd9',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'737e95'},body:JSON.stringify({sessionId:'737e95',runId:'post-fix',hypothesisId:'A',location:'snippets/product-description-metafields.liquid:feel-timeline',message:'feel timeline parse + render',data:data,timestamp:Date.now()})}).catch(function(){});
        fetch('http://127.0.0.1:7906/ingest/73d01807-f919-4550-a2d5-12c9f0435bd9',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'737e95'},body:JSON.stringify({sessionId:'737e95',runId:'post-fix',hypothesisId:'F',location:'snippets/product-description-metafields.liquid:feel-timeline-fallback',message:'string JSON split fallback',data:{usedSplitFallback: data.feelFirstAfterParse !== '[', nextIsList: data.nextIsList, nextText: data.nextText},timestamp:Date.now()})}).catch(function(){});
      })();
    </script>
    {% # endregion %}
  {%- endif -%}
  
  {%- if feel_note != blank -%}
  <aside class="npx-note">{{ feel_note }}</aside>
{%- endif -%}


  {%- if product.metafields.npx.how_it_works != blank -%}
  <h3>How it works (the simple science)</h3>
  {{ product.metafields.npx.how_it_works | metafield_tag }}
{%- endif -%}


  {%- if how != blank -%}
    <h3>How to use</h3>
    {%- assign how_first = how | json | slice: 0, 1 -%}
    {%- if how_first == '[' -%}
      <ul>
        {%- for h in how -%}
          <li>{% if h.label %}<strong>{{ h.label }}:</strong> {% endif %}{{ h.text | default: h.description | default: h }}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p>{{ how | newline_to_br }}</p>
    {%- endif -%}
    {%- assign dg_page = pages['dosing-guide'] -%}
    {%- if dg_page != empty -%}
      {%- assign dg_hub_url = dg_page.url -%}
    {%- else -%}
      {%- assign dg_hub_url = '/pages/dosing-guide' -%}
    {%- endif -%}
    <p><a href="{{ dg_hub_url }}#dose-{{ product.handle }}">Open the Dosing Guide for this product</a></p>
  {%- endif -%}

  {%- if why != blank -%}
    <h3>Why {{ form_label }}?</h3>
    {%- assign why_first = why | json | slice: 0, 1 -%}
    {%- if why_first == '[' -%}
      <ul>
        {%- for w in why -%}<li>{{ w }}</li>{%- endfor -%}
      </ul>
    {%- else -%}
      <p>{{ why | newline_to_br }}</p>
    {%- endif -%}
  {%- endif -%}

  {%- if safety_important != blank or safety_general != blank or disclaimer != blank -%}
    <h3>Safety &amp; interactions</h3>
    {%- if safety_important != blank -%}
  <aside class="npx-important"><strong>Important:</strong> {{ safety_important }}</aside>
{%- endif -%}

    {%- if safety_general != blank -%}
      <p><strong>General safety:</strong> {{ safety_general }}</p>
    {%- endif -%}
    
    {%- if disclaimer != blank -%}
  <aside class="npx-disclaimer"><strong>Disclaimer:</strong> {{ disclaimer }}</aside>
{%- endif -%}

  {%- endif -%}

  {%- if faq != blank -%}
    <h3>FAQ</h3>
    {%- assign faq_first = faq | json | slice: 0, 1 -%}
    {%- if faq_first == '[' -%}
      {%- for i in faq -%}
        <p><strong>{{ forloop.index }}. {{ i.q | default: i.question | default: i.title }}</strong><br>{{ i.a | default: i.answer | default: i.text }}</p>
      {%- endfor -%}
    {%- else -%}
      <p>{{ faq | newline_to_br }}</p>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%}
  Fallback to Body HTML only if *everything* above is missing.
  (No parentheses – Liquid evaluates left-to-right.)
  {%- endcomment -%}
  {%- if tldr == blank and what_it_is == blank and feel == blank and feel_note == blank and how_it_works_text == blank and how == blank and why == blank and safety_important == blank and safety_general == blank and disclaimer == blank and faq == blank -%}
    {{ product.description }}
  {%- endif -%}
</div>
