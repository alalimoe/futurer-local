{% liquid
  assign instance_key = id | default: selector_position | default: 'currency'
  assign form_id = 'localization-form-' | append: section.id | append: '-' | append: instance_key | handleize
%}

<xo-currency-select class='xo-currency-select'>
  {% if localization.available_countries.size > 1 %}
    {%- form 'localization', id: form_id, class: 'xo-currency-select__form' -%}
      <xo-popover-trigger xo-name='{{ form_id }}' class='xo-currency-select__trigger' tabindex='0' role='button'>
        <div class='xo-currency-select__trigger-name'>
          <span>{{ localization.country.name -}}</span>
          <span>|</span>
          <span>
            {{- localization.country.currency.iso_code }}
            {{ localization.country.currency.symbol }}
          </span>
        </div>
        {% render 'icon', name: 'arrow-down', size: '20' %}
      </xo-popover-trigger>
      <xo-popover xo-name='{{ form_id }}' xo-placement='{% if selector_position == 'footer' %}top-center{% else %}bottom-center{% endif %}' class='xo-currency-select__content'>
        {%- for country in localization.available_countries -%}
          {% liquid
            assign input_id = 'Country--' | append: country.iso_code | append: '-' | append: form_id
            assign flag_url = country | image_url: width: 16 | replace: 'http://', 'https://'
            unless flag_url contains '://'
              assign flag_url = 'https:' | append: flag_url
            endunless
          %}
          <label class='xo-currency-select__item' tabindex='0' role='button' for='{{ input_id }}'>
            <input
              class='xo-currency-select__input'
              type='radio'
              name='country_code'
              value='{{ country.iso_code }}'
              id='{{ input_id }}'
              {%- if country.iso_code == localization.country.iso_code %}
                checked
              {% endif %}
            >
            <span class='xo-currency-select__name'>
              <img src='{{ flag_url }}' width='16' height='12' alt='{{ country.name | escape }}' loading='lazy'>
              {{ country.name }} | {{ country.currency.iso_code }}
              {{ country.currency.symbol }}
            </span>
          </label>
        {%- endfor -%}
      </xo-popover>
    {%- endform -%}
  {% endif %}
</xo-currency-select>
