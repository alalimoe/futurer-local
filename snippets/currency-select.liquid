{% liquid
  assign instance_key = id | default: selector_position | default: 'currency'
  assign form_id = 'localization-form-' | append: section.id | append: '-' | append: instance_key | handleize
  assign currency_code = localization.country.currency.iso_code
  assign flag_country = localization.country
  assign currency_home = ''
  if currency_code == 'AED'
    assign currency_home = 'AE'
  elsif currency_code == 'SAR'
    assign currency_home = 'SA'
  endif
  if currency_home != blank
    for country in localization.available_countries
      if country.iso_code == currency_home
        assign flag_country = country
        break
      endif
    endfor
  endif
  assign selected_flag_url = flag_country | image_url: width: 32 | replace: 'http://', 'https://'
  unless selected_flag_url contains '://'
    assign selected_flag_url = 'https:' | append: selected_flag_url
  endunless
%}

<xo-currency-select class='xo-currency-select'>
  {% if localization.available_countries.size > 1 %}
    {%- form 'localization', id: form_id, class: 'xo-currency-select__form' -%}
      <style>
        #{{ form_id }} .xo-currency-select__trigger {
          border: 0;
          background: transparent;
          color: inherit;
          font: inherit;
          padding: 0;
        }
        #{{ form_id }} .xo-currency-select__input {
          display: block;
          position: absolute;
          width: 1px;
          height: 1px;
          padding: 0;
          margin: -1px;
          overflow: hidden;
          clip-path: inset(50%);
          white-space: nowrap;
          border: 0;
        }
        #{{ form_id }} .xo-currency-select__input:focus-visible + .xo-currency-select__name {
          outline: 0.2rem solid currentColor;
          outline-offset: -0.2rem;
        }
        #{{ form_id }} xo-popover-trigger[xo-active] .xo-currency-select__trigger svg {
          transform: rotate(180deg);
        }
      </style>
      <xo-popover-trigger xo-name='{{ form_id }}'>
        <button
          type='button'
          class='xo-currency-select__trigger'
          aria-controls='{{ form_id }}-options'
          aria-label='{{ currency_code }}'
        >
          <img src='{{ selected_flag_url }}' width='16' height='12' alt='' decoding='async'>
          <span class='xo-currency-select__trigger-name'>{{ currency_code }}</span>
          {% render 'icon', name: 'arrow-down', size: '20' %}
        </button>
      </xo-popover-trigger>
      <xo-popover id='{{ form_id }}-options' xo-name='{{ form_id }}' xo-placement='{% if selector_position == 'footer' %}top-center{% else %}bottom-center{% endif %}' class='xo-currency-select__content'>
        {%- for country in localization.available_countries -%}
          {% liquid
            assign input_id = 'Country--' | append: country.iso_code | append: '-' | append: form_id
          %}
          <label class='xo-currency-select__item' for='{{ input_id }}'>
            <input
              class='xo-currency-select__input'
              type='radio'
              name='country_code'
              value='{{ country.iso_code }}'
              id='{{ input_id }}'
              {%- if country.iso_code == localization.country.iso_code %}
                checked
              {% endif %}
            >
            <span class='xo-currency-select__name'>
              {{ country.name }} | {{ country.currency.iso_code }}
              {{ country.currency.symbol }}
            </span>
          </label>
        {%- endfor -%}
      </xo-popover>
    {%- endform -%}
  {% endif %}
</xo-currency-select>
