{% doc %}
  Canonical research-use-only (RUO) peptide disclaimer.
  Single source of truth — render on peptide PDPs and landing pages in later phases.

  @param {string} [class] - Optional wrapper class

  @example
  {% render 'disclaimer-peptide-ruo' %}
{% enddoc %}

{% liquid
  assign wrapper_class = class | default: 'policy-canonical policy-canonical--disclaimer disclaimer-peptide-ruo'
%}

{{ 'policy-canonical.css' | asset_url | stylesheet_tag }}

<p class="{{ wrapper_class }}" role="note">
  {{ 'policies.canonical.disclaimer_peptide_ruo' | t }}
</p>
