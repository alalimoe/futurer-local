{% doc %}
  NX01 launch promo strip for the announcement bar.

  @param {string} message - Promo message text
  @param {string} url - Link destination

  @example
  {% render 'announcement-nx01-promo', message: promo_message, url: promo_url %}
{% enddoc %}

<a
  class="xo-announcement-nx01-promo"
  href="{{ url | default: '/products/nx01-baseline' }}"
  data-nx01-promo
>
  <span class="xo-announcement-nx01-promo__text">{{ message }}</span>
</a>

{% stylesheet %}
  .xo-announcement-nx01-promo {
    display: block;
    text-align: center;
    padding: 0.8rem 1.6rem;
    text-decoration: none;
    color: inherit;
    font-size: 1.3rem;
    font-weight: 500;
    background: color-mix(in srgb, rgba(var(--color-accent)) 12%, rgba(var(--color-background)));
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-accent)) 25%, transparent);
    transition: background-color 0.2s ease;
  }
  .xo-announcement-nx01-promo:hover {
    background: color-mix(in srgb, rgba(var(--color-accent)) 20%, rgba(var(--color-background)));
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .xo-announcement-nx01-promo:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: -2px;
  }
{% endstylesheet %}
