{% doc %}
Renders a Last chance badge when total Shopify-tracked inventory (deny oversell) is below the theme threshold.

@param {object} product - Product Liquid object
@param {number} [threshold] - Optional threshold override; otherwise uses theme setting with fallback 10

@example
{% render 'badge-last-chance', product: product %}
{% enddoc %}

{%- liquid
  assign effective_threshold = threshold | default: settings.last_chance_threshold | default: 10
  if effective_threshold < 1
    assign effective_threshold = 1
  endif

  assign total_tracked = 0
  for variant in product.variants
    if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
      if variant.inventory_quantity > 0
        assign total_tracked = total_tracked | plus: variant.inventory_quantity
      endif
    endif
  endfor
-%}

{%- if total_tracked > 0 and total_tracked < effective_threshold -%}
  <div class="xo-badge-last-chance{% if settings.enable_border_radius %} xo-badge-last-chance--radius{% endif %}">
    <span class="xo-badge-last-chance__title">{{ 'products.product.last_chance' | t }}</span>
  </div>
{%- endif -%}
