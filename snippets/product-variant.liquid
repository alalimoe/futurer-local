{% comment %}
  Renders a product variant

  Accepts:
  - style: {String} The style of the radio buttons. Accepts 'radio' | 'boxed' | 'select' | 'color'
  - option: {Object} The product variant option to render.
  - select_custom_popover_name_suffix: {String} Suffix for popover name (optional)
  Usage:
  {% render 'product-variant', option: option, product: product %}
{% endcomment %}

{% liquid
  assign placement = placement | default: 'bottom-left'
  assign hide_pph_100 = false
  if product.handle == 'phenylpiracetam-hydrazide-150mg-capsules'
    assign hide_pph_100 = true
  endif
%}

<div class="xo-product-variant">
  {% if style == 'select' %}
    <div class="xo-product-variant__top">
      <div class="xo-product-variant__top-name">
        <span>{{ option.name }}</span>
        <span class="xo-product-variant__value-selected">{{ option.selected_value }}</span>
      </div>
    </div>
    {% capture options %}
      <div class="xo-product-variant__inner">
        {% liquid
          for value in option.values
            assign value_label = value.name | default: value | append: '' | downcase | strip
            assign skip_value = false
            if hide_pph_100
              if value_label == '100ct'
                assign skip_value = true
              endif
            endif
            unless skip_value
              render 'field-select-custom-option', label: value, option: option, name: option.name, value: value, checked: value.selected, option_value_id: value.id, variant_id: value.variant.id, use_with: 'product-variant'
            endunless
          endfor
        %}
      </div>
    {% endcapture %}
    {% render 'field-select-custom',
      use_with: 'product-variant',
      option: option,
      name: option.name,
      value: option.selected_value,
      options: options,
      placement: placement,
      popover_name_suffix: select_custom_popover_name_suffix
    %}

  {% elsif style == 'color' %}
    <div class="xo-product-variant__inner">
      <div class="xo-product-variant__inner-name">
        <span>{{ option.name }}</span>
        <span class="xo-product-variant__value-selected">{{ option.selected_value }}</span>
      </div>
      <div class="xo-product-variant__inner-value">
        {% for value in option.values %}
          {% assign value_label = value.name | default: value | append: '' | downcase | strip %}
          {% assign skip_value = false %}
          {% if hide_pph_100 %}
            {% if value_label == '100ct' %}
              {% assign skip_value = true %}
            {% endif %}
          {% endif %}
          {% unless skip_value %}
            {% render 'field-color',
              style: style,
              option: option,
              name: option.name,
              value: value,
              label: value,
              image: value.swatch.image,
              use_image: true,
              use_with: 'product-variant'
            %}
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  {%- elsif style == 'variant_image' -%}
    <div class="xo-product-variant__inner">
      <div class="xo-product-variant__inner-name">
        <span>{{ option.name }}</span>
        <span class="xo-product-variant__value-selected">{{ option.selected_value }}</span>
      </div>
      <div class="xo-product-variant__inner-value">
        {% for value in option.values %}
          {% assign value_label = value.name | default: value | append: '' | downcase | strip %}
          {% assign skip_value = false %}
          {% if hide_pph_100 %}
            {% if value_label == '100ct' %}
              {% assign skip_value = true %}
            {% endif %}
          {% endif %}
          {% unless skip_value %}
            {% render 'field-color',
              style: style,
              option: option,
              name: option.name,
              value: value,
              label: value,
              image: value.variant.featured_image,
              use_image: true,
              use_with: 'product-variant'
            %}
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  {% else %}
    {% liquid
      assign show_pill_price = false
      assign baseline_unit = 0
      if product.options.size == 1
        assign show_pill_price = true
        for value in option.values
          assign value_label = value.name | default: value | append: '' | downcase | strip
          assign skip_value = false
          if hide_pph_100
            if value_label == '100ct'
              assign skip_value = true
            endif
          endif
          unless skip_value
            if value.variant.available and value.variant.price != blank
              assign count = value_label | replace: 'ct', '' | replace: ' ', '' | plus: 0
              if count > 0
                assign unit = value.variant.price | times: 1.0 | divided_by: count
                if baseline_unit == 0 or unit > baseline_unit
                  assign baseline_unit = unit
                endif
              endif
            endif
          endunless
        endfor
      endif
    %}
    <div class="xo-product-variant__inner">
      <div class="xo-product-variant__inner-name">
        <span>{{ option.name }}</span>
        <span class="xo-product-variant__value-selected">{{ option.selected_value }}</span>
      </div>
      <div class="xo-product-variant__inner-value">
        {% for value in option.values %}
          {% liquid
            assign value_label = value.name | default: value | append: '' | downcase | strip
            assign skip_value = false
            if hide_pph_100
              if value_label == '100ct'
                assign skip_value = true
              endif
            endif
            assign pill_price = ''
            assign save_label = ''
            if show_pill_price and value.variant.price != blank
              assign pill_price = value.variant.price | money
              assign count = value_label | replace: 'ct', '' | replace: ' ', '' | plus: 0
              if count > 0 and baseline_unit > 0 and value.variant.available
                assign unit = value.variant.price | times: 1.0 | divided_by: count
                assign diff = baseline_unit | minus: unit
                assign pct = diff | times: 100.0 | divided_by: baseline_unit | round
                if pct >= 5
                  assign save_label = 'products.product.save_percent' | t: percent: pct
                endif
              endif
            endif
          %}
          {% unless skip_value %}
            {% render 'field-radio', style: style, option: option, name: option.name, value: value, label: value, checked: value.selected, use_with: 'product-variant', price: pill_price, save_label: save_label %}
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>
