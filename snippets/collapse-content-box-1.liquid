{% doc %}
  Renders collapse / FAQ content.

  @param {string} class - Heading size class
  @param {string} heading - Section heading
  @param {string} [subheading] - Optional subheading
  @param {object} block - Section blocks
  @param {string} [accordion_style] - legacy, native, or list
  @param {boolean} [show_view_all_link] - Show footer link
  @param {string} [view_all_label] - Footer link label
  @param {string} [view_all_url] - Footer link URL
  @param {boolean} [show_disclaimer] - Show disclaimer
  @param {string} [disclaimer_text] - Disclaimer HTML

  @example
    {% render 'collapse-content-box-1', class: class, heading: heading, block: block %}
{% enddoc %}

{% liquid
  assign accordion_style = accordion_style | default: 'legacy'
  assign heading_plain = heading | strip_html
%}

<div class="collapse-content-box-1{% if accordion_style == 'native' %} collapse-content-box-1--native{% endif %}{% if accordion_style == 'list' %} collapse-content-box-1--list{% endif %}">
  {% if accordion_style == 'list' %}
    <div class="faq-hairline__layout">
      {% if heading_plain != blank or subheading != blank %}
        <header class="faq-hairline__intro">
          {% render 'section-heading',
            heading: heading_plain,
            description: subheading,
            heading_tag: 'h2',
            align: 'left',
            font_size_mobile: 32,
            font_size_desktop: 48
          %}
        </header>
      {% endif %}

      <div class="faq-hairline__body">
        <div class="faq-hairline">
          {% for item in block %}
            {% liquid
              assign title = item.settings.title | strip_html
              assign content = item.settings.content
            %}
            <article class="faq-hairline__item" {{ item.shopify_attributes }}>
              <details class="faq-hairline__row">
                <summary class="faq-hairline__summary">
                  <h3 class="faq-hairline__question">{{ title | escape }}</h3>
                </summary>
                <div class="faq-hairline__answer rte">
                  {{ content }}
                </div>
              </details>
            </article>
          {% endfor %}
        </div>

        {% if show_view_all_link and view_all_label != blank and view_all_url != blank %}
          <div class="faq-hairline__view-all">
            {% render 'button',
              text: view_all_label,
              link: view_all_url,
              style: 'link'
            %}
          </div>
        {% endif %}

        {% if show_disclaimer and disclaimer_text != blank %}
          <aside class="faq-hairline__disclaimer">
            <small>{{ disclaimer_text }}</small>
          </aside>
        {% endif %}
      </div>
    </div>
  {% elsif accordion_style == 'native' %}
    {% if heading_plain != blank or subheading != blank %}
      {% render 'section-heading',
        heading: heading_plain,
        description: subheading,
        heading_tag: 'h2'
      %}
    {% endif %}

    <div class="cc-faq__list">
      {% for item in block %}
        {% liquid
          assign title = item.settings.title | strip_html
          assign content = item.settings.content
        %}
        <article {{ item.shopify_attributes }}>
          <details class="cc-faq__card">
            <summary class="cc-faq__summary">
              <h3 class="cc-faq__question">{{ title | escape }}</h3>
            </summary>
            <div class="cc-faq__answer rte">
              {{ content }}
            </div>
          </details>
        </article>
      {% endfor %}
    </div>

    {% if show_view_all_link and view_all_label != blank and view_all_url != blank %}
      <div class="cc-faq__view-all">
        {% render 'button',
          text: view_all_label,
          link: view_all_url,
          style: 'link'
        %}
      </div>
    {% endif %}

    {% if show_disclaimer and disclaimer_text != blank %}
      <aside class="cc-faq__disclaimer">
        <small>{{ disclaimer_text }}</small>
      </aside>
    {% endif %}
  {% else %}
    {% if heading %}
      <xo-animate xo-cascade>
        <h3 class="collapse-content-box-1__heading {{ class }}">{{ heading }}</h3>
      </xo-animate>
    {% endif %}
    <xo-collapse-provider>
      <div class="collapse-content-box-1__content">
        {% for item in block %}
          {% liquid
            assign title = item.settings.title
            assign content = item.settings.content
            assign name = 'heading-' | append: forloop.index
          %}
          <xo-animate xo-cascade>
            <div class="collapse-content-box-1__item {% if settings.enable_border_radius %}collapse-content-box-1__item--radius{% endif %}">
              {% render 'collapse', title: title, content: content, name: name, show_icon_arrow: false %}
            </div>
          </xo-animate>
        {% endfor %}
      </div>
    </xo-collapse-provider>
  {% endif %}
</div>
