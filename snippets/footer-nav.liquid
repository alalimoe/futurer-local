{% comment %}
  Footer nav

  Accepts:
  - footer_menu: {Object} Footer menu (required)
  - heading: {String} Heading (optional)

  Usage:
  {% render 'footer-nav', footer_menu: footer_menu, heading: heading %}
{% endcomment %}

{% liquid
  assign nav_heading = heading
  if nav_heading == blank
    assign nav_heading = footer_menu.title
  endif
%}

{% if footer_menu != blank %}
  <nav class="xo-footer-nav" aria-label="{{ nav_heading | strip_html | escape }}">
    <h2 class="xo-footer-nav__title">
      {{ nav_heading }}
    </h2>
    <ul class="xo-footer-nav__list">
      {%- for link in footer_menu.links -%}
        <li class="xo-footer-nav__item">
          <a href="{{ link.url }}" class="xo-footer-nav__link" xo-animate-text-normal-hover>
            {% render 'animate-text-normal', text: link.title, effect: 'underline-in' %}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
{% endif %}
