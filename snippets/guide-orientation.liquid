{% doc %}
  Compact page orientation: what this guide answers, what it does not, educational note.
  @param {string} answers - Question this page answers
  @param {string} does_not - What this page does not provide
  @param {string} [note] - Educational / not medical-advice line
  @example
  {% render 'guide-orientation', answers: 'How much to take on an on-day', does_not: 'A personal medical plan', note: 'Educational only.' %}
{% enddoc %}

<div class="guide-orient">
  {%- if answers != blank -%}
    <p class="guide-orient__row">
      <span class="guide-orient__label">This page answers</span>
      <span class="guide-orient__text">{{ answers }}</span>
    </p>
  {%- endif -%}
  {%- if does_not != blank -%}
    <p class="guide-orient__row">
      <span class="guide-orient__label">It does not</span>
      <span class="guide-orient__text">{{ does_not }}</span>
    </p>
  {%- endif -%}
  {%- if note != blank -%}
    <p class="guide-orient__note">{{ note }}</p>
  {%- endif -%}
</div>
