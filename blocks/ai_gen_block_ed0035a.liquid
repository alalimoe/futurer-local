{% doc %}
  @prompt
    Design a section explaining where NX-01 sits within a broader nootropic routine.
    
    HEADLINE
    “Foundation first. Everything else is optional.”
    
    Create a simple layered stack diagram:
    
    BASE LAYER
    NX-01
    Daily foundation
    
    OPTIONAL LAYERS ABOVE
    Coffee / caffeine
    Targeted nootropics
    Situational products
    Sleep / recovery support
    
    The key concept:
    NX-01 is intended to be the baseline rather than replacing every possible cognitive product.
    
    Use elegant horizontal or stacked architecture similar to a software stack diagram.
    
    Avoid making combinations sound medically guaranteed or universally appropriate.
    
    Include small note:
    “Check for overlapping ingredients when combining products.”
    
    CTA:
    “Build Around NX-01”
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-routine-stack-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding:{{ block.settings.section_padding }}px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};box-sizing:border-box}.ai-routine-stack-{{ ai_gen_id }}__inner{max-width:980px;margin:0 auto}.ai-routine-stack-{{ ai_gen_id }}__eyebrow{margin:0 0 12px;color:{{ block.settings.accent_color }};font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.ai-routine-stack-{{ ai_gen_id }}__heading{max-width:700px;margin:0;font-size:clamp(30px,5vw,58px);font-weight:700;letter-spacing:-.04em;line-height:1.02}.ai-routine-stack-{{ ai_gen_id }}__intro{max-width:620px;margin:20px 0 0;color:{{ block.settings.muted_text_color }};font-size:16px;line-height:1.65}.ai-routine-stack-{{ ai_gen_id }}__diagram{display:flex;flex-direction:column;gap:10px;max-width:760px;margin:44px auto 0}.ai-routine-stack-{{ ai_gen_id }}__label{margin:0 0 4px;color:{{ block.settings.muted_text_color }};font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.ai-routine-stack-{{ ai_gen_id }}__optional{display:flex;flex-direction:column;gap:8px}.ai-routine-stack-{{ ai_gen_id }}__layer{display:flex;align-items:center;gap:20px;min-height:68px;padding:18px 24px;border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.border_radius }}px;background:{{ block.settings.optional_layer_color }};box-sizing:border-box}.ai-routine-stack-{{ ai_gen_id }}__layer--base{min-height:92px;border-color:{{ block.settings.base_layer_color }};background:{{ block.settings.base_layer_color }};color:{{ block.settings.base_text_color }}}.ai-routine-stack-{{ ai_gen_id }}__content{flex:1}.ai-routine-stack-{{ ai_gen_id }}__layer-title{margin:0;font-size:17px;font-weight:700;line-height:1.25}.ai-routine-stack-{{ ai_gen_id }}__layer-note{margin:4px 0 0;color:{{ block.settings.muted_text_color }};font-size:13px}.ai-routine-stack-{{ ai_gen_id }}__layer--base .ai-routine-stack-{{ ai_gen_id }}__layer-note{color:{{ block.settings.base_text_color }};opacity:.78}.ai-routine-stack-{{ ai_gen_id }}__index{display:grid;flex:0 0 30px;width:30px;height:30px;place-items:center;border:1px solid currentColor;border-radius:50%;font-size:12px;font-weight:700;opacity:.7}.ai-routine-stack-{{ ai_gen_id }}__foot{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:30px}.ai-routine-stack-{{ ai_gen_id }}__note{margin:0;color:{{ block.settings.muted_text_color }};font-size:12px;line-height:1.5}.ai-routine-stack-{{ ai_gen_id }}__cta{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 22px;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font-size:14px;font-weight:700;text-decoration:none}.ai-routine-stack-{{ ai_gen_id }}__cta:hover{opacity:.84}.ai-routine-stack-{{ ai_gen_id }}__cta:focus-visible{outline:3px solid {{ block.settings.accent_color }};outline-offset:3px}@media screen and (max-width:749px){.ai-routine-stack-{{ ai_gen_id }}{padding:{{ block.settings.mobile_padding }}px 18px}.ai-routine-stack-{{ ai_gen_id }}__layer{padding:15px 16px}.ai-routine-stack-{{ ai_gen_id }}__foot{align-items:stretch;flex-direction:column;gap:18px}.ai-routine-stack-{{ ai_gen_id }}__cta{width:100%}}
{% endstyle %}
<div class="ai-routine-stack-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-routine-stack-{{ ai_gen_id }}__inner"><p class="ai-routine-stack-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p><h2 class="ai-routine-stack-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2><p class="ai-routine-stack-{{ ai_gen_id }}__intro">{{ block.settings.intro | escape }}</p><div class="ai-routine-stack-{{ ai_gen_id }}__diagram"><div><p class="ai-routine-stack-{{ ai_gen_id }}__label">{{ block.settings.optional_label | escape }}</p><div class="ai-routine-stack-{{ ai_gen_id }}__optional">{% for i in (4..1) %}{% assign title_key = 'layer_' | append: i | append: '_title' %}<div class="ai-routine-stack-{{ ai_gen_id }}__layer"><span class="ai-routine-stack-{{ ai_gen_id }}__index">{{ i }}</span><div class="ai-routine-stack-{{ ai_gen_id }}__content"><p class="ai-routine-stack-{{ ai_gen_id }}__layer-title">{{ block.settings[title_key] | escape }}</p></div></div>{% endfor %}</div></div><div><p class="ai-routine-stack-{{ ai_gen_id }}__label">{{ block.settings.base_label | escape }}</p><div class="ai-routine-stack-{{ ai_gen_id }}__layer ai-routine-stack-{{ ai_gen_id }}__layer--base"><div class="ai-routine-stack-{{ ai_gen_id }}__content"><p class="ai-routine-stack-{{ ai_gen_id }}__layer-title">{{ block.settings.base_title | escape }}</p><p class="ai-routine-stack-{{ ai_gen_id }}__layer-note">{{ block.settings.base_note | escape }}</p></div><span class="ai-routine-stack-{{ ai_gen_id }}__index">0</span></div></div></div><div class="ai-routine-stack-{{ ai_gen_id }}__foot"><p class="ai-routine-stack-{{ ai_gen_id }}__note">{{ block.settings.note | escape }}</p>{% if block.settings.cta_link != blank %}<a class="ai-routine-stack-{{ ai_gen_id }}__cta" href="{{ block.settings.cta_link }}">{{ block.settings.cta_label | escape }}</a>{% endif %}</div></div></div>
{% schema %}{"name":"Nootropic routine stack","settings":[{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The NX-01 approach"},{"type":"text","id":"heading","label":"Headline","default":"Foundation first. Everything else is optional."},{"type":"textarea","id":"intro","label":"Introduction","default":"NX-01 is designed as a baseline for your routine, not as a replacement for every cognitive product. Build around it thoughtfully and choose additional layers based on your own needs and preferences."},{"type":"text","id":"optional_label","label":"Optional label","default":"Optional layers above"},{"type":"text","id":"layer_1_title","label":"Layer 1","default":"Coffee / caffeine"},{"type":"text","id":"layer_2_title","label":"Layer 2","default":"Targeted nootropics"},{"type":"text","id":"layer_3_title","label":"Layer 3","default":"Situational products"},{"type":"text","id":"layer_4_title","label":"Layer 4","default":"Sleep / recovery support"},{"type":"text","id":"base_label","label":"Base label","default":"Base layer"},{"type":"text","id":"base_title","label":"Base title","default":"NX-01"},{"type":"text","id":"base_note","label":"Base note","default":"Daily foundation"},{"type":"text","id":"note","label":"Note","default":"Check for overlapping ingredients when combining products."},{"type":"text","id":"cta_label","label":"Button label","default":"Build Around NX-01"},{"type":"url","id":"cta_link","label":"Button link"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding","label":"Desktop padding","min":20,"max":120,"step":10,"unit":"px","default":60},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":20,"max":80,"step":10,"unit":"px","default":40},{"type":"range","id":"border_radius","label":"Layer radius","min":0,"max":24,"step":2,"unit":"px","default":6},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":6},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#F9F9F9"},{"type":"color","id":"text_color","label":"Text","default":"#2A2A2A"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#666666"},{"type":"color","id":"border_color","label":"Border","default":"#D8D8D8"},{"type":"color","id":"optional_layer_color","label":"Optional layers","default":"#FFFFFF"},{"type":"color","id":"base_layer_color","label":"Base layer","default":"#2A2A2A"},{"type":"color","id":"base_text_color","label":"Base text","default":"#FFFFFF"},{"type":"color","id":"accent_color","label":"Accent","default":"#5A9D6F"},{"type":"color","id":"button_color","label":"Button","default":"#5A9D6F"},{"type":"color","id":"button_text_color","label":"Button text","default":"#FFFFFF"}],"presets":[{"name":"Nootropic routine stack"}],"tag":null,"class":"nootropic-routine-stack"}{% endschema %}