{% liquid
  assign spacing_dt = block.settings.spacing_dt
  assign spacing_mb = block.settings.spacing_mb
%}

{% render 'space', spacing_dt: spacing_dt, spacing_mb: spacing_mb %}


{% schema %}
{
  "name": "t:blocks.spacing.name",
  "settings": [
    {
      "type": "number",
      "id": "spacing_dt",
      "label": "t:blocks.spacing.settings.spacing_dt.label",
      "default": 10
    },
    {
      "type": "number",
      "id": "spacing_mb",
      "label": "t:blocks.spacing.settings.spacing_mb.label",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.spacing.presets.name"
    }
  ]
}
{% endschema %}