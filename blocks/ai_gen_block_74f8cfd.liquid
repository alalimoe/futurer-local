{% doc %}
  @prompt
    create a modern, clean 'Shop by goal' section with customizable settings to select which collections to display in it (include breadcrumbs, page title, followed by the selected collections
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{%- style -%}
  .ai-shop-by-goal-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: rgba(var(--color-background));
  }

  .ai-shop-by-goal-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
  }

  .ai-shop-by-goal-breadcrumbs-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.breadcrumb_spacing }}px;
    font-size: {{ block.settings.breadcrumb_font_size }}px;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 40%, transparent);
  }

  .ai-shop-by-goal-breadcrumbs-{{ ai_gen_id }} a {
    color: rgba(var(--color-foreground));
    text-decoration: none;
    transition: color 0.3s var(--out-soft, ease);
  }

  .ai-shop-by-goal-breadcrumbs-{{ ai_gen_id }} a:hover {
    color: rgba(var(--color-accent));
  }

  .ai-shop-by-goal-breadcrumbs-{{ ai_gen_id }} .separator {
    margin: 0 8px;
    opacity: 0.5;
  }

  .ai-shop-by-goal-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-shop-by-goal-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: rgba(var(--color-foreground));
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-shop-by-goal-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 40%, transparent);
    margin: 0;
    line-height: 1.6;
  }

  .ai-shop-by-goal-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  @media screen and (max-width: 768px) {
    .ai-shop-by-goal-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-shop-by-goal-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size }}px * 0.8);
    }
  }

  .ai-shop-by-goal-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: rgba(var(--color-background));
    transition: transform 0.3s var(--out-soft, ease);
    display: flex;
    flex-direction: column;
  }

  .ai-shop-by-goal-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-shop-by-goal-card-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-shop-by-goal-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: rgba(var(--color-background-2));
  }

  .ai-shop-by-goal-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-shop-by-goal-card-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(var(--color-background-2));
  }

  .ai-shop-by-goal-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-shop-by-goal-card-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: {{ block.settings.overlay_gradient }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
  }

  .ai-shop-by-goal-card-{{ ai_gen_id }}:hover .ai-shop-by-goal-card-overlay-{{ ai_gen_id }} {
    opacity: {{ block.settings.overlay_hover_opacity | divided_by: 100.0 }};
  }

  .ai-shop-by-goal-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: {{ block.settings.card_text_alignment }};
  }

  .ai-shop-by-goal-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_font_size }}px;
    color: rgba(var(--color-foreground));
    margin: 0 0 8px;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-shop-by-goal-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_font_size }}px;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 40%, transparent);
    margin: 0;
    line-height: 1.5;
  }

  .ai-shop-by-goal-card-count-{{ ai_gen_id }} {
    margin: 8px 0 0;
    font-size: 13px;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  }

  .ai-shop-by-goal-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 40%, transparent);
  }

  .ai-shop-by-goal-empty-state-{{ ai_gen_id }} p {
    font-size: 16px;
    margin: 0;
  }
{%- endstyle -%}

<div
  class="ai-shop-by-goal-{{ ai_gen_id }} color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-shop-by-goal-container-{{ ai_gen_id }}">
    {% if block.settings.show_breadcrumbs %}
      <nav class="ai-shop-by-goal-breadcrumbs-{{ ai_gen_id }}" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="separator">›</span>
        <span>{{ block.settings.page_title }}</span>
      </nav>
    {% endif %}

    <div class="ai-shop-by-goal-header-{{ ai_gen_id }}">
      {% if block.settings.page_title != blank %}
        <h1 class="ai-shop-by-goal-title-{{ ai_gen_id }}">{{ block.settings.page_title }}</h1>
      {% endif %}

      {% if block.settings.page_description != blank %}
        <div class="ai-shop-by-goal-description-{{ ai_gen_id }}">
          {{ block.settings.page_description }}
        </div>
      {% endif %}
    </div>

    {% liquid
      assign goal_count = 0
      assign goal_seen = '|'
      assign canonical_goal_handles = '|goal-focus-deep-work|goal-memory-learning|goal-mood-stress|goal-energy-wakefulness|goal-sleep-recovery|goal-neuroprotection-longevity|'
      assign goal_image_class = 'ai-shop-by-goal-card-image-' | append: ai_gen_id

      capture goal_cards
        if block.settings.goal_menu != blank
          for goal_link in block.settings.goal_menu.links
            assign goal_collection = goal_link.object
            assign goal_handle_token = '|' | append: goal_collection.handle | append: '|'
            if goal_link.type == 'collection_link' and goal_collection != blank and canonical_goal_handles contains goal_handle_token and goal_collection.published_at != blank and goal_collection.all_products_count > 0
              unless goal_seen contains goal_handle_token
                assign goal_seen = goal_seen | append: goal_collection.handle | append: '|'
                assign goal_count = goal_count | plus: 1
                assign goal_image = goal_collection.featured_image | default: goal_collection.image
                assign goal_image_alt = goal_image.alt | default: goal_collection.title
                assign goal_loading = 'lazy'
                assign goal_priority = 'auto'
                if goal_count == 1
                  assign goal_loading = 'eager'
                  assign goal_priority = 'high'
                endif
                echo '<article class="ai-shop-by-goal-card-' | append: ai_gen_id | append: '"><a href="' | append: goal_collection.url | append: '" class="ai-shop-by-goal-card-link-' | append: ai_gen_id | append: '">'
                echo '<div class="ai-shop-by-goal-card-image-wrapper-' | append: ai_gen_id | append: '">'
                if goal_image != blank
                  echo goal_image | image_url: width: 1200 | image_tag: widths: '320, 480, 640, 800, 1000, 1200', sizes: '(min-width: 990px) 33vw, 50vw', loading: goal_loading, fetchpriority: goal_priority, decoding: 'async', class: goal_image_class, alt: goal_image_alt
                else
                  echo '<div class="ai-shop-by-goal-card-image-placeholder-' | append: ai_gen_id | append: '">'
                  echo 'collection-1' | placeholder_svg_tag
                  echo '</div>'
                endif
                echo '<div class="ai-shop-by-goal-card-overlay-' | append: ai_gen_id | append: '"></div></div>'
                echo '<div class="ai-shop-by-goal-card-content-' | append: ai_gen_id | append: '"><h2 class="ai-shop-by-goal-card-title-' | append: ai_gen_id | append: '">'
                echo goal_collection.title | escape
                echo '</h2>'
                if block.settings.show_collection_description and goal_collection.description != blank
                  echo '<p class="ai-shop-by-goal-card-description-' | append: ai_gen_id | append: '">'
                  echo goal_collection.description | strip_html | truncatewords: 18 | escape
                  echo '</p>'
                endif
                echo '<p class="ai-shop-by-goal-card-count-' | append: ai_gen_id | append: '">'
                echo goal_collection.all_products_count
                echo ' '
                echo goal_collection.all_products_count | pluralize: 'product', 'products'
                echo '</p></div></a></article>'
              endunless
            endif
          endfor
        endif

        for i in (1..8)
          assign collection_key = 'collection_' | append: i
          assign goal_collection = block.settings[collection_key]
          assign goal_handle_token = '|' | append: goal_collection.handle | append: '|'
          if goal_collection != blank and canonical_goal_handles contains goal_handle_token and goal_collection.published_at != blank and goal_collection.all_products_count > 0
            unless goal_seen contains goal_handle_token
              assign goal_seen = goal_seen | append: goal_collection.handle | append: '|'
              assign goal_count = goal_count | plus: 1
              assign goal_image = goal_collection.featured_image | default: goal_collection.image
              assign goal_image_alt = goal_image.alt | default: goal_collection.title
              assign goal_loading = 'lazy'
              assign goal_priority = 'auto'
              if goal_count == 1
                assign goal_loading = 'eager'
                assign goal_priority = 'high'
              endif
              echo '<article class="ai-shop-by-goal-card-' | append: ai_gen_id | append: '"><a href="' | append: goal_collection.url | append: '" class="ai-shop-by-goal-card-link-' | append: ai_gen_id | append: '">'
              echo '<div class="ai-shop-by-goal-card-image-wrapper-' | append: ai_gen_id | append: '">'
              if goal_image != blank
                echo goal_image | image_url: width: 1200 | image_tag: widths: '320, 480, 640, 800, 1000, 1200', sizes: '(min-width: 990px) 33vw, 50vw', loading: goal_loading, fetchpriority: goal_priority, decoding: 'async', class: goal_image_class, alt: goal_image_alt
              else
                echo '<div class="ai-shop-by-goal-card-image-placeholder-' | append: ai_gen_id | append: '">'
                echo 'collection-1' | placeholder_svg_tag
                echo '</div>'
              endif
              echo '<div class="ai-shop-by-goal-card-overlay-' | append: ai_gen_id | append: '"></div></div>'
              echo '<div class="ai-shop-by-goal-card-content-' | append: ai_gen_id | append: '"><h2 class="ai-shop-by-goal-card-title-' | append: ai_gen_id | append: '">'
              echo goal_collection.title | escape
              echo '</h2>'
              if block.settings.show_collection_description and goal_collection.description != blank
                echo '<p class="ai-shop-by-goal-card-description-' | append: ai_gen_id | append: '">'
                echo goal_collection.description | strip_html | truncatewords: 18 | escape
                echo '</p>'
              endif
              echo '<p class="ai-shop-by-goal-card-count-' | append: ai_gen_id | append: '">'
              echo goal_collection.all_products_count
              echo ' '
              echo goal_collection.all_products_count | pluralize: 'product', 'products'
              echo '</p></div></a></article>'
            endunless
          endif
        endfor
      endcapture
    %}

    {% if goal_count > 0 %}
      <div class="ai-shop-by-goal-grid-{{ ai_gen_id }}">
        {{ goal_cards }}
      </div>
    {% else %}
      <div class="ai-shop-by-goal-empty-state-{{ ai_gen_id }}">
        <p>No live goal collections are configured.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Shop by goal",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default"
    },
    {
      "type": "header",
      "content": "Page content"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "page_title",
      "label": "Page title",
      "default": "Shop by goal"
    },
    {
      "type": "richtext",
      "id": "page_description",
      "label": "Page description",
      "default": "<p>Discover our curated collections designed to help you achieve your health and wellness goals.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "link_list",
      "id": "goal_menu",
      "label": "Shop-by-goal menu",
      "info": "Expected to contain the six canonical goal collections. Legacy collection pickers fill any missing goals."
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Collection 4"
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "Collection 5"
    },
    {
      "type": "collection",
      "id": "collection_6",
      "label": "Collection 6"
    },
    {
      "type": "collection",
      "id": "collection_7",
      "label": "Collection 7"
    },
    {
      "type": "collection",
      "id": "collection_8",
      "label": "Collection 8"
    },
    {
      "type": "checkbox",
