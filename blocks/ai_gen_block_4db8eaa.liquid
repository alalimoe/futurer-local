{% doc %}
  @prompt
    Design a founder-led story section for NX-01.
    
    HEADLINE
    “For years, we sold the pieces.”
    
    SUPPORTING STATEMENT
    “NX-01 is our answer to what belongs in the daily foundation.”
    
    CONTENT IDEA
    Communicate visually that Nootropix historically helped customers build stacks from individual compounds, but this created a recurring question:
    “What should I actually take every day?”
    
    NX-01 represents the first Nootropix-developed answer.
    
    LAYOUT
    Editorial split layout:
    left side = strong oversized typography / founder quote
    right side = concise explanation
    
    Include a visual transition from several individual Nootropix bottles into one NX-01 bottle.
    
    Keep the section sophisticated and restrained.
    Do not make it look like a corporate “About Us” section.
    
    This should build emotional and brand significance before going deeper into product details.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-founder-story-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px 0;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }

  .ai-founder-story-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr);
    align-items: center;
    gap: clamp(40px, 8vw, 140px);
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 5vw;
  }

  .ai-founder-story-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 24px;
    color: {{ block.settings.accent_color }};
    font-family: {{ block.settings.body_font.family }};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-founder-story-{{ ai_gen_id }}__headline {
    max-width: 680px;
    margin: 0;
    font-family: {{ block.settings.heading_font.family }};
    font-size: clamp(42px, 6vw, 92px);
    font-weight: 600;
    letter-spacing: -.055em;
    line-height: .98;
  }

  .ai-founder-story-{{ ai_gen_id }}__mark {
    display: block;
    width: 52px;
    height: 1px;
    margin-top: 42px;
    background: {{ block.settings.accent_color }};
  }

  .ai-founder-story-{{ ai_gen_id }}__copy {
    max-width: 500px;
  }

  .ai-founder-story-{{ ai_gen_id }}__statement {
    margin: 0 0 24px;
    font-family: {{ block.settings.heading_font.family }};
    font-size: clamp(27px, 3vw, 45px);
    letter-spacing: -.035em;
    line-height: 1.08;
  }

  .ai-founder-story-{{ ai_gen_id }}__body {
    margin: 0;
    color: {{ block.settings.muted_color }};
    font-family: {{ block.settings.body_font.family }};
    font-size: 16px;
    line-height: 1.7;
  }

  .ai-founder-story-{{ ai_gen_id }}__visual {
    position: relative;
    min-height: 300px;
    margin-top: 58px;
    border-top: 1px solid {{ block.settings.rule_color }};
    border-bottom: 1px solid {{ block.settings.rule_color }};
  }

  .ai-founder-story-{{ ai_gen_id }}__bottles {
    position: absolute;
    inset: 0 42% 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 8px;
    padding: 28px 0 20px;
  }

  .ai-founder-story-{{ ai_gen_id }}__bottle {
    width: 25%;
    height: 72%;
    object-fit: contain;
  }

  .ai-founder-story-{{ ai_gen_id }}__arrow {
    position: absolute;
    top: 50%;
    left: 53%;
    width: 34px;
    height: 1px;
    background: {{ block.settings.accent_color }};
  }

  .ai-founder-story-{{ ai_gen_id }}__arrow::after {
    position: absolute;
    right: 0;
    top: -4px;
    width: 8px;
    height: 8px;
    border-top: 1px solid {{ block.settings.accent_color }};
    border-right: 1px solid {{ block.settings.accent_color }};
    content: '';
    transform: rotate(45deg);
  }

  .ai-founder-story-{{ ai_gen_id }}__hero {
    position: absolute;
    right: 4%;
    bottom: 10%;
    width: 38%;
    height: 88%;
    object-fit: contain;
  }

  .ai-founder-story-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.muted_color }};
    background: {{ block.settings.placeholder_color }};
  }

  .ai-founder-story-{{ ai_gen_id }}__placeholder svg {
    width: 48%;
    height: 48%;
  }

  @media screen and (max-width: 749px) {
    .ai-founder-story-{{ ai_gen_id }} { padding: 56px 0; }
    .ai-founder-story-{{ ai_gen_id }}__inner { display: block; padding: 0 24px; }
    .ai-founder-story-{{ ai_gen_id }}__copy { margin-top: 52px; }
    .ai-founder-story-{{ ai_gen_id }}__visual { min-height: 240px; margin-top: 42px; }
  }
{% endstyle %}

<div class="ai-founder-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-founder-story-{{ ai_gen_id }}__inner">
    <div>
      {% if block.settings.eyebrow != blank %}<p class="ai-founder-story-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      <h2 class="ai-founder-story-{{ ai_gen_id }}__headline">{{ block.settings.headline | escape }}</h2>
      <span class="ai-founder-story-{{ ai_gen_id }}__mark"></span>
    </div>
    <div class="ai-founder-story-{{ ai_gen_id }}__copy">
      <p class="ai-founder-story-{{ ai_gen_id }}__statement">{{ block.settings.statement | escape }}</p>
      <p class="ai-founder-story-{{ ai_gen_id }}__body">{{ block.settings.body }}</p>
      <div class="ai-founder-story-{{ ai_gen_id }}__visual" aria-label="A transition from individual compounds to NX-01">
        <div class="ai-founder-story-{{ ai_gen_id }}__bottles">
          {% for bottle in (1..3) %}
            {% assign bottle_key = 'compound_' | append: bottle %}
            {% if block.settings[bottle_key] %}
              <img class="ai-founder-story-{{ ai_gen_id }}__bottle" src="{{ block.settings[bottle_key] | image_url: width: 300 }}" alt="" loading="lazy">
            {% else %}
              <div class="ai-founder-story-{{ ai_gen_id }}__bottle ai-founder-story-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
          {% endfor %}
        </div>
        <span class="ai-founder-story-{{ ai_gen_id }}__arrow" aria-hidden="true"></span>
        {% if block.settings.nx_image %}
          <img class="ai-founder-story-{{ ai_gen_id }}__hero" src="{{ block.settings.nx_image | image_url: width: 600 }}" alt="{{ block.settings.nx_image.alt | escape }}" loading="lazy">
        {% else %}
          <div class="ai-founder-story-{{ ai_gen_id }}__hero ai-founder-story-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Founder story",
  "settings": [
    { "type": "header", "content": "Story" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The beginning of NX-01" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "For years, we sold the pieces." },
    { "type": "text", "id": "statement", "label": "Statement", "default": "NX-01 is our answer to what belongs in the daily foundation." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>For years, we helped customers build thoughtful stacks from individual compounds. The question that kept returning was simple: what should I actually take every day? NX-01 is our first Nootropix-developed answer.</p>" },
    { "type": "header", "content": "Visual transition" },
    { "type": "image_picker", "id": "compound_1", "label": "Compound bottle 1" },
    { "type": "image_picker", "id": "compound_2", "label": "Compound bottle 2" },
    { "type": "image_picker", "id": "compound_3", "label": "Compound bottle 3" },
    { "type": "image_picker", "id": "nx_image", "label": "NX-01 bottle" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "vertical_padding", "label": "Vertical spacing", "min": 20, "max": 120, "step": 10, "unit": "px", "default": 80 },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "inter_n6" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "inter_n4" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f9f9f9" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2a2a2a" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#666666" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#5a9d6f" },
    { "type": "color", "id": "rule_color", "label": "Rules", "default": "#e8e8e8" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder", "default": "#f0f0f0" }
  ],
  "presets": [{ "name": "Founder story" }],
  "tag": null,
  "class": "founder-story-block"
}
{% endschema %}