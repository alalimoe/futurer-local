{{ 'section-product-highlight.css' | asset_url | stylesheet_tag }}

{% liquid
  assign image = section.settings.image

  assign aspect_ratio = section.settings.aspect_ratio
  if aspect_ratio == 'custom'
    assign aspect_ratio = section.settings.aspect_ratio_width | append: '/' | append: section.settings.aspect_ratio_height
  endif

  assign image_width = section.settings.image_width
%}

<div {% render 'section-attr' %}>
  <div class="product-highlight">
    <xo-container class="product-highlight__container">
      <div class="product-highlight__stage">
        <div class="product-highlight__product" style="--image-width: {{ image_width }}%">
          <xo-animate xo-cascade>
            {% render 'image', image: image, alt: image.alt, aspect_ratio: aspect_ratio, class: 'product-highlight__product-image' %}
          </xo-animate>
        </div>

        {% for block in section.blocks %}
          {% liquid
            assign a_image = block.settings.image
            assign a_text = block.settings.text
            assign top_dt = block.settings.top_dt
            assign left_dt = block.settings.left_dt
            assign width = block.settings.width
            assign show_line = block.settings.show_line
            assign line_direction = block.settings.line_direction | default: 'right'
            assign line_length = block.settings.line_length

            assign a_aspect_ratio = block.settings.image_aspect_ratio
            if a_aspect_ratio == 'custom'
              assign a_aspect_ratio = block.settings.image_aspect_ratio_width | append: '/' | append: block.settings.image_aspect_ratio_height
            endif

            assign annotation_class = 'product-highlight__annotation'
            if show_line
              assign annotation_class = annotation_class | append: ' product-highlight__annotation--has-line'
            endif
          %}
          <xo-animate
            xo-type="fade"
            class="{{ annotation_class }}"
            style="--top_dt: {{ top_dt }}; --left_dt: {{ left_dt }}; --width: {{ width }}rem; --line-length: {{ line_length }}rem"
            {{ block.shopify_attributes }}
          >
            {% if show_line and line_direction == 'left' %}
              <span class="product-highlight__line product-highlight__line--left"></span>
            {% endif %}

            <div class="product-highlight__annotation-inner">
              {% if a_image != blank %}
                <div class="product-highlight__annotation-image">
                  {% render 'image', image: a_image, aspect_ratio: a_aspect_ratio, disable_alt: true, class: 'product-highlight__annotation-image-media' %}
                </div>
              {% endif %}
              {% if a_text != blank %}
                <div class="product-highlight__annotation-text h5">{{ a_text }}</div>
              {% endif %}
            </div>

            {% if show_line and line_direction == 'right' %}
              <span class="product-highlight__line product-highlight__line--right"></span>
            {% endif %}
          </xo-animate>
        {% endfor %}
      </div>
    </xo-container>
  </div>
</div>

