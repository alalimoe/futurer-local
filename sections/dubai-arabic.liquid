{%- style -%}
  .xo-section--{{ section.id }} .dubai-arabic {
    max-width: 88rem;
    margin: 0 auto;
  }

  .xo-section--{{ section.id }} .dubai-arabic__header {
    max-width: 68rem;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .xo-section--{{ section.id }} .dubai-arabic__title {
    margin: 0 0 1.2rem;
    font-size: clamp(3.2rem, 5vw, 6.6rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .xo-section--{{ section.id }} .dubai-arabic__intro {
    margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
    font-size: 1.6rem;
    line-height: 1.8;
  }

  .xo-section--{{ section.id }} .dubai-arabic__item {
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
  }

  .xo-section--{{ section.id }} .dubai-arabic__item:last-child {
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
  }

  .xo-section--{{ section.id }} .dubai-arabic__question {
    display: flex;
    min-height: 6.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.8rem 0;
    color: rgba(var(--color-foreground));
    cursor: pointer;
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.6;
    list-style: none;
  }

  .xo-section--{{ section.id }} .dubai-arabic__question::-webkit-details-marker {
    display: none;
  }

  .xo-section--{{ section.id }} .dubai-arabic__icon {
    position: relative;
    width: 2rem;
    height: 2rem;
    flex: 0 0 2rem;
  }

  .xo-section--{{ section.id }} .dubai-arabic__icon::before,
  .xo-section--{{ section.id }} .dubai-arabic__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.4rem;
    height: 0.2rem;
    background: rgba(var(--color-foreground));
    transform: translate(-50%, -50%);
  }

  .xo-section--{{ section.id }} .dubai-arabic__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .xo-section--{{ section.id }} .dubai-arabic__item[open] .dubai-arabic__icon::after {
    display: none;
  }

  .xo-section--{{ section.id }} .dubai-arabic__answer {
    padding: 0 0 2.4rem 4rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
    font-size: 1.5rem;
    line-height: 1.85;
  }

  .xo-section--{{ section.id }} .dubai-arabic__answer p {
    margin: 0;
  }

  .xo-section--{{ section.id }} summary:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 3px;
  }
{%- endstyle -%}

{%- assign arabic_faqs = section.blocks | where: 'type', 'faq' -%}

<section id="dubai-arabic" {% render 'section-attr', section: section %} aria-labelledby="dubai-arabic-title-{{ section.id }}">
  <xo-container>
    <div class="dubai-arabic" lang="ar" dir="rtl">
      <header class="dubai-arabic__header">
        <h2 id="dubai-arabic-title-{{ section.id }}" class="dubai-arabic__title">{{ section.settings.heading }}</h2>
        <div class="dubai-arabic__intro">{{ section.settings.intro }}</div>
      </header>
      <div>
        {%- for block in arabic_faqs -%}
          <details class="dubai-arabic__item" {{ block.shopify_attributes }}>
            <summary class="dubai-arabic__question">
              <span>{{ block.settings.question }}</span>
              <span class="dubai-arabic__icon" aria-hidden="true"></span>
            </summary>
            <div class="dubai-arabic__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "Dubai Arabic FAQ",
  "tag": "section",
  "class": "section-dubai-arabic",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "النوتروبيكس في الإمارات" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>معلومات مختصرة وواضحة عن المنتجات والتوصيل المحلي المجاني داخل الإمارات من مستودعنا في دبي.</p>" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "سؤال",
      "settings": [
        { "type": "text", "id": "question", "label": "السؤال" },
        { "type": "richtext", "id": "answer", "label": "الإجابة" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Dubai Arabic FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "هل توصلون داخل الإمارات؟", "answer": "<p>نعم. التوصيل المحلي داخل الإمارات مجاني، سواء كان توصيلاً خلال ٤ ساعات داخل دبي أو في اليوم التالي لباقي الإمارات في أغلب الحالات.</p>" } },
        { "type": "faq", "settings": { "question": "كم يستغرق التوصيل داخل دبي؟", "answer": "<p>غالباً خلال ٤ ساعات حسب وقت الطلب والموقع. هذه مدة معتادة وليست ضماناً.</p>" } },
        { "type": "faq", "settings": { "question": "هل التوصيل المحلي مجاني؟", "answer": "<p>نعم. كل عمليات التوصيل المحلية داخل الإمارات مجانية.</p>" } },
        { "type": "faq", "settings": { "question": "هل تشحنون دولياً؟", "answer": "<p>نعم. الشحن الدولي السريع متاح مع التتبع. الشحن السريع مجاني للطلبات الدولية التي تتجاوز ٣٠٠ درهم.</p>" } },
        { "type": "faq", "settings": { "question": "ما هي النوتروبيكس؟", "answer": "<p>النوتروبيكس مصطلح عام لمنتجات يضيفها بعض الأشخاص إلى روتين يرتبط بالتركيز أو الذاكرة أو المزاج أو الطاقة أو النوم أو العافية طويلة المدى.</p>" } },
        { "type": "faq", "settings": { "question": "كيف أختار المنتج؟", "answer": "<p>ابدأ بهدف واحد واضح، وقارن قائمة المكونات الكاملة وإرشادات الاستخدام والتحذيرات، ثم اتبع تعليمات ملصق المنتج.</p>" } },
        { "type": "faq", "settings": { "question": "هل تتوفر شهادات التحليل؟", "answer": "<p>تتوفر شهادات التحليل للمنتجات المؤهلة. راجع مكتبة الشهادات أو تواصل مع الدعم.</p>" } },
        { "type": "faq", "settings": { "question": "هل هذه الصفحة نصيحة طبية؟", "answer": "<p>لا. هذه الصفحة للتثقيف فقط وليست نصيحة طبية.</p>" } }
      ]
    }
  ]
}
{% endschema %}
