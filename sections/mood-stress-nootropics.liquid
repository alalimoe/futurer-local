{%- liquid
  assign s = section.settings
  assign mood_collection = collections['mood-stress']
  assign mood_href = routes.all_products_collection_url
  if mood_collection != blank
    assign mood_href = mood_collection.url
  endif

  comment
    Legacy handle settings are retained but never resolved.
    Product cards require an explicit picker, current availability, and opt-in.
  endcomment
  assign mood_count = 0
-%}

{%- style -%}
  #mood-stress-{{ section.id }} {
    background: {{ s.background_color | default: '#ffffff' }};
    color: rgba(var(--color-foreground));
  }
  #mood-stress-{{ section.id }} .ms-inner {
    max-width: {{ s.max_width | default: 1100 }}px;
    margin: 0 auto;
    padding: {{ s.padding_y | default: 56 }}px var(--page-gutter);
  }
  #mood-stress-{{ section.id }} .ms-hero,
  #mood-stress-{{ section.id }} .ms-panel {
    padding: clamp(1.25rem, 4vw, 2.5rem);
    margin-bottom: 1.5rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
  }
  #mood-stress-{{ section.id }} .ms-hero { background: rgba(var(--color-background-2)); }
  #mood-stress-{{ section.id }} h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  #mood-stress-{{ section.id }} h2 { margin: 0 0 0.75rem; }
  #mood-stress-{{ section.id }} p,
  #mood-stress-{{ section.id }} li { line-height: 1.7; }
  #mood-stress-{{ section.id }} .ms-muted {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 68%, transparent);
  }
  #mood-stress-{{ section.id }} .ms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  #mood-stress-{{ section.id }} .ms-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
  }
  #mood-stress-{{ section.id }} .ms-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }
  #mood-stress-{{ section.id }} .ms-card a,
  #mood-stress-{{ section.id }} .ms-collection-link {
    margin-top: auto;
    color: rgba(var(--color-foreground));
    font-weight: 600;
    text-underline-offset: 0.25em;
  }
  #mood-stress-{{ section.id }} details {
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    padding: 0.8rem 0;
  }
  #mood-stress-{{ section.id }} summary { cursor: pointer; font-weight: 600; }
  #mood-stress-{{ section.id }} :focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }
{%- endstyle -%}

<section id="mood-stress-{{ section.id }}" aria-labelledby="mood-title-{{ section.id }}">
  <div class="ms-inner">
    <header class="ms-hero">
      <h1 id="mood-title-{{ section.id }}">{{ s.hero_title | default: 'Mood & Stress: An Evidence-Aware Guide' }}</h1>
      <p class="ms-muted">{{ s.hero_subtitle | default: 'Understand the limits of supplement evidence, recognize interaction risks, and know when stress or mood symptoms need professional care.' }}</p>
    </header>

    {% render 'guide-editorial-review' %}

    <section class="ms-panel" aria-labelledby="mood-scope-{{ section.id }}">
      <h2 id="mood-scope-{{ section.id }}">Stress support is not mental-health treatment</h2>
      <p>Everyday stress, poor sleep, burnout, anxiety disorders, and depressive symptoms are not interchangeable. A supplement marketed for “calm,” “mood,” or “stress” should not be used to diagnose or treat a mental-health condition.</p>
      <p>If symptoms are severe, persistent, rapidly worsening, or include thoughts of self-harm, seek urgent local professional support rather than relying on a product or this guide.</p>
    </section>

    <section class="ms-panel" aria-labelledby="mood-foundations-{{ section.id }}">
      <h2 id="mood-foundations-{{ section.id }}">Conservative first steps</h2>
      <ul>
        <li>Review sleep opportunity, caffeine and stimulant intake, alcohol or sedative use, workload, meals, movement, and social support.</li>
        <li>Do not use stimulating products to push through exhaustion; this can worsen sleep and stress.</li>
        <li>Introduce no universal stack or schedule. If a product is appropriate, the current label and professional guidance take precedence.</li>
      </ul>
    </section>

    <section class="ms-panel" aria-labelledby="mood-evidence-{{ section.id }}">
      <h2 id="mood-evidence-{{ section.id }}">Evidence limits</h2>
      <p>Evidence varies by ingredient, extract, formulation, population, and outcome. Small studies, self-reported outcomes, animal research, and mechanistic claims do not establish that a retail product will improve mood or resilience. Testimonials are not clinical evidence.</p>
    </section>

    <section class="ms-panel" aria-labelledby="mood-interactions-{{ section.id }}">
      <h2 id="mood-interactions-{{ section.id }}">Contraindication and interaction cues</h2>
      <p>Ask a qualified healthcare professional or pharmacist before use if you take antidepressants, anxiolytics, sedatives, stimulants, blood-pressure medicines, anticoagulants, or other medication; have a health condition; are pregnant or nursing; or are under 18. Ingredients that affect serotonin, sedation, stimulation, or blood pressure can create clinically important interactions.</p>
      <p><strong>This guide does not prescribe a dose, stack, or cycle.</strong></p>
    </section>

    {%- if s.show_product_references -%}
      <section class="ms-panel" aria-labelledby="mood-products-{{ section.id }}">
        <h2 id="mood-products-{{ section.id }}">Merchant-selected product references</h2>
        <p class="ms-muted">A product appears only when deliberately selected and currently available. Inclusion is not a treatment recommendation or an outcome guarantee.</p>
        <div class="ms-grid">
          {%- assign mood_product = s.product_1 -%}
          {%- if mood_product != blank and mood_product.available -%}
            {%- assign mood_count = mood_count | plus: 1 -%}
            <article class="ms-card">
              {%- if mood_product.featured_image -%}{{ mood_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: mood_product.title }}{%- endif -%}
              <h3>{{ mood_product.title }}</h3>
              <p class="ms-muted">{{ s.product_1_desc | default: "Review this product's current label, warnings, interactions, and evidence." }}</p>
              <a href="{{ mood_product.url }}">Review product label</a>
            </article>
          {%- endif -%}
          {%- assign mood_product = s.product_2 -%}
          {%- if mood_product != blank and mood_product.available -%}
            {%- assign mood_count = mood_count | plus: 1 -%}
            <article class="ms-card">
              {%- if mood_product.featured_image -%}{{ mood_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: mood_product.title }}{%- endif -%}
              <h3>{{ mood_product.title }}</h3>
              <p class="ms-muted">{{ s.product_2_desc | default: "Review this product's current label, warnings, interactions, and evidence." }}</p>
              <a href="{{ mood_product.url }}">Review product label</a>
            </article>
          {%- endif -%}
          {%- assign mood_product = s.product_3 -%}
          {%- if mood_product != blank and mood_product.available -%}
            {%- assign mood_count = mood_count | plus: 1 -%}
            <article class="ms-card">
              {%- if mood_product.featured_image -%}{{ mood_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: mood_product.title }}{%- endif -%}
              <h3>{{ mood_product.title }}</h3>
              <p class="ms-muted">{{ s.product_3_desc | default: "Review this product's current label, warnings, interactions, and evidence." }}</p>
              <a href="{{ mood_product.url }}">Review product label</a>
            </article>
          {%- endif -%}
          {%- assign mood_product = s.product_4 -%}
          {%- if mood_product != blank and mood_product.available -%}
            {%- assign mood_count = mood_count | plus: 1 -%}
            <article class="ms-card">
              {%- if mood_product.featured_image -%}{{ mood_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: mood_product.title }}{%- endif -%}
              <h3>{{ mood_product.title }}</h3>
              <p class="ms-muted">{{ s.product_4_desc | default: "Review this product's current label, warnings, interactions, and evidence." }}</p>
              <a href="{{ mood_product.url }}">Review product label</a>
            </article>
          {%- endif -%}
        </div>
        {%- if mood_count == 0 -%}
          <p><a class="ms-collection-link" href="{{ mood_href }}">Browse the current collection</a></p>
        {%- endif -%}
      </section>
    {%- endif -%}

    {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
    {%- if faq_blocks.size > 0 -%}
      <section class="ms-panel" aria-labelledby="mood-faq-{{ section.id }}">
        <h2 id="mood-faq-{{ section.id }}">Frequently asked questions</h2>
        {%- for block in faq_blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.q }}</summary>
            <p>{{ block.settings.a }}</p>
          </details>
        {%- endfor -%}
      </section>
    {%- endif -%}

    <p class="ms-muted">Educational information only; not medical advice and not intended to diagnose, treat, cure, or prevent disease.</p>
  </div>
</section>

{% schema %}
{
  "name": "Mood & Stress Guide",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_title", "label": "Hero title", "default": "Mood & Stress: An Evidence-Aware Guide" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Hero subtitle", "default": "Understand the limits of supplement evidence, recognize interaction risks, and know when stress or mood symptoms need professional care." },
    { "type": "image_picker", "id": "hero_image", "label": "Legacy hero image (not displayed)" },
    { "type": "text", "id": "hero_cta", "label": "Legacy hero CTA (not displayed)" },
    { "type": "url", "id": "collection_link", "label": "Legacy collection link (not displayed)" },
    { "type": "richtext", "id": "intro_text", "label": "Legacy intro (not displayed)" },
    { "type": "header", "content": "Optional product references" },
    { "type": "checkbox", "id": "show_product_references", "label": "Show selected, available products", "default": false },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "text", "id": "product_1_handle", "label": "Legacy handle 1 (not used)" },
    { "type": "text", "id": "product_1_desc", "label": "Product 1 context", "default": "Review this product's current label, warnings, interactions, and evidence." },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "text", "id": "product_2_handle", "label": "Legacy handle 2 (not used)" },
    { "type": "text", "id": "product_2_desc", "label": "Product 2 context", "default": "Review this product's current label, warnings, interactions, and evidence." },
    { "type": "product", "id": "product_3", "label": "Product 3" },
    { "type": "text", "id": "product_3_handle", "label": "Legacy handle 3 (not used)" },
    { "type": "text", "id": "product_3_desc", "label": "Product 3 context", "default": "Review this product's current label, warnings, interactions, and evidence." },
    { "type": "product", "id": "product_4", "label": "Product 4" },
    { "type": "text", "id": "product_4_handle", "label": "Legacy handle 4 (not used)" },
    { "type": "text", "id": "product_4_desc", "label": "Product 4 context", "default": "Review this product's current label, warnings, interactions, and evidence." },
    { "type": "header", "content": "Legacy trust icons" },
    { "type": "image_picker", "id": "icon_1_image", "label": "Legacy icon 1 (not displayed)" },
    { "type": "text", "id": "icon_1_title", "label": "Legacy icon text 1 (not displayed)" },
    { "type": "image_picker", "id": "icon_2_image", "label": "Legacy icon 2 (not displayed)" },
    { "type": "text", "id": "icon_2_title", "label": "Legacy icon text 2 (not displayed)" },
    { "type": "image_picker", "id": "icon_3_image", "label": "Legacy icon 3 (not displayed)" },
    { "type": "text", "id": "icon_3_title", "label": "Legacy icon text 3 (not displayed)" },
    { "type": "text", "id": "cta_text", "label": "Legacy CTA text (not displayed)" },
    { "type": "url", "id": "cta_link", "label": "Legacy CTA link (not displayed)" },
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 800, "max": 1400, "step": 20, "default": 1100 },
    { "type": "range", "id": "padding_y", "label": "Vertical padding (px)", "min": 32, "max": 120, "step": 4, "default": 56 },
    { "type": "header", "content": "Legacy SEO" },
    { "type": "text", "id": "date_published", "label": "Legacy date (not used)", "info": "Use page custom.last_reviewed for a genuine review date." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "q", "label": "Question", "default": "Can a supplement treat anxiety or depression?" },
        { "type": "textarea", "id": "a", "label": "Answer", "default": "This guide does not recommend supplements as treatment. Persistent or severe mood symptoms need qualified professional assessment." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Mood & Stress Guide", "category": "Nootropix Guides" }
  ]
}
{% endschema %}
