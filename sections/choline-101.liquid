{%- liquid
  assign s = section.settings
  assign choline_collection = collections['cholinergics']
  assign choline_href = routes.all_products_collection_url
  if choline_collection != blank
    assign choline_href = choline_collection.url
  endif
  assign choline_count = 0
-%}

{%- style -%}
  #choline-101-{{ section.id }} {
    background: {{ s.background_color | default: '#ffffff' }};
    color: rgba(var(--color-foreground));
  }
  #choline-101-{{ section.id }} .c1-inner {
    max-width: {{ s.max_width | default: 1080 }}px;
    margin: 0 auto;
    padding: {{ s.padding_y | default: 64 }}px var(--page-gutter);
  }
  #choline-101-{{ section.id }} .c1-hero,
  #choline-101-{{ section.id }} .c1-panel {
    padding: clamp(1.25rem, 4vw, 2.5rem);
    margin-bottom: 1.5rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
  }
  #choline-101-{{ section.id }} .c1-hero { background: rgba(var(--color-background-2)); }
  #choline-101-{{ section.id }} h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.1;
  }
  #choline-101-{{ section.id }} h2 { margin: 0 0 0.75rem; }
  #choline-101-{{ section.id }} p,
  #choline-101-{{ section.id }} li { line-height: 1.7; }
  #choline-101-{{ section.id }} .c1-muted {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 68%, transparent);
  }
  #choline-101-{{ section.id }} .c1-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  #choline-101-{{ section.id }} .c1-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
  }
  #choline-101-{{ section.id }} .c1-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }
  #choline-101-{{ section.id }} .c1-card a,
  #choline-101-{{ section.id }} .c1-collection-link {
    margin-top: auto;
    color: rgba(var(--color-foreground));
    font-weight: 600;
    text-underline-offset: 0.25em;
  }
  #choline-101-{{ section.id }} :focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }
{%- endstyle -%}

<section id="choline-101-{{ section.id }}" aria-labelledby="choline-title-{{ section.id }}">
  <div class="c1-inner">
    <header class="c1-hero">
      <h1 id="choline-title-{{ section.id }}">{{ s.title | default: 'Choline 101: Comparing Common Forms' }}</h1>
      {%- if s.kicker != blank -%}<p><strong>{{ s.kicker }}</strong></p>{%- endif -%}
      <p class="c1-muted">{{ s.subheading | default: 'Compare product labels, formulation differences, evidence limits, and safety questions without assuming that a choline product is needed.' }}</p>
    </header>

    {% render 'guide-editorial-review' %}

    <section class="c1-panel" aria-labelledby="choline-context-{{ section.id }}">
      <h2 id="choline-context-{{ section.id }}">What “choline support” means</h2>
      <p>Choline is involved in normal physiology, including acetylcholine and phospholipid pathways. That biological role does not prove that a supplement improves focus, memory, mood, or performance in an individual.</p>
      <p>Alpha-GPC, citicoline (CDP-choline), DMAE, and other products are not interchangeable. Compare the exact ingredient, formulation, amount, warnings, and evidence rather than relying on the category name.</p>
    </section>

    <section class="c1-panel" aria-labelledby="choline-evidence-{{ section.id }}">
      <h2 id="choline-evidence-{{ section.id }}">Evidence limits</h2>
      <ul>
        <li>Research findings may come from different populations, formulations, and outcomes than the product being viewed.</li>
        <li>A mechanistic rationale is not proof of a cognitive outcome.</li>
        <li>Evidence for DMAE and for combining choline products with racetams or stimulants is especially context-dependent and should not be generalized into a stack.</li>
        <li>This guide does not establish that a choline supplement is necessary or that one form is universally “best.”</li>
      </ul>
    </section>

    <section class="c1-panel" aria-labelledby="choline-safety-{{ section.id }}">
      <h2 id="choline-safety-{{ section.id }}">Contraindication and interaction cues</h2>
      <p>Ask a qualified healthcare professional or pharmacist before use if you take medication, have a health condition, are pregnant or nursing, are under 18, or plan to combine products. Stop and seek advice if you experience a significant or persistent adverse effect.</p>
      <p><strong>No dose, timing routine, stack, or cycle is prescribed here. Follow the current product label.</strong></p>
    </section>

    <section class="c1-panel" aria-labelledby="choline-products-{{ section.id }}">
      <h2 id="choline-products-{{ section.id }}">Merchant-selected product references</h2>
      <p class="c1-muted">Cards use product pickers and appear only when the selected product is currently available.</p>
      <div class="c1-grid">
        {%- assign choline_product = s.alpha_product -%}
        {%- if choline_product != blank and choline_product.available -%}
          {%- assign choline_count = choline_count | plus: 1 -%}
          <article class="c1-card">
            {%- if choline_product.featured_image -%}{{ choline_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: choline_product.title }}{%- endif -%}
            <h3>{{ choline_product.title }}</h3>
            <p class="c1-muted">Review the exact formulation, warnings, directions, and page-specific evidence.</p>
            <a href="{{ choline_product.url }}">Review product label</a>
          </article>
        {%- endif -%}

        {%- assign choline_product = s.cdp_product -%}
        {%- if choline_product != blank and choline_product.available -%}
          {%- assign choline_count = choline_count | plus: 1 -%}
          <article class="c1-card">
            {%- if choline_product.featured_image -%}{{ choline_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: choline_product.title }}{%- endif -%}
            <h3>{{ choline_product.title }}</h3>
            <p class="c1-muted">Compare the current label with evidence for the same ingredient and formulation.</p>
            <a href="{{ choline_product.url }}">Review product label</a>
          </article>
        {%- endif -%}

        {%- assign choline_product = s.dmae_product -%}
        {%- if choline_product != blank and choline_product.available -%}
          {%- assign choline_count = choline_count | plus: 1 -%}
          <article class="c1-card">
            {%- if choline_product.featured_image -%}{{ choline_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: choline_product.title }}{%- endif -%}
            <h3>{{ choline_product.title }}</h3>
            <p class="c1-muted">Evidence and suitability should be assessed for this exact product, not inferred from a category comparison.</p>
            <a href="{{ choline_product.url }}">Review product label</a>
          </article>
        {%- endif -%}
      </div>
      {%- if choline_count == 0 -%}
        <p><a class="c1-collection-link" href="{{ choline_href }}">Browse the current choline-related collection</a></p>
      {%- endif -%}
    </section>

    <section class="c1-panel" aria-labelledby="choline-questions-{{ section.id }}">
      <h2 id="choline-questions-{{ section.id }}">Questions to take to a professional</h2>
      <ul>
        <li>Is supplementation appropriate given my diet, symptoms, health history, and medications?</li>
        <li>Could this ingredient interact with another supplement or medicine?</li>
        <li>Does a symptom such as headache, brain fog, or memory change need assessment instead of supplementation?</li>
      </ul>
    </section>

    <p class="c1-muted">Educational information only; not medical advice and not intended to diagnose, treat, cure, or prevent disease.</p>
  </div>
</section>

{% schema %}
{
  "name": "Pillar: Choline 101",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "title", "label": "Title", "default": "Choline 101: Comparing Common Forms" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Compare forms; do not assume you need one." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Compare product labels, formulation differences, evidence limits, and safety questions without assuming that a choline product is needed." },
    { "type": "header", "content": "Product references" },
    { "type": "product", "id": "alpha_product", "label": "Alpha-GPC product" },
    { "type": "product", "id": "cdp_product", "label": "CDP-choline product" },
    { "type": "product", "id": "dmae_product", "label": "DMAE product" },
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 720, "max": 1400, "step": 20, "default": 1080 },
    { "type": "range", "id": "padding_y", "label": "Vertical padding (px)", "min": 40, "max": 160, "step": 4, "default": 64 },
    { "type": "header", "content": "Legacy SEO" },
    { "type": "text", "id": "date_published", "label": "Legacy date (not used)", "info": "Use page custom.last_reviewed for a genuine review date." }
  ],
  "presets": [
    { "name": "Pillar: Choline 101" }
  ]
}
{% endschema %}
