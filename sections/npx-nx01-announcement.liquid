{%- liquid
  assign show_launch = true
  if section.settings.homepage_only and request.page_type != 'index'
    assign show_launch = false
  endif
  assign launch_product = section.settings.product | default: all_products['nx-01-baseline']
  assign launch_url = section.settings.link | default: launch_product.url
  if launch_url == blank
    assign launch_url = routes.root_url | append: 'products/nx-01-baseline'
  endif
-%}
{%- if show_launch and section.settings.message != blank -%}
  <aside class="nx-launch-bar" aria-label="{{ section.settings.accessibility_label | escape }}" style="--nx-bar-bg: {{ section.settings.background }}; --nx-bar-ink: {{ section.settings.text_color }}; --nx-bar-accent: {{ section.settings.accent }};">
    <a class="nx-launch-bar__link" href="{{ launch_url | escape }}">
      {%- if section.settings.badge != blank -%}<span class="nx-launch-bar__badge">{{ section.settings.badge | escape }}</span>{%- endif -%}
      <span class="nx-launch-bar__message">{{ section.settings.message | escape }}</span>
      <svg class="nx-launch-bar__arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true" focusable="false"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </aside>
{%- endif -%}
<style>
  .nx-launch-bar { background: var(--nx-bar-bg); color: var(--nx-bar-ink); font-family: var(--font-body-family, Arial, sans-serif); }
  .nx-launch-bar, .nx-launch-bar * { box-sizing: border-box; }
  .nx-launch-bar .nx-launch-bar__link { min-height: 44px; padding: 10px 24px; display: flex; align-items: center; justify-content: center; gap: 12px; color: var(--nx-bar-ink); font-size: 12px; font-weight: 500; line-height: 1.5; text-decoration: none; text-align: center; }
  .nx-launch-bar__badge { flex: 0 0 auto; color: var(--nx-bar-accent); font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .nx-launch-bar__message { min-width: 0; overflow-wrap: anywhere; }
  .nx-launch-bar__arrow { flex-shrink: 0; }
  .nx-launch-bar__link:hover .nx-launch-bar__message { text-decoration: underline; text-underline-offset: 3px; }
  .nx-launch-bar .nx-launch-bar__link:focus-visible { outline: 2px solid var(--nx-bar-accent); outline-offset: -5px; }
  @media (max-width: 599px) { .nx-launch-bar .nx-launch-bar__link { gap: 9px; padding-inline: 16px; font-size: 11px; } }
</style>
{% schema %}
{
  "name": "NX-01 announcement",
  "tag": "div",
  "class": "nx-launch-bar-section",
  "enabled_on": {"templates": ["index"], "groups": ["header"]},
  "settings": [
    {"type": "checkbox", "id": "homepage_only", "label": "Show only on homepage", "default": true},
    {"type": "text", "id": "badge", "label": "Badge", "default": "New"},
    {"type": "text", "id": "message", "label": "Announcement", "default": "Meet NX-01 Baseline. Your daily brain support."},
    {"type": "product", "id": "product", "label": "Product", "info": "Uses NX-01 Baseline when left empty."},
    {"type": "url", "id": "link", "label": "Link", "info": "Leave empty to link to the selected product."},
    {"type": "color", "id": "background", "label": "Background", "default": "#181B24"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF"},
    {"type": "color", "id": "accent", "label": "Badge", "default": "#FFC51C"},
    {"type": "text", "id": "accessibility_label", "label": "Screen reader label", "default": "Product launch announcement"}
  ],
  "presets": [{"name": "NX-01 announcement"}]
}
{% endschema %}
