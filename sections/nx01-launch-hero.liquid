{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = all_products['nx-01-baseline']
  endif
  assign variant = product.selected_or_first_available_variant
  assign product_available = false
  if variant != blank and variant.available
    assign product_available = true
  endif
  assign product_name = section.settings.product_name | strip
  if product_name == blank and product != blank
    assign product_name = product.title
  endif
  if product_name == blank
    assign product_name = 'NX-01 Baseline'
  endif
  assign supply = section.settings.supply_line | strip
  assign bottle = section.settings.bottle_image
  assign bottle_mobile = section.settings.bottle_image_mobile
  assign bottle_alt = section.settings.bottle_alt | strip
  assign reason_count = 0
  for block in section.blocks
    if block.type == 'reason'
      if block.settings.title != blank or block.settings.body != blank
        assign reason_count = reason_count | plus: 1
      endif
    endif
  endfor
  if section.settings.anchor_id != blank
    assign nx01_anchor = section.settings.anchor_id | handleize
  else
    assign nx01_anchor = 'nx01-hero-' | append: section.id
  endif
  assign form_id = 'nx01-purchase-hero-' | append: section.id
-%}

{% render 'nx01-launch-css' %}

<section
  id="{{ nx01_anchor }}"
  class="nx01 nx01-launch-hero xo-section xo-section--{{ section.id }}{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  style="{% if section.settings.padding_top != blank %}--nx01-pad-block-start: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom != blank %} --nx01-pad-block-end: {{ section.settings.padding_bottom }}px;{% endif %}"
  aria-labelledby="nx01-hero-heading-{{ section.id }}"
>
  <div class="nx01__inner nx01-launch-hero__inner">
    <div class="nx01-launch-hero__layout">
      <div class="nx01-launch-hero__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="nx01__label">
            <span class="nx01__label-rule" aria-hidden="true"></span>
            <span>{{ section.settings.eyebrow | escape }}</span>
          </p>
        {%- endif -%}

        <h1 class="nx01__heading nx01-launch-hero__heading" id="nx01-hero-heading-{{ section.id }}">
          {{ product_name | escape }}
        </h1>

        {%- if section.settings.subheading != blank -%}
          <div class="nx01__sub nx01-launch-hero__sub">{{ section.settings.subheading }}</div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <p class="nx01-launch-hero__tagline">{{ section.settings.heading | escape }}</p>
        {%- endif -%}

        {%- if product != blank and product_available == false -%}
          <p class="nx01-launch-hero__availability" role="status">{{ 'sections.nx01_launch_hero.sold_out' | t }}</p>
        {%- endif -%}
      </div>

      {%- if bottle != blank -%}
        <div class="nx01-launch-hero__media">
          <picture class="nx01-launch-hero__picture">
            {%- if bottle_mobile != blank -%}
              <source
                media="(max-width: 767px)"
                srcset="
                  {{ bottle_mobile | image_url: width: 280 }} 280w,
                  {{ bottle_mobile | image_url: width: 360 }} 360w,
                  {{ bottle_mobile | image_url: width: 480 }} 480w,
                  {{ bottle_mobile | image_url: width: 720 }} 720w,
                  {{ bottle_mobile | image_url: width: 960 }} 960w
                "
                sizes="min(280px, 90vw)"
              >
            {%- endif -%}
            {{
              bottle
              | image_url: width: 1400
              | image_tag:
                class: 'nx01-launch-hero__img',
                loading: 'eager',
                fetchpriority: 'high',
                widths: '280, 360, 480, 720, 960, 1200, 1400',
                sizes: '(max-width: 767px) min(280px, 90vw), min(420px, 40vw)',
                alt: bottle_alt,
                width: bottle.width,
                height: bottle.height,
                decoding: 'async'
            }}
          </picture>
        </div>
      {%- endif -%}

      {%- if supply != blank -%}
        <p class="nx01-launch-hero__supply">{{ supply | escape }}</p>
      {%- endif -%}

      <div class="nx01-launch-hero__buy" id="nx01-buy">
        {% render 'nx01-purchase', product: product, instance_id: 'hero', form_id: form_id, show_policy: true %}
      </div>

      {%- if reason_count > 0 -%}
        <ul class="nx01-launch-hero__reasons" aria-label="{{ 'sections.nx01_launch_hero.facts_label' | t }}">
          {%- for block in section.blocks -%}
            {%- if block.type == 'reason' -%}
              {%- if block.settings.title != blank or block.settings.body != blank -%}
                <li class="nx01-launch-hero__reason" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <p class="nx01-launch-hero__reason-title">{{ block.settings.title | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.body != blank -%}
                    <p class="nx01-launch-hero__reason-body">{{ block.settings.body | escape }}</p>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.ingredients_label != blank and section.settings.ingredients_href != blank -%}
        <a class="nx01__text-link nx01-launch-hero__link" href="{{ section.settings.ingredients_href | escape }}">
          {{ section.settings.ingredients_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .nx01-launch-hero {
    position: relative;
    isolation: isolate;
  }

  .nx01-launch-hero__inner {
    padding-block: 2.4rem;
  }

  .nx01-launch-hero__layout {
    display: grid;
    grid-template-areas:
      'intro'
      'media'
      'supply'
      'buy'
      'reasons'
      'link';
    gap: 2rem;
  }

  .nx01-launch-hero__intro {
    grid-area: intro;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
  }

  .nx01-launch-hero__media {
    grid-area: media;
    display: flex;
    justify-content: center;
  }

  .nx01-launch-hero__supply {
    grid-area: supply;
    margin: 0;
    font-size: 1.4rem;
    font-weight: 500;
  }

  .nx01-launch-hero__buy {
    grid-area: buy;
    scroll-margin-top: var(--nx01-scroll-margin);
  }

  .nx01-launch-hero__reasons {
    grid-area: reasons;
    display: grid;
    gap: 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nx01-launch-hero__link {
    grid-area: link;
  }

  .nx01-launch-hero__heading {
    font-size: clamp(3.2rem, 6vw, 4.8rem);
    letter-spacing: -0.035em;
    line-height: 1.14;
  }

  .nx01-launch-hero__tagline {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .nx01-launch-hero__availability {
    margin: 0;
    padding: 0.6rem 1rem;
    border: 0.1rem solid rgb(var(--nx01-navy-deep));
    border-radius: 10rem;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
    color: rgb(var(--nx01-navy-deep));
  }

  .nx01-launch-hero__sub {
    max-width: 64rem;
    font-size: 1.6rem;
    line-height: 1.55;
  }

  .nx01-launch-hero__sub p {
    margin: 0;
  }

  .nx01-launch-hero__picture,
  .nx01-launch-hero__img {
    display: block;
    width: 100%;
    height: auto;
  }

  .nx01-launch-hero__img {
    max-height: 28rem;
    width: auto;
    max-width: 100%;
    margin-inline: auto;
    object-fit: contain;
  }

  .nx01-launch-hero__reason {
    padding: 0;
  }

  .nx01-launch-hero__reason-title {
    margin: 0 0 0.4rem;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .nx01-launch-hero__reason-body {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.5;
    color: rgb(var(--nx01-body));
  }

  @media screen and (min-width: 990px) {
    .nx01-launch-hero__layout {
      grid-template-columns: minmax(0, 0.4fr) minmax(0, 0.6fr);
      grid-template-areas:
        'media intro'
        'media supply'
        'media buy'
        'media reasons'
        'media link';
      column-gap: 4.8rem;
      align-items: start;
    }

    .nx01-launch-hero__img {
      max-height: 42rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.nx01_launch_hero.name",
  "tag": "section",
  "class": "section-nx01-launch-hero",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.nx01_launch_hero.settings.color_scheme",
      "default": "background-1"
    },
    { "type": "header", "content": "Reuse" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Optional in-page link target. Leave blank to keep the default hero ID." },
    { "type": "range", "id": "padding_top", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding top", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding bottom", "default": 32 },
    {
      "type": "checkbox",
      "id": "full_viewport",
      "label": "t:sections.nx01_launch_hero.settings.full_viewport",
      "default": false
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product used for live price and availability"
    },
    {
      "type": "text",
      "id": "product_name",
      "label": "Product name",
      "default": "NX-01 Baseline"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.nx01_launch_hero.settings.eyebrow",
      "default": "Introducing NX-01 · Baseline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.nx01_launch_hero.settings.heading",
      "default": "Your daily nootropic stack, simplified."
    },
    {
      "type": "text",
      "id": "supply_line",
      "label": "Supply line",
      "default": "90 capsules · 30 servings · 3 capsules per serving"
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Meta line",
      "info": "Unused when the purchase module is shown. Kept for existing templates."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.nx01_launch_hero.settings.subheading",
      "default": "<p>A caffeine-free daily combination of nine listed ingredients in one 3-capsule serving.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:sections.nx01_launch_hero.settings.primary_label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "primary_href",
      "label": "t:sections.nx01_launch_hero.settings.primary_href",
      "default": "#nx01-buy"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:sections.nx01_launch_hero.settings.secondary_label",
      "default": "Ingredients & amounts"
    },
    {
      "type": "text",
      "id": "secondary_href",
      "label": "t:sections.nx01_launch_hero.settings.secondary_href",
      "default": "#nx01-facts"
    },
    {
      "type": "text",
      "id": "ingredients_label",
      "label": "Ingredients link label",
      "default": "Ingredients & amounts"
    },
    {
      "type": "text",
      "id": "ingredients_href",
      "label": "Ingredients link",
      "default": "#nx01-facts"
    },
    {
      "type": "image_picker",
      "id": "bottle_image",
      "label": "t:sections.nx01_launch_hero.settings.bottle_image"
    },
    {
      "type": "image_picker",
      "id": "bottle_image_mobile",
      "label": "t:sections.nx01_launch_hero.settings.bottle_image_mobile"
    },
    {
      "type": "text",
      "id": "bottle_alt",
      "label": "t:sections.nx01_launch_hero.settings.bottle_alt"
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "t:sections.nx01_launch_hero.settings.scroll_label"
    },
    {
      "type": "text",
      "id": "scroll_href",
      "label": "t:sections.nx01_launch_hero.settings.scroll_href",
      "default": "#nx01-audience"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "t:sections.nx01_launch_hero.blocks.fact.name",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.nx01_launch_hero.blocks.fact.settings.value",
          "default": "9"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.nx01_launch_hero.blocks.fact.settings.label",
          "default": "Actives"
        }
      ]
    },
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Listed daily serving" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Nine actives, with forms and amounts on the label." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:sections.nx01_launch_hero.presets.name",
      "blocks": [
        { "type": "reason", "settings": { "title": "Listed daily serving", "body": "Nine actives, with forms and amounts on the label." } },
        { "type": "reason", "settings": { "title": "0 mg caffeine", "body": "Caffeine is not listed in the formula." } },
        { "type": "reason", "settings": { "title": "Fixed combination", "body": "For people who already want these listed amounts in one serving." } }
      ]
    }
  ]
}
{% endschema %}
