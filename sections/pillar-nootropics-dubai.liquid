{% comment %}
  =============================================
  Section: Pillar — Buy Nootropics in Dubai (UAE trust-first landing)
  File: sections/pillar-nootropics-dubai.liquid
  Purpose: Compliance-safe UAE buyer guide — shipping, quality, education CTAs
  Theme: OS 2.0 — design tokens via CSS variables
  =============================================
{% endcomment %}

{%- assign s = section.settings -%}
{%- assign sid = section.id -%}
{%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}

{%- liquid
  assign default_hero_title = 'Buy Nootropics Online in Dubai & the UAE'
  assign default_hero_sub = 'A Dubai-based store for nootropics, supplements, and related products, with fast UAE delivery, clear product information, and quality documentation where available.'
  assign article_headline = s.hero_title | default: default_hero_title
  assign article_desc = s.hero_subtitle | default: default_hero_sub | strip_html | truncate: 160
  assign collections_base = shop.url | append: routes.collections_url
  if s.cat_1_link != blank
    assign cat_url_1 = s.cat_1_link
  else
    assign cat_url_1 = collections_base | append: '/nootropics'
  endif
  if s.cat_2_link != blank
    assign cat_url_2 = s.cat_2_link
  else
    assign cat_url_2 = collections_base | append: '/powder-nootropics'
  endif
  if s.cat_3_link != blank
    assign cat_url_3 = s.cat_3_link
  else
    assign cat_url_3 = collections_base | append: '/mushroom-extracts'
  endif
  if s.cat_4_link != blank
    assign cat_url_4 = s.cat_4_link
  else
    assign cat_url_4 = collections_base | append: '/racetams'
  endif
  if s.cat_5_link != blank
    assign cat_url_5 = s.cat_5_link
  else
    assign cat_url_5 = collections_base | append: '/cholinergics'
  endif
  if s.cat_6_link != blank
    assign cat_url_6 = s.cat_6_link
  else
    assign cat_url_6 = collections_base | append: '/stacks'
  endif
  assign guide_url_1 = s.guide_1_link | default: '/pages/beginners-guide-to-nootropics'
  assign guide_url_2 = s.guide_2_link | default: '/pages/quality-and-trust-certificate-of-analysis'
  assign guide_url_3 = s.guide_3_link | default: '/pages/quality-and-trust-storage-handling'
-%}

{%- comment -%} ── JSON-LD: Article ── {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ article_headline | json }},
  "description": {{ article_desc | json }},
  "author": { "@type": "Organization", "name": "Nootropix" },
  "publisher": {
    "@type": "Organization",
    "name": "Nootropix",
    "url": {{ shop.url | json }},
    "logo": {
      "@type": "ImageObject",
      "url": {{ shop.url | append: '/cdn/shop/files/nootropix-logo.png' | json }}
    }
  },
  "datePublished": {{ s.date_published | default: "2025-01-15" | json }},
  "dateModified": {{ page.updated_at | date: "%Y-%m-%d" | default: "2025-01-15" | json }},
  "mainEntityOfPage": {{ canonical_url | json }}
}
</script>

{%- comment -%} ── JSON-LD: ItemList (category tiles) ── {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Shop by category — UAE",
  "numberOfItems": 6,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": {{ s.cat_1_title | default: "Capsules" | json }}, "url": {{ cat_url_1 | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ s.cat_2_title | default: "Powders" | json }}, "url": {{ cat_url_2 | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ s.cat_3_title | default: "Natural & Mushroom Extracts" | json }}, "url": {{ cat_url_3 | json }} },
    { "@type": "ListItem", "position": 4, "name": {{ s.cat_4_title | default: "Racetams" | json }}, "url": {{ cat_url_4 | json }} },
    { "@type": "ListItem", "position": 5, "name": {{ s.cat_5_title | default: "Cholinergics" | json }}, "url": {{ cat_url_5 | json }} },
    { "@type": "ListItem", "position": 6, "name": {{ s.cat_6_title | default: "Stacks & Bundles" | json }}, "url": {{ cat_url_6 | json }} }
  ]
}
</script>

{%- comment -%} ── JSON-LD: FAQPage ── {%- endcomment -%}
{% if faq_blocks.size > 0 %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in faq_blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.q | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | json }} }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{% endif %}

{%- comment -%} ── JSON-LD: LocalBusiness ── {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Nootropix",
  "url": {{ shop.url | json }},
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Dubai",
    "addressCountry": "AE"
  },
  "areaServed": ["Dubai", "Abu Dhabi", "Sharjah", "Ajman", "UAE"],
  "description": "Dubai-based store for nootropics and related products with UAE-focused shipping, product information, and quality documentation where available."
}
</script>

{%- comment -%} ── JSON-LD: BreadcrumbList ── {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
    { "@type": "ListItem", "position": 2, "name": "Buy Nootropics Dubai", "item": {{ canonical_url | json }} }
  ]
}
</script>

<section id="pillar-dubai-{{ sid }}" class="pd-section" aria-labelledby="pd-title-{{ sid }}">
  <div class="pd-inner">

    {%- comment -%} ── HERO ── {%- endcomment -%}
    <header class="pd-hero"{% if s.hero_image != blank %} style="background-image:url({{ s.hero_image | image_url: width: 1600 }});"{% endif %}>
      <div class="pd-hero-overlay">
        <h1 id="pd-title-{{ sid }}" class="pd-hero-title">{{ s.hero_title | default: default_hero_title }}</h1>
        <p class="pd-hero-sub">{{ s.hero_subtitle | default: default_hero_sub }}</p>
        <div class="pd-hero-actions">
          <a href="{{ s.hero_cta_link | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ s.hero_cta_text | default: "Browse Nootropics" }}</a>
          <a href="{{ s.hero_cta_2_link | default: '#pd-quality' }}" class="btn btn--ghost">{{ s.hero_cta_2_text | default: "View Quality & COA Info" }}</a>
        </div>
        <ul class="pd-hero-bullets" role="list">
          <li>{{ s.hero_bullet_1 | default: "Ships from Dubai" }}</li>
          <li>{{ s.hero_bullet_2 | default: "UAE and international delivery options" }}</li>
          <li>{{ s.hero_bullet_3 | default: "COAs or batch documentation where available" }}</li>
          <li>{{ s.hero_bullet_4 | default: "Customer support before and after ordering" }}</li>
        </ul>
      </div>
    </header>

    {%- comment -%} ── COMPLIANCE NOTICE ── {%- endcomment -%}
    <aside class="pd-notice" role="note">
      <div class="pd-notice-inner">
        {% if s.compliance_notice != blank %}
          {{ s.compliance_notice }}
        {% else %}
          <p><strong>Important:</strong> Product information on Nootropix is provided for general educational purposes only. Our products are not intended to diagnose, treat, cure, or prevent any disease, and we do not provide medical advice or personalized dosing guidance.</p>
        {% endif %}
      </div>
    </aside>

    {%- comment -%} ── WHY UAE BUYERS ── {%- endcomment -%}
    <section aria-labelledby="pd-why-heading-{{ sid }}">
      <span class="pd-kicker">Trust</span>
      <h2 id="pd-why-heading-{{ sid }}" class="pd-heading">Why UAE buyers choose Nootropix</h2>
      <div class="pd-why-grid">
        <article class="pd-why-card">
          <h3 class="pd-why-title">{{ s.wc_1_title | default: "Fast UAE delivery" }}</h3>
          <p class="pd-why-desc">{{ s.wc_1_desc | default: "Orders ship from Dubai, with fast courier options available across the UAE depending on location, order timing, and courier availability." }}</p>
        </article>
        <article class="pd-why-card">
          <h3 class="pd-why-title">{{ s.wc_2_title | default: "Quality-first sourcing" }}</h3>
          <p class="pd-why-desc">{{ s.wc_2_desc | default: "We prioritize reputable sourcing, clear product details, and quality documentation such as COAs where available." }}</p>
        </article>
        <article class="pd-why-card">
          <h3 class="pd-why-title">{{ s.wc_3_title | default: "Heat-aware packing" }}</h3>
          <p class="pd-why-desc">{{ s.wc_3_desc | default: "Orders are packed with UAE conditions in mind, and customers receive clear storage and handling guidance after delivery." }}</p>
        </article>
        <article class="pd-why-card">
          <h3 class="pd-why-title">{{ s.wc_4_title | default: "Human support" }}</h3>
          <p class="pd-why-desc">{{ s.wc_4_desc | default: "Have a question before ordering? Our support team can help with availability, shipping, documentation, and order issues." }}</p>
        </article>
      </div>
    </section>

    {%- comment -%} ── COMPARISON TABLE ── {%- endcomment -%}
    <section id="pd-compare" aria-labelledby="pd-compare-heading-{{ sid }}">
      <span class="pd-kicker">Compare</span>
      <h2 id="pd-compare-heading-{{ sid }}" class="pd-heading">Why UAE buyers order from Nootropix</h2>
      <div class="pd-table-wrap">
        <table class="pd-table" aria-label="Nootropix compared with typical overseas ordering">
          <thead>
            <tr>
              <th scope="col">Buying factor</th>
              <th scope="col" class="pd-table-highlight">Nootropix</th>
              <th scope="col">Typical overseas ordering</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td data-label="Buying factor"><strong>UAE delivery</strong></td>
              <td data-label="Nootropix" class="pd-table-highlight">{{ s.compare_nx_delivery | default: "Ships from Dubai" }}</td>
              <td data-label="Typical overseas ordering">{{ s.compare_other_delivery | default: "Often delayed by customs/logistics" }}</td>
            </tr>
            <tr>
              <td data-label="Buying factor"><strong>Support</strong></td>
              <td data-label="Nootropix" class="pd-table-highlight">{{ s.compare_nx_support | default: "Local support team" }}</td>
              <td data-label="Typical overseas ordering">{{ s.compare_other_support | default: "Often slower or timezone-limited" }}</td>
            </tr>
            <tr>
              <td data-label="Buying factor"><strong>Product info</strong></td>
              <td data-label="Nootropix" class="pd-table-highlight">{{ s.compare_nx_info | default: "Clear PDPs and documentation where available" }}</td>
              <td data-label="Typical overseas ordering">{{ s.compare_other_info | default: "Varies by supplier" }}</td>
            </tr>
            <tr>
              <td data-label="Buying factor"><strong>Storage guidance</strong></td>
              <td data-label="Nootropix" class="pd-table-highlight">{{ s.compare_nx_storage | default: "UAE-aware handling info" }}</td>
              <td data-label="Typical overseas ordering">{{ s.compare_other_storage | default: "Often generic" }}</td>
            </tr>
            <tr>
              <td data-label="Buying factor"><strong>Checkout</strong></td>
              <td data-label="Nootropix" class="pd-table-highlight">{{ s.compare_nx_checkout | default: "UAE-friendly checkout" }}</td>
              <td data-label="Typical overseas ordering">{{ s.compare_other_checkout | default: "Varies by region" }}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    {%- comment -%} ── RESPONSIBLE CHOICE ── {%- endcomment -%}
    <section aria-labelledby="pd-responsible-heading-{{ sid }}">
      <span class="pd-kicker">Education</span>
      <h2 id="pd-responsible-heading-{{ sid }}" class="pd-heading">How to choose a product responsibly</h2>
      <div class="pd-responsible-intro">
        {% if s.responsible_choice_text != blank %}
          {{ s.responsible_choice_text }}
        {% else %}
          <p>Before ordering, review the product page, serving information, ingredient format, storage guidance, and any available quality documentation. Customers should choose products based on their own research and consult a qualified professional when appropriate.</p>
        {% endif %}
      </div>
      <div class="pd-guide-links">
        <a class="pd-guide-card" href="{{ guide_url_1 }}"><span class="pd-guide-card-title">{{ s.guide_1_text | default: "Beginner's Guide to Nootropics" }}</span></a>
        <a class="pd-guide-card" href="{{ guide_url_2 }}"><span class="pd-guide-card-title">{{ s.guide_2_text | default: "How to Read a COA" }}</span></a>
        <a class="pd-guide-card" href="{{ guide_url_3 }}"><span class="pd-guide-card-title">{{ s.guide_3_text | default: "Storage & Handling Guide" }}</span></a>
      </div>
    </section>

    {%- comment -%} ── CATEGORY TILES ── {%- endcomment -%}
    <section aria-labelledby="pd-cat-heading-{{ sid }}">
      <span class="pd-kicker">Shop</span>
      <h2 id="pd-cat-heading-{{ sid }}" class="pd-heading">Browse by category</h2>
      <nav class="pd-cat-grid" aria-label="Product categories">
        <a class="pd-cat-tile" href="{{ cat_url_1 }}">{{ s.cat_1_title | default: "Capsules" }}</a>
        <a class="pd-cat-tile" href="{{ cat_url_2 }}">{{ s.cat_2_title | default: "Powders" }}</a>
        <a class="pd-cat-tile" href="{{ cat_url_3 }}">{{ s.cat_3_title | default: "Natural & Mushroom Extracts" }}</a>
        <a class="pd-cat-tile" href="{{ cat_url_4 }}">{{ s.cat_4_title | default: "Racetams" }}</a>
        <a class="pd-cat-tile" href="{{ cat_url_5 }}">{{ s.cat_5_title | default: "Cholinergics" }}</a>
        <a class="pd-cat-tile" href="{{ cat_url_6 }}">{{ s.cat_6_title | default: "Stacks & Bundles" }}</a>
      </nav>
    </section>

    {%- comment -%} ── DELIVERY ── {%- endcomment -%}
    <section class="pd-panel pd-delivery" aria-labelledby="pd-delivery-heading-{{ sid }}">
      <h2 id="pd-delivery-heading-{{ sid }}" class="pd-heading">{{ s.delivery_heading | default: "Delivery in Dubai & across the UAE" }}</h2>
      <div class="pd-panel-body">
        {% if s.delivery_text != blank %}
          {{ s.delivery_text }}
        {% else %}
          <p>Nootropix ships orders from Dubai. Delivery speed depends on your location, order timing, courier availability, and checkout option selected. Dubai orders may qualify for fast local delivery, while other UAE cities are typically served through same-day or next-day courier options where available.</p>
        {% endif %}
      </div>
      <a class="btn btn--primary" href="{{ s.delivery_cta_link | default: routes.all_products_collection_url }}">{{ s.delivery_cta_text | default: "Check delivery options at checkout" }}</a>
    </section>

    {%- comment -%} ── QUALITY / COA ── {%- endcomment -%}
    <section id="pd-quality" class="pd-panel pd-coa" aria-labelledby="pd-coa-heading-{{ sid }}">
      <h2 id="pd-coa-heading-{{ sid }}" class="pd-heading">{{ s.coa_heading | default: "Quality documentation" }}</h2>
      <div class="pd-panel-body">
        {% if s.coa_text != blank %}
          {{ s.coa_text }}
        {% else %}
          <p>Where available, Nootropix provides COAs or batch-related documentation to help customers review identity, purity, and quality information. Documentation availability may vary by product and batch.</p>
        {% endif %}
      </div>
      <a class="btn btn--ghost" href="{{ s.coa_cta_link | default: '/pages/coa-library' }}">{{ s.coa_cta_text | default: "View COA Library" }}</a>
    </section>

    {%- comment -%} ── FAQ ── {%- endcomment -%}
    <section aria-labelledby="pd-faq-heading-{{ sid }}">
      <span class="pd-kicker">FAQ</span>
      <h2 id="pd-faq-heading-{{ sid }}" class="pd-heading">Questions about ordering in the UAE</h2>

      {% if faq_blocks.size > 0 %}
        {% for block in faq_blocks %}
          <details class="pd-faq" {{ block.shopify_attributes }}>
            <summary class="pd-faq-q">{{ block.settings.q }}<span class="pd-faq-chevron" aria-hidden="true"></span></summary>
            <div class="pd-faq-answer"><div class="pd-faq-inner"><p>{{ block.settings.a }}</p></div></div>
          </details>
        {% endfor %}
      {% else %}
        <details class="pd-faq">
          <summary class="pd-faq-q">Do you deliver nootropics in Dubai?<span class="pd-faq-chevron" aria-hidden="true"></span></summary>
          <div class="pd-faq-answer"><div class="pd-faq-inner"><p>Yes. Nootropix ships from Dubai and offers fast UAE delivery options depending on location, order timing, and courier availability.</p></div></div>
        </details>
      {% endif %}
    </section>

    {%- comment -%} ── FINAL CTA ── {%- endcomment -%}
    <section class="pd-final-cta" aria-label="Browse products">
      <h2 class="pd-heading">{{ s.final_heading | default: "Browse Nootropics" }}</h2>
      <p class="pd-body-muted">{{ s.final_body | default: "Nootropix ships nootropics and related products from Dubai, with fast UAE delivery options and quality documentation where available." }}</p>
      <a class="btn btn--primary" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_text | default: "Browse Nootropics" }}</a>
    </section>

  </div>
</section>

{%- style -%}
#pillar-dubai-{{ sid }} {
  --section-max-width: {{ s.max_width | default: 1100 }}px;
  --pd-py: {{ s.padding_y | default: 56 }}px;
  --pd-accent: rgba(var(--color-accent), 1);
  --pd-accent-soft: color-mix(in srgb, rgba(var(--color-accent)) 14%, transparent);
  --pd-accent-border: color-mix(in srgb, rgba(var(--color-accent)) 45%, transparent);
  --pd-text: rgba(var(--color-foreground), 1);
  --pd-muted: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  --pd-bg: {{ s.background_color | default: 'rgb(var(--color-background))' }};
  --pd-bg-alt: rgba(var(--color-background-2), 1);
  --pd-radius: 2rem;
  --pd-transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  --pd-font: var(--font-body-family, sans-serif);
  --pd-font-heading: var(--font-heading-family, sans-serif);

  background: var(--pd-bg);
  color: var(--pd-text);
  font-family: var(--pd-font);
  line-height: 1.6;
  content-visibility: auto;
  contain-intrinsic-size: 1px 5000px;
}

#pillar-dubai-{{ sid }} .pd-inner {
  max-width: var(--section-max-width);
  margin: 0 auto;
  padding: var(--pd-py) var(--page-gutter, 2.2rem);
  display: flex;
  flex-direction: column;
  gap: 40px;
}
@media (min-width: 990px) {
  #pillar-dubai-{{ sid }} .pd-inner { gap: 56px; }
}

#pillar-dubai-{{ sid }} .pd-kicker {
  display: block;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-weight: 700;
  font-size: 12px;
  color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, rgba(var(--color-accent)));
  margin-bottom: 6px;
}
#pillar-dubai-{{ sid }} .pd-heading {
  font-family: var(--pd-font-heading);
  font-size: clamp(22px, 3vw, 34px);
  font-weight: 700;
  line-height: 1.2;
  color: var(--pd-text);
  margin: 0 0 10px;
}
#pillar-dubai-{{ sid }} .pd-body-muted {
  color: var(--pd-muted);
  line-height: 1.6;
  margin: 0 0 16px;
}

/* HERO */
#pillar-dubai-{{ sid }} .pd-hero {
  background: linear-gradient(
    135deg,
    color-mix(in srgb, rgba(var(--color-accent)) 10%, transparent) 0%,
    color-mix(in srgb, rgba(var(--color-accent)) 18%, transparent) 50%,
    color-mix(in srgb, rgba(var(--color-accent)) 10%, transparent) 100%
  );
  background-size: cover;
  background-position: center;
  border-radius: var(--pd-radius);
  overflow: hidden;
  min-height: 320px;
  display: flex;
  align-items: flex-end;
}
#pillar-dubai-{{ sid }} .pd-hero-overlay {
  width: 100%;
  padding: 36px 24px;
  background: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
  -webkit-backdrop-filter: blur(16px);
  backdrop-filter: blur(16px);
}
@media (min-width: 990px) {
  #pillar-dubai-{{ sid }} .pd-hero { min-height: 400px; }
  #pillar-dubai-{{ sid }} .pd-hero-overlay { padding: 48px 36px; }
}
#pillar-dubai-{{ sid }} .pd-hero-title {
  font-family: var(--pd-font-heading);
  font-size: clamp(28px, 5vw, 50px);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.1;
  color: rgba(var(--color-background), 1);
  margin: 0 0 10px;
}
#pillar-dubai-{{ sid }} .pd-hero-sub {
  color: color-mix(in srgb, rgba(var(--color-background)) 88%, transparent);
  font-size: clamp(15px, 2vw, 18px);
  line-height: 1.6;
  margin: 0 0 20px;
  max-width: 640px;
}
#pillar-dubai-{{ sid }} .pd-hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}
#pillar-dubai-{{ sid }} .pd-hero-bullets {
  list-style: none;
  padding: 0;
  margin: 20px 0 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
#pillar-dubai-{{ sid }} .pd-hero-bullets li {
  font-size: 13px;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 10rem;
  background: color-mix(in srgb, rgba(var(--color-background)) 18%, transparent);
  color: rgba(var(--color-background), 1);
  border: 1px solid color-mix(in srgb, rgba(var(--color-background)) 35%, transparent);
}

/* COMPLIANCE NOTICE */
#pillar-dubai-{{ sid }} .pd-notice {
  border-radius: 1.5rem;
  border: 1px solid var(--pd-accent-border);
  background: var(--pd-accent-soft);
  padding: 0;
}
#pillar-dubai-{{ sid }} .pd-notice-inner {
  padding: 18px 22px;
  font-size: 14px;
  line-height: 1.65;
  color: var(--pd-muted);
  border-left: 4px solid var(--pd-accent);
  border-radius: inherit;
}
#pillar-dubai-{{ sid }} .pd-notice-inner p { margin: 0; }
#pillar-dubai-{{ sid }} .pd-notice-inner strong { color: var(--pd-text); }

/* WHY CARDS */
#pillar-dubai-{{ sid }} .pd-why-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  margin-top: 14px;
}
@media (min-width: 760px) {
  #pillar-dubai-{{ sid }} .pd-why-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 990px) {
  #pillar-dubai-{{ sid }} .pd-why-grid { grid-template-columns: repeat(4, 1fr); }
}
#pillar-dubai-{{ sid }} .pd-why-card {
  padding: 22px 18px;
  border-radius: var(--pd-radius);
  background: var(--pd-bg-alt);
  border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  transition: var(--pd-transition);
}
#pillar-dubai-{{ sid }} .pd-why-card:hover {
  border-color: color-mix(in srgb, rgba(var(--color-accent)) 35%, transparent);
}
#pillar-dubai-{{ sid }} .pd-why-title {
  font-family: var(--pd-font-heading);
  font-size: 1rem;
  font-weight: 700;
  margin: 0 0 8px;
  color: var(--pd-text);
}
#pillar-dubai-{{ sid }} .pd-why-desc {
  margin: 0;
  font-size: 14px;
  color: var(--pd-muted);
  line-height: 1.6;
}

/* TABLE */
#pillar-dubai-{{ sid }} .pd-table-wrap {
  border-radius: var(--pd-radius);
  overflow: hidden;
  border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  margin-top: 12px;
}
#pillar-dubai-{{ sid }} .pd-table {
  width: 100%;
  border-collapse: collapse;
}
#pillar-dubai-{{ sid }} .pd-table thead {
  background: var(--pd-bg-alt);
}
#pillar-dubai-{{ sid }} .pd-table th {
  text-align: left;
  padding: 12px 16px;
  font-weight: 700;
  font-size: 14px;
  color: var(--pd-text);
  line-height: 1.4;
}
#pillar-dubai-{{ sid }} .pd-table td {
  padding: 14px 16px;
  font-size: 14px;
  line-height: 1.6;
  color: var(--pd-text);
  border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
}
#pillar-dubai-{{ sid }} .pd-table tbody tr {
  transition: var(--pd-transition);
}
#pillar-dubai-{{ sid }} .pd-table tbody tr:hover {
  background: var(--pd-accent-soft);
}
#pillar-dubai-{{ sid }} .pd-table-highlight {
  background: var(--pd-accent-soft);
  font-weight: 600;
}
@media (max-width: 640px) {
  #pillar-dubai-{{ sid }} .pd-table thead { display: none; }
  #pillar-dubai-{{ sid }} .pd-table tbody tr {
    display: block;
    padding: 14px;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }
  #pillar-dubai-{{ sid }} .pd-table tbody tr:first-child { border-top: none; }
  #pillar-dubai-{{ sid }} .pd-table td {
    display: block;
    padding: 3px 0;
    border-top: none;
  }
  #pillar-dubai-{{ sid }} .pd-table td::before {
    content: attr(data-label) ": ";
    font-weight: 700;
    color: var(--pd-text);
  }
  #pillar-dubai-{{ sid }} .pd-table-highlight {
    background: transparent;
  }
}

/* RESPONSIBLE + GUIDES */
#pillar-dubai-{{ sid }} .pd-responsible-intro {
  font-size: clamp(15px, 2vw, 17px);
  line-height: 1.7;
  color: var(--pd-muted);
  max-width: 800px;
}
#pillar-dubai-{{ sid }} .pd-responsible-intro p { margin: 0 0 12px; }
#pillar-dubai-{{ sid }} .pd-guide-links {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
  margin-top: 20px;
}
@media (min-width: 740px) {
  #pillar-dubai-{{ sid }} .pd-guide-links { grid-template-columns: repeat(3, 1fr); }
}
#pillar-dubai-{{ sid }} .pd-guide-card {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 72px;
  padding: 16px;
  border-radius: var(--pd-radius);
  border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
  background: var(--pd-bg-alt);
  color: var(--pd-text);
  font-weight: 600;
  font-size: 15px;
  text-decoration: none;
  transition: var(--pd-transition);
}
#pillar-dubai-{{ sid }} .pd-guide-card:hover {
  border-color: color-mix(in srgb, rgba(var(--color-accent)) 45%, transparent);
  background: var(--pd-accent-soft);
}

/* CATEGORY TILES */
#pillar-dubai-{{ sid }} .pd-cat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-top: 16px;
}
@media (min-width: 740px) {
  #pillar-dubai-{{ sid }} .pd-cat-grid { grid-template-columns: repeat(3, 1fr); }
}
#pillar-dubai-{{ sid }} .pd-cat-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 56px;
  padding: 14px 12px;
  border-radius: var(--pd-radius);
  border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
  background: var(--pd-bg);
  color: var(--pd-text);
  font-weight: 600;
  font-size: 14px;
  text-decoration: none;
  transition: var(--pd-transition);
}
#pillar-dubai-{{ sid }} .pd-cat-tile:hover {
  border-color: var(--pd-accent);
  background: var(--pd-accent-soft);
}

/* PANELS */
#pillar-dubai-{{ sid }} .pd-panel {
  border-radius: var(--pd-radius);
  padding: 28px 24px;
  background: var(--pd-bg-alt);
  border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
}
#pillar-dubai-{{ sid }} .pd-panel-body {
  font-size: 15px;
  line-height: 1.65;
  color: var(--pd-muted);
  margin-bottom: 18px;
}
#pillar-dubai-{{ sid }} .pd-panel-body p { margin: 0 0 10px; }
#pillar-dubai-{{ sid }} .pd-panel-body p:last-child { margin-bottom: 0; }

/* FAQ */
#pillar-dubai-{{ sid }} .pd-faq {
  border-radius: 1rem;
  margin: 8px 0;
  border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  overflow: hidden;
  background: var(--pd-bg);
  transition: var(--pd-transition);
}
#pillar-dubai-{{ sid }} .pd-faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 18px;
  font-weight: 600;
  font-size: 15px;
  line-height: 1.5;
  color: var(--pd-text);
  cursor: pointer;
  list-style: none;
  min-height: 44px;
}
#pillar-dubai-{{ sid }} .pd-faq-q::-webkit-details-marker { display: none; }
#pillar-dubai-{{ sid }} .pd-faq-q::marker { content: ""; }

#pillar-dubai-{{ sid }} .pd-faq-chevron {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  position: relative;
  transition: transform 0.35s cubic-bezier(0.25, 0.74, 0.22, 0.99);
}
#pillar-dubai-{{ sid }} .pd-faq-chevron::before,
#pillar-dubai-{{ sid }} .pd-faq-chevron::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 10px;
  height: 2px;
  background: var(--pd-muted);
  border-radius: 1px;
  transition: transform 0.35s cubic-bezier(0.25, 0.74, 0.22, 0.99);
}
#pillar-dubai-{{ sid }} .pd-faq-chevron::before {
  left: 1px;
  transform: translateY(-50%) rotate(45deg);
}
#pillar-dubai-{{ sid }} .pd-faq-chevron::after {
  right: 1px;
  transform: translateY(-50%) rotate(-45deg);
}
#pillar-dubai-{{ sid }} .pd-faq[open] .pd-faq-chevron::before {
  transform: translateY(-50%) rotate(-45deg);
}
#pillar-dubai-{{ sid }} .pd-faq[open] .pd-faq-chevron::after {
  transform: translateY(-50%) rotate(45deg);
}
#pillar-dubai-{{ sid }} .pd-faq-answer {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.35s cubic-bezier(0.25, 0.74, 0.22, 0.99);
}
#pillar-dubai-{{ sid }} .pd-faq[open] .pd-faq-answer {
  grid-template-rows: 1fr;
}
#pillar-dubai-{{ sid }} .pd-faq-inner {
  overflow: hidden;
}
#pillar-dubai-{{ sid }} .pd-faq-inner p {
  padding: 0 18px 16px;
  margin: 0;
  color: var(--pd-muted);
  line-height: 1.6;
  font-size: 14px;
}

/* FINAL CTA */
#pillar-dubai-{{ sid }} .pd-final-cta {
  background: var(--pd-bg-alt);
  border-radius: var(--pd-radius);
  padding: 28px 24px;
  border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  text-align: center;
}

#pillar-dubai-{{ sid }} :focus-visible {
  outline: 2px solid var(--pd-accent);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  #pillar-dubai-{{ sid }} *,
  #pillar-dubai-{{ sid }} *::before,
  #pillar-dubai-{{ sid }} *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
{%- endstyle -%}

