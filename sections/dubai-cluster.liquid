{%- style -%}
  .xo-section--{{ section.id }} .dubai-cluster__header {
    max-width: 84rem;
    margin: 0 auto 4.8rem;
  }

  .xo-section--{{ section.id }} .dubai-cluster__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 2rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.4rem;
  }

  .xo-section--{{ section.id }} .dubai-cluster__breadcrumb a {
    color: rgba(var(--color-foreground));
    font-weight: 600;
    text-decoration: none;
  }

  .xo-section--{{ section.id }} .dubai-cluster__back {
    display: inline-flex;
    min-height: 4.4rem;
    align-items: center;
    margin-bottom: 2.4rem;
    color: rgba(var(--color-foreground));
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  .xo-section--{{ section.id }} .dubai-cluster__title {
    margin: 0 0 1.6rem;
    font-size: clamp(3.4rem, 5vw, 7rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .xo-section--{{ section.id }} .dubai-cluster__intro,
  .xo-section--{{ section.id }} .dubai-cluster__body {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
    font-size: 1.6rem;
    line-height: 1.75;
  }

  .xo-section--{{ section.id }} .dubai-cluster__intro {
    margin: 0 0 2.4rem;
  }

  .xo-section--{{ section.id }} .dubai-cluster__body p {
    margin: 0 0 1.6rem;
  }

  .xo-section--{{ section.id }} .dubai-cluster__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }

  .xo-section--{{ section.id }} .dubai-cluster__button {
    display: inline-flex;
    min-height: 4.8rem;
    align-items: center;
    justify-content: center;
    padding: 1.2rem 2.4rem;
    border: 1px solid rgba(var(--color-accent));
    border-radius: 10rem;
    background: rgba(var(--color-accent));
    color: rgba(var(--color-foreground));
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  .xo-section--{{ section.id }} .dubai-cluster__button--secondary {
    border-color: color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
    background: transparent;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .dubai-cluster__steps {
    display: grid;
    gap: 1.2rem;
    margin: 4.8rem 0;
  }

  .xo-section--{{ section.id }} .dubai-cluster__step {
    padding: 2.4rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 18%, transparent);
    border-radius: 2rem;
    background: rgba(var(--color-background-2));
  }

  .xo-section--{{ section.id }} .dubai-cluster__step-title {
    margin: 0 0 0.8rem;
    font-size: 2rem;
    line-height: 1.3;
  }

  .xo-section--{{ section.id }} .dubai-cluster__step-text {
    margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.5rem;
    line-height: 1.65;
  }

  .xo-section--{{ section.id }} .dubai-cluster__shipping {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-desktop-horizontal-spacing);
    margin: 4.8rem 0;
  }

  .xo-section--{{ section.id }} .dubai-cluster__shipping-card {
    padding: 2.4rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 18%, transparent);
    border-radius: 2rem;
    background: rgba(var(--color-background));
  }

  .xo-section--{{ section.id }} .dubai-cluster__shipping-card--policy {
    grid-column: 1 / -1;
  }

  .xo-section--{{ section.id }} .dubai-cluster__shipping-value {
    display: block;
    margin-bottom: 0.8rem;
    font-size: clamp(2.4rem, 3vw, 3.6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .xo-section--{{ section.id }} .dubai-cluster__shipping-title {
    margin: 0 0 0.8rem;
    font-size: 1.7rem;
  }

  .xo-section--{{ section.id }} .dubai-cluster__shipping-text {
    margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.4rem;
    line-height: 1.65;
  }

  .xo-section--{{ section.id }} .dubai-cluster__policy-link {
    display: inline-block;
    margin-top: 1.2rem;
    color: rgba(var(--color-foreground));
    font-size: 1.4rem;
    font-weight: 600;
    text-underline-offset: 0.3rem;
  }

  .xo-section--{{ section.id }} .dubai-cluster__faq-title {
    margin: 0 0 2rem;
    font-size: clamp(2.4rem, 3vw, 4rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .xo-section--{{ section.id }} .dubai-cluster__faq-item {
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
  }

  .xo-section--{{ section.id }} .dubai-cluster__faq-item:last-child {
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
  }

  .xo-section--{{ section.id }} .dubai-cluster__faq-question {
    display: flex;
    min-height: 6.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.8rem 0;
    cursor: pointer;
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.4;
    list-style: none;
  }

  .xo-section--{{ section.id }} .dubai-cluster__faq-question::-webkit-details-marker {
    display: none;
  }

  .xo-section--{{ section.id }} .dubai-cluster__faq-answer {
    padding: 0 0 2.4rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
    font-size: 1.5rem;
    line-height: 1.75;
  }

  .xo-section--{{ section.id }} .dubai-cluster__disclaimer {
    margin-top: 3.2rem;
    padding: 1.8rem 2rem;
    border-inline-start: 0.3rem solid rgba(var(--color-accent));
    border-radius: 1rem;
    background: rgba(var(--color-background-2));
    font-size: 1.4rem;
    line-height: 1.65;
  }

  .xo-section--{{ section.id }} a:focus-visible,
  .xo-section--{{ section.id }} summary:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .xo-section--{{ section.id }} .dubai-cluster__shipping {
      grid-template-columns: 1fr;
      gap: var(--grid-mobile-vertical-spacing);
    }
  }
{%- endstyle -%}

{%- liquid
  assign locale_code = request.locale.iso_code | default: shop.locale | downcase
  assign language_code = locale_code | split: '-' | first
  assign is_arabic = false
  if language_code == 'ar'
    assign is_arabic = true
  endif

  assign pillar_url = section.settings.pillar_url
  assign collection_url = section.settings.collection.url
  assign policy_url = pages['shipping-and-returns'].url
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign faq_blocks = section.blocks | where: 'type', 'faq'

  assign pillar_label = section.settings.pillar_label
  assign breadcrumb_label = section.settings.breadcrumb_label
  assign back_label = section.settings.back_label
  assign heading = section.settings.heading
  assign intro = section.settings.intro
  assign body = section.settings.body
  assign primary_cta_label = section.settings.primary_cta_label
  assign secondary_cta_label = section.settings.secondary_cta_label
  assign policy_heading = section.settings.policy_heading
  assign policy_text = section.settings.policy_text
  assign policy_link_label = section.settings.policy_link_label
  assign faq_heading = section.settings.faq_heading
  assign disclaimer = section.settings.disclaimer
  assign home_label = 'Home'
  assign breadcrumb_aria_label = 'Breadcrumb'

  if is_arabic
    assign pillar_label = section.settings.pillar_label_ar | default: pillar_label
    assign breadcrumb_label = section.settings.breadcrumb_label_ar | default: breadcrumb_label
    assign back_label = section.settings.back_label_ar | default: back_label
    assign heading = section.settings.heading_ar | default: heading
    assign intro = section.settings.intro_ar | default: intro
    assign body = section.settings.body_ar | default: body
    assign primary_cta_label = section.settings.primary_cta_label_ar | default: primary_cta_label
    assign secondary_cta_label = section.settings.secondary_cta_label_ar | default: secondary_cta_label
    assign policy_heading = section.settings.policy_heading_ar | default: policy_heading
    assign policy_text = section.settings.policy_text_ar | default: policy_text
    assign policy_link_label = section.settings.policy_link_label_ar | default: policy_link_label
    assign faq_heading = section.settings.faq_heading_ar | default: faq_heading
    assign disclaimer = section.settings.disclaimer_ar | default: disclaimer
    assign home_label = 'الرئيسية'
    assign breadcrumb_aria_label = 'مسار التنقل'
  endif

  assign visible_faq_count = 0
  for block in faq_blocks
    assign faq_question = block.settings.question
    assign faq_answer = block.settings.answer
    if is_arabic
      assign faq_question = block.settings.question_ar | default: faq_question
      assign faq_answer = block.settings.answer_ar | default: faq_answer
    endif
    if faq_question != blank and faq_answer != blank
      assign visible_faq_count = visible_faq_count | plus: 1
    endif
  endfor
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "{{ canonical_url }}#webpage",
      "name": {{ heading | json }},
      "description": {{ intro | strip_html | json }},
      "url": {{ canonical_url | json }},
      "inLanguage": {{ locale_code | json }},
      {%- if pillar_url != blank %}
      "isPartOf": {
        "@type": "WebPage",
        "@id": "{{ shop.url }}{{ pillar_url }}#webpage"
      },
      {%- endif %}
      "publisher": {
        "@id": {{ shop.secure_url | append: '#organization' | json }}
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ canonical_url }}#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ home_label | json }},
          "item": {{ shop.url | json }}
        }
        {%- if pillar_url != blank -%},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ pillar_label | json }},
          "item": {{ shop.url | append: pillar_url | json }}
        }
        {%- endif -%},
        {
          "@type": "ListItem",
          "position": {%- if pillar_url != blank -%}3{%- else -%}2{%- endif -%},
          "name": {{ breadcrumb_label | json }},
          "item": {{ canonical_url | json }}
        }
      ]
    }
  ]
}
</script>

{%- if visible_faq_count > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "{{ canonical_url }}#faq",
    "inLanguage": {{ locale_code | json }},
    "mainEntity": [
      {%- assign rendered_faq_count = 0 -%}
      {%- for block in faq_blocks -%}
        {%- liquid
          assign faq_question = block.settings.question
          assign faq_answer = block.settings.answer
          if is_arabic
            assign faq_question = block.settings.question_ar | default: faq_question
            assign faq_answer = block.settings.answer_ar | default: faq_answer
          endif
        -%}
        {%- if faq_question != blank and faq_answer != blank -%}
        {%- if rendered_faq_count > 0 -%},{%- endif -%}
        {
          "@type": "Question",
          "name": {{ faq_question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq_answer | strip_html | json }}
          }
        }
        {%- assign rendered_faq_count = rendered_faq_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

<section {% render 'section-attr', section: section %} aria-labelledby="dubai-cluster-title-{{ section.id }}" lang="{{ locale_code }}">
  <xo-container>
    <header class="dubai-cluster__header">
      <nav class="dubai-cluster__breadcrumb" aria-label="{{ breadcrumb_aria_label }}">
        <a href="{{ routes.root_url }}">{{ home_label }}</a>
        {%- if pillar_url != blank -%}
        <span aria-hidden="true">/</span>
        <a href="{{ pillar_url }}">{{ pillar_label }}</a>
        {%- endif -%}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ breadcrumb_label }}</span>
      </nav>
      {%- if pillar_url != blank and back_label != blank -%}
        <a class="dubai-cluster__back" href="{{ pillar_url }}">{{ back_label }}</a>
      {%- endif -%}
      <h1 id="dubai-cluster-title-{{ section.id }}" class="dubai-cluster__title">{{ heading }}</h1>
      <div class="dubai-cluster__intro">{{ intro }}</div>
      {%- if collection_url != blank or pillar_url != blank -%}
        <div class="dubai-cluster__actions">
          {%- if collection_url != blank and primary_cta_label != blank -%}
            <a class="dubai-cluster__button" href="{{ collection_url }}">{{ primary_cta_label }}</a>
          {%- endif -%}
          {%- if pillar_url != blank and secondary_cta_label != blank -%}
            <a class="dubai-cluster__button dubai-cluster__button--secondary" href="{{ pillar_url }}">{{ secondary_cta_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>

    {%- if body != blank -%}
      <div class="dubai-cluster__body">{{ body }}</div>
    {%- endif -%}

    {%- if step_blocks.size > 0 -%}
      <div class="dubai-cluster__steps">
        {%- for block in step_blocks -%}
          {%- liquid
            assign step_title = block.settings.title
            assign step_text = block.settings.text
            if is_arabic
              assign step_title = block.settings.title_ar | default: step_title
              assign step_text = block.settings.text_ar | default: step_text
            endif
          -%}
          {%- if step_title != blank and step_text != blank -%}
          <article class="dubai-cluster__step" {{ block.shopify_attributes }}>
            <h2 class="dubai-cluster__step-title">{{ step_title }}</h2>
            <p class="dubai-cluster__step-text">{{ step_text }}</p>
          </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if policy_heading != blank and policy_text != blank -%}
      <div class="dubai-cluster__shipping" aria-labelledby="dubai-cluster-policy-{{ section.id }}">
        <article class="dubai-cluster__shipping-card dubai-cluster__shipping-card--policy">
          <h2 id="dubai-cluster-policy-{{ section.id }}" class="dubai-cluster__shipping-title">{{ policy_heading }}</h2>
          <p class="dubai-cluster__shipping-text">{{ policy_text }}</p>
          {%- if policy_url != blank and policy_link_label != blank -%}
            <a class="dubai-cluster__policy-link" href="{{ policy_url }}">{{ policy_link_label }}</a>
          {%- endif -%}
        </article>
      </div>
    {%- endif -%}

    {%- if visible_faq_count > 0 -%}
      <section aria-labelledby="dubai-cluster-faq-{{ section.id }}">
        <h2 id="dubai-cluster-faq-{{ section.id }}" class="dubai-cluster__faq-title">{{ faq_heading }}</h2>
        {%- for block in faq_blocks -%}
          {%- liquid
            assign faq_question = block.settings.question
            assign faq_answer = block.settings.answer
            if is_arabic
              assign faq_question = block.settings.question_ar | default: faq_question
              assign faq_answer = block.settings.answer_ar | default: faq_answer
            endif
          -%}
          {%- if faq_question != blank and faq_answer != blank -%}
          <details class="dubai-cluster__faq-item" {{ block.shopify_attributes }}>
            <summary class="dubai-cluster__faq-question">{{ faq_question }}</summary>
            <div class="dubai-cluster__faq-answer">{{ faq_answer }}</div>
          </details>
          {%- endif -%}
        {%- endfor -%}
      </section>
    {%- endif -%}

    {%- if disclaimer != blank -%}
      <aside class="dubai-cluster__disclaimer" role="note">{{ disclaimer }}</aside>
    {%- endif -%}
  </xo-container>
</section>

{% schema %}
{
  "name": "Dubai cluster page",
  "tag": "section",
  "class": "section-dubai-cluster",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "pillar_label", "label": "Pillar breadcrumb label", "default": "Nootropics Dubai" },
    { "type": "url", "id": "pillar_url", "label": "Pillar URL" },
    { "type": "text", "id": "breadcrumb_label", "label": "Current page breadcrumb label", "default": "Cluster page" },
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "Back to Nootropics Dubai" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dubai cluster page" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "header", "content": "Arabic content" },
    { "type": "text", "id": "pillar_label_ar", "label": "Pillar breadcrumb label — Arabic" },
    { "type": "text", "id": "breadcrumb_label_ar", "label": "Current page breadcrumb label — Arabic" },
    { "type": "text", "id": "back_label_ar", "label": "Back link label — Arabic" },
    { "type": "text", "id": "heading_ar", "label": "Heading — Arabic" },
    { "type": "richtext", "id": "intro_ar", "label": "Introduction — Arabic" },
    { "type": "richtext", "id": "body_ar", "label": "Body — Arabic" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "url", "id": "collection_link", "label": "Fallback collection link" },
    { "type": "text", "id": "primary_cta_label", "label": "Primary CTA label", "default": "Explore category" },
    { "type": "text", "id": "secondary_cta_label", "label": "Secondary CTA label", "default": "View Nootropics Dubai hub" },
    { "type": "text", "id": "primary_cta_label_ar", "label": "Primary CTA label — Arabic" },
    { "type": "text", "id": "secondary_cta_label_ar", "label": "Secondary CTA label — Arabic" },
    { "type": "text", "id": "shipping_value_1", "label": "Shipping card 1 value", "default": "At checkout" },
    { "type": "text", "id": "shipping_title_1", "label": "Shipping card 1 title", "default": "Dubai delivery" },
    { "type": "textarea", "id": "shipping_text_1", "label": "Shipping card 1 text", "default": "Current services, estimates and charges depend on the address and checkout option." },
    { "type": "text", "id": "shipping_value_2", "label": "Shipping card 2 value", "default": "By address" },
    { "type": "text", "id": "shipping_title_2", "label": "Shipping card 2 title", "default": "Other Emirates" },
    { "type": "textarea", "id": "shipping_text_2", "label": "Shipping card 2 text", "default": "Enter the destination at checkout to confirm coverage and timing." },
    { "type": "text", "id": "shipping_value_3", "label": "Shipping card 3 value", "default": "Current policy" },
    { "type": "text", "id": "shipping_title_3", "label": "Shipping card 3 title", "default": "Delivery conditions" },
    { "type": "textarea", "id": "shipping_text_3", "label": "Shipping card 3 text", "default": "Review the shipping policy for current delivery conditions." },
    { "type": "text", "id": "policy_heading", "label": "Shipping policy heading", "default": "Current checkout details" },
    { "type": "textarea", "id": "policy_text", "label": "Shipping policy summary", "default": "Product availability and delivery options are confirmed for the entered address at checkout." },
    { "type": "text", "id": "policy_link_label", "label": "Shipping policy link label", "default": "Review shipping and returns" },
    { "type": "text", "id": "policy_heading_ar", "label": "Shipping policy heading — Arabic" },
    { "type": "textarea", "id": "policy_text_ar", "label": "Shipping policy summary — Arabic" },
    { "type": "text", "id": "policy_link_label_ar", "label": "Shipping policy link label — Arabic" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Common questions" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Educational information only. This is not medical advice. Follow the product label and speak with a qualified healthcare professional if you have a medical condition, are pregnant or nursing, or take medication." },
    { "type": "text", "id": "faq_heading_ar", "label": "FAQ heading — Arabic" },
    { "type": "textarea", "id": "disclaimer_ar", "label": "Disclaimer — Arabic" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "title_ar", "label": "Title — Arabic" },
        { "type": "textarea", "id": "text_ar", "label": "Text — Arabic" }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" },
        { "type": "text", "id": "question_ar", "label": "Question — Arabic" },
        { "type": "richtext", "id": "answer_ar", "label": "Answer — Arabic" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Dubai cluster page"
    }
  ]
}
{% endschema %}
