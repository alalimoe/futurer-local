{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = all_products['nx-01-baseline']
  endif
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign nx01_anchor = section.settings.anchor_id | default: 'nx01-buy-close' | handleize
  assign nx01_intro_class = 'nx01__intro'
  if section.settings.heading_alignment == 'center'
    assign nx01_intro_class = 'nx01__intro nx01__intro--center'
  endif
  assign form_id = 'nx01-purchase-close-' | append: section.id
  assign cta_label = section.settings.cta_label
-%}

{% render 'nx01-launch-css' %}

<section
  id="{{ nx01_anchor }}"
  class="nx01 nx01-buy xo-section xo-section--{{ section.id }}{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  style="{% if section.settings.padding_top != blank %}--nx01-pad-block-start: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom != blank %} --nx01-pad-block-end: {{ section.settings.padding_bottom }}px;{% endif %}"
  aria-labelledby="nx01-buy-heading-{{ section.id }}"
>
  <div class="nx01__inner">
    <div class="{{ nx01_intro_class }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nx01__label">
          <span class="nx01__label-rule" aria-hidden="true"></span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="nx01__heading" id="nx01-buy-heading-{{ section.id }}">{{ heading | escape }}</h2>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="nx01__sub">{{ subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="nx01-buy__purchase">
      {% render 'nx01-purchase', product: product, instance_id: 'close', form_id: form_id, cta_label: cta_label %}
    </div>

    {%- assign trust_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'trust' and block.settings.label != blank -%}
        {%- assign trust_count = trust_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if trust_count > 0 -%}
      <ul class="nx01-buy__trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust' and block.settings.label != blank -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
                <span class="nx01-buy__trust-icon" aria-hidden="true">{% render 'icon', name: block.settings.icon, size: '1.6rem' %}</span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a>
              {%- else -%}
                <span>{{ block.settings.label | escape }}</span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% style %}
  .nx01-buy {
    scroll-margin-top: var(--nx01-scroll-margin);
  }

  .nx01-buy__purchase {
    max-width: 44rem;
  }

  .nx01-buy__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem 3.2rem;
    margin: 4.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .nx01-buy__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.3rem;
    font-weight: 500;
    color: rgb(var(--nx01-body));
  }

  .nx01-buy__trust-icon {
    display: inline-flex;
    color: rgb(var(--nx01-navy-deep));
  }

  .nx01-buy__trust a {
    display: inline-flex;
    align-items: center;
    min-height: 4.8rem;
    color: inherit;
    text-underline-offset: 0.3rem;
  }

  @media screen and (min-width: 1100px) {
    .nx01-buy__trust {
      justify-content: space-between;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "NX-01 launch buy",
  "tag": "section",
  "class": "section-nx01-buy",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "header", "content": "Reuse" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Optional in-page link target. Leave blank to keep nx01-buy-close." },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "range", "id": "padding_top", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding bottom", "default": 48 },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NX-01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Add NX-01 to your routine" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Choose 1 or 2 bottles. The same selection is used at the top of the page." },
    { "type": "text", "id": "cta_label", "label": "Default button label", "default": "Add to cart" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Quantity tier",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "1 Bottle" },
        { "type": "range", "id": "quantity", "label": "Quantity", "min": 1, "max": 6, "step": 1, "default": 1 },
        { "type": "text", "id": "days_label", "label": "Supply label", "default": "30 Day Supply" },
        { "type": "text", "id": "label", "label": "Badge", "default": "Starter" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Best for testing biological compatibility and establishing immediate routine compliance." },
        { "type": "text", "id": "saving", "label": "Saving label" },
        { "type": "text", "id": "cta_label", "label": "Button label" },
        { "type": "checkbox", "id": "featured", "label": "Highlight this tier", "default": false },
        { "type": "checkbox", "id": "subscribe", "label": "Use product subscription (selling plan)", "default": false }
      ]
    },
    {
      "type": "trust",
      "name": "Trust marker",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "shipping-fast", "label": "Shipping" },
          { "value": "padlock", "label": "Lock" },
          { "value": "verified-user", "label": "Support" },
          { "value": "return", "label": "Returns" },
          { "value": "none", "label": "None" }
        ], "default": "shipping-fast" },
        { "type": "text", "id": "label", "label": "Label", "default": "See current delivery estimates" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "NX-01 launch buy",
      "blocks": [
        { "type": "trust", "settings": { "icon": "shipping-fast", "label": "See current delivery estimates" } },
        { "type": "trust", "settings": { "icon": "padlock", "label": "Secure checkout" } },
        { "type": "trust", "settings": { "icon": "verified-user", "label": "Questions? Ask the Nootropix team" } },
        { "type": "trust", "settings": { "icon": "return", "label": "Unopened returns: see eligibility and terms" } }
      ]
    }
  ]
}
{% endschema %}
