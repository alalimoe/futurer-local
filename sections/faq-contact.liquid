{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .xo-section--{{ section.id }} .fc__title {
    font-size: clamp(2rem, 2.2vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: rgba(var(--color-foreground));
    margin: 0 0 4px;
  }

  .xo-section--{{ section.id }} .fc__lead {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
    margin-top: 6px;
    font-size: 1.5rem;
  }

  .xo-section--{{ section.id }} .fc__row {
    display: grid;
    gap: 6px;
    margin-bottom: 14px;
  }

  .xo-section--{{ section.id }} .fc__row label {
    font-size: 1.4rem;
    font-weight: 600;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .fc__row input,
  .xo-section--{{ section.id }} .fc__row textarea {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: 10px 14px;
    min-height: 48px;
    box-sizing: border-box;
    font-size: 1.5rem;
    background: rgba(var(--color-background));
    color: rgba(var(--color-foreground));
    transition: border-color 0.3s var(--out-soft, ease);
  }

  .xo-section--{{ section.id }} .fc__row input:focus,
  .xo-section--{{ section.id }} .fc__row textarea:focus {
    outline: none;
    border-color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .fc__row input:focus-visible,
  .xo-section--{{ section.id }} .fc__row textarea:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  .xo-section--{{ section.id }} .fc__row input::placeholder,
  .xo-section--{{ section.id }} .fc__row textarea::placeholder {
    opacity: 0.5;
  }

  .xo-section--{{ section.id }} .fc__btn {
    border: none;
    border-radius: var(--button-radius);
    padding: 12px 24px;
    min-height: 48px;
    background: rgba(var(--color-foreground));
    color: rgba(var(--color-background));
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.3s var(--out-soft, ease);
  }

  .xo-section--{{ section.id }} .fc__btn:hover {
    opacity: 0.85;
  }

  .xo-section--{{ section.id }} .fc__btn:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  .xo-section--{{ section.id }} .fc__success {
    color: rgba(var(--color-success, 16, 167, 31));
    margin-top: 12px;
    font-weight: 500;
    font-size: 1.5rem;
  }

  .xo-section--{{ section.id }} .fc__error {
    color: rgba(var(--color-error, 218, 30, 40));
    margin-top: 12px;
    font-weight: 500;
    font-size: 1.5rem;
  }

  .xo-section--{{ section.id }} .fc__embed iframe {
    width: 100%;
    min-height: 560px;
    height: 660px;
    border: 0;
    border-radius: var(--general-radius-3, 2rem);
  }

  .xo-section--{{ section.id }} .fc__channels {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin: 14px 0 18px;
  }

  .xo-section--{{ section.id }} .fc__channel {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 18px;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--button-radius, 10rem);
    background: rgba(var(--color-background));
    color: rgba(var(--color-foreground));
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.3s var(--out-soft, ease);
  }

  .xo-section--{{ section.id }} .fc__channel:hover {
    border-color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .fc__channel:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  .xo-section--{{ section.id }} .fc__channel--primary {
    background: rgba(var(--color-accent));
    border-color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .fc__response {
    font-size: 1.3rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 62%, transparent);
    margin: 0;
    flex-basis: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ section.id }} .fc__row input,
    .xo-section--{{ section.id }} .fc__row textarea,
    .xo-section--{{ section.id }} .fc__btn {
      transition: none;
    }
  }
{%- endstyle -%}

<section {% render 'section-attr' %}>
  <xo-container>
    <h2 class="fc__title">{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}
      <p class="fc__lead">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.support_email != blank or section.settings.whatsapp_number != blank %}
      <div class="fc__channels">
        {% if section.settings.support_email != blank %}
          <a class="fc__channel fc__channel--primary" href="mailto:{{ section.settings.support_email }}?subject=Order%20help">
            {% render 'icon', name: 'mail', size: '1.8rem', color: 'currentColor' %}
            Email {{ section.settings.support_email }}
          </a>
        {% endif %}
        {% if section.settings.whatsapp_number != blank %}
          {% assign wa_msg = section.settings.whatsapp_msg | default: 'Hi Nootropix! I need help with my order.' | url_encode %}
          <a class="fc__channel" rel="noopener" target="_blank" href="https://wa.me/{{ section.settings.whatsapp_number | remove: ' ' | remove: '+' }}?text={{ wa_msg }}">
            WhatsApp us
          </a>
        {% endif %}
        {% if section.settings.response_note != blank %}
          <p class="fc__response">{{ section.settings.response_note }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.use_embed and section.settings.helpdesk_embed != blank %}
      <div class="fc__embed">
        {{ section.settings.helpdesk_embed }}
      </div>
    {% else %}
      <div class="fc__form">
        {% form 'contact' %}
          <div class="fc__row">
            <label for="ContactFormName-{{ section.id }}">Name</label>
            <input id="ContactFormName-{{ section.id }}" type="text" name="contact[name]" required autocomplete="name">
          </div>
          <div class="fc__row">
            <label for="ContactFormEmail-{{ section.id }}">Email</label>
            <input id="ContactFormEmail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email">
          </div>
          <div class="fc__row">
            <label for="ContactFormOrder-{{ section.id }}">Order # (optional)</label>
            <input id="ContactFormOrder-{{ section.id }}" type="text" name="contact[Order Number]">
          </div>
          <div class="fc__row">
            <label for="ContactFormBody-{{ section.id }}">How can we help?</label>
            <textarea id="ContactFormBody-{{ section.id }}" name="contact[body]" rows="6" required></textarea>
          </div>
          <button class="fc__btn" type="submit">Send message</button>
          {% if form.posted_successfully? %}
            <p class="fc__success" role="status" aria-live="polite">Thanks! We'll get back to you shortly.</p>
          {% endif %}
          {% if form.errors %}
            <p class="fc__error" role="alert">Please check the form and try again.</p>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}
  </xo-container>
</section>

{% schema %}
{
  "name": "FAQ – Help & Support",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Still need help?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Message us and we'll jump on it." },
    { "type": "text", "id": "support_email", "label": "Support email (shown as direct CTA)", "default": "support@nootropix.shop" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (digits only, blank to hide)", "info": "Only add once a WhatsApp Business auto-reply or helpdesk channel is set up." },
    { "type": "text", "id": "whatsapp_msg", "label": "WhatsApp prefilled message", "default": "Hi Nootropix! I need help with my order." },
    { "type": "text", "id": "response_note", "label": "Response-time note", "default": "We reply within a few hours, 9am–10pm GST, 7 days a week." },
    { "type": "checkbox", "id": "use_embed", "label": "Use embed form", "default": false },
    { "type": "html", "id": "helpdesk_embed", "label": "Embed code (iframe/script)", "default": "<!-- paste HelpDesk iframe here, then toggle 'Use embed form' on -->" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 24 }
  ],
  "presets": [{ "name": "FAQ – Help & Support" }]
}
{% endschema %}
