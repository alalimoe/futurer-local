{%- liquid
  assign pieces_image = section.settings.pieces_image
  assign nx01_image = section.settings.nx01_image
  assign piece_count = 0
  assign piece_image_count = 0
  for block in section.blocks
    if block.type == 'piece'
      if block.settings.label != blank or block.settings.image != blank
        assign piece_count = piece_count | plus: 1
      endif
      if block.settings.image != blank
        assign piece_image_count = piece_image_count | plus: 1
      endif
    endif
  endfor
  assign show_composite = false
  if pieces_image != blank
    assign show_composite = true
  endif
  assign show_piece_row = false
  if piece_count > 0 and show_composite == false
    assign show_piece_row = true
  endif
  assign use_piece_images = false
  if piece_count > 0 and piece_image_count == piece_count
    assign use_piece_images = true
  endif
  assign show_result = false
  if nx01_image != blank or section.settings.result_name != blank
    assign show_result = true
  endif
  assign show_transition = false
  if show_piece_row or show_composite or show_result
    assign show_transition = true
  endif
  assign show_pieces_wrap = false
  if show_piece_row
    assign show_pieces_wrap = true
  endif
  if show_composite == false
    if show_result
      assign show_pieces_wrap = true
    endif
  endif
  assign show_link = false
  if section.settings.link_label != blank and section.settings.link_href != blank
    assign show_link = true
  endif
  assign nx01_alt = section.settings.nx01_alt | strip
  if nx01_alt == blank
    assign nx01_alt = section.settings.result_name
  endif
  assign result_image_size = section.settings.result_image_size | default: 360
  assign result_image_size_mobile = result_image_size | times: 0.75 | round
  assign result_image_sizes = '(max-width: 767px) ' | append: result_image_size_mobile | append: 'px, ' | append: result_image_size | append: 'px'
  assign nx01_anchor = section.settings.anchor_id | default: 'nx01-why' | handleize
-%}

{% render 'nx01-launch-css' %}

<section
  id="{{ nx01_anchor }}"
  class="nx01 nx01-story xo-section xo-section--{{ section.id }}{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  style="--nx01-result-size: {{ result_image_size }}px;{% if section.settings.padding_top != blank %} --nx01-pad-block-start: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom != blank %} --nx01-pad-block-end: {{ section.settings.padding_bottom }}px;{% endif %}"
  aria-labelledby="nx01-story-heading-{{ section.id }}"
>
  <div class="nx01__inner nx01-story__inner">
    <div class="nx01-story__intro">
      <div class="nx01-story__lead">
        {%- if section.settings.eyebrow != blank -%}
          <p class="nx01__label">
            <span class="nx01__label-rule" aria-hidden="true"></span>
            <span>{{ section.settings.eyebrow | escape }}</span>
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="nx01__heading nx01-story__heading" id="nx01-story-heading-{{ section.id }}">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.lead != blank -%}
          <p class="nx01-story__lead-sub">{{ section.settings.lead | escape }}</p>
        {%- endif -%}

        {%- if section.settings.quote != blank -%}
          <blockquote class="nx01-story__quote">
            <p>{{ section.settings.quote | escape }}</p>
            {%- if section.settings.quote_credit != blank -%}
              <footer>{{ section.settings.quote_credit | escape }}</footer>
            {%- endif -%}
          </blockquote>
        {%- endif -%}
      </div>

      {%- if section.settings.supporting != blank or section.settings.body != blank or show_link -%}
        <div class="nx01-story__explain">
          {%- if section.settings.supporting != blank -%}
            <p class="nx01-story__supporting">{{ section.settings.supporting | escape }}</p>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="nx01-story__body">{{ section.settings.body }}</div>
          {%- endif -%}

          {%- if show_link -%}
            <a class="nx01-story__link" href="{{ section.settings.link_href | escape }}">
              {{ section.settings.link_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if show_transition -%}
      <div class="nx01-story__transition" aria-label="{{ 'sections.nx01_launch_story.transition_label' | t }}">
        {%- if section.settings.transition_heading != blank -%}
          <p class="nx01-story__transition-heading">{{ section.settings.transition_heading | escape }}</p>
        {%- endif -%}
        {%- if show_composite -%}
          <div class="nx01-story__media">
            <div class="nx01-story__media-from">
              {{
                pieces_image
                | image_url: width: 1200
                | image_tag:
                  class: 'nx01-story__img',
                  loading: 'lazy',
                  widths: '480, 720, 960, 1200',
                  sizes: '(max-width: 767px) min(640px, 92vw), min(520px, 42vw)',
                  alt: section.settings.pieces_alt,
                  width: pieces_image.width,
                  height: pieces_image.height,
                  decoding: 'async'
              }}
              {%- if section.settings.pieces_caption != blank -%}
                <p class="nx01-story__caption">{{ section.settings.pieces_caption | escape }}</p>
              {%- endif -%}
            </div>

            <span class="nx01-story__arrow" aria-hidden="true"></span>

            <div class="nx01-story__media-to">
              {%- if nx01_image != blank -%}
                <span class="nx01-story__figure nx01-story__figure--one">
                  {{
                    nx01_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'nx01-story__bottle nx01-story__bottle--one',
                      loading: 'lazy',
                      widths: '160, 240, 320, 360, 540, 720, 900',
                      sizes: result_image_sizes,
                      alt: nx01_alt,
                      width: nx01_image.width,
                      height: nx01_image.height,
                      decoding: 'async'
                  }}
                </span>
              {%- endif -%}
              {%- if section.settings.result_caption != blank -%}
                <p class="nx01-story__caption">{{ section.settings.result_caption | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if show_pieces_wrap -%}
          <div class="nx01-story__pieces">
            {%- if show_piece_row -%}
              <ul class="nx01-story__piece-list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'piece' -%}
                    {%- if block.settings.label != blank or block.settings.image != blank -%}
                      {%- liquid
                        assign piece_image = blank
                        if use_piece_images
                          assign piece_image = block.settings.image
                        endif
                        assign piece_alt = block.settings.alt | strip
                        if piece_alt == blank
                          assign piece_alt = block.settings.label
                        endif
                      -%}
                      <li
                        class="nx01-story__piece{% if piece_image != blank %} nx01-story__piece--photo{% endif %}"
                        {{ block.shopify_attributes }}
                      >
                        {%- if piece_image != blank -%}
                          <span class="nx01-story__figure">
                            {{
                              piece_image
                              | image_url: width: 360
                              | image_tag:
                                class: 'nx01-story__bottle',
                                loading: 'lazy',
                                widths: '120, 180, 240, 360',
                                sizes: '(max-width: 767px) 104px, 120px',
                                alt: piece_alt,
                                width: piece_image.width,
                                height: piece_image.height,
                                decoding: 'async'
                            }}
                          </span>
                        {%- else -%}
                          <span class="nx01-story__vial" aria-hidden="true"></span>
                          {%- if block.settings.label != blank -%}
                            <span class="nx01-story__piece-name">{{ block.settings.label | escape }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      </li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if show_result -%}
              {%- if show_piece_row -%}
                <span class="nx01-story__arrow" aria-hidden="true"></span>
              {%- endif -%}
              <div class="nx01-story__result{% if nx01_image != blank %} nx01-story__result--photo{% endif %}">
                {%- if nx01_image != blank -%}
                  <span class="nx01-story__figure nx01-story__figure--one">
                    {{
                      nx01_image
                      | image_url: width: 900
                      | image_tag:
                        class: 'nx01-story__bottle nx01-story__bottle--one',
                        loading: 'lazy',
                        widths: '160, 240, 320, 360, 540, 720, 900',
                        sizes: result_image_sizes,
                        alt: nx01_alt,
                        width: nx01_image.width,
                        height: nx01_image.height,
                        decoding: 'async'
                    }}
                  </span>
                {%- else -%}
                  <span class="nx01-story__vial nx01-story__vial--one" aria-hidden="true"></span>
                  {%- if section.settings.result_name != blank -%}
                    <span class="nx01-story__result-name">{{ section.settings.result_name | escape }}</span>
                  {%- endif -%}
                {%- endif -%}
                {%- if section.settings.result_caption != blank -%}
                  <p class="nx01-story__caption">{{ section.settings.result_caption | escape }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.transition_note != blank -%}
          <p class="nx01-story__transition-note">{{ section.settings.transition_note | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  .nx01-story {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 0.1rem solid rgb(var(--nx01-line));
    border-bottom: 0.1rem solid rgb(var(--nx01-line));
  }

  .nx01-story__inner {
    display: flex;
    flex-direction: column;
    gap: 6.4rem;
  }

  .nx01-story__intro {
    display: flex;
    flex-direction: column;
    gap: 4.8rem;
  }

  .nx01-story__lead {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.6rem;
    max-width: 72rem;
  }

  .nx01-story__heading {
    margin: 0;
    font-size: clamp(3.6rem, 6vw, 6.4rem);
    letter-spacing: -0.04em;
    line-height: 1.08;
  }

  .nx01-story__lead-sub {
    margin: 0;
    max-width: 56rem;
    font-size: 1.8rem;
    font-weight: 400;
    line-height: 1.55;
    color: rgb(var(--nx01-body));
  }

  .nx01-story__transition-heading {
    margin: 0 0 3.2rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 3.4vw, 3.6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-align: center;
    color: rgb(var(--nx01-ink));
  }

  .nx01-story__transition-note {
    margin: 3.2rem 0 0;
    font-size: 1.4rem;
    line-height: 1.5;
    text-align: center;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 62%, transparent);
  }

  .nx01-story__quote {
    margin: 2.8rem 0 0;
    padding: 0;
    border: 0;
  }

  .nx01-story__quote p {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 3.2vw, 3.2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.2;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
  }

  .nx01-story__quote p::before {
    content: "“";
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.55em;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 28%, transparent);
  }

  .nx01-story__quote footer {
    margin-top: 1.6rem;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 46%, transparent);
  }

  .nx01-story__supporting {
    margin: 0 0 1.6rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 2.4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.25;
    color: rgb(var(--color-foreground));
  }

  .nx01-story__explain {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.4rem;
    padding-block-start: 4rem;
    border-block-start: 0.1rem solid rgb(var(--nx01-line));
  }

  .nx01-story__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
    width: 100%;
    max-width: none;
    margin: 0;
    counter-reset: nx01-story-beat;
    font-size: 1.6rem;
    line-height: 1.6;
    color: rgb(var(--nx01-body));
  }

  .nx01-story__body p {
    position: relative;
    margin: 0;
    padding-block-start: 3.6rem;
    counter-increment: nx01-story-beat;
  }

  .nx01-story__body p::before {
    content: counter(nx01-story-beat, decimal-leading-zero);
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    color: rgb(var(--nx01-navy-deep));
  }

  .nx01-story__body p strong {
    display: block;
    margin-block-end: 0.8rem;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: rgb(var(--nx01-ink));
  }

  .nx01-story__link {
    display: inline-flex;
    align-items: center;
    min-height: 4.8rem;
    margin-top: 1.6rem;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 22%, transparent);
  }

  .nx01-story__link::after {
    content: "";
    width: 0.6rem;
    height: 0.6rem;
    margin-inline-start: 0.8rem;
    border-top: 1px solid currentColor;
    border-right: 1px solid currentColor;
    transform: rotate(45deg);
  }

  .nx01-story__link:hover,
  .nx01-story__link:focus-visible {
    border-bottom-color: rgb(var(--color-foreground));
  }

  .nx01-story__link:focus-visible {
    outline: 2px solid rgb(var(--color-foreground));
    outline-offset: 0.4rem;
  }

  .nx01-story__transition {
    padding-top: 4rem;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
  }

  .nx01-story__media {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    align-items: end;
    gap: 2.4rem;
  }

  .nx01-story__media-from,
  .nx01-story__media-to {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }

  .nx01-story__img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .nx01-story__caption,
  .nx01-story__piece-name,
  .nx01-story__result-name {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-transform: none;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 72%, transparent);
  }

  .nx01-story__piece-name {
    min-height: 2.6em;
  }

  .nx01-story__result-name {
    color: rgb(var(--color-foreground));
  }

  .nx01-story__pieces {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.4rem;
  }

  .nx01-story__piece-list {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    max-width: 36rem;
    gap: 1.6rem 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nx01-story__piece,
  .nx01-story__result {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin: 0;
    text-align: center;
  }

  .nx01-story__piece {
    flex: 0 0 calc((100% - 2.4rem) / 3);
    width: calc((100% - 2.4rem) / 3);
    max-width: 10.4rem;
  }

  .nx01-story__result {
    width: auto;
    max-width: var(--nx01-result-size, 36rem);
  }

  .nx01-story__figure {
    position: relative;
    display: block;
    width: 100%;
  }

  .nx01-story__figure::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 2%;
    width: 62%;
    height: 12%;
    transform: translateX(-50%);
    background: radial-gradient(ellipse, color-mix(in srgb, rgba(var(--color-foreground)) 18%, transparent), transparent 72%);
    filter: blur(0.8rem);
    pointer-events: none;
    z-index: 0;
  }

  .nx01-story__bottle {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .nx01-story__figure--one,
  .nx01-story__bottle--one {
    width: min(100%, calc(var(--nx01-result-size, 36rem) * 0.75));
  }

  .nx01-story__vial {
    position: relative;
    display: block;
    width: 1.8rem;
    height: 4.6rem;
    margin-top: 0.8rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 28%, transparent);
    border-radius: 999px;
    background: transparent;
  }

  .nx01-story__vial::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 12%;
    right: 12%;
    height: 1px;
    transform: none;
    border: 0;
    border-radius: 0;
    background: color-mix(in srgb, rgba(var(--color-foreground)) 22%, transparent);
  }

  .nx01-story__piece:nth-child(6n + 1) .nx01-story__vial {
    width: 1.5rem;
    height: 5.4rem;
  }

  .nx01-story__piece:nth-child(6n + 2) .nx01-story__vial {
    width: 2.2rem;
    height: 3.6rem;
  }

  .nx01-story__piece:nth-child(6n + 3) .nx01-story__vial {
    width: 1.7rem;
    height: 4.8rem;
  }

  .nx01-story__piece:nth-child(6n + 4) .nx01-story__vial {
    width: 2rem;
    height: 4.2rem;
  }

  .nx01-story__piece:nth-child(6n + 5) .nx01-story__vial {
    width: 1.6rem;
    height: 5rem;
  }

  .nx01-story__piece:nth-child(6n) .nx01-story__vial {
    width: 2.4rem;
    height: 3.8rem;
  }

  .nx01-story__vial--one {
    width: 2.8rem;
    height: 7.2rem;
    border-color: color-mix(in srgb, rgba(var(--color-foreground)) 42%, transparent);
    background: color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }

  .nx01-story__vial--one::before {
    background: color-mix(in srgb, rgba(var(--color-foreground)) 32%, transparent);
  }

  .nx01-story__arrow {
    display: block;
    position: relative;
    flex: 0 0 auto;
    width: 1px;
    height: 3.2rem;
    background: color-mix(in srgb, rgba(var(--color-foreground)) 28%, transparent);
  }

  .nx01-story__arrow::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0.7rem;
    height: 0.7rem;
    border-right: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 36%, transparent);
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 36%, transparent);
    transform: translate(-50%, 0.15rem) rotate(45deg);
  }

  @media screen and (min-width: 768px) {
    .nx01-story__inner {
      gap: 8rem;
    }

    .nx01-story__quote {
      margin-top: 4rem;
    }

    .nx01-story__body {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
      gap: 4.8rem;
    }

    .nx01-story__pieces {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      gap: 3.2rem;
    }

    .nx01-story__piece-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      max-width: 64rem;
      gap: 2.4rem;
    }

    .nx01-story__piece {
      width: 100%;
      max-width: 12rem;
      margin: 0;
      justify-self: center;
    }

    .nx01-story__figure--one,
    .nx01-story__bottle--one {
      width: min(100%, var(--nx01-result-size, 36rem));
    }

    .nx01-story__result {
      flex-direction: column;
      align-items: center;
      align-self: flex-end;
      max-width: var(--nx01-result-size, 36rem);
    }

    .nx01-story__pieces > .nx01-story__arrow {
      width: 1px;
      height: 3.2rem;
      margin: 0;
    }
  }

  @media screen and (min-width: 990px) {
    .nx01-story__media {
      grid-template-columns: minmax(0, 1fr) 4.8rem minmax(0, 0.42fr);
      justify-items: stretch;
      column-gap: 3.2rem;
    }

    .nx01-story__media-from,
    .nx01-story__media-to {
      align-items: flex-start;
    }

    .nx01-story__media .nx01-story__arrow {
      align-self: center;
      width: 4.8rem;
      height: 1px;
    }

    .nx01-story__media .nx01-story__arrow::after {
      inset-inline-start: auto;
      inset-inline-end: 0;
      bottom: auto;
      top: 50%;
      border-bottom: 0;
      border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 36%, transparent);
      transform: translate(0.15rem, -50%) rotate(45deg);
    }
  }

  @media screen and (min-width: 1200px) {
    .nx01-story__pieces {
      grid-template-columns: minmax(0, 1fr) 4.8rem auto;
      align-items: end;
      justify-items: stretch;
    }

    .nx01-story__piece-list {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      max-width: none;
    }

    .nx01-story__pieces > .nx01-story__arrow {
      width: 4.8rem;
      height: 1px;
      margin-bottom: 3.8rem;
    }

    .nx01-story__pieces > .nx01-story__arrow::after {
      inset-inline-start: auto;
      inset-inline-end: 0;
      bottom: auto;
      top: 50%;
      border-bottom: 0;
      border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 36%, transparent);
      transform: translate(0.15rem, -50%) rotate(45deg);
    }
  }

  [dir="rtl"] .nx01-story__link::after {
    transform: rotate(-135deg);
  }

  [dir="rtl"] .nx01-story__media .nx01-story__arrow::after,
  [dir="rtl"] .nx01-story__pieces > .nx01-story__arrow::after {
    inset-inline-start: 0;
    inset-inline-end: auto;
    transform: translate(-0.15rem, -50%) rotate(-135deg);
  }
{% endstyle %}

