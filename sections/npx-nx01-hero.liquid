  endif
  assign text_per_day = 'sections.npx_nx01_hero.per_day' | t
  if nx_labels != blank
    assign text_per_day = nx_labels.settings.per_day
  endif
  assign text_quantity = 'sections.npx_nx01_hero.quantity' | t
