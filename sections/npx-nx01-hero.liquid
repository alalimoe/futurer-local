{% javascript %}
if (!customElements.get('npx-nx01-hero')) {
  customElements.define('npx-nx01-hero', class extends HTMLElement {
    connectedCallback() {
      if (this.controller) return;
      this.controller = new AbortController();
      const options = { signal: this.controller.signal };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => this.initialize(), { ...options, once: true });
      else this.initialize();
    }
    initialize() {
      if (!this.isConnected || !this.controller || this.initialized) return;
      this.initialized = true;
      const options = { signal: this.controller.signal };
      this.form = this.querySelector('.npx-hero__form');
      this.variant = this.querySelector('[data-variant]');
      this.quantity = this.querySelector('[data-quantity]');
      this.add = this.querySelector('[data-add]');
      this.cartAdd = this.querySelector('[data-cart-add]');
      if (!this.form || !this.variant || !this.quantity) return;
      try { this.money = new Intl.NumberFormat(this.dataset.locale || 'en', { style: 'currency', currency: this.dataset.currency || 'AED' }); }
      catch (_) { this.money = new Intl.NumberFormat('en', { style: 'currency', currency: 'AED' }); }
      this.querySelectorAll('[data-quantity-change]').forEach((button) => { button.hidden = false; });
      this.addEventListener('click', (event) => this.onClick(event), options);
      this.variant.addEventListener('change', () => this.update(true), options);
      this.quantity.addEventListener('input', () => this.update(false), options);
      this.quantity.addEventListener('change', () => this.update(false), options);
      this.form.addEventListener('submit', (event) => {
        if (!this.cartAdd || typeof customElements.get('xo-cart-add') === 'undefined') {
          if (this.pending || !this.form.checkValidity() || this.selection().available !== 'true') {
            event.preventDefault();
            return;
          }
          this.pending = true;
          if (this.add) {
            this.add.disabled = true;
            this.add.setAttribute('aria-busy', 'true');
          }
          const addText = this.querySelector('[data-add-text]');
          const status = this.querySelector('[data-status]');
          if (addText) addText.textContent = this.dataset.addingLabel;
          if (status) status.textContent = this.dataset.addingLabel;
          return;
        }
        event.preventDefault();
        if (!this.form.checkValidity() || this.selection().available !== 'true') return;
        this.add?.click();
      }, options);
      window.addEventListener('pageshow', () => this.reset(), options);
      this.reset();
    }
    disconnectedCallback() {
      this.controller?.abort();
      this.controller = null;
      this.initialized = false;
    }
    selection() {
      return this.variant.tagName === 'SELECT' ? this.variant.selectedOptions[0].dataset : this.variant.dataset;
    }
    reset() {
      this.pending = false;
      this.add?.removeAttribute('aria-busy');
      const status = this.querySelector('[data-status]');
      if (status) status.textContent = '';
      this.update(false);
    }
    syncCartAdd(selected) {
      if (!this.cartAdd) return;
      this.cartAdd.setAttribute('xo-variant-id', this.variant.value);
      if (selected.available === 'true') this.cartAdd.removeAttribute('xo-disabled');
      else this.cartAdd.setAttribute('xo-disabled', '');
    }
    update(variantChanged) {
      if (this.pending) return;
      const selected = this.selection();
      if (variantChanged) {
        this.quantity.min = selected.min || '1';
        this.quantity.step = selected.step || '1';
        if (selected.max) this.quantity.max = selected.max;
        else this.quantity.removeAttribute('max');
        this.quantity.value = selected.min || '1';
      }
      const valid = this.quantity.checkValidity();
      const amount = Number(this.quantity.value);
      if (valid) {
        const priceLabel = this.querySelector('[data-price-label]');
        const perBottle = this.querySelector('[data-per-bottle]');
        const total = this.querySelector('[data-total]');
        const daily = this.querySelector('[data-daily]');
        const supply = this.querySelector('[data-supply]');
        if (priceLabel) priceLabel.textContent = this.dataset.totalLabel;
        if (perBottle) perBottle.hidden = true;
        if (total) total.textContent = this.money.format(Number(selected.price) * amount / 100);
        if (daily) daily.textContent = this.money.format(Number(selected.price) / 100 / Number(this.dataset.servings));
        if (supply) supply.textContent = String(amount * Number(this.dataset.servings));
      }
      if (this.add) {
        this.add.disabled = selected.available !== 'true';
        const addText = this.querySelector('[data-add-text]');
        if (addText) addText.textContent = this.add.disabled ? this.dataset.soldLabel : this.dataset.addLabel;
      }
      this.syncCartAdd(selected);
      const minus = this.querySelector('[data-quantity-change="-1"]');
      const plus = this.querySelector('[data-quantity-change="1"]');
      if (minus) minus.disabled = valid && amount <= Number(this.quantity.min || 1);
      if (plus) plus.disabled = valid && !!this.quantity.max && amount >= Number(this.quantity.max);
    }
    onClick(event) {
      const quantityButton = event.target.closest('[data-quantity-change]');
      if (quantityButton && !this.pending) {
        if (Number(quantityButton.dataset.quantityChange) > 0) this.quantity.stepUp();
        else this.quantity.stepDown();
        this.quantity.dispatchEvent(new Event('input', { bubbles: true }));
      }
      const thumbnail = event.target.closest('[data-thumb]');
      if (!thumbnail || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button > 0) return;
      const main = this.querySelector('.npx-hero__photo');
      if (!main) return;
      event.preventDefault();
      main.removeAttribute('srcset');
      main.removeAttribute('sizes');
      main.src = thumbnail.dataset.src;
      main.alt = thumbnail.dataset.alt;
      const mainLink = this.querySelector('[data-main-link]');
      if (mainLink) mainLink.href = thumbnail.href;
      this.querySelectorAll('[data-thumb]').forEach((link) => link.removeAttribute('aria-current'));
      thumbnail.setAttribute('aria-current', 'true');
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "NX-01 product opening",
  "tag": "section",
  "class": "npx-nx01-hero-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Use on a dedicated NX-01 Baseline product template. Reads current product price, availability and images automatically."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Main benefit",
      "default": "Your daily stack, simplified."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Short introduction",
      "default": "<p>A caffeine-free daily formula with nine ingredients, including ALCAR, citicoline and NMN.</p>"
    },
    {
      "type": "range",
      "id": "capsules",
      "label": "Capsules per bottle",
      "min": 30,
      "max": 180,
      "step": 30,
      "default": 90
    },
    {
      "type": "range",
      "id": "servings",
      "label": "Daily servings per bottle",
      "min": 1,
      "max": 90,
      "step": 1,
      "default": 30,
      "info": "Used to calculate price per day and supply. Match the current approved label."
    },
    {
      "type": "range",
      "id": "daily_capsules",
      "label": "Capsules per daily serving",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "image_picker",
      "id": "label_image",
      "label": "Ingredients / label image",
      "info": "Defaults to the second product image. Select an approved, legible label image."
    },
    {
      "type": "url",
      "id": "shipping_link",
      "label": "Delivery and returns page"
    },
    {
      "type": "checkbox",
      "id": "show_payment_terms",
      "label": "Show Shopify payment terms",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show enabled payment methods",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "Include product structured data",
      "default": false,
      "info": "Leave off. Product structured data is already output by the theme."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "Image background",
      "default": "#F3F6FC"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Headings",
      "default": "#142342"
    },
    {
      "type": "color",
      "id": "text",
      "label": "Body text",
      "default": "#536076"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent and button",
      "default": "#243F95"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "image_zoom",
      "label": "Bottle photo scale",
      "min": 100,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 140,
      "info": "140% removes whitespace from current product photos. Use 100% for tightly cropped photos."
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content width",
      "min": 1000,
      "max": 1440,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "NX-01 product opening"
    }
  ]
}
{% endschema %}
