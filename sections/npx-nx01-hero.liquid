{{ 'npx-nx01-hero.css' | asset_url | stylesheet_tag }}
{{ 'sticky-cart.css' | asset_url | stylesheet_tag }}
{{ 'sticky-variant-modal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign nx_product = product
  assign nx_variant = nx_product.selected_or_first_available_variant
  assign form_id = 'npx-nx01-form-' | append: section.id
  assign heading_id = 'npx-nx01-heading-' | append: section.id
  assign image = nx_variant.featured_image | default: nx_product.featured_image
  assign label_image = section.settings.label_image | default: nx_product.images[1]
  assign daily_price = nx_variant.price | times: 1.0 | divided_by: section.settings.servings | round
  assign currency_code = cart.currency.iso_code | default: shop.currency
  assign initial_quantity = nx_variant.quantity_rule.min | default: 1
  assign photo_alt = image.alt | default: nx_product.title
-%}
{%- if nx_product != blank and nx_product.handle == 'nx-01-baseline' -%}
<xo-product
  xo-selected-or-first-available-variant-id="{{ nx_variant.id }}"
  xo-product-information
  xo-product-id="{{ nx_product.id }}"
  xo-section-id="{{ section.id }}"
  class="npx-hero-product"
>
  <npx-nx01-hero
    class="npx-hero"
    data-total-label="{{ 'sections.npx_nx01_hero.total' | t | escape }}"
    data-currency="{{ currency_code | escape }}"
    data-locale="{{ request.locale.iso_code | escape }}"
    data-servings="{{ section.settings.servings }}"
    data-add-label="{{ 'sections.npx_nx01_hero.add' | t | escape }}"
    data-adding-label="{{ 'sections.npx_nx01_hero.adding' | t | escape }}"
    data-sold-label="{{ 'sections.npx_nx01_hero.sold_out' | t | escape }}"
    style="--npx-hero-bg: {{ section.settings.background }}; --npx-hero-media: {{ section.settings.media_background }}; --npx-hero-ink: {{ section.settings.ink }}; --npx-hero-text: {{ section.settings.text }}; --npx-hero-accent: {{ section.settings.accent }}; --npx-hero-button-text: {{ section.settings.button_text }}; --npx-hero-width: {{ section.settings.max_width }}px; --npx-hero-top: {{ section.settings.padding_top }}px; --npx-hero-bottom: {{ section.settings.padding_bottom }}px; --npx-hero-zoom: {{ section.settings.image_zoom | divided_by: 100.0 }};"
  >
    <div class="npx-hero__inner">
      <nav class="npx-hero__breadcrumb" aria-label="{{ 'sections.npx_nx01_hero.home' | t | escape }}">
        <a href="{{ routes.root_url }}">{{ 'sections.npx_nx01_hero.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <a href="{{ routes.all_products_collection_url }}">{{ 'sections.npx_nx01_hero.shop' | t }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ nx_product.title | escape }}</span>
      </nav>
      <div class="npx-hero__layout">
        <header class="npx-hero__intro">
          <p class="npx-hero__eyebrow">{{ 'sections.npx_nx01_hero.eyebrow' | t }}</p>
          <h1 class="npx-hero__title" id="{{ heading_id }}">{{ nx_product.title | escape }}</h1>
          {% if section.settings.tagline != blank %}
            <p class="npx-hero__tagline">{{ section.settings.tagline | escape }}</p>
          {% endif %}
          {% if section.settings.intro != blank %}
            <div class="npx-hero__description">{{ section.settings.intro }}</div>
          {% endif %}
          {% if section.blocks.size > 0 %}
            <div class="npx-hero__apps">
              {% for block in section.blocks %}
                <div class="npx-hero__app" {{ block.shopify_attributes }}>{% render block %}</div>
              {% endfor %}
            </div>
          {% endif %}
        </header>
        <div class="npx-hero__gallery" aria-label="{{ 'sections.npx_nx01_hero.gallery' | t | escape }}">
          <div class="npx-hero__stage">
            <span class="npx-hero__badge"><span aria-hidden="true"></span>{{ 'sections.npx_nx01_hero.caffeine_free' | t }}</span>
            {% if image != blank %}
              <a class="npx-hero__photo-link" data-main-link href="{{ image | image_url: width: 2400 }}" target="_blank" rel="noopener" aria-label="{{ 'sections.npx_nx01_hero.enlarge' | t | escape }}">
                {{ image | image_url: width: 1400 | image_tag: class: 'npx-hero__photo', loading: 'eager', fetchpriority: 'high', widths: '480, 700, 1000, 1400', sizes: '(max-width: 749px) 440px, (max-width: 1000px) 65vw, 800px', alt: photo_alt }}
                <span class="npx-hero__zoom" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5M7 10h6m-3-3v6"/></svg></span>
              </a>
            {% else %}
              <div class="npx-hero__image-empty">{{ 'sections.npx_nx01_hero.image_empty' | t }}</div>
            {% endif %}
          </div>
          <div class="npx-hero__gallery-footer">
            <div class="npx-hero__thumbs">
              {% for photo in nx_product.images limit: 6 %}
                <a
                  class="npx-hero__thumb"
                  data-thumb
                  href="{{ photo | image_url: width: 2400 }}"
                  data-src="{{ photo | image_url: width: 1400 }}"
                  data-alt="{{ photo.alt | default: nx_product.title | escape }}"
                  {% if photo.id == image.id %}aria-current="true"{% endif %}
                  aria-label="{{ 'sections.npx_nx01_hero.image' | t | escape }} {{ forloop.index }}"
                >
                  {{ photo | image_url: width: 160 | image_tag: class: 'npx-hero__thumb-image', loading: 'lazy', alt: '' }}
                </a>
              {% endfor %}
            </div>
            {% if label_image != blank %}
              <a class="npx-hero__label-link" href="{{ label_image | image_url: width: 2400 }}" target="_blank" rel="noopener">
                {{ 'sections.npx_nx01_hero.label' | t }}<span aria-hidden="true">↗</span>
              </a>
            {% endif %}
          </div>
        </div>
        <div class="npx-hero__buy">
          <div class="npx-hero__facts">
            <div>
              <strong>{{ section.settings.capsules }}</strong>
              <span>{{ 'sections.npx_nx01_hero.capsules' | t }}</span>
            </div>
            <div>
              <strong>{{ section.settings.servings }}</strong>
              <span>{{ 'sections.npx_nx01_hero.servings' | t }}</span>
            </div>
            <div>
              <strong>{{ section.settings.daily_capsules }}</strong>
              <span>{{ 'sections.npx_nx01_hero.daily' | t }}</span>
            </div>
          </div>
          {% form 'product', nx_product, id: form_id, class: 'npx-hero__form', data-type: 'add-to-cart-form' %}
            {{ form.errors | default_errors }}
            {% if nx_product.has_only_default_variant %}
              <input
                type="hidden"
                name="id"
                value="{{ nx_variant.id }}"
                data-variant
                data-price="{{ nx_variant.price }}"
                data-available="{{ nx_variant.available }}"
                data-min="{{ initial_quantity }}"
                data-step="{{ nx_variant.quantity_rule.increment | default: 1 }}"
                data-max="{{ nx_variant.quantity_rule.max }}"
              >
            {% else %}
              <label class="npx-hero__option-label" for="npx-option-{{ section.id }}">{{ 'sections.npx_nx01_hero.option' | t }}</label>
              <select class="npx-hero__option" name="id" id="npx-option-{{ section.id }}" data-variant>
                {% for variant in nx_product.variants %}
                  <option
                    value="{{ variant.id }}"
                    data-price="{{ variant.price }}"
                    data-available="{{ variant.available }}"
                    data-min="{{ variant.quantity_rule.min | default: 1 }}"
                    data-step="{{ variant.quantity_rule.increment | default: 1 }}"
                    data-max="{{ variant.quantity_rule.max }}"
                    {% if variant.id == nx_variant.id %}selected{% endif %}
                  >
                    {{ variant.title | escape }} — {{ variant.price | money_with_currency }}
                    {% unless variant.available %} — {{ 'sections.npx_nx01_hero.sold_out' | t }}{% endunless %}
                  </option>
                {% endfor %}
              </select>
              <noscript><p class="npx-hero__fine">{{ 'sections.npx_nx01_hero.selection_note' | t }}</p></noscript>
            {% endif %}
            <div class="npx-hero__price-row">
              <div>
                <span class="npx-hero__price-label" data-price-label>{{ 'sections.npx_nx01_hero.per_bottle' | t }}</span>
                <strong class="npx-hero__price" data-total>{{ nx_variant.price | money_with_currency }}</strong>
              </div>
              <p class="npx-hero__daily">
                <span data-daily>{{ daily_price | money_with_currency }}</span>
                <span>{{ 'sections.npx_nx01_hero.per_day' | t }}</span>
              </p>
            </div>
            <div class="npx-hero__bnpl">
              {% render 'bnpl-box' %}
            </div>
            <div class="npx-hero__purchase-row">
              <div class="npx-hero__quantity-block">
                <label for="npx-quantity-{{ section.id }}">{{ 'sections.npx_nx01_hero.quantity' | t }}</label>
                <div class="npx-hero__quantity">
                  <button type="button" data-quantity-change="-1" aria-label="{{ 'sections.npx_nx01_hero.decrease' | t | escape }}" hidden>−</button>
                  <xo-cart-quantity>
                    <input
                      id="npx-quantity-{{ section.id }}"
                      type="number"
                      name="quantity"
                      inputmode="numeric"
                      min="{{ initial_quantity }}"
                      step="{{ nx_variant.quantity_rule.increment | default: 1 }}"
                      {% if nx_variant.quantity_rule.max != blank %}max="{{ nx_variant.quantity_rule.max }}"{% endif %}
                      value="{{ initial_quantity }}"
                      required
                      data-quantity
                    >
                  </xo-cart-quantity>
                  <button type="button" data-quantity-change="1" aria-label="{{ 'sections.npx_nx01_hero.increase' | t | escape }}" hidden>+</button>
                </div>
              </div>
              <p class="npx-hero__supply">
                <strong data-supply>{{ section.settings.servings }}</strong>
                {{ 'sections.npx_nx01_hero.supply' | t }}
                <span data-per-bottle> · {{ 'sections.npx_nx01_hero.per_bottle' | t }}</span>
              </p>
            </div>
            <xo-cart-add
              class="npx-hero__cart-add"
              xo-product-id="{{ nx_product.id }}"
              xo-variant-id="{{ nx_variant.id }}"
              xo-section-id="{{ section.id }}"
              data-cart-add
              {% unless nx_variant.available %}xo-disabled{% endunless %}
              {% if settings.cart_type == 'page' %}xo-cart-redirection{% endif %}
            >
              <button type="submit" name="add" class="npx-hero__add" {% unless nx_variant.available %}disabled{% endunless %} data-add>
                <span data-add-text>
                  {% if nx_variant.available %}
                    {{ 'sections.npx_nx01_hero.add' | t }}
                  {% else %}
                    {{ 'sections.npx_nx01_hero.sold_out' | t }}
                  {% endif %}
                </span>
                <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M5 8h14l1 13H4L5 8Zm4 0V6a3 3 0 0 1 6 0v2"/>
                </svg>
              </button>
            </xo-cart-add>
            <p class="npx-hero__status" role="status" aria-live="polite" data-status></p>
            {% if section.settings.show_payment_terms %}
              <div class="npx-hero__payment-terms">{{ form | payment_terms }}</div>
            {% endif %}
          {% endform %}
          <p class="npx-hero__delivery">
            {% if cart.taxes_included %}{{ 'sections.npx_nx01_hero.tax_included' | t }} {% endif %}
            {{ 'sections.npx_nx01_hero.shipping' | t }}
            {% if section.settings.shipping_link != blank %}
              <a href="{{ section.settings.shipping_link }}">{{ 'sections.npx_nx01_hero.shipping_link' | t }}</a>
            {% endif %}
          </p>
          {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
            <div class="npx-hero__payments">
              <span>
                <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.2">
                  <rect x="3" y="7" width="10" height="7" rx="1"/>
                  <path d="M5 7V5a3 3 0 0 1 6 0v2"/>
                </svg>
                {{ 'sections.npx_nx01_hero.secure' | t }}
              </span>
              <ul aria-label="{{ 'sections.npx_nx01_hero.payments' | t | escape }}">
                {% for payment in shop.enabled_payment_types %}
                  <li>{{ payment | payment_type_svg_tag: class: 'npx-hero__payment-icon' }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
          <p class="npx-hero__fine npx-hero__precautions">{{ 'sections.npx_nx01_hero.footer_note' | t }}</p>
        </div>
      </div>
      <div class="npx-hero__details">
        {% render 'product-description-metafields', accordion: true, section: section %}
      </div>
    </div>
  </npx-nx01-hero>
  {% render 'sticky-cart', product: nx_product %}
  {% render 'product-data', product: nx_product %}
</xo-product>
{% if section.settings.structured_data %}
  <script type="application/ld+json">{{ nx_product | structured_data }}</script>
{% endif %}
<script>
  // #region agent log
  (function () {
    var send = function (hypothesisId, message, data) {
      fetch('http://127.0.0.1:7906/ingest/73d01807-f919-4550-a2d5-12c9f0435bd9', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Debug-Session-Id': '70de97' },
        body: JSON.stringify({
          sessionId: '70de97',
          runId: data.assetHref ? 'post-fix' : 'pre-fix',
          hypothesisId: hypothesisId,
          location: 'npx-nx01-hero.liquid:inline',
          message: message,
          data: data,
          timestamp: Date.now()
        })
      }).catch(function () {});
    };
    var report = function () {
      var hero = document.querySelector('.npx-hero');
      var photo = document.querySelector('.npx-hero__photo');
      var cs = hero ? getComputedStyle(hero) : null;
      var photoCs = photo ? getComputedStyle(photo) : null;
      var sheetsWithHero = 0;
      var assetHref = null;
      var compiledHref = null;
      for (var i = 0; i < document.styleSheets.length; i++) {
        var sheet = document.styleSheets[i];
        var href = sheet.href || '';
        if (href.indexOf('npx-nx01-hero.css') !== -1) assetHref = href;
        if (href.indexOf('compiled_assets/styles.css') !== -1) compiledHref = href;
        try {
          var rules = sheet.cssRules || [];
          for (var j = 0; j < rules.length; j++) {
            if ((rules[j].cssText || '').indexOf('.npx-hero') !== -1) sheetsWithHero += 1;
          }
        } catch (e) {}
      }
      send('A', 'hero style attachment', {
        host: location.host,
        heroDisplay: cs ? cs.display : null,
        heroPadding: cs ? cs.padding : null,
        photoPosition: photoCs ? photoCs.position : null,
        photoH: photo ? photo.clientHeight : null,
        sheetsWithHero: sheetsWithHero,
        assetHref: assetHref,
        compiledHref: compiledHref,
        viewport: window.innerWidth,
        mobileMq: window.matchMedia('(max-width: 749px)').matches
      });
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', report);
    else report();
  })();
  // #endregion
</script>
{% elsif request.design_mode %}
  <p>{{ 'sections.npx_nx01_hero.wrong_product' | t }}</p>
{% endif %}

{% javascript %}
if (!customElements.get('npx-nx01-hero')) {
  customElements.define('npx-nx01-hero', class extends HTMLElement {
    connectedCallback() {
      if (this.controller) return;
      this.controller = new AbortController();
      const options = { signal: this.controller.signal };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => this.initialize(), { ...options, once: true });
      else this.initialize();
    }
    initialize() {
      if (!this.isConnected || !this.controller || this.initialized) return;
      this.initialized = true;
      const options = { signal: this.controller.signal };
      this.form = this.querySelector('.npx-hero__form');
      this.variant = this.querySelector('[data-variant]');
      this.quantity = this.querySelector('[data-quantity]');
      this.add = this.querySelector('[data-add]');
      this.cartAdd = this.querySelector('[data-cart-add]');
      if (!this.form || !this.variant || !this.quantity) return;
      try { this.money = new Intl.NumberFormat(this.dataset.locale || 'en', { style: 'currency', currency: this.dataset.currency || 'AED' }); }
      catch (_) { this.money = new Intl.NumberFormat('en', { style: 'currency', currency: 'AED' }); }
      this.querySelectorAll('[data-quantity-change]').forEach((button) => { button.hidden = false; });
      this.addEventListener('click', (event) => this.onClick(event), options);
      this.variant.addEventListener('change', () => this.update(true), options);
      this.quantity.addEventListener('input', () => this.update(false), options);
      this.quantity.addEventListener('change', () => this.update(false), options);
      this.form.addEventListener('submit', (event) => {
        if (!this.cartAdd || typeof customElements.get('xo-cart-add') === 'undefined') {
          if (this.pending || !this.form.checkValidity() || this.selection().available !== 'true') {
            event.preventDefault();
            return;
          }
          this.pending = true;
          if (this.add) {
            this.add.disabled = true;
            this.add.setAttribute('aria-busy', 'true');
          }
          const addText = this.querySelector('[data-add-text]');
          const status = this.querySelector('[data-status]');
          if (addText) addText.textContent = this.dataset.addingLabel;
          if (status) status.textContent = this.dataset.addingLabel;
          return;
        }
        event.preventDefault();
        if (!this.form.checkValidity() || this.selection().available !== 'true') return;
        this.add?.click();
      }, options);
      window.addEventListener('pageshow', () => this.reset(), options);
      this.reset();
    }
    disconnectedCallback() {
      this.controller?.abort();
      this.controller = null;
      this.initialized = false;
    }
    selection() {
      return this.variant.tagName === 'SELECT' ? this.variant.selectedOptions[0].dataset : this.variant.dataset;
    }
    reset() {
      this.pending = false;
      this.add?.removeAttribute('aria-busy');
      const status = this.querySelector('[data-status]');
      if (status) status.textContent = '';
      this.update(false);
    }
    syncCartAdd(selected) {
      if (!this.cartAdd) return;
      this.cartAdd.setAttribute('xo-variant-id', this.variant.value);
      if (selected.available === 'true') this.cartAdd.removeAttribute('xo-disabled');
      else this.cartAdd.setAttribute('xo-disabled', '');
    }
    update(variantChanged) {
      if (this.pending) return;
      const selected = this.selection();
      if (variantChanged) {
        this.quantity.min = selected.min || '1';
        this.quantity.step = selected.step || '1';
        if (selected.max) this.quantity.max = selected.max;
        else this.quantity.removeAttribute('max');
        this.quantity.value = selected.min || '1';
      }
      const valid = this.quantity.checkValidity();
      const amount = Number(this.quantity.value);
      if (valid) {
        const priceLabel = this.querySelector('[data-price-label]');
        const perBottle = this.querySelector('[data-per-bottle]');
        const total = this.querySelector('[data-total]');
        const daily = this.querySelector('[data-daily]');
        const supply = this.querySelector('[data-supply]');
        if (priceLabel) priceLabel.textContent = this.dataset.totalLabel;
        if (perBottle) perBottle.hidden = true;
        if (total) total.textContent = this.money.format(Number(selected.price) * amount / 100);
        if (daily) daily.textContent = this.money.format(Number(selected.price) / 100 / Number(this.dataset.servings));
        if (supply) supply.textContent = String(amount * Number(this.dataset.servings));
      }
      if (this.add) {
        this.add.disabled = selected.available !== 'true';
        const addText = this.querySelector('[data-add-text]');
        if (addText) addText.textContent = this.add.disabled ? this.dataset.soldLabel : this.dataset.addLabel;
      }
      this.syncCartAdd(selected);
      const minus = this.querySelector('[data-quantity-change="-1"]');
      const plus = this.querySelector('[data-quantity-change="1"]');
      if (minus) minus.disabled = valid && amount <= Number(this.quantity.min || 1);
      if (plus) plus.disabled = valid && !!this.quantity.max && amount >= Number(this.quantity.max);
    }
    onClick(event) {
      const quantityButton = event.target.closest('[data-quantity-change]');
      if (quantityButton && !this.pending) {
        if (Number(quantityButton.dataset.quantityChange) > 0) this.quantity.stepUp();
        else this.quantity.stepDown();
        this.quantity.dispatchEvent(new Event('input', { bubbles: true }));
      }
      const thumbnail = event.target.closest('[data-thumb]');
      if (!thumbnail || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button > 0) return;
      const main = this.querySelector('.npx-hero__photo');
      if (!main) return;
      event.preventDefault();
      main.removeAttribute('srcset');
      main.removeAttribute('sizes');
      main.src = thumbnail.dataset.src;
      main.alt = thumbnail.dataset.alt;
      const mainLink = this.querySelector('[data-main-link]');
      if (mainLink) mainLink.href = thumbnail.href;
      this.querySelectorAll('[data-thumb]').forEach((link) => link.removeAttribute('aria-current'));
      thumbnail.setAttribute('aria-current', 'true');
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "NX-01 product opening",
  "tag": "section",
  "class": "npx-nx01-hero-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "paragraph",
      "content": "Use on a dedicated NX-01 Baseline product template. Reads current product price, availability and images automatically."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Main benefit",
      "default": "Your daily stack, simplified."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Short introduction",
      "default": "<p>A caffeine-free daily formula with nine ingredients, including ALCAR, citicoline and NMN.</p>"
    },
    {
      "type": "range",
      "id": "capsules",
      "label": "Capsules per bottle",
      "min": 30,
      "max": 180,
      "step": 30,
      "default": 90
    },
    {
      "type": "range",
      "id": "servings",
      "label": "Daily servings per bottle",
      "min": 1,
      "max": 90,
      "step": 1,
      "default": 30,
      "info": "Used to calculate price per day and supply. Match the current approved label."
    },
    {
      "type": "range",
      "id": "daily_capsules",
      "label": "Capsules per daily serving",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "image_picker",
      "id": "label_image",
      "label": "Ingredients / label image",
      "info": "Defaults to the second product image. Select an approved, legible label image."
    },
    {
      "type": "url",
      "id": "shipping_link",
      "label": "Delivery and returns page"
    },
    {
      "type": "checkbox",
      "id": "show_payment_terms",
      "label": "Show Shopify payment terms",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show enabled payment methods",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "Include product structured data",
      "default": false,
      "info": "Leave off. Product structured data is already output by the theme."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "Image background",
      "default": "#F3F6FC"
    },
    {
