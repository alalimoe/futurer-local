{{ 'npx-nx01-hero.css' | asset_url | stylesheet_tag }}
{{ 'sticky-cart.css' | asset_url | stylesheet_tag }}
{{ 'sticky-variant-modal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign nx_product = product
  assign nx_labels = section.blocks | where: 'type', 'labels' | first
  assign nx_apps = section.blocks | where: 'type', '@app'
  assign display_title = section.settings.display_title | default: nx_product.title
  assign nx_variant = nx_product.selected_or_first_available_variant
  assign form_id = 'npx-nx01-form-' | append: section.id
  assign heading_id = 'npx-nx01-heading-' | append: section.id
  assign image = nx_variant.featured_image | default: nx_product.featured_image
  assign label_image = section.settings.label_image | default: nx_product.images[1]
  assign daily_price = nx_variant.price | times: 1.0 | divided_by: section.settings.servings | round
  assign currency_code = cart.currency.iso_code | default: shop.currency
  assign text_total = 'sections.npx_nx01_hero.total' | t
  if nx_labels != blank
    assign text_total = nx_labels.settings.total
  endif
  assign text_add = 'sections.npx_nx01_hero.add' | t
  if nx_labels != blank
    assign text_add = nx_labels.settings.add
  endif
  assign text_adding = 'sections.npx_nx01_hero.adding' | t
  if nx_labels != blank
    assign text_adding = nx_labels.settings.adding
  endif
  assign text_sold_out = 'sections.npx_nx01_hero.sold_out' | t
  if nx_labels != blank
    assign text_sold_out = nx_labels.settings.sold_out
  endif
  assign text_home = 'sections.npx_nx01_hero.home' | t
  if nx_labels != blank
    assign text_home = nx_labels.settings.home
  endif
  assign text_shop = 'sections.npx_nx01_hero.shop' | t
  if nx_labels != blank
    assign text_shop = nx_labels.settings.shop
  endif
  assign text_eyebrow = 'sections.npx_nx01_hero.eyebrow' | t
  if nx_labels != blank
    assign text_eyebrow = nx_labels.settings.eyebrow
  endif
  assign text_gallery = 'sections.npx_nx01_hero.gallery' | t
  if nx_labels != blank
    assign text_gallery = nx_labels.settings.gallery
  endif
  assign text_caffeine_free = 'sections.npx_nx01_hero.caffeine_free' | t
  if nx_labels != blank
    assign text_caffeine_free = nx_labels.settings.caffeine_free
  endif
  assign text_enlarge = 'sections.npx_nx01_hero.enlarge' | t
  if nx_labels != blank
    assign text_enlarge = nx_labels.settings.enlarge
  endif
  assign text_image_empty = 'sections.npx_nx01_hero.image_empty' | t
  if nx_labels != blank
    assign text_image_empty = nx_labels.settings.image_empty
  endif
  assign text_image = 'sections.npx_nx01_hero.image' | t
  if nx_labels != blank
    assign text_image = nx_labels.settings.image
  endif
  assign text_label = 'sections.npx_nx01_hero.label' | t
  if nx_labels != blank
    assign text_label = nx_labels.settings.label
  endif
  assign text_capsules = 'sections.npx_nx01_hero.capsules' | t
  if nx_labels != blank
    assign text_capsules = nx_labels.settings.capsules
  endif
  assign text_servings = 'sections.npx_nx01_hero.servings' | t
  if nx_labels != blank
    assign text_servings = nx_labels.settings.servings
  endif
  assign text_daily = 'sections.npx_nx01_hero.daily' | t
  if nx_labels != blank
    assign text_daily = nx_labels.settings.daily
  endif
  assign text_option = 'sections.npx_nx01_hero.option' | t
  if nx_labels != blank
    assign text_option = nx_labels.settings.option
  endif
  assign text_selection_note = 'sections.npx_nx01_hero.selection_note' | t
