{{ 'section-countdown-banner.css' | asset_url | stylesheet_tag }}

{% liquid
  assign image = section.settings.background_image
  assign image_mobile = section.settings.background_image_mobile | default: image
  assign overlay_opacity = section.settings.overlay_opacity | default: 20
  assign overlay = overlay_opacity | divided_by: 100.0
  assign countdown_label = section.settings.countdown_label
  assign end_time = section.settings.end_time

  # Resolve the section aspect ratio from its setting. 'auto' follows the
  # uploaded image's natural ratio (falling back when no image is set).
  assign ar_dt = section.settings.aspect_ratio_desktop
  if ar_dt == 'custom'
    assign ar_dt = section.settings.aspect_ratio_desktop_width | append: '/' | append: section.settings.aspect_ratio_desktop_height
  elsif ar_dt == 'auto'
    if image != blank and image.aspect_ratio != blank
      assign ar_dt = image.aspect_ratio
    else
      assign ar_dt = '16/9'
    endif
  endif

  assign ar_mb = section.settings.aspect_ratio_mobile
  if ar_mb == 'custom'
    assign ar_mb = section.settings.aspect_ratio_mobile_width | append: '/' | append: section.settings.aspect_ratio_mobile_height
  elsif ar_mb == 'auto'
    if image_mobile != blank and image_mobile.aspect_ratio != blank
      assign ar_mb = image_mobile.aspect_ratio
    else
      assign ar_mb = '375/667'
    endif
  endif

  if end_time != blank
    assign timestamp = end_time | date: '%s' | append: '000'
  else
    assign add_day = 3 | times: 86400
    assign timestamp = 'now' | date: '%s' | plus: add_day | append: '000'
  endif
%}

{%- capture banner_style -%}
  --overlay: {{ overlay }};
  --ar-dt: {{ ar_dt }};
  --ar-mb: {{ ar_mb }};
  {%- if image != blank %} --img-dt: url('{{ image | image_url: width: 2400 }}');{% endif -%}
  {%- if image_mobile != blank %} --img-mb: url('{{ image_mobile | image_url: width: 1200 }}');{% endif -%}
{%- endcapture -%}

<section {% render 'section-attr' %}>
  <div class="countdown-banner" style="{{ banner_style }}">
    <div class="countdown-banner__bg xo-background-lazyload" aria-hidden="true"></div>
    <div class="countdown-banner__overlay" aria-hidden="true"></div>

    <xo-container class="countdown-banner__container">
      <div class="countdown-banner__inner">
        <div class="countdown-banner__top">
          <xo-animate xo-cascade class="countdown-banner__heading">
            {% render 'text', context: section %}
          </xo-animate>
          {% if section.settings.button_text != blank %}
            <xo-animate xo-cascade class="countdown-banner__actions">
              {% render 'button',
                text: section.settings.button_text,
                link: section.settings.button_link,
                style: section.settings.button_style,
                size: section.settings.button_size
              %}
            </xo-animate>
          {% endif %}
        </div>

        <div class="countdown-banner__bottom">
          {% if countdown_label != blank %}
            <xo-animate xo-cascade>
              <p class="countdown-banner__label">{{ countdown_label }}</p>
            </xo-animate>
          {% endif %}

          <xo-animate xo-cascade>
            <xo-countdown xo-timestamp="{{ timestamp }}" class="countdown-banner__timer">
              <div class="countdown-banner__unit">
                <xo-countdown-day class="countdown-banner__num"></xo-countdown-day>
                <span class="countdown-banner__unit-label">{{ 'general.popup.day' | t }}</span>
              </div>
              <span class="countdown-banner__divider" aria-hidden="true"></span>
              <div class="countdown-banner__unit">
                <xo-countdown-hour class="countdown-banner__num"></xo-countdown-hour>
                <span class="countdown-banner__unit-label">{{ 'general.popup.hour' | t }}</span>
              </div>
              <span class="countdown-banner__divider" aria-hidden="true"></span>
              <div class="countdown-banner__unit">
                <xo-countdown-minute class="countdown-banner__num"></xo-countdown-minute>
                <span class="countdown-banner__unit-label">{{ 'general.popup.minus' | t }}</span>
              </div>
              <span class="countdown-banner__divider" aria-hidden="true"></span>
              <div class="countdown-banner__unit">
                <xo-countdown-second class="countdown-banner__num"></xo-countdown-second>
                <span class="countdown-banner__unit-label">{{ 'general.popup.second' | t }}</span>
              </div>
            </xo-countdown>
          </xo-animate>
        </div>
      </div>
    </xo-container>
  </div>
</section>

