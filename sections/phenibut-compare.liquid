{% comment %}
  Compare — XO theme design system
  - Native <table>, ItemList JSON-LD, reduced-motion
{% endcomment %}

{%- comment -%} ── JSON-LD: ItemList (alternatives) ── {%- endcomment -%}
{% if section.blocks.size > 0 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ section.settings.heading | json }},
  "numberOfItems": {{ section.blocks.size }},
  "itemListElement": [
    {%- for block in section.blocks -%}
      {%- if block.type == 'alt_row' -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "name": {{ block.settings.name | json }},
          "description": {{ block.settings.mechanism | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{% endif %}

{%- style -%}
.xo-section--{{ section.id }} xo-animate { display: block; }
.xo-section--{{ section.id }} { scroll-margin-top: 96px; }
@media (max-width: 768px) { .xo-section--{{ section.id }} { scroll-margin-top: 80px; } }
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .xo-section--{{ section.id }} .phb-kicker {
    display: block;
    margin: 0 0 1rem;
    color: rgba(var(--color-accent));
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .xo-section--{{ section.id }} .phb-compare__shell {
    max-width: 110rem;
    margin-inline: auto;
    width: 100%;
  }

  .xo-section--{{ section.id }} .phb-compare__title {
    font-size: clamp(2.8rem, 4vw, 4.8rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: rgba(var(--color-foreground));
    margin: 0;
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .phb-compare__intro {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 80%, transparent);
    line-height: 1.6;
    max-width: 72rem;
  }

  .xo-section--{{ section.id }} .phb-compare__table-wrap {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
    border-radius: var(--general-radius-2, 1.5rem);
    overflow: hidden;
    max-width: 110rem;
    margin-top: 1.6rem;
    background: rgba(var(--color-background));
  }

  .xo-section--{{ section.id }} .phb-compare__table {
    width: 100%;
    min-width: 64rem;
    border-collapse: collapse;
  }

  .xo-section--{{ section.id }} .phb-compare__table thead {
    background: rgba(var(--color-background-2));
  }

  .xo-section--{{ section.id }} .phb-compare__table th {
    text-align: left;
    padding: 1.4rem 1.6rem;
    font-weight: 600;
    color: rgba(var(--color-foreground));
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
  }

  .xo-section--{{ section.id }} .phb-compare__table td {
    padding: 1.4rem 1.6rem;
    color: rgba(var(--color-foreground));
    font-size: 1.5rem;
    line-height: 1.6;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    vertical-align: top;
  }

  .xo-section--{{ section.id }} .phb-compare__table td p {
    margin: 0;
  }

  .xo-section--{{ section.id }} .phb-compare__row--highlight {
    background: color-mix(in srgb, rgba(var(--color-accent)) 8%, transparent);
    box-shadow: inset 3px 0 0 rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .phb-compare__cta {
    margin-top: 2rem;
  }

  .xo-section--{{ section.id }} :focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .xo-section--{{ section.id }} .phb-compare__table-wrap {
      border: none;
      background: transparent;
      overflow: visible;
    }

    .xo-section--{{ section.id }} .phb-compare__table {
      min-width: 0;
      display: block;
    }

    .xo-section--{{ section.id }} .phb-compare__table thead {
      display: none;
    }

    .xo-section--{{ section.id }} .phb-compare__table tbody {
      display: grid;
      gap: 1.2rem;
    }

    .xo-section--{{ section.id }} .phb-compare__table tr {
      display: grid;
      gap: 0.8rem;
      padding: 1.6rem;
      background: rgba(var(--color-background));
      border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
      border-radius: var(--general-radius-2, 1.5rem);
      box-shadow: none;
    }

    .xo-section--{{ section.id }} .phb-compare__row--highlight {
      border-color: color-mix(in srgb, rgba(var(--color-accent)) 45%, transparent);
      box-shadow: inset 3px 0 0 rgba(var(--color-accent));
    }

    .xo-section--{{ section.id }} .phb-compare__table td {
      display: grid;
      grid-template-columns: minmax(9rem, 34%) 1fr;
      gap: 0.8rem;
      align-items: start;
      padding: 0;
      border-top: none;
      font-size: 1.4rem;
    }

    .xo-section--{{ section.id }} .phb-compare__table td::before {
      content: attr(data-label);
      font-weight: 600;
      font-size: 1.2rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ section.id }} *,
    .xo-section--{{ section.id }} *::before,
    .xo-section--{{ section.id }} *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
{%- endstyle -%}

<section {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}" {% endif %}{% render 'section-attr' %} aria-labelledby="phb-compare-title-{{ section.id }}">
  <xo-container>
    <xo-animate xo-type="fade-up" class="phb-compare__shell">
    {% if section.settings.kicker != blank %}
      <span class="phb-kicker">{{ section.settings.kicker | escape }}</span>
    {% endif %}
    <h2 id="phb-compare-title-{{ section.id }}" class="phb-compare__title">{{ section.settings.heading | escape }}</h2>
    {% if section.settings.intro != blank %}
      <div class="phb-compare__intro">{{ section.settings.intro }}</div>
    {% endif %}

    <div class="phb-compare__table-wrap">
      <table class="phb-compare__table" aria-label="Phenibut vs alternatives">
        <thead>
          <tr>
            <th scope="col">Option</th>
            <th scope="col">Mechanism</th>
            <th scope="col">Best For</th>
            <th scope="col">Onset</th>
            <th scope="col">Notes</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'alt_row' %}
              <tr {% if block.settings.highlight %}class="phb-compare__row--highlight"{% endif %} {{ block.shopify_attributes }}>
                <td data-label="Option"><strong>{{ block.settings.name | escape }}</strong></td>
                <td data-label="Mechanism">{{ block.settings.mechanism | escape }}</td>
                <td data-label="Best For">{{ block.settings.best_for | escape }}</td>
                <td data-label="Onset">{{ block.settings.onset | escape }}</td>
                <td data-label="Notes">{{ block.settings.notes }}</td>
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if section.settings.cta_label != blank and section.settings.cta_href != blank %}
      <div class="phb-compare__cta">
        {% render 'button', style: 'primary', text: section.settings.cta_label, link: section.settings.cta_href, icon: 'arrow-right', icon_size: '1.4rem' %}
      </div>
    {% endif %}
    </xo-animate>
  </xo-container>
</section>

{% schema %}
{
  "name": "Compare",
  "tag": "section",
  "class": "section-phenibut-compare",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "alternatives" },
    { "type": "text", "id": "kicker", "label": "Kicker (eyebrow label)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Phenibut vs Alternatives" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>How Phenibut compares to gentler options you might try first.</p>" },
    { "type": "text", "id": "cta_label", "label": "CTA label (below table)", "default": "Shop Phenibut" },
    { "type": "text", "id": "cta_href", "label": "CTA link (URL or #anchor)", "default": "#shop-phenibut" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "blocks": [
    { "type": "alt_row", "name": "Alternative row", "settings": [
      { "type": "checkbox", "id": "highlight", "label": "Highlight row (gold accent)", "default": false },
      { "type": "text", "id": "name", "label": "Name", "default": "L‑Theanine" },
      { "type": "text", "id": "mechanism", "label": "Mechanism", "default": "Glutamate modulation; alpha waves" },
      { "type": "text", "id": "best_for", "label": "Best for", "default": "Smooth focus; daytime calm" },
      { "type": "text", "id": "onset", "label": "Onset", "default": "30–60 min" },
      { "type": "richtext", "id": "notes", "label": "Notes", "default": "<p>Well‑tolerated; pairs with caffeine.</p>" }
    ] },
    { "type": "@app" }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Compare",
      "blocks": [
        { "type": "alt_row", "settings": { "name": "GABA", "mechanism": "Peripheral GABA; limited BBB crossing", "best_for": "Very mild relaxation", "onset": "30–60 min", "notes": "<p>Gentle; effects can be subtle.</p>" } },
        { "type": "alt_row", "settings": { "name": "L‑Theanine", "mechanism": "Glutamate modulation; alpha waves", "best_for": "Calm focus", "onset": "30–60 min", "notes": "<p>Pairs with caffeine for balance.</p>" } },
        { "type": "alt_row", "settings": { "name": "Ashwagandha", "mechanism": "Adaptogen; cortisol modulation", "best_for": "Stress resilience", "onset": "Days–weeks", "notes": "<p>Daily adaptogen; cumulative effect.</p>" } }
      ]
    }
  ]
}
{% endschema %}
