{{ 'section-banner-main-collection.css' | asset_url | stylesheet_tag }}

{% liquid
  assign show_count_number = section.settings.show_count_number
  assign class = section.settings.font_size_heading
  assign heading = section.settings.heading
  assign alignment = section.settings.alignment
  assign img_desktop = section.settings.background_image_desktop
  assign img_mobile = section.settings.background_image_mobile
  assign banner_height = section.settings.banner_height
  assign image_overlay_opacity = section.settings.image_overlay_opacity
  assign image_overlay_color = section.settings.image_overlay_color
  assign excluded_handles = section.settings.excluded_handles | default: 'all,frontpage,restricted,restock-watch,restock-blitz,coa-library' | remove: ' ' | replace: ',', '|' | prepend: '|' | append: '|'
  assign visible_collection_count = 0
  for listed_collection in collections
    assign listed_handle_token = '|' | append: listed_collection.handle | append: '|'
    if listed_collection.published_at != blank and listed_collection.all_products_count > 0
      unless excluded_handles contains listed_handle_token
        assign visible_collection_count = visible_collection_count | plus: 1
      endunless
    endif
  endfor
%}

<section {% render 'section-attr' %}>
  <div
    class="banner-main-collection{% if banner_height %} banner-main-collection--{{ banner_height }}{% endif %}"
    style="--overlay-opacity: {{ image_overlay_opacity }}; --overlay-color: {{ image_overlay_color }}"
  >
    {% if img_desktop != blank or img_mobile != blank %}
      <div class="banner-main-collection__pr">
        <div class="banner-main-collection__pr-2">
          {% assign banner_image = img_desktop | default: img_mobile %}
          <picture class="banner-main-collection__picture">
            {% if img_mobile != blank %}
              <source
                media="(max-width: 767px)"
                srcset="
                  {{ img_mobile | image_url: width: 480 }} 480w,
                  {{ img_mobile | image_url: width: 750 }} 750w,
                  {{ img_mobile | image_url: width: 960 }} 960w
                "
                sizes="100vw"
              >
            {% endif %}
            {{
              banner_image
              | image_url: width: 2400
              | image_tag:
                class: 'banner-main-collection__image',
                widths: '750, 1100, 1500, 2000, 2400',
                sizes: '100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: banner_image.alt | default: heading
            }}
          </picture>
        </div>
      </div>
    {%- else -%}
      <div class="banner-main-collection__pr">
        <div class="banner-main-collection__pr-2">
          <div class="banner-main-collection__bg">
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        </div>
      </div>
    {% endif %}

    <xo-container class="banner-main-collection__container">
      <div class="banner-main-collection__content{% if alignment %} banner-main-collection__content--{{ alignment }}{% endif %}">
        <div class="banner-main-collection__head">
          <h1 class="banner-main-collection__heading {{ class }}">{{ heading | escape }}</h1>
          {% if show_count_number %}
            <p class="banner-main-collection__count">
              {{ visible_collection_count }}
              {{ visible_collection_count | pluralize: 'collection', 'collections' }}
            </p>
          {% endif %}
        </div>
      </div>
    </xo-container>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.banner_main_collection.name",
  "class": "section-hero",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay",
      "custom.popups",
      "custom.features"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.banner_main_collection.settings.header_text.content"
    },
    {
      "type": "select",
      "id": "font_size_heading",
      "label": "Font size heading",
      "default": "h1",
      "options": [
        {
          "value": "h1",
          "label": "Extra extra large"
        },
        {
          "value": "h2",
          "label": "Extra large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "Extra small"
        }
      ]
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:sections.banner_main_collection.settings.heading.label",
      "default": "Banner main collection"
    },
    {
      "type": "checkbox",
      "id": "show_count_number",
      "label": "t:sections.banner_main_collection.settings.show_count_number.label",
      "default": true
    },
    {
      "type": "text",
      "id": "excluded_handles",
      "label": "Internal collection handles",
      "info": "Comma-separated handles hidden from the catalogue count.",
      "default": "all,frontpage,restricted,restock-watch,restock-blitz,coa-library"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.banner_main_collection.settings.header_image.content"
    },
    {
      "type": "image_picker",
      "id": "background_image_desktop",
      "label": "t:sections.banner_main_collection.settings.image_dt.label"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "t:sections.banner_main_collection.settings.image_mb.label"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Aspect ratio",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "label": "t:sections.banner_main_collection.settings.image_overlay_opacity.label",
      "default": 0
    },
    {
      "type": "color",
      "id": "image_overlay_color",
      "label": "t:sections.banner_main_collection.settings.image_overlay_color.label",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "General settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "number",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "default": 50
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:sections.banner_main_collection.presets.name",
      "category": "Banners",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}