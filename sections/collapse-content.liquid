{{ 'section-collapse-content.css' | asset_url | stylesheet_tag }}
{{ 'collapse-content-box-1.css' | asset_url | stylesheet_tag }}
{% unless section.settings.accordion_style == 'native' %}
  {{ 'collapse.css' | asset_url | stylesheet_tag }}
{% endunless %}

{%- if section.settings.accordion_style == 'native' -%}
  {%- style -%}
    .xo-section--{{ section.id }} .cc-faq__list {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .xo-section--{{ section.id }} .cc-faq__card {
      border-radius: var(--general-radius-3);
      background: rgba(var(--color-background));
      border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
      overflow: hidden;
      transition: border-color 0.3s var(--out-soft, ease);
    }

    .xo-section--{{ section.id }} .cc-faq__card:hover,
    .xo-section--{{ section.id }} .cc-faq__card[open] {
      border-color: color-mix(in srgb, rgba(var(--color-accent)) 40%, transparent);
    }

    .xo-section--{{ section.id }} .cc-faq__card[open] {
      background: color-mix(in srgb, rgba(var(--color-accent)) 4%, rgba(var(--color-background)));
    }

    .xo-section--{{ section.id }} .cc-faq__summary {
      list-style: none;
      display: flex;
      align-items: center;
      gap: 1.2rem;
      padding: 2rem;
      cursor: pointer;
      min-height: 44px;
      transition: background 0.3s var(--out-soft, ease);
    }

    .xo-section--{{ section.id }} .cc-faq__summary::-webkit-details-marker {
      display: none;
    }

    .xo-section--{{ section.id }} .cc-faq__summary::after {
      content: '+';
      margin-left: auto;
      font-size: 2rem;
      line-height: 1;
      flex-shrink: 0;
      color: color-mix(in srgb, rgba(var(--color-foreground)) 40%, transparent);
      transition: transform 0.3s var(--out-soft, ease), color 0.3s var(--out-soft, ease);
    }

    .xo-section--{{ section.id }} .cc-faq__card[open] .cc-faq__summary::after {
      transform: rotate(45deg);
      color: rgba(var(--color-accent));
    }

    .xo-section--{{ section.id }} .cc-faq__summary:focus-visible {
      outline: 2px solid rgba(var(--color-accent));
      outline-offset: -2px;
    }

    .xo-section--{{ section.id }} .cc-faq__question {
      font-size: calc(var(--font-body-scale, 1) * 1.8rem);
      line-height: 1.3;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: rgba(var(--color-foreground));
      margin: 0;
    }

    .xo-section--{{ section.id }} .cc-faq__answer {
      padding: 0 2rem 2rem;
    }

    .xo-section--{{ section.id }} .cc-faq__answer p {
      margin: 0 0 0.75rem;
    }

    .xo-section--{{ section.id }} .cc-faq__answer p:last-child {
      margin-bottom: 0;
    }

    .xo-section--{{ section.id }} .cc-faq__view-all {
      margin-top: 2.4rem;
      text-align: center;
    }

    .xo-section--{{ section.id }} .cc-faq__disclaimer {
      margin-top: 2.4rem;
      padding: 1.6rem 2rem;
      border-radius: var(--general-radius-4);
      background: rgba(var(--color-background-2));
      color: color-mix(in srgb, rgba(var(--color-foreground)) 70%, transparent);
      line-height: 1.55;
      font-size: calc(var(--font-body-scale, 1) * 1.4rem);
    }

    @media (prefers-reduced-motion: reduce) {
      .xo-section--{{ section.id }} .cc-faq__card,
      .xo-section--{{ section.id }} .cc-faq__summary,
      .xo-section--{{ section.id }} .cc-faq__summary::after {
        transition: none;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% liquid
  assign class = section.settings.font_size_heading
  assign heading = section.settings.heading
  assign block = section.blocks
%}

<section {% render 'section-attr' %}>
  <div class='collapse-content'>
    <xo-container class='collapse-content__container'>
      {% render 'collapse-content-box-1',
        class: class,
        heading: heading,
        subheading: section.settings.subheading,
        block: block,
        accordion_style: section.settings.accordion_style,
        section_id: section.id,
        show_view_all_link: section.settings.show_view_all_link,
        view_all_label: section.settings.view_all_label,
        view_all_url: section.settings.view_all_url,
        show_disclaimer: section.settings.show_disclaimer,
        disclaimer_text: section.settings.disclaimer_text
      %}
    </xo-container>
  </div>
</section>

{% if section.settings.enable_faq_schema and section.blocks.size > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for block in section.blocks %}
          {
            "@type": "Question",
            "name": {{ block.settings.title | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.content | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

{% schema %}
{
