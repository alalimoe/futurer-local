{% comment %}
  Products — XO theme design system
  - Theme product-card snippet (quick add, badges, hover swap), ItemList JSON-LD
{% endcomment %}

{%- comment -%} ── JSON-LD: ItemList (products) ── {%- endcomment -%}
{% assign product_blocks = section.blocks | where: "type", "product_card" %}
{% if product_blocks.size > 0 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ section.settings.heading | json }},
  "numberOfItems": {{ product_blocks.size }},
  "itemListElement": [
    {%- for block in product_blocks -%}
      {%- assign prod = all_products[block.settings.product] -%}
      {%- if prod -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": "{{ shop.url }}{{ prod.url }}",
          "name": {{ prod.title | json }}{% if prod.featured_image %},
          "image": "{{ prod.featured_image | image_url: width: 600 }}"{% endif %}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{% endif %}

{%- style -%}
.xo-section--{{ section.id }} xo-animate { display: block; }
.xo-section--{{ section.id }} { scroll-margin-top: 96px; }
@media (max-width: 768px) { .xo-section--{{ section.id }} { scroll-margin-top: 80px; } }
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .xo-section--{{ section.id }} .phb-kicker {
    display: block;
    margin: 0 0 1rem;
    color: rgba(var(--color-accent));
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .xo-section--{{ section.id }} .phb-products__title {
    font-size: clamp(2.8rem, 4vw, 4.8rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: rgba(var(--color-foreground));
    margin: 0 0 0.8rem;
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .phb-products__intro {
    color: rgba(var(--color-foreground));
    max-width: 76rem;
    margin-bottom: 2.4rem;
  }

  .xo-section--{{ section.id }} xo-grid {
    --xo-grid-col-gap: var(--grid-desktop-horizontal-spacing, 24px);
    --xo-grid-row-gap: var(--grid-desktop-vertical-spacing, 24px);
  }

  .xo-section--{{ section.id }} .phb-products__grid--single {
    max-width: 42rem;
    margin-inline: auto;
  }

  @media (max-width: 768px) {
    .xo-section--{{ section.id }} xo-grid {
      --xo-grid-col-gap: var(--grid-mobile-horizontal-spacing, 12px);
      --xo-grid-row-gap: var(--grid-mobile-vertical-spacing, 12px);
    }
  }
{%- endstyle -%}

{%- assign product_card_blocks = section.blocks | where: 'type', 'product_card' -%}
{%- assign visible_product_count = 0 -%}
{%- for block in product_card_blocks -%}
  {%- if block.settings.product != blank -%}
    {%- assign visible_product_count = visible_product_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- assign products_lg = section.settings.columns_desktop -%}
{%- assign products_md = section.settings.columns_tablet -%}
{%- if visible_product_count == 1 -%}
  {%- assign products_lg = 1 -%}
  {%- assign products_md = 1 -%}
{%- endif -%}

<section {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}" {% endif %}{% render 'section-attr' %} aria-labelledby="phb-products-title-{{ section.id }}">
  <xo-container>
    <xo-animate xo-type="fade-up" xo-cascade>
      {% if section.settings.kicker != blank %}
        <span class="phb-kicker">{{ section.settings.kicker | escape }}</span>
      {% endif %}
      <h2 id="phb-products-title-{{ section.id }}" class="phb-products__title">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.intro != blank %}
        <div class="phb-products__intro">{{ section.settings.intro }}</div>
      {% endif %}
    </xo-animate>

    <xo-grid class="{% if visible_product_count == 1 %}phb-products__grid--single{% endif %}" style="--lg: {{ products_lg }}; --md: {{ products_md }}; --xs: 1;">
      {% for block in section.blocks %}
        {% if block.type == 'product_card' and block.settings.product != blank %}
          {% assign prod = all_products[block.settings.product] %}
          {% if prod %}
            <div {{ block.shopify_attributes }}>
              {% render 'product-card',
                product: prod,
                show_image: true,
                show_secondary_image: true,
                show_quick_add: true,
                show_price: true,
                show_badge: true,
                media_aspect_ratio: '1/1',
                animate_enabled: true
              %}
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </xo-grid>
  </xo-container>
</section>

{% schema %}
{
  "name": "Products",
  "tag": "section",
  "class": "section-phenibut-products",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "shop-phenibut" },
    { "type": "text", "id": "kicker", "label": "Kicker (eyebrow label)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Phenibut Products" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Capsules, powders, and bundles—clearly dosed and shipped fast from Dubai.</p>" },
    { "type": "range", "id": "columns_desktop", "label": "Columns desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_tablet", "label": "Columns tablet", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "blocks": [
    { "type": "product_card", "name": "Product", "settings": [
      { "type": "product", "id": "product", "label": "Product" }
    ] },
    { "type": "@app" }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Products" } ]
}
{% endschema %}
