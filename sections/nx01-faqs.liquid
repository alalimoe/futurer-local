{{ 'nx01-faqs.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_id = 'npx-faq-heading-' | append: section.id
  assign list_id = 'npx-faq-list-' | append: section.id
  assign initial_count = section.settings.initial_count | default: 8
  assign single_open = section.settings.single_open
  assign contact_email = section.settings.contact_email | strip
  assign item_count = 0
  for block in section.blocks
    if block.type == 'question'
      if block.settings.question != blank and block.settings.answer != blank
        assign item_count = item_count | plus: 1
      endif
    endif
  endfor
-%}

<npx-nx01-faq
  class="npx-faq"
  id="nx01-faqs-{{ section.id }}"
  data-initial-count="{{ initial_count }}"
  data-single-open="{% if single_open %}true{% else %}false{% endif %}"
  style="--npx-faq-bg: {{ section.settings.background_color }}; --npx-faq-title: {{ section.settings.heading_color }}; --npx-faq-text: {{ section.settings.text_color }}; --npx-faq-accent: {{ section.settings.accent_color }}; --npx-faq-border: {{ section.settings.border_color }}; --npx-faq-width: 900px; --npx-faq-top: {{ section.settings.padding_top }}px; --npx-faq-bottom: {{ section.settings.padding_bottom }}px; --npx-faq-heading-size: 38px;"
  role="region"
  aria-labelledby="{{ heading_id }}"
>
  <div class="npx-faq__inner">
    <header class="npx-faq__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="npx-faq__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="npx-faq__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
      {%- else -%}
        <h2 class="npx-faq__heading xo-visually-hidden" id="{{ heading_id }}">
          {{ 'sections.nx01_faqs.region_label' | t }}
        </h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="npx-faq__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    {%- if item_count > 0 -%}
      <div class="npx-faq__list" id="{{ list_id }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' -%}
            {%- if block.settings.question != blank and block.settings.answer != blank -%}
              <details
                class="npx-faq__item"
                id="npx-faq-{{ section.id }}-{{ block.id }}"
                {{ block.shopify_attributes }}
                {% if block.settings.open_by_default %}
                  open
                {% endif %}
              >
                <summary class="npx-faq__summary">
                  <span class="npx-faq__question">{{ block.settings.question | escape }}</span>
                  <svg class="npx-faq__chevron" viewBox="0 0 24 24" width="24" height="24" fill="none" aria-hidden="true" focusable="false">
                    <path d="m5 9 7 7 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <div class="npx-faq__answer">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if item_count > initial_count -%}
      <div class="npx-faq__more-wrap">
        <button
          class="npx-faq__more"
          type="button"
          aria-expanded="false"
          aria-controls="{{ list_id }}"
          hidden
        >
          <span data-more-label>{{ 'sections.nx01_faqs.show_more' | t }}</span>
          <span data-less-label hidden>{{ 'sections.nx01_faqs.show_fewer' | t }}</span>
          <svg class="npx-faq__more-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
            <path d="M12 4v16m-6-6 6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {%- endif -%}

    {%- if section.settings.contact_label != blank or contact_email != blank -%}
      <p class="npx-faq__contact">
        {%- if section.settings.contact_label != blank -%}
          {{ section.settings.contact_label | escape }}
        {%- endif -%}
        {%- if contact_email != blank -%}
          <a dir="ltr" href="mailto:{{ contact_email | escape }}">{{ contact_email | escape }}</a>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</npx-nx01-faq>

{% javascript %}
  if (!customElements.get('npx-nx01-faq')) {
    customElements.define(
      'npx-nx01-faq',
      class extends HTMLElement {
        connectedCallback() {
          queueMicrotask(() => {
            if (!this.isConnected || this.controller) return;
            this.controller = new AbortController();
            const signal = this.controller.signal;
            this.items = Array.from(this.querySelectorAll('.npx-faq__item'));
            this.limit = Math.max(1, Number(this.dataset.initialCount) || 8);
            this.extra = this.items.slice(this.limit);
            this.button = this.querySelector('.npx-faq__more');
            this.expanded = false;
            if (this.button && this.extra.length) {
              this.setExpanded(false);
              this.button.hidden = false;
              this.button.addEventListener(
                'click',
                () => {
                  const opening = !this.expanded;
                  this.setExpanded(opening);
                  if (opening) {
                    const firstExtra = this.extra[0].querySelector('summary');
                    if (firstExtra) firstExtra.focus({ preventScroll: true });
                  }
                },
                { signal }
              );
            }
            this.addEventListener(
              'click',
              (event) => {
                const summary = event.target.closest('.npx-faq__summary');
                const active = summary && summary.parentElement;
                if (active && this.items.includes(active) && !active.open) this.closeOthers(active);
              },
              { signal }
            );
            this.addEventListener(
              'toggle',
              (event) => {
                const active = event.target;
                if (!this.items.includes(active) || !active.open) return;
                this.closeOthers(active);
              },
              { capture: true, signal }
            );
            this.addEventListener(
              'shopify:block:select',
              (event) => {
                const active = event.target.closest('.npx-faq__item');
                if (!active || !this.items.includes(active)) return;
                if (active.hidden) this.setExpanded(true);
                this.closeOthers(active);
                active.open = true;
              },
              { signal }
            );
          });
        }

        closeOthers(active) {
          if (this.dataset.singleOpen !== 'true') return;
          this.items.forEach((item) => {
            if (item !== active) item.open = false;
          });
        }

        setExpanded(expanded) {
          this.expanded = expanded;
          this.extra.forEach((item) => {
            if (!expanded) item.open = false;
            item.hidden = !expanded;
          });
          if (!this.button) return;
          this.button.setAttribute('aria-expanded', String(expanded));
          const moreLabel = this.button.querySelector('[data-more-label]');
          const lessLabel = this.button.querySelector('[data-less-label]');
          if (moreLabel) moreLabel.hidden = expanded;
          if (lessLabel) lessLabel.hidden = !expanded;
        }

        disconnectedCallback() {
          if (this.controller) this.controller.abort();
          this.controller = null;
          if (this.items) this.items.forEach((item) => { item.hidden = false; });
          if (this.button) this.button.hidden = true;
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "NX-01 FAQs",
  "tag": "div",
  "class": "section-nx01-faqs",
  "enabled_on": {
    "templates": ["product", "page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NX-01 BASELINE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions before you buy."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact line"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact email"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "range",
      "id": "initial_count",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Questions shown first",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "single_open",
      "label": "Keep only one question open",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F7F9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#142342"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4D5A70"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#243F95"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#D5D9E1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "NX-01 FAQs",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Can I take NX-01 with supplements I already use?",
            "answer": "<p>Compare labels for overlap before adding NX-01, especially if you already take ALCAR, citicoline, NMN, theanine, Rhodiola, CoQ10 or these B vitamins. Ask a pharmacist or clinician if you take medicines.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I change one ingredient’s amount?",
            "answer": "<p>The proportions are the stack: complementary amounts meant to be taken together. NX-01 has fixed ingredient proportions. Taking fewer capsules lowers every ingredient together; it does not let you change one ingredient on its own. Separate products offer more flexibility if you need to adjust individual amounts.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How is it shipped?",
            "answer": "<p>Same-Day Shipping Worldwide. Destination options and charges are on the <a href=\"/pages/shipping-and-returns\">Delivery &amp; returns</a> page.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is the returns policy?",
            "answer": "<p>Eligible unopened items can be returned within 30 days. See <a href=\"/pages/shipping-and-returns\">Shipping &amp; returns</a>.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
