{%- liquid
  assign show_cta = false
  if section.settings.cta_label != blank and section.settings.cta_href != blank
    assign show_cta = true
  endif
  assign nx01_anchor = section.settings.anchor_id | default: 'nx01-facts' | handleize
  assign nx01_intro_class = 'nx01__intro'
  if section.settings.heading_alignment == 'center'
    assign nx01_intro_class = 'nx01__intro nx01__intro--center'
  endif
-%}

{% render 'nx01-launch-css' %}

<section
  id="{{ nx01_anchor }}"
  class="nx01 nx01-facts xo-section xo-section--{{ section.id }}{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  style="{% if section.settings.padding_top != blank %}--nx01-pad-block-start: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom != blank %} --nx01-pad-block-end: {{ section.settings.padding_bottom }}px;{% endif %}"
  aria-labelledby="nx01-facts-heading-{{ section.id }}"
>
  <div class="nx01__inner">
    <div class="{{ nx01_intro_class }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nx01__label">
          <span class="nx01__label-rule" aria-hidden="true"></span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="nx01__heading" id="nx01-facts-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="nx01__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="nx01-facts__grid">
      <div class="nx01-facts__table-wrap">
        <table class="nx01-facts__table">
          <caption class="xo-visually-hidden">{{ section.settings.heading | escape }}</caption>
          <thead>
            <tr>
              <th scope="col">{{ 'sections.nx01_launch_facts.col_ingredient' | t }}</th>
              <th scope="col">{{ 'sections.nx01_launch_facts.col_amount' | t }}</th>
              <th scope="col">{{ 'sections.nx01_launch_facts.col_system' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'ingredient' -%}
                {%- if block.settings.name != blank or block.settings.amount != blank or block.settings.system != blank -%}
                  <tr {{ block.shopify_attributes }}>
                    <th scope="row">{{ block.settings.name | escape }}</th>
                    <td data-label="{{ 'sections.nx01_launch_facts.col_amount' | t }}">{{ block.settings.amount | escape }}</td>
                    <td data-label="{{ 'sections.nx01_launch_facts.col_system' | t }}">{{ block.settings.system | escape }}</td>
                  </tr>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
        {%- if show_cta -%}
          <a class="nx01__text-link" href="{{ section.settings.cta_href | escape }}">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.panel_heading != blank or section.settings.panel_meta != blank or section.settings.panel_note != blank -%}
        <aside class="nx01-facts__panel"{% if section.settings.panel_heading != blank %} aria-labelledby="nx01-facts-panel-heading-{{ section.id }}"{% endif %}>
          {%- if section.settings.panel_heading != blank -%}
            <h3 class="nx01-facts__panel-title" id="nx01-facts-panel-heading-{{ section.id }}">{{ section.settings.panel_heading | escape }}</h3>
          {%- endif -%}
          {%- if section.settings.panel_meta != blank -%}
            <p class="nx01-facts__panel-meta">{{ section.settings.panel_meta | escape }}</p>
          {%- endif -%}
          <div class="nx01-facts__panel-rule" aria-hidden="true"></div>
          <ul class="nx01-facts__panel-list" aria-hidden="true">
            {%- for block in section.blocks -%}
              {%- if block.type == 'ingredient' -%}
                {%- if block.settings.name != blank or block.settings.amount != blank -%}
                  <li>
                    <span>{{ block.settings.name | escape }}</span>
                    <strong>{{ block.settings.amount | escape }}</strong>
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if section.settings.panel_note != blank -%}
            <p class="nx01-facts__panel-note">{{ section.settings.panel_note | escape }}</p>
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .nx01-facts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4.8rem;
    align-items: start;
  }

  .nx01-facts__table {
    width: 100%;
    border-collapse: collapse;
  }

  .nx01-facts__table th,
  .nx01-facts__table td {
    padding: 2rem 0;
    text-align: start;
    border-bottom: 0.1rem solid #3a3737;
    vertical-align: top;
  }

  .nx01-facts__table thead th {
    padding-bottom: 1.6rem;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--nx01-body));
  }

  .nx01-facts__table tbody th {
    font-size: 1.4rem;
    font-weight: 500;
  }

  .nx01-facts__table td {
    font-size: 1.4rem;
  }

  .nx01-facts__table tbody td:last-child {
    font-size: 1.3rem;
    font-weight: 600;
    color: rgb(var(--nx01-navy-deep));
    text-align: end;
  }

  .nx01-facts__table thead th:nth-child(2),
  .nx01-facts__table thead th:nth-child(3),
  .nx01-facts__table td:nth-child(2) {
    text-align: end;
  }

  .nx01-facts__panel {
    padding: 3.2rem;
    border: 0.2rem solid rgb(var(--nx01-rule));
    background: rgb(var(--nx01-surface));
    border-radius: var(--nx01-radius);
  }

  .nx01-facts__panel-title {
    margin: 0 0 0.8rem;
    font-size: 2.2rem;
    font-weight: 600;
  }

  .nx01-facts__panel-meta,
  .nx01-facts__panel-note {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.5;
    color: rgb(var(--nx01-body));
  }

  .nx01-facts__panel-rule {
    height: 0.8rem;
    margin: 1.6rem 0 0;
    background: rgb(var(--nx01-rule));
  }

  .nx01-facts__panel-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nx01-facts__panel-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.6rem;
    padding: 1.2rem 0;
    border-bottom: 0.1rem solid rgb(var(--nx01-rule));
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .nx01-facts__panel-list strong {
    overflow-wrap: anywhere;
  }

  .nx01-facts__panel-note {
    margin-top: 2.4rem;
  }

  @media screen and (max-width: 767px) {
    .nx01-facts__table,
    .nx01-facts__table tbody,
    .nx01-facts__table tr,
    .nx01-facts__table th,
    .nx01-facts__table td {
      display: block;
      width: 100%;
    }

    .nx01-facts__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .nx01-facts__table tr {
      margin-bottom: 1.2rem;
      padding: 1.6rem;
      border: 0.1rem solid rgb(var(--nx01-line));
      background: rgb(var(--nx01-surface));
    }

    .nx01-facts__table th,
    .nx01-facts__table td {
      padding: 0;
      border: 0;
      text-align: start;
    }

    .nx01-facts__table tbody th {
      margin-bottom: 1.2rem;
      font-size: 1.5rem;
    }

    .nx01-facts__table td {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1.6rem;
      padding-top: 0.8rem;
      color: rgb(var(--nx01-body));
    }

    .nx01-facts__table td::before {
      content: attr(data-label);
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .nx01-facts__table tbody td:last-child {
      text-align: start;
    }

    .nx01-facts__panel {
      padding: 2.4rem;
    }

    .nx01-facts__panel-list,
    .nx01-facts__panel-rule {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    .nx01-facts__grid {
      grid-template-columns: minmax(0, 1fr) minmax(24rem, 40rem);
      gap: 4.8rem;
    }

    .nx01-facts__panel {
      position: sticky;
      top: var(--nx01-scroll-margin, 12.8rem);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "NX-01 launch facts",
  "tag": "section",
  "class": "section-nx01-facts",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "header", "content": "Reuse" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Optional in-page link target. Leave blank to keep nx01-facts." },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "range", "id": "padding_top", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding bottom", "default": 48 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "05 · Formula Composition" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The complete daily serving." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "9 highly bioavailable active ingredients consolidated into exactly 3 plant-based capsules. Zero trade secret blends or hidden binders." },
    { "type": "text", "id": "cta_label", "label": "Text link label", "default": "View Supplement Facts Panel →" },
    { "type": "text", "id": "cta_href", "label": "Text link" },
    { "type": "text", "id": "panel_heading", "label": "Panel heading", "default": "Supplement Facts" },
    { "type": "text", "id": "panel_meta", "label": "Panel meta", "default": "Serving Size: 3 Capsules | Servings Per Container: 30" },
    { "type": "textarea", "id": "panel_note", "label": "Panel note", "default": "* Daily Value (DV) not established. Other ingredients: Hypromellose (vegetable capsule), leucine." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Acetyl-L-Carnitine (ALCAR)" },
        { "type": "text", "id": "amount", "label": "Amount", "default": "500 mg" },
        { "type": "text", "id": "system", "label": "System", "default": "Cellular Energy" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "NX-01 launch facts",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Acetyl-L-Carnitine (ALCAR)", "amount": "500 mg", "system": "Cellular Energy" } },
        { "type": "ingredient", "settings": { "name": "CDP-Choline (Citicoline)", "amount": "250 mg", "system": "Cholinergic Support" } },
        { "type": "ingredient", "settings": { "name": "Nicotinamide Mononucleotide (NMN)", "amount": "250 mg", "system": "Cellular Energy" } },
        { "type": "ingredient", "settings": { "name": "L-Theanine", "amount": "200 mg", "system": "Calm Focus" } },
        { "type": "ingredient", "settings": { "name": "Rhodiola rosea extract (3% Salidroside)", "amount": "200 mg", "system": "Calm Focus" } },
        { "type": "ingredient", "settings": { "name": "Ubiquinol CoQ10", "amount": "100 mg", "system": "Cellular Energy" } },
        { "type": "ingredient", "settings": { "name": "Pyridoxal-5-Phosphate (P-5-P)", "amount": "5 mg", "system": "Active Cofactors" } },
        { "type": "ingredient", "settings": { "name": "Methyl B12 (Methylcobalamin)", "amount": "500 mcg", "system": "Active Cofactors" } },
        { "type": "ingredient", "settings": { "name": "5-MTHF (Active Folate)", "amount": "400 mcg DFE", "system": "Active Cofactors" } }
      ]
    }
  ]
}
{% endschema %}
