{%- liquid
  assign nx01_anchor = section.settings.anchor_id | default: 'nx01-facts' | handleize
  assign nx01_intro_class = 'nx01__intro'
  if section.settings.heading_alignment == 'center'
    assign nx01_intro_class = 'nx01__intro nx01__intro--center'
  endif
  assign ingredient_count = 0
  for block in section.blocks
    if block.type == 'ingredient'
      if block.settings.name != blank or block.settings.amount != blank
        assign ingredient_count = ingredient_count | plus: 1
      endif
    endif
  endfor
-%}

{% render 'nx01-launch-css' %}

{%- if nx01_anchor != 'nx01-formula' -%}
  <span id="nx01-formula" class="nx01-facts__alias"></span>
{%- endif -%}

<section
  id="{{ nx01_anchor }}"
  class="nx01 nx01-facts xo-section xo-section--{{ section.id }}{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  style="{% if section.settings.padding_top != blank %}--nx01-pad-block-start: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom != blank %} --nx01-pad-block-end: {{ section.settings.padding_bottom }}px;{% endif %}"
  aria-labelledby="nx01-facts-heading-{{ section.id }}"
>
  <div class="nx01__inner">
    <div class="{{ nx01_intro_class }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nx01__label">
          <span class="nx01__label-rule" aria-hidden="true"></span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="nx01__heading" id="nx01-facts-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="nx01__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="nx01-facts__grid">
      <div class="nx01-facts__table-wrap">
        {%- if ingredient_count > 0 -%}
          <ul class="nx01-facts__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'ingredient' -%}
                {%- if block.settings.name != blank or block.settings.amount != blank -%}
                  <li class="nx01-facts__item" {{ block.shopify_attributes }}>
                    {%- if block.settings.explanation != blank -%}
                      <details>
                        <summary class="nx01-facts__summary">
                          <span class="nx01-facts__name">{{ block.settings.name | escape }}</span>
                          <span class="nx01-facts__amount">{{ block.settings.amount | escape }}</span>
                          {%- if block.settings.system != blank -%}
                            <p class="nx01-facts__form">{{ block.settings.system | escape }}</p>
                          {%- endif -%}
                          <span class="xo-visually-hidden">{{ 'sections.nx01_launch_facts.details_label' | t }}</span>
                        </summary>
                        <div class="nx01-facts__explain">{{ block.settings.explanation }}</div>
                      </details>
                    {%- else -%}
                      <div class="nx01-facts__summary">
                        <span class="nx01-facts__name">{{ block.settings.name | escape }}</span>
                        <span class="nx01-facts__amount">{{ block.settings.amount | escape }}</span>
                        {%- if block.settings.system != blank -%}
                          <p class="nx01-facts__form">{{ block.settings.system | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.evidence_note != blank -%}
          <p class="nx01-facts__note">{{ section.settings.evidence_note | escape }}</p>
        {%- endif -%}

        {%- if section.settings.cta_label != blank and section.settings.cta_href != blank -%}
          <a class="nx01__text-link" href="{{ section.settings.cta_href | escape }}">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.panel_heading != blank or section.settings.panel_meta != blank or section.settings.panel_note != blank -%}
        <aside class="nx01-facts__panel"{% if section.settings.panel_heading != blank %} aria-labelledby="nx01-facts-panel-heading-{{ section.id }}"{% endif %}>
          {%- if section.settings.panel_heading != blank -%}
            <h3 class="nx01-facts__panel-title" id="nx01-facts-panel-heading-{{ section.id }}">{{ section.settings.panel_heading | escape }}</h3>
          {%- endif -%}
          {%- if section.settings.panel_meta != blank -%}
            <p class="nx01-facts__panel-meta">{{ section.settings.panel_meta | escape }}</p>
          {%- endif -%}
          <div class="nx01-facts__panel-rule" aria-hidden="true"></div>
          <ul class="nx01-facts__panel-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'ingredient' -%}
                {%- if block.settings.name != blank or block.settings.amount != blank -%}
                  <li>
                    <span>{{ block.settings.name | escape }}</span>
                    <strong>{{ block.settings.amount | escape }}</strong>
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if section.settings.panel_note != blank -%}
            <p class="nx01-facts__panel-note">{{ section.settings.panel_note | escape }}</p>
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .nx01-facts,
  .nx01-facts__alias {
    scroll-margin-top: var(--nx01-scroll-margin);
  }

  .nx01-facts__alias {
    display: block;
    height: 0;
  }

  .nx01-facts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4.8rem;
    align-items: start;
  }

  .nx01-facts__summary {
    list-style: none;
  }

  .nx01-facts__summary:focus-visible {
    outline: 0.2rem solid rgb(var(--nx01-navy));
    outline-offset: 0.4rem;
  }

  .nx01-facts__panel {
    padding: 3.2rem;
    border: 0.2rem solid rgb(var(--nx01-rule));
    background: rgb(var(--nx01-surface));
    border-radius: var(--nx01-radius);
  }

  .nx01-facts__panel-title {
    margin: 0 0 0.8rem;
    font-size: 2.2rem;
    font-weight: 600;
  }

  .nx01-facts__panel-meta,
  .nx01-facts__panel-note {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.5;
    color: rgb(var(--nx01-body));
  }

  .nx01-facts__panel-rule {
    height: 0.8rem;
    margin: 1.6rem 0 0;
    background: rgb(var(--nx01-rule));
  }

  .nx01-facts__panel-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nx01-facts__panel-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.6rem;
    padding: 1.2rem 0;
    border-bottom: 0.1rem solid rgb(var(--nx01-rule));
    font-size: 1.2rem;
    line-height: 1.35;
  }

  .nx01-facts__panel-list strong {
    overflow-wrap: anywhere;
  }

  .nx01-facts__panel-note {
    margin-top: 2.4rem;
  }

  @media screen and (max-width: 767px) {
    .nx01-facts__panel {
      padding: 2.4rem;
    }

    .nx01-facts__panel-list,
    .nx01-facts__panel-rule {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    .nx01-facts__grid {
      grid-template-columns: minmax(0, 1fr) minmax(24rem, 40rem);
      gap: 4.8rem;
    }

    .nx01-facts__panel {
      position: sticky;
      top: var(--nx01-scroll-margin, 12.8rem);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "NX-01 launch facts",
  "tag": "section",
  "class": "section-nx01-facts",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "header", "content": "Reuse" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Optional in-page link target. Leave blank to keep nx01-facts." },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "range", "id": "padding_top", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding bottom", "default": 48 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ingredients" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What’s inside, and why." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Nine listed actives in one 3-capsule serving. Open a row for the intended role." },
    { "type": "text", "id": "cta_label", "label": "Text link label" },
    { "type": "text", "id": "cta_href", "label": "Text link" },
    { "type": "textarea", "id": "evidence_note", "label": "Evidence note", "default": "Research on individual ingredients describes those compounds. It does not establish that the finished NX-01 formula produces a specific result." },
    { "type": "text", "id": "panel_heading", "label": "Panel heading", "default": "Supplement Facts" },
    { "type": "text", "id": "panel_meta", "label": "Panel meta", "default": "Serving Size: 3 Capsules | Servings Per Container: 30" },
    { "type": "textarea", "id": "panel_note", "label": "Panel note", "default": "* Daily Value (DV) not established for remaining ingredients. Other ingredients: vegetable cellulose (capsule), silicon dioxide." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Acetyl-L-Carnitine" },
        { "type": "text", "id": "amount", "label": "Amount", "default": "500 mg" },
        { "type": "text", "id": "system", "label": "Form", "default": "Acetyl-L-Carnitine" },
        { "type": "richtext", "id": "explanation", "label": "Explanation" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "NX-01 launch facts",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Acetyl-L-Carnitine", "amount": "500 mg", "system": "Acetyl-L-Carnitine" } },
        { "type": "ingredient", "settings": { "name": "CDP-Choline (Citicoline)", "amount": "250 mg", "system": "Citicoline" } },
        { "type": "ingredient", "settings": { "name": "NMN", "amount": "250 mg", "system": "Nicotinamide mononucleotide" } },
        { "type": "ingredient", "settings": { "name": "L-Theanine", "amount": "200 mg", "system": "L-Theanine" } },
        { "type": "ingredient", "settings": { "name": "Rhodiola rosea extract", "amount": "200 mg", "system": "Rhodiola rosea extract" } },
        { "type": "ingredient", "settings": { "name": "CoQ10", "amount": "100 mg", "system": "CoQ10" } },
        { "type": "ingredient", "settings": { "name": "Vitamin B6", "amount": "5 mg (294% DV)", "system": "Pyridoxal-5-Phosphate" } },
        { "type": "ingredient", "settings": { "name": "Vitamin B12", "amount": "500 mcg (20833% DV)", "system": "Methylcobalamin" } },
        { "type": "ingredient", "settings": { "name": "Folate", "amount": "400 mcg DFE (100% DV)", "system": "L-5-MTHF" } }
      ]
    }
  ]
}
{% endschema %}
