{%- style -%}
  .xo-section--{{ section.id }} .dubai-guide__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(3.2rem, 6vw, 9.6rem);
    align-items: start;
  }

  .xo-section--{{ section.id }} .dubai-guide__eyebrow {
    display: block;
    margin-bottom: 1.2rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 76%, transparent);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .xo-section--{{ section.id }} .dubai-guide__title {
    margin: 0 0 2rem;
    font-size: clamp(3.2rem, 5vw, 6.6rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
  }

  .xo-section--{{ section.id }} .dubai-guide__body {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
    font-size: 1.6rem;
    line-height: 1.75;
  }

  .xo-section--{{ section.id }} .dubai-guide__body p {
    margin: 0 0 1.6rem;
  }

  .xo-section--{{ section.id }} .dubai-guide__note {
    margin-top: 2.4rem;
    padding: 1.8rem 2rem;
    border-inline-start: 0.3rem solid rgba(var(--color-accent));
    border-radius: 0 1rem 1rem 0;
    background: rgba(var(--color-background-2));
    color: rgba(var(--color-foreground));
    font-size: 1.4rem;
    line-height: 1.6;
  }

  .xo-section--{{ section.id }} .dubai-guide__steps {
    display: grid;
    gap: 1.2rem;
  }

  .xo-section--{{ section.id }} .dubai-guide__step {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1.6rem;
    padding: 2.4rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 18%, transparent);
    border-radius: 2rem;
    background: rgba(var(--color-background));
  }

  .xo-section--{{ section.id }} .dubai-guide__number {
    display: inline-flex;
    width: 4rem;
    height: 4rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(var(--color-accent));
    color: rgba(var(--color-foreground));
    font-size: 1.4rem;
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .dubai-guide__step-title {
    margin: 0 0 0.8rem;
    font-size: 2rem;
    line-height: 1.3;
  }

  .xo-section--{{ section.id }} .dubai-guide__step-text {
    margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.5rem;
    line-height: 1.65;
  }

  .xo-section--{{ section.id }} .dubai-guide__link {
    display: inline-flex;
    min-height: 4.4rem;
    align-items: center;
    margin-top: 1.2rem;
    color: rgba(var(--color-foreground));
    font-size: 1.4rem;
    font-weight: 600;
    text-underline-offset: 0.4rem;
  }

  .xo-section--{{ section.id }} a:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .xo-section--{{ section.id }} .dubai-guide__layout {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<section id="dubai-guide" {% render 'section-attr', section: section %} aria-labelledby="dubai-guide-title-{{ section.id }}">
  <xo-container>
    <div class="dubai-guide__layout">
      <div>
        <span class="dubai-guide__eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 id="dubai-guide-title-{{ section.id }}" class="dubai-guide__title">{{ section.settings.heading }}</h2>
        <div class="dubai-guide__body">{{ section.settings.body }}</div>
        <aside class="dubai-guide__note" role="note">{{ section.settings.disclaimer }}</aside>
      </div>
      <div class="dubai-guide__steps">
        {%- for block in section.blocks -%}
          <article class="dubai-guide__step" {{ block.shopify_attributes }}>
            <span class="dubai-guide__number" aria-hidden="true">{{ forloop.index }}</span>
            <div>
              <h3 class="dubai-guide__step-title">{{ block.settings.title }}</h3>
              <p class="dubai-guide__step-text">{{ block.settings.text }}</p>
              {%- if block.settings.link != blank -%}
                <a class="dubai-guide__link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "Dubai guide",
  "tag": "section",
  "class": "section-dubai-guide",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A practical introduction" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What are nootropics?" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Nootropics is a broad term used for products people add to routines built around focus, memory, mood, energy, sleep, or long-term wellness. Products differ by ingredient, format, serving guidance, and intended use.</p><p>Start with a clear goal, read the complete product label, and choose one product at a time so your routine stays easy to understand.</p>" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Educational information only. This is not medical advice. Follow the product label and speak with a qualified healthcare professional if you have a medical condition, are pregnant or nursing, or take medication." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Selection step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the guide" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Dubai guide",
      "blocks": [
        { "type": "step", "settings": { "title": "Choose one goal", "text": "Decide whether your routine is centered on focus, learning, mood, energy, sleep, or long-term wellness." } },
        { "type": "step", "settings": { "title": "Compare the label", "text": "Review ingredients, serving guidance, quantity, warnings, current price, and availability on the product page." } },
        { "type": "step", "settings": { "title": "Check quality information", "text": "Use the product details and consult available Certificates of Analysis for eligible products." } },
        { "type": "step", "settings": { "title": "Keep the routine simple", "text": "Follow label directions and avoid changing several products at the same time." } }
      ]
    }
  ]
}
{% endschema %}
