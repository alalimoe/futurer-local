{% javascript %}
if (!customElements.get('npx-peptide-pdp')) {
  customElements.define('npx-peptide-pdp', class extends HTMLElement {
    connectedCallback() {
      if (this.controller) return;
      this.controller = new AbortController();
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => this.initialize(), { once: true, signal: this.controller.signal });
      else this.initialize();
    }
    initialize() {
      if (!this.isConnected || this.initialized) return;
      this.initialized = true;
      this.form = this.querySelector('.npp-form');
      this.quantity = this.querySelector('[data-quantity]');
      this.add = this.querySelector('[data-add]');
      this.cartAdd = this.querySelector('xo-cart-add');
      this.sticky = this.querySelector('[data-sticky]');
      this.options = [...this.querySelectorAll('[data-option]')];
      this.options.forEach(option => { option.dataset.originalValue = option.value; });
      this.querySelector('[data-option-controls]')?.removeAttribute('hidden');
      this.querySelector('[data-variant-input]').disabled = false;
      this.querySelectorAll('[data-quantity-change]').forEach(button => { button.hidden = false; });
      const listener = { signal: this.controller.signal };
      this.addEventListener('click', event => this.onClick(event), listener);
      this.addEventListener('change', event => {
        if (event.target.matches('[data-option]')) this.changeVariant(event.target.dataset.position);
        if (event.target === this.quantity) this.syncQuantity();
      }, listener);
      this.quantity.addEventListener('input', () => this.syncQuantity(), listener);
      this.addEventListener('click', event => {
        if (event.target.closest('[data-add]') && (!this.form.reportValidity() || this.hasAttribute('aria-busy'))) {
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      }, { ...listener, capture: true });
      if (this.sticky && 'IntersectionObserver' in window) {
        this.observer = new IntersectionObserver(([entry]) => {
          this.sticky.hidden = entry.isIntersecting || entry.boundingClientRect.bottom >= 0;
        });
        this.observer.observe(this.add);
      }
      this.syncQuantity();
    }
    syncQuantity() {
      const valid = this.quantity.checkValidity();
      if (valid) this.cartAdd.setAttribute('xo-product-quantity', this.quantity.value);
      const minus = this.querySelector('[data-quantity-change="-1"]');
      const plus = this.querySelector('[data-quantity-change="1"]');
      if (minus) minus.disabled = valid && Number(this.quantity.value) <= Number(this.quantity.min);
      if (plus) plus.disabled = valid && !!this.quantity.max && Number(this.quantity.value) >= Number(this.quantity.max);
    }
    onClick(event) {
      const quantityButton = event.target.closest('[data-quantity-change]');
      if (quantityButton) {
        if (Number(quantityButton.dataset.quantityChange) > 0) this.quantity.stepUp();
        else this.quantity.stepDown();
        this.syncQuantity();
      }
      if (event.target.closest('[data-sticky-add]')) {
        if (this.form.reportValidity()) this.add.click();
        else this.quantity.focus();
      }
      const thumbnail = event.target.closest('[data-thumb]');
      if (thumbnail && !event.ctrlKey && !event.metaKey && !event.shiftKey && event.button === 0) {
        event.preventDefault();
        this.querySelectorAll('[data-media-panel]').forEach(panel => {
          panel.hidden = panel.dataset.mediaPanel !== thumbnail.dataset.thumb;
          if (panel.hidden) panel.querySelectorAll('video').forEach(video => video.pause());
        });
        this.querySelectorAll('[data-thumb]').forEach(link => link.removeAttribute('aria-current'));
        thumbnail.setAttribute('aria-current', 'true');
      }
    }
    async changeVariant(position) {
      this.requestController?.abort();
      const requestController = new AbortController();
      this.requestController = requestController;
      this.setAttribute('aria-busy', 'true');
      this.add.disabled = true;
      this.querySelector('[data-sticky-add]')?.setAttribute('disabled', '');
      this.querySelector('[data-status]').textContent = this.dataset.loadingLabel;
      const url = new URL(this.dataset.url, window.location.origin);
      url.searchParams.set('section_id', this.dataset.section);
      url.searchParams.set('option_values', this.options.map(option => option.value).join(','));
      try {
        const response = await fetch(url, { signal: requestController.signal });
        if (!response.ok) throw new Error('Variant request failed');
        const page = new DOMParser().parseFromString(await response.text(), 'text/html');
        const next = page.querySelector('npx-peptide-pdp');
        if (!next || next.dataset.section !== this.dataset.section) throw new Error('Product section missing');
        const quantity = next.querySelector('[data-quantity]');
        quantity.value = this.quantity.value;
        if (!quantity.checkValidity()) quantity.value = quantity.min || '1';
        const selectedUrl = new URL(window.location.href);
        if (next.dataset.variantId) {
          selectedUrl.searchParams.set('variant', next.dataset.variantId);
          selectedUrl.searchParams.delete('option_values');
        } else {
          selectedUrl.searchParams.delete('variant');
          selectedUrl.searchParams.set('option_values', this.options.map(option => option.value).join(','));
        }
        window.history.replaceState({}, '', selectedUrl);
        this.replaceWith(next);
        next.querySelector(`[data-option][data-position="${position}"]`)?.focus({ preventScroll: true });
      } catch (error) {
        if (error.name === 'AbortError') return;
        this.removeAttribute('aria-busy');
        this.options.forEach(option => { option.value = option.dataset.originalValue; });
        this.add.disabled = this.cartAdd.hasAttribute('xo-disabled');
        const stickyAdd = this.querySelector('[data-sticky-add]');
        if (stickyAdd) stickyAdd.disabled = this.add.disabled;
        this.querySelector('[data-status]').textContent = this.dataset.errorLabel;
      }
    }
    disconnectedCallback() {
      this.controller?.abort();
      this.requestController?.abort();
      this.observer?.disconnect();
      this.controller = null;
      this.initialized = false;
    }
  });
}
{% endjavascript %}
