{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign reference = product.metafields.pep.reference.value
  assign archive = variant.metafields.pep.coa_archive.value
  if archive == blank and variant.metafields.pdp.coa_url == blank and variant.metafields.pep.coa_pdf == blank
    assign archive = product.metafields.pep.coa_archive.value
  endif
  assign form_id = 'npp-form-' | append: section.id
  assign selected_media = variant.featured_media | default: product.featured_media
  assign form_text = product.metafields.peptide.form.value
  assign strength = variant.metafields.pdp.strength_mg.value
  assign component_count = 0
  for block in section.blocks
    if block.type == 'component' and block.settings.for_product == product.handle
      assign component_count = component_count | plus: 1
    endif
  endfor
  assign is_bundle = false
  if component_count > 0 or product.metafields.filters.form.value contains 'Bundle'
    assign is_bundle = true
  endif
  assign references = reference.scientific_reference_list.value
  assign research_sections = product.metafields.pep.sections.value | sort: 'order'
  assign quantity_min = variant.quantity_rule.min | default: 1
  assign data_sheet = product.metafields.pep.data_sheet_pdf.value.url
  assign shipping_url = section.settings.shipping_link | default: shop.shipping_policy.url
  assign returns_url = shop.refund_policy.url
  assign contact_url = section.settings.contact_link
  assign report_count = 0
  capture report_cards
    for entry in archive
      capture report_card
        render 'npx-peptide-report', entry: entry, product: product, variant: variant
      endcapture
      assign report_card = report_card | strip
      if report_card != blank
        assign report_count = report_count | plus: 1
        echo report_card
      endif
    endfor
    if report_count == 0
      capture report_card
        render 'npx-peptide-report', product: product, variant: variant
      endcapture
      assign report_card = report_card | strip
      if report_card != blank
        assign report_count = 1
        echo report_card
      endif
    endif
  endcapture
-%}
<npx-peptide-pdp class="npp" data-section="{{ section.id }}" data-url="{{ product.url }}" data-loading-label="{{ 'npx_peptide.updating' | t | escape }}" data-error-label="{{ 'npx_peptide.variant_error' | t | escape }}" data-variant-id="{{ variant.id }}" {% if request.locale.iso_code == 'ar' %}dir="rtl"{% endif %}>
  <div class="npp-hero">
    <div class="npp-shell">
      <nav class="npp-breadcrumb" aria-label="{{ 'npx_peptide.breadcrumb' | t | escape }}">
        <a href="{{ routes.root_url }}">{{ 'npx_peptide.home' | t }}</a><span aria-hidden="true">/</span><span>{{ product.title | escape }}</span>
      </nav>
      <xo-product xo-product-id="{{ product.id }}" xo-section-id="{{ section.id }}" xo-selected-or-first-available-variant-id="{{ variant.id }}">
        <div class="npp-layout">
          <header class="npp-intro">
            <p class="npp-kicker"><span class="npp-dot" aria-hidden="true"></span>{{ 'npx_peptide.eyebrow' | t }}</p>
            <h1>{{ product.title | escape }}</h1>
            {% if form_text != blank %}<p class="npp-subtitle">{{ form_text | escape }}</p>{% endif %}
          </header>
          <div class="npp-gallery">
            <div class="npp-stage">
              {% for media in product.media %}
                <div class="npp-media" data-media-panel="{{ media.id }}" {% unless media.id == selected_media.id %}hidden{% endunless %}>
                  {% if media.media_type == 'image' %}
                    {% assign image_alt = media.alt | default: product.title %}
                    <a href="{{ media | image_url: width: 2400 }}" target="_blank" rel="noopener" aria-label="{{ 'npx_peptide.enlarge' | t: title: image_alt | escape }}">
                      {% if media.id == selected_media.id %}
                        {{ media | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: '(max-width: 749px) 90vw, (max-width: 1280px) 46vw, 580px', loading: 'eager', fetchpriority: 'high', alt: image_alt }}
                      {% else %}
                        {{ media | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 960, 1200', sizes: '(max-width: 749px) 90vw, 580px', loading: 'lazy', alt: image_alt }}
                      {% endif %}
                      <span class="npp-zoom" aria-hidden="true">↗</span>
                    </a>
                  {% else %}
                    {{ media | media_tag: image_size: '900x', controls: true, preload: 'none' }}
                  {% endif %}
                </div>
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'npp-placeholder' }}
              {% endfor %}
            </div>
            {% if product.media.size > 1 %}
              <div class="npp-thumbs" aria-label="{{ 'npx_peptide.gallery' | t | escape }}">
                {% for media in product.media %}
                  <a href="{{ media.preview_image | image_url: width: 1800 }}" data-thumb="{{ media.id }}" {% if media.id == selected_media.id %}aria-current="true"{% endif %} aria-label="{{ 'npx_peptide.view_image' | t: number: forloop.index | escape }}">
                    {{ media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: media.alt }}
                  </a>
                {% endfor %}
              </div>
            {% endif %}
            {% if report_count > 0 %}<a class="npp-gallery-note" href="#npp-reports-{{ section.id }}">{{ 'npx_peptide.review_reports' | t }} <span aria-hidden="true">↗</span></a>{% endif %}
          </div>
          <div class="npp-buy">
            <div class="npp-facts">
              {% if is_bundle %}
                {% for block in section.blocks %}
                  {% if block.type == 'component' and block.settings.for_product == product.handle %}
                    <div><strong><bdi>{{ block.settings.amount | escape }}</bdi></strong><span>{{ block.settings.title | escape }}</span></div>
                  {% endif %}
                {% endfor %}
              {% elsif strength != blank %}
                <div><strong>{{ strength }} <small>{{ 'npx_peptide.mg' | t }}</small></strong><span>{{ 'npx_peptide.selected_strength' | t }}</span></div>
              {% endif %}
              <div><strong>{{ 'npx_peptide.ruo_short' | t }}</strong><span>{{ 'npx_peptide.laboratory_material' | t }}</span></div>
            </div>
            {% form 'product', product, id: form_id, class: 'npp-form' %}
              {{ form.errors | default_errors }}
              {% unless product.has_only_default_variant %}
                <div class="npp-options" data-option-controls hidden>
                  {% for option in product.options_with_values %}
                    <label for="npp-option-{{ section.id }}-{{ option.position }}">{{ option.name | escape }}
                      <select id="npp-option-{{ section.id }}-{{ option.position }}" data-option data-position="{{ option.position }}">
                        {% for value in option.values %}<option value="{{ value.id }}" {% if value.selected %}selected{% endif %}>{{ value | escape }}</option>{% endfor %}
                      </select>
                    </label>
                  {% endfor %}
                </div>
                <noscript>
                  <label for="npp-fallback-{{ section.id }}">{{ 'npx_peptide.choose_option' | t }}</label>
                  <select id="npp-fallback-{{ section.id }}" name="id">
                    {% for v in product.variants %}<option value="{{ v.id }}" {% if v.id == variant.id %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title | escape }} — {{ v.price | money_with_currency }}{% unless v.available %} — {{ 'npx_peptide.sold_out' | t }}{% endunless %}</option>{% endfor %}
                  </select>
                </noscript>
              {% endunless %}
              <input type="hidden" name="id" value="{{ variant.id }}" data-variant-input {% unless product.has_only_default_variant %}disabled{% endunless %}>
              <div class="npp-price-row">
                <div><span class="npp-price-label">{% if is_bundle %}{{ 'npx_peptide.bundle_price' | t }}{% else %}{{ 'npx_peptide.price' | t }}{% endif %}</span><strong class="npp-price">{% if variant != blank %}{{ variant.price | money_with_currency }}{% else %}{{ 'npx_peptide.unavailable' | t }}{% endif %}</strong></div>
                {% if variant.compare_at_price > variant.price %}<s class="npp-compare">{{ variant.compare_at_price | money_with_currency }}</s>{% endif %}
              </div>
              <div class="npp-purchase">
                <label class="npp-quantity-label" for="npp-quantity-{{ section.id }}">{{ 'npx_peptide.quantity' | t }}</label>
                <div class="npp-quantity">
                  <button type="button" data-quantity-change="-1" aria-label="{{ 'npx_peptide.decrease' | t | escape }}" hidden>−</button>
                  <input type="number" id="npp-quantity-{{ section.id }}" name="quantity" value="{{ quantity_min }}" min="{{ quantity_min }}" step="{{ variant.quantity_rule.increment | default: 1 }}" {% if variant.quantity_rule.max != blank %}max="{{ variant.quantity_rule.max }}"{% endif %} inputmode="numeric" required data-quantity>
                  <button type="button" data-quantity-change="1" aria-label="{{ 'npx_peptide.increase' | t | escape }}" hidden>+</button>
                </div>
                <xo-cart-add xo-product-id="{{ product.id }}" xo-variant-id="{{ variant.id }}" xo-section-id="{{ section.id }}" xo-product-quantity="{{ quantity_min }}" {% unless variant.available %}xo-disabled{% endunless %} {% if settings.cart_type == 'page' %}xo-cart-redirection{% endif %}>
                  <button class="npp-button" type="submit" name="add" data-add {% unless variant.available %}disabled{% endunless %}>
                    {% if variant.available %}{{ 'npx_peptide.add_to_cart' | t }}{% else %}{{ 'npx_peptide.sold_out' | t }}{% endif %}<span aria-hidden="true">→</span>
                  </button>
                </xo-cart-add>
              </div>
              {% render 'cart-add-error' %}
              <p class="npp-status" role="status" aria-live="polite" data-status></p>
              {% if section.settings.show_payment_terms %}<div class="npp-payment-terms">{{ form | payment_terms }}</div>{% endif %}
            {% endform %}
            <div class="npp-buy-links">
              {% if shipping_url != blank %}<a href="{{ shipping_url }}">{{ 'npx_peptide.shipping' | t }} <span aria-hidden="true">↗</span></a>{% endif %}
              {% if report_count > 0 %}<a href="#npp-reports-{{ section.id }}">{{ 'npx_peptide.reports' | t }} <span aria-hidden="true">↓</span></a>{% endif %}
            </div>
            <p class="npp-ruo">{{ 'npx_peptide.ruo' | t }}</p>
            {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
              <div class="npp-payment-row"><span>{{ 'npx_peptide.secure_checkout' | t }}</span><ul aria-label="{{ 'npx_peptide.payment_methods' | t | escape }}">{% for payment in shop.enabled_payment_types %}<li>{{ payment | payment_type_svg_tag }}</li>{% endfor %}</ul></div>
            {% endif %}
          </div>
        </div>
        {% render 'product-data', product: product %}
      </xo-product>
    </div>
  </div>
  <nav class="npp-navigation" aria-label="{{ 'npx_peptide.on_this_page' | t | escape }}"><div class="npp-shell">
    <a href="#npp-contents-{{ section.id }}">{{ 'npx_peptide.contents' | t }}</a>
    <a href="#npp-reports-{{ section.id }}">{{ 'npx_peptide.reports' | t }}</a>
    {% if references != blank or research_sections != blank %}<a href="#npp-research-{{ section.id }}">{{ 'npx_peptide.research' | t }}</a>{% endif %}
    <a href="#npp-faq-{{ section.id }}">{{ 'npx_peptide.faq_short' | t }}</a>
  </div></nav>
  <section class="npp-band npp-contents" id="npp-contents-{{ section.id }}">
    <div class="npp-shell">
      <header class="npp-heading"><p class="npp-kicker">{{ 'npx_peptide.contents_eyebrow' | t }}</p><h2>{{ 'npx_peptide.contents_heading' | t }}</h2></header>
      {% if component_count > 0 %}
        <div class="npp-components">
          {% for block in section.blocks %}
            {% if block.type == 'component' and block.settings.for_product == product.handle %}
              {% assign component_product = block.settings.component_product %}
              <article class="npp-component" {{ block.shopify_attributes }}>
                {% if component_product.featured_image != blank %}<div class="npp-component__image">{{ component_product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '180, 300, 400', sizes: '(max-width: 749px) 96px, 160px' }}</div>{% endif %}
                <div><span class="npp-kicker">{{ 'npx_peptide.component_number' | t: number: forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><p class="npp-component__amount"><bdi>{{ block.settings.amount | escape }}</bdi></p><p>{{ 'npx_peptide.vial_count' | t: count: block.settings.vial_count }}</p></div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      {% elsif product.metafields.pdp.whats_inside != blank %}
        <div class="npp-content-copy">{{ product.metafields.pdp.whats_inside | metafield_tag }}</div>
      {% else %}
        <div class="npp-specs">
          {% if form_text != blank %}<div><span>{{ 'npx_peptide.form' | t }}</span><strong>{{ form_text | escape }}</strong></div>{% endif %}
          {% if strength != blank %}<div><span>{{ 'npx_peptide.selected_strength' | t }}</span><strong>{{ strength }} {{ 'npx_peptide.mg' | t }}</strong></div>{% endif %}
          <div><span>{{ 'npx_peptide.intended_use' | t }}</span><strong>{{ 'npx_peptide.laboratory_research' | t }}</strong></div>
        </div>
      {% endif %}
    </div>
  </section>
  <section class="npp-band npp-reports" id="npp-reports-{{ section.id }}">
    <div class="npp-shell">
      <header class="npp-heading"><p class="npp-kicker">{{ 'npx_peptide.documentation' | t }}</p><h2>{{ 'npx_peptide.reports_heading' | t }}</h2><p>{{ 'npx_peptide.report_scope' | t }}</p></header>
      {% if report_count > 0 %}<div class="npp-report-grid">{{ report_cards }}</div>
      {% else %}<div class="npp-empty"><p>{{ 'npx_peptide.no_report' | t }}</p>{% if contact_url != blank %}<a class="npp-text-link" href="{{ contact_url }}">{{ 'npx_peptide.request_report' | t }} ↗</a>{% endif %}</div>{% endif %}
      {% if data_sheet != blank %}<a class="npp-text-link npp-data-sheet" href="{{ data_sheet }}" target="_blank" rel="noopener">{{ 'npx_peptide.data_sheet' | t }} ↗</a>{% endif %}
    </div>
  </section>
  <section class="npp-band npp-details"><div class="npp-shell npp-split">
    <header class="npp-heading"><p class="npp-kicker">{{ 'npx_peptide.product_information' | t }}</p><h2>{{ 'npx_peptide.details_heading' | t }}</h2></header>
    <div class="npp-accordions">
      {% unless is_bundle %}
        {% if reference.summary != blank %}<details><summary>{{ 'npx_peptide.overview' | t }}<span aria-hidden="true">+</span></summary><div class="npp-answer">{{ reference.summary | metafield_tag }}</div></details>{% endif %}
        {% if reference.molecular_formula != blank or reference.sequence != blank %}
          <details><summary>{{ 'npx_peptide.structure' | t }}<span aria-hidden="true">+</span></summary><div class="npp-answer"><dl class="npp-report__meta">
            {% if reference.molecular_formula != blank %}<div><dt>{{ 'npx_peptide.formula' | t }}</dt><dd dir="ltr">{{ reference.molecular_formula.value | escape }}</dd></div>{% endif %}
            {% if reference.molecular_weight_g_mol != blank %}<div><dt>{{ 'npx_peptide.molecular_weight' | t }}</dt><dd dir="ltr">{{ reference.molecular_weight_g_mol.value | escape }}</dd></div>{% endif %}
            {% if reference.sequence != blank %}<div><dt>{{ 'npx_peptide.sequence' | t }}</dt><dd dir="ltr">{{ reference.sequence.value | escape }}</dd></div>{% endif %}
          </dl>{% if reference.pubchem_url != blank %}<a class="npp-text-link" href="{{ reference.pubchem_url.value }}" target="_blank" rel="noopener">{{ 'npx_peptide.pubchem' | t }} ↗</a>{% endif %}</div></details>
        {% endif %}
      {% endunless %}
      {% if product.metafields.peptide.storage != blank %}<details><summary>{{ 'npx_peptide.storage' | t }}<span aria-hidden="true">+</span></summary><div class="npp-answer">{{ product.metafields.peptide.storage | metafield_tag }}</div></details>{% endif %}
      <details><summary>{{ 'npx_peptide.shipping_returns' | t }}<span aria-hidden="true">+</span></summary><div class="npp-answer"><p>{{ 'npx_peptide.shipping_note' | t }}</p>{% if shipping_url != blank %}<a class="npp-text-link" href="{{ shipping_url }}">{{ 'npx_peptide.shipping' | t }} ↗</a>{% endif %} {% if returns_url != blank %}<a class="npp-text-link" href="{{ returns_url }}">{{ 'npx_peptide.returns' | t }} ↗</a>{% endif %}</div></details>
    </div>
  </div></section>
  {% if references != blank or research_sections != blank %}
    <section class="npp-band npp-research" id="npp-research-{{ section.id }}"><div class="npp-shell npp-split">
      <header class="npp-heading"><p class="npp-kicker">{{ 'npx_peptide.published_research' | t }}</p><h2>{{ 'npx_peptide.research_heading' | t }}</h2><p>{{ 'npx_peptide.research_scope' | t }}</p></header>
      <ol class="npp-sources">
        {% for item in references %}
          {% liquid
            assign source_url = item.url | default: item
            assign source_title = item.title
            assign source_host = source_url | split: '//' | last | split: '/' | first
            assign source_id = source_url | remove_last: '/' | split: '/' | last
            assign compound = reference.title_common.value | default: product.title
            if source_title == blank
              assign source_title = 'npx_peptide.source_title' | t: compound: compound, number: forloop.index
            endif
          %}
          {% if source_url != blank %}<li><span class="npp-source-index" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><div><h3><a href="{{ source_url | escape }}" target="_blank" rel="noopener">{{ source_title | escape }} <span aria-hidden="true">↗</span></a></h3><p>{{ source_host | escape }} · {{ source_id | escape }}</p></div></li>{% endif %}
        {% endfor %}
      </ol>
      {% if research_sections != blank %}
        <div class="npp-research-details npp-accordions">
          {% for research_section in research_sections %}
            {% if research_section.heading != blank and research_section.body != blank %}
              <details><summary>{{ research_section.heading.value | escape }}<span aria-hidden="true">+</span></summary><div class="npp-answer">
                {{ research_section.body | metafield_tag }}
                {% if research_section.figure_image.value != blank %}{{ research_section.figure_image.value | image_url: width: 900 | image_tag: loading: 'lazy', alt: research_section.figure_caption.value }}{% endif %}
                {% if research_section.source_link.value != blank %}<a class="npp-text-link" href="{{ research_section.source_link.value }}" target="_blank" rel="noopener">{{ 'npx_peptide.view_source' | t }} ↗</a>{% endif %}
              </div></details>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div></section>
  {% endif %}
  <section class="npp-band npp-faq" id="npp-faq-{{ section.id }}"><div class="npp-shell npp-split">
    <header class="npp-heading"><p class="npp-kicker">{{ 'npx_peptide.before_ordering' | t }}</p><h2>{{ 'npx_peptide.faq_heading' | t }}</h2></header>
    <div class="npp-accordions">
      {% for i in (1..4) %}
        {% assign question_key = 'npx_peptide.faq_q' | append: i %}{% assign answer_key = 'npx_peptide.faq_a' | append: i %}
        <details><summary>{{ question_key | t }}<span aria-hidden="true">+</span></summary><div class="npp-answer"><p>{{ answer_key | t }}</p>{% if i == 2 %}<a class="npp-text-link" href="#npp-reports-{{ section.id }}">{{ 'npx_peptide.reports' | t }} ↑</a>{% elsif i == 4 and contact_url != blank %}<a class="npp-text-link" href="{{ contact_url }}">{{ 'npx_peptide.contact' | t }} ↗</a>{% endif %}</div></details>
      {% endfor %}
    </div>
  </div></section>
  {% assign related_products = product.metafields.pep.complementary_peptides.value %}
  {% if section.settings.show_related and related_products != blank %}
    <section class="npp-band npp-related"><div class="npp-shell"><header class="npp-heading"><p class="npp-kicker">{{ 'npx_peptide.explore' | t }}</p><h2>{{ 'npx_peptide.related_heading' | t }}</h2></header><div class="npp-related-grid">
      {% for related in related_products limit: 3 %}{% if related.id != product.id and related.url != blank %}<a class="npp-related-card" href="{{ related.url }}">{% if related.featured_image != blank %}{{ related.featured_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '200, 320, 420', sizes: '(max-width: 749px) 44vw, 320px' }}{% endif %}<h3>{{ related.title | escape }} <span aria-hidden="true">↗</span></h3><p>{% if related.price_varies %}{{ 'npx_peptide.from' | t }} {% endif %}{{ related.price | money_with_currency }}</p></a>{% endif %}{% endfor %}
    </div></div></section>
  {% endif %}
  {% if section.settings.enable_sticky %}
    <div class="npp-sticky" data-sticky hidden><div class="npp-sticky__inner"><div><strong>{{ product.title | escape }}</strong><span>{{ variant.price | money_with_currency }}{% unless product.has_only_default_variant %} · {{ variant.title | escape }}{% endunless %}</span></div><button type="button" class="npp-button" data-sticky-add {% unless variant.available %}disabled{% endunless %}>{% if variant.available %}{{ 'npx_peptide.add_to_cart' | t }}{% else %}{{ 'npx_peptide.sold_out' | t }}{% endif %}</button></div></div>
  {% endif %}
</npx-peptide-pdp>
{% if section.settings.structured_data %}<script type="application/ld+json">{{ product | structured_data }}</script>{% endif %}

{% schema %}
{
  "name": "Peptide product",
  "settings": [
    {"type":"url","id":"shipping_link","label":"Shipping information"},
    {"type":"url","id":"contact_link","label":"Research enquiries"},
    {"type":"checkbox","id":"enable_sticky","label":"Show purchase bar after main button scrolls away","default":true},
    {"type":"checkbox","id":"show_payment_terms","label":"Show Shopify payment terms","default":true},
    {"type":"checkbox","id":"show_payment_icons","label":"Show payment icons","default":true},
    {"type":"checkbox","id":"show_related","label":"Show linked related products","default":true},
    {"type":"checkbox","id":"structured_data","label":"Include product structured data","default":true}
  ],
  "blocks":[{"type":"component","name":"Bundle component","settings":[
    {"type":"text","id":"for_product","label":"Bundle product handle","info":"Only shows on this exact bundle. Never use a related product as a bundle component without confirming the contents."},
    {"type":"product","id":"component_product","label":"Component product image"},
    {"type":"text","id":"title","label":"Compound name"},
    {"type":"text","id":"amount","label":"Amount per vial"},
    {"type":"range","id":"vial_count","label":"Number of vials","min":1,"max":10,"step":1,"default":1}
  ]}],
  "presets":[{"name":"Peptide product"}]
}
{% endschema %}

{% stylesheet %}
.npp{--npp-ink:#142342;--npp-muted:#536076;--npp-blue:#243f95;--npp-line:#dfe4ec;display:block;color:var(--npp-ink);background:#fff;font:15px/1.65 var(--font-body-family,Arial,sans-serif);overflow-wrap:anywhere}
