{%- liquid
  assign peptide_blocks = section.blocks | where: 'type', 'peptide'
  assign heading = section.settings.heading | default: 'Research-Use Peptide Supply Inquiries'
  assign contact_email = section.settings.email | default: 'research@nootropix.shop'
-%}

{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: rgba(var(--color-foreground));
  }
  .xo-section--{{ section.id }} .pw__wrap {
    max-width: 980px;
    margin: 0 auto;
  }
  .xo-section--{{ section.id }} .pw__header,
  .xo-section--{{ section.id }} .pw__panel,
  .xo-section--{{ section.id }} .pw__form-wrap {
    padding: clamp(1.25rem, 4vw, 2.5rem);
    margin-bottom: 1.5rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
  }
  .xo-section--{{ section.id }} .pw__header { background: rgba(var(--color-background-2)); }
  .xo-section--{{ section.id }} .pw__heading {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  .xo-section--{{ section.id }} .pw__desc,
  .xo-section--{{ section.id }} .pw__muted {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 68%, transparent);
    line-height: 1.7;
  }
  .xo-section--{{ section.id }} h2 { margin: 0 0 0.75rem; }
  .xo-section--{{ section.id }} p,
  .xo-section--{{ section.id }} li { line-height: 1.7; }
  .xo-section--{{ section.id }} .pw__table-wrap { overflow-x: auto; }
  .xo-section--{{ section.id }} .pw__table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
  }
  .xo-section--{{ section.id }} .pw__table th,
  .xo-section--{{ section.id }} .pw__table td {
    padding: 0.75rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
  }
  .xo-section--{{ section.id }} .pw__form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .xo-section--{{ section.id }} .pw__field--full { grid-column: 1 / -1; }
  .xo-section--{{ section.id }} .pw__field label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 600;
  }
  .xo-section--{{ section.id }} .pw__required { font-weight: 400; }
  .xo-section--{{ section.id }} .pw__form input:not([type='checkbox']),
  .xo-section--{{ section.id }} .pw__form textarea {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 18%, transparent);
    border-radius: var(--button-radius, 8px);
    background: rgba(var(--color-background));
    color: rgba(var(--color-foreground));
    font: inherit;
  }
  .xo-section--{{ section.id }} .pw__check {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
  }
  .xo-section--{{ section.id }} .pw__check input {
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.2rem;
    flex: 0 0 auto;
  }
  .xo-section--{{ section.id }} .pw__submit {
    min-height: 44px;
    padding: 0.75rem 1.25rem;
    border: 0;
    border-radius: var(--button-radius, 8px);
    background: rgba(var(--color-accent));
    color: rgba(var(--color-foreground));
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .xo-section--{{ section.id }} .pw__errors {
    padding: 1rem;
    border: 1px solid rgba(var(--color-error));
    color: rgba(var(--color-error));
  }
  .xo-section--{{ section.id }} .pw__errors ul { margin-bottom: 0; }
  .xo-section--{{ section.id }} .pw__success {
    padding: 1rem;
    color: rgba(var(--color-success));
    font-weight: 600;
  }
  .xo-section--{{ section.id }} :focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }
  @media (max-width: 749px) {
    .xo-section--{{ section.id }} .pw__form { grid-template-columns: 1fr; }
    .xo-section--{{ section.id }} .pw__field--full { grid-column: auto; }
  }
{%- endstyle -%}

<section {% render 'section-attr' %}>
  <xo-container>
    <div class="pw__wrap">
      <header class="pw__header">
        <h1 class="pw__heading">{{ heading | escape }}</h1>
        {%- if section.settings.description != blank -%}
          <p class="pw__desc">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </header>

      <section class="pw__panel" aria-labelledby="pw-eligibility-{{ section.id }}">
        <h2 id="pw-eligibility-{{ section.id }}">Research-use eligibility</h2>
        <ul>
          <li>Inquiries are considered for verified organizations with a documented non-clinical research purpose.</li>
          <li>Materials are for research use only (RUO), not for human or veterinary use, diagnosis, treatment, compounding, resale to consumers, or household use.</li>
          <li>Submitting this form does not guarantee qualification, availability, documentation, pricing, or supply.</li>
          <li>The inquiring organization is responsible for applicable laws, approvals, facilities, training, handling, storage, and disposal.</li>
        </ul>
      </section>

      {%- if peptide_blocks.size > 0 -%}
        <section class="pw__panel" aria-labelledby="pw-materials-{{ section.id }}">
          <h2 id="pw-materials-{{ section.id }}">Research material inquiry list</h2>
          <div class="pw__table-wrap" role="region" aria-label="Research material inquiry list" tabindex="0">
            <table class="pw__table">
              <thead>
                <tr>
                  <th scope="col">Material</th>
                  <th scope="col">Format requested</th>
                  <th scope="col">Minimum inquiry quantity</th>
                  <th scope="col">Reviewed document note</th>
                </tr>
              </thead>
              <tbody>
                {%- for block in peptide_blocks -%}
                  {%- if block.settings.name != blank -%}
                    <tr {{ block.shopify_attributes }}>
                      <td>{{ block.settings.name | escape }}</td>
                      <td>{{ block.settings.format | default: 'Specify in inquiry' | escape }}</td>
                      <td>{{ block.settings.moq | default: 'Specify requested quantity' | escape }}</td>
                      <td>{{ block.settings.documentation | default: 'Document availability confirmed during qualification' | escape }}</td>
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>
          <p class="pw__muted">No fixed purity, lead time, shipping condition, or universal document package is represented here. Any material- or lot-specific information must be confirmed in a reviewed quotation.</p>
        </section>
      {%- endif -%}

      <section class="pw__panel" aria-labelledby="pw-process-{{ section.id }}">
        <h2 id="pw-process-{{ section.id }}">Qualification process</h2>
        <ol>
          <li>Submit the organization's legal identity, website, location, requested material and quantity, and intended research use.</li>
          <li>We review organizational eligibility and may request registration, facility, principal-investigator, ethics, import, or other supporting information.</li>
          <li>If the inquiry qualifies, any available material specifications, lot documents, commercial terms, and logistics are provided for that request.</li>
          <li>No supply is confirmed until verification and a written quotation are complete.</li>
        </ol>
      </section>

      <div class="pw__form-wrap">
        <h2 id="wholesale-form-heading-{{ section.id }}">Submit a qualified research inquiry</h2>
        <p id="wholesale-form-help-{{ section.id }}" class="pw__muted">Fields marked required are used to assess organization and intended-use eligibility. Do not include patient or consumer health information.</p>

        {%- form 'contact',
          id: 'PeptideWholesaleForm',
          class: 'pw__form',
          aria-labelledby: 'wholesale-form-heading-' | append: section.id,
          aria-describedby: 'wholesale-form-help-' | append: section.id
        -%}
          {%- if form.posted_successfully? -%}
            <p class="pw__success pw__field--full" role="status">Thank you. Your inquiry was received for eligibility review; this is not a confirmation of supply.</p>
          {%- else -%}
            {%- if form.errors -%}
              <div class="pw__errors pw__field--full" role="alert" tabindex="-1">
                <p><strong>Please correct the following:</strong></p>
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <input type="hidden" name="contact[tags]" value="peptide, wholesale, RUO, organization-verification">

            <div class="pw__field">
              <label for="pw-company-{{ section.id }}">Organization legal name <span class="pw__required">(required)</span></label>
              <input id="pw-company-{{ section.id }}" type="text" name="contact[organization]" required autocomplete="organization">
            </div>

            <div class="pw__field">
              <label for="pw-website-{{ section.id }}">Organization website or registry URL <span class="pw__required">(required)</span></label>
              <input id="pw-website-{{ section.id }}" type="url" name="contact[organization_website]" required inputmode="url" placeholder="https://">
            </div>

            <div class="pw__field">
              <label for="pw-name-{{ section.id }}">Authorized contact name <span class="pw__required">(required)</span></label>
              <input id="pw-name-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name }}" required autocomplete="name">
            </div>

            <div class="pw__field">
              <label for="pw-email-{{ section.id }}">Organization email <span class="pw__required">(required)</span></label>
              <input
                id="pw-email-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                required
                autocomplete="email"
                {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="pw-email-error-{{ section.id }}"{% endif %}
              >
              {%- if form.errors contains 'email' -%}<span id="pw-email-error-{{ section.id }}" class="pw__muted">Enter a valid organization email address.</span>{%- endif -%}
            </div>

            <div class="pw__field">
              <label for="pw-country-{{ section.id }}">Organization country or jurisdiction <span class="pw__required">(required)</span></label>
              <input id="pw-country-{{ section.id }}" type="text" name="contact[country]" required autocomplete="country-name">
            </div>

            <div class="pw__field">
              <label for="pw-phone-{{ section.id }}">Business phone <span class="pw__required">(optional)</span></label>
              <input id="pw-phone-{{ section.id }}" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
            </div>

            <div class="pw__field pw__field--full">
              <label for="pw-products-{{ section.id }}">Requested research material(s) <span class="pw__required">(required)</span></label>
              <textarea id="pw-products-{{ section.id }}" name="contact[requested_materials]" rows="3" required></textarea>
            </div>

            <div class="pw__field pw__field--full">
              <label for="pw-quantity-{{ section.id }}">Requested quantity and format <span class="pw__required">(required)</span></label>
              <input id="pw-quantity-{{ section.id }}" type="text" name="contact[requested_quantity_and_format]" required>
            </div>

            <div class="pw__field pw__field--full">
              <label for="pw-use-{{ section.id }}">Intended non-clinical research use <span class="pw__required">(required)</span></label>
              <textarea id="pw-use-{{ section.id }}" name="contact[intended_research_use]" rows="5" required aria-describedby="pw-use-help-{{ section.id }}"></textarea>
              <span id="pw-use-help-{{ section.id }}" class="pw__muted">Describe the study purpose, responsible team, facility context, and any approvals relevant to the request.</span>
            </div>

            <div class="pw__field pw__field--full">
              <label for="pw-documents-{{ section.id }}">Documents requested <span class="pw__required">(optional)</span></label>
              <textarea id="pw-documents-{{ section.id }}" name="contact[documents_requested]" rows="3" placeholder="List material- or lot-specific documents needed for your review."></textarea>
            </div>

            <div class="pw__field pw__field--full">
              <label for="pw-message-{{ section.id }}">Additional organization or compliance information <span class="pw__required">(optional)</span></label>
              <textarea id="pw-message-{{ section.id }}" name="contact[body]" rows="3"></textarea>
            </div>

            <div class="pw__field pw__field--full pw__check">
              <input id="pw-ruo-{{ section.id }}" type="checkbox" name="contact[RUO_confirmation]" value="Confirmed" required>
              <label for="pw-ruo-{{ section.id }}">I confirm that this inquiry is on behalf of the named organization for non-clinical research use only, not for human or veterinary use, treatment, compounding, consumer resale, or household use. <span class="pw__required">(required)</span></label>
            </div>

            <div class="pw__field pw__field--full">
              <button type="submit" class="pw__submit">Submit for eligibility review</button>
            </div>
          {%- endif -%}
        {%- endform -%}

        <p class="pw__muted">For organization inquiries only: <a href="mailto:{{ contact_email | escape }}">{{ contact_email | escape }}</a></p>
      </div>
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "Peptide Wholesale",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Research-Use Peptide Supply Inquiries" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Qualified organization inquiries for non-clinical research use only. Verification is required before any availability, documentation, commercial terms, or logistics are confirmed." },
    { "type": "text", "id": "email", "label": "Organization inquiry email", "default": "research@nootropix.shop" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "blocks": [
    {
      "type": "peptide",
      "name": "Research material",
      "settings": [
        { "type": "text", "id": "name", "label": "Material name" },
        { "type": "text", "id": "purity", "label": "Legacy purity (not displayed)", "info": "Do not publish a fixed purity claim here." },
        { "type": "text", "id": "format", "label": "Format requested" },
        { "type": "text", "id": "moq", "label": "Minimum inquiry quantity" },
        { "type": "text", "id": "lead_time", "label": "Legacy lead time (not displayed)", "info": "Confirm timing only in a reviewed quotation." },
        { "type": "textarea", "id": "documentation", "label": "Reviewed document note", "info": "Optional. Publish only when reviewed and accurate for this material." }
      ]
    }
  ],
  "presets": [
    { "name": "Peptide Wholesale" }
  ]
}
{% endschema %}
