{% comment %} NX Flagship dual-pathway — cognitive + cellular energy mapping. {% endcomment %}

{{ 'nx-flagship.css' | asset_url | stylesheet_tag }}

<section {% render 'section-attr' %} id="nx-pathways" class="nx-flagship nx-flagship__anchor nx-flagship__section">
  <xo-container>
    <div class="nx-flagship__wrap">
      <p class="nx-flagship__eyebrow">{{ section.settings.eyebrow | default: 'Dual Pathway Formula' }}</p>
      <h2 class="nx-flagship__h2">{{ section.settings.heading | default: 'Two systems. One daily stack.' }}</h2>
      <p class="nx-flagship__lead">{{ section.settings.lead }}</p>

      <div class="nx-flagship__grid-2">
        {% for block in section.blocks %}
          {% if block.type == 'pathway' %}
            <div class="nx-flagship__card nx-flagship__pathway" {{ block.shopify_attributes }}>
              <div class="nx-flagship__pathway-head">
                <div class="nx-flagship__pathway-icon" aria-hidden="true">
                  {% if block.settings.icon == 'brain' %}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 4c-2 0-3.5 1.5-4 3.5C6 6.5 4 8 4 10.5 4 13 5.5 15 8 15.5V18c0 1 1 2 2 2h4c1 0 2-1 2-2v-2.5c2.5-.5 4-2.5 4-5 0-2.5-2-4-4-4-.5-2-2-3.5-4-3.5z"/></svg>
                  {% else %}
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                  {% endif %}
                </div>
                <h3 class="nx-flagship__pathway-title">{{ block.settings.title }}</h3>
              </div>
              <p style="margin:0;font-size:1.4rem;color:var(--nx-muted);line-height:1.6;">{{ block.settings.description }}</p>
              <ul class="nx-flagship__pathway-list">
                {% assign items = block.settings.ingredients | newline_to_br | split: '<br />' %}
                {% for item in items %}
                  {%- assign parts = item | strip | split: '|' -%}
                  {% if parts.size >= 2 %}
                    <li class="nx-flagship__pathway-item">
                      <div>
                        <strong>{{ parts[0] | strip }}</strong>
                        <span>{{ parts[1] | strip }}</span>
                      </div>
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "NX — Dual Pathway",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dual Pathway Formula" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two systems. One daily stack." },
    { "type": "textarea", "id": "lead", "label": "Lead text", "default": "Baseline targets cognitive clarity and cellular energy with complementary actives — designed to work together, not compete." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },
    { "type": "number", "id": "padding_top_desktop", "label": "Padding top desktop", "default": 48 },
    { "type": "number", "id": "padding_bottom_desktop", "label": "Padding bottom desktop", "default": 48 },
    { "type": "number", "id": "padding_top_mobile", "label": "Padding top mobile", "default": 32 },
    { "type": "number", "id": "padding_bottom_mobile", "label": "Padding bottom mobile", "default": 32 }
  ],
  "blocks": [
    {
      "type": "pathway",
      "name": "Pathway",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "brain", "label": "Brain" },
          { "value": "energy", "label": "Energy" }
        ], "default": "brain" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cognitive Clarity" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Supports focus, working memory, and calm alertness." },
        { "type": "textarea", "id": "ingredients", "label": "Ingredients (Name|Role per line)", "default": "Citicoline|Choline donor for acetylcholine & phospholipid synthesis\nL-Theanine|Promotes calm focus without sedation\nRhodiola|Adaptogen for stress resilience & mental stamina" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NX — Dual Pathway",
      "blocks": [
        {
          "type": "pathway",
          "settings": {
            "icon": "brain",
            "title": "Cognitive Clarity",
            "description": "Supports focus, working memory, and calm alertness without the jitters.",
            "ingredients": "Citicoline|Choline donor for acetylcholine & phospholipid synthesis\nL-Theanine|Promotes calm focus without sedation\nRhodiola|Adaptogen for stress resilience & mental stamina"
          }
        },
        {
          "type": "pathway",
          "settings": {
            "icon": "energy",
            "title": "Cellular Energy",
            "description": "Fuels mitochondrial function and NAD+ pathways for sustained daily vitality.",
            "ingredients": "ALCAR|Transports fatty acids into mitochondria for ATP production\nNMN|NAD+ precursor supporting cellular repair & metabolism\nCoQ10|Essential electron carrier in the mitochondrial energy chain"
          }
        }
      ]
    }
  ]
}
{% endschema %}
