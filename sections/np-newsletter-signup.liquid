{% comment %}
  NP • Newsletter Signup
  Custom-designed Klaviyo signup form that posts to the Klaviyo Client
  Subscriptions API client-side (no Klaviyo form editor). The Klaviyo onsite
  script is loaded site-wide, so consent + profile tracking stay intact.
  Layouts: "hero" (full landing page) and "band" (compact, e.g. homepage).
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign title_id = 'np-nl-title-' | append: section.id
  assign email_id = 'np-nl-email-' | append: section.id
  assign status_id = 'np-nl-status-' | append: section.id
  assign has_image = false
  if s.background_image != blank
    assign has_image = true
  endif
-%}

<section
  {% render 'section-attr' %}
  aria-labelledby="{{ title_id }}"
  data-np-newsletter-section
>
  <xo-container>
    <div
      class="np-nl np-nl--{{ s.layout }}{% if has_image %} np-nl--has-image{% endif %}"
      data-np-newsletter
      data-public-key="{{ s.public_api_key | escape }}"
      data-list-id="{{ s.list_id | escape }}"
      data-source="{{ s.custom_source | escape }}"
    >
      {%- if has_image -%}
        <div class="np-nl__bg" aria-hidden="true">
          <img
            src="{{ s.background_image | image_url: width: 2000 }}"
            srcset="{{ s.background_image | image_url: width: 800 }} 800w, {{ s.background_image | image_url: width: 1400 }} 1400w, {{ s.background_image | image_url: width: 2000 }} 2000w"
            sizes="100vw"
            alt=""
            loading="lazy"
            decoding="async"
            width="{{ s.background_image.width }}"
            height="{{ s.background_image.height }}"
          >
          <span class="np-nl__bg-scrim"></span>
        </div>
      {%- endif -%}

      <div class="np-nl__inner">
        <div class="np-nl__content">
          {%- if s.eyebrow != blank -%}
            <span class="np-nl__eyebrow">
              {%- if s.eyebrow_icon != blank -%}
                <span class="np-nl__eyebrow-icon">{% render 'icon', name: s.eyebrow_icon, size: '1.6rem' %}</span>
              {%- endif -%}
              {{ s.eyebrow }}
            </span>
          {%- endif -%}

          <h2 class="np-nl__title" id="{{ title_id }}">{{ s.heading }}</h2>

          {%- if s.subheading != blank -%}
            <div class="np-nl__subtitle">{{ s.subheading }}</div>
          {%- endif -%}

          <form
            class="np-nl__form"
            data-np-form
            novalidate
          >
            <div class="np-nl__field">
              <label class="np-nl__label" for="{{ email_id }}">{{ s.email_label }}</label>
              <input
                class="np-nl__input"
                type="email"
                id="{{ email_id }}"
                name="email"
                inputmode="email"
                autocomplete="email"
                placeholder="{{ s.email_placeholder }}"
                aria-describedby="{{ status_id }}"
                required
              >
              <button class="np-nl__btn" type="submit" data-np-submit>
                <span class="np-nl__btn-label">{{ s.button_label }}</span>
                <span class="np-nl__btn-spinner" aria-hidden="true"></span>
              </button>
            </div>

            {%- if s.fine_print != blank -%}
              <div class="np-nl__fineprint">{{ s.fine_print }}</div>
            {%- endif -%}

            <p class="np-nl__status" id="{{ status_id }}" role="status" aria-live="polite" data-np-status></p>
          </form>

          <div class="np-nl__success" data-np-success hidden tabindex="-1">
            <span class="np-nl__success-icon" aria-hidden="true">{% render 'icon', name: 'check', size: '2.4rem' %}</span>
            <h3 class="np-nl__success-title">{{ s.success_heading }}</h3>
            {%- if s.success_message != blank -%}
              <div class="np-nl__success-text">{{ s.success_message }}</div>
            {%- endif -%}
            {%- if s.success_cta_label != blank and s.success_cta_link != blank -%}
              <a class="np-nl__success-cta" href="{{ s.success_cta_link }}">{{ s.success_cta_label }}</a>
            {%- endif -%}
          </div>

          {%- assign benefit_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}{%- assign benefit_count = benefit_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          {%- if benefit_count > 0 -%}
            <ul class="np-nl__benefits" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'benefit' -%}
                  <li class="np-nl__benefit" {{ block.shopify_attributes }}>
                    <span class="np-nl__benefit-icon" aria-hidden="true">{% render 'icon', name: block.settings.icon, size: '2rem' %}</span>
                    <span class="np-nl__benefit-text">{{ block.settings.text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        {%- assign proof_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'proof' -%}{%- assign proof_count = proof_count | plus: 1 -%}{%- endif -%}
        {%- endfor -%}
        {%- if proof_count > 0 -%}
          <ul class="np-nl__proof" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'proof' -%}
                <li class="np-nl__proof-item" {{ block.shopify_attributes }}>
                  <span class="np-nl__proof-value">{{ block.settings.value }}</span>
                  <span class="np-nl__proof-label">{{ block.settings.label }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </xo-container>
</section>

{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
  }
  @media (max-width: 767px) {
    .xo-section--{{ section.id }} {
      padding-top: {{ s.padding_top | times: 0.7 | round }}px;
      padding-bottom: {{ s.padding_bottom | times: 0.7 | round }}px;
    }
  }
  .xo-section--{{ section.id }} .np-nl__bg-scrim {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, rgba(var(--color-background)) {{ s.overlay_opacity }}%, transparent),
      color-mix(in srgb, rgba(var(--color-background)) {{ s.overlay_opacity | plus: 12 | at_most: 100 }}%, transparent)
    );
  }
{%- endstyle -%}

{% stylesheet %}
  .np-nl {
    position: relative;
    --np-nl-radius: 2.4rem;
    --np-nl-input-radius: 1rem;
    --np-nl-accent: rgba(var(--color-accent));
    --np-nl-line: color-mix(in srgb, rgba(var(--color-foreground)) 14%, transparent);
    --np-nl-muted: color-mix(in srgb, rgba(var(--color-foreground)) 70%, transparent);
  }

  .np-nl__inner { position: relative; z-index: 1; }

  /* Background image (hero) */
  .np-nl__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: var(--np-nl-radius);
  }
  .np-nl__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .np-nl__bg-scrim { position: absolute; inset: 0; }

  /* Eyebrow */
  .np-nl__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    padding: .6rem 1.2rem;
    border-radius: 10rem;
    background: color-mix(in srgb, var(--np-nl-accent) 18%, transparent);
    color: rgba(var(--color-foreground));
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: .02em;
    text-transform: uppercase;
    line-height: 1;
  }
  .np-nl__eyebrow-icon { display: inline-flex; }
  .np-nl__eyebrow-icon svg { display: block; }

  .np-nl__title {
    margin: 0;
    color: rgba(var(--color-foreground));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .np-nl__subtitle {
    color: var(--np-nl-muted);
    line-height: 1.6;
  }
  .np-nl__subtitle > :first-child { margin-top: 0; }
  .np-nl__subtitle > :last-child { margin-bottom: 0; }

  /* Form */
  .np-nl__form { width: 100%; }
  .np-nl__field {
    display: flex;
    gap: 1rem;
    background: rgba(var(--color-background));
    border: 1px solid var(--np-nl-line);
    border-radius: var(--np-nl-input-radius);
    padding: .6rem;
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .np-nl__field:focus-within {
    border-color: var(--np-nl-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--np-nl-accent) 35%, transparent);
  }
  .np-nl__label {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  .np-nl__input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    color: rgba(var(--color-foreground));
    font-size: 1.6rem;
    padding: 0 1.2rem;
    line-height: 1.4;
  }
  .np-nl__input::placeholder { color: color-mix(in srgb, rgba(var(--color-foreground)) 50%, transparent); }
  .np-nl__input:focus { outline: none; }
  .np-nl__input[aria-invalid="true"] { color: rgba(var(--color-error)); }

  .np-nl__btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .8rem;
    min-height: 4.8rem;
    padding: 0 2.4rem;
    border: 0;
    border-radius: calc(var(--np-nl-input-radius) - .4rem);
    background: var(--np-nl-accent);
    color: rgba(var(--color-foreground));
    font-size: 1.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .2s ease, transform .2s ease, opacity .2s ease;
    white-space: nowrap;
  }
  .np-nl__btn:hover { background: color-mix(in srgb, var(--np-nl-accent) 85%, rgba(var(--color-foreground)) 15%); }
  .np-nl__btn:focus-visible { outline: 2px solid rgba(var(--color-foreground)); outline-offset: 2px; }
  .np-nl__btn[aria-busy="true"] { opacity: .75; cursor: progress; }
  .np-nl__btn[aria-busy="true"] .np-nl__btn-label { visibility: hidden; }
  .np-nl__btn[aria-busy="true"] .np-nl__btn-spinner { display: block; }

  .np-nl__btn-spinner {
    display: none;
    position: absolute;
    width: 1.8rem;
    height: 1.8rem;
    border: 2px solid color-mix(in srgb, rgba(var(--color-foreground)) 35%, transparent);
    border-top-color: rgba(var(--color-foreground));
    border-radius: 50%;
    animation: np-nl-spin .7s linear infinite;
  }
  @keyframes np-nl-spin { to { transform: rotate(360deg); } }

  .np-nl__fineprint {
    margin: 1rem 0 0;
    font-size: 1.2rem;
    line-height: 1.5;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
  }
  .np-nl__fineprint a { color: inherit; text-underline-offset: 2px; }

  .np-nl__status {
    margin: 1rem 0 0;
    font-size: 1.35rem;
    line-height: 1.4;
    min-height: 1.4em;
  }
  .np-nl__status[data-state="error"] { color: rgba(var(--color-error)); }
  .np-nl__status:empty { margin: 0; min-height: 0; }

  /* Success */
  .np-nl__success {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .8rem;
  }
  .np-nl__success-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5.2rem;
    height: 5.2rem;
    border-radius: 50%;
    background: color-mix(in srgb, rgba(var(--color-success)) 16%, transparent);
    color: rgba(var(--color-success));
  }
  .np-nl__success-icon svg { display: block; }
  .np-nl__success-title { margin: 0; color: rgba(var(--color-foreground)); font-weight: 600; }
  .np-nl__success-text { color: var(--np-nl-muted); line-height: 1.6; }
  .np-nl__success-text > :first-child { margin-top: 0; }
  .np-nl__success-text > :last-child { margin-bottom: 0; }
  .np-nl__success-cta {
    display: inline-flex;
    align-items: center;
    min-height: 4.4rem;
    padding: 0 2rem;
    margin-top: .4rem;
    border-radius: 10rem;
    background: var(--np-nl-accent);
    color: rgba(var(--color-foreground));
    font-weight: 600;
    text-decoration: none;
  }
  .np-nl__success-cta:hover { background: color-mix(in srgb, var(--np-nl-accent) 85%, rgba(var(--color-foreground)) 15%); }

  /* Benefits */
  .np-nl__benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2.4rem;
  }
  .np-nl__benefit {
    display: inline-flex;
    align-items: center;
    gap: .8rem;
    color: rgba(var(--color-foreground));
    font-size: 1.45rem;
    line-height: 1.3;
  }
  .np-nl__benefit-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--np-nl-accent);
  }
  .np-nl__benefit-icon svg { display: block; }

  /* Proof row */
  .np-nl__proof {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2.4rem 4rem;
  }
  .np-nl__proof-item { display: flex; flex-direction: column; gap: .2rem; }
  .np-nl__proof-value {
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 600;
    line-height: 1;
    color: rgba(var(--color-foreground));
  }
  .np-nl__proof-label {
    font-size: 1.3rem;
    color: var(--np-nl-muted);
    line-height: 1.3;
  }

  /* ---------- HERO layout ---------- */
  .np-nl--hero .np-nl__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
    padding: clamp(3.2rem, 6vw, 6.4rem) clamp(2rem, 5vw, 6rem);
  }
  .np-nl--hero .np-nl__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    width: 100%;
    max-width: 64rem;
  }
  .np-nl--hero .np-nl__title { font-size: clamp(3.2rem, 6vw, 5.6rem); }
  .np-nl--hero .np-nl__subtitle { font-size: clamp(1.6rem, 2.2vw, 1.9rem); max-width: 52rem; }
  .np-nl--hero .np-nl__form { max-width: 52rem; }
  .np-nl--hero .np-nl__fineprint,
  .np-nl--hero .np-nl__status { text-align: center; }
  .np-nl--hero .np-nl__benefits { justify-content: center; }
  .np-nl--hero .np-nl__success { align-items: center; text-align: center; max-width: 52rem; }
  .np-nl--hero .np-nl__proof { justify-content: center; }
  .np-nl--hero.np-nl--has-image .np-nl__inner { background: transparent; }

  /* ---------- BAND layout (homepage) ---------- */
  .np-nl--band .np-nl__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(2.4rem, 4vw, 4.8rem);
    padding: clamp(2.8rem, 4vw, 4rem);
    background: rgba(var(--color-background-2, var(--color-background)));
    border: 1px solid var(--np-nl-line);
    border-radius: var(--np-nl-radius);
  }
  .np-nl--band .np-nl__content { display: flex; flex-direction: column; gap: 1.4rem; }
  .np-nl--band .np-nl__title { font-size: clamp(2.4rem, 3.4vw, 3.6rem); }
  .np-nl--band .np-nl__subtitle { font-size: 1.55rem; }
  .np-nl--band .np-nl__benefits { margin-top: .4rem; }
  .np-nl--band .np-nl__proof { grid-column: 1 / -1; padding-top: 1.2rem; border-top: 1px solid var(--np-nl-line); }

  @media (max-width: 860px) {
    .np-nl--band .np-nl__inner { grid-template-columns: 1fr; }
  }

  @media (max-width: 599px) {
    .np-nl__field { flex-direction: column; padding: 1rem; gap: .8rem; }
    .np-nl__input { padding: 1rem 1.2rem; }
    .np-nl__btn { width: 100%; min-height: 5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .np-nl__btn-spinner { animation-duration: 1.4s; }
    .np-nl__field, .np-nl__btn { transition: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var ENDPOINT = 'https://a.klaviyo.com/client/subscriptions';
    var REVISION = '2026-01-15';
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function init(root) {
      if (root.__npNlBound) return;
      root.__npNlBound = true;

      var form = root.querySelector('[data-np-form]');
      if (!form) return;

      var input = form.querySelector('input[type="email"]');
      var btn = form.querySelector('[data-np-submit]');
      var status = form.querySelector('[data-np-status]');
      var success = root.querySelector('[data-np-success]');
      var publicKey = root.getAttribute('data-public-key');
      var listId = root.getAttribute('data-list-id');
      var source = root.getAttribute('data-source') || 'Website signup form';

      function setStatus(message, state) {
        if (!status) return;
        status.textContent = message || '';
        if (state) {
          status.setAttribute('data-state', state);
        } else {
          status.removeAttribute('data-state');
        }
      }

      function setLoading(isLoading) {
        if (!btn) return;
        if (isLoading) {
          btn.setAttribute('aria-busy', 'true');
          btn.disabled = true;
        } else {
          btn.removeAttribute('aria-busy');
          btn.disabled = false;
        }
      }

      function showSuccess(email) {
        try {
          if (window.klaviyo && typeof window.klaviyo.push === 'function') {
            window.klaviyo.push(['identify', { '$email': email }]);
          }
        } catch (e) {}

        if (success) {
          form.setAttribute('hidden', '');
          success.removeAttribute('hidden');
          try { success.focus(); } catch (e) {}
        } else {
          setStatus('Thanks! Check your inbox to confirm.', 'success');
        }
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();

        var email = (input && input.value ? input.value : '').trim();

        if (!EMAIL_RE.test(email)) {
          if (input) {
            input.setAttribute('aria-invalid', 'true');
            input.focus();
          }
          setStatus('Please enter a valid email address.', 'error');
          return;
        }
        if (input) input.removeAttribute('aria-invalid');

        if (!publicKey || !listId) {
          setStatus('Sign-up is temporarily unavailable. Please try again later.', 'error');
          return;
        }

        setStatus('', null);
        setLoading(true);

        var payload = {
          data: {
            type: 'subscription',
            attributes: {
              custom_source: source,
              profile: {
                data: {
                  type: 'profile',
                  attributes: { email: email }
                }
              }
            },
            relationships: {
              list: { data: { type: 'list', id: listId } }
            }
          }
        };

        fetch(ENDPOINT + '?company_id=' + encodeURIComponent(publicKey), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/vnd.api+json',
            'Accept': 'application/vnd.api+json',
            'revision': REVISION
          },
          body: JSON.stringify(payload)
        })
          .then(function (res) {
            if (res.ok || res.status === 202 || res.status === 204) {
              showSuccess(email);
              return;
            }
            throw new Error('Subscription failed with status ' + res.status);
          })
          .catch(function () {
            setLoading(false);
            setStatus('Something went wrong. Please try again in a moment.', 'error');
          });
      });

      if (input) {
        input.addEventListener('input', function () {
          if (input.getAttribute('aria-invalid') === 'true') {
            input.removeAttribute('aria-invalid');
            setStatus('', null);
          }
        });
      }
    }

    function boot() {
      var roots = document.querySelectorAll('[data-np-newsletter]');
      for (var i = 0; i < roots.length; i++) init(roots[i]);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
    document.addEventListener('shopify:section:load', boot);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "NP • Newsletter Signup",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "hero", "label": "Hero (full page)" },
        { "value": "band", "label": "Band (compact)" }
      ],
      "default": "hero"
    },
    { "type": "header", "content": "Klaviyo" },
    {
      "type": "text",
      "id": "public_api_key",
      "label": "Klaviyo Public API Key (Site ID)",
      "info": "6-character company_id used for the client subscription API.",
      "default": "Y8iBzf"
    },
    {
      "type": "text",
      "id": "list_id",
      "label": "Klaviyo List ID",
      "info": "Profiles are subscribed to this list (triggers your welcome flow).",
      "default": "YzxUyY"
    },
    {
      "type": "text",
      "id": "custom_source",
      "label": "Consent source label",
      "info": "Stored on the Klaviyo consent record.",
      "default": "Newsletter landing page"
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Nootropix Newsletter" },
    { "type": "text", "id": "eyebrow_icon", "label": "Eyebrow icon name", "info": "Theme icon name, e.g. mail, discount, star.", "default": "mail" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Join the list for science-backed stacking tips, restock alerts, and first access to every flash sale.</p>"
    },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "email_label", "label": "Email field label (screen readers)", "default": "Email address" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "you@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get my 10% off" },
    {
      "type": "richtext",
      "id": "fine_print",
      "label": "Fine print / consent",
      "default": "<p>By subscribing you agree to receive marketing emails. Unsubscribe anytime.</p>"
    },
    { "type": "header", "content": "Success state" },
