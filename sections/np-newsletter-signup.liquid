{% comment %}
  NP • Newsletter Signup
  Premium section frame (eyebrow, heading, benefits, proof) wrapping a native
  Klaviyo embedded form. Klaviyo's onsite script is loaded site-wide via the
  app embed, so the form auto-hydrates. Capture + welcome/coupon flow are
  handled in Klaviyo's form + flow editor.
  Layouts: "hero" (full landing page) and "band" (compact, e.g. homepage).
{% endcomment %}

{{ 'np-newsletter-signup.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign title_id = 'np-nl-title-' | append: section.id
  assign has_image = false
  if s.background_image != blank
    assign has_image = true
  endif
-%}

<section
  {% render 'section-attr' %}
  aria-labelledby="{{ title_id }}"
>
  <xo-container>
    <div class="np-nl np-nl--{{ s.layout }}{% if has_image %} np-nl--has-image{% endif %}">
      {%- if has_image -%}
        <div class="np-nl__bg" aria-hidden="true">
          <img
            src="{{ s.background_image | image_url: width: 2000 }}"
            srcset="{{ s.background_image | image_url: width: 800 }} 800w, {{ s.background_image | image_url: width: 1400 }} 1400w, {{ s.background_image | image_url: width: 2000 }} 2000w"
            sizes="100vw"
            alt=""
            loading="lazy"
            decoding="async"
            width="{{ s.background_image.width }}"
            height="{{ s.background_image.height }}"
          >
          <span class="np-nl__bg-scrim"></span>
        </div>
      {%- endif -%}

      <div class="np-nl__inner">
        <div class="np-nl__content">
          {%- if s.show_eyebrow and s.eyebrow != blank -%}
            <span class="np-nl__eyebrow">
              {%- if s.eyebrow_icon != blank -%}
                <span class="np-nl__eyebrow-icon">{% render 'icon', name: s.eyebrow_icon, size: '1.6rem' %}</span>
              {%- endif -%}
              {{ s.eyebrow }}
            </span>
          {%- endif -%}

          {%- if s.show_heading and s.heading != blank -%}
            <h2 class="np-nl__title {{ s.heading_size }}" id="{{ title_id }}">{{ s.heading }}</h2>
          {%- endif -%}

          {%- if s.show_subheading and s.subheading != blank -%}
            <div class="np-nl__subtitle">{{ s.subheading }}</div>
          {%- endif -%}

          {%- if s.klaviyo_form_id != blank -%}
            <div class="np-nl__embed klaviyo-form-{{ s.klaviyo_form_id }}"></div>
          {%- elsif request.design_mode -%}
            <p class="np-nl__embed-missing">Add your Klaviyo embed form ID in the section settings.</p>
          {%- endif -%}

          {%- assign benefit_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}{%- assign benefit_count = benefit_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          {%- if s.show_benefits and benefit_count > 0 -%}
            <ul class="np-nl__benefits" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'benefit' -%}
                  <li class="np-nl__benefit" {{ block.shopify_attributes }}>
                    <span class="np-nl__benefit-icon" aria-hidden="true">{% render 'icon', name: block.settings.icon, size: '2rem' %}</span>
                    <span class="np-nl__benefit-text">{{ block.settings.text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        {%- assign proof_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'proof' -%}{%- assign proof_count = proof_count | plus: 1 -%}{%- endif -%}
        {%- endfor -%}
        {%- if s.show_proof and proof_count > 0 -%}
          <ul class="np-nl__proof" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'proof' -%}
                <li class="np-nl__proof-item" {{ block.shopify_attributes }}>
                  <span class="np-nl__proof-value">{{ block.settings.value }}</span>
                  <span class="np-nl__proof-label">{{ block.settings.label }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </xo-container>
</section>

{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
  }
  @media (max-width: 767px) {
    .xo-section--{{ section.id }} {
      padding-top: {{ s.padding_top | times: 0.7 | round }}px;
      padding-bottom: {{ s.padding_bottom | times: 0.7 | round }}px;
    }
  }
  .xo-section--{{ section.id }} .np-nl__bg-scrim {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, rgba(var(--color-background)) {{ s.overlay_opacity }}%, transparent),
      color-mix(in srgb, rgba(var(--color-background)) {{ s.overlay_opacity | plus: 12 | at_most: 100 }}%, transparent)
    );
  }
{%- endstyle -%}

{% schema %}
{
  "name": "NP • Newsletter Signup",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "hero", "label": "Hero (full page)" },
        { "value": "band", "label": "Band (compact)" }
      ],
      "default": "hero"
    },
    { "type": "header", "content": "Klaviyo embed form" },
    {
      "type": "text",
      "id": "klaviyo_form_id",
      "label": "Klaviyo embed form ID",
      "info": "The ID in <div class=\"klaviyo-form-XXXX\">. Build and style the form (and its welcome/coupon flow) in Klaviyo.",
      "default": "RdVLYF"
    },
    { "type": "header", "content": "Visible elements" },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show eyebrow", "default": true },
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "checkbox", "id": "show_subheading", "label": "Show subheading", "default": true },
    { "type": "checkbox", "id": "show_benefits", "label": "Show benefits list", "default": true },
    { "type": "checkbox", "id": "show_proof", "label": "Show proof stats", "default": true },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Nootropix Newsletter" },
    { "type": "text", "id": "eyebrow_icon", "label": "Eyebrow icon name", "info": "Theme icon name, e.g. mail, discount, star.", "default": "mail" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Join the list for science-backed stacking tips, restock alerts, and first access to every flash sale.</p>"
    },
    { "type": "header", "content": "Background (hero)" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Background scrim opacity", "default": 70 },
    { "type": "header", "content": "Section style" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "color", "id": "background_color", "label": "Background color" },
    { "type": "color_background", "id": "background_gradient", "label": "Background gradient" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon name", "info": "Theme icon name, e.g. check, discount, shipping-fast.", "default": "check" },
        { "type": "text", "id": "text", "label": "Text", "default": "10% off your first order" }
      ]
    },
    {
      "type": "proof",
      "name": "Proof stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "12k+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Subscribers" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NP • Newsletter Signup",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "discount", "text": "10% off your first order" } },
        { "type": "benefit", "settings": { "icon": "shipping-fast", "text": "Restock & flash-sale alerts" } },
        { "type": "benefit", "settings": { "icon": "star", "text": "Science-backed stacking tips" } }
      ]
    }
  ]
}
{% endschema %}
