{%- style -%}
  .xo-section--{{ section.id }} .ksa-cluster__header {
    max-width: 84rem;
    margin: 0 auto 4.8rem;
  }

  .xo-section--{{ section.id }} .ksa-cluster__breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 2rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.4rem;
  }

  .xo-section--{{ section.id }} .ksa-cluster__breadcrumb a {
    color: rgba(var(--color-foreground));
    font-weight: 600;
    text-decoration: none;
  }

  .xo-section--{{ section.id }} .ksa-cluster__back {
    display: inline-flex;
    min-height: 4.4rem;
    align-items: center;
    margin-bottom: 2.4rem;
    color: rgba(var(--color-foreground));
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  .xo-section--{{ section.id }} .ksa-cluster__title {
    margin: 0 0 1.6rem;
    font-size: clamp(3.4rem, 5vw, 7rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .xo-section--{{ section.id }} .ksa-cluster__intro,
  .xo-section--{{ section.id }} .ksa-cluster__body {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
    font-size: 1.6rem;
    line-height: 1.75;
  }

  .xo-section--{{ section.id }} .ksa-cluster__intro {
    margin: 0 0 2.4rem;
  }

  .xo-section--{{ section.id }} .ksa-cluster__body p {
    margin: 0 0 1.6rem;
  }

  .xo-section--{{ section.id }} .ksa-cluster__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 2.4rem;
  }

  .xo-section--{{ section.id }} .ksa-cluster__button {
    display: inline-flex;
    min-height: 4.8rem;
    align-items: center;
    justify-content: center;
    padding: 1.2rem 2.4rem;
    border: 1px solid rgba(var(--color-accent));
    border-radius: 10rem;
    background: rgba(var(--color-accent));
    color: rgba(var(--color-foreground));
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  .xo-section--{{ section.id }} .ksa-cluster__button--secondary {
    border-color: color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
    background: transparent;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .ksa-cluster__steps {
    display: grid;
    gap: 1.2rem;
    margin: 4.8rem 0;
  }

  .xo-section--{{ section.id }} .ksa-cluster__step {
    padding: 2.4rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 18%, transparent);
    border-radius: 2rem;
    background: rgba(var(--color-background-2));
  }

  .xo-section--{{ section.id }} .ksa-cluster__step-title {
    margin: 0 0 0.8rem;
    font-size: 2rem;
    line-height: 1.3;
  }

  .xo-section--{{ section.id }} .ksa-cluster__step-text {
    margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.5rem;
    line-height: 1.65;
  }

  .xo-section--{{ section.id }} .ksa-cluster__shipping {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-desktop-horizontal-spacing);
    margin: 4.8rem 0;
  }

  .xo-section--{{ section.id }} .ksa-cluster__shipping-card {
    padding: 2.4rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 18%, transparent);
    border-radius: 2rem;
    background: rgba(var(--color-background));
  }

  .xo-section--{{ section.id }} .ksa-cluster__shipping-value {
    display: block;
    margin-bottom: 0.8rem;
    font-size: clamp(2.4rem, 3vw, 3.6rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .xo-section--{{ section.id }} .ksa-cluster__shipping-title {
    margin: 0 0 0.8rem;
    font-size: 1.7rem;
  }

  .xo-section--{{ section.id }} .ksa-cluster__shipping-text {
    margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.4rem;
    line-height: 1.65;
  }

  .xo-section--{{ section.id }} .ksa-cluster__faq-title {
    margin: 0 0 2rem;
    font-size: clamp(2.4rem, 3vw, 4rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .xo-section--{{ section.id }} .ksa-cluster__faq-item {
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
  }

  .xo-section--{{ section.id }} .ksa-cluster__faq-item:last-child {
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
  }

  .xo-section--{{ section.id }} .ksa-cluster__faq-question {
    display: flex;
    min-height: 6.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.8rem 0;
    cursor: pointer;
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.4;
    list-style: none;
  }

  .xo-section--{{ section.id }} .ksa-cluster__faq-question::-webkit-details-marker {
    display: none;
  }

  .xo-section--{{ section.id }} .ksa-cluster__faq-answer {
    padding: 0 0 2.4rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
    font-size: 1.5rem;
    line-height: 1.75;
  }

  .xo-section--{{ section.id }} .ksa-cluster__disclaimer {
    margin-top: 3.2rem;
    padding: 1.8rem 2rem;
    border-inline-start: 0.3rem solid rgba(var(--color-accent));
    border-radius: 0 1rem 1rem 0;
    background: rgba(var(--color-background-2));
    font-size: 1.4rem;
    line-height: 1.65;
  }

  .xo-section--{{ section.id }} a:focus-visible,
  .xo-section--{{ section.id }} summary:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .xo-section--{{ section.id }} .ksa-cluster__shipping {
      grid-template-columns: 1fr;
      gap: var(--grid-mobile-vertical-spacing);
    }
  }
{%- endstyle -%}

{%- assign pillar_url = section.settings.pillar_url | default: '/pages/nootropics-ksa' -%}
{%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
{%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
{%- assign collection_url = section.settings.collection.url | default: section.settings.collection_link -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "{{ canonical_url }}#article",
      "headline": {{ section.settings.heading | json }},
      "description": {{ section.settings.intro | strip_html | json }},
      "url": {{ canonical_url | json }},
      "inLanguage": "en",
      "isPartOf": {
        "@type": "WebPage",
        "@id": "{{ shop.url }}{{ pillar_url }}#webpage"
      },
      "publisher": {
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ canonical_url }}#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ section.settings.pillar_label | json }},
          "item": {{ shop.url | append: pillar_url | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ section.settings.breadcrumb_label | json }},
          "item": {{ canonical_url | json }}
        }
      ]
    }
  ]
}
</script>

{%- if faq_blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "{{ canonical_url }}#faq",
    "inLanguage": "en",
    "mainEntity": [
      {%- for block in faq_blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

<section {% render 'section-attr', section: section %} aria-labelledby="ksa-cluster-title-{{ section.id }}">
  <xo-container>
    <header class="ksa-cluster__header">
      <nav class="ksa-cluster__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <a href="{{ pillar_url }}">{{ section.settings.pillar_label }}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ section.settings.breadcrumb_label }}</span>
      </nav>
      <a class="ksa-cluster__back" href="{{ pillar_url }}">{{ section.settings.back_label }}</a>
      <h1 id="ksa-cluster-title-{{ section.id }}" class="ksa-cluster__title">{{ section.settings.heading }}</h1>
      <div class="ksa-cluster__intro">{{ section.settings.intro }}</div>
      {%- if collection_url != blank -%}
        <div class="ksa-cluster__actions">
          <a class="ksa-cluster__button" href="{{ collection_url }}">{{ section.settings.primary_cta_label }}</a>
          <a class="ksa-cluster__button ksa-cluster__button--secondary" href="{{ pillar_url }}">{{ section.settings.secondary_cta_label }}</a>
        </div>
      {%- endif -%}
    </header>

    {%- if section.settings.body != blank -%}
      <div class="ksa-cluster__body">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if step_blocks.size > 0 -%}
      <div class="ksa-cluster__steps">
        {%- for block in step_blocks -%}
          <article class="ksa-cluster__step" {{ block.shopify_attributes }}>
            <h2 class="ksa-cluster__step-title">{{ block.settings.title }}</h2>
            <p class="ksa-cluster__step-text">{{ block.settings.text }}</p>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="ksa-cluster__shipping" aria-label="Shipping to Saudi Arabia">
      {%- for i in (1..3) -%}
        {%- assign value_key = 'shipping_value_' | append: i -%}
        {%- assign title_key = 'shipping_title_' | append: i -%}
        {%- assign text_key = 'shipping_text_' | append: i -%}
        {%- if section.settings[title_key] != blank -%}
          <article class="ksa-cluster__shipping-card">
            <span class="ksa-cluster__shipping-value">{{ section.settings[value_key] }}</span>
            <h2 class="ksa-cluster__shipping-title">{{ section.settings[title_key] }}</h2>
            <p class="ksa-cluster__shipping-text">{{ section.settings[text_key] }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if faq_blocks.size > 0 -%}
      <section aria-labelledby="ksa-cluster-faq-{{ section.id }}">
        <h2 id="ksa-cluster-faq-{{ section.id }}" class="ksa-cluster__faq-title">{{ section.settings.faq_heading }}</h2>
        {%- for block in faq_blocks -%}
          <details class="ksa-cluster__faq-item" {{ block.shopify_attributes }}>
            <summary class="ksa-cluster__faq-question">{{ block.settings.question }}</summary>
            <div class="ksa-cluster__faq-answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </section>
    {%- endif -%}

    <aside class="ksa-cluster__disclaimer" role="note">{{ section.settings.disclaimer }}</aside>
  </xo-container>
</section>

{% schema %}
{
  "name": "KSA cluster page",
  "tag": "section",
  "class": "section-ksa-cluster",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "pillar_label", "label": "Pillar breadcrumb label", "default": "Nootropics KSA" },
    { "type": "url", "id": "pillar_url", "label": "Pillar URL" },
    { "type": "text", "id": "breadcrumb_label", "label": "Current page breadcrumb label", "default": "Cluster page" },
    { "type": "text", "id": "back_label", "label": "Back link label", "default": "Back to Nootropics KSA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "KSA cluster page" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "url", "id": "collection_link", "label": "Fallback collection link" },
    { "type": "text", "id": "primary_cta_label", "label": "Primary CTA label", "default": "Explore category" },
    { "type": "text", "id": "secondary_cta_label", "label": "Secondary CTA label", "default": "View Nootropics KSA hub" },
    { "type": "text", "id": "shipping_value_1", "label": "Shipping card 1 value", "default": "Same day" },
    { "type": "text", "id": "shipping_title_1", "label": "Shipping card 1 title", "default": "Order dispatch" },
    { "type": "textarea", "id": "shipping_text_1", "label": "Shipping card 1 text", "default": "Orders are prepared and shipped from Dubai within the same day." },
    { "type": "text", "id": "shipping_value_2", "label": "Shipping card 2 value", "default": "3–5 days" },
    { "type": "text", "id": "shipping_title_2", "label": "Shipping card 2 title", "default": "Average delivery" },
    { "type": "textarea", "id": "shipping_text_2", "label": "Shipping card 2 text", "default": "Express delivery to Saudi Arabia takes 3–5 business days on average. Timing can vary by destination and order timing." },
    { "type": "text", "id": "shipping_value_3", "label": "Shipping card 3 value", "default": "SAR 300+" },
    { "type": "text", "id": "shipping_title_3", "label": "Shipping card 3 title", "default": "Free express shipping" },
    { "type": "textarea", "id": "shipping_text_3", "label": "Shipping card 3 text", "default": "Express shipping is free when the order value reaches SAR 300." },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Common questions" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "Educational information only. This is not medical advice. Follow the product label and speak with a qualified healthcare professional if you have a medical condition, are pregnant or nursing, or take medication." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "KSA cluster page"
    }
  ]
}
{% endschema %}
