{% render 'nx01-launch-css' %}

<section
  id="nx01-volume"
  class="nx01 nx01-volume xo-section xo-section--{{ section.id }}{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  aria-labelledby="nx01-volume-heading-{{ section.id }}"
>
  <div class="nx01__inner">
    <div class="nx01__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nx01__label">
          <span class="nx01__label-rule" aria-hidden="true"></span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="nx01__heading" id="nx01-volume-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="nx01__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="nx01-volume__split">
      <div class="nx01-volume__graphic">
        <div class="nx01-volume__col">
          {%- if section.settings.one_label != blank -%}
            <p class="nx01-volume__cap">{{ section.settings.one_label | escape }}</p>
          {%- endif -%}
          <div class="nx01-volume__pill nx01-volume__pill--single" aria-hidden="true">
            <span class="nx01-volume__fill nx01-volume__fill--low"></span>
          </div>
          {%- if section.settings.one_value != blank -%}
            <p class="nx01-volume__value">{{ section.settings.one_value | escape }}</p>
          {%- endif -%}
          {%- if section.settings.one_note != blank -%}
            <p class="nx01-volume__note">{{ section.settings.one_note | escape }}</p>
          {%- endif -%}
        </div>
        <p class="nx01-volume__vs">{{ 'sections.nx01_launch_volume.vs' | t }}</p>
        <div class="nx01-volume__col nx01-volume__col--nx">
          {%- if section.settings.three_label != blank -%}
            <p class="nx01-volume__cap">{{ section.settings.three_label | escape }}</p>
          {%- endif -%}
          <div class="nx01-volume__pills" aria-hidden="true">
            <span class="nx01-volume__pill"><span class="nx01-volume__fill"></span></span>
            <span class="nx01-volume__pill"><span class="nx01-volume__fill"></span></span>
            <span class="nx01-volume__pill"><span class="nx01-volume__fill"></span></span>
          </div>
          {%- if section.settings.three_value != blank -%}
            <p class="nx01-volume__value">{{ section.settings.three_value | escape }}</p>
          {%- endif -%}
          {%- if section.settings.three_note != blank -%}
            <p class="nx01-volume__note">{{ section.settings.three_note | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      <div class="nx01-volume__copy">
        {%- if section.settings.statement != blank -%}
          <p class="nx01-volume__statement">{{ section.settings.statement | escape }}</p>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="nx01-volume__body">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  .nx01-volume__split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4.8rem;
    align-items: center;
  }

  .nx01-volume__graphic {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2.4rem;
    padding: 4rem 2.4rem;
    background: rgb(var(--nx01-surface));
    border-radius: var(--nx01-radius);
  }

  .nx01-volume__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
    text-align: center;
    min-width: 16rem;
  }

  .nx01-volume__col--nx {
    padding: 2.4rem;
    border-radius: var(--nx01-radius);
  }

  .nx01-volume__cap {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nx01-volume__vs {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 600;
  }

  .nx01-volume__pill {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 5.6rem;
    height: 12rem;
    padding: 0.3rem;
    border: 0.2rem solid rgb(var(--nx01-ink));
    border-radius: 2.8rem;
  }

  .nx01-volume__pill--single {
    width: 9rem;
    height: 18rem;
    border-radius: 4.5rem;
    padding: 0.4rem;
    border-color: rgb(var(--nx01-ink));
  }

  .nx01-volume__pills {
    display: flex;
    gap: 1.2rem;
  }

  .nx01-volume__fill {
    display: block;
    width: 100%;
    height: 5rem;
    border-radius: 0.2rem 0.2rem 2.4rem 2.4rem;
    background: rgb(var(--nx01-ink));
    opacity: 0.8;
  }

  .nx01-volume__fill--low {
    height: 7rem;
    background: rgb(var(--nx01-ink));
    opacity: 0.2;
    border-radius: 0.4rem 0.4rem 4rem 4rem;
  }

  .nx01-volume__value,
  .nx01-volume__note,
  .nx01-volume__statement {
    margin: 0;
  }

  .nx01-volume__value {
    font-size: 1.4rem;
    font-weight: 600;
  }

  .nx01-volume__note {
    font-size: 1.2rem;
  }

  .nx01-volume__statement {
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .nx01-volume__body {
    margin-top: 2.4rem;
    font-size: 1.5rem;
    line-height: 1.7;
    color: rgb(var(--nx01-body));
  }

  .nx01-volume__body p {
    margin: 0 0 2.4rem;
  }

  .nx01-volume__body p:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 990px) {
    .nx01-volume__split {
      grid-template-columns: minmax(0, 64rem) minmax(0, 1fr);
      gap: 8rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "NX-01 launch volume",
  "tag": "section",
  "class": "section-nx01-volume",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "06 · Volumetric Integrity" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Because meaningful amounts take space." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Many formulations compress active ingredients to fit inside a single pill. To provide truly active clinical amounts, we refuse to compromise." },
    { "type": "text", "id": "statement", "label": "Statement", "default": "We chose formula integrity over a smaller serving count." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Packing 9 highly active, water-soluble bio-factors into a single standard capsule is physical impossibility unless you decrease dosages to ineffective levels.</p><p>To preserve full therapeutic synergy — matching the strict physiological benchmarks established in clinical research — NX-01 relies on exactly three daily capsules. Take them with water, work without lag.</p>" },
    { "type": "text", "id": "one_label", "label": "One-capsule label", "default": "1 capsule limit" },
    { "type": "text", "id": "one_value", "label": "One-capsule value", "default": "~650mg Max Capacity" },
    { "type": "text", "id": "one_note", "label": "One-capsule note", "default": "Requires trace dosages" },
    { "type": "text", "id": "three_label", "label": "Three-capsule label", "default": "NX-01 serving" },
    { "type": "text", "id": "three_value", "label": "Three-capsule value", "default": "1950mg Active Servings" },
    { "type": "text", "id": "three_note", "label": "Three-capsule note", "default": "No micro-dosing shortcuts" }
  ],
  "presets": [
    { "name": "NX-01 launch volume" }
  ]
}
{% endschema %}
