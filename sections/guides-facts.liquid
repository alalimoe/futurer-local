{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .xo-section--{{ section.id }} .gf-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 0;
    margin: 0;
    padding: 2.4rem 0;
    list-style: none;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 70%, transparent);
    text-align: center;
  }

  .xo-section--{{ section.id }} .gf-item:not(:last-child)::after {
    content: '·';
    margin: 0 1.4rem;
    font-weight: 400;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 35%, transparent);
  }
{%- endstyle -%}

<section {% render 'section-attr' %}>
  <xo-container>
    {%- assign facts_raw = section.settings.facts | replace: ',', '|' -%}
    {%- assign facts = facts_raw | split: '|' -%}
    {%- if facts.size > 0 -%}
      <ul class="gf-list">
        {%- for fact in facts -%}
          {%- assign trimmed = fact | strip -%}
          {%- if trimmed != blank -%}
            <li class="gf-item">{{ trimmed | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </xo-container>
</section>

{% schema %}
{
  "name": "Guides facts",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay", "custom.popups", "custom.features"]
  },
  "settings": [
    { "type": "textarea", "id": "facts", "label": "Facts", "info": "Separate with | or commas", "default": "COA on page | Evidence-based dosing | Same-day Dubai dispatch" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 24 }
  ],
  "presets": [{ "name": "Guides facts" }]
}
{% endschema %}
