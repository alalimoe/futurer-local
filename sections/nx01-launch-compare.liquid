{%- liquid
  assign diy_image = section.settings.diy_image
  assign nx01_image = section.settings.nx01_image
  assign compound_count = 0
  assign note_count = 0
  assign point_count = 0
  for block in section.blocks
    if block.type == 'compound' and block.settings.label != blank
      assign compound_count = compound_count | plus: 1
    endif
    if block.type == 'note' and block.settings.label != blank
      assign note_count = note_count | plus: 1
    endif
    if block.type == 'point' and block.settings.label != blank or block.settings.value != blank
      assign point_count = point_count | plus: 1
    endif
  endfor
  assign show_cta = false
  if section.settings.cta_label != blank and section.settings.cta_href != blank
    assign show_cta = true
  endif
  assign nx01_anchor = section.settings.anchor_id | default: 'nx01-compare' | handleize
  assign nx01_intro_class = 'nx01__intro nx01__intro--center'
  if section.settings.heading_alignment == 'left'
    assign nx01_intro_class = 'nx01__intro'
  endif
  assign vs_label = section.settings.vs_label | default: 'vs'
  assign left_stat_label = section.settings.left_stat_label | default: 'separate bottles'
  assign right_stat = section.settings.right_stat | default: '1'
  assign right_stat_label = section.settings.right_stat_label | default: 'daily formula'
-%}

{% render 'nx01-launch-css' %}

<section
  id="{{ nx01_anchor }}"
  class="nx01 nx01-compare xo-section xo-section--{{ section.id }}{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  style="{% if section.settings.padding_top != blank %}--nx01-pad-block-start: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom != blank %} --nx01-pad-block-end: {{ section.settings.padding_bottom }}px;{% endif %}"
  aria-labelledby="nx01-compare-heading-{{ section.id }}"
>
  <div class="nx01__inner nx01-compare__inner">
    <div class="{{ nx01_intro_class }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nx01__label">
          <span class="nx01__label-rule" aria-hidden="true"></span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="nx01__heading" id="nx01-compare-heading-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="nx01__sub">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>

    <div class="nx01-compare__board" aria-label="{{ 'sections.nx01_launch_compare.board_label' | t }}">
      <article class="nx01-compare__pane nx01-compare__pane--many">
        {%- if compound_count > 0 -%}
          <p class="nx01-compare__stat">
            <span class="nx01-compare__stat-value">{{ compound_count }}</span>
            <span class="nx01-compare__stat-label">{{ left_stat_label | escape }}</span>
          </p>
        {%- endif -%}
        <header class="nx01-compare__pane-head">
          {%- if section.settings.left_kicker != blank -%}
            <p class="nx01-compare__protocol">{{ section.settings.left_kicker | escape }}</p>
          {%- endif -%}
          <h3 class="nx01-compare__pane-title{% if section.settings.left_label_mobile != blank %} nx01-compare__pane-title--split{% endif %}">
            <span class="nx01-compare__kicker-full">{{ section.settings.left_label | escape }}</span>
            {%- if section.settings.left_label_mobile != blank -%}
              <span class="nx01-compare__kicker-short">{{ section.settings.left_label_mobile | escape }}</span>
            {%- endif -%}
          </h3>
        </header>

        {%- if diy_image != blank -%}
          <div class="nx01-compare__media">
            {{
              diy_image
              | image_url: width: 900
              | image_tag:
                class: 'nx01-compare__img',
                loading: 'lazy',
                widths: '360, 540, 720, 900',
                sizes: '(max-width: 767px) min(280px, 88vw), 280px',
                alt: section.settings.diy_alt,
                width: diy_image.width,
                height: diy_image.height,
                decoding: 'async'
            }}
          </div>
        {%- endif -%}

        {%- if compound_count > 0 -%}
          <ul class="nx01-compare__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'compound' and block.settings.label != blank -%}
                <li {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.left_note != blank -%}
          <p class="nx01-compare__footer">{{ section.settings.left_note | escape }}</p>
        {%- elsif note_count > 0 -%}
          <p class="nx01-compare__footer">
            {%- assign note_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'note' and block.settings.label != blank -%}
                {%- if note_index > 0 %} · {% endif -%}
                <span {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</span>
                {%- assign note_index = note_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </p>
        {%- endif -%}
      </article>

      <p class="nx01-compare__vs">{{ vs_label | escape }}</p>

      <article class="nx01-compare__pane nx01-compare__pane--nx">
        <p class="nx01-compare__stat">
          <span class="nx01-compare__stat-value">{{ right_stat | escape }}</span>
          <span class="nx01-compare__stat-label">{{ right_stat_label | escape }}</span>
        </p>
        <header class="nx01-compare__pane-head">
          <div class="nx01-compare__pane-row">
            {%- if section.settings.right_kicker != blank -%}
              <p class="nx01-compare__protocol">{{ section.settings.right_kicker | escape }}</p>
            {%- endif -%}
            {%- if section.settings.badge != blank -%}
              <span class="nx01-compare__badge">{{ section.settings.badge | escape }}</span>
            {%- endif -%}
          </div>
          {%- if section.settings.right_label != blank -%}
            <h3 class="nx01-compare__pane-title">{{ section.settings.right_label | escape }}</h3>
          {%- endif -%}
        </header>

        {%- if nx01_image != blank -%}
          <div class="nx01-compare__media">
            {{
              nx01_image
              | image_url: width: 720
              | image_tag:
                class: 'nx01-compare__img nx01-compare__img--single',
                loading: 'lazy',
                widths: '240, 360, 540, 720',
                sizes: '120px',
                alt: section.settings.nx01_alt,
                width: nx01_image.width,
                height: nx01_image.height,
                decoding: 'async'
            }}
          </div>
        {%- endif -%}

        {%- if point_count > 0 -%}
          <ul class="nx01-compare__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'point' -%}
                {%- if block.settings.value != blank or block.settings.label != blank -%}
                  <li {{ block.shopify_attributes }}>
                    {%- if block.settings.value != blank and block.settings.label != blank -%}
                      {{ block.settings.value | escape }} {{ block.settings.label | escape }}
                    {%- elsif block.settings.label != blank -%}
                      {{ block.settings.label | escape }}
                    {%- else -%}
                      {{ block.settings.value | escape }}
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.right_note != blank -%}
          <p class="nx01-compare__footer">{{ section.settings.right_note | escape }}</p>
        {%- endif -%}
      </article>
    </div>

    {%- if section.settings.highlight != blank or show_cta -%}
      <div class="nx01-compare__close">
        {%- if section.settings.highlight != blank -%}
          <p class="nx01-compare__highlight">{{ section.settings.highlight | escape }}</p>
        {%- endif -%}
        {%- if show_cta -%}
          <div class="nx01-compare__cta">
            {% render 'button', style: 'primary', text: section.settings.cta_label, link: section.settings.cta_href %}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  .nx01-compare__board {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
  }

  .nx01-compare__pane {
    display: flex;
    flex-direction: column;
    gap: 3.2rem;
    min-width: 0;
    padding: 2.4rem;
    background: rgb(var(--nx01-surface));
    border: 0.1rem solid rgb(var(--nx01-rule));
    border-radius: 0.8rem;
  }

  .nx01-compare__pane--many {
    background: rgb(var(--nx01-field));
    border-color: rgb(var(--nx01-line));
  }

  .nx01-compare__pane--nx {
    border-color: rgb(var(--nx01-navy));
  }

  .nx01-compare__stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0;
  }

  .nx01-compare__stat-value {
    font-family: var(--font-heading-family);
    font-size: clamp(4.8rem, 8vw, 7.2rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
    color: rgb(var(--nx01-muted));
  }

  .nx01-compare__pane--nx .nx01-compare__stat-value {
    color: rgb(var(--nx01-navy));
  }

  .nx01-compare__stat-label {
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.3;
    color: rgb(var(--nx01-ink));
  }

  .nx01-compare__vs {
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    width: 4.8rem;
    height: 4.8rem;
    margin: 0;
    background: rgb(var(--nx01-surface));
    border: 0.1rem solid rgb(var(--nx01-line));
    border-radius: 50%;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--nx01-navy-deep));
  }

  .nx01-compare__pane-head {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .nx01-compare__pane-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
  }

  .nx01-compare__protocol {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--nx01-ink));
  }

  .nx01-compare__pane-title {
    margin: 0;
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .nx01-compare__pane-title--split .nx01-compare__kicker-full {
    display: none;
  }

  .nx01-compare__badge {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0.4rem 1rem;
    border: 0.1rem solid rgb(var(--nx01-navy-deep));
    border-radius: var(--nx01-radius);
    font-size: 1.1rem;
    font-weight: 600;
    color: rgb(var(--nx01-navy-deep));
  }

  .nx01-compare__media {
    display: flex;
    align-items: flex-end;
  }

  .nx01-compare__img {
    display: block;
    width: 100%;
    max-width: 28rem;
    height: auto;
    object-fit: contain;
  }

  .nx01-compare__img--single {
    max-width: 12rem;
  }

  .nx01-compare__list {
    margin: 0;
    padding: 3.2rem 0 0;
    list-style: none;
    border-top: 0.1rem solid rgb(var(--nx01-rule));
  }

  .nx01-compare__list li {
    position: relative;
    padding-block: 0.8rem;
    padding-inline-start: 1.8rem;
    font-size: 1.5rem;
    line-height: 1.4;
    color: rgb(var(--nx01-ink));
  }

  .nx01-compare__list li::before {
    content: "";
    position: absolute;
    top: 1.4rem;
    inset-inline-start: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: rgb(var(--nx01-ink));
  }

  .nx01-compare__footer {
    margin: 0;
    padding-top: 3.2rem;
    border-top: 0.1rem solid rgb(var(--nx01-rule));
    font-size: 1.3rem;
    line-height: 1.4;
    color: rgb(var(--nx01-muted));
  }

  .nx01-compare__close {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.4rem;
    margin-top: 6.4rem;
    text-align: center;
  }

  .nx01-compare__highlight {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 500;
  }

  @media screen and (min-width: 990px) {
    .nx01-compare__board {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: stretch;
      gap: 2.4rem;
    }

    .nx01-compare__vs {
      align-self: center;
    }

    .nx01-compare__pane {
      padding: 4rem;
    }

    .nx01-compare__kicker-short {
      display: none;
    }

    .nx01-compare__pane-title--split .nx01-compare__kicker-full {
      display: inline;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.nx01_launch_compare.name",
  "tag": "section",
  "class": "section-nx01-compare",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.nx01_launch_compare.settings.color_scheme",
      "default": "background-1"
    },
    { "type": "header", "content": "Reuse" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Optional in-page link target. Leave blank to keep nx01-compare." },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "center" },
    { "type": "range", "id": "padding_top", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding bottom", "default": 48 },
    { "type": "text", "id": "vs_label", "label": "Versus label", "default": "vs" },
    { "type": "text", "id": "left_stat_label", "label": "Left count label", "default": "separate bottles" },
    { "type": "text", "id": "right_stat", "label": "Right count", "default": "1" },
    { "type": "text", "id": "right_stat_label", "label": "Right count label", "default": "daily formula" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Comparison Architecture"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.nx01_launch_compare.settings.heading",
      "default": "Separate bottles, or one formula."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Same kinds of ingredients. Different number of things to manage."
    },
    {
      "type": "text",
      "id": "left_kicker",
      "label": "Left protocol label",
      "default": "Protocol A"
    },
    {
      "type": "text",
      "id": "left_label",
      "label": "t:sections.nx01_launch_compare.settings.left_label",
      "default": "Build It Yourself"
    },
    {
      "type": "text",
      "id": "left_label_mobile",
      "label": "t:sections.nx01_launch_compare.settings.left_label_mobile",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "left_note",
      "label": "Left footer note",
      "default": "7+ bottles · separate reorders · fragmented schedule"
    },
    {
      "type": "text",
      "id": "right_kicker",
      "label": "Right protocol label",
      "default": "Protocol B"
    },
    {
      "type": "text",
      "id": "right_label",
      "label": "t:sections.nx01_launch_compare.settings.right_label",
      "default": "NX-01 Baseline"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Right badge",
      "default": "Consolidated"
    },
    {
      "type": "text",
      "id": "right_note",
      "label": "Right footer note",
      "default": "1 bottle · single monthly subscription · zero daily decisions"
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "t:sections.nx01_launch_compare.settings.highlight",
      "default": "Same foundation. Less friction."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.nx01_launch_compare.settings.cta_label",
      "default": "See What’s Inside"
    },
    {
      "type": "text",
      "id": "cta_href",
      "label": "t:sections.nx01_launch_compare.settings.cta_href",
      "default": "#nx01-formula",
      "info": "t:sections.nx01_launch_compare.settings.href_info"
    },
    {
      "type": "header",
      "content": "t:sections.nx01_launch_compare.settings.images_header"
    },
    {
      "type": "image_picker",
      "id": "diy_image",
      "label": "t:sections.nx01_launch_compare.settings.diy_image",
      "info": "t:sections.nx01_launch_compare.settings.cutout_info"
    },
    {
      "type": "text",
      "id": "diy_alt",
      "label": "t:sections.nx01_launch_compare.settings.diy_alt"
    },
    {
      "type": "image_picker",
      "id": "nx01_image",
      "label": "t:sections.nx01_launch_compare.settings.nx01_image",
      "info": "t:sections.nx01_launch_compare.settings.cutout_info"
    },
    {
      "type": "text",
      "id": "nx01_alt",
      "label": "t:sections.nx01_launch_compare.settings.nx01_alt"
    }
  ],
  "blocks": [
    {
      "type": "compound",
      "name": "t:sections.nx01_launch_compare.blocks.compound.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.nx01_launch_compare.blocks.compound.settings.label",
          "default": "Acetyl-L-Carnitine"
        }
      ]
    },
    {
      "type": "note",
      "name": "t:sections.nx01_launch_compare.blocks.note.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.nx01_launch_compare.blocks.note.settings.label",
          "default": "Multiple bottles"
        }
      ]
    },
    {
      "type": "point",
      "name": "t:sections.nx01_launch_compare.blocks.point.name",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.nx01_launch_compare.blocks.point.settings.value"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.nx01_launch_compare.blocks.point.settings.label",
          "default": "9 Active ingredients at physiological synergy"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "t:sections.nx01_launch_compare.presets.name",
      "blocks": [
        { "type": "compound", "settings": { "label": "Acetyl-L-Carnitine (ALCAR)" } },
        { "type": "compound", "settings": { "label": "CDP-Choline (Citicoline)" } },
        { "type": "compound", "settings": { "label": "Nicotinamide Mononucleotide (NMN)" } },
        { "type": "compound", "settings": { "label": "L-Theanine" } },
        { "type": "compound", "settings": { "label": "Rhodiola rosea (3% Salidroside)" } },
        { "type": "compound", "settings": { "label": "Ubiquinol CoQ10" } },
        { "type": "compound", "settings": { "label": "Active B Vitamins (B12, Folate, B6)" } },
        { "type": "point", "settings": { "label": "9 Active ingredients at physiological synergy" } },
        { "type": "point", "settings": { "label": "3 capsule single daily serving size" } },
        { "type": "point", "settings": { "label": "Zero fillers, binders, or trade secret blends" } },
        { "type": "point", "settings": { "label": "Caffeine-free design allows anytime routine placement" } },
        { "type": "point", "settings": { "label": "One simplified bottle replacement" } },
        { "type": "point", "settings": { "label": "30-day comprehensive supply" } }
      ]
    }
  ]
}
{% endschema %}
