{% render 'compound-guide-css' %}

{%- liquid
  assign cg_anchor = section.settings.anchor_id | default: 'compound-quality' | handleize
  assign doc_count = 0
  assign product_options = ''
  assign batch_options = ''
  assign product_keys = '|'
  assign batch_keys = '|'
  for block in section.blocks
    if block.type == 'document' and block.settings.product != blank
      assign document_product = block.settings.product
      assign document_status = document_product.metafields.pep.coa_status.value | default: document_product.metafields.pep.coa_status | downcase
      assign document_url = document_product.metafields.pdp.coa_url.value | default: document_product.metafields.pdp.coa_url
      assign document_pdf = document_product.metafields.pep.coa_pdf
      assign document_files = document_product.metafields.peptide.coa_file
      if document_url == blank and document_pdf.value.url != blank
        assign document_url = document_pdf.value.url
      endif
      if document_url == blank and document_files.value.first.url != blank
        assign document_url = document_files.value.first.url
      endif
      unless document_status == 'hidden' or document_status == 'pending'
        if document_url != blank
          assign doc_count = doc_count | plus: 1
          assign product_key = '|' | append: document_product.handle | append: '|'
          unless product_keys contains product_key
            assign product_keys = product_keys | append: document_product.handle | append: '|'
            assign product_options = product_options | append: document_product.handle | append: '::' | append: document_product.title | append: '||'
          endunless
          assign document_batch = document_product.metafields.pep.coa_batch.value | default: document_product.metafields.pep.coa_batch
          if document_batch != blank
            assign batch_handle = document_batch | handleize
            assign batch_key = '|' | append: batch_handle | append: '|'
            unless batch_keys contains batch_key
              assign batch_keys = batch_keys | append: batch_handle | append: '|'
              assign batch_options = batch_options | append: batch_handle | append: '::' | append: document_batch | append: '||'
            endunless
          endif
        endif
      endunless
    endif
  endfor
  assign product_list = product_options | split: '||'
  assign batch_list = batch_options | split: '||'
  assign show_request = false
  if section.settings.request_label != blank
    assign show_request = true
  endif
-%}

{%- if section.settings.heading != blank or doc_count > 0 or section.settings.library_label != blank -%}
<section
  id="{{ cg_anchor }}"
  {% render 'compound-section-attrs', section: section, base: 'cg-quality' %}
  data-cg-quality
  aria-labelledby="cg-quality-heading-{{ section.id }}"
>
  <div class="cg__inner">
    <div class="cg__intro">
      {%- if section.settings.kicker != blank -%}
        <p class="cg__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cg__heading" id="cg-quality-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="cg__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if doc_count > 0 -%}
      {%- assign product_choice_count = 0 -%}
      {%- for option in product_list -%}
        {%- if option != blank -%}
          {%- assign product_choice_count = product_choice_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign batch_choice_count = 0 -%}
      {%- for option in batch_list -%}
        {%- if option != blank -%}
          {%- assign batch_choice_count = batch_choice_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      <div class="cg-quality__viewer{% if product_choice_count < 2 and batch_choice_count < 2 %} cg-quality__viewer--single{% endif %}">
        {%- if product_choice_count > 1 or batch_choice_count > 1 -%}
          <div class="cg-quality__controls">
            {%- if product_choice_count > 1 -%}
              <label>
                {{ 'sections.compound_guide.document_product' | t }}
                <select data-cg-doc-product>
                  <option value="">{{ 'sections.compound_guide.filter_all' | t }}</option>
                  {%- for option in product_list -%}
                    {%- if option != blank -%}
                      {%- assign option_parts = option | split: '::' -%}
                      <option value="{{ option_parts.first | escape }}">{{ option_parts.last | escape }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              </label>
            {%- endif -%}
            {%- if batch_choice_count > 1 -%}
              <label>
                {{ 'sections.compound_guide.document_batch' | t }}
                <select data-cg-doc-batch>
                  <option value="">{{ 'sections.compound_guide.filter_all' | t }}</option>
                  {%- for option in batch_list -%}
                    {%- if option != blank -%}
                      {%- assign option_parts = option | split: '::' -%}
                      <option value="{{ option_parts.first | escape }}">{{ option_parts.last | escape }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              </label>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div>
          {%- assign rendered_doc_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'document' and block.settings.product != blank -%}
              {%- liquid
                assign document_product = block.settings.product
                assign document_status = document_product.metafields.pep.coa_status.value | default: document_product.metafields.pep.coa_status | downcase
                assign doc_url = document_product.metafields.pdp.coa_url.value | default: document_product.metafields.pdp.coa_url
                assign document_pdf = document_product.metafields.pep.coa_pdf
                assign document_files = document_product.metafields.peptide.coa_file
                if doc_url == blank and document_pdf.value.url != blank
                  assign doc_url = document_pdf.value.url
                endif
                if doc_url == blank and document_files.value.first.url != blank
                  assign doc_url = document_files.value.first.url
                endif
                assign document_batch = document_product.metafields.pep.coa_batch.value | default: document_product.metafields.pep.coa_batch
                assign document_image = document_product.metafields.pdp.coa_image.value
                assign preview_alt = document_product.metafields.pdp.coa_alt.value | default: document_product.title
                assign render_document = false
                unless document_status == 'hidden' or document_status == 'pending'
                  if doc_url != blank
                    assign render_document = true
                  endif
                endunless
              -%}
              {%- if render_document -%}
              {%- assign rendered_doc_count = rendered_doc_count | plus: 1 -%}
              <article
                class="cg-quality__doc{% if rendered_doc_count == 1 %} is-active{% endif %}"
                data-cg-doc
                data-product="{{ document_product.handle | escape }}"
                data-batch="{{ document_batch | handleize }}"
                {{ block.shopify_attributes }}
              >
                {%- if section.settings.show_preview and document_image != blank -%}
                  <a href="{{ doc_url }}" target="_blank" rel="noopener">
                    {{
                      document_image
                      | image_url: width: 720
                      | image_tag:
                        widths: '240, 360, 480, 720',
                        sizes: '(max-width: 767px) 72vw, 24rem',
                        alt: preview_alt,
                        width: document_image.width,
                        height: document_image.height,
                        loading: 'lazy',
                        decoding: 'async'
                    }}
                  </a>
                {%- endif -%}
                <div class="cg-quality__doc-body">
                  <h3>{{ document_product.title | escape }}</h3>
                  {%- if section.settings.show_stats and document_batch != blank -%}
                    <dl class="cg-quality__stats">
                      <div class="cg-quality__stat">
                        <dt>{{ 'sections.compound_guide.document_batch' | t }}</dt>
                        <dd>{{ document_batch | escape }}</dd>
                      </div>
                    </dl>
                  {%- endif -%}
                  <a class="cg__text-link" href="{{ doc_url }}" target="_blank" rel="noopener">{{ 'sections.compound_guide.view_report' | t }}</a>
                </div>
              </article>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <p class="cg-quality__empty" data-cg-doc-empty hidden>{{ 'sections.compound_guide.document_empty' | t }}</p>
        </div>
      </div>
    {%- else -%}
      <p class="cg-quality__empty">{{ 'sections.compound_guide.document_empty' | t }}</p>
    {%- endif -%}

    {%- if section.settings.show_disclaimer and doc_count > 0 -%}
      <p class="cg-quality__disclaimer">Open each linked document to review its identified product, batch and test scope.</p>
    {%- endif -%}

    <div class="cg-quality__actions">
      {%- if section.settings.library_label != blank and section.settings.library_href != blank -%}
        {% render 'button', style: 'secondary', text: section.settings.library_label, link: section.settings.library_href %}
      {%- endif -%}
    </div>

    {%- if show_request -%}
      {%- assign request_id = 'cg-doc-request-' | append: section.id -%}
      {% form 'contact', id: request_id, class: 'cg-card__restock' %}
        <input type="hidden" name="contact[tags]" value="compound-guide, document-request, page-{{ page.handle | escape }}">
        <input type="hidden" name="contact[request_type]" value="Product or batch document">
        <input type="hidden" name="contact[body]" value="{{ 'sections.compound_guide.document_request_message' | t: product: page.title | escape }}">
        {%- if form.posted_successfully? -%}
          <p role="status">{{ 'sections.compound_guide.document_request_success' | t }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="cg-form__errors" id="{{ request_id }}-errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          <p class="cg-form__notice" id="{{ request_id }}-notice">This request is transactional only and does not subscribe you to marketing.</p>
          <label class="visually-hidden" for="{{ request_id }}-email">{{ 'sections.compound_guide.restock_email' | t }}</label>
          <input
            id="{{ request_id }}-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            required
            placeholder="{{ 'sections.compound_guide.restock_email' | t }}"
            aria-describedby="{{ request_id }}-notice{% if form.errors %} {{ request_id }}-errors{% endif %}"
            {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
          >
          <button class="xo-btn xo-btn--secondary" type="submit">{{ section.settings.request_label | escape }}</button>
        {%- endif -%}
      {% endform %}
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Compound quality",
  "tag": "section",
  "class": "section-compound-quality",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "compound-quality" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Documents" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product and batch documents." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Documents appear here only when they are linked to the selected product or its batch data." },
    { "type": "text", "id": "library_label", "label": "Quality library label", "default": "Open the quality and COA library" },
    { "type": "url", "id": "library_href", "label": "Quality standards link", "info": "Use the COA library page when no matching batch report is attached." },
    { "type": "text", "id": "request_label", "label": "Document request label", "default": "Request a document", "info": "Leave blank to hide the request form. Add per-SKU batch reports here when they are available. Do not invent purity figures." },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "show_preview", "label": "Show document preview image", "default": true },
    { "type": "checkbox", "id": "show_stats", "label": "Show stat strip", "default": true },
    { "type": "checkbox", "id": "show_disclaimer", "label": "Show document scope note", "default": true },
    { "type": "select", "id": "tone", "label": "Background", "options": [
      { "value": "paper", "label": "Paper" },
      { "value": "white", "label": "White" }
    ], "default": "paper" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [
      { "value": "small", "label": "Small" },
      { "value": "default", "label": "Default" },
      { "value": "large", "label": "Large" }
    ], "default": "default" },
    { "type": "select", "id": "intro_align", "label": "Intro alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "select", "id": "content_width", "label": "Content width", "options": [
      { "value": "narrow", "label": "Narrow" },
      { "value": "default", "label": "Default" },
      { "value": "wide", "label": "Wide" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "Scales the responsive section spacing. 100% is the theme default." },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "show_divider", "label": "Show top divider", "default": true, "info": "Hairline between this and the previous section." },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class", "info": "Optional hook for bespoke styling." }
  ],
  "blocks": [
    {
      "type": "document",
      "name": "Batch document",
      "settings": [
        { "type": "product", "id": "product", "label": "Product document source", "info": "Required. The document, image and batch label are read only from this product's metafields." },
        { "type": "text", "id": "title", "label": "Legacy title (not displayed)" },
        { "type": "text", "id": "product_label", "label": "Legacy product label (not displayed)" },
        { "type": "text", "id": "batch_label", "label": "Legacy batch label (not displayed)" },
        { "type": "select", "id": "kind", "label": "Legacy report type (not displayed)", "options": [
          { "value": "raw", "label": "Raw-material report" },
          { "value": "finished", "label": "Finished-product report" }
        ], "default": "finished" },
        { "type": "header", "content": "Legacy manual fields", "info": "Preserved for template compatibility. They are not displayed; use product or batch metafields." },
        { "type": "text", "id": "stat_purity", "label": "Legacy purity (not displayed)" },
        { "type": "text", "id": "stat_method", "label": "Legacy method (not displayed)" },
        { "type": "text", "id": "stat_sample", "label": "Legacy sample (not displayed)" },
        { "type": "text", "id": "stat_lot", "label": "Legacy lot (not displayed)" },
        { "type": "textarea", "id": "tests", "label": "Legacy tests (not displayed)" },
        { "type": "image_picker", "id": "preview", "label": "Legacy preview (not displayed)" },
        { "type": "text", "id": "preview_asset", "label": "Legacy preview asset (not displayed)" },
        { "type": "number", "id": "preview_width", "label": "Legacy preview width (not displayed)" },
        { "type": "number", "id": "preview_height", "label": "Legacy preview height (not displayed)" },
        { "type": "url", "id": "url", "label": "Legacy document URL (not displayed)" },
        { "type": "text", "id": "asset", "label": "Legacy document asset (not displayed)" }
      ]
    }
  ],
  "presets": [{ "name": "Compound quality" }]
}
{% endschema %}
