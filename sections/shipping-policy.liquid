{%- style -%}
  .xo-section--{{ section.id }} .sp-wrap {
    max-width: 88rem;
    margin: 0 auto;
  }

  .xo-section--{{ section.id }} .sp-header {
    max-width: 72rem;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .xo-section--{{ section.id }} .sp-title {
    margin: 0 0 1.2rem;
    font-size: clamp(3.2rem, 5vw, 5.6rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .xo-section--{{ section.id }} .sp-intro {
    margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.6rem;
    line-height: 1.7;
  }

  .xo-section--{{ section.id }} .sp-intro--start {
    max-width: none;
    margin: 0 0 1.8rem;
    text-align: start;
  }

  .xo-section--{{ section.id }} .sp-kicker {
    display: block;
    margin: 0 0 0.8rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 62%, transparent);
  }

  .xo-section--{{ section.id }} .sp-heading {
    margin: 0 0 1.6rem;
    font-size: clamp(2.4rem, 3.2vw, 3.4rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .xo-section--{{ section.id }} .sp-block {
    margin-bottom: clamp(3.2rem, 5vw, 5.6rem);
  }

  .xo-section--{{ section.id }} .sp-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-desktop-horizontal-spacing, 2.4rem);
  }

  .xo-section--{{ section.id }} .sp-card {
    padding: 2.8rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 14%, transparent);
    border-radius: 2rem;
    background: rgba(var(--color-background));
  }

  .xo-section--{{ section.id }} .sp-card-price {
    display: block;
    margin-bottom: 0.8rem;
    font-size: clamp(2.4rem, 3vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .sp-card-title {
    margin: 0 0 0.8rem;
    font-size: 1.8rem;
  }

  .xo-section--{{ section.id }} .sp-card-text,
  .xo-section--{{ section.id }} .sp-note {
    margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.5rem;
    line-height: 1.65;
  }

  .xo-section--{{ section.id }} .sp-note {
    margin-top: 1.6rem;
  }

  .xo-section--{{ section.id }} .sp-table-wrap {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: 2rem;
  }

  .xo-section--{{ section.id }} .sp-table {
    width: 100%;
    border-collapse: collapse;
  }

  .xo-section--{{ section.id }} .sp-table th,
  .xo-section--{{ section.id }} .sp-table td {
    padding: 1.6rem 1.8rem;
    text-align: left;
    vertical-align: top;
    font-size: 1.5rem;
    line-height: 1.5;
  }

  .xo-section--{{ section.id }} .sp-table th {
    background: rgba(var(--color-background-2));
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .xo-section--{{ section.id }} .sp-table tbody tr + tr td {
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
  }

  .xo-section--{{ section.id }} .sp-customs {
    padding: clamp(2.4rem, 4vw, 3.6rem);
    border-radius: 2rem;
    background: rgba(var(--color-background-2));
  }

  .xo-section--{{ section.id }} .sp-customs .sp-heading {
    margin-bottom: 1.2rem;
  }

  .xo-section--{{ section.id }} .sp-customs-body {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.5rem;
    line-height: 1.7;
  }

  .xo-section--{{ section.id }} .sp-customs-body p {
    margin: 0 0 1.2rem;
  }

  .xo-section--{{ section.id }} .sp-customs-body p:last-child {
    margin-bottom: 0;
  }

  .xo-section--{{ section.id }} :focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .xo-section--{{ section.id }} .sp-cards {
      grid-template-columns: 1fr;
      gap: var(--grid-mobile-vertical-spacing, 1.2rem);
    }

    .xo-section--{{ section.id }} .sp-table thead {
      display: none;
    }

    .xo-section--{{ section.id }} .sp-table tbody tr {
      display: block;
      padding: 1.6rem 1.8rem;
    }

    .xo-section--{{ section.id }} .sp-table tbody tr + tr {
      border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
    }

    .xo-section--{{ section.id }} .sp-table td {
      display: block;
      padding: 0.3rem 0;
      border-top: none;
    }

    .xo-section--{{ section.id }} .sp-table td::before {
      content: attr(data-label) ": ";
      font-weight: 600;
      color: rgba(var(--color-foreground));
    }
  }
{%- endstyle -%}

<section {% render 'section-attr', section: section %} aria-labelledby="sp-title-{{ section.id }}">
  <xo-container>
    <div class="sp-wrap">
      <header class="sp-header">
        <h1 id="sp-title-{{ section.id }}" class="sp-title">{{ section.settings.heading }}</h1>
        {%- if section.settings.intro != blank -%}
          <div class="sp-intro">{{ section.settings.intro }}</div>
        {%- endif -%}
      </header>

      <div class="sp-block">
        <span class="sp-kicker">{{ section.settings.uae_kicker }}</span>
        <h2 class="sp-heading">{{ section.settings.uae_heading }}</h2>
        <div class="sp-cards">
          <article class="sp-card">
            <span class="sp-card-price">{{ section.settings.dubai_price }}</span>
            <h3 class="sp-card-title">{{ section.settings.dubai_title }}</h3>
            <p class="sp-card-text">{{ section.settings.dubai_detail }}</p>
          </article>
          <article class="sp-card">
            <span class="sp-card-price">{{ section.settings.uae_price }}</span>
            <h3 class="sp-card-title">{{ section.settings.uae_title }}</h3>
            <p class="sp-card-text">{{ section.settings.uae_detail }}</p>
          </article>
        </div>
      </div>

      <div class="sp-block">
        <span class="sp-kicker">{{ section.settings.intl_kicker }}</span>
        <h2 class="sp-heading">{{ section.settings.intl_heading }}</h2>
        {%- if section.settings.intl_intro != blank -%}
          <div class="sp-intro sp-intro--start">{{ section.settings.intl_intro }}</div>
        {%- endif -%}
        <div class="sp-table-wrap">
          <table class="sp-table">
            <thead>
              <tr>
                <th scope="col">{{ section.settings.col_region }}</th>
                <th scope="col">{{ section.settings.col_checkout }}</th>
                <th scope="col">{{ section.settings.col_rate }}</th>
                <th scope="col">{{ section.settings.col_free }}</th>
                <th scope="col">{{ section.settings.col_transit }}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td data-label="{{ section.settings.col_region }}">{{ section.settings.gcc_region }}</td>
                <td data-label="{{ section.settings.col_checkout }}">{{ section.settings.gcc_checkout }}</td>
                <td data-label="{{ section.settings.col_rate }}">{{ section.settings.gcc_rate }}</td>
                <td data-label="{{ section.settings.col_free }}">{{ section.settings.gcc_free }}</td>
                <td data-label="{{ section.settings.col_transit }}">{{ section.settings.gcc_transit }}</td>
              </tr>
              <tr>
                <td data-label="{{ section.settings.col_region }}">{{ section.settings.std_region }}</td>
                <td data-label="{{ section.settings.col_checkout }}">{{ section.settings.std_checkout }}</td>
                <td data-label="{{ section.settings.col_rate }}">{{ section.settings.std_rate }}</td>
                <td data-label="{{ section.settings.col_free }}">{{ section.settings.std_free }}</td>
                <td data-label="{{ section.settings.col_transit }}">{{ section.settings.std_transit }}</td>
              </tr>
              <tr>
                <td data-label="{{ section.settings.col_region }}">{{ section.settings.high_region }}</td>
                <td data-label="{{ section.settings.col_checkout }}">{{ section.settings.high_checkout }}</td>
                <td data-label="{{ section.settings.col_rate }}">{{ section.settings.high_rate }}</td>
                <td data-label="{{ section.settings.col_free }}">{{ section.settings.high_free }}</td>
                <td data-label="{{ section.settings.col_transit }}">{{ section.settings.high_transit }}</td>
              </tr>
            </tbody>
          </table>
        </div>
        {%- if section.settings.intl_note != blank -%}
          <p class="sp-note">{{ section.settings.intl_note }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.customs_body != blank -%}
        <div class="sp-customs">
          <h2 class="sp-heading">{{ section.settings.customs_heading }}</h2>
          <div class="sp-customs-body">{{ section.settings.customs_body }}</div>
        </div>
      {%- endif -%}
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "Shipping policy",
  "tag": "section",
  "class": "section-shipping-policy",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping and delivery" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Orders ship from Dubai. UAE delivery is free. International orders are prepaid and sent with Aramex tracking.</p>" },
    { "type": "header", "content": "UAE delivery" },
    { "type": "text", "id": "uae_kicker", "label": "UAE kicker", "default": "UAE" },
    { "type": "text", "id": "uae_heading", "label": "UAE heading", "default": "UAE delivery" },
    { "type": "text", "id": "dubai_title", "label": "Dubai checkout name", "default": "4-Hour Dubai Delivery" },
    { "type": "text", "id": "dubai_price", "label": "Dubai price", "default": "Free" },
    { "type": "textarea", "id": "dubai_detail", "label": "Dubai detail", "default": "Order by 6 PM. Orders placed after 6 PM will be delivered next-day. Dubai only." },
    { "type": "text", "id": "uae_title", "label": "Rest of UAE checkout name", "default": "Next-Day UAE Delivery" },
    { "type": "text", "id": "uae_price", "label": "Rest of UAE price", "default": "Free" },
    { "type": "textarea", "id": "uae_detail", "label": "Rest of UAE detail", "default": "Order by 6 PM for next-day delivery. Orders placed after 6 PM will be processed the following day. Covers Abu Dhabi, Sharjah, Ajman, Umm Al Quwain, Ras Al Khaimah and Fujairah." },
    { "type": "header", "content": "International delivery" },
    { "type": "text", "id": "intl_kicker", "label": "International kicker", "default": "International" },
    { "type": "text", "id": "intl_heading", "label": "International heading", "default": "International delivery" },
    { "type": "richtext", "id": "intl_intro", "label": "International intro", "default": "<p>All supported international shipments are sent through Aramex. International orders must be prepaid. Transit estimates begin after dispatch and can be affected by customs clearance, local import restrictions, public holidays or remote-area delivery.</p>" },
    { "type": "text", "id": "col_region", "label": "Column: region", "default": "Region" },
    { "type": "text", "id": "col_checkout", "label": "Column: checkout name", "default": "Checkout name" },
    { "type": "text", "id": "col_rate", "label": "Column: rate", "default": "Rate" },
    { "type": "text", "id": "col_free", "label": "Column: free shipping", "default": "Free from" },
    { "type": "text", "id": "col_transit", "label": "Column: transit", "default": "Estimated transit" },
    { "type": "textarea", "id": "gcc_region", "label": "GCC countries", "default": "Saudi Arabia, Kuwait, Bahrain, Qatar and Oman" },
    { "type": "text", "id": "gcc_checkout", "label": "GCC checkout name", "default": "Tracked GCC Delivery" },
    { "type": "text", "id": "gcc_rate", "label": "GCC rate", "default": "AED 90" },
    { "type": "text", "id": "gcc_free", "label": "GCC free from", "default": "AED 750" },
    { "type": "text", "id": "gcc_transit", "label": "GCC transit", "default": "3–7 business days" },
    { "type": "textarea", "id": "std_region", "label": "Standard countries", "default": "All international destinations except the UAE, GCC countries, Canada and North Macedonia" },
    { "type": "text", "id": "std_checkout", "label": "Standard checkout name", "default": "Tracked International Delivery" },
    { "type": "text", "id": "std_rate", "label": "Standard rate", "default": "AED 150" },
    { "type": "text", "id": "std_free", "label": "Standard free from", "default": "AED 1,200" },
    { "type": "text", "id": "std_transit", "label": "Standard transit", "default": "8–15 business days" },
    { "type": "textarea", "id": "high_region", "label": "High-cost countries", "default": "Canada and North Macedonia" },
    { "type": "text", "id": "high_checkout", "label": "High-cost checkout name", "default": "Tracked International Delivery" },
    { "type": "text", "id": "high_rate", "label": "High-cost rate", "default": "AED 260" },
    { "type": "text", "id": "high_free", "label": "High-cost free from", "default": "AED 1,500" },
    { "type": "text", "id": "high_transit", "label": "High-cost transit", "default": "7–12 business days" },
    { "type": "textarea", "id": "intl_note", "label": "International note", "default": "Delivery dates are estimates, not guarantees. Rates are flat by destination." },
    { "type": "header", "content": "Customs and conditions" },
    { "type": "text", "id": "customs_heading", "label": "Customs heading", "default": "Customs and delivery conditions" },
    { "type": "richtext", "id": "customs_body", "label": "Customs body", "default": "<p>Customs duties, taxes and import charges are not included unless they are shown at checkout. The recipient is responsible for paying applicable destination-country charges.</p><p>Please provide a complete address, a reachable telephone number and accurate delivery information.</p><p>Delivery dates are estimates, not guarantees. Contact us and we’ll assist with carrier-related delivery issues.</p><p>Return or redelivery costs caused by refusal, unpaid duties, an incorrect address or an unresponsive recipient may be deducted from the refund.</p><p>Certain products may be restricted by local destination-country regulations. Customers are responsible for confirming local import eligibility.</p>" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top desktop", "default": 64 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom desktop", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top mobile", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom mobile", "default": 56 }
  ],
  "presets": [
    { "name": "Shipping policy" }
  ]
}
{% endschema %}
