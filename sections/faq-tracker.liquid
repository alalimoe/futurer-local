{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .xo-section--{{ section.id }} .ft__wrap {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-3, 2rem);
    padding: 20px;
  }

  .xo-section--{{ section.id }} .ft__title {
    margin: 0 0 12px;
    font-size: clamp(1.8rem, 2vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .ft__tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .xo-section--{{ section.id }} .ft__tab {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    background: rgba(var(--color-background));
    border-radius: var(--button-radius);
    padding: 8px 14px;
    min-height: 44px;
    box-sizing: border-box;
    cursor: pointer;
    font-size: 1.4rem;
    display: inline-flex;
    align-items: center;
    color: rgba(var(--color-foreground));
    transition: border-color 0.3s var(--out-soft, ease);
  }

  .xo-section--{{ section.id }} .ft__tab:hover {
    border-color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .ft__tab:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  .xo-section--{{ section.id }} .ft__tab--active {
    border-color: rgba(var(--color-accent));
    font-weight: 600;
    background: color-mix(in srgb, rgba(var(--color-accent)) 8%, transparent);
  }

  .xo-section--{{ section.id }} .ft__panel[hidden] {
    display: none;
  }

  .xo-section--{{ section.id }} .ft__group + .ft__group {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }

  .xo-section--{{ section.id }} .ft__label {
    display: block;
    margin-bottom: 8px;
    font-size: 1.4rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  }

  .xo-section--{{ section.id }} .ft__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: center;
  }

  .xo-section--{{ section.id }} .ft__input {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: 10px 14px;
    width: 100%;
    min-height: 48px;
    box-sizing: border-box;
    font-size: 1.5rem;
    background: rgba(var(--color-background));
    color: rgba(var(--color-foreground));
    transition: border-color 0.3s var(--out-soft, ease);
  }

  .xo-section--{{ section.id }} .ft__input:focus {
    outline: none;
    border-color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .ft__input:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  .xo-section--{{ section.id }} .ft__input::placeholder {
    opacity: 0.5;
  }

  .xo-section--{{ section.id }} .ft__btn {
    border: none;
    border-radius: var(--general-radius-1, 1rem);
    padding: 10px 18px;
    min-height: 48px;
    background: rgba(var(--color-foreground));
    color: rgba(var(--color-background));
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.3s var(--out-soft, ease);
  }

  .xo-section--{{ section.id }} .ft__btn:hover {
    opacity: 0.85;
  }

  .xo-section--{{ section.id }} .ft__btn:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  .xo-section--{{ section.id }} .ft__hint {
    font-size: 1.3rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 60%, transparent);
    margin-top: 10px;
  }

  @media (max-width: 740px) {
    .xo-section--{{ section.id }} .ft__row {
      grid-template-columns: 1fr;
    }

    .xo-section--{{ section.id }} .ft__btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ section.id }} .ft__tab,
    .xo-section--{{ section.id }} .ft__input,
    .xo-section--{{ section.id }} .ft__btn {
      transition: none;
    }
  }
{%- endstyle -%}

<section {% render 'section-attr' %}>
  <xo-container>
    <div class="ft__wrap" id="track">
      <h2 class="ft__title">{{ section.settings.heading }}</h2>

      <div class="ft__tabs" role="tablist" aria-label="{{ 'sections.faq_tracker.tabs_label' | t }}">
        <button class="ft__tab ft__tab--active" data-tab="local" role="tab" aria-selected="true">{{ 'sections.faq_tracker.tab_local' | t }}</button>
        <button class="ft__tab" data-tab="intl" role="tab" aria-selected="false">{{ 'sections.faq_tracker.tab_intl' | t }}</button>
      </div>

      <div class="ft__panel ft__panel--active" data-panel="local" role="tabpanel">
        <label for="ftLocalRef-{{ section.id }}" class="ft__label">{{ 'sections.faq_tracker.local_label' | t }}</label>
        <div class="ft__row">
          <input id="ftLocalRef-{{ section.id }}" type="text" class="ft__input" placeholder="{{ section.settings.local_placeholder }}" enterkeyhint="go">
          <button class="ft__btn" data-track="quiqup" data-input="ftLocalRef-{{ section.id }}">{{ 'sections.faq_tracker.track_quiqup' | t }}</button>
        </div>
        <p class="ft__hint" data-hint="quiqup" data-copied="{{ 'sections.faq_tracker.copied' | t: ref: '__REF__' }}" aria-live="polite">{{ 'sections.faq_tracker.local_hint' | t }}</p>
      </div>

      <div class="ft__panel" data-panel="intl" role="tabpanel" hidden>
        <div class="ft__group">
          <label for="ftIntlQuiqup-{{ section.id }}" class="ft__label">{{ 'sections.faq_tracker.intl_quiqup_label' | t }}</label>
          <div class="ft__row">
            <input id="ftIntlQuiqup-{{ section.id }}" type="text" class="ft__input" placeholder="{{ section.settings.local_placeholder }}" enterkeyhint="go">
            <button class="ft__btn" data-track="quiqup" data-input="ftIntlQuiqup-{{ section.id }}">{{ 'sections.faq_tracker.track_quiqup' | t }}</button>
          </div>
          <p class="ft__hint" data-hint="quiqup" data-copied="{{ 'sections.faq_tracker.copied' | t: ref: '__REF__' }}" aria-live="polite">{{ 'sections.faq_tracker.intl_quiqup_hint' | t }}</p>
        </div>
        <div class="ft__group">
          <label for="ftIntlRef-{{ section.id }}" class="ft__label">{{ 'sections.faq_tracker.intl_aramex_label' | t }}</label>
          <div class="ft__row">
            <input id="ftIntlRef-{{ section.id }}" type="text" class="ft__input" placeholder="{{ section.settings.intl_placeholder }}" enterkeyhint="go">
            <button class="ft__btn" data-track="aramex">{{ 'sections.faq_tracker.track_aramex' | t }}</button>
          </div>
          <p class="ft__hint">{{ 'sections.faq_tracker.intl_aramex_hint' | t }}</p>
        </div>
      </div>
    </div>
  </xo-container>
</section>

<script>
  (function(){
    var section = document.querySelector('.xo-section--{{ section.id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('.ft__tab');
    var panels = section.querySelectorAll('.ft__panel');
    var localInput = section.querySelector('#ftLocalRef-{{ section.id }}');
    var intlQuiqupInput = section.querySelector('#ftIntlQuiqup-{{ section.id }}');
    var intlInput = section.querySelector('#ftIntlRef-{{ section.id }}');

    section.querySelectorAll('[data-hint="quiqup"]').forEach(function(hint){
      hint.setAttribute('data-default', hint.textContent);
    });

    function selectTab(key){
      tabs.forEach(function(x){
        var active = x.getAttribute('data-tab') === key;
        x.classList.toggle('ft__tab--active', active);
        x.setAttribute('aria-selected', active);
      });
      panels.forEach(function(p){
        var active = p.getAttribute('data-panel') === key;
        p.toggleAttribute('hidden', !active);
      });
    }

    tabs.forEach(function(t){
      t.addEventListener('click', function(){
        selectTab(t.getAttribute('data-tab'));
      });
    });

    function trackQuiqup(input, hint){
      var ref = input ? input.value.trim() : '';
      if (ref && navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(ref).then(function(){
          if (hint) {
            var tpl = hint.getAttribute('data-copied') || '';
            hint.textContent = tpl.replace('__REF__', ref);
          }
        }).catch(function(){});
      }
      window.open('https://track-parcel.quiqup.com/', '_blank', 'noopener');
    }

    function trackAramex(){
      var id = intlInput ? intlInput.value.trim() : '';
      if (!id) return;
      window.open('https://www.aramex.com/track/results?ShipmentNumber=' + encodeURIComponent(id), '_blank', 'noopener');
    }

    function resetHint(hint){
      if (!hint) return;
      var fallback = hint.getAttribute('data-default') || '';
      if (hint.textContent !== fallback) hint.textContent = fallback;
    }

    section.querySelectorAll('[data-track="quiqup"]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var input = section.querySelector('#' + btn.getAttribute('data-input'));
        var wrap = btn.closest('.ft__group') || btn.closest('.ft__panel');
        var hint = wrap ? wrap.querySelector('[data-hint="quiqup"]') : null;
        trackQuiqup(input, hint);
      });
    });

    var aramexBtn = section.querySelector('[data-track="aramex"]');
    if (aramexBtn) aramexBtn.addEventListener('click', trackAramex);

    function bindQuiqupInput(input){
      if (!input) return;
      var wrap = input.closest('.ft__group') || input.closest('.ft__panel');
      var hint = wrap ? wrap.querySelector('[data-hint="quiqup"]') : null;
      input.addEventListener('keydown', function(e){
        if (e.key === 'Enter') { e.preventDefault(); trackQuiqup(input, hint); }
      });
      input.addEventListener('input', function(){
        resetHint(hint);
      });
    }

    bindQuiqupInput(localInput);
    bindQuiqupInput(intlQuiqupInput);

    if (intlInput) {
      intlInput.addEventListener('keydown', function(e){
        if (e.key === 'Enter') { e.preventDefault(); trackAramex(); }
      });
    }

    var params = new URLSearchParams(window.location.search);
    var prefill = params.get('ref') || params.get('order') || params.get('track');
    if (prefill) {
      prefill = prefill.trim();
      var isIntl = /^\d{10,12}$/.test(prefill.replace(/\s/g, ''));
      if (isIntl && intlInput) {
        selectTab('intl');
        intlInput.value = prefill;
      } else if (localInput) {
        selectTab('local');
        localInput.value = prefill;
      }
    }
  })();
</script>

{% schema %}
{
  "name": "FAQ Tracking Widget",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your delivery" },
    { "type": "text", "id": "local_placeholder", "label": "Local placeholder", "default": "e.g., your order number #9051" },
    { "type": "text", "id": "intl_placeholder", "label": "International placeholder", "default": "e.g., Aramex waybill" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 8 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 16 }
  ],
  "presets": [{ "name": "FAQ Tracking Widget" }]
}
{% endschema %}
