{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .xo-section--{{ section.id }} .ft__wrap {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-3, 2rem);
    padding: 20px;
  }

  .xo-section--{{ section.id }} .ft__title {
    margin: 0 0 12px;
    font-size: clamp(1.8rem, 2vw, 2.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .ft__tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .xo-section--{{ section.id }} .ft__tab {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    background: rgba(var(--color-background));
    border-radius: var(--button-radius);
    padding: 8px 14px;
    min-height: 44px;
    box-sizing: border-box;
    cursor: pointer;
    font-size: 1.4rem;
    display: inline-flex;
    align-items: center;
    color: rgba(var(--color-foreground));
    transition: border-color 0.3s var(--out-soft, ease);
  }

  .xo-section--{{ section.id }} .ft__tab:hover {
    border-color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .ft__tab:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  .xo-section--{{ section.id }} .ft__tab--active {
    border-color: rgba(var(--color-accent));
    font-weight: 600;
    background: color-mix(in srgb, rgba(var(--color-accent)) 8%, transparent);
  }

  .xo-section--{{ section.id }} .ft__panel[hidden] {
    display: none;
  }

  .xo-section--{{ section.id }} .ft__group + .ft__group {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }

  .xo-section--{{ section.id }} .ft__label {
    display: block;
    margin-bottom: 8px;
    font-size: 1.4rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  }

  .xo-section--{{ section.id }} .ft__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: center;
  }

  .xo-section--{{ section.id }} .ft__input {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: 10px 14px;
    width: 100%;
    min-height: 48px;
    box-sizing: border-box;
    font-size: 1.5rem;
    background: rgba(var(--color-background));
    color: rgba(var(--color-foreground));
    transition: border-color 0.3s var(--out-soft, ease);
  }

  .xo-section--{{ section.id }} .ft__input:focus {
    outline: none;
    border-color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .ft__input:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  .xo-section--{{ section.id }} .ft__input::placeholder {
    opacity: 0.5;
  }

  .xo-section--{{ section.id }} .ft__btn {
    border: none;
    border-radius: var(--general-radius-1, 1rem);
    padding: 10px 18px;
    min-height: 48px;
    background: rgba(var(--color-foreground));
    color: rgba(var(--color-background));
    font-size: 1.4rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.3s var(--out-soft, ease);
  }

  .xo-section--{{ section.id }} .ft__btn:hover {
    opacity: 0.85;
  }

  .xo-section--{{ section.id }} .ft__btn:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  .xo-section--{{ section.id }} .ft__hint {
    font-size: 1.3rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 60%, transparent);
    margin-top: 10px;
  }

  .xo-section--{{ section.id }} .ft__account {
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }

  .xo-section--{{ section.id }} .ft__account-title {
    margin: 0 0 8px;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .ft__account-cta {
    margin-top: 12px;
  }

  .xo-section--{{ section.id }} .ft__shipments {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .xo-section--{{ section.id }} .ft__shipment {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: center;
  }

  .xo-section--{{ section.id }} .ft__shipment-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    font-size: 1.4rem;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .ft__shipment-name {
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .ft__shipment-date,
  .xo-section--{{ section.id }} .ft__shipment-carrier,
  .xo-section--{{ section.id }} .ft__shipment-status {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  }

  .xo-section--{{ section.id }} .ft__btn--ghost {
    background: transparent;
    color: rgba(var(--color-foreground));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
  }

  .xo-section--{{ section.id }} .ft__btn--ghost:hover {
    border-color: rgba(var(--color-accent));
    opacity: 1;
  }

  .xo-section--{{ section.id }} .ft__carrier-heading {
    margin: 0 0 12px;
    font-size: 1.4rem;
    font-weight: 600;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .ft__intro,
  .xo-section--{{ section.id }} .ft__notice,
  .xo-section--{{ section.id }} .ft__support {
    max-width: 72ch;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
  }

  .xo-section--{{ section.id }} .ft__intro {
    margin: 0 0 20px;
  }

  .xo-section--{{ section.id }} .ft__notice {
    margin: 20px 0 0;
    padding: 14px;
    border-inline-start: 3px solid rgba(var(--color-accent));
    background: color-mix(in srgb, rgba(var(--color-accent)) 6%, transparent);
  }

  .xo-section--{{ section.id }} .ft__support {
    margin: 14px 0 0;
  }

  .xo-section--{{ section.id }} .ft__support a,
  .xo-section--{{ section.id }} .ft__carrier-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .xo-section--{{ section.id }} .ft__carrier-link {
    display: inline-block;
    margin-top: 10px;
  }

  .xo-section--{{ section.id }} .ft__error {
    min-height: 1.5em;
    margin: 8px 0 0;
    color: rgba(var(--color-error, var(--color-foreground)));
    font-size: 1.3rem;
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .ft__input[aria-invalid='true'] {
    border-color: rgba(var(--color-error, var(--color-foreground)));
  }

  .xo-section--{{ section.id }} .ft__status {
    min-height: 1.5em;
    margin: 10px 0 0;
    font-size: 1.3rem;
  }

  .xo-section--{{ section.id }} noscript p {
    margin: 12px 0 0;
  }

  @media (max-width: 740px) {
    .xo-section--{{ section.id }} .ft__row {
      grid-template-columns: 1fr;
    }

    .xo-section--{{ section.id }} .ft__btn {
      width: 100%;
    }

    .xo-section--{{ section.id }} .ft__shipment {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ section.id }} .ft__tab,
    .xo-section--{{ section.id }} .ft__input,
    .xo-section--{{ section.id }} .ft__btn {
      transition: none;
    }
  }
{%- endstyle -%}

{% liquid
  assign login_url = routes.storefront_login_url
  if login_url == blank
    assign login_url = '/customer_authentication/login?return_to=' | append: request.path
  endif
  assign sign_in_label = 'sections.faq_tracker.sign_in_button' | t
  assign local_carrier_name = section.settings.local_carrier_name | default: 'Quiqup'
  assign intl_carrier_name = section.settings.intl_carrier_name | default: 'Aramex'
  assign local_tracking_url = section.settings.local_tracking_url | default: 'https://track-parcel.quiqup.com/'
  assign intl_tracking_url = section.settings.intl_tracking_url | default: 'https://www.aramex.com/track/results'
  assign local_reference_pattern = section.settings.local_reference_pattern | default: '[A-Za-z0-9][-A-Za-z0-9 ._/]{2,58}[A-Za-z0-9]'
  assign intl_reference_pattern = section.settings.intl_reference_pattern | default: '[A-Za-z0-9][-A-Za-z0-9 ._/]{2,58}[A-Za-z0-9]'
  assign is_tracking_page = false
  if template.name == 'page' and template.suffix == 'track-order'
    assign is_tracking_page = true
  endif
%}

<section {% render 'section-attr' %}>
  <xo-container>
    <div class="ft__wrap" id="track">
      {%- if is_tracking_page -%}
        <h1 class="ft__title">{{ section.settings.heading | escape }}</h1>
      {%- else -%}
        <h2 class="ft__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <p class="ft__intro">{{ 'sections.faq_tracker.intro' | t }}</p>

      {%- if customer -%}
        <div class="ft__account">
          <h3 class="ft__account-title">{{ 'sections.faq_tracker.shipments_heading' | t }}</h3>
          {%- if customer.orders.size == 0 -%}
            <p class="ft__hint">{{ 'sections.faq_tracker.no_orders' | t }}</p>
          {%- else -%}
            <ul class="ft__shipments">
              {%- for order in customer.orders limit: 5 -%}
                {%- assign shown_urls = '' -%}
                {%- assign order_has_track = false -%}
                {%- for item in order.line_items -%}
                  {%- if item.fulfillment.tracking_url != blank -%}
                    {%- assign track_url = item.fulfillment.tracking_url -%}
                    {%- unless shown_urls contains track_url -%}
                      {%- assign order_has_track = true -%}
                      {%- assign shown_urls = shown_urls | append: track_url | append: '|' -%}
                      <li class="ft__shipment">
                        <div class="ft__shipment-meta">
                          <span class="ft__shipment-name">{{ order.name | escape }}</span>
                          <span class="ft__shipment-date">{{ order.created_at | time_tag: format: 'date' }}</span>
                          {%- if item.fulfillment.tracking_company != blank -%}
                            <span class="ft__shipment-carrier">{{ item.fulfillment.tracking_company | escape }}</span>
                          {%- endif -%}
                        </div>
                        <a class="ft__btn" href="{{ track_url | escape }}" target="_blank" rel="noopener noreferrer">
                          {{- 'sections.faq_tracker.track_shipment' | t -}}
                        </a>
                      </li>
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- unless order_has_track -%}
                  <li class="ft__shipment">
                    <div class="ft__shipment-meta">
                      <span class="ft__shipment-name">{{ order.name | escape }}</span>
                      <span class="ft__shipment-date">{{ order.created_at | time_tag: format: 'date' }}</span>
                      <span class="ft__shipment-status">
                        {%- if order.fulfillment_status_label != blank -%}
                          {{ order.fulfillment_status_label }}
                        {%- else -%}
                          {{ 'sections.faq_tracker.not_shipped' | t }}
                        {%- endif -%}
                      </span>
                    </div>
                    <a class="ft__btn ft__btn--ghost" href="{{ order.customer_url | escape }}">
                      {{- 'sections.faq_tracker.view_order' | t -}}
                    </a>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- elsif shop.customer_accounts_enabled -%}
        <div class="ft__account">
          <h3 class="ft__account-title">{{ 'sections.faq_tracker.sign_in_heading' | t }}</h3>
          <p class="ft__hint">{{ 'sections.faq_tracker.sign_in_hint' | t }}</p>
          <div class="ft__account-cta">
            {% render 'button', text: sign_in_label, link: login_url, style: 'primary', size: 'md' %}
          </div>
        </div>
      {%- endif -%}

      <p class="ft__carrier-heading">{{ 'sections.faq_tracker.carrier_heading' | t }}</p>

      <div class="ft__tabs" role="tablist" aria-label="{{ 'sections.faq_tracker.tabs_label' | t }}">
        <button
          id="ft-tab-local-{{ section.id }}"
          class="ft__tab ft__tab--active"
          type="button"
          data-tab="local"
          role="tab"
          aria-controls="ft-panel-local-{{ section.id }}"
          aria-selected="true"
          tabindex="0"
        >
          {{- local_carrier_name | escape -}}
        </button>
        <button
          id="ft-tab-intl-{{ section.id }}"
          class="ft__tab"
          type="button"
          data-tab="intl"
          role="tab"
          aria-controls="ft-panel-intl-{{ section.id }}"
          aria-selected="false"
          tabindex="-1"
        >
          {{- intl_carrier_name | escape -}}
        </button>
      </div>

      <div
        id="ft-panel-local-{{ section.id }}"
        class="ft__panel ft__panel--active"
        data-panel="local"
        role="tabpanel"
        aria-labelledby="ft-tab-local-{{ section.id }}"
        tabindex="0"
      >
        <form
          data-carrier-form
          action="{{ local_tracking_url | escape }}"
          method="get"
          target="_blank"
          rel="noopener noreferrer"
          data-query-parameter="{{ section.settings.local_tracking_parameter | escape }}"
          data-empty-message="{{ 'sections.faq_tracker.empty_error' | t: carrier: local_carrier_name | escape }}"
          data-format-message="{{ 'sections.faq_tracker.format_error' | t: carrier: local_carrier_name | escape }}"
          data-manual-message="{{ 'sections.faq_tracker.manual_entry' | t: carrier: local_carrier_name | escape }}"
        >
          <label for="ftLocalRef-{{ section.id }}" class="ft__label">
            {{- 'sections.faq_tracker.reference_label' | t: carrier: local_carrier_name | escape -}}
          </label>
          <div class="ft__row">
            <input
              id="ftLocalRef-{{ section.id }}"
              name="{{ section.settings.local_tracking_parameter | escape }}"
              type="text"
              class="ft__input"
              inputmode="text"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              enterkeyhint="go"
              required
              pattern="{{ local_reference_pattern | escape }}"
              aria-describedby="ft-local-help-{{ section.id }} ft-local-error-{{ section.id }}"
            >
            <button class="ft__btn" type="submit">
              {{- 'sections.faq_tracker.track_with' | t: carrier: local_carrier_name | escape -}}
            </button>
          </div>
          <p id="ft-local-help-{{ section.id }}" class="ft__hint">{{ section.settings.local_placeholder | escape }}</p>
          <p id="ft-local-error-{{ section.id }}" class="ft__error" data-form-error aria-live="polite"></p>
          <p class="ft__status" data-form-status role="status" aria-live="polite"></p>
        </form>
        <a class="ft__carrier-link" href="{{ local_tracking_url | escape }}" target="_blank" rel="noopener noreferrer">
          {{- 'sections.faq_tracker.open_carrier' | t: carrier: local_carrier_name | escape -}}
        </a>
        <noscript>
          <p>{{ 'sections.faq_tracker.no_js' | t: carrier: local_carrier_name | escape }}</p>
        </noscript>
      </div>

      <div
        id="ft-panel-intl-{{ section.id }}"
        class="ft__panel"
        data-panel="intl"
        role="tabpanel"
        aria-labelledby="ft-tab-intl-{{ section.id }}"
        tabindex="0"
        hidden
      >
        <form
          data-carrier-form
          action="{{ intl_tracking_url | escape }}"
          method="get"
          target="_blank"
          rel="noopener noreferrer"
          data-query-parameter="{{ section.settings.intl_tracking_parameter | escape }}"
          data-empty-message="{{ 'sections.faq_tracker.empty_error' | t: carrier: intl_carrier_name | escape }}"
          data-format-message="{{ 'sections.faq_tracker.format_error' | t: carrier: intl_carrier_name | escape }}"
          data-manual-message="{{ 'sections.faq_tracker.manual_entry' | t: carrier: intl_carrier_name | escape }}"
        >
          <label for="ftIntlRef-{{ section.id }}" class="ft__label">
            {{- 'sections.faq_tracker.reference_label' | t: carrier: intl_carrier_name | escape -}}
          </label>
          <div class="ft__row">
            <input
              id="ftIntlRef-{{ section.id }}"
              name="{{ section.settings.intl_tracking_parameter | escape }}"
              type="text"
              class="ft__input"
              inputmode="text"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              enterkeyhint="go"
              required
              pattern="{{ intl_reference_pattern | escape }}"
              aria-describedby="ft-intl-help-{{ section.id }} ft-intl-error-{{ section.id }}"
            >
            <button class="ft__btn" type="submit">
              {{- 'sections.faq_tracker.track_with' | t: carrier: intl_carrier_name | escape -}}
            </button>
          </div>
          <p id="ft-intl-help-{{ section.id }}" class="ft__hint">{{ section.settings.intl_placeholder | escape }}</p>
          <p id="ft-intl-error-{{ section.id }}" class="ft__error" data-form-error aria-live="polite"></p>
          <p class="ft__status" data-form-status role="status" aria-live="polite"></p>
        </form>
        <a class="ft__carrier-link" href="{{ intl_tracking_url | escape }}" target="_blank" rel="noopener noreferrer">
          {{- 'sections.faq_tracker.open_carrier' | t: carrier: intl_carrier_name | escape -}}
        </a>
        <noscript>
          <p>{{ 'sections.faq_tracker.no_js' | t: carrier: intl_carrier_name | escape }}</p>
        </noscript>
      </div>

      <p class="ft__notice">{{ 'sections.faq_tracker.privacy_note' | t }}</p>
      <p class="ft__support">
        {{ 'sections.faq_tracker.split_shipments' | t }}
        <a href="/pages/contact">{{ 'sections.faq_tracker.contact_support' | t }}</a>
      </p>
    </div>
  </xo-container>
</section>

<script>
  (function() {
    var section = document.querySelector('.xo-section--{{ section.id }}');
    if (!section || section.dataset.trackerReady === 'true') return;
    section.dataset.trackerReady = 'true';

    var tabs = Array.prototype.slice.call(section.querySelectorAll('[role="tab"]'));
    var panels = section.querySelectorAll('[role="tabpanel"]');

    function selectTab(tab, moveFocus) {
      tabs.forEach(function(item) {
        var active = item === tab;
        item.classList.toggle('ft__tab--active', active);
        item.setAttribute('aria-selected', active ? 'true' : 'false');
        item.setAttribute('tabindex', active ? '0' : '-1');
      });
      panels.forEach(function(panel) {
        panel.hidden = panel.id !== tab.getAttribute('aria-controls');
      });
      if (moveFocus) tab.focus();
    }

    tabs.forEach(function(tab, index) {
      tab.addEventListener('click', function() {
        selectTab(tab, false);
      });
      tab.addEventListener('keydown', function(event) {
        var targetIndex = index;
        if (event.key === 'ArrowRight') targetIndex = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') targetIndex = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') targetIndex = 0;
        if (event.key === 'End') targetIndex = tabs.length - 1;
        if (targetIndex !== index) {
          event.preventDefault();
          selectTab(tabs[targetIndex], true);
        }
      });
    });

    section.querySelectorAll('[data-carrier-form]').forEach(function(form) {
      var input = form.querySelector('.ft__input');
      var error = form.querySelector('[data-form-error]');
      var status = form.querySelector('[data-form-status]');

      function clearMessages() {
        input.setCustomValidity('');
        input.removeAttribute('aria-invalid');
        error.textContent = '';
        status.textContent = '';
      }

      input.addEventListener('input', clearMessages);

      form.addEventListener('submit', function(event) {
        clearMessages();
        var reference = input.value.trim();
        var message = '';
        input.value = reference;

        if (!reference) {
          message = form.dataset.emptyMessage;
        } else if (input.validity.patternMismatch) {
          message = form.dataset.formatMessage;
        }

        if (message) {
          event.preventDefault();
          input.setCustomValidity(message);
          input.setAttribute('aria-invalid', 'true');
          error.textContent = message;
          input.reportValidity();
          input.focus();
          return;
        }

        if (!form.dataset.queryParameter) {
          event.preventDefault();
          status.textContent = form.dataset.manualMessage;
          var directLink = form.closest('[role="tabpanel"]').querySelector('.ft__carrier-link');
          directLink.click();
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ Tracking Widget",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Track your delivery" },
    { "type": "header", "content": "First carrier" },
    { "type": "text", "id": "local_carrier_name", "label": "Carrier name", "default": "Quiqup" },
    { "type": "url", "id": "local_tracking_url", "label": "Tracking URL" },
    {
      "type": "text",
      "id": "local_tracking_parameter",
      "label": "Tracking URL parameter",
      "info": "Leave blank when the carrier does not support references in its URL."
    },
    {
      "type": "text",
      "id": "local_reference_pattern",
      "label": "Accepted reference pattern",
      "default": "[A-Za-z0-9][-A-Za-z0-9 ._/]{2,58}[A-Za-z0-9]",
      "info": "HTML pattern syntax. The default accepts 4–60 letters, numbers, spaces, periods, underscores, slashes, or hyphens."
    },
    { "type": "text", "id": "local_placeholder", "label": "Reference format hint", "default": "Enter the reference exactly as it appears in your shipping message." },
    { "type": "header", "content": "Second carrier" },
    { "type": "text", "id": "intl_carrier_name", "label": "Carrier name", "default": "Aramex" },
    { "type": "url", "id": "intl_tracking_url", "label": "Tracking URL" },
    {
      "type": "text",
      "id": "intl_tracking_parameter",
      "label": "Tracking URL parameter",
      "default": "ShipmentNumber",
      "info": "Leave blank when the carrier does not support references in its URL."
    },
    {
      "type": "text",
      "id": "intl_reference_pattern",
