{% comment %} NX Flagship routine — daily use + feel timeline. {% endcomment %}

{{ 'nx-flagship.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign feel_data = product.metafields.npx.feel_timeline.value | default: product.metafields.npx.feel_timeline
  assign how_data = product.metafields.npx.how_to_use.value | default: product.metafields.npx.how_to_use
-%}

<section {% render 'section-attr' %} id="routine" class="nx-flagship nx-flagship__anchor nx-flagship__section">
  <xo-container>
    <div class="nx-flagship__wrap">
      <p class="nx-flagship__eyebrow">{{ section.settings.eyebrow | default: 'Daily Routine' }}</p>
      <h2 class="nx-flagship__h2">{{ section.settings.heading | default: 'How to take Baseline' }}</h2>

      <div class="nx-flagship__grid-2" style="margin-top:2rem;">
        <div class="nx-flagship__card">
          <h3 style="margin:0 0 1rem;font-size:1.8rem;font-weight:600;">{{ section.settings.usage_heading | default: 'Morning, with food' }}</h3>
          {% if how_data != blank %}
            <div style="font-size:1.4rem;line-height:1.65;color:var(--nx-muted);">{{ how_data | metafield_tag }}</div>
          {% else %}
            <p style="margin:0;font-size:1.4rem;line-height:1.65;color:var(--nx-muted);">{{ section.settings.usage_text }}</p>
          {% endif %}
        </div>

        <div class="nx-flagship__card">
          <h3 style="margin:0 0 1.2rem;font-size:1.8rem;font-weight:600;">{{ section.settings.timeline_heading | default: 'What to expect' }}</h3>
          <ul class="nx-flagship__timeline">
            {% if feel_data != blank and feel_data.size > 0 %}
              {% for item in feel_data %}
                <li class="nx-flagship__timeline-item">
                  <span class="nx-flagship__timeline-dot" aria-hidden="true"></span>
                  <div>
                    <p class="nx-flagship__timeline-label">{{ item.period | default: item.label | default: item.title }}</p>
                    <p style="margin:0;font-size:1.3rem;color:var(--nx-muted);line-height:1.55;">{{ item.description | default: item.text | default: item.note }}</p>
                  </div>
                </li>
              {% endfor %}
            {% else %}
              {% for block in section.blocks %}
                {% if block.type == 'timeline' %}
                  <li class="nx-flagship__timeline-item" {{ block.shopify_attributes }}>
                    <span class="nx-flagship__timeline-dot" aria-hidden="true"></span>
                    <div>
                      <p class="nx-flagship__timeline-label">{{ block.settings.period }}</p>
                      <p style="margin:0;font-size:1.3rem;color:var(--nx-muted);line-height:1.55;">{{ block.settings.description }}</p>
                    </div>
                  </li>
                {% endif %}
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      </div>
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "NX Flagship — Routine",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Daily Routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to take Baseline" },
    { "type": "text", "id": "usage_heading", "label": "Usage heading", "default": "Morning, with food" },
    { "type": "textarea", "id": "usage_text", "label": "Usage text", "default": "Take 2 capsules daily with your morning meal. Consistency matters more than timing precision — pick a time you can stick to every day." },
    { "type": "text", "id": "timeline_heading", "label": "Timeline heading", "default": "What to expect" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },
    { "type": "number", "id": "padding_top_desktop", "label": "Padding top desktop", "default": 48 },
    { "type": "number", "id": "padding_bottom_desktop", "label": "Padding bottom desktop", "default": 48 },
    { "type": "number", "id": "padding_top_mobile", "label": "Padding top mobile", "default": 32 },
    { "type": "number", "id": "padding_bottom_mobile", "label": "Padding bottom mobile", "default": 32 }
  ],
  "blocks": [
    {
      "type": "timeline",
      "name": "Timeline item",
      "settings": [
        { "type": "text", "id": "period", "label": "Period", "default": "Week 1" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Subtle shifts in energy and focus. Effects build gradually — give it time." }
      ]
    }
  ],
  "presets": [
    {
      "name": "NX Flagship — Routine",
      "blocks": [
        { "type": "timeline", "settings": { "period": "Week 1", "description": "Subtle shifts in energy and focus. Effects build gradually — give it time." } },
        { "type": "timeline", "settings": { "period": "Weeks 2–4", "description": "Steadier mental clarity, smoother energy through the afternoon, better stress tolerance." } },
        { "type": "timeline", "settings": { "period": "Month 2+", "description": "Consistent baseline performance. Many users report this becomes their default 'good day' feeling." } }
      ]
    }
  ]
}
{% endschema %}
