{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    text-align: center;
  }

  .bgh-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 9999;
    background: color-mix(in srgb, rgba(var(--color-foreground)) 6%, transparent);
    pointer-events: none;
  }

  .bgh-progress__bar {
    height: 100%;
    width: 100%;
    background: rgba(var(--color-accent));
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  .xo-section--{{ section.id }} .bgh-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .xo-section--{{ section.id }} .bgh-meta {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .xo-section--{{ section.id }} .bgh-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: calc(var(--font-body-scale, 1) * 1.4rem);
    font-weight: 500;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
  }

  .xo-section--{{ section.id }} .bgh-title {
    font-size: clamp(3.6rem, 5.5vw, 6.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: rgba(var(--color-foreground));
    margin: 0 0 2rem;
    line-height: 1.08;
  }

  .xo-section--{{ section.id }} .bgh-subtitle {
    font-size: 1.6rem;
    line-height: 1.65;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
    margin: 0 0 2.4rem;
    max-width: 48ch;
    margin-inline: auto;
  }

  .xo-section--{{ section.id }} .bgh-trust {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem 0;
    margin-bottom: 2.8rem;
    list-style: none;
  }

  .xo-section--{{ section.id }} .bgh-trust-pill {
    display: inline;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0;
  }

  .xo-section--{{ section.id }} .bgh-trust-pill:not(:last-child)::after {
    content: '·';
    margin: 0 1.2rem;
    font-weight: 400;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 35%, transparent);
  }

  .xo-section--{{ section.id }} .bgh-ctas {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .xo-section--{{ section.id }} .bgh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem 1.5rem;
    font-size: calc(var(--font-body-scale, 1) * 1.5rem);
    font-weight: 600;
    border-radius: var(--button-radius);
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: opacity 0.3s var(--out-soft, ease);
  }

  .xo-section--{{ section.id }} .bgh-btn--primary {
    background: rgba(var(--color-accent));
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .bgh-btn--primary:hover {
    opacity: 0.85;
  }

  .xo-section--{{ section.id }} .bgh-btn--secondary {
    background: transparent;
    color: rgba(var(--color-foreground));
    border: 0;
    border-radius: 0;
    min-height: auto;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, rgba(var(--color-foreground)) 28%, transparent);
  }

  .xo-section--{{ section.id }} .bgh-btn--secondary:hover {
    border-color: transparent;
    text-decoration-color: rgba(var(--color-accent));
    opacity: 1;
  }

  .xo-section--{{ section.id }} .bgh-btn:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .xo-section--{{ section.id }} .bgh-ctas {
      flex-direction: column;
      align-items: center;
    }

    .xo-section--{{ section.id }} .bgh-btn {
      width: 100%;
      max-width: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ section.id }} .bgh-btn,
    .bgh-progress__bar {
      transition: none;
    }
  }
{%- endstyle -%}

<div class="bgh-progress" aria-hidden="true"><div class="bgh-progress__bar" data-bgh-bar></div></div>

<section {% render 'section-attr' %}>
  <xo-container>
    <div class="bgh-inner">
      {% if section.settings.read_time != blank %}
        <div class="bgh-meta">
          <span class="bgh-meta-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {{ section.settings.read_time }}
          </span>
        </div>
      {% endif %}

      <h1 class="bgh-title">{{ section.settings.heading }}</h1>

      {% if section.settings.subheading != blank %}
        <p class="bgh-subtitle">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank %}
        <div class="bgh-trust">
          {% if section.settings.trust_1 != blank %}<span class="bgh-trust-pill">{{ section.settings.trust_1 }}</span>{% endif %}
          {% if section.settings.trust_2 != blank %}<span class="bgh-trust-pill">{{ section.settings.trust_2 }}</span>{% endif %}
          {% if section.settings.trust_3 != blank %}<span class="bgh-trust-pill">{{ section.settings.trust_3 }}</span>{% endif %}
        </div>
      {% endif %}

      {% if section.settings.cta_primary_text != blank or section.settings.cta_secondary_text != blank %}
        <div class="bgh-ctas">
          {% if section.settings.cta_primary_text != blank %}
            <a href="{{ section.settings.cta_primary_url | default: '#' }}" class="bgh-btn bgh-btn--primary">{{ section.settings.cta_primary_text }}</a>
          {% endif %}
          {% if section.settings.cta_secondary_text != blank %}
            <a href="{{ section.settings.cta_secondary_url | default: '#' }}" class="bgh-btn bgh-btn--secondary">{{ section.settings.cta_secondary_text }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
    {% render 'guide-editorial-review' %}
  </xo-container>
</section>

<script>
(function() {
  var bar = document.querySelector('[data-bgh-bar]');
  if (!bar) return;
  var ticking = false;
  window.addEventListener('scroll', function() {
    if (!ticking) {
      requestAnimationFrame(function() {
        var scrollTop = window.scrollY || window.pageYOffset;
        var docHeight = document.body.scrollHeight - window.innerHeight;
        var pct = Math.max(0, Math.min(1, scrollTop / (docHeight || 1)));
        bar.style.transform = 'scaleX(' + pct.toFixed(4) + ')';
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });
})();
</script>

{% schema %}
{
  "name": "Beginners Guide Hero",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beginner's Guide to Nootropics" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "A conservative, education-first path for understanding labels, evidence limits, contraindications, and when to ask a healthcare professional." },
    { "type": "text", "id": "author_name", "label": "Legacy author (not displayed)", "info": "Use page metafield custom.author for a real named author or reviewer." },
    { "type": "text", "id": "read_time", "label": "Reading Time", "default": "12 min read" },
    { "type": "text", "id": "date_published", "label": "Legacy published date (not displayed)", "info": "Use page metafield custom.last_reviewed for a genuine review date." },
    { "type": "header", "content": "Trust Signals" },
    { "type": "text", "id": "trust_1", "label": "Trust Signal 1", "default": "Education before products" },
    { "type": "text", "id": "trust_2", "label": "Trust Signal 2", "default": "One decision at a time" },
    { "type": "text", "id": "trust_3", "label": "Trust Signal 3", "default": "Labels take precedence" },
    { "type": "header", "content": "Call to Action" },
    { "type": "text", "id": "cta_primary_text", "label": "Primary CTA Text", "default": "Start with the basics" },
    { "type": "url", "id": "cta_primary_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "cta_secondary_text", "label": "Secondary CTA Text", "default": "Review safety cues" },
    { "type": "url", "id": "cta_secondary_url", "label": "Secondary CTA URL" },
    { "type": "header", "content": "Section Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "presets": [{ "name": "Beginners Guide Hero" }]
}
{% endschema %}
