    {
      "type": "range",
      "id": "image_scale",
      "label": "Product image size",
      "min": 80,
      "max": 140,
      "step": 5,
      "unit": "%",
      "default": 120
    },
    {
      "type": "header",
      "content": "Copy",
      "info": "Leave text empty to use the translated default copy."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "line_one",
