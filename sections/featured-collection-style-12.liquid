{{ 'section-featured-collection-style-12.css' | asset_url | stylesheet_tag }}

{% liquid
  assign data_source = section.settings.data_source
  assign button_text = section.settings.button_text
  assign products_limit = section.settings.products_limit | default: 8

  if data_source == 'product_list'
    assign products = section.settings.product_list
  else
    assign products = section.settings.collection.products
  endif
%}

<section {% render 'section-attr' %}>
  <div class="featured-collection-style-12">
    <xo-container class="featured-collection-style-12__container">
      <div
        xo-grid
        class="featured-collection-style-12__grid xo-grid-block"
        style="--xo-col-desktop: 2; --xo-col-tablet: 1; --xo-col-mobile: 1; --xo-col-gap-desktop: 2.8rem; --xo-row-gap-mobile: 3.2rem"
      >
        <xo-item class="featured-collection-style-12__media">
          <xo-animate xo-cascade>
            {% render 'image',
              image: section.settings.image,
              aspect_ratio: section.settings.image_aspect_ratio,
              class: 'featured-collection-style-12__image'
            %}
          </xo-animate>
        </xo-item>

        <xo-item class="featured-collection-style-12__panel">
          <xo-carousel
            class="featured-collection-style-12__carousel"
            xo-active-index="0"
            xo-per-view="2"
            xo-gap="32"
            xo-overflow="visible"
            xo-speed="400"
            xo-breakpoints="
              {
                768: { perView: 1, gap: 12 },
                992: { perView: 2 }
              }
            "
          >
            <div class="featured-collection-style-12__head">
              <div class="featured-collection-style-12__head-text">
                {% render 'text', context: section %}
                {% if button_text != blank %}
                  <div class="featured-collection-style-12__button">
                    {% render 'button',
                      text: section.settings.button_text,
                      link: section.settings.button_link,
                      style: section.settings.button_style,
                      size: section.settings.button_size,
                      radius: settings.button_radius,
                      padding: settings.button_padding
                    %}
                  </div>
                {% endif %}
              </div>

              <div class="featured-collection-style-12__nav">
                <xo-carousel-prev
                  class="featured-collection-style-12__nav-btn"
                  role="button"
                  tabindex="0"
                  aria-label="{{ 'general.slider.previous_slide' | t }}"
                >
                  {% render 'button-slide', icon: 'arrow-left', icon_size: '2.8rem', size: '5.6rem', direction: 'left', style: 'gray' %}
                </xo-carousel-prev>
                <xo-carousel-next
                  class="featured-collection-style-12__nav-btn"
                  role="button"
                  tabindex="0"
                  aria-label="{{ 'general.slider.next_slide' | t }}"
                >
                  {% render 'button-slide', icon: 'arrow-right', icon_size: '2.8rem', size: '5.6rem', direction: 'right', style: 'gray' %}
                </xo-carousel-next>
              </div>
            </div>

            <xo-carousel-inner class="featured-collection-style-12__viewport">
              <xo-carousel-list class="featured-collection-style-12__list">
                {% if products != blank and products.size > 0 %}
                  {% for product in products limit: products_limit %}
                    <xo-carousel-slide class="featured-collection-style-12__slide">
                      {% render 'product-card',
                        product: product,
                        show_image: settings.product_card_show_image,
                        show_secondary_image: settings.product_card_show_secondary_image,
                        show_vendor: settings.product_card_show_vendor,
                        show_description: settings.product_card_show_description,
                        show_quick_add: settings.product_card_show_quick_add,
                        show_quick_view: settings.product_card_show_quick_view,
                        show_favorite: settings.product_card_show_favorite,
                        show_price: settings.product_card_show_price,
                        show_badge: settings.product_card_show_badge,
                        media_aspect_ratio: section.settings.product_card_aspect_ratio,
                        color_scheme: section.settings.card_color_scheme,
                        placeholder_image: 'collection-1',
                        animate_enabled: true
                      %}
                    </xo-carousel-slide>
                  {% endfor %}
                {% else %}
                  {% for i in (1..4) %}
                    <xo-carousel-slide class="featured-collection-style-12__slide">
                      {% render 'product-card',
                        product: empty,
                        show_image: settings.product_card_show_image,
                        show_price: settings.product_card_show_price,
                        show_badge: settings.product_card_show_badge,
                        media_aspect_ratio: section.settings.product_card_aspect_ratio,
                        color_scheme: section.settings.card_color_scheme,
                        placeholder_image: 'collection-1',
                        animate_enabled: true
                      %}
                    </xo-carousel-slide>
                  {% endfor %}
                {% endif %}
              </xo-carousel-list>
            </xo-carousel-inner>
          </xo-carousel>
        </xo-item>
      </div>
    </xo-container>
  </div>
</section>

