{{ 'section-shop-the-look-duo.css' | asset_url | stylesheet_tag }}

{% liquid
  assign aspect_ratio = section.settings.aspect_ratio
  if aspect_ratio == 'custom'
    assign aspect_ratio = section.settings.aspect_ratio_width | append: '/' | append: section.settings.aspect_ratio_height
  endif
  assign point_type = section.settings.point_type
  assign point_size = section.settings.point_size
%}

<section {% render 'section-attr' %}>
  <div class="shop-the-look-duo" xo-popover-boundary>
    <xo-container class="shop-the-look-duo__container">
      <div class="shop-the-look-duo__head">
        {% render 'text', context: section %}
      </div>

      <div class="shop-the-look-duo__grid">
        {% assign columns = '1,2' | split: ',' %}
        {% for col in columns %}
          {% liquid
            assign image_key = 'image_' | append: col
            assign image = section.settings[image_key]
          %}
          <div class="shop-the-look-duo__col">
            <div class="shop-the-look-duo__media{% if settings.enable_border_radius %} shop-the-look-duo__media--radius{% endif %}">
              <xo-animate xo-cascade>
                {% render 'image',
                  image: image,
                  aspect_ratio: aspect_ratio,
                  class: 'shop-the-look-duo__media-el'
                %}
              </xo-animate>

              {% for block in section.blocks %}
                {% if block.settings.column == col %}
                  {% liquid
                    assign top_dt = block.settings.top_dt
                    assign top_mb = block.settings.top_mb
                    assign left_dt = block.settings.left_dt
                    assign left_mb = block.settings.left_mb
                    assign color = block.settings.hotspot_color
                    assign timer_delay = block.settings.timer_delay
                  %}
                  <div
                    class="shop-the-look-duo__hotspot"
                    style="--top_dt: {{ top_dt }}; --left_dt: {{ left_dt }}; --top_mb: {{ top_mb }}; --left_mb: {{ left_mb }}"
                    {{ block.shopify_attributes }}
                  >
                    {% render 'shop-look-2',
                      product: block.settings.product,
                      placement: block.settings.placement,
                      type: 'click',
                      size: point_size,
                      color: color,
                      timer_delay: timer_delay
                    %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    </xo-container>
  </div>
</section>

