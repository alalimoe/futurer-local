{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .xo-section--{{ section.id }} .qcta__card {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-3, 2rem);
    padding: clamp(32px, 5vw, 56px) clamp(20px, 4vw, 48px);
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 14px;
    background: color-mix(in srgb, rgba(var(--color-accent)) 6%, rgba(var(--color-background)));
  }

  .xo-section--{{ section.id }} .qcta__eyebrow {
    font-size: 1.2rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 60%, transparent);
    margin: 0;
  }

  .xo-section--{{ section.id }} .qcta__heading {
    font-size: clamp(2.2rem, 3vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: rgba(var(--color-foreground));
    margin: 0;
    max-width: 24ch;
  }

  .xo-section--{{ section.id }} .qcta__text {
    font-size: 1.5rem;
    line-height: 1.6;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 70%, transparent);
    margin: 0;
    max-width: 52ch;
  }

  .xo-section--{{ section.id }} .qcta__button {
    margin-top: 8px;
  }

  .xo-section--{{ section.id }} .qcta__note {
    font-size: 1.2rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    margin: 0;
  }
{%- endstyle -%}

<section {% render 'section-attr' %}>
  <xo-container>
    <div class="qcta__card">
      {% if section.settings.eyebrow != blank %}
        <p class="qcta__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="qcta__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <p class="qcta__text">{{ section.settings.text }}</p>
      {% endif %}
      <div class="qcta__button">
        {% render 'button',
          text: section.settings.button_label,
          link: section.settings.button_link,
          style: 'primary'
        %}
      </div>
      {% if section.settings.note != blank %}
        <p class="qcta__note">{{ section.settings.note }}</p>
      {% endif %}
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "Quiz CTA",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Not sure where to start?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your stack in 60 seconds" },
    { "type": "text", "id": "text", "label": "Text", "default": "Answer a few quick questions about your goals and we'll match you with the right nootropics, no guesswork." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Take the Quiz" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Free. No signup needed." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 24 }
  ],
  "presets": [{ "name": "Quiz CTA" }]
}
{% endschema %}
