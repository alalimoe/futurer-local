{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: rgba(var(--color-background-2));
  }

  .xo-section--{{ section.id }} .qcta__inner {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1.6rem;
  }

  .xo-section--{{ section.id }} .qcta__eyebrow {
    font-size: 1.3rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    margin: 0;
  }

  .xo-section--{{ section.id }} .qcta__heading {
    font-size: clamp(2.8rem, 4vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: rgba(var(--color-foreground));
    margin: 0;
    max-width: 18ch;
  }

  .xo-section--{{ section.id }} .qcta__text {
    font-size: 1.6rem;
    line-height: 1.65;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
    margin: 0;
    max-width: 48ch;
  }

  .xo-section--{{ section.id }} .qcta__button {
    margin-top: 0.8rem;
  }

  .xo-section--{{ section.id }} .qcta__note {
    font-size: 1.3rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    margin: 0;
  }
{%- endstyle -%}

<section {% render 'section-attr' %}>
  <xo-container>
    <div class="qcta__inner">
      {% if section.settings.eyebrow != blank %}
        <p class="qcta__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 class="qcta__heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}
        <p class="qcta__text">{{ section.settings.text | escape }}</p>
      {% endif %}
      <div class="qcta__button">
        {% render 'button',
          text: section.settings.button_label,
          link: section.settings.button_link,
          style: 'primary'
        %}
      </div>
      {% if section.settings.note != blank %}
        <p class="qcta__note">{{ section.settings.note | escape }}</p>
      {% endif %}
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "Quiz CTA",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Not sure where to start?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your stack in 60 seconds" },
    { "type": "text", "id": "text", "label": "Text", "default": "Answer a few quick questions about your goals and we'll match you with the right nootropics, no guesswork." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Take the Quiz" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Small note", "default": "Free. No signup needed." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "presets": [{ "name": "Quiz CTA" }]
}
{% endschema %}
