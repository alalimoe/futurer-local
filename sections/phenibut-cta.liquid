{% comment %}
  Closing CTA — XO theme design system
  - Focus-visible, reduced-motion, srcset for packshot
{% endcomment %}

{%- style -%}
.xo-section--{{ section.id }} xo-animate { display: block; }
.xo-section--{{ section.id }} { scroll-margin-top: 96px; }
@media (max-width: 768px) { .xo-section--{{ section.id }} { scroll-margin-top: 80px; } }
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    /* Gradient flipped relative to the hero (to → from) to bookend the page */
    background: linear-gradient(180deg, {{ section.settings.gradient_to }} 0%, {{ section.settings.gradient_from }} 100%);
    color: rgba(var(--color-background));
    position: relative;
    overflow: clip;
  }

  .xo-section--{{ section.id }} .phb-cta__container {
    text-align: center;
    position: relative;
  }

  .xo-section--{{ section.id }} .phb-cta__title {
    font-size: clamp(2.8rem, 5vw, 5.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 0.8rem;
    font-weight: 600;
    color: rgba(var(--color-background));
    text-wrap: balance;
  }

  .xo-section--{{ section.id }} .phb-cta__sub {
    font-size: clamp(1.6rem, 2.2vw, 1.8rem);
    color: color-mix(in srgb, rgba(var(--color-background)) 90%, transparent);
    margin-bottom: 1.2rem;
  }

  .xo-section--{{ section.id }} .phb-cta__buttons {
    display: flex;
    gap: 1.2rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .xo-section--{{ section.id }} .phb-cta__urgency {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.6rem 0 0;
    font-size: 1.4rem;
    font-weight: 600;
    color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .phb-cta__packshot {
    position: absolute;
    right: max(1.6rem, 6%);
    bottom: 0.8rem;
    width: clamp(16rem, 26vw, 34rem);
    height: auto;
    pointer-events: none;
    opacity: 0.95;
  }

  @media (max-width: 768px) {
    .xo-section--{{ section.id }} .phb-cta__packshot {
      display: {% if section.settings.packshot_hide_mobile %}none{% else %}block{% endif %};
      right: 1.2rem;
      width: clamp(14rem, 44vw, 26rem);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ section.id }} *,
    .xo-section--{{ section.id }} *::before,
    .xo-section--{{ section.id }} *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
{%- endstyle -%}

<section {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}" {% endif %}{% render 'section-attr' %} aria-labelledby="phb-cta-title-{{ section.id }}">
  <xo-container>
    <xo-animate xo-type="fade-up" class="phb-cta__container">
      <h2 id="phb-cta-title-{{ section.id }}" class="phb-cta__title">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.subhead != blank %}
        <div class="phb-cta__sub">{{ section.settings.subhead }}</div>
      {% endif %}

      <div class="phb-cta__buttons">
        {% if section.settings.primary_label != blank and section.settings.primary_href != blank %}
          {% render 'button', style: 'primary', text: section.settings.primary_label, link: section.settings.primary_href %}
        {% endif %}
        {% if section.settings.secondary_label != blank and section.settings.secondary_href != blank %}
          {% render 'button', style: 'light', text: section.settings.secondary_label, link: section.settings.secondary_href %}
        {% endif %}
      </div>

      {% if section.settings.urgency_text != blank %}
        <p class="phb-cta__urgency">
          {% render 'icon', name: 'shipping-fast', size: '1.6rem' %}
          {{ section.settings.urgency_text | escape }}
        </p>
      {% endif %}

      {% if section.settings.packshot_image != blank %}
        <img
          class="phb-cta__packshot"
          src="{{ section.settings.packshot_image | image_url: width: 900 }}"
          srcset="{{ section.settings.packshot_image | image_url: width: 400 }} 400w, {{ section.settings.packshot_image | image_url: width: 600 }} 600w, {{ section.settings.packshot_image | image_url: width: 900 }} 900w"
          sizes="(max-width: 768px) 44vw, 26vw"
          width="{{ section.settings.packshot_image.width | default: 900 }}"
          height="{{ section.settings.packshot_image.height | default: 900 }}"
          alt="{% unless section.settings.packshot_decorative %}{{ section.settings.packshot_alt | escape }}{% endunless %}"
          {% if section.settings.packshot_decorative %}role="presentation" aria-hidden="true"{% endif %}
          loading="lazy" decoding="async"
        >
      {% endif %}
    </xo-animate>
  </xo-container>
</section>

{% schema %}
{
  "name": "Closing CTA",
  "tag": "section",
  "class": "section-phenibut-cta",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "closing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Calm, Rest, Reset — delivered fast." },
    { "type": "richtext", "id": "subhead", "label": "Subhead", "default": "<p>Lab‑tested quality • 4‑hour delivery in Dubai • Express worldwide • Free express shipping 300 AED+</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary CTA label", "default": "Shop Phenibut" },
    { "type": "text", "id": "primary_href", "label": "Primary CTA href", "default": "#shop-phenibut" },
    { "type": "text", "id": "secondary_label", "label": "Secondary CTA label", "default": "Compare Forms" },
    { "type": "text", "id": "secondary_href", "label": "Secondary CTA href", "default": "#forms" },
    { "type": "text", "id": "urgency_text", "label": "Trust/urgency subline", "default": "Ships today from Dubai — order by 6pm" },
    { "type": "color", "id": "gradient_from", "label": "Gradient from", "default": "#0A2342" },
    { "type": "color", "id": "gradient_to", "label": "Gradient to", "default": "#CFE7E7" },
    { "type": "image_picker", "id": "packshot_image", "label": "Decorative packshot image" },
    { "type": "text", "id": "packshot_alt", "label": "Packshot alt text", "default": "Phenibut bottles" },
    { "type": "checkbox", "id": "packshot_decorative", "label": "Mark packshot decorative (hide from screen readers)", "default": true },
    { "type": "checkbox", "id": "packshot_hide_mobile", "label": "Hide packshot on mobile", "default": true },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [ { "name": "Closing CTA" } ]
}
{% endschema %}
