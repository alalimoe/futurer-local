{% comment %}
  Nootropics 101 — hairline accordion explainer with per-item CTAs, disclaimer, and optional FAQ JSON-LD.
{% endcomment %}

{{ 'faq-hairline.css' | asset_url | stylesheet_tag }}

<section {% render 'section-attr' %}>
  <xo-container>
    <div class="faq-hairline__layout">
      <header class="faq-hairline__intro">
        {% render 'section-heading',
          heading: section.settings.heading,
          description: section.settings.subheading,
          heading_tag: 'h2',
          align: 'left',
          font_size_mobile: 32,
          font_size_desktop: 48
        %}
      </header>

      <div class="faq-hairline__body">
        <div class="faq-hairline">
          {% for block in section.blocks %}
            <article
              class="faq-hairline__item"
              id="{{ block.settings.anchor | default: block.id }}"
              {{ block.shopify_attributes }}
            >
              <details class="faq-hairline__row" {% if block.settings.open_by_default %}open{% endif %}>
                <summary class="faq-hairline__summary">
                  <h3 class="faq-hairline__question">{{ block.settings.title | escape }}</h3>
                </summary>
                <div class="faq-hairline__answer rte">
                  {{ block.settings.answer }}

                  {% if block.settings.cta_label != blank and block.settings.cta_url != blank %}
                    <div class="faq-hairline__cta">
                      {% render 'button',
                        text: block.settings.cta_label,
                        link: block.settings.cta_url,
                        style: section.settings.cta_style
                      %}
                    </div>
                  {% endif %}
                </div>
              </details>
            </article>
          {% endfor %}
        </div>

        {% if section.settings.show_disclaimer and section.settings.disclaimer_text != blank %}
          <aside class="faq-hairline__disclaimer">
            <small>{{ section.settings.disclaimer_text }}</small>
          </aside>
        {% endif %}
      </div>
    </div>
  </xo-container>
</section>

{% if section.settings.enable_faq_schema and section.blocks.size > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for block in section.blocks %}
          {
            "@type": "Question",
            "name": {{ block.settings.title | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "Nootropics 101",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Nootropics 101"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Short, clear answers to the questions people ask most."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show icons in card headers",
      "info": "Unused in the hairline list layout. Kept for Theme Editor compatibility.",
      "default": false
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "default": "link",
      "options": [
        { "value": "link", "label": "Text link" },
        { "value": "secondary", "label": "Button (secondary)" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_disclaimer",
      "label": "Show compliance disclaimer",
      "default": false
    },
    {
      "type": "richtext",
      "id": "disclaimer_text",
      "label": "Disclaimer text",
      "default": "<p>This content is for educational purposes only and is not a substitute for professional medical advice. Consult a qualified healthcare professional before use, especially if you take medication, are pregnant or nursing, or have a medical condition.</p>"
    },
    {
      "type": "checkbox",
      "id": "enable_faq_schema",
      "label": "Output FAQ schema (JSON-LD)",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Desktop top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Q&A card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question / Card title",
          "default": "What are nootropics?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer (120–180 words)",
          "default": "<p>Nootropics are nutrients, plant extracts and synthetics that support aspects of cognition such as focus, attention, memory, motivation and stress resilience. They are not a single drug class. Common groups include cholinergics (for example Alpha-GPC and CDP-Choline), amino acids (L-Theanine, N-Acetyl-L-Tyrosine), adaptogens (Rhodiola, Lion's Mane) and racetams. As with any supplement, quality and dosing matter. Look for products made in cGMP facilities with third-party testing to verify identity, potency and purity. Results vary by individual and goal, and no product is a substitute for sleep, nutrition, hydration and movement. If you are new, start with one simple, well-studied ingredient and evaluate how you feel over a couple of weeks before adding anything else.</p>"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon (only used if icons enabled)",
          "default": "brain",
          "options": [
            { "value": "brain", "label": "Brain" },
            { "value": "shield", "label": "Shield" },
            { "value": "rocket", "label": "Rocket" },
            { "value": "layers", "label": "Layers" }
          ]
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": true
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Read the beginner's guide"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA link"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Anchor ID (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nootropics 101 (Explainer)",
      "blocks": [
        { "type": "qa" },
        { "type": "qa" },
        { "type": "qa" },
        { "type": "qa" }
      ]
    }
  ]
}
{% endschema %}
