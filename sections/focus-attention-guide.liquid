{%- liquid
  assign s = section.settings
  assign focus_collection = collections['focus-attention']
  assign focus_href = routes.all_products_collection_url
  if focus_collection != blank
    assign focus_href = focus_collection.url
  endif

  comment
    Legacy handle settings remain in the schema for Theme Editor compatibility.
    Recommendations intentionally resolve only from product pickers.
  endcomment
  assign products_seen = ''
  assign product_count = 0
-%}

{%- style -%}
  #focus-guide-{{ section.id }} {
    background: {{ s.background_color | default: '#ffffff' }};
    color: rgba(var(--color-foreground));
  }
  #focus-guide-{{ section.id }} .fg-inner {
    max-width: {{ s.max_width | default: 1100 }}px;
    margin: 0 auto;
    padding: {{ s.padding_y | default: 56 }}px var(--page-gutter);
  }
  #focus-guide-{{ section.id }} .fg-hero,
  #focus-guide-{{ section.id }} .fg-panel {
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    margin-bottom: 1.5rem;
  }
  #focus-guide-{{ section.id }} .fg-hero { background: rgba(var(--color-background-2)); }
  #focus-guide-{{ section.id }} h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  #focus-guide-{{ section.id }} h2 { margin: 0 0 0.75rem; }
  #focus-guide-{{ section.id }} p,
  #focus-guide-{{ section.id }} li { line-height: 1.7; }
  #focus-guide-{{ section.id }} .fg-muted {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 68%, transparent);
  }
  #focus-guide-{{ section.id }} .fg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  #focus-guide-{{ section.id }} .fg-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
  }
  #focus-guide-{{ section.id }} .fg-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }
  #focus-guide-{{ section.id }} .fg-card a,
  #focus-guide-{{ section.id }} .fg-collection-link {
    margin-top: auto;
    color: rgba(var(--color-foreground));
    font-weight: 600;
    text-underline-offset: 0.25em;
  }
  #focus-guide-{{ section.id }} details {
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    padding: 0.8rem 0;
  }
  #focus-guide-{{ section.id }} summary { cursor: pointer; font-weight: 600; }
  #focus-guide-{{ section.id }} :focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }
{%- endstyle -%}

<section id="focus-guide-{{ section.id }}" aria-labelledby="focus-title-{{ section.id }}">
  <div class="fg-inner">
    <header class="fg-hero">
      <h1 id="focus-title-{{ section.id }}">{{ s.hero_title | default: 'Focus & Attention: An Evidence-Aware Guide' }}</h1>
      <p class="fg-muted">{{ s.hero_subtitle | default: 'Learn how to compare focus-related products without assuming a guaranteed outcome or following a universal stack.' }}</p>
    </header>

    {% render 'guide-editorial-review' %}

    <section class="fg-panel" aria-labelledby="focus-method-{{ section.id }}">
      <h2 id="focus-method-{{ section.id }}">What the evidence can and cannot say</h2>
      <ul>
        <li>Sleep, stress, workload, health conditions, and medication can all affect attention.</li>
        <li>Evidence quality varies by ingredient, formulation, population, and outcome; mechanistic findings do not prove a real-world benefit.</li>
        <li>A product category or customer experience is not evidence that a product will work for you.</li>
        <li>Current product labels, warnings, and professional advice take precedence over this editorial guide.</li>
      </ul>
    </section>

    <section class="fg-panel" aria-labelledby="focus-safety-{{ section.id }}">
      <h2 id="focus-safety-{{ section.id }}">Contraindication and interaction cues</h2>
      <p>Ask a qualified healthcare professional or pharmacist before use if you take medication, have a health condition, are pregnant or nursing, are under 18, or are sensitive to stimulants. Check total caffeine from all sources and consider anxiety, sleep disruption, heart-rate or blood-pressure concerns, and current sport or local rules.</p>
      <p><strong>This guide does not prescribe a stack, dose, timing plan, or cycle.</strong></p>
    </section>

    <section class="fg-panel" aria-labelledby="focus-products-{{ section.id }}">
      <h2 id="focus-products-{{ section.id }}">Merchant-selected product references</h2>
      <p class="fg-muted">A card appears only when its product picker resolves to a currently available product. The card links to the live product page for the current label and warnings.</p>
      <div class="fg-grid">
        {%- assign focus_product = s.stack_product -%}
        {%- if focus_product != blank and focus_product.available -%}
          {%- assign product_count = product_count | plus: 1 -%}
          {%- assign products_seen = products_seen | append: '|' | append: focus_product.id | append: '|' -%}
          <article class="fg-card">
            {%- if focus_product.featured_image -%}
              {{ focus_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: focus_product.title }}
            {%- endif -%}
            <h3>{{ focus_product.title }}</h3>
            <p class="fg-muted">Review the product's current ingredients, directions, warnings, and availability.</p>
            <a href="{{ focus_product.url }}">Review product label</a>
          </article>
        {%- endif -%}

        {%- assign focus_product = s.theanine_product -%}
        {%- assign focus_token = '|' | append: focus_product.id | append: '|' -%}
        {%- if focus_product != blank and focus_product.available -%}
          {%- unless products_seen contains focus_token -%}
          {%- assign product_count = product_count | plus: 1 -%}
          {%- assign products_seen = products_seen | append: focus_token -%}
          <article class="fg-card">
            {%- if focus_product.featured_image -%}
              {{ focus_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: focus_product.title }}
            {%- endif -%}
            <h3>{{ focus_product.title }}</h3>
            <p class="fg-muted">Check total stimulant exposure, contraindications, and the current label.</p>
            <a href="{{ focus_product.url }}">Review product label</a>
          </article>
          {%- endunless -%}
        {%- endif -%}

        {%- assign focus_product = s.choline_product -%}
        {%- assign focus_token = '|' | append: focus_product.id | append: '|' -%}
        {%- if focus_product != blank and focus_product.available -%}
          {%- unless products_seen contains focus_token -%}
          {%- assign product_count = product_count | plus: 1 -%}
          {%- assign products_seen = products_seen | append: focus_token -%}
          <article class="fg-card">
            {%- if focus_product.featured_image -%}
              {{ focus_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: focus_product.title }}
            {%- endif -%}
            <h3>{{ focus_product.title }}</h3>
            <p class="fg-muted">Use the live label to assess ingredients, warnings, and suitability.</p>
            <a href="{{ focus_product.url }}">Review product label</a>
          </article>
          {%- endunless -%}
        {%- endif -%}

        {%- assign focus_product = s.lion_product -%}
        {%- assign focus_token = '|' | append: focus_product.id | append: '|' -%}
        {%- if focus_product != blank and focus_product.available -%}
          {%- unless products_seen contains focus_token -%}
          {%- assign product_count = product_count | plus: 1 -%}
          <article class="fg-card">
            {%- if focus_product.featured_image -%}
              {{ focus_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: focus_product.title }}
            {%- endif -%}
            <h3>{{ focus_product.title }}</h3>
            <p class="fg-muted">Review the exact formulation and evidence rather than inferring an outcome from the ingredient name.</p>
            <a href="{{ focus_product.url }}">Review product label</a>
          </article>
          {%- endunless -%}
        {%- endif -%}
      </div>
      {%- if product_count == 0 -%}
        <p><a class="fg-collection-link" href="{{ focus_href }}">Browse the current Focus &amp; Attention collection</a></p>
      {%- endif -%}
    </section>

    {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
    {%- if faq_blocks.size > 0 -%}
      <section class="fg-panel" aria-labelledby="focus-faq-{{ section.id }}">
        <h2 id="focus-faq-{{ section.id }}">Frequently asked questions</h2>
        {%- for block in faq_blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.q }}</summary>
            <p>{{ block.settings.a }}</p>
          </details>
        {%- endfor -%}
      </section>
    {%- endif -%}

    <p class="fg-muted">Educational information only; not medical advice and not intended to diagnose, treat, cure, or prevent disease.</p>
  </div>
</section>

{% schema %}
{
  "name": "Focus & Attention Guide",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_title", "label": "Hero title", "default": "Focus & Attention: An Evidence-Aware Guide" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Hero subtitle", "default": "Learn how to compare focus-related products without assuming a guaranteed outcome or following a universal stack." },
    { "type": "image_picker", "id": "hero_image", "label": "Legacy hero image (not displayed)" },
    { "type": "header", "content": "Product references" },
    { "type": "product", "id": "stack_product", "label": "Featured product (picker)" },
    { "type": "text", "id": "stack_product_handle", "label": "Legacy backup handle (not used)", "info": "Retained for compatibility. Select a product above instead." },
    { "type": "text", "id": "bundle_title", "label": "Legacy featured title (not used)" },
    { "type": "range", "id": "subscribe_discount", "min": 0, "max": 30, "step": 1, "unit": "%", "label": "Legacy subscription value (not displayed)", "default": 0 },
    { "type": "product", "id": "theanine_product", "label": "Product reference 1" },
    { "type": "text", "id": "theanine_handle", "label": "Legacy backup handle (not used)", "info": "Retained for compatibility. Select a product above instead." },
    { "type": "product", "id": "choline_product", "label": "Product reference 2" },
    { "type": "text", "id": "choline_handle", "label": "Legacy backup handle (not used)", "info": "Retained for compatibility. Select a product above instead." },
    { "type": "product", "id": "lion_product", "label": "Product reference 3" },
    { "type": "text", "id": "lion_handle", "label": "Legacy backup handle (not used)", "info": "Retained for compatibility. Select a product above instead." },
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 800, "max": 1400, "step": 20, "default": 1100 },
    { "type": "range", "id": "padding_y", "label": "Vertical padding (px)", "min": 32, "max": 120, "step": 4, "default": 56 },
    { "type": "header", "content": "Legacy SEO" },
    { "type": "text", "id": "date_published", "label": "Legacy date (not used)", "info": "Use page custom.last_reviewed for a genuine review date." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "q", "label": "Question", "default": "Does this guide prescribe a focus stack?" },
        { "type": "textarea", "id": "a", "label": "Answer", "default": "No. It explains evidence and safety questions to review. Follow current product labels and qualified professional advice." }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    { "name": "Focus & Attention Guide", "category": "Nootropix Guides" }
  ]
}
{% endschema %}
