{% comment %} NX Flagship FAQ — accordion + FAQPage JSON-LD. {% endcomment %}

{{ 'nx-flagship.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign faq_list = nil
  if product.metafields.npx.faq and product.metafields.npx.faq.value
    assign faq_list = product.metafields.npx.faq.value
  endif

  assign faq_block_has_content = false
  for block in section.blocks
    if block.type == 'faq_item' and block.settings.question != blank and block.settings.answer != blank
      assign faq_block_has_content = true
      break
    endif
  endfor
-%}

{%- style -%}
  .xo-section--{{ section.id }} .nxf-faq__title {
    font-family: var(--font-heading-family, sans-serif);
    font-weight: 600;
    font-size: clamp(1.8rem, 2vw, 2.2rem);
    margin: 0 0 1.4rem;
    color: rgba(var(--color-foreground));
  }
  .xo-section--{{ section.id }} details {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-3, 2rem);
    background: rgba(var(--color-background));
    margin-bottom: 1rem;
    overflow: hidden;
  }
  .xo-section--{{ section.id }} details[open] {
    border-color: color-mix(in srgb, rgba(var(--color-accent)) 30%, transparent);
  }
  .xo-section--{{ section.id }} summary {
    list-style: none;
    cursor: pointer;
    padding: 1.4rem 1.6rem;
    font-family: var(--font-heading-family, sans-serif);
    font-weight: 600;
    font-size: calc(var(--font-body-scale, 1) * 1.5rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.2rem;
    min-height: 44px;
  }
  .xo-section--{{ section.id }} summary::-webkit-details-marker { display: none; }
  .xo-section--{{ section.id }} summary:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }
  .xo-section--{{ section.id }} .nxf-faq__ans {
    padding: 0 1.6rem 1.6rem;
    font-size: calc(var(--font-body-scale, 1) * 1.4rem);
    line-height: 1.6;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
  }
{%- endstyle -%}

<section id="nx-faq" {% render 'section-attr' %} class="nx-flagship nx-flagship__anchor nx-flagship__section">
  <xo-container>
    <div class="nx-flagship__wrap">
      <h2 class="nxf-faq__title">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h2>

      {% if faq_list and faq_list.size > 0 %}
        {% for f in faq_list %}
          <details class="nx-flagship__card" {% if forloop.first %}open{% endif %}>
            <summary><span>{{ f.question }}</span></summary>
            <div class="nxf-faq__ans">{{ f.answer | metafield_tag }}</div>
          </details>
        {% endfor %}
      {% elsif faq_block_has_content %}
        {%- assign faq_opened = false -%}
        {% for block in section.blocks %}
          {% if block.type == 'faq_item' %}
            {% assign bq = block.settings.question %}
            {% assign ba = block.settings.answer %}
            {% if bq != blank and ba != blank %}
              <details class="nx-flagship__card" {% unless faq_opened %}open{% endunless %} {{ block.shopify_attributes }}>
                <summary><span>{{ bq }}</span></summary>
                <div class="nxf-faq__ans rte">{{ ba }}</div>
              </details>
              {% assign faq_opened = true %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% else %}
        {% for i in (1..8) %}
          {% assign q_key = 'q' | append: i %}
          {% assign a_key = 'a' | append: i %}
          {% assign q = section.settings[q_key] %}
          {% assign a = section.settings[a_key] %}
          {% if q != blank and a != blank %}
            <details class="nx-flagship__card" {% if forloop.first %}open{% endif %}>
              <summary><span>{{ q }}</span></summary>
              <div class="nxf-faq__ans">{{ a }}</div>
            </details>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </xo-container>
</section>

{%- capture faq_json -%}
[
  {%- if faq_list and faq_list.size > 0 -%}
    {%- for f in faq_list -%}
      {"@type":"Question","name":{{ f.question | strip | json }},"acceptedAnswer":{"@type":"Answer","text":{{ f.answer | metafield_tag | strip | json }}}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  {%- elsif faq_block_has_content -%}
    {%- assign jf = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq_item' -%}
        {%- assign bq = block.settings.question -%}
        {%- assign ba = block.settings.answer -%}
        {%- if bq != blank and ba != blank -%}
          {%- if jf == false -%},{%- endif -%}
          {"@type":"Question","name":{{ bq | strip | json }},"acceptedAnswer":{"@type":"Answer","text":{{ ba | strip | json }}}}
          {%- assign jf = false -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- assign first = true -%}
    {%- for i in (1..8) -%}
      {%- assign q_key = 'q' | append: i -%}
      {%- assign a_key = 'a' | append: i -%}
      {%- assign q = section.settings[q_key] -%}
      {%- assign a = section.settings[a_key] -%}
      {%- if q != blank and a != blank -%}
        {%- if first == false -%},{%- endif -%}
        {"@type":"Question","name":{{ q | strip | json }},"acceptedAnswer":{"@type":"Answer","text":{{ a | strip | json }}}}
        {%- assign first = false -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
]
{%- endcapture -%}
<script type="application/ld+json">
{ "@context":"https://schema.org", "@type":"FAQPage", "mainEntity": {{ faq_json | strip }} }
</script>

{% schema %}
{
  "name": "NX Flagship — FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "header", "content": "Legacy Q&A (used if no blocks or metafield)" },
    { "type": "text", "id": "q1", "label": "Question 1", "default": "Who is Baseline for?" },
    { "type": "richtext", "id": "a1", "label": "Answer 1", "default": "<p>Baseline is designed for adults seeking a daily foundation for cognitive clarity and cellular energy — whether you're managing a demanding workload, studying, or simply optimizing your baseline performance.</p>" },
    { "type": "text", "id": "q2", "label": "Question 2", "default": "Can I take it with coffee?" },
    { "type": "richtext", "id": "a2", "label": "Answer 2", "default": "<p>Yes. L-Theanine is included specifically to smooth stimulant effects. Many users pair Baseline with their morning coffee for calm, focused energy.</p>" },
    { "type": "text", "id": "q3", "label": "Question 3", "default": "Do I need to cycle Baseline?" },
    { "type": "richtext", "id": "a3", "label": "Answer 3", "default": "<p>Baseline is formulated for daily use. Most ingredients are well-tolerated long-term. If you prefer cycling, consider 5 days on / 2 days off.</p>" },
    { "type": "text", "id": "q4", "label": "Question 4", "default": "Morning or evening?" },
    { "type": "richtext", "id": "a4", "label": "Answer 4", "default": "<p>Take with your morning meal. The energy-supporting ingredients are best suited to daytime use.</p>" },
    { "type": "text", "id": "q5", "label": "Question 5", "default": "Is it safe if I'm on medication?" },
    { "type": "richtext", "id": "a5", "label": "Answer 5", "default": "<p>Consult your healthcare provider before starting any supplement, especially if pregnant, nursing, or taking prescription medications.</p>" },
    { "type": "text", "id": "q6", "label": "Question 6", "default": "How is it shipped in the UAE?" },
    { "type": "richtext", "id": "a6", "label": "Answer 6", "default": "<p>Orders dispatch same-day from Dubai with express delivery across the UAE and worldwide shipping available.</p>" },
    { "type": "text", "id": "q7", "label": "Question 7", "default": "What is your return policy?" },
    { "type": "richtext", "id": "a7", "label": "Answer 7", "default": "<p>We offer a satisfaction guarantee on unopened products. Contact our support team if Baseline isn't right for you.</p>" },
    { "type": "text", "id": "q8", "label": "Question 8", "default": "Can I stack Baseline with other nootropics?" },
    { "type": "richtext", "id": "a8", "label": "Answer 8", "default": "<p>Baseline works as a foundation stack. You can layer targeted nootropics on top — start one addition at a time to assess tolerance.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },
    { "type": "number", "id": "padding_top_desktop", "label": "Padding top desktop", "default": 48 },
    { "type": "number", "id": "padding_bottom_desktop", "label": "Padding bottom desktop", "default": 48 },
    { "type": "number", "id": "padding_top_mobile", "label": "Padding top mobile", "default": 32 },
    { "type": "number", "id": "padding_bottom_mobile", "label": "Padding bottom mobile", "default": 32 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "NX Flagship — FAQ" }]
}
{% endschema %}
