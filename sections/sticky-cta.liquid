{% comment %}
  Sticky CTA (Mobile) — XO theme design system
  - Fixed position bar, safe-area-inset, reduced-motion
{% endcomment %}

{%- liquid
  assign product = section.settings.product
  assign primary_label = section.settings.primary_label
  assign primary_href = section.settings.primary_href
  if product != blank
    assign variant = product.selected_or_first_available_variant
    if variant == blank or variant.available == false
      assign primary_label = section.settings.sold_out_label
      if primary_label == blank
        assign primary_label = 'products.product.sold_out' | t
      endif
    endif
  endif
-%}

{%- style -%}
  .xo-section--{{ section.id }} {
    --sticky-cta-gap: calc(var(--page-gap-mobile, 2.4) * 1rem);
    --sticky-cta-pad-top: {{ section.settings.padding_top }}px;
    --sticky-cta-pad-bottom: {{ section.settings.padding_bottom }}px;
    --sticky-cta-reserve: 6.8rem;
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    gap: 1rem;
    padding: max(1rem, var(--sticky-cta-pad-top)) var(--sticky-cta-gap) calc(max(1rem, var(--sticky-cta-pad-bottom)) + env(safe-area-inset-bottom));
    background: color-mix(in srgb, rgba(var(--color-foreground)) 96%, transparent);
  }

  .xo-section--{{ section.id }} .sticky-cta__mobile {
    display: contents;
  }

  .xo-section--{{ section.id }} .sticky-cta__desktop,
  .xo-section--{{ section.id }} .sticky-cta__apps {
    display: none;
  }

  .xo-section--{{ section.id }} .xo-btn {
    flex: 1 1 12rem;
    min-width: 0;
    min-height: 4.8rem;
    height: auto;
    white-space: normal;
  }

  .xo-section--{{ section.id }} .xo-btn--secondary {
    --color-secondary-button: var(--color-background);
    --color-secondary-button-text: var(--color-background);
    border-color: rgba(var(--color-background));
    color: rgba(var(--color-background));
    background: transparent;
  }

  .xo-section--{{ section.id }} .xo-btn--secondary:hover {
    opacity: 0.85;
  }

  @media (max-width: 767px) {
    .xo-section--{{ section.id }} {
      display: flex;
      flex-wrap: wrap;
      align-items: stretch;
      transition: transform 180ms ease, visibility 180ms ease;
    }

    .xo-section--{{ section.id }}[data-mobile-hidden="true"] {
      visibility: hidden;
      pointer-events: none;
      transform: translateY(110%);
    }

    {% if section.settings.reserve_space_mobile %}
    body:has(.xo-section--{{ section.id }}) {
      padding-bottom: calc(var(--sticky-cta-reserve) + env(safe-area-inset-bottom));
    }
    {% endif %}
  }

  {% if section.settings.desktop_navigation %}
    @media (min-width: 768px) {
      #shopify-section-{{ section.id }} {
        position: sticky;
        top: var(--sticky-header-offset, 5.2rem);
        z-index: 40;
      }

      .xo-section--{{ section.id }} {
        --sticky-cta-gap: calc(var(--page-gap, 2.4) * 1rem);
        position: static;
        display: block;
        padding: 0;
        background: rgb(var(--color-background));
        border-top: 0.1rem solid rgba(var(--color-foreground), 0.12);
        border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.12);
      }

      .xo-section--{{ section.id }} .sticky-cta__mobile {
        display: none;
      }

      .xo-section--{{ section.id }} .sticky-cta__desktop {
        display: grid;
        grid-template-columns: minmax(0, auto) minmax(0, 1fr) minmax(0, auto);
        align-items: center;
        gap: 1.6rem 2.4rem;
        width: 100%;
        max-width: 128rem;
        min-height: 6rem;
        margin: 0 auto;
        padding: max(0.6rem, var(--sticky-cta-pad-top)) var(--sticky-cta-gap) max(0.6rem, var(--sticky-cta-pad-bottom));
      }

      .xo-section--{{ section.id }} .sticky-cta__product {
        margin: 0;
        font-size: 1.3rem;
        font-weight: 700;
        overflow-wrap: anywhere;
      }

      .xo-section--{{ section.id }} .sticky-cta__nav-list {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .xo-section--{{ section.id }} .sticky-cta__nav-link {
        display: inline-flex;
        align-items: center;
        min-height: 4.8rem;
        padding: 0 1.2rem;
        color: rgb(var(--color-foreground));
        font-size: 1.2rem;
        font-weight: 600;
        text-decoration: none;
      }

      .xo-section--{{ section.id }} .sticky-cta__nav-link:hover,
      .xo-section--{{ section.id }} .sticky-cta__nav-link:focus-visible {
        text-decoration: underline;
        text-underline-offset: 0.4rem;
      }

      .xo-section--{{ section.id }} .sticky-cta__desktop > .xo-btn {
        flex: none;
        min-height: 4.8rem;
      }

      .xo-section--{{ section.id }} .sticky-cta__apps {
        display: block;
      }
    }
  {% endif %}

  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ section.id }} *,
    .xo-section--{{ section.id }} *::before,
    .xo-section--{{ section.id }} *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
{%- endstyle -%}

<section
  {% render 'section-attr' %}
  id="sticky-cta-{{ section.id }}"
  aria-label="{{ 'sections.sticky_cta.actions_label' | t }}"
  data-show-after="{{ section.settings.show_after_id | escape }}"
  data-hide-at="{{ section.settings.hide_at_id | escape }}"
  {% if section.settings.show_after_id != blank %}data-mobile-hidden="true"{% endif %}
>
  <div class="sticky-cta__mobile">
    {% render 'button', style: 'primary', text: primary_label, link: primary_href %}
    {% render 'button', style: 'secondary', text: section.settings.secondary_label, link: section.settings.secondary_href %}
  </div>

  {%- if section.settings.desktop_navigation -%}
    <div class="sticky-cta__desktop">
      <p class="sticky-cta__product">{{ section.settings.product_label | default: product.title | escape }}</p>
      <nav aria-label="{{ 'sections.sticky_cta.navigation_label' | t }}">
        <ul class="sticky-cta__nav-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'link' and block.settings.label != blank and block.settings.href != blank -%}
              <li {{ block.shopify_attributes }}>
                <a class="sticky-cta__nav-link" href="{{ block.settings.href | escape }}">{{ block.settings.label | escape }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
      {% render 'button', style: 'primary', text: primary_label, link: primary_href %}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <div class="sticky-cta__apps" {{ block.shopify_attributes }}>{% render block %}</div>
    {%- endif -%}
  {%- endfor -%}
</section>

<script>
  (() => {
    const barId = 'sticky-cta-{{ section.id }}';
    const mobileQuery = window.matchMedia('(max-width: 767px)');
    let cleanup = () => {};

    const measureHeaderOffset = () => {
      const header = document.querySelector('.shopify-section-group-header-group, header, [data-header]');
      const height = header ? Math.round(header.getBoundingClientRect().height) : 52;
      document.documentElement.style.setProperty('--sticky-header-offset', `${height}px`);
    };

    const measureReserve = (bar) => {
      if (!mobileQuery.matches || bar.dataset.mobileHidden === 'true') return;
      const height = Math.ceil(bar.getBoundingClientRect().height);
      if (height > 0) {
        bar.style.setProperty('--sticky-cta-reserve', `${height}px`);
      }
    };

    const bind = () => {
      cleanup();
      const bar = document.getElementById(barId);
      if (!bar) return;

      measureHeaderOffset();

      const start = document.getElementById(bar.dataset.showAfter);
      const stop = document.getElementById(bar.dataset.hideAt);
      let hidden = bar.dataset.mobileHidden === 'true';
      let queued = false;
      const observers = [];

      const setHidden = (next) => {
        if (hidden === next) return;
        hidden = next;
        bar.dataset.mobileHidden = String(next);
      };

      const update = () => {
        queued = false;
        measureHeaderOffset();
        if (!mobileQuery.matches) {
          bar.removeAttribute('data-mobile-hidden');
          return;
        }
        if (!start && !stop) {
          setHidden(false);
          measureReserve(bar);
          return;
        }
        const afterStart = !start || start.getBoundingClientRect().bottom <= 0;
        const reachedStop = Boolean(stop && stop.getBoundingClientRect().top <= window.innerHeight);
        setHidden(!afterStart || reachedStop);
        measureReserve(bar);
      };

      const requestUpdate = () => {
        if (queued) return;
        queued = true;
        window.requestAnimationFrame(update);
      };

      update();

      if ('IntersectionObserver' in window && (start || stop)) {
        const observer = new IntersectionObserver(requestUpdate, { threshold: [0, 1] });
        if (start) observer.observe(start);
        if (stop) observer.observe(stop);
        observers.push(observer);
      }

      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate);

      cleanup = () => {
        window.removeEventListener('scroll', requestUpdate);
        window.removeEventListener('resize', requestUpdate);
        observers.forEach((observer) => observer.disconnect());
        cleanup = () => {};
      };
    };

    const onMediaChange = () => bind();

    const start = () => {
      bind();
      if (mobileQuery.addEventListener) {
        mobileQuery.addEventListener('change', onMediaChange);
      } else {
        mobileQuery.addListener(onMediaChange);
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.target && event.target.contains(document.getElementById(barId))) {
        cleanup();
        if (mobileQuery.removeEventListener) {
          mobileQuery.removeEventListener('change', onMediaChange);
        } else {
          mobileQuery.removeListener(onMediaChange);
        }
      }
    });

    document.addEventListener('shopify:section:load', (event) => {
      if (event.target && event.target.querySelector(`#${barId}`)) bind();
    });
  })();
</script>

{% schema %}
{
  "name": "Sticky CTA (Mobile)",
  "tag": "section",
  "class": "section-phb-sticky-cta",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "product", "id": "product", "label": "Product used for availability" },
    { "type": "text", "id": "product_label", "label": "Desktop product label" },
    { "type": "text", "id": "primary_label", "label": "Primary label", "default": "Shop Phenibut" },
    { "type": "text", "id": "sold_out_label", "label": "Sold-out label", "default": "Join restock list" },
    { "type": "text", "id": "primary_href", "label": "Primary link (URL or #anchor)", "default": "#shop-phenibut" },
    { "type": "text", "id": "secondary_label", "label": "Secondary label", "default": "Safety" },
    { "type": "text", "id": "secondary_href", "label": "Secondary link (URL or #anchor)", "default": "#safety" },
    { "type": "checkbox", "id": "reserve_space_mobile", "label": "Reserve bottom space on mobile", "default": true },
    { "type": "checkbox", "id": "desktop_navigation", "label": "Show desktop jump navigation", "default": false },
    { "type": "text", "id": "show_after_id", "label": "Show mobile bar after element ID", "info": "Enter an element ID without #. Leave blank to show immediately." },
    { "type": "text", "id": "hide_at_id", "label": "Hide mobile bar while element ID is visible", "info": "Enter an element ID without #." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 0 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Desktop navigation link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Formula" },
        { "type": "text", "id": "href", "label": "Anchor or URL", "default": "#nx01-formula" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [ { "name": "Sticky CTA (Mobile)" } ]
}
{% endschema %}
