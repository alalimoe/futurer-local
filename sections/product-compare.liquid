{{ 'section-product-compare.css' | asset_url | stylesheet_tag }}

{% liquid
  assign show_colors = section.settings.show_colors | default: true, allow_false: true
  assign color_label = section.settings.color_label
  assign button_label = section.settings.button_label | default: 'View detail'
%}

<section {% render 'section-attr' %}>
  <div class="product-compare">
    <xo-container class="product-compare__container">
      {% if section.settings.text_heading != blank %}
        <div class="product-compare__head">
          {% render 'text', context: section %}
        </div>
      {% endif %}

      {%- liquid
        assign columns = section.blocks.size | at_most: 3
      -%}
      <xo-carousel
        class="product-compare__grid"
        xo-per-view="{{ columns }}"
        xo-gap="28"
        xo-overflow="visible"
        xo-speed="400"
        xo-breakpoints="
          {
            768: { perView: 1, gap: 12 }
          }
        "
      >
        <xo-carousel-inner class="product-compare__viewport">
        <xo-carousel-list class="product-compare__list">
        {% for block in section.blocks %}
          {% liquid
            assign product = block.settings.product
            assign button_link = block.settings.button_link | default: product.url

            assign color_option = null
            if show_colors and product != blank
              for option in product.options_with_values
                assign option_name = option.name | downcase
                if option_name contains 'color' or option_name contains 'colour'
                  assign color_option = option
                  break
                endif
              endfor
            endif
          %}
          <xo-carousel-slide class="product-compare__col" {{ block.shopify_attributes }}>
            <xo-animate xo-cascade class="product-compare__card">
              {% render 'product-card',
                product: product,
                show_image: true,
                show_price: true,
                show_vendor: false,
                show_rating: false,
                show_badge: false,
                show_quick_add: false,
                show_quick_view: false,
                animate_enabled: false,
                placeholder_image: 'product-apparel-1'
              %}
            </xo-animate>

            <div class="product-compare__specs">
              {% if block.settings.compatibility != blank %}
                <p class="product-compare__compat">{{ block.settings.compatibility }}</p>
              {% endif %}

              {% if color_option != blank %}
                <span class="product-compare__divider" aria-hidden="true"></span>
                <div class="product-compare__row product-compare__row--colors">
                  {% if color_label != blank %}
                    <p class="product-compare__row-label">{{ color_label }}</p>
                  {% endif %}
                  <div class="product-compare__swatches">
                    {% render 'product-variant-link', product: product, option: color_option %}
                  </div>
                </div>
              {% endif %}

              {% if block.settings.material_text != blank or block.settings.material_icon != blank %}
                <span class="product-compare__divider" aria-hidden="true"></span>
                <div class="product-compare__row product-compare__row--material">
                  {% if block.settings.material_icon != blank %}
                    <div class="product-compare__icon product-compare__icon--material">
                      {% render 'image', image: block.settings.material_icon, class: 'product-compare__icon-el' %}
                    </div>
                  {% endif %}
                  {% if block.settings.material_text != blank %}
                    <p class="product-compare__row-text">{{ block.settings.material_text }}</p>
                  {% endif %}
                </div>
              {% endif %}

              {% if block.settings.features != blank or block.settings.feature_icon != blank %}
                <span class="product-compare__divider" aria-hidden="true"></span>
                <div class="product-compare__row product-compare__row--features">
                  {% if block.settings.feature_icon != blank %}
                    <div class="product-compare__icon product-compare__icon--feature">
                      {% render 'image', image: block.settings.feature_icon, class: 'product-compare__icon-el' %}
                    </div>
                  {% endif %}
                  {% if block.settings.features != blank %}
                    <div class="product-compare__features rte">{{ block.settings.features }}</div>
                  {% endif %}
                </div>
              {% endif %}

              {% assign has_highlight = false %}
              {% if block.settings.highlight_1_text != blank or block.settings.highlight_2_text != blank or block.settings.highlight_3_text != blank %}
                {% assign has_highlight = true %}
              {% endif %}
              {% if has_highlight %}
                <span class="product-compare__divider" aria-hidden="true"></span>
                <div class="product-compare__highlights">
                  {% for i in (1..3) %}
                    {% liquid
                      assign icon_key = 'highlight_' | append: i | append: '_icon'
                      assign text_key = 'highlight_' | append: i | append: '_text'
                      assign hl_icon = block.settings[icon_key]
                      assign hl_text = block.settings[text_key]
                    %}
                    {% if hl_text != blank or hl_icon != blank %}
                      <div class="product-compare__highlight">
                        {% if hl_icon != blank %}
                          <div class="product-compare__icon product-compare__icon--highlight">
                            {% render 'image', image: hl_icon, class: 'product-compare__icon-el' %}
                          </div>
                        {% endif %}
                        {% if hl_text != blank %}
                          <p class="product-compare__highlight-text">{{ hl_text }}</p>
                        {% endif %}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              {% if button_link != blank %}
                <span class="product-compare__divider" aria-hidden="true"></span>
                <div class="product-compare__button">
                  {% render 'button', text: button_label, link: button_link, style: 'secondary', size: 'sm' %}
                </div>
              {% endif %}
            </div>
          </xo-carousel-slide>
        {% endfor %}
        </xo-carousel-list>
        </xo-carousel-inner>
      </xo-carousel>
    </xo-container>
  </div>
</section>

{% schema %}
