{% comment %} <div class="xo-quick-view-content">
  <xo-product
    class="d:contents xo-quick-view-content__product"
    xo-product-information
    xo-product-id="{{ product.id }}"
    xo-product-url="{{ shop.url }}{{ product.url }}"
    xo-section-id="{{ section.id }}"
    xo-selected-or-first-available-variant-id="{{ product.selected_or_first_available_variant.id }}"
  >
    <xo-product-will-change xo-unique-id="{{ section.id }}-product-variant-title">
      <template xo-product-variant-title>{{ product.selected_or_first_available_variant.title }}</template>
    </xo-product-will-change>
    <div class="xo-quick-view-content__container">
      {% render 'variant-option-modal-content', product: product %}
    </div>
    {% render 'product-data', product: product %}
    {% render 'product-quick-view-liquid-binding', product: product %}
  </xo-product>
  {% render 'main-product-ld-json' %}
</div> {% endcomment %}

{{ 'section-quick-view-content.css' | asset_url | stylesheet_tag }}
{{ 'product-info-content-quickview.css' | asset_url | stylesheet_tag }}
{{ 'product-info-media-quickview.css' | asset_url | stylesheet_tag }}
{{ '3d-model.css' | asset_url | stylesheet_tag }}

{% liquid
  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
%}

<div class="xo-main-product-quickview">
  <xo-product
    xo-product-information
    xo-product-id="{{ product.id }}"
    xo-section-id="{{ section.id }}"
    xo-product-url="{{ shop.url }}{{ product.url }}"
    xo-selected-or-first-available-variant-id="{{ product.selected_or_first_available_variant.id }}"
    class="xo-main-product-quickview__product"
  >
    <xo-product-will-change xo-unique-id="{{ section.id }}-product-variant-title">
      <template xo-product-variant-title>{{ product.selected_or_first_available_variant.title }}</template>
    </xo-product-will-change>
    <div class="xo-main-product-quickview__container">
      <xo-grid class="xo-main-product-quickview__grid">
        <div style="--xs: 12; --md: 12; --lg: 6" class="xo-main-product-quickview__media">
          {% render 'product-info-media-quickview', variant_images: variant_images %}
        </div>
        <div style="--xs: 12; --md: 12; --lg: 6" class="xo-main-product-quickview__content xo-scrollbar">
          {% render 'variant-option-modal-content', is_bundle: false, product: product %}
        </div>
      </xo-grid>
    </div>

    {% comment %} 3d model {% endcomment %}
    {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
    {%- if first_3d_model -%}
      <script type="application/json" id="xo-3d-product-json-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
    {%- endif -%}

    {% comment %} product helpers {% endcomment %}
    {% render 'product-data', product: product %}
    {% render 'product-quick-view-liquid-binding', product: product %}
    {% render 'main-product-ld-json', product: product %}
  </xo-product>
</div>

{% schema %}
{
  "tag": "section",
  "name": "Variant option modal",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay",
      "custom.popups",
      "custom.features"
    ]
  },
  "settings": []
}
{% endschema %}