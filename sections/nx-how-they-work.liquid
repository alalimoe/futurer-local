{%- assign sid = section.id -%}

{%- style -%}
#nx-how-{{ sid }} {
  max-width: var(--container-width-narrow);
  margin: 0 auto;
  padding: 8px 16px;
  font-family: var(--font-body-family, sans-serif);
  color: var(--color-text-main, #111827);
  line-height: 1.7;
  content-visibility: auto;
}
#nx-how-{{ sid }} h2 {
  font-family: var(--font-heading-family, sans-serif);
  font-size: clamp(22px, 3vw, 30px);
  font-weight: 700;
  line-height: 1.2;
  margin: 0 0 12px;
}
#nx-how-{{ sid }} ul { margin: 0; padding-left: 18px; }
#nx-how-{{ sid }} li { margin: 8px 0; color: var(--color-text-muted, #4b5563); }
#nx-how-{{ sid }} li strong { color: var(--color-text-main, #111827); }
#nx-how-{{ sid }} a {
  color: var(--color-accent-dark, #92400e);
  text-decoration: none;
  font-weight: 600;
  position: relative;
  transition: var(--transition-premium, all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1));
}
#nx-how-{{ sid }} a::after {
  content: "";
  position: absolute;
  left: 50%; right: 50%;
  bottom: -1px;
  height: 1.5px;
  background: var(--color-accent-primary, #FBBF24);
  transition: var(--transition-premium, all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1));
}
#nx-how-{{ sid }} a:hover { color: var(--color-text-main, #111827); }
#nx-how-{{ sid }} a:hover::after { left: 0; right: 0; }
#nx-how-{{ sid }} a:focus-visible {
  outline: 2px solid var(--color-accent-primary, #FBBF24);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  #nx-how-{{ sid }},
  #nx-how-{{ sid }} * {
    transition: none !important;
    animation: none !important;
    transform: none !important;
  }
}
{%- endstyle -%}

<section id="nx-how-{{ sid }}" aria-label="How racetams work">
  <h2>How Are Mechanisms Discussed?</h2>
  <ul>
    <li><strong>Mechanism is not outcome:</strong> laboratory findings about neurotransmitter or receptor pathways do not prove improved focus, memory, mood, or learning in people.</li>
    <li><strong>Evidence is compound-specific:</strong> findings for one racetam should not be generalized to another compound, formulation, or retail product.</li>
    <li><strong>Anecdotes are not clinical evidence:</strong> perceived effects and online reports cannot establish benefit, dose, safety, or the need for another product.</li>
  </ul>
</section>

{% schema %}
{
  "name": "NX — How They Work",
  "settings": [
    { "type": "product", "id": "alpha_gpc", "label": "Alpha-GPC (optional)" },
    { "type": "product", "id": "cdp_choline", "label": "CDP-Choline (optional)" }
  ],
  "presets": [{ "name": "NX — How They Work" }]
}
{% endschema %}
