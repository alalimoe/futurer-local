{%- liquid
  assign heading_id = 'npx-benefits-heading-' | append: section.id
  assign image = section.settings.image
  assign image_alt = section.settings.image_alt | strip
  if image_alt == blank
    assign image_alt = 'Nootropix NX-01 Baseline supplement bottle'
  endif
  assign show_image = section.settings.show_image
  assign asset_image = 'nx01-benefits-bottle.webp'
  assign has_image = false
  if show_image
    assign has_image = true
  endif

  assign point_count = 0
  for block in section.blocks
    if block.type == 'benefit'
      if block.settings.title != blank or block.settings.description != blank
        assign point_count = point_count | plus: 1
      endif
    endif
  endfor

  assign image_loading = 'lazy'
  if section.index != blank and section.index <= 2
    assign image_loading = 'eager'
  endif
-%}

<section
  id="nx01-benefits-{{ section.id }}"
  class="npx-benefits{% unless has_image %} npx-benefits--no-image{% endunless %}"
  style="--npx-benefits-bg: {{ section.settings.background_color }}; --npx-benefits-heading: {{ section.settings.heading_color }}; --npx-benefits-text: {{ section.settings.text_color }}; --npx-benefits-accent: {{ section.settings.accent_color }}; --npx-benefits-icon: {{ section.settings.icon_color }}; --npx-benefits-width: 1220px; --npx-benefits-top: {{ section.settings.padding_top }}px; --npx-benefits-bottom: {{ section.settings.padding_bottom }}px; --npx-benefits-heading-size: 42px; --npx-benefits-image-height: {{ section.settings.image_height }}px;"
  role="region"
  aria-labelledby="{{ heading_id }}"
>
  <div class="npx-benefits__inner">
    <header class="npx-benefits__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="npx-benefits__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="npx-benefits__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
      {%- else -%}
        <h2 class="npx-benefits__heading xo-visually-hidden" id="{{ heading_id }}">
          {{ 'sections.nx01_benefits.region_label' | t }}
        </h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="npx-benefits__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    {%- if has_image or point_count > 0 -%}
      <div class="npx-benefits__layout">
        {%- if has_image -%}
          <figure class="npx-benefits__figure npx-benefits__figure--blend">
            {%- if image != blank -%}
              {{
                image
                | image_url: width: 1000
                | image_tag:
                  class: 'npx-benefits__image',
                  loading: image_loading,
                  widths: '280, 360, 480, 640, 800, 1000',
                  sizes: '(max-width: 600px) 280px, (max-width: 960px) 320px, min(32vw, 400px)',
                  alt: image_alt,
                  width: image.width,
                  height: image.height,
                  decoding: 'async'
              }}
            {%- else -%}
              <img
                src="{{ asset_image | asset_url }}"
                class="npx-benefits__image"
                alt="{{ image_alt | escape }}"
                width="800"
                height="1200"
                loading="{{ image_loading }}"
                decoding="async"
              >
            {%- endif -%}
          </figure>
        {%- endif -%}

        {%- assign point_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            {%- if block.settings.title != blank or block.settings.description != blank -%}
              {%- assign point_i = point_i | plus: 1 -%}
              <article
                class="npx-benefits__point npx-benefits__point--{{ point_i }}"
                {{ block.shopify_attributes }}
              >
                <span class="npx-benefits__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'flask' -%}
                      <svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        <path d="M12 4h8m-6 0v10L7 24a2.5 2.5 0 0 0 2 4h14a2.5 2.5 0 0 0 2-4l-7-10V4M11 19h10"/>
                        <circle cx="14" cy="23" r=".8"/>
                        <circle cx="20" cy="25" r=".8"/>
                      </svg>
                    {%- when 'caffeine' -%}
                      <svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        <path d="M6 12h16v10a5 5 0 0 1-5 5h-6a5 5 0 0 1-5-5V12Zm16 2h2a4 4 0 0 1 0 8h-2M10 5v3m5-3v3M4 29 28 5"/>
                      </svg>
                    {%- when 'servings' -%}
                      <svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        <rect x="5" y="7" width="22" height="21" rx="3"/>
                        <path d="M10 4v6m12-6v6M5 14h22m-16 7 3 3 7-7"/>
                      </svg>
                    {%- else -%}
                      <svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                        <rect x="5" y="5" width="5" height="5" rx="1.3"/>
                        <rect x="13.5" y="5" width="5" height="5" rx="1.3"/>
                        <rect x="22" y="5" width="5" height="5" rx="1.3"/>
                        <rect x="5" y="13.5" width="5" height="5" rx="1.3"/>
                        <rect x="13.5" y="13.5" width="5" height="5" rx="1.3"/>
                        <rect x="22" y="13.5" width="5" height="5" rx="1.3"/>
                        <rect x="5" y="22" width="5" height="5" rx="1.3"/>
                        <rect x="13.5" y="22" width="5" height="5" rx="1.3"/>
                        <rect x="22" y="22" width="5" height="5" rx="1.3"/>
                      </svg>
                  {%- endcase -%}
                </span>
                <div class="npx-benefits__point-copy">
                  {%- if block.settings.title != blank -%}
                    <h3 class="npx-benefits__point-title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <div class="npx-benefits__description">{{ block.settings.description }}</div>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .npx-benefits {
    padding-block: var(--npx-benefits-top) var(--npx-benefits-bottom);
    padding-inline: 32px;
    border-block-start: 3px solid var(--npx-benefits-accent);
    background: var(--npx-benefits-bg);
    color: var(--npx-benefits-text);
    font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 16px;
    line-height: 1.65;
  }

  .npx-benefits *,
  .npx-benefits *::before,
  .npx-benefits *::after {
    box-sizing: border-box;
  }

  .npx-benefits .npx-benefits__inner {
    max-width: var(--npx-benefits-width);
    margin-inline: auto;
  }

  .npx-benefits .npx-benefits__header {
    max-width: 820px;
    margin: 0 auto 32px;
    text-align: center;
  }

  .npx-benefits .npx-benefits__eyebrow {
    margin: 0 0 13px;
    color: var(--npx-benefits-accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.5;
  }

  .npx-benefits .npx-benefits__heading {
    margin: 0;
    color: var(--npx-benefits-heading);
    font-family: var(--font-heading-family, var(--font-body-family, Arial, sans-serif));
    font-size: clamp(28px, 3.2vw, var(--npx-benefits-heading-size));
    font-style: normal;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.17;
    text-transform: none;
    overflow-wrap: anywhere;
  }

  .npx-benefits .npx-benefits__intro {
    max-width: 650px;
    margin: 17px auto 0;
    font-size: 16px;
    line-height: 1.7;
  }

  .npx-benefits .npx-benefits__intro p {
    margin: 0;
  }

  .npx-benefits .npx-benefits__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 400px) minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: 36px;
    align-items: center;
  }

  .npx-benefits .npx-benefits__figure {
    grid-column: 2;
    grid-row: 1 / span 2;
    position: relative;
    min-width: 0;
    margin: 0;
    align-self: center;
    text-align: center;
  }

  .npx-benefits .npx-benefits__image {
    display: block;
    width: 100%;
    height: var(--npx-benefits-image-height);
    margin: 0 auto;
    object-fit: contain;
    -webkit-mask-image: linear-gradient(to bottom, #000 88%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 88%, transparent 100%);
  }

  .npx-benefits .npx-benefits__figure--blend .npx-benefits__image {
    mix-blend-mode: multiply;
  }

  .npx-benefits .npx-benefits__point {
    min-width: 0;
    max-width: 350px;
    margin: 0;
    padding: 12px 0;
    text-align: center;
    justify-self: center;
  }

  .npx-benefits .npx-benefits__point--1 {
    grid-column: 1;
    grid-row: 1;
  }

  .npx-benefits .npx-benefits__point--2 {
    grid-column: 3;
    grid-row: 1;
  }

  .npx-benefits .npx-benefits__point--3 {
    grid-column: 1;
    grid-row: 2;
  }

  .npx-benefits .npx-benefits__point--4 {
    grid-column: 3;
    grid-row: 2;
  }

  .npx-benefits .npx-benefits__icon {
    display: flex;
    width: 62px;
    height: 62px;
    margin: 0 auto 20px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    background: var(--npx-benefits-accent);
    color: var(--npx-benefits-icon);
    flex: 0 0 62px;
  }

  .npx-benefits .npx-benefits__icon svg {
    display: block;
  }

  .npx-benefits .npx-benefits__point-title {
    margin: 0;
    color: var(--npx-benefits-heading);
    font-family: var(--font-heading-family, var(--font-body-family, Arial, sans-serif));
    font-size: 23px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
    text-transform: none;
    overflow-wrap: anywhere;
  }

  .npx-benefits .npx-benefits__description {
    margin: 15px 0 0;
    font-size: 15px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .npx-benefits .npx-benefits__description p {
    margin: 0;
  }

  .npx-benefits .npx-benefits__description p + p {
    margin-block-start: 0.7em;
  }

  .npx-benefits .npx-benefits__description a,
  .npx-benefits .npx-benefits__intro a {
    color: var(--npx-benefits-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .npx-benefits a:focus-visible {
    outline: 2px solid var(--npx-benefits-accent);
    outline-offset: 4px;
  }

  .npx-benefits.npx-benefits--no-image .npx-benefits__layout {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .npx-benefits.npx-benefits--no-image .npx-benefits__point {
    grid-column: auto;
    grid-row: auto;
  }

  @media (max-width: 960px) {
    .npx-benefits .npx-benefits__layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px 40px;
    }

    .npx-benefits .npx-benefits__figure {
      grid-column: 1 / -1;
      grid-row: auto;
      width: 320px;
      max-width: 100%;
      justify-self: center;
    }

    .npx-benefits .npx-benefits__image {
      height: min(var(--npx-benefits-image-height), 390px);
    }

    .npx-benefits .npx-benefits__point {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (max-width: 600px) {
    .npx-benefits {
      padding-inline: 22px;
      padding-block: min(var(--npx-benefits-top), 48px) min(var(--npx-benefits-bottom), 44px);
    }

    .npx-benefits .npx-benefits__header {
      margin-bottom: 20px;
    }

    .npx-benefits .npx-benefits__heading {
      font-size: min(var(--npx-benefits-heading-size), 32px);
    }

    .npx-benefits .npx-benefits__intro {
      margin-top: 14px;
      font-size: 15px;
    }

    .npx-benefits .npx-benefits__layout,
    .npx-benefits.npx-benefits--no-image .npx-benefits__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .npx-benefits .npx-benefits__figure {
      width: 280px;
    }

    .npx-benefits .npx-benefits__image {
      height: min(var(--npx-benefits-image-height), 330px);
    }

    .npx-benefits .npx-benefits__point {
      display: flex;
      gap: 16px;
      width: 100%;
      max-width: none;
      padding: 0;
      text-align: start;
      align-items: flex-start;
    }

    .npx-benefits .npx-benefits__icon {
      width: 46px;
      height: 46px;
      flex-basis: 46px;
      margin: 0;
    }

    .npx-benefits .npx-benefits__icon svg {
      width: 25px;
      height: 25px;
    }

    .npx-benefits .npx-benefits__point-copy {
      min-width: 0;
    }

    .npx-benefits .npx-benefits__point-title {
      font-size: 20px;
    }

    .npx-benefits .npx-benefits__description {
      margin-top: 10px;
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .npx-benefits *,
    .npx-benefits *::before,
    .npx-benefits *::after {
      animation: none !important;
      transition: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NX-01 benefits",
  "tag": "div",
  "class": "section-nx01-benefits",
  "enabled_on": {
    "templates": ["product", "page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY NX-01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your daily baseline. Simplified."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Nine ingredients. A caffeine-free formula. One straightforward routine.</p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show bottle image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bottle image",
      "info": "Leave empty to use the NX-01 bottle included with the theme."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 280,
      "max": 640,
      "step": 10,
      "unit": "px",
      "label": "Image height",
      "default": 520
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F3F7FC"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#142342"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4D5A70"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#243F95"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "grid", "label": "Nine-grid" },
            { "value": "flask", "label": "Flask" },
            { "value": "caffeine", "label": "Caffeine-free" },
            { "value": "servings", "label": "Servings" }
          ],
          "default": "grid"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "NX-01 benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "grid",
            "title": "Nine ingredients together",
            "description": "<p>Amino acids, coenzymes, Rhodiola and B vitamins, combined in one daily formula.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "flask",
            "title": "Named nutrient forms",
            "description": "<p>With ubiquinol CoQ10, plus B6 as P5P, B12 as methylcobalamin and folate as 5-MTHF.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "caffeine",
            "title": "Caffeine-free by design",
            "description": "<p>A caffeine-free formula that keeps your supplement routine separate from your coffee or tea.</p>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "servings",
            "title": "30 servings per bottle",
            "description": "<p>90 capsules per bottle. A serving of 3 capsules gives you 30 servings, with no powders to measure.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
