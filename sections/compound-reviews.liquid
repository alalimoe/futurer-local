{% render 'compound-guide-css' %}

{%- liquid
  assign cg_anchor = section.settings.anchor_id | default: 'reviews' | handleize
  assign scope_product = section.settings.product
  assign app_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_count = app_count | plus: 1
    endif
  endfor
-%}

{%- if section.settings.heading != blank or app_count > 0 -%}
<section
  id="{{ cg_anchor }}"
  {% render 'compound-section-attrs', section: section, base: 'cg-reviews' %}
  aria-labelledby="cg-reviews-heading-{{ section.id }}"
>
  <div class="cg__inner">
    <div class="cg__intro">
      {%- if section.settings.kicker != blank -%}
        <p class="cg__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cg__heading" id="cg-reviews-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="cg__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if scope_product != blank -%}
        <p class="cg-reviews__note">{{ 'sections.compound_guide.reviews_scope_product' | t: product: scope_product.title | escape }}</p>
      {%- endif -%}
    </div>

    {%- if app_count > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <p class="cg-range__error">{{ 'sections.compound_guide.reviews_empty' | t }}</p>
    {%- endif -%}

    {%- if scope_product != blank -%}
      <p>
        <a class="cg__text-link" href="{{ scope_product.url }}#judgeme_product_reviews">{{ 'sections.compound_guide.read_all_reviews' | t }}</a>
      </p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Compound reviews",
  "tag": "section",
  "class": "section-compound-reviews",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "reviews" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer experiences." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "product", "id": "product", "label": "Review-scope product", "info": "Judge.me only. Label the product these reviews belong to. Do not add editor ratings or sample quotes." },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "tone", "label": "Background", "options": [
      { "value": "paper", "label": "Paper" },
      { "value": "white", "label": "White" }
    ], "default": "paper" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [
      { "value": "small", "label": "Small" },
      { "value": "default", "label": "Default" },
      { "value": "large", "label": "Large" }
    ], "default": "default" },
    { "type": "select", "id": "intro_align", "label": "Intro alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "select", "id": "content_width", "label": "Content width", "options": [
      { "value": "narrow", "label": "Narrow" },
      { "value": "default", "label": "Default" },
      { "value": "wide", "label": "Wide" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "Scales the responsive section spacing. 100% is the theme default." },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "show_divider", "label": "Show top divider", "default": true, "info": "Hairline between this and the previous section." },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class", "info": "Optional hook for bespoke styling." }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [{ "name": "Compound reviews" }]
}
{% endschema %}
