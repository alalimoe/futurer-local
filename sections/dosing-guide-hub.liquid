{%- liquid
  assign dg_id = section.id
  assign dg_paths_id = 'guide-paths-' | append: dg_id
  assign dg_related_id = 'guide-related-' | append: dg_id
  assign dg_coa_page = pages['quality-coa-library']
  if dg_coa_page == empty
    assign dg_coa_page = pages['coa-library']
  endif
  if dg_coa_page != empty
    assign dg_coa_href = dg_coa_page.url
  else
    assign dg_coa_href = '/pages/quality-coa-library'
  endif
  assign dg_contact_page = pages['contact']
  if dg_contact_page != empty
    assign dg_contact_href = dg_contact_page.url
  else
    assign dg_contact_href = '/pages/contact'
  endif
  assign dg_coll = section.settings.collection
  if dg_coll == blank
    assign dg_coll = collections.all
  endif

  assign dg_manual = false
  assign dg_seen = ','
  assign dg_card_count = 0

  for block in section.blocks
    if block.type == 'product' and block.settings.product != blank
      assign dg_manual = true
      assign product = block.settings.product
      assign mf_dose = product.metafields.custom.dose
      assign mf_timing = product.metafields.custom.timing
      assign dg_key = ',' | append: product.handle | append: ','
      unless dg_seen contains dg_key
        if mf_dose != blank or mf_timing != blank
          assign dg_seen = dg_seen | append: product.handle | append: ','
          assign dg_card_count = dg_card_count | plus: 1
        endif
      endunless
    endif
  endfor

  assign dg_coll_2 = section.settings.collection_secondary
  assign dg_has_secondary = false
  if dg_coll_2 != blank
    unless dg_coll_2.handle == dg_coll.handle
      assign dg_sorted_2 = dg_coll_2.products | sort_natural: 'title'
      assign dg_has_secondary = true
    endunless
  endif

  unless dg_manual
    assign dg_sorted = dg_coll.products | sort_natural: 'title'
    assign dg_seen = ','
    assign dg_card_count = 0
    for product in dg_sorted
      unless product == empty
        assign mf_dose = product.metafields.custom.dose
        assign mf_timing = product.metafields.custom.timing
        assign dg_key = ',' | append: product.handle | append: ','
        unless dg_seen contains dg_key
          if mf_dose != blank or mf_timing != blank
            assign dg_seen = dg_seen | append: product.handle | append: ','
            assign dg_card_count = dg_card_count | plus: 1
          endif
        endunless
      endunless
    endfor
    if dg_has_secondary
      for product in dg_sorted_2
        unless product == empty
          assign mf_dose = product.metafields.custom.dose
          assign mf_timing = product.metafields.custom.timing
          assign dg_key = ',' | append: product.handle | append: ','
          unless dg_seen contains dg_key
            if mf_dose != blank or mf_timing != blank
              assign dg_seen = dg_seen | append: product.handle | append: ','
              assign dg_card_count = dg_card_count | plus: 1
            endif
          endunless
        endunless
      endfor
    endif
  endunless
-%}

{%- style -%}
  .xo-section--{{ dg_id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: rgba(var(--color-foreground));
  }
  .xo-section--{{ dg_id }} .dg__wrap {
    max-width: 880px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .xo-section--{{ dg_id }} .dg__wrap { max-width: 1120px; }
  }

  .xo-section--{{ dg_id }} .dg-catalog {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.4rem;
    column-gap: 10px;
    align-items: start;
  }
  .xo-section--{{ dg_id }} .dg-products { grid-column: 1; min-width: 0; }
  .xo-section--{{ dg_id }} .dg-noresults { grid-column: 1; }
  .xo-section--{{ dg_id }} .dg-index {
    grid-column: 2;
    grid-row: 1 / span 8;
    position: sticky;
    top: 96px;
    z-index: 4;
    align-self: start;
    max-height: calc(100dvh - 112px);
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, rgba(var(--color-foreground)) 25%, transparent) transparent;
    padding-block: 4px;
  }
  .xo-section--{{ dg_id }} .dg-index__title {
    display: none;
  }
  .xo-section--{{ dg_id }} .dg-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .xo-section--{{ dg_id }} .dg-index__item:not(.dg-index__item--letter-start) {
    display: none;
  }
  .xo-section--{{ dg_id }} .dg-index__item[hidden] {
    display: none !important;
  }
  .xo-section--{{ dg_id }} .dg-index__link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0;
    text-decoration: none;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
    border-radius: 0.5rem;
  }
  .xo-section--{{ dg_id }} .dg-index__link:hover {
    color: rgba(var(--color-foreground));
    background: color-mix(in srgb, rgba(var(--color-foreground)) 5%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-index__link:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }
  .xo-section--{{ dg_id }} .dg-index__item--active .dg-index__link {
    color: rgba(var(--color-foreground));
    background: color-mix(in srgb, rgba(var(--color-accent)) 16%, transparent);
    font-weight: 600;
  }
  .xo-section--{{ dg_id }} .dg-index__letter {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .xo-section--{{ dg_id }} .dg-index__name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .xo-section--{{ dg_id }} .dg-catalog {
      grid-template-columns: 22rem minmax(0, 1fr);
      column-gap: 24px;
    }
    .xo-section--{{ dg_id }} .dg-index {
      grid-column: 1;
      border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
      border-radius: var(--general-radius-1, 1rem);
      background: rgba(var(--color-background));
      padding: 16px 10px 16px 12px;
      max-height: calc(100dvh - 120px);
    }
    .xo-section--{{ dg_id }} .dg-products { grid-column: 2; }
    .xo-section--{{ dg_id }} .dg-noresults { grid-column: 2; }
    .xo-section--{{ dg_id }} .dg-index__title {
      display: block;
      margin: 0 8px 10px;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.09em;
      text-transform: uppercase;
      color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    }
    .xo-section--{{ dg_id }} .dg-index__item:not(.dg-index__item--letter-start) {
      display: list-item;
    }
    .xo-section--{{ dg_id }} .dg-index__item[hidden] { display: none; }
    .xo-section--{{ dg_id }} .dg-index__link {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      min-height: 44px;
      padding: 8px 10px;
      border-radius: 0.8rem;
      font-size: 0.88rem;
      line-height: 1.35;
    }
    .xo-section--{{ dg_id }} .dg-index__letter {
      display: none;
    }
    .xo-section--{{ dg_id }} .dg-index__item--letter-start .dg-index__letter {
      display: block;
      margin: 0 0 4px;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: rgba(var(--color-accent));
    }
    .xo-section--{{ dg_id }} .dg-index__name {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }
  }

  /* Breadcrumbs */
  .xo-section--{{ dg_id }} .rg-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    margin-bottom: clamp(16px, 3vw, 24px);
    font-size: calc(var(--font-body-scale, 1) * 1.3rem);
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
  }
  .xo-section--{{ dg_id }} .rg-breadcrumbs__link {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
    text-decoration: none;
  }
  .xo-section--{{ dg_id }} .rg-breadcrumbs__link:hover {
    color: rgba(var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .xo-section--{{ dg_id }} .rg-breadcrumbs__current {
    color: rgba(var(--color-foreground));
    font-weight: 600;
  }
  .xo-section--{{ dg_id }} .rg-breadcrumbs__sep {
    opacity: 0.45;
    user-select: none;
  }

  /* ── Hero ── */
  .xo-section--{{ dg_id }} .dg-hero {
    padding: clamp(8px, 2vw, 16px) 0 clamp(12px, 2vw, 20px);
  }
  .xo-section--{{ dg_id }} .dg-hero__eyebrow {
    display: inline-block;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(var(--color-accent));
    margin-bottom: 12px;
  }
  .xo-section--{{ dg_id }} .dg-hero__h1 {
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600; letter-spacing: -0.03em; line-height: 1.15;
    margin: 0 0 12px;
  }
  .xo-section--{{ dg_id }} .dg-hero__sub {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem); line-height: 1.7;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 60%, transparent);
    margin: 0 0 20px;
  }
  .xo-section--{{ dg_id }} .dg-hero__sub p { margin: 0 0 10px; }
  .xo-section--{{ dg_id }} .dg-hero__badges {
    display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px;
  }
  .xo-section--{{ dg_id }} .dg-hero__badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 13px;
    border-radius: var(--button-radius, 10rem);
    background: color-mix(in srgb, rgba(var(--color-accent)) 10%, transparent);
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase;
    white-space: nowrap;
  }
  .xo-section--{{ dg_id }} .dg-hero__badge-icon {
    width: 15px; height: 15px; flex-shrink: 0; color: rgba(var(--color-accent));
  }
  .xo-section--{{ dg_id }} .dg-hero__meta {
    display: flex; flex-wrap: wrap; gap: 8px 20px;
    font-size: 0.82rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 6%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-hero__meta-item { display: inline-flex; align-items: center; gap: 5px; }
  .xo-section--{{ dg_id }} .dg-hero__meta-icon { width: 14px; height: 14px; flex-shrink: 0; opacity: 0.55; }

  /* ── Generic zone heading ── */
  .xo-section--{{ dg_id }} .dg-zone { margin-bottom: clamp(40px, 6vw, 64px); }
  .xo-section--{{ dg_id }} .dg-zone__h2 {
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 600; letter-spacing: -0.025em; line-height: 1.15;
    margin: 0 0 20px; scroll-margin-top: 84px;
  }

  /* ── Zone 1: Universal principles ── */
  .xo-section--{{ dg_id }} .dg-principles {
    display: grid; grid-template-columns: 1fr; gap: 14px;
  }
  @media (min-width: 640px) {
    .xo-section--{{ dg_id }} .dg-principles { grid-template-columns: 1fr 1fr; }
  }
  .xo-section--{{ dg_id }} .dg-principle {
    display: flex; gap: 14px; align-items: flex-start;
    background: rgba(var(--color-background));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: 20px;
  }
  .xo-section--{{ dg_id }} .dg-principle__num {
    flex-shrink: 0; width: 30px; height: 30px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    background: rgba(var(--color-accent));
    color: rgba(var(--color-foreground));
    font-family: var(--font-heading-family, sans-serif);
    font-size: 0.85rem; font-weight: 700;
  }
  .xo-section--{{ dg_id }} .dg-principle__body { flex: 1; min-width: 0; }
  .xo-section--{{ dg_id }} .dg-principle__title {
    font-family: var(--font-heading-family, sans-serif);
    font-size: 0.98rem; font-weight: 600; line-height: 1.3; margin: 0 0 6px;
  }
  .xo-section--{{ dg_id }} .dg-principle__text {
    font-size: 0.88rem; line-height: 1.6; margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  }

  .xo-section--{{ dg_id }} .dg-principles-disclosure {
    margin-bottom: clamp(28px, 4vw, 40px);
  }
  .xo-section--{{ dg_id }} .dg-search-zone {
    margin-bottom: clamp(20px, 3vw, 28px);
  }
  .xo-section--{{ dg_id }} .dg-principles-disclosure__summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    margin-bottom: 16px;
  }
  .xo-section--{{ dg_id }} .dg-principles-disclosure__summary::-webkit-details-marker { display: none; }
  .xo-section--{{ dg_id }} .dg-principles-disclosure__summary .dg-zone__h2 {
    margin: 0;
  }
  .xo-section--{{ dg_id }} .dg-principles-disclosure__summary::after {
    content: '+';
    font-size: 1.2rem;
    font-weight: 400;
    flex-shrink: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 45%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-principles-disclosure[open] .dg-principles-disclosure__summary::after { content: '−'; }
  .xo-section--{{ dg_id }} .dg-search-zone { margin-bottom: clamp(20px, 3vw, 28px); }
  .xo-section--{{ dg_id }} .dg-search {
    position: sticky; top: 96px; z-index: 5;
    background: rgba(var(--color-background-2));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 7%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: 16px 18px;
  }
  .xo-section--{{ dg_id }} .dg-search__label {
    display: block;
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    margin: 0 0 10px;
  }
  .xo-section--{{ dg_id }} .dg-search__field {
    display: flex; align-items: center; gap: 10px;
    background: rgba(var(--color-background));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 14%, transparent);
    border-radius: var(--button-radius, 10rem);
    padding: 0 14px;
    transition: border-color 0.2s var(--out-soft, ease);
  }
  .xo-section--{{ dg_id }} .dg-search__field:focus-within { border-color: rgba(var(--color-accent)); }
  .xo-section--{{ dg_id }} .dg-search__icon {
    width: 17px; height: 17px; flex-shrink: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 45%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-search__input {
    flex: 1; min-width: 0;
    border: none; background: transparent; outline: none;
    padding: 12px 0;
    font-size: 0.95rem; color: rgba(var(--color-foreground)); font-family: inherit;
  }
  .xo-section--{{ dg_id }} .dg-search__input::-webkit-search-cancel-button { display: none; }
  .xo-section--{{ dg_id }} .dg-search__clear {
    flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center;
    width: 24px; height: 24px; padding: 0;
    border: none; border-radius: 50%; cursor: pointer;
    background: color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
    color: rgba(var(--color-foreground));
  }
  .xo-section--{{ dg_id }} .dg-search__clear svg { width: 13px; height: 13px; }
  .xo-section--{{ dg_id }} .dg-search__clear:hover { background: color-mix(in srgb, rgba(var(--color-foreground)) 18%, transparent); }
  .xo-section--{{ dg_id }} .dg-search__clear:focus-visible { outline: 2px solid rgba(var(--color-accent)); outline-offset: 2px; }
  .xo-section--{{ dg_id }} .dg-search__count {
    margin: 10px 2px 0; font-size: 0.78rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-search__hint {
    margin: 6px 2px 0;
    font-size: 0.72rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 50%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-search__hint kbd {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    background: color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-noresults a {
    display: inline-block;
    margin-top: 10px;
    color: rgba(var(--color-accent));
    font-weight: 600;
    text-decoration: none;
  }
  .xo-section--{{ dg_id }} .dg-noresults a:hover { text-decoration: underline; }

  /* ── Zone 3: Per-product cards ── */
  .xo-section--{{ dg_id }} .dg-products {
    display: flex; flex-direction: column; gap: 16px;
  }
  .xo-section--{{ dg_id }} .dg-product {
    scroll-margin-top: 160px;
    background: rgba(var(--color-background));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: clamp(20px, 3vw, 28px);
    transition: border-color 0.3s var(--out-soft, ease);
  }
  .xo-section--{{ dg_id }} .dg-product[hidden] { display: none !important; }
  .xo-section--{{ dg_id }} .dg-product:hover {
    border-color: color-mix(in srgb, rgba(var(--color-foreground)) 16%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-product__head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 16px; margin-bottom: 18px;
  }
  .xo-section--{{ dg_id }} .dg-product__h2 {
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 600; letter-spacing: -0.02em; line-height: 1.2;
    margin: 0;
    overflow-wrap: break-word;
  }
  .xo-section--{{ dg_id }} .dg-product__links {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }
  .xo-section--{{ dg_id }} .dg-product__link {
    display: inline-flex; align-items: center; gap: 5px;
    min-height: 44px;
    font-size: 0.82rem; font-weight: 600;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    text-decoration: none;
    white-space: nowrap;
  }
  .xo-section--{{ dg_id }} .dg-product__link--secondary {
    color: rgba(var(--color-accent));
  }
  .xo-section--{{ dg_id }} .dg-product__link:hover { text-decoration: underline; }
  .xo-section--{{ dg_id }} .dg-product__link:focus-visible {
    outline: 2px solid rgba(var(--color-accent)); outline-offset: 2px; border-radius: 4px;
  }
  .xo-section--{{ dg_id }} .dg-product__link svg { width: 13px; height: 13px; }

  .xo-section--{{ dg_id }} .dg-specs {
    display: grid; grid-template-columns: 1fr; gap: 0; margin: 0;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 6%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-spec {
    display: grid; grid-template-columns: 130px 1fr; gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 6%, transparent);
  }
  @media (max-width: 480px) {
    .xo-section--{{ dg_id }} .dg-spec { grid-template-columns: 1fr; gap: 2px; }
    .xo-section--{{ dg_id }} .dg-product__head { flex-direction: column; align-items: stretch; }
    .xo-section--{{ dg_id }} .dg-product__links { align-items: flex-start; }
    .xo-section--{{ dg_id }} .dg-product__link { white-space: normal; }
  }
  .xo-section--{{ dg_id }} .dg-spec__label {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    padding-top: 2px;
  }
  .xo-section--{{ dg_id }} .dg-spec__value {
    font-size: 1.02rem; line-height: 1.6;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 80%, transparent);
    margin: 0;
  }
  .xo-section--{{ dg_id }} .dg-badge {
    display: inline-block; padding: 3px 10px;
    border-radius: 0.5rem;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em;
    background: color-mix(in srgb, rgba(var(--color-accent)) 14%, transparent);
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-badge--muted {
    background: color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  }

  /* ── Per-card empty note ── */
  .xo-section--{{ dg_id }} .dg-empty-note {
    margin: 0; font-size: 0.85rem; line-height: 1.6;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 6%, transparent);
    padding-top: 12px;
  }
  .xo-section--{{ dg_id }} .dg-empty-note code {
    font-size: 0.8em;
    padding: 1px 5px; border-radius: 4px;
    background: color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }

  /* ── Empty state ── */
  .xo-section--{{ dg_id }} .dg-empty {
    background: rgba(var(--color-background-2));
    border: 1px dashed color-mix(in srgb, rgba(var(--color-foreground)) 18%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: 32px; text-align: center;
    font-size: 0.9rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 60%, transparent);
  }

  /* ── Disclaimer ── */
  .xo-section--{{ dg_id }} .dg-disclaimer {
    margin: clamp(32px, 5vw, 48px) 0 0;
    background: color-mix(in srgb, rgba(var(--color-error)) 7%, transparent);
    border-left: 4px solid rgba(var(--color-error));
    border-radius: 0 var(--general-radius-1, 1rem) var(--general-radius-1, 1rem) 0;
    padding: 16px 20px;
    display: flex; gap: 14px; align-items: flex-start;
  }
  .xo-section--{{ dg_id }} .dg-disclaimer__icon {
    width: 20px; height: 20px; flex-shrink: 0; color: rgba(var(--color-error)); margin-top: 2px;
  }
  .xo-section--{{ dg_id }} .dg-disclaimer__body {
    font-size: clamp(0.78rem, 1vw, 0.85rem); line-height: 1.65; color: rgba(var(--color-error));
  }
  .xo-section--{{ dg_id }} .dg-disclaimer__body p { margin: 0 0 6px; }
  .xo-section--{{ dg_id }} .dg-disclaimer__body p:last-child { margin-bottom: 0; }

  /* FAQ */
  .xo-section--{{ dg_id }} .dg-faq-zone {
    margin: clamp(40px, 6vw, 64px) 0 0;
  }
  .xo-section--{{ dg_id }} .dg-faq-zone__h2 {
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 20px;
    scroll-margin-top: 84px;
  }
  .xo-section--{{ dg_id }} .dg-faq {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .xo-section--{{ dg_id }} .dg-faq__item {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    overflow: hidden;
    background: rgba(var(--color-background));
  }
  .xo-section--{{ dg_id }} .dg-faq__summary {
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading-family, sans-serif);
    font-size: calc(var(--font-body-scale, 1) * 1.5rem);
    font-weight: 600;
    line-height: 1.4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
  }
  .xo-section--{{ dg_id }} .dg-faq__summary::-webkit-details-marker { display: none; }
  .xo-section--{{ dg_id }} .dg-faq__summary::after {
    content: '+';
    font-size: 1.2rem;
    font-weight: 400;
    flex-shrink: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 45%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-faq__item[open] .dg-faq__summary::after { content: '−'; }
  .xo-section--{{ dg_id }} .dg-faq__answer {
    padding: 0 20px 18px;
    font-size: calc(var(--font-body-scale, 1) * 1.45rem);
    line-height: 1.7;
    color: color-mix(in srgb, rgba(var(--color-foreground)) calc(var(--font-body-color-opacity, 0.75) * 100%), transparent);
  }
  .xo-section--{{ dg_id }} .dg-faq__answer p { margin: 0 0 10px; }
  .xo-section--{{ dg_id }} .dg-faq__answer p:last-child { margin-bottom: 0; }

  .xo-section--{{ dg_id }} .dg-index__link {
    transition: color 0.2s var(--out-soft, ease), background 0.2s var(--out-soft, ease);
  }

  .xo-section--{{ dg_id }} .dg-product__cycle-gap {
    margin: 12px 0 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ dg_id }} .dg-search__field,
    .xo-section--{{ dg_id }} .dg-product,
    .xo-section--{{ dg_id }} .dg-index__link { transition: none; }
  }
{%- endstyle -%}

<section {% render 'section-attr' %} data-guide-page="dosing">
  {% render 'guide-system' %}
  <xo-container>
    <div class="dg__wrap" data-guide-root data-guide-search-url="{{ routes.search_url }}" data-guide-noun="products">

      {% render 'reference-guide-breadcrumbs',
        parent_label: section.settings.breadcrumb_parent_label,
        parent_url: section.settings.breadcrumb_parent_url,
        current_label: section.settings.heading
      %}

      {% render 'guide-switcher', current: 'dosing' %}

      {%- comment -%} ═══ HERO (single H1) ═══ {%- endcomment -%}
      <header class="dg-hero">
        {%- if section.settings.eyebrow != blank -%}
          <span class="dg-hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="dg-hero__h1">{{ section.settings.heading }}</h1>

        {%- if section.settings.subtitle != blank -%}
          <div class="dg-hero__sub rte">{{ section.settings.subtitle }}</div>
        {%- endif -%}

        {%- if section.settings.badge_1_text != blank or section.settings.badge_2_text != blank or section.settings.badge_3_text != blank -%}
          <div class="dg-hero__badges" role="list">
            {%- if section.settings.badge_1_text != blank -%}
              <span class="dg-hero__badge" role="listitem">
                <svg class="dg-hero__badge-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                {{ section.settings.badge_1_text }}
              </span>
            {%- endif -%}
            {%- if section.settings.badge_2_text != blank -%}
              <span class="dg-hero__badge" role="listitem">
                <svg class="dg-hero__badge-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l7 4v5c0 5.25-3.5 9.74-7 11-3.5-1.26-7-5.75-7-11V6l7-4z"/><polyline points="9 12 11 14 15 10"/></svg>
                {{ section.settings.badge_2_text }}
              </span>
            {%- endif -%}
            {%- if section.settings.badge_3_text != blank -%}
              <span class="dg-hero__badge" role="listitem">
                <svg class="dg-hero__badge-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="12" y2="14"/></svg>
                {{ section.settings.badge_3_text }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.author != blank or section.settings.date_published != blank or section.settings.read_time != blank -%}
          <div class="dg-hero__meta">
            {%- if section.settings.author != blank -%}
              <span class="dg-hero__meta-item">
                <svg class="dg-hero__meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                {{ section.settings.author }}
              </span>
            {%- endif -%}
            {%- if section.settings.date_published != blank -%}
              <time class="dg-hero__meta-item" datetime="{{ section.settings.date_published }}">
                <svg class="dg-hero__meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                {{ section.settings.date_published | date: "%B %d, %Y" }}
              </time>
            {%- endif -%}
            {%- if section.settings.read_time != blank -%}
              <span class="dg-hero__meta-item">
                <svg class="dg-hero__meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {{ section.settings.read_time }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </header>

      {% render 'guide-orientation',
        answers: section.settings.answers_text,
        does_not: section.settings.does_not_text,
        note: section.settings.orientation_note
      %}

      {%- if dg_card_count > 0 -%}
        {%- assign dg_finder_id = 'dg-search-' | append: dg_id -%}
        {% render 'guide-finder',
          input_id: dg_finder_id,
          label: section.settings.jump_label,
          placeholder: section.settings.search_placeholder,
          controls: 'dosing-by-product'
        %}
        <div class="guide-rail" data-guide-rail role="toolbar" aria-label="Filter listed products">
          <button type="button" class="guide-rail__btn" data-guide-cat="" aria-pressed="true">
            <svg class="guide-rail__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
            All listed
          </button>
          <button type="button" class="guide-rail__btn" data-guide-cat="capsules" aria-pressed="false">
            <svg class="guide-rail__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="8" y="3" width="8" height="18" rx="4"/></svg>
            Capsules
          </button>
          <button type="button" class="guide-rail__btn" data-guide-cat="powder" aria-pressed="false">
            <svg class="guide-rail__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 8h10l-1 13H8L7 8z"/><path d="M9 8V5h6v3"/></svg>
            Powder
          </button>
          <button type="button" class="guide-rail__btn" data-guide-cat="has-cycle" aria-pressed="false">
            <svg class="guide-rail__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6"/><polyline points="4 4 4 12 12 12"/></svg>
            Has a cycling note
          </button>
          <button type="button" class="guide-rail__clear" data-guide-rail-clear hidden>Clear filter</button>
        </div>
      {%- endif -%}

      {% render 'guide-pathways',
        heading: section.settings.pathways_heading,
        heading_id: dg_paths_id,
        p1_title: section.settings.p1_title,
        p1_for: section.settings.p1_for,
        p1_answers: section.settings.p1_answers,
        p1_learn: section.settings.p1_learn,
        p1_leads: section.settings.p1_leads,
        p1_limit: section.settings.p1_limit,
        p1_href: section.settings.p1_href,
        p2_title: section.settings.p2_title,
        p2_for: section.settings.p2_for,
        p2_answers: section.settings.p2_answers,
        p2_learn: section.settings.p2_learn,
        p2_leads: section.settings.p2_leads,
        p2_limit: section.settings.p2_limit,
        p2_href: section.settings.p2_href,
        p3_title: section.settings.p3_title,
        p3_for: section.settings.p3_for,
        p3_answers: section.settings.p3_answers,
        p3_learn: section.settings.p3_learn,
        p3_leads: section.settings.p3_leads,
        p3_limit: section.settings.p3_limit,
        p3_href: section.settings.p3_href,
        p4_title: section.settings.p4_title,
        p4_for: section.settings.p4_for,
        p4_answers: section.settings.p4_answers,
        p4_learn: section.settings.p4_learn,
        p4_leads: section.settings.p4_leads,
        p4_limit: section.settings.p4_limit,
        p4_href: section.settings.p4_href
      %}

      {%- comment -%} ═══ UNIVERSAL PRINCIPLES (disclosure) ═══ {%- endcomment -%}
      <details class="dg-zone dg-principles-disclosure" id="principles">
        <summary class="dg-principles-disclosure__summary">
          <h2 class="dg-zone__h2">{{ section.settings.principles_heading }}</h2>
        </summary>
        <div class="dg-principles">
          {%- for i in (1..4) -%}
            {%- assign title_key = 'principle_' | append: i -%}
            {%- assign body_key = 'principle_' | append: i | append: '_body' -%}
            {%- assign p_title = section.settings[title_key] -%}
            {%- assign p_body = section.settings[body_key] -%}
            {%- if p_title != blank -%}
              <div class="dg-principle">
                <div class="dg-principle__num" aria-hidden="true">{{ i }}</div>
                <div class="dg-principle__body">
                  <h3 class="dg-principle__title">{{ p_title }}</h3>
                  {%- if p_body != blank -%}
                    <p class="dg-principle__text">{{ p_body }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </details>

      {%- comment -%} ═══ ZONE 3: PER-PRODUCT ENTRIES (H2 each) ═══ {%- endcomment -%}
      {%- assign dg_render_seen = ',' -%}
      {%- assign dg_json_items = '' -%}
      {%- assign dg_index_items = '' -%}
      {%- assign dg_prev_letter = '' -%}
      {%- assign li_pos = 0 -%}
      <div class="dg-zone dg-catalog" id="dosing-by-product">
        {%- if dg_card_count > 0 -%}
          <div class="dg-products">
            {%- if dg_manual -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'product' and block.settings.product != blank -%}
                  {%- assign product = block.settings.product -%}
                  {%- assign mf_dose = product.metafields.custom.dose -%}
                  {%- assign mf_timing = product.metafields.custom.timing -%}
                  {%- assign dg_key = ',' | append: product.handle | append: ',' -%}
                  {%- if mf_dose != blank or mf_timing != blank -%}
                    {%- unless dg_render_seen contains dg_key -%}
                      {%- assign dg_render_seen = dg_render_seen | append: product.handle | append: ',' -%}
                      {%- assign dg_letter = product.title | strip | slice: 0, 1 | upcase -%}
                      {%- assign dg_ls = '0' -%}
                      {%- if dg_letter != dg_prev_letter -%}
                        {%- assign dg_ls = '1' -%}
                        {%- assign dg_prev_letter = dg_letter -%}
                      {%- endif -%}
                      {%- capture dg_idx_one -%}
                        {%- render 'dosing-guide-index-item', product: product, letter_start: dg_ls -%}
                      {%- endcapture -%}
                      {%- assign dg_index_items = dg_index_items | append: dg_idx_one -%}
                      {%- render 'dosing-guide-card', product: product -%}
                      {%- assign li_pos = li_pos | plus: 1 -%}
                      {%- capture dg_one -%}
                        {%- if li_pos > 1 -%},{%- endif -%}
                        {
                          "@type": "ListItem",
                          "position": {{ li_pos }},
                          "name": {{ product.title | json }},
                          "url": {{ canonical_url | append: '#dose-' | append: product.handle | json }}
                        }
                      {%- endcapture -%}
                      {%- assign dg_json_items = dg_json_items | append: dg_one -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for product in dg_sorted -%}
                {%- if product == empty -%}{%- continue -%}{%- endif -%}
                {%- assign mf_dose = product.metafields.custom.dose -%}
                {%- assign mf_timing = product.metafields.custom.timing -%}
                {%- assign dg_key = ',' | append: product.handle | append: ',' -%}
                {%- if mf_dose != blank or mf_timing != blank -%}
                  {%- unless dg_render_seen contains dg_key -%}
                    {%- assign dg_render_seen = dg_render_seen | append: product.handle | append: ',' -%}
                    {%- assign dg_letter = product.title | strip | slice: 0, 1 | upcase -%}
                    {%- assign dg_ls = '0' -%}
                    {%- if dg_letter != dg_prev_letter -%}
                      {%- assign dg_ls = '1' -%}
                      {%- assign dg_prev_letter = dg_letter -%}
                    {%- endif -%}
                    {%- capture dg_idx_one -%}
                      {%- render 'dosing-guide-index-item', product: product, letter_start: dg_ls -%}
                    {%- endcapture -%}
                    {%- assign dg_index_items = dg_index_items | append: dg_idx_one -%}
                    {%- render 'dosing-guide-card', product: product -%}
                    {%- assign li_pos = li_pos | plus: 1 -%}
                    {%- capture dg_one -%}
                      {%- if li_pos > 1 -%},{%- endif -%}
                      {
                        "@type": "ListItem",
                        "position": {{ li_pos }},
                        "name": {{ product.title | json }},
                        "url": {{ canonical_url | append: '#dose-' | append: product.handle | json }}
                      }
                    {%- endcapture -%}
                    {%- assign dg_json_items = dg_json_items | append: dg_one -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if dg_has_secondary -%}
                {%- for product in dg_sorted_2 -%}
                  {%- if product == empty -%}{%- continue -%}{%- endif -%}
                  {%- assign mf_dose = product.metafields.custom.dose -%}
                  {%- assign mf_timing = product.metafields.custom.timing -%}
                  {%- assign dg_key = ',' | append: product.handle | append: ',' -%}
                  {%- if mf_dose != blank or mf_timing != blank -%}
                    {%- unless dg_render_seen contains dg_key -%}
                      {%- assign dg_render_seen = dg_render_seen | append: product.handle | append: ',' -%}
                      {%- assign dg_letter = product.title | strip | slice: 0, 1 | upcase -%}
                      {%- assign dg_ls = '0' -%}
                      {%- if dg_letter != dg_prev_letter -%}
                        {%- assign dg_ls = '1' -%}
                        {%- assign dg_prev_letter = dg_letter -%}
                      {%- endif -%}
                      {%- capture dg_idx_one -%}
                        {%- render 'dosing-guide-index-item', product: product, letter_start: dg_ls -%}
                      {%- endcapture -%}
                      {%- assign dg_index_items = dg_index_items | append: dg_idx_one -%}
                      {%- render 'dosing-guide-card', product: product -%}
                      {%- assign li_pos = li_pos | plus: 1 -%}
                      {%- capture dg_one -%}
                        {%- if li_pos > 1 -%},{%- endif -%}
                        {
                          "@type": "ListItem",
                          "position": {{ li_pos }},
                          "name": {{ product.title | json }},
                          "url": {{ canonical_url | append: '#dose-' | append: product.handle | json }}
                        }
                      {%- endcapture -%}
                      {%- assign dg_json_items = dg_json_items | append: dg_one -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}
          </div>
          <nav class="dg-index" data-dg-index aria-labelledby="dg-index-title-{{ dg_id }}">
            <p class="dg-index__title" id="dg-index-title-{{ dg_id }}">A to Z</p>
            <ol class="dg-index__list">
              {{ dg_index_items }}
            </ol>
          </nav>
          <p class="dg-noresults guide-empty" data-dg-noresults data-guide-empty hidden>
            No products on this page match that name.
            <a class="dg-noresults__link" data-dg-search-fallback data-guide-search-fallback href="{{ routes.search_url }}">Search the store for this name</a>
          </p>
        {%- else -%}
          <p class="dg-empty">No collection selected yet. Choose a collection in the theme editor to populate per-product dosing entries.</p>
        {%- endif -%}
      </div>

      {%- comment -%} ═══ FAQ ═══ {%- endcomment -%}
      {%- assign dg_faq_blocks = section.blocks | where: 'type', 'faq' -%}
      {%- if dg_faq_blocks.size > 0 -%}
        <div class="dg-faq-zone" id="faq">
          <h2 class="dg-faq-zone__h2">{{ section.settings.faq_heading }}</h2>
          <div class="dg-faq">
            {%- for block in dg_faq_blocks -%}
              {%- if block.settings.question != blank -%}
                <details class="dg-faq__item" {{ block.shopify_attributes }}>
                  <summary class="dg-faq__summary">{{ block.settings.question }}</summary>
                  <div class="dg-faq__answer rte">{{ block.settings.answer }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- liquid
        assign dg_cycling_page = pages['cycling-guide']
        if dg_cycling_page != empty
          assign dg_cycling_href = dg_cycling_page.url
        else
          assign dg_cycling_href = '/pages/cycling-guide'
        endif
      -%}
      {% render 'guide-related',
        heading: section.settings.related_heading,
        heading_id: dg_related_id,
        body: section.settings.related_body,
        href: dg_cycling_href,
        cta: section.settings.related_cta,
        coa_href: dg_coa_href,
        contact_href: dg_contact_href
      %}

      {%- comment -%} ═══ DISCLAIMER ═══ {%- endcomment -%}
      {%- if section.settings.disclaimer != blank -%}
        <aside class="dg-disclaimer" role="note" aria-label="Medical disclaimer">
