      <div class="dg-body">

        {%- comment -%} Desktop sidebar TOC {%- endcomment -%}
        <aside class="dg-toc" aria-label="Guide sections" id="dg-toc-{{ dg_id }}">
          <p class="dg-toc__title">In this guide</p>
          <ul class="dg-toc__list">
            <li><a class="dg-toc__link" href="#general-principles" data-dg-toc-link>General Principles</a></li>
            <li><a class="dg-toc__link" href="#compound-types" data-dg-toc-link>Compound Types</a></li>
            <li><a class="dg-toc__link" href="#mistakes" data-dg-toc-link>Common Mistakes</a></li>
            <li><a class="dg-toc__link" href="#stacking" data-dg-toc-link>Stacking Guide</a></li>
            <li><a class="dg-toc__link" href="#cycling" data-dg-toc-link>Cycling & Breaks</a></li>
          </ul>
        </aside>

        <div class="dg-content">

          {%- comment -%} ── SECTION 1: General Principles ── {%- endcomment -%}
          <section class="dg-section" id="general-principles" data-dg-section aria-labelledby="dg-h2-principles">
            <h2 class="dg-section__h2" id="dg-h2-principles">General Principles</h2>
            <p class="dg-section__lead">The three variables that determine whether a nootropic works for you: timing, context (food), and consistency. Most people underoptimise all three.</p>

            <h3 class="dg-h3">Timing</h3>
            <p class="dg-section__lead">Take stimulant-class and racetam compounds 30–45 minutes before the cognitive task you want to enhance. Adaptogens and cumulative compounds are less time-sensitive — morning or evening, consistently.</p>

            <div class="dg-callout" role="note">
              <svg class="dg-callout__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <p><strong>Fat-soluble compounds</strong> — Aniracetam, Alpha-GPC, and most racetams absorb significantly better with dietary fat. Taking them on an empty stomach can reduce effective dose by 30–50%. A tablespoon of nut butter or a meal is sufficient.</p>
            </div>

            <h3 class="dg-h3">Consistency</h3>
            <p class="dg-section__lead">Cumulative compounds (Lion's Mane, Bacopa, Ashwagandha) require uninterrupted daily dosing to build their effects. Missing 2–3 days resets part of the progress. Set a consistent time — morning is easiest to anchor.</p>

            {%- if compound_blocks.size > 0 -%}
              <h3 class="dg-h3">Quick Reference</h3>
              <div class="dg-table-wrap" role="region" aria-label="Compound dosing reference">
                <table class="dg-table">
                  <thead>
                    <tr>
                      <th scope="col">Compound</th>
                      <th scope="col">Dose Range</th>
                      <th scope="col">Timing</th>
                      <th scope="col">Type</th>
                      <th scope="col">Notes</th>
                    </tr>
                  </thead>
                  <tbody>
                    {%- for block in compound_blocks -%}
                      {%- assign cp = block.settings.product -%}
                      <tr {{ block.shopify_attributes }}>
                        <td>
                          {%- if cp != blank -%}
                            <a class="dg-table__compound-link" href="{{ cp.url }}">{{ block.settings.name | default: cp.title }}</a>
                          {%- else -%}
                            <strong>{{ block.settings.name }}</strong>
                          {%- endif -%}
                        </td>
                        <td>{{ block.settings.dose_range | default: '—' }}</td>
                        <td>{{ block.settings.timing }}</td>
                        <td>
                          {%- if block.settings.onset_type == 'acute' -%}
                            <span class="dg-badge dg-badge--acute">Acute</span>
                          {%- else -%}
                            <span class="dg-badge dg-badge--cumulative">Cumulative</span>
                          {%- endif -%}
                          {%- if block.settings.food_required -%}
                            <span class="dg-badge dg-badge--food">With food</span>
                          {%- endif -%}
                        </td>
                        <td>{{ block.settings.notes | default: '—' }}</td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
            {%- endif -%}
          </section>

          {%- comment -%} ── SECTION 2: Compound Types ── {%- endcomment -%}
          <section class="dg-section" id="compound-types" data-dg-section aria-labelledby="dg-h2-types">
            <h2 class="dg-section__h2" id="dg-h2-types">Compound Types</h2>
            <p class="dg-section__lead">The most common week-one mistake is expecting dramatic effects from cumulative compounds. Understanding the difference prevents early drop-off.</p>

            <div class="dg-split">
              <div class="dg-split__col">
                <div class="dg-split__col-label">
                  <span aria-hidden="true"></span>
                  Acute compounds
                </div>
                <p class="dg-split__col-desc">Effects appear within 30–90 minutes of dosing. If you notice nothing after Day 3, check dose, timing, and whether you took it with food (for fat-soluble compounds).</p>
                {%- if acute_blocks.size > 0 -%}
                  <ul class="dg-pill-list" aria-label="Acute compounds">
                    {%- for block in acute_blocks -%}
                      {%- assign cp = block.settings.product -%}
                      <li>
                        {%- if cp != blank -%}
                          <a class="dg-pill" href="{{ cp.url }}">{{ block.settings.name | default: cp.title }}</a>
                        {%- else -%}
                          <span class="dg-pill">{{ block.settings.name }}</span>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <ul class="dg-pill-list" aria-label="Acute compounds">
                    <li><span class="dg-pill">Noopept</span></li>
                    <li><span class="dg-pill">Alpha-GPC</span></li>
                    <li><span class="dg-pill">Phenylpiracetam</span></li>
                    <li><span class="dg-pill">Aniracetam</span></li>
                    <li><span class="dg-pill">Caffeine + L-Theanine</span></li>
                  </ul>
                {%- endif -%}
              </div>

              <div class="dg-split__col dg-split__col--cumul">
                <div class="dg-split__col-label">
                  <span aria-hidden="true"></span>
                  Cumulative compounds
                </div>
                <p class="dg-split__col-desc">Effects build over weeks. Small signals at week 1 are real signals. Significant change typically appears at weeks 3–6. Daily consistency is the mechanism.</p>
                {%- if cumulative_blocks.size > 0 -%}
                  <ul class="dg-pill-list" aria-label="Cumulative compounds">
                    {%- for block in cumulative_blocks -%}
                      {%- assign cp = block.settings.product -%}
                      <li>
                        {%- if cp != blank -%}
                          <a class="dg-pill" href="{{ cp.url }}">{{ block.settings.name | default: cp.title }}</a>
                        {%- else -%}
                          <span class="dg-pill">{{ block.settings.name }}</span>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <ul class="dg-pill-list" aria-label="Cumulative compounds">
                    <li><span class="dg-pill">Lion's Mane</span></li>
                    <li><span class="dg-pill">Bacopa Monnieri</span></li>
                    <li><span class="dg-pill">Ashwagandha KSM-66</span></li>
                    <li><span class="dg-pill">Tongkat Ali</span></li>
                    <li><span class="dg-pill">Rhodiola Rosea</span></li>
                  </ul>
                {%- endif -%}
              </div>
            </div>

            <div class="dg-rule">
              <div class="dg-rule__label">The rule</div>
              <p class="dg-rule__text">Don't measure a cumulative compound by week-1 response. If you stopped a cumulative compound at week 1 because "it didn't work," you stopped before the mechanism had time to engage.</p>
            </div>
          </section>

          {%- comment -%} ── SECTION 3: Common Mistakes ── {%- endcomment -%}
          <section class="dg-section" id="mistakes" data-dg-section aria-labelledby="dg-h2-mistakes">
            <h2 class="dg-section__h2" id="dg-h2-mistakes">Common Mistakes</h2>
            <p class="dg-section__lead">Most inconsistent results trace back to one of these four patterns. They're fixable once identified.</p>

            <ol class="dg-mistakes" aria-label="Common dosing mistakes">
              <li class="dg-mistake">
                <div class="dg-mistake__num" aria-hidden="true">1</div>
                <div class="dg-mistake__body">
                  <h3 class="dg-mistake__title">Taking fat-soluble compounds on an empty stomach</h3>
                  <p class="dg-mistake__text">Aniracetam, Alpha-GPC, and most racetams require dietary fat to absorb. A capsule on an empty stomach can deliver a fraction of the intended dose. Always take these with a meal or a small amount of fat.</p>
                </div>
              </li>
              <li class="dg-mistake">
                <div class="dg-mistake__num" aria-hidden="true">2</div>
                <div class="dg-mistake__body">
                  <h3 class="dg-mistake__title">Inconsistent timing on cumulative compounds</h3>
                  <p class="dg-mistake__text">Skipping 2–3 days in a row resets part of the progress on Lion's Mane, Bacopa, and adaptogens. Daily dosing isn't optional for these — it's the mechanism.</p>
                </div>
              </li>
              <li class="dg-mistake">
                <div class="dg-mistake__num" aria-hidden="true">3</div>
                <div class="dg-mistake__body">
                  <h3 class="dg-mistake__title">High caffeine intake competing with nootropic effects</h3>
                  <p class="dg-mistake__text">400mg+ of caffeine adds background cortisol and competes with some nootropic mechanisms. High caffeine also disrupts the sleep that consolidates neuroplasticity gains. If you're a heavy coffee drinker, consider swapping one coffee for a lower-dose caffeine + L-Theanine pairing.</p>
                </div>
              </li>
              <li class="dg-mistake">
                <div class="dg-mistake__num" aria-hidden="true">4</div>
                <div class="dg-mistake__body">
                  <h3 class="dg-mistake__title">Not sleeping enough</h3>
                  <p class="dg-mistake__text">Nootropics enhance cognition but do not replace sleep debt. The neuroplasticity effects from compounds like Lion's Mane and Bacopa are consolidated during deep sleep. Disrupted sleep compresses your results — and is the most common hidden variable when something "stopped working."</p>
                </div>
              </li>
            </ol>
          </section>

          {%- comment -%} ── SECTION 4: Stacking Guide ── {%- endcomment -%}
          <section class="dg-section" id="stacking" data-dg-section aria-labelledby="dg-h2-stacking">
            <h2 class="dg-section__h2" id="dg-h2-stacking">Stacking Guide</h2>
            <p class="dg-section__lead">Add one compound at a time. Give each 10 days before assessing. Don't optimise a stack you can't read.</p>

            <div class="dg-callout" role="note">
              <svg class="dg-callout__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l7 4v5c0 5.25-3.5 9.74-7 11-3.5-1.26-7-5.75-7-11V6l7-4z"/><polyline points="9 12 11 14 15 10"/></svg>
              <p><strong>Choline pairing is mandatory with racetams.</strong> Racetam-class compounds increase acetylcholine utilisation. Without a choline donor (Alpha-GPC or CDP-Choline), this can deplete acetylcholine and cause headaches. Alpha-GPC at 250–300mg per racetam dose is the standard pairing.</p>
            </div>

            <h3 class="dg-h3">Add based on your goal</h3>
            <div class="dg-stack-grid">
              <div class="dg-stack-card">
                <div class="dg-stack-card__goal">For sharper focus</div>
                <h4 class="dg-stack-card__add">Add Alpha-GPC</h4>
                <p class="dg-stack-card__why">Choline source that amplifies most other nootropics and prevents acetylcholine-depletion headaches. Foundation of any racetam stack.</p>
              </div>
              <div class="dg-stack-card">
                <div class="dg-stack-card__goal">For stress resilience</div>
                <h4 class="dg-stack-card__add">Add an adaptogen first</h4>
                <p class="dg-stack-card__why">Ashwagandha or Tongkat Ali builds the cortisol floor. High cortisol blunts everything else — removing it first makes subsequent compounds more readable.</p>
              </div>
              <div class="dg-stack-card">
                <div class="dg-stack-card__goal">For long-term performance</div>
                <h4 class="dg-stack-card__add">Add Lion's Mane</h4>
                <p class="dg-stack-card__why">NGF stimulation isn't dramatic in week 1. Significant effects emerge at month 2–3 and compound over time. Start it early and keep it consistent.</p>
              </div>
            </div>

            {%- if section.settings.stacking_cta_url != blank -%}
              <a class="dg-cta-link" href="{{ section.settings.stacking_cta_url }}">
                Build my stack
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            {%- endif -%}
          </section>

          {%- comment -%} ── SECTION 5: Cycling & Breaks ── {%- endcomment -%}
          <section class="dg-section" id="cycling" data-dg-section aria-labelledby="dg-h2-cycling">
            <h2 class="dg-section__h2" id="dg-h2-cycling">Cycling & Breaks</h2>
            <p class="dg-section__lead">Cycling prevents tolerance build-up and keeps your baseline sensitivity. Not all compounds need strict cycling — adaptogens and neurotrophics can run continuously; stimulant-class compounds benefit from regular breaks.</p>

            <div class="dg-rule">
              <div class="dg-rule__label">General principle</div>
              <p class="dg-rule__text">Stimulant-class: 5 days on / 2 off (weekday use natural). Adaptogens: 8–12 weeks on / 1–2 weeks off. Racetams: 8 weeks on / 2–4 weeks off. Neurotrophics (Lion's Mane, Bacopa): continuous use is safe; a 2-week break every 3–4 months is optional.</p>
            </div>

            {%- if cycled_blocks.size > 0 -%}
              <h3 class="dg-h3">Cycling schedules</h3>
              <div class="dg-cycle-grid">
                {%- for block in cycled_blocks -%}
                  {%- assign cp = block.settings.product -%}
                  <div class="dg-cycle-card" {{ block.shopify_attributes }}>
                    <div class="dg-cycle-card__name">
                      {%- if cp != blank -%}
                        <a href="{{ cp.url }}">{{ block.settings.name | default: cp.title }}</a>
                      {%- else -%}
                        <span>{{ block.settings.name }}</span>
                      {%- endif -%}
                    </div>
                    <div class="dg-cycle-card__cycle" aria-label="Cycling schedule">
                      <svg class="dg-cycle-card__cycle-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 014-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>
                      {{ block.settings.cycle_length }}
                    </div>
                    {%- if block.settings.notes != blank -%}
                      <p class="dg-cycle-card__note">{{ block.settings.notes }}</p>
                    {%- endif -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </section>

          {%- comment -%} Disclaimer {%- endcomment -%}
          {%- if section.settings.disclaimer != blank -%}
            <aside class="dg-disclaimer" role="note" aria-label="Medical disclaimer">
              <svg class="dg-disclaimer__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
              <div class="dg-disclaimer__body rte">{{ section.settings.disclaimer }}</div>
            </aside>
          {%- endif -%}

        </div>
      </div>
    </div>

  </xo-container>
</section>

{%- comment -%} ═══ JSON-LD ═══ {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": {{ section.settings.heading | json }},
      "description": {{ section.settings.seo_description | default: section.settings.heading | json }},
      "author": { "@type": "Organization", "name": {{ section.settings.author | default: shop.name | json }} },
      "publisher": { "@type": "Organization", "name": {{ shop.name | json }} },
      {%- if section.settings.date_published != blank -%}
        "datePublished": {{ section.settings.date_published | json }},
      {%- endif -%}
      "mainEntityOfPage": {{ request.origin | append: request.path | json }}
    },
    {
      "@type": "ItemList",
      "name": {{ section.settings.heading | json }},
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "General Principles", "url": {{ request.origin | append: request.path | append: "#general-principles" | json }} },
        { "@type": "ListItem", "position": 2, "name": "Compound Types",      "url": {{ request.origin | append: request.path | append: "#compound-types"    | json }} },
        { "@type": "ListItem", "position": 3, "name": "Common Mistakes",     "url": {{ request.origin | append: request.path | append: "#mistakes"           | json }} },
        { "@type": "ListItem", "position": 4, "name": "Stacking Guide",      "url": {{ request.origin | append: request.path | append: "#stacking"           | json }} },
        { "@type": "ListItem", "position": 5, "name": "Cycling & Breaks",    "url": {{ request.origin | append: request.path | append: "#cycling"            | json }} }
      ]
    }
  ]
}
</script>

{%- comment -%} ═══ SCROLL-SPY JS ═══ {%- endcomment -%}
<script>
(function() {
  var tocEl = document.getElementById('dg-toc-{{ dg_id }}');
  if (!tocEl) return;

  var links = tocEl.querySelectorAll('[data-dg-toc-link]');
  var sections = document.querySelectorAll('[data-dg-section]');
  if (!links.length || !sections.length) return;

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        var id = entry.target.id;
        links.forEach(function(link) {
          var active = link.getAttribute('href') === '#' + id;
          link.setAttribute('aria-current', active ? 'true' : 'false');
        });
      }
    });
  }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });

  sections.forEach(function(sec) { observer.observe(sec); });

  function smoothNav(el) {
    el.addEventListener('click', function(e) {
      var link = e.target.closest('a[href^="#"]');
      if (!link) return;
      var target = document.querySelector(link.getAttribute('href'));
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(null, '', link.getAttribute('href'));
    });
  }

  smoothNav(tocEl);

  var mobileToc = document.getElementById('dg-toc-mobile-{{ dg_id }}');
  if (mobileToc) {
    mobileToc.addEventListener('click', function(e) {
      var link = e.target.closest('.dg-toc-mobile__link');
      if (!link) return;
      var target = document.querySelector(link.getAttribute('href'));
      if (!target) return;
      e.preventDefault();
      mobileToc.removeAttribute('open');
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(null, '', link.getAttribute('href'));
    });
  }
})();
</script>

