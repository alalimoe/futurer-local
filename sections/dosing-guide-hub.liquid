{%- liquid
  assign dg_id = section.id
  assign dg_coll = section.settings.collection

  assign dg_manual = false
  assign dg_handles = ''
  for block in section.blocks
    if block.type == 'product' and block.settings.product != blank
      assign dg_handles = dg_handles | append: block.settings.product.handle | append: ','
    endif
  endfor
  assign dg_handles = dg_handles | split: ','
  if dg_handles.size > 0
    assign dg_manual = true
  else
    assign dg_handles = dg_coll.products | map: 'handle'
  endif
  assign dg_products = dg_handles
-%}

{%- style -%}
  .xo-section--{{ dg_id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: rgba(var(--color-foreground));
  }
  .xo-section--{{ dg_id }} .dg__wrap {
    max-width: 880px;
    margin: 0 auto;
  }

  /* ── Hero ── */
  .xo-section--{{ dg_id }} .dg-hero {
    padding: clamp(40px, 7vw, 80px) 0 clamp(24px, 4vw, 40px);
  }
  .xo-section--{{ dg_id }} .dg-hero__eyebrow {
    display: inline-block;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(var(--color-accent));
    margin-bottom: 12px;
  }
  .xo-section--{{ dg_id }} .dg-hero__h1 {
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 600; letter-spacing: -0.03em; line-height: 1.1;
    margin: 0 0 16px;
  }
  .xo-section--{{ dg_id }} .dg-hero__sub {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem); line-height: 1.7;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 60%, transparent);
    margin: 0 0 20px;
  }
  .xo-section--{{ dg_id }} .dg-hero__sub p { margin: 0 0 10px; }
  .xo-section--{{ dg_id }} .dg-hero__badges {
    display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px;
  }
  .xo-section--{{ dg_id }} .dg-hero__badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 13px;
    border-radius: var(--button-radius, 10rem);
    background: color-mix(in srgb, rgba(var(--color-accent)) 10%, transparent);
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase;
    white-space: nowrap;
  }
  .xo-section--{{ dg_id }} .dg-hero__badge-icon {
    width: 15px; height: 15px; flex-shrink: 0; color: rgba(var(--color-accent));
  }
  .xo-section--{{ dg_id }} .dg-hero__meta {
    display: flex; flex-wrap: wrap; gap: 8px 20px;
    font-size: 0.82rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 6%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-hero__meta-item { display: inline-flex; align-items: center; gap: 5px; }
  .xo-section--{{ dg_id }} .dg-hero__meta-icon { width: 14px; height: 14px; flex-shrink: 0; opacity: 0.55; }

  /* ── Generic zone heading ── */
  .xo-section--{{ dg_id }} .dg-zone { margin-bottom: clamp(40px, 6vw, 64px); }
  .xo-section--{{ dg_id }} .dg-zone__h2 {
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 600; letter-spacing: -0.025em; line-height: 1.15;
    margin: 0 0 20px; scroll-margin-top: 84px;
  }

  /* ── Zone 1: Universal principles ── */
  .xo-section--{{ dg_id }} .dg-principles {
    display: grid; grid-template-columns: 1fr; gap: 14px;
  }
  @media (min-width: 640px) {
    .xo-section--{{ dg_id }} .dg-principles { grid-template-columns: 1fr 1fr; }
  }
  .xo-section--{{ dg_id }} .dg-principle {
    display: flex; gap: 14px; align-items: flex-start;
    background: rgba(var(--color-background));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: 20px;
  }
  .xo-section--{{ dg_id }} .dg-principle__num {
    flex-shrink: 0; width: 30px; height: 30px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    background: rgba(var(--color-accent));
    color: rgba(var(--color-foreground));
    font-family: var(--font-heading-family, sans-serif);
    font-size: 0.85rem; font-weight: 700;
  }
  .xo-section--{{ dg_id }} .dg-principle__body { flex: 1; min-width: 0; }
  .xo-section--{{ dg_id }} .dg-principle__title {
    font-family: var(--font-heading-family, sans-serif);
    font-size: 0.98rem; font-weight: 600; line-height: 1.3; margin: 0 0 6px;
  }
  .xo-section--{{ dg_id }} .dg-principle__text {
    font-size: 0.88rem; line-height: 1.6; margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  }

  /* ── Zone 2: Jump-to nav (CSS only) ── */
  .xo-section--{{ dg_id }} .dg-jump {
    background: rgba(var(--color-background-2));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 7%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: 20px 22px;
  }
  .xo-section--{{ dg_id }} .dg-jump__label {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    margin: 0 0 14px;
  }
  .xo-section--{{ dg_id }} .dg-jump__list {
    display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0;
  }
  .xo-section--{{ dg_id }} .dg-jump__link {
    display: inline-flex; align-items: center;
    padding: 7px 14px; min-height: 32px;
    border-radius: var(--button-radius, 10rem);
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    background: rgba(var(--color-background));
    font-size: 0.82rem; font-weight: 500;
    text-decoration: none; color: inherit;
    transition: border-color 0.2s var(--out-soft, ease), background 0.2s var(--out-soft, ease);
  }
  .xo-section--{{ dg_id }} .dg-jump__link:hover {
    border-color: rgba(var(--color-accent));
    background: color-mix(in srgb, rgba(var(--color-accent)) 8%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-jump__link:focus-visible {
    outline: 2px solid rgba(var(--color-accent)); outline-offset: 2px;
  }

  /* ── Zone 3: Per-product cards ── */
  .xo-section--{{ dg_id }} .dg-products {
    display: flex; flex-direction: column; gap: 16px;
  }
  .xo-section--{{ dg_id }} .dg-product {
    scroll-margin-top: 84px;
    background: rgba(var(--color-background));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: clamp(20px, 3vw, 28px);
    transition: border-color 0.3s var(--out-soft, ease);
  }
  .xo-section--{{ dg_id }} .dg-product:hover {
    border-color: color-mix(in srgb, rgba(var(--color-foreground)) 16%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-product__head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 16px; margin-bottom: 18px;
  }
  .xo-section--{{ dg_id }} .dg-product__h2 {
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 600; letter-spacing: -0.02em; line-height: 1.2;
    margin: 0;
  }
  .xo-section--{{ dg_id }} .dg-product__link {
    flex-shrink: 0;
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 0.82rem; font-weight: 600;
    color: rgba(var(--color-accent)); text-decoration: none;
    white-space: nowrap;
  }
  .xo-section--{{ dg_id }} .dg-product__link:hover { text-decoration: underline; }
  .xo-section--{{ dg_id }} .dg-product__link:focus-visible {
    outline: 2px solid rgba(var(--color-accent)); outline-offset: 2px; border-radius: 4px;
  }
  .xo-section--{{ dg_id }} .dg-product__link svg { width: 13px; height: 13px; }

  .xo-section--{{ dg_id }} .dg-specs {
    display: grid; grid-template-columns: 1fr; gap: 0; margin: 0;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 6%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-spec {
    display: grid; grid-template-columns: 130px 1fr; gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 6%, transparent);
  }
  @media (max-width: 480px) {
    .xo-section--{{ dg_id }} .dg-spec { grid-template-columns: 1fr; gap: 2px; }
  }
  .xo-section--{{ dg_id }} .dg-spec__label {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    padding-top: 2px;
  }
  .xo-section--{{ dg_id }} .dg-spec__value {
    font-size: 0.92rem; line-height: 1.6;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 80%, transparent);
    margin: 0;
  }
  .xo-section--{{ dg_id }} .dg-badge {
    display: inline-block; padding: 3px 10px;
    border-radius: 0.5rem;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.02em;
    background: color-mix(in srgb, rgba(var(--color-accent)) 14%, transparent);
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
  }
  .xo-section--{{ dg_id }} .dg-badge--muted {
    background: color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  }

  /* ── Per-card empty note ── */
  .xo-section--{{ dg_id }} .dg-empty-note {
    margin: 0; font-size: 0.85rem; line-height: 1.6;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 6%, transparent);
    padding-top: 12px;
  }
  .xo-section--{{ dg_id }} .dg-empty-note code {
    font-size: 0.8em;
    padding: 1px 5px; border-radius: 4px;
    background: color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }

  /* ── Empty state ── */
  .xo-section--{{ dg_id }} .dg-empty {
    background: rgba(var(--color-background-2));
    border: 1px dashed color-mix(in srgb, rgba(var(--color-foreground)) 18%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: 32px; text-align: center;
    font-size: 0.9rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 60%, transparent);
  }

  /* ── Disclaimer ── */
  .xo-section--{{ dg_id }} .dg-disclaimer {
    margin: clamp(32px, 5vw, 48px) 0 0;
    background: color-mix(in srgb, rgba(var(--color-error)) 7%, transparent);
    border-left: 4px solid rgba(var(--color-error));
    border-radius: 0 var(--general-radius-1, 1rem) var(--general-radius-1, 1rem) 0;
    padding: 16px 20px;
    display: flex; gap: 14px; align-items: flex-start;
  }
  .xo-section--{{ dg_id }} .dg-disclaimer__icon {
    width: 20px; height: 20px; flex-shrink: 0; color: rgba(var(--color-error)); margin-top: 2px;
  }
  .xo-section--{{ dg_id }} .dg-disclaimer__body {
    font-size: clamp(0.78rem, 1vw, 0.85rem); line-height: 1.65; color: rgba(var(--color-error));
  }
  .xo-section--{{ dg_id }} .dg-disclaimer__body p { margin: 0 0 6px; }
  .xo-section--{{ dg_id }} .dg-disclaimer__body p:last-child { margin-bottom: 0; }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ dg_id }} .dg-jump__link,
    .xo-section--{{ dg_id }} .dg-product { transition: none; }
  }
{%- endstyle -%}

<section {% render 'section-attr' %}>
  <xo-container>
    <div class="dg__wrap">

      {%- comment -%} ═══ HERO (single H1) ═══ {%- endcomment -%}
      <header class="dg-hero">
        {%- if section.settings.eyebrow != blank -%}
          <span class="dg-hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="dg-hero__h1">{{ section.settings.heading }}</h1>

        {%- if section.settings.subtitle != blank -%}
          <div class="dg-hero__sub rte">{{ section.settings.subtitle }}</div>
        {%- endif -%}

        {%- if section.settings.badge_1_text != blank or section.settings.badge_2_text != blank or section.settings.badge_3_text != blank -%}
          <div class="dg-hero__badges" role="list">
            {%- if section.settings.badge_1_text != blank -%}
              <span class="dg-hero__badge" role="listitem">
                <svg class="dg-hero__badge-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                {{ section.settings.badge_1_text }}
              </span>
            {%- endif -%}
            {%- if section.settings.badge_2_text != blank -%}
              <span class="dg-hero__badge" role="listitem">
                <svg class="dg-hero__badge-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l7 4v5c0 5.25-3.5 9.74-7 11-3.5-1.26-7-5.75-7-11V6l7-4z"/><polyline points="9 12 11 14 15 10"/></svg>
                {{ section.settings.badge_2_text }}
              </span>
            {%- endif -%}
            {%- if section.settings.badge_3_text != blank -%}
              <span class="dg-hero__badge" role="listitem">
                <svg class="dg-hero__badge-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="12" y2="14"/></svg>
                {{ section.settings.badge_3_text }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.author != blank or section.settings.date_published != blank or section.settings.read_time != blank -%}
          <div class="dg-hero__meta">
            {%- if section.settings.author != blank -%}
              <span class="dg-hero__meta-item">
                <svg class="dg-hero__meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                {{ section.settings.author }}
              </span>
            {%- endif -%}
            {%- if section.settings.date_published != blank -%}
              <time class="dg-hero__meta-item" datetime="{{ section.settings.date_published }}">
                <svg class="dg-hero__meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                {{ section.settings.date_published | date: "%B %d, %Y" }}
              </time>
            {%- endif -%}
            {%- if section.settings.read_time != blank -%}
              <span class="dg-hero__meta-item">
                <svg class="dg-hero__meta-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {{ section.settings.read_time }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </header>

      {%- comment -%} ═══ ZONE 1: UNIVERSAL PRINCIPLES ═══ {%- endcomment -%}
      <div class="dg-zone" id="principles">
        <h2 class="dg-zone__h2">{{ section.settings.principles_heading }}</h2>
        <div class="dg-principles">
          {%- for i in (1..4) -%}
            {%- assign title_key = 'principle_' | append: i -%}
            {%- assign body_key = 'principle_' | append: i | append: '_body' -%}
            {%- assign p_title = section.settings[title_key] -%}
            {%- assign p_body = section.settings[body_key] -%}
            {%- if p_title != blank -%}
              <div class="dg-principle">
                <div class="dg-principle__num" aria-hidden="true">{{ i }}</div>
                <div class="dg-principle__body">
                  <h3 class="dg-principle__title">{{ p_title }}</h3>
                  {%- if p_body != blank -%}
                    <p class="dg-principle__text">{{ p_body }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} ═══ ZONE 2: JUMP-TO NAVIGATION ═══ {%- endcomment -%}
      {%- if dg_products.size > 0 -%}
        <div class="dg-zone">
          <nav class="dg-jump" aria-label="{{ section.settings.jump_label | escape }}">
            <p class="dg-jump__label">{{ section.settings.jump_label }}</p>
            <ul class="dg-jump__list">
              {%- for dg_handle in dg_products -%}
                {%- assign product = all_products[dg_handle] -%}
                {%- if product == empty -%}{%- continue -%}{%- endif -%}
                {%- assign has_dose = product.metafields.custom.dose -%}
                {%- assign has_timing = product.metafields.custom.timing -%}
                {%- if dg_manual or has_dose != blank or has_timing != blank -%}
                  <li>
                    <a class="dg-jump__link" href="#dose-{{ product.handle }}">{{ product.title }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        </div>
      {%- endif -%}

      {%- comment -%} ═══ ZONE 3: PER-PRODUCT ENTRIES (H2 each) ═══ {%- endcomment -%}
      <div class="dg-zone" id="dosing-by-product">
        {%- if dg_products.size > 0 -%}
          <div class="dg-products">
            {%- for dg_handle in dg_products -%}
              {%- assign product = all_products[dg_handle] -%}
              {%- if product == empty -%}{%- continue -%}{%- endif -%}
              {%- assign mf_dose = product.metafields.custom.dose -%}
              {%- assign mf_timing = product.metafields.custom.timing -%}
              {%- assign mf_food = product.metafields.custom.with_food -%}
              {%- assign mf_cycling = product.metafields.custom.cycling -%}
              {%- assign mf_notes = product.metafields.custom.dosing_notes -%}

              {%- assign dg_has_specs = false -%}
              {%- if mf_dose != blank or mf_timing != blank or mf_food != blank or mf_cycling != blank or mf_notes != blank -%}
                {%- assign dg_has_specs = true -%}
              {%- endif -%}

              {%- if dg_manual or mf_dose != blank or mf_timing != blank -%}
                <article class="dg-product" id="dose-{{ product.handle }}">
                  <div class="dg-product__head">
                    <h2 class="dg-product__h2">{{ product.title }}</h2>
                    <a class="dg-product__link" href="{{ product.url }}">
                      View product
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                  </div>

                  {%- if dg_has_specs -%}
                    <dl class="dg-specs">
                      {%- if mf_dose != blank -%}
                        <div class="dg-spec">
                          <dt class="dg-spec__label">Dose</dt>
                          <dd class="dg-spec__value">{{ mf_dose }}</dd>
                        </div>
                      {%- endif -%}
                      {%- if mf_timing != blank -%}
                        <div class="dg-spec">
                          <dt class="dg-spec__label">Timing</dt>
                          <dd class="dg-spec__value">{{ mf_timing }}</dd>
                        </div>
                      {%- endif -%}
                      {%- if mf_food != blank -%}
                        <div class="dg-spec">
                          <dt class="dg-spec__label">Food</dt>
                          <dd class="dg-spec__value">
                            {%- if mf_food.value == true -%}
                              <span class="dg-badge">Take with food</span>
                            {%- else -%}
                              <span class="dg-badge dg-badge--muted">Empty stomach OK</span>
                            {%- endif -%}
                          </dd>
                        </div>
                      {%- endif -%}
                      {%- if mf_cycling != blank -%}
                        <div class="dg-spec">
                          <dt class="dg-spec__label">Cycling</dt>
                          <dd class="dg-spec__value">{{ mf_cycling }}</dd>
                        </div>
                      {%- endif -%}
                      {%- if mf_notes != blank -%}
                        <div class="dg-spec">
                          <dt class="dg-spec__label">Notes</dt>
                          <dd class="dg-spec__value">{{ mf_notes }}</dd>
                        </div>
                      {%- endif -%}
                    </dl>
                  {%- else -%}
                    <p class="dg-empty-note">Dosing details coming soon. Add this product's <code>custom.dose</code> and <code>custom.timing</code> metafields to populate this card.</p>
                  {%- endif -%}
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="dg-empty">No collection selected yet. Choose a collection in the theme editor to populate per-product dosing entries.</p>
        {%- endif -%}
      </div>

      {%- comment -%} ═══ DISCLAIMER ═══ {%- endcomment -%}
      {%- if section.settings.disclaimer != blank -%}
        <aside class="dg-disclaimer" role="note" aria-label="Medical disclaimer">
          <svg class="dg-disclaimer__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <div class="dg-disclaimer__body rte">{{ section.settings.disclaimer }}</div>
        </aside>
      {%- endif -%}

    </div>
  </xo-container>
</section>

{%- comment -%} ═══ JSON-LD: Article + ItemList (+ optional FAQPage) ═══ {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": {{ section.settings.heading | json }},
      "description": {{ section.settings.seo_description | default: section.settings.heading | json }},
      "author": { "@type": "Organization", "name": {{ section.settings.author | default: shop.name | json }} },
      "publisher": { "@type": "Organization", "name": {{ shop.name | json }} },
      {%- if section.settings.date_published != blank -%}
        "datePublished": {{ section.settings.date_published | json }},
      {%- endif -%}
      "mainEntityOfPage": {{ request.origin | append: request.path | json }}
    }
    {%- if dg_products.size > 0 -%}
      ,{
        "@type": "ItemList",
        "name": {{ section.settings.heading | json }},
        "itemListElement": [
          {%- assign li_pos = 0 -%}
          {%- for dg_handle in dg_products -%}
            {%- assign product = all_products[dg_handle] -%}
            {%- if product == empty -%}{%- continue -%}{%- endif -%}
            {%- assign mf_dose = product.metafields.custom.dose -%}
            {%- assign mf_timing = product.metafields.custom.timing -%}
            {%- if dg_manual or mf_dose != blank or mf_timing != blank -%}
              {%- assign li_pos = li_pos | plus: 1 -%}
              {%- if li_pos > 1 -%},{%- endif -%}
              {
                "@type": "ListItem",
                "position": {{ li_pos }},
                "name": {{ product.title | json }},
                "url": {{ request.origin | append: request.path | append: "#dose-" | append: product.handle | json }}
              }
            {%- endif -%}
          {%- endfor -%}
        ]
      }
      {%- if section.settings.emit_faq_schema -%}
        ,{
          "@type": "FAQPage",
          "mainEntity": [
            {%- assign faq_pos = 0 -%}
            {%- for dg_handle in dg_products -%}
              {%- assign product = all_products[dg_handle] -%}
              {%- if product == empty -%}{%- continue -%}{%- endif -%}
              {%- assign mf_dose = product.metafields.custom.dose -%}
              {%- assign mf_timing = product.metafields.custom.timing -%}
              {%- assign mf_cycling = product.metafields.custom.cycling -%}
              {%- assign mf_notes = product.metafields.custom.dosing_notes -%}
              {%- if mf_dose != blank or mf_timing != blank -%}
                {%- assign faq_pos = faq_pos | plus: 1 -%}
                {%- if faq_pos > 1 -%},{%- endif -%}
                {%- capture faq_answer -%}
                  {%- if mf_dose != blank -%}Dose: {{ mf_dose }}. {% endif -%}
                  {%- if mf_timing != blank -%}Timing: {{ mf_timing }}. {% endif -%}
                  {%- if mf_cycling != blank -%}Cycling: {{ mf_cycling }}. {% endif -%}
                  {%- if mf_notes != blank -%}{{ mf_notes }}{% endif -%}
                {%- endcapture -%}
                {
                  "@type": "Question",
                  "name": {{ "How do I dose " | append: product.title | append: "?" | json }},
                  "acceptedAnswer": { "@type": "Answer", "text": {{ faq_answer | strip | json }} }
                }
              {%- endif -%}
            {%- endfor -%}
          ]
        }
      {%- endif -%}
    {%- endif -%}
  ]
}
</script>

{% schema %}
{
  "name": "Dosing Guide Hub",
  "tag": "div",
  "class": "dg-section-wrap",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "header", "content": "Data Source" },
    { "type": "paragraph", "content": "Add 'Product' blocks below to choose exactly which products appear, in order. If no Product blocks are added, the section falls back to looping the collection chosen here." },
    { "type": "collection", "id": "collection", "label": "Fallback collection", "info": "Used only when no Product blocks are added. Products in this collection render as dosing cards if they have a custom.dose or custom.timing metafield. Set custom.dose, custom.timing, custom.with_food, custom.cycling, and custom.dosing_notes on each product." },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reference Guide" },
    { "type": "text", "id": "heading", "label": "Page heading (H1)", "default": "Dosing Guide" },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>How to dose every product we carry — plus the universal rules that make any nootropic work better. Find your product below or scroll the principles first.</p>"
    },
    { "type": "text", "id": "author", "label": "Author", "default": "Nootropix Research" },
    { "type": "text", "id": "date_published", "label": "Published date (YYYY-MM-DD)", "default": "2026-01-01" },
    { "type": "text", "id": "read_time", "label": "Read time", "default": "6 min read" },
    { "type": "header", "content": "Trust Badges" },
    { "type": "text", "id": "badge_1_text", "label": "Badge 1", "default": "Evidence-Based Dosing" },
    { "type": "text", "id": "badge_2_text", "label": "Badge 2", "default": "3rd-Party Tested" },
    { "type": "text", "id": "badge_3_text", "label": "Badge 3", "default": "Updated Regularly" },
    { "type": "header", "content": "Zone 1 — Universal Principles" },
    { "type": "text", "id": "principles_heading", "label": "Section heading (H2)", "default": "Start here: four rules for everything" },
    { "type": "text", "id": "principle_1", "label": "Principle 1 title", "default": "Consistency beats dose size" },
    { "type": "textarea", "id": "principle_1_body", "label": "Principle 1 detail", "default": "Taking the same dose at the same time daily beats a bigger, random dose. Routine is the active ingredient." },
    { "type": "text", "id": "principle_2", "label": "Principle 2 title", "default": "Start at the lower end" },
    { "type": "textarea", "id": "principle_2_body", "label": "Principle 2 detail", "default": "Begin at the bottom of your range for the first few days, then adjust upward once you know how you respond." },
    { "type": "text", "id": "principle_3", "label": "Principle 3 title", "default": "Most stacks work best with food" },
    { "type": "textarea", "id": "principle_3_body", "label": "Principle 3 detail", "default": "Unless the label says otherwise, take with a meal. Many compounds are fat-soluble and absorb far better with dietary fat." },
    { "type": "text", "id": "principle_4", "label": "Principle 4 title", "default": "Give it the full first month" },
    { "type": "textarea", "id": "principle_4_body", "label": "Principle 4 detail", "default": "Many compounds build over weeks. Judge the result after a consistent month, not after the first few doses." },
    { "type": "header", "content": "Zone 2 — Jump-to Navigation" },
    { "type": "text", "id": "jump_label", "label": "Jump nav label", "default": "Jump to a product" },
    { "type": "header", "content": "Structured Data" },
    { "type": "checkbox", "id": "emit_faq_schema", "label": "Emit FAQ schema for products", "default": true, "info": "Adds FAQPage structured data (one Q&A per product) for rich-result eligibility." },
    {
      "type": "textarea",
      "id": "seo_description",
      "label": "SEO description",
      "default": "The complete Nootropix dosing guide — dose, timing, food, and cycling for every compound we carry, plus universal dosing principles."
    },
    { "type": "header", "content": "Disclaimer" },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>This guide is for educational purposes only and has not been evaluated by any regulatory body. These products are not intended to diagnose, treat, cure, or prevent any disease. Consult a qualified healthcare professional before starting any supplement protocol. Individual responses vary.</p>"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Shown as a dosing card in this order. Card content is pulled from the product's custom.dose, custom.timing, custom.with_food, custom.cycling, and custom.dosing_notes metafields." }
      ]
    }
  ],
  "presets": [
    { "name": "Dosing Guide Hub" }
  ]
}
{% endschema %}
