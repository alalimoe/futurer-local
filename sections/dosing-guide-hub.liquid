{% render 'reference-guide-jsonld', section: section, item_list_markup: dg_item_list_markup %}

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root || !('IntersectionObserver' in window)) { return; }
  var items = root.querySelectorAll('[data-guide-item]');
  var indexItems = root.querySelectorAll('[data-dg-index-item]');
  if (!items.length || !indexItems.length) { return; }
  var io = new IntersectionObserver(function (entries) {
    for (var i = 0; i < entries.length; i++) {
      if (!entries[i].isIntersecting) { continue; }
      var handle = entries[i].target.getAttribute('data-guide-handle');
      for (var n = 0; n < indexItems.length; n++) {
        var on = indexItems[n].getAttribute('data-dg-handle') === handle && !indexItems[n].hidden;
        indexItems[n].classList.toggle('dg-index__item--active', on);
        var a = indexItems[n].querySelector('a');
        if (!a) { continue; }
        if (on) { a.setAttribute('aria-current', 'location'); }
        else { a.removeAttribute('aria-current'); }
      }
    }
  }, { rootMargin: '-18% 0px -70% 0px', threshold: 0.01 });
  for (var o = 0; o < items.length; o++) { io.observe(items[o]); }
})();
</script>

