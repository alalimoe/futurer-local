{%- liquid
  assign cg_id = section.id
  assign cg_paths_id = 'guide-paths-' | append: cg_id
  assign cg_related_id = 'guide-related-' | append: cg_id
  assign cg_finder_id = 'cg-search-' | append: cg_id
  assign cg_coa_page = pages['quality-coa-library']
  if cg_coa_page == empty
    assign cg_coa_page = pages['coa-library']
  endif
  if cg_coa_page != empty
    assign cg_coa_href = cg_coa_page.url
  else
    assign cg_coa_href = '/pages/quality-coa-library'
  endif
  assign cg_contact_page = pages['contact']
  if cg_contact_page != empty
    assign cg_contact_href = cg_contact_page.url
  else
    assign cg_contact_href = '/pages/contact'
  endif
-%}
{%- capture cg_t1_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'tier1_row' -%}{{ block.settings.compound }} {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture cg_t2_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'tier2_row' -%}{{ block.settings.compound }} {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture cg_t3_html -%}{{ section.settings.tier3_list }}{%- endcapture -%}
{%- capture cg_play_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'playbook_card' -%}{{ block.settings.title }} {{ block.settings.body }} {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- capture cg_t1_keys -%}{% render 'guide-cycle-keys', html: cg_t1_html %}{%- endcapture -%}
{%- capture cg_t2_keys -%}{% render 'guide-cycle-keys', html: cg_t2_html %}{%- endcapture -%}
{%- capture cg_t3_keys -%}{% render 'guide-cycle-keys', html: cg_t3_html %}{%- endcapture -%}

{%- style -%}
  .xo-section--{{ cg_id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: rgba(var(--color-foreground));
  }
  .xo-section--{{ cg_id }} .cg__wrap {
    max-width: min(1140px, 100%);
    margin: 0 auto;
  }

  /* Breadcrumbs */
  .xo-section--{{ cg_id }} .rg-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    margin-bottom: clamp(16px, 3vw, 24px);
    font-size: calc(var(--font-body-scale, 1) * 1.3rem);
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
  }
  .xo-section--{{ cg_id }} .rg-breadcrumbs__link {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
    text-decoration: none;
  }
  .xo-section--{{ cg_id }} .rg-breadcrumbs__link:hover {
    color: rgba(var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .xo-section--{{ cg_id }} .rg-breadcrumbs__current {
    color: rgba(var(--color-foreground));
    font-weight: 600;
  }
  .xo-section--{{ cg_id }} .rg-breadcrumbs__sep {
    opacity: 0.45;
    user-select: none;
  }
  .xo-section--{{ cg_id }} .cg-layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: clamp(32px, 4vw, 56px);
    align-items: start;
  }
  .xo-section--{{ cg_id }} .cg-main { min-width: 0; }

  /* Safety */
  .xo-section--{{ cg_id }} .cg-safety {
    margin-bottom: clamp(24px, 4vw, 36px);
    padding: 18px 20px;
    background: rgba(var(--color-background-2));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    font-size: calc(var(--font-body-scale, 1) * 1.45rem);
    line-height: 1.65;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
    max-width: 72ch;
  }
  .xo-section--{{ cg_id }} .cg-safety p { margin: 0; }

  /* Hero */
  .xo-section--{{ cg_id }} .cg-hero {
    padding: clamp(8px, 2vw, 16px) 0 clamp(12px, 2vw, 20px);
  }
  .xo-section--{{ cg_id }} .cg-hero__eyebrow {
    display: inline-block;
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(var(--color-accent)); margin-bottom: 12px;
  }
  .xo-section--{{ cg_id }} .cg-hero__h1 {
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600; letter-spacing: -0.03em; line-height: 1.15;
    margin: 0 0 12px;
  }
  .xo-section--{{ cg_id }} .cg-hero__sub {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem); line-height: 1.7;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 60%, transparent);
    margin: 0 0 20px;
    max-width: 65ch;
  }
  .xo-section--{{ cg_id }} .cg-hero__sub p { margin: 0; }
  .xo-section--{{ cg_id }} .cg-hero__badges {
    display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 20px;
  }
  .xo-section--{{ cg_id }} .cg-hero__badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 13px;
    border-radius: var(--button-radius, 10rem);
    background: color-mix(in srgb, rgba(var(--color-accent)) 10%, transparent);
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase;
    white-space: nowrap;
  }
  .xo-section--{{ cg_id }} .cg-hero__badge-icon {
    width: 15px; height: 15px; flex-shrink: 0; color: rgba(var(--color-accent));
  }
  .xo-section--{{ cg_id }} .cg-hero__meta {
    display: flex; flex-wrap: wrap; gap: 8px 20px;
    font-size: 0.82rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 6%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-hero__meta-item { display: inline-flex; align-items: center; gap: 5px; }
  .xo-section--{{ cg_id }} .cg-hero__meta-icon { width: 14px; height: 14px; flex-shrink: 0; opacity: 0.55; }

  /* TOC */
  .xo-section--{{ cg_id }} .cg-toc {
    position: sticky; top: 80px; align-self: start;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-3, 2rem);
    padding: 20px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }
  .xo-section--{{ cg_id }} .cg-toc__title {
    font-weight: 600; font-size: 0.75rem; text-transform: uppercase;
    letter-spacing: 0.5px;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    margin-bottom: 12px;
  }
  .xo-section--{{ cg_id }} .cg-toc__link {
    padding: 8px 12px;
    font-size: calc(var(--font-body-scale, 1) * 1.35rem);
    line-height: 1.4;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.2s ease, background 0.2s ease;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .xo-section--{{ cg_id }} .cg-toc__link:hover {
    color: rgba(var(--color-foreground));
    background: color-mix(in srgb, rgba(var(--color-foreground)) 4%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-toc__link--active {
    color: rgba(var(--color-foreground));
    background: color-mix(in srgb, rgba(var(--color-accent)) 10%, transparent);
    font-weight: 600;
  }
  .xo-section--{{ cg_id }} .cg-toc--mobile {
    display: none;
    position: sticky; top: 64px; z-index: 4;
    margin: 0 -2px 28px;
    padding: 12px 0;
    background: color-mix(in srgb, rgba(var(--color-background)) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-toc--mobile .cg-toc__nav {
    display: flex; gap: 8px;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    padding: 0 2px 4px;
    scrollbar-width: none;
  }
  .xo-section--{{ cg_id }} .cg-toc--mobile .cg-toc__nav::-webkit-scrollbar { display: none; }
  .xo-section--{{ cg_id }} .cg-toc--mobile .cg-toc__link {
    flex: 0 0 auto; scroll-snap-align: start;
    white-space: nowrap; min-height: 44px;
    padding: 10px 16px;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--button-radius, 10rem);
    font-size: 0.82rem;
  }

  /* Zones */
  .xo-section--{{ cg_id }} .cg-zone {
    margin-bottom: clamp(48px, 10vw, 88px);
  }
  .xo-section--{{ cg_id }} .cg-zone__h2 {
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 600; letter-spacing: -0.025em; line-height: 1.15;
    margin: 0 0 20px; scroll-margin-top: 84px;
  }
  .xo-section--{{ cg_id }} .cg-zone > .cg-prose {
    max-width: 72ch;
  }
  .xo-section--{{ cg_id }} .cg-zone__h3 {
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    font-weight: 600; margin: 28px 0 14px;
  }
  .xo-section--{{ cg_id }} .cg-prose {
    font-size: calc(var(--font-body-scale, 1) * 1.5rem);
    line-height: 1.75;
    color: color-mix(in srgb, rgba(var(--color-foreground)) calc(var(--font-body-color-opacity, 0.75) * 100%), transparent);
  }
  .xo-section--{{ cg_id }} .cg-prose p { margin: 0 0 14px; }
  .xo-section--{{ cg_id }} .cg-prose p:last-child { margin-bottom: 0; }
  .xo-section--{{ cg_id }} .cg-prose ul { margin: 0 0 14px; padding-left: 1.25em; }
  .xo-section--{{ cg_id }} .cg-prose li { margin-bottom: 6px; }
  .xo-section--{{ cg_id }} .cg-prose a { color: rgba(var(--color-foreground)); text-decoration: underline; text-underline-offset: 2px; }

  /* Rules grid */
  .xo-section--{{ cg_id }} .cg-rules {
    display: grid; grid-template-columns: 1fr; gap: 14px;
  }
  @media (min-width: 640px) {
    .xo-section--{{ cg_id }} .cg-rules { grid-template-columns: 1fr 1fr; }
  }
  .xo-section--{{ cg_id }} .cg-rule {
    display: flex; gap: 14px; align-items: flex-start;
    background: rgba(var(--color-background));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: 20px;
  }
  .xo-section--{{ cg_id }} .cg-rule__num {
    flex-shrink: 0; width: 30px; height: 30px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    background: rgba(var(--color-accent));
    color: rgba(var(--color-foreground));
    font-family: var(--font-heading-family, sans-serif);
    font-size: 0.85rem; font-weight: 700;
  }
  .xo-section--{{ cg_id }} .cg-rule__title {
    font-family: var(--font-heading-family, sans-serif);
    font-size: calc(var(--font-body-scale, 1) * 1.5rem);
    font-weight: 600; line-height: 1.3; margin: 0 0 6px;
  }
  .xo-section--{{ cg_id }} .cg-rule__text {
    font-size: calc(var(--font-body-scale, 1) * 1.4rem);
    line-height: 1.65; margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  }

  /* Tier sections */
  .xo-section--{{ cg_id }} .cg-tier {
    border-radius: var(--general-radius-1, 1rem);
    padding: clamp(20px, 3vw, 28px);
    margin-top: 8px;
  }
  .xo-section--{{ cg_id }} .cg-tier--strict {
    background: color-mix(in srgb, rgba(var(--color-background-2)) 60%, transparent);
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-left: 4px solid rgba(var(--color-accent));
  }
  .xo-section--{{ cg_id }} .cg-tier--periodic {
    background: rgba(var(--color-background));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-tier--daily {
    background: rgba(var(--color-background));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }

  /* Tables */
  .xo-section--{{ cg_id }} .cg-table-wrap {
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    margin: 16px 0 0;
  }
  .xo-section--{{ cg_id }} .cg-table {
    width: 100%; border-collapse: collapse;
    font-size: calc(var(--font-body-scale, 1) * 1.4rem);
    min-width: 520px;
  }
  .xo-section--{{ cg_id }} .cg-table th,
  .xo-section--{{ cg_id }} .cg-table td {
    padding: 14px 16px; text-align: left; vertical-align: top;
    overflow-wrap: break-word;
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-table th {
    font-size: calc(var(--font-body-scale, 1) * 1.15rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    background: color-mix(in srgb, rgba(var(--color-foreground)) 3%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-table-cards { display: none; gap: 12px; margin-top: 16px; }
  .xo-section--{{ cg_id }} .cg-table-card {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    padding: 16px;
    background: rgba(var(--color-background));
  }
  .xo-section--{{ cg_id }} .cg-table-card__label {
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 50%, transparent);
    margin: 10px 0 4px;
  }
  .xo-section--{{ cg_id }} .cg-table-card__label:first-child { margin-top: 0; }
  .xo-section--{{ cg_id }} .cg-table-card__value {
    font-size: calc(var(--font-body-scale, 1) * 1.4rem);
    line-height: 1.55;
    overflow-wrap: break-word;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-zone[hidden] { display: none !important; }
  @media (max-width: 639px) {
    .xo-section--{{ cg_id }} .cg-table-wrap { display: none; }
    .xo-section--{{ cg_id }} .cg-table-cards { display: flex; flex-direction: column; }
  }

  /* Phenibut callout */
  .xo-section--{{ cg_id }} .cg-caution {
    margin-top: 24px;
    padding: 20px;
    border-radius: var(--general-radius-1, 1rem);
    border: 1px solid color-mix(in srgb, rgba(var(--color-error)) 25%, transparent);
    background: color-mix(in srgb, rgba(var(--color-error)) 4%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-caution__title {
    font-family: var(--font-heading-family, sans-serif);
    font-size: calc(var(--font-body-scale, 1) * 1.65rem);
    font-weight: 600;
    margin: 0 0 12px;
  }

  /* Note card */
  .xo-section--{{ cg_id }} .cg-note {
    margin-top: 20px; padding: 18px 20px;
    background: color-mix(in srgb, rgba(var(--color-accent)) 8%, transparent);
    border: 1px solid color-mix(in srgb, rgba(var(--color-accent)) 20%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    font-size: calc(var(--font-body-scale, 1) * 1.45rem);
    line-height: 1.65;
  }

  /* Callout paragraphs */
  .xo-section--{{ cg_id }} .cg-callout {
    padding: 18px 20px; margin: 16px 0;
    background: rgba(var(--color-background-2));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    font-size: calc(var(--font-body-scale, 1) * 1.45rem);
    line-height: 1.65;
    max-width: 72ch;
  }

  /* Dot grid */
  .xo-section--{{ cg_id }} .cg-dotgrid {
    display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start;
    margin: 24px 0;
    padding: 24px;
    background: rgba(var(--color-background-2));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-1, 1rem);
  }
  .xo-section--{{ cg_id }} .cg-dotgrid__week {
    display: flex; gap: 10px; align-items: center; flex-wrap: wrap;
  }
  .xo-section--{{ cg_id }} .cg-dotgrid__day {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    min-width: 36px;
  }
  .xo-section--{{ cg_id }} .cg-dotgrid__circle {
    width: 28px; height: 28px; border-radius: 50%;
    border: 2px solid color-mix(in srgb, rgba(var(--color-foreground)) 25%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-dotgrid__circle--on {
    background: rgba(var(--color-accent));
    border-color: rgba(var(--color-accent));
  }
  .xo-section--{{ cg_id }} .cg-dotgrid__label {
    font-size: 0.7rem; font-weight: 600;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-dotgrid__legend {
    font-size: 0.82rem; line-height: 1.6;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-dotgrid__legend span {
    display: inline-flex; align-items: center; gap: 6px; margin-right: 16px;
  }
  .xo-section--{{ cg_id }} .cg-dotgrid__legend-dot {
    width: 12px; height: 12px; border-radius: 50%; display: inline-block;
    border: 2px solid color-mix(in srgb, rgba(var(--color-foreground)) 25%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-dotgrid__legend-dot--on {
    background: rgba(var(--color-accent)); border-color: rgba(var(--color-accent));
  }
  .xo-section--{{ cg_id }} .cg-prose ol { margin: 20px 0 0; padding-left: 1.25em; }
  .xo-section--{{ cg_id }} .cg-prose ol li {
    margin-bottom: 10px;
    line-height: 1.65;
    font-size: inherit;
  }

  /* Playbook cards */
  .xo-section--{{ cg_id }} .cg-playbook {
    display: grid; grid-template-columns: 1fr; gap: 14px; margin-top: 16px;
  }
  @media (min-width: 640px) {
    .xo-section--{{ cg_id }} .cg-playbook { grid-template-columns: repeat(3, 1fr); }
  }
  .xo-section--{{ cg_id }} .cg-playbook-card {
    padding: 20px;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    background: rgba(var(--color-background));
  }
  .xo-section--{{ cg_id }} .cg-playbook-card__link {
    margin-top: 12px;
    margin-bottom: 0;
  }
  .xo-section--{{ cg_id }} .cg-prose--spaced {
    margin-top: 20px;
  }
  .xo-section--{{ cg_id }} .cg-playbook-card__title {
    font-family: var(--font-heading-family, sans-serif);
    font-size: calc(var(--font-body-scale, 1) * 1.5rem);
    font-weight: 600;
    margin: 0 0 10px;
  }

  /* FAQ */
  .xo-section--{{ cg_id }} .cg-faq { display: flex; flex-direction: column; gap: 10px; }
  .xo-section--{{ cg_id }} .cg-faq__item {
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    overflow: hidden;
    background: rgba(var(--color-background));
  }
  .xo-section--{{ cg_id }} .cg-faq__summary {
    padding: 16px 20px; cursor: pointer; list-style: none;
    font-family: var(--font-heading-family, sans-serif);
    font-size: calc(var(--font-body-scale, 1) * 1.5rem);
    font-weight: 600; line-height: 1.4;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    min-height: 44px;
  }
  .xo-section--{{ cg_id }} .cg-faq__summary::-webkit-details-marker { display: none; }
  .xo-section--{{ cg_id }} .cg-faq__summary::after {
    content: '+'; font-size: 1.2rem; font-weight: 400; flex-shrink: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 45%, transparent);
  }
  .xo-section--{{ cg_id }} .cg-faq__item[open] .cg-faq__summary::after { content: '−'; }
  .xo-section--{{ cg_id }} .cg-faq__answer {
    padding: 0 20px 18px;
    font-size: calc(var(--font-body-scale, 1) * 1.45rem);
    line-height: 1.7;
    color: color-mix(in srgb, rgba(var(--color-foreground)) calc(var(--font-body-color-opacity, 0.75) * 100%), transparent);
  }
  .xo-section--{{ cg_id }} .cg-faq__answer p { margin: 0 0 10px; }
  .xo-section--{{ cg_id }} .cg-faq__answer p:last-child { margin-bottom: 0; }

  /* Disclaimer */
  .xo-section--{{ cg_id }} .cg-disclaimer {
    background: color-mix(in srgb, rgba(var(--color-error)) 6%, transparent);
    border: 1px solid color-mix(in srgb, rgba(var(--color-error)) 18%, transparent);
    border-left: 4px solid rgba(var(--color-error));
    border-radius: 0 var(--general-radius-1, 1rem) var(--general-radius-1, 1rem) 0;
    padding: 16px 20px; margin-top: clamp(32px, 5vw, 48px);
  }
  .xo-section--{{ cg_id }} .cg-disclaimer__body {
    font-size: clamp(0.78rem, 1vw, 0.85rem); line-height: 1.65;
    color: rgba(var(--color-error));
  }
  .xo-section--{{ cg_id }} .cg-disclaimer__body p { margin: 0 0 6px; }
  .xo-section--{{ cg_id }} .cg-crosslink {
    margin-top: 24px;
    font-size: calc(var(--font-body-scale, 1) * 1.45rem);
    line-height: 1.6;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 70%, transparent);
    max-width: 72ch;
  }

  @media (min-width: 768px) {
    .xo-section--{{ cg_id }} .cg-safety {
      padding: 22px 28px;
      margin-bottom: clamp(28px, 4vw, 44px);
    }
    .xo-section--{{ cg_id }} .cg-hero {
      padding: clamp(40px, 6vw, 80px) 0 clamp(32px, 4vw, 56px);
    }
    .xo-section--{{ cg_id }} .cg-hero__sub {
      font-size: clamp(1.05rem, 1.35vw, 1.22rem);
      line-height: 1.75;
    }
    .xo-section--{{ cg_id }} .cg-hero__meta {
      font-size: calc(var(--font-body-scale, 1) * 1.35rem);
      gap: 10px 24px;
    }
    .xo-section--{{ cg_id }} .cg-hero__badge {
      font-size: calc(var(--font-body-scale, 1) * 1.2rem);
      padding: 8px 16px;
    }
    .xo-section--{{ cg_id }} .cg-toc--sidebar {
      padding: 24px;
    }
    .xo-section--{{ cg_id }} .cg-toc__title {
      font-size: calc(var(--font-body-scale, 1) * 1.2rem);
      margin-bottom: 14px;
    }
    .xo-section--{{ cg_id }} .cg-zone {
      margin-bottom: clamp(56px, 8vw, 96px);
    }
    .xo-section--{{ cg_id }} .cg-zone__h2 {
      font-size: clamp(1.65rem, 2.4vw, 2.15rem);
      margin-bottom: 24px;
      padding-bottom: 12px;
      border-bottom: 2px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    }
    .xo-section--{{ cg_id }} .cg-prose {
      font-size: calc(var(--font-body-scale, 1) * 1.6rem);
      line-height: 1.8;
    }
    .xo-section--{{ cg_id }} .cg-rules {
      gap: 18px;
    }
    .xo-section--{{ cg_id }} .cg-rule {
      padding: 24px;
      gap: 16px;
    }
    .xo-section--{{ cg_id }} .cg-rule__num {
      width: 36px;
      height: 36px;
      font-size: calc(var(--font-body-scale, 1) * 1.35rem);
    }
    .xo-section--{{ cg_id }} .cg-rule__title {
      font-size: calc(var(--font-body-scale, 1) * 1.55rem);
    }
    .xo-section--{{ cg_id }} .cg-rule__text {
      font-size: calc(var(--font-body-scale, 1) * 1.45rem);
    }
    .xo-section--{{ cg_id }} .cg-tier {
      padding: clamp(24px, 3vw, 32px);
      margin-top: 12px;
    }
    .xo-section--{{ cg_id }} .cg-table th,
    .xo-section--{{ cg_id }} .cg-table td {
      padding: 16px 20px;
    }
    .xo-section--{{ cg_id }} .cg-table {
      font-size: calc(var(--font-body-scale, 1) * 1.45rem);
    }
    .xo-section--{{ cg_id }} .cg-caution {
      padding: 24px 28px;
      margin-top: 28px;
    }
    .xo-section--{{ cg_id }} .cg-dotgrid {
      padding: 28px 32px;
      gap: 32px;
    }
    .xo-section--{{ cg_id }} .cg-dotgrid__circle {
      width: 36px;
      height: 36px;
    }
    .xo-section--{{ cg_id }} .cg-dotgrid__week {
      gap: 14px;
    }
    .xo-section--{{ cg_id }} .cg-dotgrid__label {
      font-size: calc(var(--font-body-scale, 1) * 1.2rem);
    }
    .xo-section--{{ cg_id }} .cg-dotgrid__legend {
      font-size: calc(var(--font-body-scale, 1) * 1.35rem);
    }
    .xo-section--{{ cg_id }} .cg-playbook {
      gap: 18px;
      margin-top: 20px;
    }
    .xo-section--{{ cg_id }} .cg-playbook-card {
      padding: 24px;
    }
    .xo-section--{{ cg_id }} .cg-faq {
      gap: 12px;
    }
    .xo-section--{{ cg_id }} .cg-faq__summary {
      padding: 18px 24px;
    }
    .xo-section--{{ cg_id }} .cg-faq__answer {
      padding: 0 24px 22px;
      font-size: calc(var(--font-body-scale, 1) * 1.5rem);
    }
    .xo-section--{{ cg_id }} .cg-disclaimer {
      padding: 20px 24px;
    }
    .xo-section--{{ cg_id }} .cg-disclaimer__body {
      font-size: calc(var(--font-body-scale, 1) * 1.3rem);
    }
  }

  @media (min-width: 992px) {
    .xo-section--{{ cg_id }} .cg__wrap {
      max-width: min(1200px, 100%);
    }
    .xo-section--{{ cg_id }} .cg-layout {
      grid-template-columns: 272px minmax(0, 1fr);
      gap: 64px;
    }
  }

  @media (max-width: 767px) {
    .xo-section--{{ cg_id }} .cg-layout { grid-template-columns: 1fr; gap: 0; }
    .xo-section--{{ cg_id }} .cg-toc--sidebar { display: none; }
    .xo-section--{{ cg_id }} .cg-toc--mobile { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ cg_id }} .cg-toc__link { transition: none; }
  }
{%- endstyle -%}

<section {% render 'section-attr' %} data-cycling-guide data-guide-page="cycling">
  {% render 'guide-system' %}
  <xo-container>
    <div class="cg__wrap" data-guide-root data-guide-search-url="{{ routes.search_url }}" data-guide-noun="sections">

      {% render 'reference-guide-breadcrumbs',
        parent_label: section.settings.breadcrumb_parent_label,
        parent_url: section.settings.breadcrumb_parent_url,
        current_label: section.settings.heading
      %}

      {% render 'guide-switcher', current: 'cycling' %}

      {%- if section.settings.safety_text != blank -%}
        <div class="cg-safety rte">{{ section.settings.safety_text }}</div>
      {%- endif -%}

      <header class="cg-hero">
        {%- if section.settings.eyebrow != blank -%}
          <span class="cg-hero__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="cg-hero__h1">{{ section.settings.heading }}</h1>
        {%- if section.settings.subtitle != blank -%}
          <div class="cg-hero__sub rte">{{ section.settings.subtitle }}</div>
        {%- endif -%}
        {%- if section.settings.badge_1_text != blank or section.settings.badge_2_text != blank or section.settings.badge_3_text != blank -%}
          <div class="cg-hero__badges" role="list">
            {%- if section.settings.badge_1_text != blank -%}
              <span class="cg-hero__badge" role="listitem">
                <svg class="cg-hero__badge-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
                {{ section.settings.badge_1_text }}
              </span>
            {%- endif -%}
            {%- if section.settings.badge_2_text != blank -%}
              <span class="cg-hero__badge" role="listitem">
                <svg class="cg-hero__badge-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
                {{ section.settings.badge_2_text }}
              </span>
            {%- endif -%}
            {%- if section.settings.badge_3_text != blank -%}
              <span class="cg-hero__badge" role="listitem">
                <svg class="cg-hero__badge-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 6v12M6 12h12"/></svg>
                {{ section.settings.badge_3_text }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.author != blank or section.settings.date_published != blank or section.settings.read_time != blank -%}
          <div class="cg-hero__meta">
            {%- if section.settings.author != blank -%}
              <span class="cg-hero__meta-item">{{ section.settings.author }}</span>
            {%- endif -%}
            {%- if section.settings.date_published != blank -%}
              <time class="cg-hero__meta-item" datetime="{{ section.settings.date_published }}">{{ section.settings.date_published | date: '%B %d, %Y' }}</time>
            {%- endif -%}
            {%- if section.settings.read_time != blank -%}
              <span class="cg-hero__meta-item">{{ section.settings.read_time }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </header>

      {% render 'guide-orientation',
        answers: section.settings.answers_text,
        does_not: section.settings.does_not_text,
        note: section.settings.orientation_note
      %}

      {% render 'guide-finder',
        input_id: cg_finder_id,
        label: 'Find a compound in this guide',
        placeholder: 'Search names in this guide',
        controls: 'why-cycling'
      %}
      <div class="guide-rail" data-guide-rail role="toolbar" aria-label="Browse cycling sections">
        <button type="button" class="guide-rail__btn" data-guide-cat="" aria-pressed="true">
          <svg class="guide-rail__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
          All sections
        </button>
        <button type="button" class="guide-rail__btn" data-guide-cat="tier-1" aria-pressed="false">
          <svg class="guide-rail__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          Strict-cycle
        </button>
        <button type="button" class="guide-rail__btn" data-guide-cat="tier-2" aria-pressed="false">
          <svg class="guide-rail__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h16M12 4v16"/></svg>
          Periodic-break
        </button>
        <button type="button" class="guide-rail__btn" data-guide-cat="tier-3" aria-pressed="false">
          <svg class="guide-rail__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14"/></svg>
          Daily-friendly
        </button>
        <button type="button" class="guide-rail__btn" data-guide-cat="track" aria-pressed="false">
          <svg class="guide-rail__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="6" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="18" cy="12" r="2"/></svg>
          How to track
        </button>
        <button type="button" class="guide-rail__clear" data-guide-rail-clear hidden>Clear filter</button>
      </div>
      <p class="guide-empty" data-guide-empty hidden>No section in this guide matches that name. Try a compound listed in the tables below, or open the Dosing Guide.</p>

      {% render 'guide-pathways',
        heading: section.settings.pathways_heading,
        heading_id: cg_paths_id,
        p1_title: section.settings.p1_title,
        p1_for: section.settings.p1_for,
        p1_answers: section.settings.p1_answers,
        p1_learn: section.settings.p1_learn,
        p1_leads: section.settings.p1_leads,
        p1_limit: section.settings.p1_limit,
        p1_href: section.settings.p1_href,
        p2_title: section.settings.p2_title,
        p2_for: section.settings.p2_for,
        p2_answers: section.settings.p2_answers,
        p2_learn: section.settings.p2_learn,
        p2_leads: section.settings.p2_leads,
        p2_limit: section.settings.p2_limit,
        p2_href: section.settings.p2_href,
        p3_title: section.settings.p3_title,
        p3_for: section.settings.p3_for,
        p3_answers: section.settings.p3_answers,
        p3_learn: section.settings.p3_learn,
        p3_leads: section.settings.p3_leads,
        p3_limit: section.settings.p3_limit,
        p3_href: section.settings.p3_href,
        p4_title: section.settings.p4_title,
        p4_for: section.settings.p4_for,
        p4_answers: section.settings.p4_answers,
        p4_learn: section.settings.p4_learn,
        p4_leads: section.settings.p4_leads,
        p4_limit: section.settings.p4_limit,
        p4_href: section.settings.p4_href
      %}

      <div class="cg-toc cg-toc--mobile" aria-label="On this page">
        <nav class="cg-toc__nav">
          {%- for block in section.blocks -%}
            {%- if block.type == 'jump_link' -%}
              <a class="cg-toc__link" href="#{{ block.settings.anchor }}" data-cg-toc-link {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      </div>

      <div class="cg-layout">
        <aside class="cg-toc cg-toc--sidebar" aria-label="On this page">
          <div class="cg-toc__title">On this page</div>
          <nav>
            {%- for block in section.blocks -%}
              {%- if block.type == 'jump_link' -%}
                <a class="cg-toc__link" href="#{{ block.settings.anchor }}" data-cg-toc-link {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        </aside>

        <div class="cg-main">

          {%- comment -%} Why cycling {%- endcomment -%}
          <div class="cg-zone" id="why-cycling" data-guide-static>
            <h2 class="cg-zone__h2">Why cycling exists</h2>
            {%- if section.settings.why_cycling != blank -%}
              <div class="cg-prose rte">{{ section.settings.why_cycling }}</div>
            {%- endif -%}
          </div>

          {%- comment -%} Universal rules {%- endcomment -%}
          <div class="cg-zone" id="universal-rules" data-guide-static>
            <h2 class="cg-zone__h2">The universal rules</h2>
            <div class="cg-rules">
              {%- assign rule_num = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'rule' -%}
                  {%- assign rule_num = rule_num | plus: 1 -%}
                  <div class="cg-rule" {{ block.shopify_attributes }}>
                    <div class="cg-rule__num" aria-hidden="true">{{ rule_num }}</div>
                    <div>
                      {%- if block.settings.title != blank -%}
                        <h3 class="cg-rule__title">{{ block.settings.title }}</h3>
                      {%- endif -%}
                      {%- if block.settings.body != blank -%}
                        <p class="cg-rule__text">{{ block.settings.body }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          {%- comment -%} Tier 1 {%- endcomment -%}
          <div class="cg-zone" id="tier-1" data-guide-item data-guide-cats="tier-1" data-guide-name="{{ cg_t1_html | strip_html | strip | escape }}" data-cycle-keys="{{ cg_t1_keys | strip | escape }}">
            {% render 'guide-cycle-anchors', html: cg_t1_html %}
            <h2 class="cg-zone__h2">Tier 1: Strict-cycle compounds</h2>
            {%- if section.settings.tier1_intro != blank -%}
              <div class="cg-prose rte">{{ section.settings.tier1_intro }}</div>
            {%- endif -%}
            <div class="cg-tier cg-tier--strict">
              <div class="cg-table-wrap" role="region" aria-label="Tier 1 strict-cycle compounds" tabindex="0">
                <table class="cg-table">
                  <thead>
                    <tr>
                      <th scope="col">Compound</th>
                      <th scope="col">Suggested on-days</th>
                      <th scope="col">Break pattern</th>
                      <th scope="col">Off-day pairing</th>
                    </tr>
                  </thead>
                  <tbody>
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'tier1_row' -%}
                        <tr {{ block.shopify_attributes }}>
                          <td>
                            {% if block.settings.compound != blank %}<div class="rte">{{ block.settings.compound }}</div>{% endif %}
                            {% render 'guide-dosing-exits', html: block.settings.compound %}
                          </td>
                          <td>{{ block.settings.on_days }}</td>
                          <td>{{ block.settings.break_pattern }}</td>
                          <td>{{ block.settings.off_day_pairing }}</td>
                        </tr>
                      {%- endif -%}
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
              <div class="cg-table-cards">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'tier1_row' -%}
                    <div class="cg-table-card" {{ block.shopify_attributes }}>
                      <div class="cg-table-card__label">Compound</div>
                      <div class="cg-table-card__value rte">{% if block.settings.compound != blank %}{{ block.settings.compound }}{% endif %}</div>
                      <div class="cg-table-card__label">Suggested on-days</div>
                      <div class="cg-table-card__value">{{ block.settings.on_days }}</div>
                      <div class="cg-table-card__label">Break pattern</div>
                      <div class="cg-table-card__value">{{ block.settings.break_pattern }}</div>
                      <div class="cg-table-card__label">Off-day pairing</div>
                      <div class="cg-table-card__value">{{ block.settings.off_day_pairing }}</div>
                      {% render 'guide-dosing-exits', html: block.settings.compound %}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if section.settings.phenibut_title != blank or section.settings.phenibut_body != blank -%}
                <div class="cg-caution">
                  {%- if section.settings.phenibut_title != blank -%}
                    <h3 class="cg-caution__title">{{ section.settings.phenibut_title }}</h3>
                  {%- endif -%}
                  {%- if section.settings.phenibut_body != blank -%}
                    <div class="cg-prose rte">{{ section.settings.phenibut_body }}</div>
                  {%- endif -%}
                  {%- if section.settings.phenibut_signs != blank -%}
                    <div class="cg-prose rte">{{ section.settings.phenibut_signs }}</div>
                  {%- endif -%}
                  {%- if section.settings.phenibut_taper != blank -%}
                    <div class="cg-prose rte">{{ section.settings.phenibut_taper }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>

          {%- comment -%} Tier 2 {%- endcomment -%}
          <div class="cg-zone" id="tier-2" data-guide-item data-guide-cats="tier-2" data-guide-name="{{ cg_t2_html | strip_html | strip | escape }}" data-cycle-keys="{{ cg_t2_keys | strip | escape }}">
            {% render 'guide-cycle-anchors', html: cg_t2_html %}
            <h2 class="cg-zone__h2">Tier 2: Periodic-break compounds</h2>
            {%- if section.settings.tier2_intro != blank -%}
              <div class="cg-prose rte">{{ section.settings.tier2_intro }}</div>
            {%- endif -%}
            <div class="cg-tier cg-tier--periodic">
              <div class="cg-table-wrap" role="region" aria-label="Tier 2 periodic-break compounds" tabindex="0">
                <table class="cg-table">
                  <thead>
                    <tr>
                      <th scope="col">Compound</th>
                      <th scope="col">Suggested pattern</th>
                    </tr>
                  </thead>
                  <tbody>
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'tier2_row' -%}
                        <tr {{ block.shopify_attributes }}>
                          <td>
                            {{ block.settings.compound }}
                            {% render 'guide-dosing-exits', html: block.settings.compound %}
                          </td>
                          <td>{{ block.settings.pattern }}</td>
                        </tr>
                      {%- endif -%}
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>
              <div class="cg-table-cards">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'tier2_row' -%}
                    <div class="cg-table-card" {{ block.shopify_attributes }}>
                      <div class="cg-table-card__label">Compound</div>
                      <div class="cg-table-card__value">{{ block.settings.compound }}</div>
                      <div class="cg-table-card__label">Suggested pattern</div>
                      <div class="cg-table-card__value">{{ block.settings.pattern }}</div>
                      {% render 'guide-dosing-exits', html: block.settings.compound %}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>

          {%- comment -%} Tier 3 {%- endcomment -%}
          <div class="cg-zone" id="tier-3" data-guide-item data-guide-cats="tier-3" data-guide-name="{{ cg_t3_html | strip_html | strip | escape }}" data-cycle-keys="{{ cg_t3_keys | strip | escape }}">
            {% render 'guide-cycle-anchors', html: cg_t3_html %}
            <h2 class="cg-zone__h2">Tier 3: Daily-friendly compounds</h2>
            {%- if section.settings.tier3_intro != blank -%}
              <div class="cg-prose rte">{{ section.settings.tier3_intro }}</div>
            {%- endif -%}
            <div class="cg-tier cg-tier--daily">
              {%- if section.settings.tier3_list != blank -%}
                <div class="cg-prose rte">{{ section.settings.tier3_list }}</div>
              {%- endif -%}
              {%- if section.settings.tier3_note != blank -%}
                <div class="cg-note rte">{{ section.settings.tier3_note }}</div>
              {%- endif -%}
            </div>
            {%- if section.settings.stacks_note != blank -%}
              <div class="cg-callout rte">{{ section.settings.stacks_note }}</div>
            {%- endif -%}
            {%- if section.settings.peptides_note != blank -%}
              <div class="cg-callout rte">{{ section.settings.peptides_note }}</div>
            {%- endif -%}
          </div>

          {%- comment -%} Dot grid {%- endcomment -%}
          <div class="cg-zone" id="dot-grid" data-guide-item data-guide-cats="track" data-guide-name="dot-grid tracker weekly calendar">
            <h2 class="cg-zone__h2">The weekly dot-grid method</h2>
            {%- if section.settings.dot_grid_intro != blank -%}
              <div class="cg-prose rte">{{ section.settings.dot_grid_intro }}</div>
            {%- endif -%}
            <div class="cg-dotgrid" aria-hidden="true">
              <div class="cg-dotgrid__week">
                {%- assign days = 'M,T,W,T,F,S,S' | split: ',' -%}
                {%- assign on_days = '1,0,1,0,1,0,0' | split: ',' -%}
                {%- for day in days -%}
                  {%- assign idx = forloop.index0 -%}
                  <div class="cg-dotgrid__day">
                    <span class="cg-dotgrid__circle{% if on_days[idx] == '1' %} cg-dotgrid__circle--on{% endif %}"></span>
                    <span class="cg-dotgrid__label">{{ day }}</span>
                  </div>
                {%- endfor -%}
              </div>
              <div class="cg-dotgrid__legend">
                <span><i class="cg-dotgrid__legend-dot cg-dotgrid__legend-dot--on"></i> On-day</span>
                <span><i class="cg-dotgrid__legend-dot"></i> Off-day</span>
              </div>
            </div>
            {%- if section.settings.dot_grid_steps != blank -%}
              <div class="cg-prose rte">{{ section.settings.dot_grid_steps }}</div>
            {%- endif -%}
          </div>

          {%- comment -%} Off-day playbook {%- endcomment -%}
          <div class="cg-zone" id="off-day-playbook" data-guide-item data-guide-cats="tier-3 track" data-guide-name="{{ cg_play_html | strip_html | strip | escape }}">
            <h2 class="cg-zone__h2">The off-day playbook</h2>
            {%- if section.settings.playbook_intro != blank -%}
              <div class="cg-prose rte">{{ section.settings.playbook_intro }}</div>
            {%- endif -%}
            <div class="cg-playbook">
              {%- for block in section.blocks -%}
                {%- if block.type == 'playbook_card' -%}
                  <div class="cg-playbook-card" {{ block.shopify_attributes }}>
                    {%- if block.settings.title != blank -%}
                      <h3 class="cg-playbook-card__title">{{ block.settings.title }}</h3>
                    {%- endif -%}
                    {%- if block.settings.body != blank -%}
                      <div class="cg-prose rte">{{ block.settings.body }}</div>
                    {%- endif -%}
                    {%- if block.settings.product != blank -%}
                      <p class="cg-prose cg-playbook-card__link">
                        <a href="{{ block.settings.product.url }}">View {{ block.settings.product.title }}</a>
                      </p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if section.settings.playbook_outro != blank -%}
              <div class="cg-prose cg-prose--spaced rte">{{ section.settings.playbook_outro }}</div>
            {%- endif -%}
          </div>

          {%- comment -%} Bottle math {%- endcomment -%}
          <div class="cg-zone" id="bottle-math" data-guide-item data-guide-cats="track" data-guide-name="bottle math count reorder">
            <h2 class="cg-zone__h2">Bottle math: what your count says about your cycle</h2>
            {%- if section.settings.bottle_math != blank -%}
              <div class="cg-prose rte">{{ section.settings.bottle_math }}</div>
            {%- endif -%}
          </div>

          {%- comment -%} FAQ {%- endcomment -%}
          <div class="cg-zone" id="faq" data-guide-static>
            <h2 class="cg-zone__h2">Frequently asked questions</h2>
            <div class="cg-faq">
              {%- for block in section.blocks -%}
                {%- if block.type == 'faq' -%}
                  <details class="cg-faq__item" {{ block.shopify_attributes }}>
                    <summary class="cg-faq__summary">{{ block.settings.question }}</summary>
                    <div class="cg-faq__answer rte">{{ block.settings.answer }}</div>
                  </details>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.cross_link != blank -%}
            <div class="cg-crosslink rte" data-guide-static>{{ section.settings.cross_link }}</div>
          {%- endif -%}

          {%- liquid
            assign cg_dosing_page = pages['dosing-guide']
            if cg_dosing_page != empty
              assign cg_dosing_href = cg_dosing_page.url
            else
              assign cg_dosing_href = '/pages/dosing-guide'
            endif
          -%}
          {% render 'guide-related',
            heading: section.settings.related_heading,
            heading_id: cg_related_id,
            body: section.settings.related_body,
            href: cg_dosing_href,
            cta: section.settings.related_cta,
            coa_href: cg_coa_href,
            contact_href: cg_contact_href
          %}

          {%- if section.settings.disclaimer != blank -%}
            <div class="cg-disclaimer">
              <div class="cg-disclaimer__body rte">{{ section.settings.disclaimer }}</div>
            </div>
          {%- endif -%}

        </div>
      </div>
    </div>
  </xo-container>
</section>

{% render 'reference-guide-jsonld', section: section %}

{% schema %}
{
  "name": "Cycling Guide",
  "tag": "div",
  "class": "cg-section-wrap",
  "settings": [
