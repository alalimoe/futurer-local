    { "type": "text", "id": "p1_href", "label": "Pathway 1 URL", "default": "#tier-1" },
    { "type": "text", "id": "p2_title", "label": "Pathway 2 title", "default": "Why off-days exist" },
    { "type": "text", "id": "p2_for", "label": "Pathway 2 for", "default": "You want the idea before the tables." },
