{%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
{%- assign rule_blocks = section.blocks | where: 'type', 'rule' -%}

{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: rgba(var(--color-foreground));
  }
  .xo-section--{{ section.id }} .cg-wrap {
    max-width: 960px;
    margin: 0 auto;
  }
  .xo-section--{{ section.id }} .cg-hero,
  .xo-section--{{ section.id }} .cg-panel {
    padding: clamp(1.25rem, 4vw, 2.5rem);
    margin-bottom: 1.5rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
  }
  .xo-section--{{ section.id }} .cg-hero { background: rgba(var(--color-background-2)); }
  .xo-section--{{ section.id }} .cg-eyebrow {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
  }
  .xo-section--{{ section.id }} h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  .xo-section--{{ section.id }} h2 { margin: 0 0 0.75rem; }
  .xo-section--{{ section.id }} p,
  .xo-section--{{ section.id }} li { line-height: 1.7; }
  .xo-section--{{ section.id }} .cg-muted {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 68%, transparent);
  }
  .xo-section--{{ section.id }} .cg-rules {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
  }
  .xo-section--{{ section.id }} .cg-rule {
    padding: 1rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
  }
  .xo-section--{{ section.id }} details {
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    padding: 0.8rem 0;
  }
  .xo-section--{{ section.id }} summary { cursor: pointer; font-weight: 600; }
  .xo-section--{{ section.id }} :focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }
{%- endstyle -%}

<section {% render 'section-attr' %} data-cycling-guide>
  <xo-container>
    <div class="cg-wrap">
      <header class="cg-hero">
        {%- if section.settings.eyebrow != blank -%}<span class="cg-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h1>{{ section.settings.heading | default: 'Cycling Claims: An Evidence & Safety Guide' }}</h1>
        {%- if section.settings.subtitle != blank -%}<div class="cg-muted rte">{{ section.settings.subtitle }}</div>{%- endif -%}
      </header>

      {% render 'guide-editorial-review' %}

      <section class="cg-panel" aria-labelledby="cycling-scope-{{ section.id }}">
        <h2 id="cycling-scope-{{ section.id }}">What this guide does</h2>
        <p>This page explains why “cycling” claims need product-specific evidence and professional context. It does not set on-days, off-days, break lengths, taper instructions, replacement products, or a universal schedule.</p>
        <p><strong>Follow the current product label.</strong> If a label does not provide cycling directions, do not invent a schedule from a generic table or another product.</p>
      </section>

      <section class="cg-panel" aria-labelledby="cycling-evidence-{{ section.id }}">
        <h2 id="cycling-evidence-{{ section.id }}">Evidence limits</h2>
        <ul>
          <li>Tolerance, dependence, withdrawal, and discontinuation risk differ by compound, exposure, duration, health history, and concurrent substances.</li>
          <li>Anecdotes and retailer experience do not establish a safe cycle.</li>
          <li>Evidence for one ingredient cannot be transferred automatically to a related ingredient, formulation, or stack.</li>
          <li>Some products may have no validated “cycle” at all; a break schedule is not a substitute for evidence of safety or benefit.</li>
        </ul>
      </section>

      {%- if rule_blocks.size > 0 -%}
        <section class="cg-panel" aria-labelledby="cycling-rules-{{ section.id }}">
          <h2 id="cycling-rules-{{ section.id }}">Conservative decision rules</h2>
          <div class="cg-rules">
            {%- for block in rule_blocks -%}
              <article class="cg-rule" {{ block.shopify_attributes }}>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.body }}</p>
              </article>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}

      <section class="cg-panel" aria-labelledby="cycling-escalate-{{ section.id }}">
        <h2 id="cycling-escalate-{{ section.id }}">When not to self-manage</h2>
        <p>Do not use a generic cycling page to manage dependence, withdrawal, escalating use, or persistent adverse effects. Ask a qualified healthcare professional for individualized advice. Abrupt discontinuation may be unsafe for some substances and patterns of use.</p>
        <p>Medication use, pregnancy or nursing, age under 18, health conditions, alcohol or sedative use, multiple stimulants, and competitive-sport rules all require additional caution.</p>
      </section>

      <section class="cg-panel" aria-labelledby="cycling-label-{{ section.id }}">
        <h2 id="cycling-label-{{ section.id }}">A label-first review</h2>
        <ol>
          <li>Confirm the exact product and ingredient; similar names are not interchangeable.</li>
          <li>Read the current directions, warnings, contraindications, and storage information.</li>
          <li>Check medications, supplements, alcohol, caffeine, and other exposures with a pharmacist or clinician.</li>
          <li>If unwanted effects, escalating use, or difficulty stopping occur, seek qualified care rather than changing the schedule yourself.</li>
        </ol>
      </section>

      {%- if faq_blocks.size > 0 -%}
        <section class="cg-panel" aria-labelledby="cycling-faq-{{ section.id }}">
          <h2 id="cycling-faq-{{ section.id }}">Frequently asked questions</h2>
          {%- for block in faq_blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="rte">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </section>
      {%- endif -%}

      {%- if section.settings.disclaimer != blank -%}
        <div class="cg-panel cg-muted rte">{{ section.settings.disclaimer }}</div>
      {%- endif -%}
    </div>
  </xo-container>
</section>

