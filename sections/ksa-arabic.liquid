{%- style -%}
  .xo-section--{{ section.id }} .ksa-arabic {
    max-width: 88rem;
    margin: 0 auto;
  }

  .xo-section--{{ section.id }} .ksa-arabic__header {
    max-width: 68rem;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .xo-section--{{ section.id }} .ksa-arabic__title {
    margin: 0 0 1.2rem;
    font-size: clamp(3.2rem, 5vw, 6.6rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .xo-section--{{ section.id }} .ksa-arabic__intro {
    margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
    font-size: 1.6rem;
    line-height: 1.8;
  }

  .xo-section--{{ section.id }} .ksa-arabic__item {
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
  }

  .xo-section--{{ section.id }} .ksa-arabic__item:last-child {
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
  }

  .xo-section--{{ section.id }} .ksa-arabic__question {
    display: flex;
    min-height: 6.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.8rem 0;
    color: rgba(var(--color-foreground));
    cursor: pointer;
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.6;
    list-style: none;
  }

  .xo-section--{{ section.id }} .ksa-arabic__question::-webkit-details-marker {
    display: none;
  }

  .xo-section--{{ section.id }} .ksa-arabic__icon {
    position: relative;
    width: 2rem;
    height: 2rem;
    flex: 0 0 2rem;
  }

  .xo-section--{{ section.id }} .ksa-arabic__icon::before,
  .xo-section--{{ section.id }} .ksa-arabic__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.4rem;
    height: 0.2rem;
    background: rgba(var(--color-foreground));
    transform: translate(-50%, -50%);
  }

  .xo-section--{{ section.id }} .ksa-arabic__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .xo-section--{{ section.id }} .ksa-arabic__item[open] .ksa-arabic__icon::after {
    display: none;
  }

  .xo-section--{{ section.id }} .ksa-arabic__answer {
    padding: 0 0 2.4rem 4rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
    font-size: 1.5rem;
    line-height: 1.85;
  }

  .xo-section--{{ section.id }} .ksa-arabic__answer p {
    margin: 0;
  }

  .xo-section--{{ section.id }} summary:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 3px;
  }
{%- endstyle -%}

{%- assign arabic_faqs = section.blocks | where: 'type', 'faq' -%}

<section id="ksa-arabic" {% render 'section-attr', section: section %} aria-labelledby="ksa-arabic-title-{{ section.id }}">
  <xo-container>
    <div class="ksa-arabic" lang="ar" dir="rtl">
      <header class="ksa-arabic__header">
        <h2 id="ksa-arabic-title-{{ section.id }}" class="ksa-arabic__title">{{ section.settings.heading }}</h2>
        <div class="ksa-arabic__intro">{{ section.settings.intro }}</div>
      </header>
      <div>
        {%- for block in arabic_faqs -%}
          <details class="ksa-arabic__item" {{ block.shopify_attributes }}>
            <summary class="ksa-arabic__question">
              <span>{{ block.settings.question }}</span>
              <span class="ksa-arabic__icon" aria-hidden="true"></span>
            </summary>
            <div class="ksa-arabic__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "KSA Arabic FAQ",
  "tag": "section",
  "class": "section-ksa-arabic",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "النوتروبيكس في السعودية" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>معلومات مختصرة وواضحة عن المنتجات والشحن السريع من دبي إلى المملكة العربية السعودية.</p>" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "سؤال",
      "settings": [
        { "type": "text", "id": "question", "label": "السؤال" },
        { "type": "richtext", "id": "answer", "label": "الإجابة" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "KSA Arabic FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "هل تشحن نوتروبيكس إلى السعودية؟", "answer": "<p>نعم. تُشحن الطلبات من دبي إلى عناوين المملكة العربية السعودية عبر الشحن السريع.</p>" } },
        { "type": "faq", "settings": { "question": "كم يستغرق التوصيل إلى السعودية؟", "answer": "<p>يستغرق التوصيل ٣ أيام في المتوسط بعد شحن الطلب في اليوم نفسه. هذه مدة متوسطة وليست ضماناً، وقد تختلف حسب الوجهة ووقت الطلب.</p>" } },
        { "type": "faq", "settings": { "question": "متى يكون الشحن السريع مجانياً؟", "answer": "<p>يكون الشحن السريع إلى السعودية مجانياً عندما تبلغ قيمة الطلب ٣٠٠ ريال سعودي أو أكثر.</p>" } },
        { "type": "faq", "settings": { "question": "هل لدى نوتروبيكس متجر أو مستودع في السعودية؟", "answer": "<p>لا. نوتروبيكس متجر إلكتروني مقره دبي، وتُشحن طلبات السعودية من دبي.</p>" } },
        { "type": "faq", "settings": { "question": "ما هي النوتروبيكس؟", "answer": "<p>النوتروبيكس مصطلح عام لمنتجات يضيفها بعض الأشخاص إلى روتين يرتبط بالتركيز أو الذاكرة أو المزاج أو الطاقة أو النوم أو العافية طويلة المدى. تختلف المنتجات حسب المكونات والشكل.</p>" } },
        { "type": "faq", "settings": { "question": "كيف أختار المنتج؟", "answer": "<p>ابدأ بهدف واحد واضح، وقارن قائمة المكونات الكاملة وإرشادات الاستخدام والتحذيرات والسعر والتوفر الحالي، ثم اتبع تعليمات ملصق المنتج.</p>" } },
        { "type": "faq", "settings": { "question": "هل تتوفر شهادات التحليل؟", "answer": "<p>تتوفر شهادات التحليل للمنتجات المؤهلة. راجع مكتبة الشهادات أو تواصل مع الدعم للحصول على معلومات خاصة بالمنتج.</p>" } },
        { "type": "faq", "settings": { "question": "هل هذه الصفحة نصيحة طبية؟", "answer": "<p>لا. هذه الصفحة للتثقيف فقط وليست نصيحة طبية. استشر مختصاً صحياً مؤهلاً عند الحاجة إلى إرشاد طبي شخصي.</p>" } }
      ]
    }
  ]
}
{% endschema %}
