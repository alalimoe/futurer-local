{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    scroll-margin-top: 10rem;
  }

  .xo-section--{{ section.id }} .gs-head {
    margin-bottom: 2.4rem;
    max-width: 62ch;
  }

  .xo-section--{{ section.id }} .gs-heading {
    margin: 0 0 0.8rem;
    font-size: clamp(2.4rem, 3vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .gs-sub {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.6;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
  }

  .xo-section--{{ section.id }} .gs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  @media (min-width: 768px) {
    .xo-section--{{ section.id }} .gs-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.4rem;
    }
  }

  .xo-section--{{ section.id }} .gs-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.4rem;
    border-radius: var(--general-radius-3, 2rem);
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 8%, transparent);
    background: rgba(var(--color-background));
    min-height: 100%;
    transition: border-color 0.2s ease;
  }

  .xo-section--{{ section.id }} .gs-card:hover {
    border-color: color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
  }

  .xo-section--{{ section.id }} .gs-card__audience {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
  }

  .xo-section--{{ section.id }} .gs-card__title {
    margin: 0;
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .gs-card__text {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.6;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
  }

  .xo-section--{{ section.id }} .gs-card__compounds {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .xo-section--{{ section.id }} .gs-card__compound {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.4rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 70%, transparent);
  }

  .xo-section--{{ section.id }} .gs-card__compound::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    flex-shrink: 0;
    background: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .gs-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    align-items: center;
    margin-top: auto;
    padding-top: 0.8rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ section.id }} .gs-card {
      transition: none;
    }
  }
{%- endstyle -%}

<section
  {% render 'section-attr' %}
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | escape }}"{% endif %}
>
  <xo-container>
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="gs-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="gs-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="gs-sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="gs-grid">
      {%- for block in section.blocks -%}
        <article class="gs-card" {{ block.shopify_attributes }}>
          {%- if block.settings.audience != blank -%}
            <p class="gs-card__audience">{{ block.settings.audience | escape }}</p>
          {%- endif -%}
          <h3 class="gs-card__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="gs-card__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.compounds != blank -%}
            {%- assign items = block.settings.compounds | split: ',' -%}
            <ul class="gs-card__compounds">
              {%- for item in items -%}
                {%- assign trimmed = item | strip -%}
                {%- if trimmed != blank -%}
                  <li class="gs-card__compound">{{ trimmed | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="gs-card__actions">
            {%- if block.settings.primary_label != blank and block.settings.primary_url != blank -%}
              {% render 'button',
                text: block.settings.primary_label,
                link: block.settings.primary_url,
                style: 'primary',
                size: 'sm'
              %}
            {%- endif -%}
            {%- if block.settings.secondary_label != blank and block.settings.secondary_url != blank -%}
              {% render 'button',
                text: block.settings.secondary_label,
                link: block.settings.secondary_url,
                style: 'link',
                size: 'sm'
              %}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "Guides situations",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay", "custom.popups", "custom.features"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Focus situations" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick the day you are actually having, then shop the stack behind it." },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Used by jump chips, e.g. guides-focus" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "situation",
      "name": "Situation card",
      "settings": [
        { "type": "text", "id": "audience", "label": "Who it is for" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "textarea", "id": "compounds", "label": "Compounds (comma-separated)" },
        { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Shop this stack" },
        { "type": "url", "id": "primary_url", "label": "Primary link" },
        { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Learn the why" },
        { "type": "url", "id": "secondary_url", "label": "Secondary link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guides situations",
      "blocks": [
        { "type": "situation", "settings": { "audience": "Deep work", "title": "Deep-work afternoon", "compounds": "Caffeine + L-Theanine, Alpha-GPC, Lion's Mane" } },
        { "type": "situation", "settings": { "audience": "Study", "title": "Exam week", "compounds": "Caffeine + L-Theanine, Alpha-GPC" } },
        { "type": "situation", "settings": { "audience": "Meetings", "title": "Calm focus", "compounds": "Caffeine + L-Theanine" } }
      ]
    }
  ]
}
{% endschema %}
