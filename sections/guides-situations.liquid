{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    scroll-margin-top: 10rem;
  }

  .xo-section--{{ section.id }} .gs-head {
    margin-bottom: 3.2rem;
    max-width: 48ch;
  }

  .xo-section--{{ section.id }} .gs-heading {
    margin: 0 0 1rem;
    font-size: clamp(2.8rem, 3.4vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .gs-sub {
    margin: 0;
    font-size: 1.6rem;
    line-height: 1.65;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
  }

  .xo-section--{{ section.id }} .gs-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .xo-section--{{ section.id }} .gs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .xo-section--{{ section.id }} .gs-card {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 2.4rem 0;
    min-height: 100%;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
  }

  @media (min-width: 768px) {
    .xo-section--{{ section.id }} .gs-card {
      padding: 0 2.8rem;
      border-top: 0;
    }

    .xo-section--{{ section.id }} .gs-card:first-child {
      padding-left: 0;
    }

    .xo-section--{{ section.id }} .gs-card:last-child {
      padding-right: 0;
    }

    .xo-section--{{ section.id }} .gs-card + .gs-card {
      border-left: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
    }
  }

  .xo-section--{{ section.id }} .gs-card__audience {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 50%, transparent);
  }

  .xo-section--{{ section.id }} .gs-card__title {
    margin: 0;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .gs-card__text {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.65;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
  }

  .xo-section--{{ section.id }} .gs-card__meta {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1.2rem;
    font-size: 1.4rem;
    line-height: 1.5;
  }

  .xo-section--{{ section.id }} .gs-card__meta dt {
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 1.1rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 45%, transparent);
  }

  .xo-section--{{ section.id }} .gs-card__meta dd {
    margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 70%, transparent);
  }

  .xo-section--{{ section.id }} .gs-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2rem;
    align-items: center;
    margin-top: auto;
    padding-top: 1.2rem;
  }

  .xo-section--{{ section.id }} .gs-card__link {
    font-size: 1.5rem;
    font-weight: 600;
    color: rgba(var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, rgba(var(--color-foreground)) 28%, transparent);
  }

  .xo-section--{{ section.id }} .gs-card__link:hover {
    text-decoration-color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .gs-card__link:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 3px;
  }

  .xo-section--{{ section.id }} .gs-table {
    display: flex;
    flex-direction: column;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
  }

  .xo-section--{{ section.id }} .gs-table__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
    padding: 2.4rem 0;
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
  }

  @media (min-width: 768px) {
    .xo-section--{{ section.id }} .gs-table__row {
      grid-template-columns: 12rem 1.2fr 1.4fr auto;
      gap: 2.4rem;
      align-items: center;
      padding: 2.8rem 0;
    }
  }

  .xo-section--{{ section.id }} .gs-table__audience {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 50%, transparent);
  }

  .xo-section--{{ section.id }} .gs-table__title {
    margin: 0 0 0.4rem;
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .gs-table__text {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.5;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 70%, transparent);
  }

  .xo-section--{{ section.id }} .gs-table__compounds {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.5;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 70%, transparent);
  }

  .xo-section--{{ section.id }} .gs-table__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2rem;
    align-items: center;
  }
{%- endstyle -%}

{%- liquid
  assign gs_layout = section.settings.layout | default: 'columns'
-%}

<section
  {% render 'section-attr' %}
  {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | escape }}"{% endif %}
>
  <xo-container>
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="gs-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="gs-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="gs-sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if gs_layout == 'table' -%}
      <div class="gs-table" role="table">
        {%- for block in section.blocks -%}
          {%- liquid
            assign primary_is_shop = false
            if block.settings.primary_url contains 'products/'
              assign primary_is_shop = true
            endif
            if block.settings.primary_url contains 'collections/'
              assign primary_is_shop = true
            endif
          -%}
          <div class="gs-table__row" role="row" {{ block.shopify_attributes }}>
            <p class="gs-table__audience">{{ block.settings.audience | escape }}</p>
            <div>
              <h3 class="gs-table__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="gs-table__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
            <p class="gs-table__compounds">{{ block.settings.compounds | escape }}</p>
            <div class="gs-table__actions">
              {%- if block.settings.secondary_label != blank and block.settings.secondary_url != blank -%}
                <a class="gs-card__link" href="{{ block.settings.secondary_url }}">{{ block.settings.secondary_label | escape }}</a>
              {%- endif -%}
              {%- if block.settings.primary_label != blank and block.settings.primary_url != blank -%}
                {%- if primary_is_shop -%}
                  {% render 'button',
                    text: block.settings.primary_label,
                    link: block.settings.primary_url,
                    style: 'primary',
                    size: 'sm'
                  %}
                {%- else -%}
                  <a class="gs-card__link" href="{{ block.settings.primary_url }}">{{ block.settings.primary_label | escape }}</a>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="gs-grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign primary_is_shop = false
            if block.settings.primary_url contains 'products/'
              assign primary_is_shop = true
            endif
            if block.settings.primary_url contains 'collections/'
              assign primary_is_shop = true
            endif
          -%}
          <article class="gs-card" {{ block.shopify_attributes }}>
            {%- if block.settings.audience != blank -%}
              <p class="gs-card__audience">{{ block.settings.audience | escape }}</p>
            {%- endif -%}
            <h3 class="gs-card__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="gs-card__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.compounds != blank -%}
              <dl class="gs-card__meta">
                <dt>Compounds</dt>
                <dd>{{ block.settings.compounds | escape }}</dd>
              </dl>
            {%- endif -%}
            <div class="gs-card__actions">
              {%- if block.settings.primary_label != blank and block.settings.primary_url != blank -%}
                {%- if primary_is_shop -%}
                  {% render 'button',
                    text: block.settings.primary_label,
                    link: block.settings.primary_url,
                    style: 'primary',
                    size: 'sm'
                  %}
                {%- else -%}
                  <a class="gs-card__link" href="{{ block.settings.primary_url }}">{{ block.settings.primary_label | escape }}</a>
                {%- endif -%}
              {%- endif -%}
              {%- if block.settings.secondary_label != blank and block.settings.secondary_url != blank -%}
                <a class="gs-card__link" href="{{ block.settings.secondary_url }}">{{ block.settings.secondary_label | escape }}</a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </xo-container>
</section>

{% schema %}
{
  "name": "Guides situations",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay", "custom.popups", "custom.features"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Focus situations" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick the day you are actually having, then shop the stack behind it." },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Used by jump chips, e.g. guides-focus" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [
      { "value": "columns", "label": "Columns" },
      { "value": "table", "label": "Table" }
    ], "default": "columns" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "situation",
      "name": "Situation card",
      "settings": [
        { "type": "text", "id": "audience", "label": "Who it is for" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "textarea", "id": "compounds", "label": "Compounds (comma-separated)" },
        { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Shop this stack" },
        { "type": "url", "id": "primary_url", "label": "Primary link" },
        { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Learn the why" },
        { "type": "url", "id": "secondary_url", "label": "Secondary link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guides situations",
      "blocks": [
        { "type": "situation", "settings": { "audience": "Deep work", "title": "Deep-work afternoon", "compounds": "Caffeine + L-Theanine, Alpha-GPC, Lion's Mane" } },
        { "type": "situation", "settings": { "audience": "Study", "title": "Exam week", "compounds": "Caffeine + L-Theanine, Alpha-GPC" } },
        { "type": "situation", "settings": { "audience": "Meetings", "title": "Calm focus", "compounds": "Caffeine + L-Theanine" } }
      ]
    }
  ]
}
{% endschema %}
