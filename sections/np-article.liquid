{{ 'article-card.css' | asset_url | stylesheet_tag }}

{% liquid
  assign article_author = article.metafields.custom.author.value | default: article.author
  assign author_credentials = article.metafields.custom.author_credentials.value
  assign reviewed_by = article.metafields.custom.reviewed_by.value
  assign last_reviewed = article.metafields.custom.last_reviewed.value
  assign review_status = article.metafields.custom.review_status.value
  case review_status
    when 'reviewed'
      assign review_status_label = 'Reviewed'
    when 'needs_revision'
      assign review_status_label = 'Needs revision'
    when 'pending'
      assign review_status_label = 'Review pending'
  endcase
  assign citations = article.metafields.custom.citations.value
  assign explicit_related_articles = article.metafields.custom.related_articles.value
  assign related_limit = section.settings.related_articles_limit | default: 3
  assign explicit_related_count = 0

  if explicit_related_articles != blank
    for related_article in explicit_related_articles
      if related_article.id != article.id and related_article.url != blank
        assign explicit_related_count = explicit_related_count | plus: 1
        if explicit_related_count >= related_limit
          break
        endif
      endif
    endfor
  endif

  assign tagged_related_count = 0
  if explicit_related_count == 0
    for candidate in blog.articles
      if candidate.id != article.id and candidate.url != blank
        assign shares_tag = false
        for current_tag in article.tags
          if candidate.tags contains current_tag
            assign shares_tag = true
            break
          endif
        endfor
        if shares_tag
          assign tagged_related_count = tagged_related_count | plus: 1
          if tagged_related_count >= related_limit
            break
          endif
        endif
      endif
    endfor
  endif

  assign same_blog_related_count = 0
  if explicit_related_count == 0 and tagged_related_count == 0
    for candidate in blog.articles
      if candidate.id != article.id and candidate.url != blank
        assign same_blog_related_count = same_blog_related_count | plus: 1
        if same_blog_related_count >= related_limit
          break
        endif
      endif
    endfor
  endif
%}

{%- style -%}
  .xo-section--{{ section.id }} {
    --max-width: {{ section.settings.max_width }}px;
    --content-gap: {{ section.settings.content_gap | divided_by: 10.0 }}rem;
    --toc-width: {{ section.settings.toc_width }}px;
    --sticky-offset: {{ section.settings.sticky_offset }}px;

    --line-height: {{ section.settings.line_height }};
    --title-size: {{ section.settings.title_size | divided_by: 10.0 }}rem;
    --body-size: {{ section.settings.body_size | divided_by: 10.0 }}rem;
    --meta-size: {{ section.settings.meta_size | divided_by: 10.0 }}rem;
    --h1: {{ section.settings.title_size | divided_by: 10.0 }}rem;
    --h2: {{ section.settings.h2_size | divided_by: 10.0 }}rem;
    --h3: {{ section.settings.h3_size | divided_by: 10.0 }}rem;

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .np-reading-progress-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background-color: transparent;
    z-index: 9999;
    pointer-events: none;
  }

  .np-reading-progress-bar {
    height: 100%;
    width: 100%;
    background-color: rgba(var(--color-accent));
    transform-origin: left;
    transform: scaleX(0);
    will-change: transform;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes npFadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .np-animate-in {
      animation: npFadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .np-animate-in {
      animation: none;
    }

    .np-reading-progress-container {
      display: none;
    }

    .xo-section--{{ section.id }} .np-hero:hover img {
      transform: none;
    }

    .xo-section--{{ section.id }} *,
    .xo-section--{{ section.id }} *::before,
    .xo-section--{{ section.id }} *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }

  .xo-section--{{ section.id }} .np-container {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--content-gap);
    align-items: start;
  }

  @media (min-width: 993px) {
    .xo-section--{{ section.id }} .np-container--toc-ready {
      grid-template-columns: var(--toc-width) 1fr;
    }
  }

  .xo-section--{{ section.id }} .np-hero {
    margin: 0 0 3.5rem 0;
    border-radius: var(--general-radius-1, 1rem);
    overflow: hidden;
    position: relative;
    background-color: rgba(var(--color-background-2));
  }

  .xo-section--{{ section.id }} .np-hero img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .xo-section--{{ section.id }} .np-hero:hover img { transform: scale(1.02); }

  .xo-section--{{ section.id }} .np-toc-wrapper {
    position: sticky;
    top: var(--sticky-offset);
    padding: 0;
    max-height: calc(100vh - var(--sticky-offset) - 2rem);
    overflow-y: auto;
  }

  .xo-section--{{ section.id }} .np-toc-wrapper::-webkit-scrollbar { width: 4px; }
  .xo-section--{{ section.id }} .np-toc-wrapper::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
    border-radius: 4px;
  }

  .xo-section--{{ section.id }} .np-toc__title {
    font-size: 1.3rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 60%, transparent);
    margin: 0 0 1.2rem 0;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .np-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-left: 2px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
  }

  .xo-section--{{ section.id }} .np-toc__link {
    display: block;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
    font-size: 1.6rem;
    line-height: 1.45;
    font-weight: 500;
    text-decoration: none;
    padding: 0.8rem 0 0.8rem 1.4rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .xo-section--{{ section.id }} .np-toc__link--sub {
    font-size: 1.5rem;
    padding-left: 2.6rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
  }

  .xo-section--{{ section.id }} .np-toc__link:hover { color: rgba(var(--color-foreground)); }

  .xo-section--{{ section.id }} .np-toc__link.active {
    color: rgba(var(--color-foreground));
    font-weight: 600;
    border-left-color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .np-toc__link:focus-visible {
    outline: 2px solid rgba(var(--color-foreground));
    outline-offset: 2px;
    border-radius: 4px;
  }

  .xo-section--{{ section.id }} .np-header { margin-bottom: 4rem; text-align: {{ section.settings.text_alignment }}; }

  .xo-section--{{ section.id }} .np-title {
    font-size: var(--title-size);
    color: rgba(var(--color-foreground));
    line-height: 1.1;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .np-meta-container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: {% if section.settings.text_alignment == 'center' %}center{% else %}flex-start{% endif %};
    gap: 1.5rem;
  }

  .xo-section--{{ section.id }} .np-meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--meta-size);
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .xo-section--{{ section.id }} .np-meta__dot { color: rgba(var(--color-accent)); font-weight: 600; }

  .np-share-btn {
    background: transparent;
    border: 2px solid rgba(var(--color-accent));
    border-radius: var(--button-radius);
    padding: 0.5rem 1.2rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(var(--color-foreground));
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    min-height: var(--touch-min, 44px);
    min-width: var(--touch-min, 44px);
  }

  .np-share-btn:hover {
    border-color: rgba(var(--color-accent));
    color: rgba(var(--color-foreground));
    background: rgba(var(--color-background-2));
  }

  .np-visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .xo-section--{{ section.id }} .np-review-details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 1.5rem 0 0;
    font-size: var(--meta-size);
    color: color-mix(in srgb, rgba(var(--color-foreground)) 70%, transparent);
  }

  .xo-section--{{ section.id }} .np-review-details__item {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .xo-section--{{ section.id }} .np-review-details dt {
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .np-review-details dd {
    margin: 0;
  }

  .xo-section--{{ section.id }} .np-excerpt {
    font-size: calc(var(--body-size) * 1.15);
    color: color-mix(in srgb, rgba(var(--color-foreground)) 55%, transparent);
    margin-top: 2rem;
    line-height: 1.6;
    font-weight: 400;
    max-width: 800px;
    {% if section.settings.text_alignment == 'center' %}margin-left: auto; margin-right: auto;{% endif %}
  }

  .xo-section--{{ section.id }} .np-body {
    font-size: var(--body-size);
    line-height: var(--line-height);
  }

  .xo-section--{{ section.id }} .np-body h2,
  .xo-section--{{ section.id }} .np-body h3 {
    color: rgba(var(--color-foreground));
    margin: 3.5rem 0 1.5rem 0;
    line-height: 1.2;
    scroll-margin-top: calc(var(--sticky-offset) + 2rem);
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .np-body h2 { font-size: var(--h2); letter-spacing: -0.01em; }
  .xo-section--{{ section.id }} .np-body h3 { font-size: var(--h3); }

  .xo-section--{{ section.id }} .np-body p { margin-bottom: 1.75rem; color: rgba(var(--color-foreground)); }

  .xo-section--{{ section.id }} .np-body a {
    color: rgba(var(--color-foreground));
    text-decoration: underline;
    text-decoration-color: rgba(var(--color-accent));
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: all 0.3s ease;
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .np-body a:hover {
    color: rgba(var(--color-accent));
    text-decoration-color: rgba(var(--color-accent));
    background-color: color-mix(in srgb, rgba(var(--color-accent)) 10%, transparent);
  }

  .xo-section--{{ section.id }} .np-body blockquote {
    position: relative;
    border-left: none;
    margin: 3rem 0;
    padding: 2.5rem 3rem;
    font-style: italic;
    color: rgba(var(--color-foreground));
    background: rgba(var(--color-background-2));
    border-radius: var(--general-radius-1, 1rem);
    font-size: calc(var(--body-size) * 1.2);
    box-shadow: inset 4px 0 0 rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .np-body img {
    border-radius: var(--general-radius-1, 1rem);
    margin: 3rem 0;
    width: 100%;
    height: auto;
  }

  .xo-section--{{ section.id }} .np-body ul,
  .xo-section--{{ section.id }} .np-body ol { margin: 2rem 0; padding-left: 1rem; }
  .xo-section--{{ section.id }} .np-body li { margin-bottom: 0.75rem; position: relative; }

  .xo-section--{{ section.id }} .np-body ul { list-style: none; }
  .xo-section--{{ section.id }} .np-body ul li::before {
    content: "";
    position: absolute;
    left: -1.25rem;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .np-citations,
  .xo-section--{{ section.id }} .np-related-articles {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
  }

  .xo-section--{{ section.id }} .np-citations__title,
  .xo-section--{{ section.id }} .np-related-articles__title {
    margin: 0 0 2rem;
    font-size: var(--h2);
    line-height: 1.2;
  }

  .xo-section--{{ section.id }} .np-citations__list {
    margin: 0;
    padding-left: 2.2rem;
  }

  .xo-section--{{ section.id }} .np-citations__list li {
    margin-bottom: 1rem;
    padding-left: 0.5rem;
  }

  .xo-section--{{ section.id }} .np-citations__source {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 65%, transparent);
  }

  .xo-section--{{ section.id }} .np-related-articles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  @media (max-width: 992px) {
    .xo-section--{{ section.id }} .np-container { grid-template-columns: 1fr; gap: 3rem; }
    .xo-section--{{ section.id }} .np-toc-wrapper {
      position: relative;
      top: 0;
      order: -1;
      max-height: none;
    }
    .xo-section--{{ section.id }} .np-title { font-size: calc(var(--title-size) * 0.75); }
    .xo-section--{{ section.id }} .np-body h2 { font-size: calc(var(--h2) * 0.85); }
    .xo-section--{{ section.id }} .np-body blockquote { padding: 1.5rem 2rem; font-size: calc(var(--body-size) * 1.1); }
    .xo-section--{{ section.id }} .np-related-articles__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 768px) {
    .xo-section--{{ section.id }} .np-header { margin-bottom: 2.5rem; }
    .xo-section--{{ section.id }} .np-body p { margin-bottom: 1.25rem; }
    .xo-section--{{ section.id }} .np-body img { margin: 2rem 0; }
    .xo-section--{{ section.id }} .np-body blockquote { padding: 1.25rem 1.5rem; margin: 2rem 0; }
    .xo-section--{{ section.id }} .np-related-articles__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<div class="np-reading-progress-container" aria-hidden="true">
  <div class="np-reading-progress-bar" id="np-progress-bar-{{ section.id }}"></div>
</div>

<section id="np-section-{{ section.id }}" {% render 'section-attr' %}>
  <xo-container>
    <div class="np-container np-animate-in">

      {% if section.settings.show_toc %}
        <aside class="np-toc-wrapper" id="np-toc-{{ section.id }}" aria-label="Table of contents" hidden>
          <h3 class="np-toc__title">{{ section.settings.toc_title }}</h3>
          <nav>
            <ul class="np-toc__list" id="np-toc-list-{{ section.id }}">
            </ul>
          </nav>
        </aside>
      {% endif %}

      <article class="np-content">

        <header class="np-header">
          <h1 class="np-title">{{ article.title | escape }}</h1>

          <div class="np-meta-container">
            <div class="np-meta">
              {% if section.settings.show_author and article_author != blank %}
                <span class="np-meta__item">
                  <span>{{ article_author | escape }}</span>
                  {% if author_credentials != blank %}
                    <span>, {{ author_credentials | escape }}</span>
                  {% endif %}
                </span>
              {% endif %}

              {% if section.settings.show_date %}
                {% if section.settings.show_author and article_author != blank %}<span class="np-meta__dot">&middot;</span>{% endif %}
                <time class="np-meta__item" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{ article.published_at | date: "%B %e, %Y" }}
                </time>
              {% endif %}

              {% if section.settings.show_reading_time %}
                {% assign words = article.content | strip_html | split: ' ' | size %}
                {% assign minutes = words | divided_by: 200 | ceil %}
                {% if minutes == 0 %}{% assign minutes = 1 %}{% endif %}
                {% if section.settings.show_date %}
                  <span class="np-meta__dot">&middot;</span>
                {% elsif section.settings.show_author and article_author != blank %}
                  <span class="np-meta__dot">&middot;</span>
                {% endif %}
                <span class="np-meta__item">{{ minutes }} min read</span>
              {% endif %}
            </div>

            <button class="np-share-btn" id="np-share-{{ section.id }}" aria-label="Share this article" type="button">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
              <span class="np-share-text">Share</span>
            </button>
            <span class="np-visually-hidden" id="np-share-status-{{ section.id }}" role="status" aria-live="polite" aria-atomic="true"></span>
          </div>

          {% if reviewed_by != blank or last_reviewed != blank or review_status != blank %}
            <dl class="np-review-details" aria-label="Editorial review details">
              {% if reviewed_by != blank %}
                <div class="np-review-details__item">
                  <dt>Reviewed by</dt>
                  <dd>{{ reviewed_by | escape }}</dd>
                </div>
              {% endif %}
              {% if last_reviewed != blank %}
                <div class="np-review-details__item">
                  <dt>Last reviewed</dt>
                  <dd><time datetime="{{ last_reviewed | date: '%Y-%m-%d' }}">{{ last_reviewed | date: '%B %e, %Y' }}</time></dd>
                </div>
              {% endif %}
              {% if review_status_label != blank %}
                <div class="np-review-details__item">
                  <dt>Review status</dt>
                  <dd>{{ review_status_label | escape }}</dd>
                </div>
              {% endif %}
            </dl>
          {% endif %}

          {% if article.excerpt != blank and section.settings.show_excerpt %}
            <p class="np-excerpt">{{ article.excerpt | strip_html | escape }}</p>
          {% endif %}
        </header>

        {% if section.settings.show_featured_image and article.image %}
          <figure class="np-hero">
            {%- assign hero_alt = article.image.alt | default: article.title | escape -%}
            {{ article.image | image_url: width: 2000 | image_tag: 
              loading: 'eager', 
              fetchpriority: 'high',
              sizes: '(max-width: 768px) 100vw, (max-width: 1200px) 70vw, 1200px',
              widths: '400, 600, 800, 1200, 1600, 2000',
              alt: hero_alt, 
              class: 'np-hero-img' 
            }}
          </figure>
        {% endif %}

        <div class="np-body rte" id="np-body-{{ section.id }}">
          {{ article.content }}
        </div>

        {% if citations != blank %}
          <section class="np-citations" aria-labelledby="np-citations-title-{{ section.id }}">
            <h2 class="np-citations__title" id="np-citations-title-{{ section.id }}">Citations</h2>
            <ol class="np-citations__list">
              {% for citation in citations %}
                {% liquid
                  assign citation_title = citation.title.value | default: citation.title
                  assign citation_source = citation.source.value | default: citation.source | default: citation.publisher.value | default: citation.publisher
                  assign citation_url = citation.url.value | default: citation.url
                  assign citation_date = citation.published_date.value | default: citation.published_date
                  assign citation_tier = citation.evidence_tier.value | default: citation.evidence_tier
                  if citation_title == blank and citation_source == blank and citation_url == blank
                    assign citation_title = citation
                  endif
                  assign citation_label = citation_title | default: citation_source | default: citation_url
                %}
                {% if citation_label != blank %}
                  <li>
                    {% if citation_url != blank %}
                      <a href="{{ citation_url | escape }}">{{ citation_label | escape }}</a>
                    {% else %}
                      <span>{{ citation_label | escape }}</span>
                    {% endif %}
                    {% if citation_source != blank and citation_source != citation_label %}
                      <span class="np-citations__source"> — {{ citation_source | escape }}</span>
                    {% endif %}
                    {% if citation_date != blank %}
                      <span class="np-citations__source"> ({{ citation_date | date: '%Y' }})</span>
                    {% endif %}
                    {% if citation_tier != blank %}
                      <span class="np-citations__source"> · {{ citation_tier | escape }}</span>
                    {% endif %}
                  </li>
                {% endif %}
              {% endfor %}
            </ol>
          </section>
        {% endif %}

        {% if section.settings.show_related_articles %}
          {% if explicit_related_count > 0 or tagged_related_count > 0 or same_blog_related_count > 0 %}
            <section class="np-related-articles" aria-labelledby="np-related-title-{{ section.id }}">
              <h2 class="np-related-articles__title" id="np-related-title-{{ section.id }}">{{ section.settings.related_articles_title | escape }}</h2>
              <div class="np-related-articles__grid">
                {% if explicit_related_count > 0 %}
                  {% assign rendered_related_count = 0 %}
                  {% for related_article in explicit_related_articles %}
                    {% if related_article.id != article.id and related_article.url != blank %}
                      <div>
                        {% render 'article-card',
                          article: related_article,
                          show_image: true,
                          media_aspect_ratio: '16/9',
                          show_date: true,
                          show_author: false,
                          show_excerpt: true,
                          show_tags: true,
                          lazyload: true,
                          animate_enabled: false
                        %}
                      </div>
                      {% assign rendered_related_count = rendered_related_count | plus: 1 %}
                      {% if rendered_related_count >= related_limit %}{% break %}{% endif %}
                    {% endif %}
                  {% endfor %}
                {% elsif tagged_related_count > 0 %}
                  {% assign rendered_related_count = 0 %}
                  {% for candidate in blog.articles %}
                    {% if candidate.id != article.id and candidate.url != blank %}
                      {% assign shares_tag = false %}
                      {% for current_tag in article.tags %}
                        {% if candidate.tags contains current_tag %}
                          {% assign shares_tag = true %}
                          {% break %}
                        {% endif %}
                      {% endfor %}
                      {% if shares_tag %}
                        <div>
                          {% render 'article-card',
                            article: candidate,
                            show_image: true,
                            media_aspect_ratio: '16/9',
                            show_date: true,
                            show_author: false,
                            show_excerpt: true,
                            show_tags: true,
                            lazyload: true,
                            animate_enabled: false
                          %}
                        </div>
                        {% assign rendered_related_count = rendered_related_count | plus: 1 %}
                        {% if rendered_related_count >= related_limit %}{% break %}{% endif %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {% assign rendered_related_count = 0 %}
                  {% for candidate in blog.articles %}
                    {% if candidate.id != article.id and candidate.url != blank %}
                      <div>
                        {% render 'article-card',
                          article: candidate,
                          show_image: true,
                          media_aspect_ratio: '16/9',
                          show_date: true,
                          show_author: false,
                          show_excerpt: true,
                          show_tags: true,
                          lazyload: true,
                          animate_enabled: false
                        %}
                      </div>
                      {% assign rendered_related_count = rendered_related_count | plus: 1 %}
                      {% if rendered_related_count >= related_limit %}{% break %}{% endif %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </div>
            </section>
          {% endif %}
        {% endif %}
      </article>

    </div>
  </xo-container>
</section>

<script>
  (function() {
    class NootropixPremiumArticle {
      constructor(sectionId) {
        this.sectionId = sectionId;
        this.root = document.getElementById(`np-section-${sectionId}`);
        this.body = document.getElementById(`np-body-${sectionId}`);
        this.tocList = document.getElementById(`np-toc-list-${sectionId}`);
        this.tocWrapper = document.getElementById(`np-toc-${sectionId}`);
        this.progressBar = document.getElementById(`np-progress-bar-${sectionId}`);
        this.shareButton = document.getElementById(`np-share-${sectionId}`);
        this.shareStatus = document.getElementById(`np-share-status-${sectionId}`);
        this.headings = this.body ? Array.from(this.body.querySelectorAll('h2, h3')) : [];
        this.reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        
        this.init();
      }

      init() {
        if (!this.root || this.root.dataset.npArticleReady === 'true') return;
        this.root.dataset.npArticleReady = 'true';

        if (this.headings.length > 0 && this.tocList) {
          this.buildTOC();
          this.initScrollSpy();
        }

        if (this.progressBar && !this.reducedMotion) this.initProgressBar();
        if (this.shareButton) this.initShare();
      }

      buildTOC() {
        this.headings.forEach((heading, index) => {
          if (!heading.id) heading.id = `np-heading-${this.sectionId}-${index}`;
          
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.className = 'np-toc__link';
          a.href = `#${heading.id}`;
          a.textContent = heading.textContent.trim();
          
          if (heading.tagName.toLowerCase() === 'h3') {
            a.classList.add('np-toc__link--sub');
          }

          a.addEventListener('click', (e) => {
            e.preventDefault();
            heading.scrollIntoView({ behavior: this.reducedMotion ? 'auto' : 'smooth', block: 'start' });
            history.pushState(null, '', a.href);
          });

          li.appendChild(a);
          this.tocList.appendChild(li);
        });

        if (this.tocWrapper) this.tocWrapper.hidden = false;
        const container = this.root.querySelector('.np-container');
        if (container) container.classList.add('np-container--toc-ready');
      }

      initScrollSpy() {
        if (!('IntersectionObserver' in window)) return;
        const tocLinks = this.tocList.querySelectorAll('.np-toc__link');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const index = this.headings.indexOf(entry.target);
              tocLinks.forEach(link => {
                link.classList.remove('active');
                link.removeAttribute('aria-current');
              });
              if (tocLinks[index]) {
                tocLinks[index].classList.add('active');
                tocLinks[index].setAttribute('aria-current', 'true');
              }
            }
          });
        }, { rootMargin: '-15% 0px -80% 0px', threshold: 0 });

        this.headings.forEach(heading => observer.observe(heading));
      }

      initProgressBar() {
        let isTicking = false;
        const updateProgress = () => {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const scrollPercent = docHeight > 0 ? scrollTop / docHeight : 0;
          this.progressBar.style.transform = `scaleX(${Math.min(scrollPercent, 1)})`;
          isTicking = false;
        };

        updateProgress();
        window.addEventListener('scroll', () => {
          if (!isTicking) {
            window.requestAnimationFrame(updateProgress);
            isTicking = true;
          }
        }, { passive: true });
      }

      initShare() {
        this.shareButton.addEventListener('click', async () => {
          const shareData = {
            title: document.title,
            text: 'Check out this article from {{ shop.name | escape }}',
            url: window.location.href
          };
          const textSpan = this.shareButton.querySelector('.np-share-text');
          const originalText = textSpan.textContent;

          const showFeedback = (buttonText, statusText) => {
            window.clearTimeout(this.shareFeedbackTimer);
            textSpan.textContent = buttonText;
            if (this.shareStatus) this.shareStatus.textContent = statusText;
            this.shareFeedbackTimer = window.setTimeout(() => {
              textSpan.textContent = originalText;
            }, 2500);
          };

          if (navigator.share) {
            try {
              await navigator.share(shareData);
              showFeedback('Shared', 'Article shared.');
            } catch (err) {
              if (err.name !== 'AbortError') {
                showFeedback(originalText, 'Sharing failed. Copy the address from your browser.');
              }
            }
          } else if (navigator.clipboard && window.isSecureContext) {
            try {
              await navigator.clipboard.writeText(window.location.href);
              showFeedback('Link copied', 'Article link copied to clipboard.');
            } catch (err) {
              showFeedback(originalText, 'Could not copy the article link. Copy the address from your browser.');
            }
          } else {
            showFeedback(originalText, 'Copying is not available. Copy the address from your browser.');
          }
        });
      }
    }

    const initializeArticle = () => {
      new NootropixPremiumArticle('{{ section.id }}');
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeArticle, { once: true });
    } else {
      initializeArticle();
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (event.target.querySelector('#np-section-{{ section.id }}')) initializeArticle();
    });
  })();
</script>

