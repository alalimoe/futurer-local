{{ 'section-specification-stats.css' | asset_url | stylesheet_tag }}

{% liquid
  assign image = section.settings.image

  assign aspect_ratio_desktop = section.settings.aspect_ratio_desktop
  if aspect_ratio_desktop == 'custom'
    assign aspect_ratio_desktop = section.settings.aspect_ratio_desktop_width | append: '/' | append: section.settings.aspect_ratio_desktop_height
  endif

  assign aspect_ratio_mobile = section.settings.aspect_ratio_mobile
  if aspect_ratio_mobile == 'custom'
    assign aspect_ratio_mobile = section.settings.aspect_ratio_mobile_width | append: '/' | append: section.settings.aspect_ratio_mobile_height
  endif

  assign media_style = '--specification-stats-ratio-desktop: ' | append: aspect_ratio_desktop | append: '; --specification-stats-ratio-mobile: ' | append: aspect_ratio_mobile
%}

{% capture stat_left %}
  {% for block in section.blocks %}
    {% if block.settings.side == 'left' %}
      <xo-animate xo-cascade>
        <div class="specification-stats__stat" {{ block.shopify_attributes }}>
          <span class="specification-stats__stat-divider" aria-hidden="true"></span>
          {% if block.settings.label != blank %}
            <span class="specification-stats__stat-label">{{ block.settings.label }}</span>
          {% endif %}
          {% if block.settings.value != blank %}
            <span class="specification-stats__stat-value h2">{{ block.settings.value }}</span>
          {% endif %}
        </div>
      </xo-animate>
    {% endif %}
  {% endfor %}
{% endcapture %}

{% capture stat_right %}
  {% for block in section.blocks %}
    {% if block.settings.side == 'right' %}
      <xo-animate xo-cascade>
        <div class="specification-stats__stat" {{ block.shopify_attributes }}>
          <span class="specification-stats__stat-divider" aria-hidden="true"></span>
          {% if block.settings.label != blank %}
            <span class="specification-stats__stat-label">{{ block.settings.label }}</span>
          {% endif %}
          {% if block.settings.value != blank %}
            <span class="specification-stats__stat-value h2">{{ block.settings.value }}</span>
          {% endif %}
        </div>
      </xo-animate>
    {% endif %}
  {% endfor %}
{% endcapture %}

<section {% render 'section-attr' %}>
  <div class="specification-stats">
    <xo-container class="specification-stats__container">
      <xo-animate xo-cascade>
        <div class="specification-stats__head">
          {% render 'text', context: section %}
          {% if section.settings.button_text != blank %}
            <div class="specification-stats__actions">
              {% render 'button',
                text: section.settings.button_text,
                link: section.settings.button_link,
                style: section.settings.button_style,
                size: section.settings.button_size
              %}
            </div>
          {% endif %}
        </div>
      </xo-animate>

      <div class="specification-stats__body">
        <div class="specification-stats__col specification-stats__col--left">
          {{ stat_left }}
        </div>

        <div class="specification-stats__media" style="{{ media_style }}">
          <xo-animate xo-cascade class="specification-stats__frame">
            {% render 'image',
              image: image,
              aspect_ratio: 'var(--specification-stats-ratio)',
              class: 'specification-stats__media-el'
            %}
          </xo-animate>
        </div>

        <div class="specification-stats__col specification-stats__col--right">
          {{ stat_right }}
        </div>
      </div>
    </xo-container>
  </div>
</section>

