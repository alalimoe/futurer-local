{% comment %} NX Flagship quality — trust band with supplement facts. {% endcomment %}

{{ 'nx-flagship.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign coa_url = product.metafields.pdp.coa_url
-%}

<section {% render 'section-attr' %} id="quality" class="nx-flagship nx-flagship__anchor nx-flagship__section">
  <xo-container>
    <div class="nx-flagship__wrap">
      <p class="nx-flagship__eyebrow">{{ section.settings.eyebrow | default: 'Quality & Transparency' }}</p>
      <h2 class="nx-flagship__h2">{{ section.settings.heading | default: 'Built to a higher standard.' }}</h2>

      <div class="nx-flagship__quality-grid" style="margin-top:2rem;">
        <div>
          <ul class="nx-flagship__quality-list">
            {% for block in section.blocks %}
              {% if block.type == 'point' %}
                <li {{ block.shopify_attributes }}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                  <span>{{ block.settings.text }}</span>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
          {% if coa_url != blank and section.settings.show_coa_link %}
            <p style="margin-top:1.6rem;">
              <a href="{{ coa_url }}" target="_blank" rel="noopener" style="font-weight:600;color:rgba(var(--color-foreground));">
                {{ section.settings.coa_label | default: 'View Certificate of Analysis' }} →
              </a>
            </p>
          {% endif %}
        </div>

        {% if section.settings.supplement_facts != blank %}
          <div>
            {{ section.settings.supplement_facts | image_url: width: 800 | image_tag:
              class: 'nx-flagship__facts-img',
              loading: 'lazy',
              alt: section.settings.supplement_facts_alt | default: 'Supplement facts label for NX01 Baseline',
              widths: '400,600,800',
              sizes: '(min-width: 768px) 400px, 100vw'
            }}
          </div>
        {% endif %}
      </div>
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "NX Flagship — Quality",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Quality & Transparency" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to a higher standard." },
    { "type": "image_picker", "id": "supplement_facts", "label": "Supplement facts image" },
    { "type": "text", "id": "supplement_facts_alt", "label": "Supplement facts alt text", "default": "Supplement facts label for NX01 Baseline" },
    { "type": "checkbox", "id": "show_coa_link", "label": "Show COA link (from product metafield)", "default": true },
    { "type": "text", "id": "coa_label", "label": "COA link label", "default": "View Certificate of Analysis" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-premium-health" },
    { "type": "number", "id": "padding_top_desktop", "label": "Padding top desktop", "default": 48 },
    { "type": "number", "id": "padding_bottom_desktop", "label": "Padding bottom desktop", "default": 48 },
    { "type": "number", "id": "padding_top_mobile", "label": "Padding top mobile", "default": 32 },
    { "type": "number", "id": "padding_bottom_mobile", "label": "Padding bottom mobile", "default": 32 }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Quality point",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Third-party tested for identity and purity" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NX Flagship — Quality",
      "blocks": [
        { "type": "point", "settings": { "text": "Third-party tested for identity and purity" } },
        { "type": "point", "settings": { "text": "Manufactured in cGMP-certified facilities" } },
        { "type": "point", "settings": { "text": "Full transparent labeling — every dose listed" } },
        { "type": "point", "settings": { "text": "No proprietary blends — you know exactly what you're taking" } },
        { "type": "point", "settings": { "text": "Same-day dispatch from Dubai with express worldwide shipping" } }
      ]
    }
  ]
}
{% endschema %}
