{% render 'compound-guide-css' %}

{%- liquid
  assign cg_anchor = section.settings.anchor_id | default: 'compound-overview' | handleize
  assign alias_id = section.settings.alias_id | handleize
  assign heading = section.settings.heading
  assign image = section.settings.image
  if image == blank and section.settings.fallback_product != blank
    assign image = section.settings.fallback_product.featured_image
  endif
  assign image_alt = section.settings.image_alt | default: heading
  assign show_primary = false
  if section.settings.primary_label != blank and section.settings.primary_href != blank
    assign show_primary = true
  endif
  assign show_secondary = false
  if section.settings.secondary_label != blank and section.settings.secondary_href != blank
    assign show_secondary = true
  endif
-%}

{%- if heading != blank -%}
<section
  id="{{ cg_anchor }}"
  {% render 'compound-section-attrs', section: section, base: 'cg-hero', default_tone: 'dark' %}
  aria-labelledby="cg-hero-heading-{{ section.id }}"
>
  {%- if alias_id != blank -%}
    <div id="{{ alias_id }}" hidden></div>
  {%- endif -%}
  <div class="cg__inner">
    <div class="cg-hero__stage{% if section.settings.media_position == 'left' %} cg-hero__stage--media-left{% endif %}">
      <div class="cg-hero__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cg__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="cg__heading" id="cg-hero-heading-{{ section.id }}">{{ heading | escape }}</h1>
        {%- if section.settings.subheading != blank -%}
          <p class="cg__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if show_primary or show_secondary or section.settings.safety_label != blank -%}
          <div class="cg-hero__actions">
            {%- if show_primary -%}
              {% render 'button', style: 'primary', text: section.settings.primary_label, link: section.settings.primary_href, attrs: 'data-compound-event="hero_cta" data-cg-keep-filters' %}
            {%- endif -%}
            {%- if show_secondary -%}
              {% render 'button', style: 'secondary', text: section.settings.secondary_label, link: section.settings.secondary_href %}
            {%- endif -%}
            {%- if section.settings.safety_label != blank and section.settings.safety_href != blank -%}
              <a class="cg__text-link" href="{{ section.settings.safety_href | escape }}">{{ section.settings.safety_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if image != blank and section.settings.show_image -%}
        <div class="cg-hero__media">
          {{
            image
            | image_url: width: 1200
            | image_tag:
              class: 'cg-hero__img',
              widths: '360, 540, 720, 960, 1200',
              sizes: '(max-width: 767px) 88vw, 42vw',
              alt: image_alt,
              width: image.width,
              height: image.height,
              fetchpriority: 'high',
              loading: 'eager',
              decoding: 'async'
          }}
        </div>
      {%- endif -%}
    </div>

    {%- liquid
      assign has_chips = false
      if section.settings.forms_value != blank or section.settings.formats_value != blank or section.settings.important_text != blank
        assign has_chips = true
      endif
    -%}
    {%- if section.settings.show_chips and has_chips -%}
      <ul class="cg-overview cg-overview--chips" aria-label="{{ 'sections.compound_guide.at_a_glance' | t }}">
        {%- if section.settings.forms_value != blank -%}
          <li class="cg-overview__chip">
            <span class="cg-overview__label">{{ section.settings.forms_label | escape }}</span>
            <span class="cg-overview__value">{{ section.settings.forms_value | escape }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.formats_value != blank -%}
          <li class="cg-overview__chip">
            <span class="cg-overview__label">{{ section.settings.formats_label | escape }}</span>
            <span class="cg-overview__value">{{ section.settings.formats_value | escape }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.important_text != blank -%}
          <li class="cg-overview__chip cg-overview__chip--risk">
            <span class="cg-overview__label">{{ section.settings.important_label | escape }}</span>
            <span class="cg-overview__value">{{ section.settings.important_text | escape }}</span>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Compound hero",
  "tag": "section",
  "class": "section-compound-hero",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "compound-overview" },
    { "type": "text", "id": "alias_id", "label": "Extra anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NOOTROPIX / COMPOUND" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Know what you’re choosing." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "View products" },
    { "type": "text", "id": "primary_href", "label": "Primary button link", "default": "#compound-products" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Compare forms & formats" },
    { "type": "text", "id": "secondary_href", "label": "Secondary button link", "default": "#compound-compare" },
    { "type": "text", "id": "safety_label", "label": "Safety link label", "default": "Read safety information" },
    { "type": "text", "id": "safety_href", "label": "Safety link", "default": "#safety" },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "product", "id": "fallback_product", "label": "Fallback product image", "info": "Used only when no image is selected." },
    { "type": "header", "content": "At a glance chips" },
    { "type": "text", "id": "forms_label", "label": "Forms label", "default": "Forms" },
    { "type": "text", "id": "forms_value", "label": "Forms value", "default": "HCl · FAA", "info": "Short. The Compare section carries the explanation." },
    { "type": "textarea", "id": "forms_text", "label": "Forms summary (legacy)", "info": "No longer rendered. Kept for existing templates." },
    { "type": "text", "id": "formats_label", "label": "Formats label", "default": "Formats" },
    { "type": "text", "id": "formats_value", "label": "Formats value", "default": "Capsules · Powder" },
    { "type": "textarea", "id": "formats_text", "label": "Formats summary (legacy)", "info": "No longer rendered. Kept for existing templates." },
    { "type": "text", "id": "important_label", "label": "Risk label", "default": "Risk" },
    { "type": "textarea", "id": "important_text", "label": "Risk sentence", "info": "One sentence. Rendered as a yellow-railed chip." },
    { "type": "checkbox", "id": "show_chips", "label": "Show at-a-glance chips", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "show_image", "label": "Show product image", "default": true },
    { "type": "select", "id": "media_position", "label": "Image position (desktop)", "options": [
      { "value": "right", "label": "Right" },
      { "value": "left", "label": "Left" }
    ], "default": "right" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [
      { "value": "small", "label": "Small" },
      { "value": "default", "label": "Default" },
      { "value": "large", "label": "Large" }
    ], "default": "default" },
    { "type": "select", "id": "content_width", "label": "Content width", "options": [
      { "value": "narrow", "label": "Narrow" },
      { "value": "default", "label": "Default" },
      { "value": "wide", "label": "Wide" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "Scales the responsive section spacing. 100% is the theme default." },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class", "info": "Optional hook for bespoke styling." }
  ],
  "presets": [{ "name": "Compound hero" }]
}
{% endschema %}
