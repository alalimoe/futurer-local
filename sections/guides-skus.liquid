{%- style -%}
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .xo-section--{{ section.id }} .gsk-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.2rem 2.4rem;
    margin-bottom: 2.4rem;
  }

  .xo-section--{{ section.id }} .gsk-heading {
    margin: 0;
    font-size: clamp(2.8rem, 3.4vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .gsk-more {
    font-size: 1.5rem;
    font-weight: 600;
    color: rgba(var(--color-foreground));
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, rgba(var(--color-foreground)) 28%, transparent);
  }

  .xo-section--{{ section.id }} .gsk-more:hover {
    text-decoration-color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .gsk-more:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 3px;
  }

  .xo-section--{{ section.id }} .gsk-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem 2.4rem;
  }

  @media (min-width: 768px) {
    .xo-section--{{ section.id }} .gsk-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.4rem;
    }
  }
{%- endstyle -%}

<section {% render 'section-attr' %}>
  <xo-container>
    {%- if section.settings.heading != blank or section.settings.more_label != blank -%}
      <div class="gsk-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="gsk-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.more_label != blank and section.settings.more_url != blank -%}
          <a class="gsk-more" href="{{ section.settings.more_url }}">{{ section.settings.more_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.product_list != blank -%}
      <div class="gsk-grid">
        {%- for product in section.settings.product_list -%}
          {% render 'product-card',
            product: product,
            show_image: true,
            show_secondary_image: false,
            show_vendor: false,
            show_description: false,
            show_quick_add: false,
            show_quick_view: false,
            show_price: true,
            show_badge: false,
            media_aspect_ratio: '1/1',
            animate_enabled: false,
            lazyload: true
          %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </xo-container>
</section>

{% schema %}
{
  "name": "Guides SKUs",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay", "custom.popups", "custom.features"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Starter SKUs" },
    { "type": "text", "id": "more_label", "label": "Collection link label", "default": "Shop Focus" },
    { "type": "url", "id": "more_url", "label": "Collection link" },
    { "type": "product_list", "id": "product_list", "label": "Products", "limit": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 64 }
  ],
  "presets": [{ "name": "Guides SKUs" }]
}
{% endschema %}
