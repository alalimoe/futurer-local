{% comment %}
  Nootropic Stack Finder Quiz
  Template:  templates/page.quiz.json
  Assets:    assets/nootropic-quiz.css, assets/quiz-engine.js, assets/nootropic-quiz.js
  Schema:    5 "result" blocks — merchant manages stack descriptions (and optional
             backup handles) from the Theme Customizer. The recommended products
             and headline come from assets/quiz-engine.js.
{% endcomment %}

{{ 'nootropic-quiz.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quiz-engine.js' | asset_url }}" defer></script>
<script src="{{ 'nootropic-quiz.js' | asset_url }}" defer></script>

<section id="nqQuiz" {% render 'section-attr' %}>
  <div class="nq-wrapper">
    <div class="nq-inner">

      {%- comment -%} ── Quiz header (always visible) ── {%- endcomment -%}
      <div class="nq-header">
        <span class="nq-header__eyebrow">Find Your Stack</span>
        <h1 class="nq-header__title">{{ section.settings.quiz_title }}</h1>
        {%- if section.settings.quiz_subtitle != blank -%}
          <p class="nq-header__subtitle">{{ section.settings.quiz_subtitle }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} ── Gate hero: benefits + email capture ── {%- endcomment -%}
      <div class="nq-gate" data-nq-gate>
        <div class="nq-hero">
          <div class="nq-hero__copy">
            <ul class="nq-hero__benefits">
              {%- if section.settings.benefit_1 != blank -%}
                <li class="nq-hero__benefit">
                  <span class="nq-hero__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span>{{ section.settings.benefit_1 }}</span>
                </li>
              {%- endif -%}
              {%- if section.settings.benefit_2 != blank -%}
                <li class="nq-hero__benefit">
                  <span class="nq-hero__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span>{{ section.settings.benefit_2 }}</span>
                </li>
              {%- endif -%}
              {%- if section.settings.benefit_3 != blank -%}
                <li class="nq-hero__benefit">
                  <span class="nq-hero__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span>{{ section.settings.benefit_3 }}</span>
                </li>
              {%- endif -%}
            </ul>
          </div>

          <div class="nq-hero__card">
            <div class="nq-capture nq-gate__card">
              <div class="nq-capture__text">
                <span class="nq-capture__dot" aria-hidden="true"></span>
                <h2 class="nq-capture__title">{{ section.settings.gate_title }}</h2>
                {%- if section.settings.gate_subtitle != blank -%}
                  <p class="nq-capture__sub">{{ section.settings.gate_subtitle }}</p>
                {%- endif -%}
              </div>
              <form class="nq-capture__form" data-nq-gate-form novalidate>
                <label class="nq-capture__label" for="nqGateEmail">Email address</label>
                <div class="nq-capture__row">
                  <input class="nq-capture__input" id="nqGateEmail" name="email" type="email" inputmode="email"
                    autocomplete="email" placeholder="{{ section.settings.capture_placeholder | default: 'you@email.com' }}"
                    aria-describedby="nqGateStatus" required>
                  <button class="nq-capture__btn" type="submit" data-nq-gate-submit>
                    <span class="nq-capture__btn-label">{{ section.settings.gate_button }} →</span>
                    <span class="nq-capture__btn-spinner" aria-hidden="true"></span>
                  </button>
                </div>
                {%- if section.settings.capture_fineprint != blank -%}
                  <div class="nq-capture__fineprint">{{ section.settings.capture_fineprint }}</div>
                {%- endif -%}
                <p class="nq-capture__status" id="nqGateStatus" role="status" aria-live="polite" data-nq-gate-status></p>
              </form>
            </div>
            <div class="nq-gate__preview" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
          </div>
        </div>

        {%- if section.settings.trust_text != blank -%}
          {%- assign trust_items = section.settings.trust_text | split: '·' -%}
          <p class="nq-trust">
            {%- for item in trust_items -%}
              <span class="nq-trust__item">{{ item | strip }}</span>
            {%- endfor -%}
          </p>
        {%- endif -%}
      </div>

      <div class="nq-quiz-body" data-nq-quiz-body>
      {%- comment -%} ── Segmented progress (5 steps) ── {%- endcomment -%}
      <div class="nq-progress-wrap" id="nqProgressBar" role="progressbar" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0">
        <span class="nq-progress__seg"></span>
        <span class="nq-progress__seg"></span>
        <span class="nq-progress__seg"></span>
        <span class="nq-progress__seg"></span>
        <span class="nq-progress__seg"></span>
      </div>
      <p class="nq-progress__label" id="nqProgressLabel" aria-live="polite">Step 1 of 5</p>

      <div class="nq-steps">
      {%- comment -%} ════════════════════════════════════════
        Step 1 — Primary Goal
        data-value must match the goal keys in assets/quiz-engine.js:
        focus | mood | energy | memory | sleep
      ════════════════════════════════════════ {%- endcomment -%}
      <div class="nq-step" data-step="0">
        <div class="nq-step__header">
          <span class="nq-step__eyebrow">Step 1 of 5 · Your Goal</span>
          <h2 class="nq-step__question">What's your primary goal?</h2>
          <p class="nq-step__sub">Pick the outcome that matters most to you right now.</p>
        </div>
        <div class="nq-options nq-options--grid" role="group" aria-label="Primary goal">

          <button type="button" class="nq-option nq-option--icon" data-value="focus" tabindex="0">
            <span class="nq-option__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="0.8" fill="currentColor"/></svg></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Focus &amp; Cognition</span>
              <span class="nq-option__desc">Deep work, mental clarity, sustained concentration</span>
            </span>
          </button>

          <button type="button" class="nq-option nq-option--icon" data-value="mood" tabindex="0">
            <span class="nq-option__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Mood &amp; Anxiety Relief</span>
              <span class="nq-option__desc">Calm, stress resilience, emotional baseline</span>
            </span>
          </button>

          <button type="button" class="nq-option nq-option--icon" data-value="energy" tabindex="0">
            <span class="nq-option__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Energy &amp; Motivation</span>
              <span class="nq-option__desc">Drive, clean energy, get-up-and-go</span>
            </span>
          </button>

          <button type="button" class="nq-option nq-option--icon" data-value="memory" tabindex="0">
            <span class="nq-option__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.4 1 2.3h6c0-.9.4-1.8 1-2.3A7 7 0 0 0 12 2z"/><path d="M9 20h6"/><path d="M10 22h4"/></svg></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Memory &amp; Learning</span>
              <span class="nq-option__desc">Retention, recall, study performance</span>
            </span>
          </button>

          <button type="button" class="nq-option nq-option--icon nq-option--span" data-value="sleep" tabindex="0">
            <span class="nq-option__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Sleep &amp; Recovery</span>
              <span class="nq-option__desc">Quality rest, faster wind-down, restoration</span>
            </span>
          </button>

        </div>
        <div class="nq-nav">
          <button type="button" class="nq-back-btn" id="nqBackBtn" aria-label="Go back">← Back</button>
        </div>
      </div>

      {%- comment -%} ════════════════════════════════════════
        Step 2 — Experience Level
        JS keys: beginner | some | intermediate | advanced
      ════════════════════════════════════════ {%- endcomment -%}
      <div class="nq-step" data-step="1">
        <div class="nq-step__header">
          <span class="nq-step__eyebrow">Step 2 of 5 · Your Experience</span>
          <h2 class="nq-step__question">How familiar are you with nootropics?</h2>
          <p class="nq-step__sub">Honest answers get you the most appropriate stack.</p>
        </div>
        <div class="nq-options" role="group" aria-label="Experience level">

          <button type="button" class="nq-option" data-value="beginner" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Complete beginner</span>
              <span class="nq-option__desc">Haven't tried nootropics before</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="some" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Some experience</span>
              <span class="nq-option__desc">Tried caffeine, L-theanine, or similar basics</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="intermediate" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Intermediate</span>
              <span class="nq-option__desc">Tried racetams or adaptogens</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="advanced" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Advanced</span>
              <span class="nq-option__desc">Comfortable building and cycling multi-compound stacks</span>
            </span>
          </button>

        </div>
        <div class="nq-nav">
          <button type="button" class="nq-back-btn" aria-label="Go back">← Back</button>
        </div>
      </div>

      {%- comment -%} ════════════════════════════════════════
        Step 3 — Lifestyle / Context
        JS keys: student | professional | athletic | wellness
      ════════════════════════════════════════ {%- endcomment -%}
      <div class="nq-step" data-step="2">
        <div class="nq-step__header">
          <span class="nq-step__eyebrow">Step 3 of 5 · Your Context</span>
          <h2 class="nq-step__question">What best describes your situation?</h2>
          <p class="nq-step__sub">This helps us match compounds to real-world demands.</p>
        </div>
        <div class="nq-options" role="group" aria-label="Lifestyle context">

          <button type="button" class="nq-option" data-value="student" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Student / Studying</span>
              <span class="nq-option__desc">Exams, reading, long study sessions, retention</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="professional" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Professional / Work</span>
              <span class="nq-option__desc">Deadlines, decisions, deep work, output</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="athletic" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Athletic Performance</span>
              <span class="nq-option__desc">Training, recovery, mind-muscle focus</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="wellness" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">General Wellness</span>
              <span class="nq-option__desc">Long-term cognitive health and resilience</span>
            </span>
          </button>

        </div>
        <div class="nq-nav">
          <button type="button" class="nq-back-btn" aria-label="Go back">← Back</button>
        </div>
      </div>

      {%- comment -%} ════════════════════════════════════════
        Step 4 — Sensitivities / Preferences
        JS keys: stimulant-sensitive | natural | synthetics | dependency
      ════════════════════════════════════════ {%- endcomment -%}
      <div class="nq-step" data-step="3">
        <div class="nq-step__header">
          <span class="nq-step__eyebrow">Step 4 of 5 · Your Preferences</span>
          <h2 class="nq-step__question">Any sensitivities or preferences?</h2>
          <p class="nq-step__sub">We'll filter out anything that doesn't fit your profile.</p>
        </div>
        <div class="nq-options" role="group" aria-label="Sensitivities and preferences">

          <button type="button" class="nq-option" data-value="stimulant-sensitive" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Stimulant-sensitive</span>
              <span class="nq-option__desc">No jitteriness, racing heart, or sleep disruption</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="natural" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Prefer natural / herbal</span>
              <span class="nq-option__desc">Plant-based, adaptogenic, and well-studied options</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="synthetics" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Open to synthetics</span>
              <span class="nq-option__desc">Research-backed synthetic compounds are fine</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="dependency" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Concerned about dependency</span>
              <span class="nq-option__desc">Low tolerance-build risk is a priority</span>
            </span>
          </button>

        </div>
        <div class="nq-nav">
          <button type="button" class="nq-back-btn" aria-label="Go back">← Back</button>
        </div>
      </div>

      {%- comment -%} ════════════════════════════════════════
        Step 5 — Budget / Stack Size
        JS keys: simple | moderate | full
      ════════════════════════════════════════ {%- endcomment -%}
      <div class="nq-step" data-step="4">
        <div class="nq-step__header">
          <span class="nq-step__eyebrow">Step 5 of 5 · Your Stack Size</span>
          <h2 class="nq-step__question">How many compounds do you want to start with?</h2>
          <p class="nq-step__sub">Simpler stacks are easier to track and adjust. You can always layer more later.</p>
        </div>
        <div class="nq-options" role="group" aria-label="Stack size preference">

          <button type="button" class="nq-option" data-value="simple" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Start simple: 1 to 2 compounds</span>
              <span class="nq-option__desc">Low commitment. Easy to track what's working.</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="moderate" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Moderate stack: 3 to 4 compounds</span>
              <span class="nq-option__desc">Good balance of depth and manageability.</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="full" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">Full stack: 5 or more</span>
              <span class="nq-option__desc">Maximise synergy. Best for experienced users.</span>
            </span>
          </button>

        </div>
        <div class="nq-nav">
          <button type="button" class="nq-back-btn" aria-label="Go back">← Back</button>
          <button type="button" id="nqNextBtn">Build My Stack →</button>
        </div>
      </div>
      </div><!-- /.nq-steps -->
      </div><!-- /.nq-quiz-body -->

      {%- comment -%} ── Results panel (populated by JS) ── {%- endcomment -%}
      <div class="nq-results" id="nqResultsPanel" aria-live="polite"></div>

      {%- comment -%}
        Results data: merchant-controlled product handles and stack descriptions
        injected as a JSON blob. JS reads this to render product cards.
        Each block contributes one result entry.
      {%- endcomment -%}
      <script type="application/json" id="nq-results-data">
      [
        {%- for block in section.blocks -%}
          {%- if block.type == 'result' -%}
            {%- unless forloop.first -%},{%- endunless -%}
            {
              "key": {{ block.settings.result_key | json }},
              "stackName": {{ block.settings.stack_name | json }},
              "description": {{ block.settings.stack_description | json }},
              "handles": [
                {%- assign h_count = 0 -%}
                {%- if block.settings.product_handle_1 != blank -%}
                  {%- if h_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_1 | json }}
                  {%- assign h_count = h_count | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.product_handle_2 != blank -%}
                  {%- if h_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_2 | json }}
                  {%- assign h_count = h_count | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.product_handle_3 != blank -%}
                  {%- if h_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_3 | json }}
                  {%- assign h_count = h_count | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.product_handle_4 != blank -%}
                  {%- if h_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_4 | json }}
                {%- endif -%}
              ],
              "backupHandles": [
                {%- assign b_count = 0 -%}
                {%- if block.settings.product_handle_5 != blank -%}
                  {%- if b_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_5 | json }}
                  {%- assign b_count = b_count | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.product_handle_6 != blank -%}
                  {%- if b_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_6 | json }}
                {%- endif -%}
              ]
            }
          {%- endif -%}
        {%- endfor -%}
      ]
      </script>

      {%- comment -%} ── Klaviyo + lead-capture config (read by JS) ── {%- endcomment -%}
      <script type="application/json" id="nq-config">
      {
        "klaviyo": {
          "publicKey": {{ section.settings.public_api_key | json }},
          "listId": {{ section.settings.list_id | json }},
          "eventName": {{ section.settings.event_name | json }},
          "source": {{ section.settings.custom_source | json }}
        },
        "capture": {
          "enabled": {{ section.settings.capture_enabled | json }},
          "title": {{ section.settings.capture_title | json }},
          "subtitle": {{ section.settings.capture_subtitle | json }},
          "placeholder": {{ section.settings.capture_placeholder | json }},
          "button": {{ section.settings.capture_button | json }},
          "fineprint": {{ section.settings.capture_fineprint | json }},
          "successTitle": {{ section.settings.capture_success_title | json }},
          "successMessage": {{ section.settings.capture_success_message | json }}
        },
        "minInStock": {{ section.settings.min_in_stock | json }}
      }
      </script>

    </div><!-- /.nq-inner -->
  </div><!-- /.nq-wrapper -->
</section>

{% schema %}
{
  "name": "Nootropic Quiz",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "quiz_title",
      "label": "Quiz title",
      "default": "Find Your Nootropic Stack"
    },
    {
      "type": "text",
      "id": "quiz_subtitle",
      "label": "Quiz subtitle",
      "default": "Answer 5 quick questions and we'll build a personalised stack for your goals, experience level, and preferences."
    },
    {
      "type": "header",
      "content": "Email gate"
    },
    {
      "type": "text",
      "id": "gate_title",
      "label": "Gate heading",
      "default": "Find your stack in 60 seconds"
    },
    {
      "type": "text",
      "id": "gate_subtitle",
      "label": "Gate subtext",
      "default": "Enter your email to start. We'll send your stack plus a one-time 15% off code."
    },
    {
      "type": "text",
      "id": "gate_button",
      "label": "Gate button label",
      "default": "Start the quiz"
    },
    {
      "type": "header",
      "content": "Hero benefits"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "5 questions, under 60 seconds"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "Matched from our COA-verified catalog"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "15% off code emailed with your stack"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust strip",
      "info": "Separate items with a middle dot (·).",
      "default": "Third-party tested · Rated 4.8 on Google · Same-day dispatch from Dubai"
    },
    {
      "type": "header",
      "content": "Lead capture (Klaviyo)"
    },
    {
      "type": "checkbox",
      "id": "capture_enabled",
      "label": "Show email capture on results",
      "default": true
