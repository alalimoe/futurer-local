{% comment %}
  Nootropic Stack Finder Quiz
  Template:  templates/page.quiz.json
  Assets:    assets/nootropic-quiz.css, assets/quiz-engine.js, assets/nootropic-quiz.js
  Schema:    5 "result" blocks — merchant manages stack descriptions (and optional
             backup handles) from the Theme Customizer. The recommended products
             and headline come from assets/quiz-engine.js.
{% endcomment %}

{{ 'nootropic-quiz.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quiz-engine.js' | asset_url }}" defer></script>
<script src="{{ 'nootropic-quiz.js' | asset_url }}" defer></script>

{%- assign quiz_privacy_url = section.settings.privacy_link | default: shop.privacy_policy.url -%}

<section id="nqQuiz" {% render 'section-attr' %}>
  <div class="nq-wrapper">
    <div class="nq-inner">

      {%- comment -%} ── Quiz header (always visible) ── {%- endcomment -%}
      <div class="nq-header">
        <span class="nq-header__eyebrow">{{ 'sections.nootropic_quiz.eyebrow' | t }}</span>
        <h1 class="nq-header__title">{{ section.settings.quiz_title }}</h1>
        {%- if section.settings.quiz_subtitle != blank -%}
          <p class="nq-header__subtitle">{{ section.settings.quiz_subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.method_note != blank -%}
          <div class="nq-header__method">{{ section.settings.method_note }}</div>
        {%- endif -%}
      </div>

      {%- comment -%} ── Gate hero: benefits + email capture ── {%- endcomment -%}
      <div class="nq-gate" data-nq-gate>
        <div class="nq-hero">
          <div class="nq-hero__copy">
            <ul class="nq-hero__benefits">
              {%- if section.settings.benefit_1 != blank -%}
                <li class="nq-hero__benefit">
                  <span class="nq-hero__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span>{{ section.settings.benefit_1 }}</span>
                </li>
              {%- endif -%}
              {%- if section.settings.benefit_2 != blank -%}
                <li class="nq-hero__benefit">
                  <span class="nq-hero__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span>{{ section.settings.benefit_2 }}</span>
                </li>
              {%- endif -%}
              {%- if section.settings.benefit_3 != blank -%}
                <li class="nq-hero__benefit">
                  <span class="nq-hero__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span>{{ section.settings.benefit_3 }}</span>
                </li>
              {%- endif -%}
            </ul>
          </div>

          <div class="nq-hero__card">
            <div class="nq-capture nq-gate__card">
              <div class="nq-capture__text">
                <span class="nq-capture__dot" aria-hidden="true"></span>
                <h2 class="nq-capture__title">{{ section.settings.gate_title }}</h2>
                {%- if section.settings.gate_subtitle != blank -%}
                  <p class="nq-capture__sub">{{ section.settings.gate_subtitle }}</p>
                {%- endif -%}
              </div>
              {%- if section.settings.answer_use_disclosure != blank -%}
                <div class="nq-gate__disclosure">{{ section.settings.answer_use_disclosure }}</div>
              {%- endif -%}
              {%- if quiz_privacy_url != blank and section.settings.privacy_link_label != blank -%}
                <p class="nq-gate__privacy">
                  <a href="{{ quiz_privacy_url }}">{{ section.settings.privacy_link_label | escape }}</a>
                </p>
              {%- endif -%}
              <button class="nq-gate__start" type="button" data-nq-gate-skip>
                <span>{{ section.settings.gate_button | escape }}</span>
                {%- if section.settings.allow_skip and section.settings.skip_label != blank -%}
                  <small>{{ section.settings.skip_label | escape }}</small>
                {%- endif -%}
              </button>
            </div>
            <div class="nq-gate__preview" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
          </div>
        </div>

        {%- if section.settings.trust_text != blank -%}
          {%- assign trust_items = section.settings.trust_text | split: '·' -%}
          <p class="nq-trust">
            {%- for item in trust_items -%}
              <span class="nq-trust__item">{{ item | strip }}</span>
            {%- endfor -%}
          </p>
        {%- endif -%}
      </div>

      <div class="nq-quiz-body" data-nq-quiz-body>
      {%- comment -%} ── Segmented progress (5 steps) ── {%- endcomment -%}
      <div class="nq-progress-wrap" id="nqProgressBar" role="progressbar" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0">
        <span class="nq-progress__seg"></span>
        <span class="nq-progress__seg"></span>
        <span class="nq-progress__seg"></span>
        <span class="nq-progress__seg"></span>
        <span class="nq-progress__seg"></span>
      </div>
      <p class="nq-progress__label" id="nqProgressLabel" aria-live="polite">{{ 'sections.nootropic_quiz.progress' | t: current: 1, total: 5 }}</p>

      <div class="nq-steps">
      {%- comment -%} ════════════════════════════════════════
        Step 1 — Primary Goal
        data-value must match the goal keys in assets/quiz-engine.js:
        focus | mood | energy | memory | sleep
      ════════════════════════════════════════ {%- endcomment -%}
      <div class="nq-step" data-step="0">
        <div class="nq-step__header">
          <span class="nq-step__eyebrow">{{ 'sections.nootropic_quiz.step_1_eyebrow' | t }}</span>
          <h2 class="nq-step__question">{{ 'sections.nootropic_quiz.step_1_question' | t }}</h2>
          <p class="nq-step__sub">{{ 'sections.nootropic_quiz.step_1_subtitle' | t }}</p>
        </div>
        <div class="nq-options nq-options--grid" role="group" aria-label="{{ 'sections.nootropic_quiz.step_1_group' | t }}">

          <button type="button" class="nq-option nq-option--icon" data-value="focus" tabindex="0">
            <span class="nq-option__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="0.8" fill="currentColor"/></svg></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.focus_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.focus_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option nq-option--icon" data-value="mood" tabindex="0">
            <span class="nq-option__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.mood_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.mood_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option nq-option--icon" data-value="energy" tabindex="0">
            <span class="nq-option__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.energy_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.energy_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option nq-option--icon" data-value="memory" tabindex="0">
            <span class="nq-option__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.4 1 2.3h6c0-.9.4-1.8 1-2.3A7 7 0 0 0 12 2z"/><path d="M9 20h6"/><path d="M10 22h4"/></svg></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.memory_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.memory_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option nq-option--icon nq-option--span" data-value="sleep" tabindex="0">
            <span class="nq-option__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.sleep_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.sleep_description' | t }}</span>
            </span>
          </button>

        </div>
        <div class="nq-nav">
          <button type="button" class="nq-back-btn" id="nqBackBtn" aria-label="{{ 'sections.nootropic_quiz.back' | t }}">← {{ 'sections.nootropic_quiz.back' | t }}</button>
        </div>
      </div>

      {%- comment -%} ════════════════════════════════════════
        Step 2 — Experience Level
        JS keys: beginner | some | intermediate | advanced
      ════════════════════════════════════════ {%- endcomment -%}
      <div class="nq-step" data-step="1">
        <div class="nq-step__header">
          <span class="nq-step__eyebrow">{{ 'sections.nootropic_quiz.step_2_eyebrow' | t }}</span>
          <h2 class="nq-step__question">{{ 'sections.nootropic_quiz.step_2_question' | t }}</h2>
          <p class="nq-step__sub">{{ 'sections.nootropic_quiz.step_2_subtitle' | t }}</p>
        </div>
        <div class="nq-options" role="group" aria-label="{{ 'sections.nootropic_quiz.step_2_group' | t }}">

          <button type="button" class="nq-option" data-value="beginner" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.beginner_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.beginner_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="some" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.some_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.some_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="intermediate" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.intermediate_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.intermediate_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="advanced" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.advanced_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.advanced_description' | t }}</span>
            </span>
          </button>

        </div>
        <div class="nq-nav">
          <button type="button" class="nq-back-btn" aria-label="{{ 'sections.nootropic_quiz.back' | t }}">← {{ 'sections.nootropic_quiz.back' | t }}</button>
        </div>
      </div>

      {%- comment -%} ════════════════════════════════════════
        Step 3 — Lifestyle / Context
        JS keys: student | professional | athletic | wellness
      ════════════════════════════════════════ {%- endcomment -%}
      <div class="nq-step" data-step="2">
        <div class="nq-step__header">
          <span class="nq-step__eyebrow">{{ 'sections.nootropic_quiz.step_3_eyebrow' | t }}</span>
          <h2 class="nq-step__question">{{ 'sections.nootropic_quiz.step_3_question' | t }}</h2>
          <p class="nq-step__sub">{{ 'sections.nootropic_quiz.step_3_subtitle' | t }}</p>
        </div>
        <div class="nq-options" role="group" aria-label="{{ 'sections.nootropic_quiz.step_3_group' | t }}">

          <button type="button" class="nq-option" data-value="student" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.student_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.student_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="professional" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.professional_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.professional_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="athletic" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.athletic_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.athletic_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="wellness" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.wellness_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.wellness_description' | t }}</span>
            </span>
          </button>

        </div>
        <div class="nq-nav">
          <button type="button" class="nq-back-btn" aria-label="{{ 'sections.nootropic_quiz.back' | t }}">← {{ 'sections.nootropic_quiz.back' | t }}</button>
        </div>
      </div>

      {%- comment -%} ════════════════════════════════════════
        Step 4 — Sensitivities / Preferences
        JS keys: stimulant-sensitive | natural | synthetics | dependency
      ════════════════════════════════════════ {%- endcomment -%}
      <div class="nq-step" data-step="3">
        <div class="nq-step__header">
          <span class="nq-step__eyebrow">{{ 'sections.nootropic_quiz.step_4_eyebrow' | t }}</span>
          <h2 class="nq-step__question">{{ 'sections.nootropic_quiz.step_4_question' | t }}</h2>
          <p class="nq-step__sub">{{ 'sections.nootropic_quiz.step_4_subtitle' | t }}</p>
        </div>
        <div class="nq-options" role="group" aria-label="{{ 'sections.nootropic_quiz.step_4_group' | t }}">

          <button type="button" class="nq-option" data-value="stimulant-sensitive" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.sensitive_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.sensitive_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="natural" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.natural_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.natural_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="synthetics" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.synthetics_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.synthetics_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="dependency" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.dependency_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.dependency_description' | t }}</span>
            </span>
          </button>

        </div>
        <div class="nq-nav">
          <button type="button" class="nq-back-btn" aria-label="{{ 'sections.nootropic_quiz.back' | t }}">← {{ 'sections.nootropic_quiz.back' | t }}</button>
        </div>
      </div>

      {%- comment -%} ════════════════════════════════════════
        Step 5 — Budget / Stack Size
        JS keys: simple | moderate | full
      ════════════════════════════════════════ {%- endcomment -%}
      <div class="nq-step" data-step="4">
        <div class="nq-step__header">
          <span class="nq-step__eyebrow">{{ 'sections.nootropic_quiz.step_5_eyebrow' | t }}</span>
          <h2 class="nq-step__question">{{ 'sections.nootropic_quiz.step_5_question' | t }}</h2>
          <p class="nq-step__sub">{{ 'sections.nootropic_quiz.step_5_subtitle' | t }}</p>
        </div>
        <div class="nq-options" role="group" aria-label="{{ 'sections.nootropic_quiz.step_5_group' | t }}">

          <button type="button" class="nq-option" data-value="simple" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.simple_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.simple_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="moderate" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.moderate_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.moderate_description' | t }}</span>
            </span>
          </button>

          <button type="button" class="nq-option" data-value="full" tabindex="0">
            <span class="nq-option__dot" aria-hidden="true"></span>
            <span class="nq-option__text">
              <span class="nq-option__label">{{ 'sections.nootropic_quiz.full_label' | t }}</span>
              <span class="nq-option__desc">{{ 'sections.nootropic_quiz.full_description' | t }}</span>
            </span>
          </button>

        </div>
        <div class="nq-nav">
          <button type="button" class="nq-back-btn" aria-label="{{ 'sections.nootropic_quiz.back' | t }}">← {{ 'sections.nootropic_quiz.back' | t }}</button>
          <button type="button" id="nqNextBtn">{{ 'sections.nootropic_quiz.build_stack' | t }} →</button>
        </div>
      </div>
      </div><!-- /.nq-steps -->
      </div><!-- /.nq-quiz-body -->

      {%- comment -%} ── Results panel (populated by JS) ── {%- endcomment -%}
      <div class="nq-results" id="nqResultsPanel" aria-live="polite"></div>

      {%- comment -%}
        Results data: merchant-controlled product handles and stack descriptions
        injected as a JSON blob. JS reads this to render product cards.
        Each block contributes one result entry.
      {%- endcomment -%}
      <script type="application/json" id="nq-results-data">
      [
        {%- for block in section.blocks -%}
          {%- if block.type == 'result' -%}
            {%- unless forloop.first -%},{%- endunless -%}
            {
              "key": {{ block.settings.result_key | json }},
              "stackName": {{ block.settings.stack_name | json }},
              "description": {{ block.settings.stack_description | json }},
              "handles": [
                {%- assign h_count = 0 -%}
                {%- if block.settings.product_handle_1 != blank -%}
                  {%- if h_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_1 | json }}
                  {%- assign h_count = h_count | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.product_handle_2 != blank -%}
                  {%- if h_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_2 | json }}
                  {%- assign h_count = h_count | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.product_handle_3 != blank -%}
                  {%- if h_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_3 | json }}
                  {%- assign h_count = h_count | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.product_handle_4 != blank -%}
                  {%- if h_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_4 | json }}
                {%- endif -%}
              ],
              "backupHandles": [
                {%- assign b_count = 0 -%}
                {%- if block.settings.product_handle_5 != blank -%}
                  {%- if b_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_5 | json }}
                  {%- assign b_count = b_count | plus: 1 -%}
                {%- endif -%}
                {%- if block.settings.product_handle_6 != blank -%}
                  {%- if b_count > 0 -%},{%- endif -%}
                  {{ block.settings.product_handle_6 | json }}
                {%- endif -%}
              ]
            }
          {%- endif -%}
        {%- endfor -%}
      ]
      </script>

      {%- comment -%} ── Klaviyo + lead-capture config (read by JS) ── {%- endcomment -%}
      <script type="application/json" id="nq-config">
      {
        "language": {{ localization.language.iso_code | json }},
        "klaviyo": {
          "publicKey": {{ section.settings.public_api_key | json }},
          "listId": {{ section.settings.list_id | json }},
          "eventName": {{ section.settings.event_name | json }},
          "source": {{ section.settings.custom_source | json }}
        },
        "capture": {
