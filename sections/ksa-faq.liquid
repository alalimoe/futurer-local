{%- style -%}
  .xo-section--{{ section.id }} .ksa-faq__layout {
    display: grid;
    grid-template-columns: minmax(24rem, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(3.2rem, 6vw, 9.6rem);
    align-items: start;
  }

  .xo-section--{{ section.id }} .ksa-faq__title {
    margin: 0 0 1.2rem;
    font-size: clamp(3.2rem, 5vw, 6.6rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .xo-section--{{ section.id }} .ksa-faq__intro {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
    font-size: 1.5rem;
    line-height: 1.7;
  }

  .xo-section--{{ section.id }} .ksa-faq__item {
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
  }

  .xo-section--{{ section.id }} .ksa-faq__item:last-child {
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 20%, transparent);
  }

  .xo-section--{{ section.id }} .ksa-faq__question {
    display: flex;
    min-height: 6.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.8rem 0;
    color: rgba(var(--color-foreground));
    cursor: pointer;
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.4;
    list-style: none;
  }

  .xo-section--{{ section.id }} .ksa-faq__question::-webkit-details-marker {
    display: none;
  }

  .xo-section--{{ section.id }} .ksa-faq__icon {
    position: relative;
    width: 2rem;
    height: 2rem;
    flex: 0 0 2rem;
  }

  .xo-section--{{ section.id }} .ksa-faq__icon::before,
  .xo-section--{{ section.id }} .ksa-faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1.4rem;
    height: 0.2rem;
    background: rgba(var(--color-foreground));
    transform: translate(-50%, -50%);
  }

  .xo-section--{{ section.id }} .ksa-faq__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .xo-section--{{ section.id }} .ksa-faq__item[open] .ksa-faq__icon::after {
    display: none;
  }

  .xo-section--{{ section.id }} .ksa-faq__answer {
    padding: 0 4rem 2.4rem 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 82%, transparent);
    font-size: 1.5rem;
    line-height: 1.75;
  }

  .xo-section--{{ section.id }} .ksa-faq__answer p {
    margin: 0;
  }

  .xo-section--{{ section.id }} summary:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .xo-section--{{ section.id }} .ksa-faq__layout {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

{%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
{%- if faq_blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "{{ canonical_url }}#faq",
    "inLanguage": "en",
    "mainEntity": [
      {%- for block in faq_blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

<section id="ksa-faq" {% render 'section-attr', section: section %} aria-labelledby="ksa-faq-title-{{ section.id }}">
  <xo-container>
    <div class="ksa-faq__layout">
      <header>
        <h2 id="ksa-faq-title-{{ section.id }}" class="ksa-faq__title">{{ section.settings.heading }}</h2>
        <div class="ksa-faq__intro">{{ section.settings.intro }}</div>
      </header>
      <div>
        {%- for block in faq_blocks -%}
          <details class="ksa-faq__item" {{ block.shopify_attributes }}>
            <summary class="ksa-faq__question">
              <span>{{ block.settings.question }}</span>
              <span class="ksa-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="ksa-faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "KSA FAQ",
  "tag": "section",
  "class": "section-ksa-faq",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nootropics KSA FAQ" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Clear answers about Nootropix, our products, and express delivery from Dubai to Saudi Arabia.</p>" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "KSA FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Does Nootropix ship nootropics to Saudi Arabia?", "answer": "<p>Yes. Nootropix ships orders from Dubai to addresses in Saudi Arabia using express delivery.</p>" } },
        { "type": "faq", "settings": { "question": "How long does delivery to KSA take?", "answer": "<p>Delivery takes 3–5 business days on average after same-day dispatch. This is an average rather than a delivery guarantee, and timing can vary by destination and order timing.</p>" } },
        { "type": "faq", "settings": { "question": "When is express shipping free?", "answer": "<p>Express shipping to KSA is free when the order value reaches SAR 300.</p>" } },
        { "type": "faq", "settings": { "question": "Does Nootropix have a store or warehouse in Saudi Arabia?", "answer": "<p>No. Nootropix is a Dubai-based online retailer, and KSA orders ship from Dubai.</p>" } },
        { "type": "faq", "settings": { "question": "What are nootropics?", "answer": "<p>Nootropics is a broad term for products people add to routines built around goals such as focus, memory, mood, energy, sleep, or long-term wellness. Products vary by ingredient and format.</p>" } },
        { "type": "faq", "settings": { "question": "How should I choose a product?", "answer": "<p>Start with one clear goal, compare full ingredient labels, serving guidance, warnings, price, and current availability, then follow the product label.</p>" } },
        { "type": "faq", "settings": { "question": "Are Certificates of Analysis available?", "answer": "<p>Certificates of Analysis are available for eligible products. Check the COA library or contact support for product-specific information.</p>" } },
        { "type": "faq", "settings": { "question": "Is this page medical advice?", "answer": "<p>No. This page is educational and is not medical advice. Speak with a qualified healthcare professional when personal medical guidance is needed.</p>" } }
      ]
    }
  ]
}
{% endschema %}
