{% comment %} Nootropix — Product Features (Premium) {% endcomment %}
{%- assign sid = section.id -%}

{%- style -%}
#nx-feat-{{ sid }} {
  --nx-accent: var(--color-accent-primary, #FBBF24);
  --nx-accent-hover: var(--color-accent-hover, #D97706);
  --nx-accent-dark: var(--color-accent-dark, #92400e);
  --nx-accent-glass: rgba(251, 191, 36, 0.06);
  --nx-text: var(--color-text-main, #111827);
  --nx-muted: var(--color-text-muted, #4b5563);
  --nx-radius: var(--radius-premium, 14px);
  --nx-transition: var(--transition-premium, all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1));
  --nx-shadow-rest: var(--shadow-sm, 0 2px 8px rgba(0,0,0,0.04));
  --nx-shadow-hover: var(--shadow-md, 0 12px 30px rgba(0,0,0,0.06));
  --nx-gold-glow: var(--shadow-gold-glow, 0 4px 14px rgba(251,191,36,0.25));
  --nx-font: var(--font-body-family, sans-serif);
  --nx-font-heading: var(--font-heading-family, sans-serif);

  max-width: var(--container-width-large);
  margin: 0 auto;
  padding: 8px var(--page-gutter);
  font-family: var(--nx-font);
  color: var(--nx-text);
  content-visibility: auto;
}

#nx-feat-{{ sid }} h2 {
  font-family: var(--nx-font-heading);
  font-size: clamp(22px, 3vw, 30px);
  font-weight: 700;
  line-height: 1.2;
  margin: 0 0 20px;
}

#nx-feat-{{ sid }} .nx-grid {
  display: grid;
  gap: 20px;
}
@media (min-width: 860px) {
  #nx-feat-{{ sid }} .nx-grid { grid-template-columns: 1fr 1fr; }
}

#nx-feat-{{ sid }} .nx-card {
  border: 1px solid transparent;
  border-radius: var(--nx-radius);
  padding: 20px 22px;
  background: #fff;
  box-shadow: var(--nx-shadow-rest);
  transition: var(--nx-transition);
  display: flex;
  flex-direction: column;
}
#nx-feat-{{ sid }} .nx-grid:hover .nx-card:not(:hover) {
  opacity: 0.65;
}
#nx-feat-{{ sid }} .nx-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--nx-shadow-hover);
}

#nx-feat-{{ sid }} .nx-card h3 {
  font-family: var(--nx-font-heading);
  font-size: 18px;
  font-weight: 700;
  margin: 0 0 4px;
  color: var(--nx-text);
}

#nx-feat-{{ sid }} .nx-tags {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--nx-accent-dark);
  margin-bottom: 8px;
}

#nx-feat-{{ sid }} .nx-card p {
  color: var(--nx-muted);
  font-size: 14px;
  line-height: 1.7;
  margin: 0 0 12px;
}

#nx-feat-{{ sid }} .nx-card ul {
  list-style: none;
  padding: 0;
  margin: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

#nx-feat-{{ sid }} .nx-card li {
  font-size: 13px;
  color: var(--nx-muted);
  padding: 6px 10px;
  border-radius: var(--nx-radius-sm);
  background: rgba(249, 250, 251, 0.65);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}
#nx-feat-{{ sid }} .nx-card li strong { color: var(--nx-text); }

#nx-feat-{{ sid }} .nx-btnrow {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 16px;
}

#nx-feat-{{ sid }} .nx-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 14px;
  border-radius: var(--nx-radius-md);
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  min-height: 40px;
  border: 1.5px solid var(--nx-accent);
  background: transparent;
  color: var(--nx-text);
  transition: var(--nx-transition);
}
#nx-feat-{{ sid }} .nx-btn:hover {
  background: var(--nx-accent);
  color: var(--color-text-primary);
  transform: translateY(-1px);
  box-shadow: var(--nx-gold-glow);
}
#nx-feat-{{ sid }} .nx-btn:active { transform: scale(0.98); }

#nx-feat-{{ sid }} .nx-btn.primary {
  background: var(--nx-accent);
  border-color: var(--nx-accent);
  color: var(--color-text-primary);
  box-shadow: var(--nx-gold-glow);
}
#nx-feat-{{ sid }} .nx-btn.primary:hover {
  background: var(--nx-accent-hover);
  border-color: var(--nx-accent-hover);
  box-shadow: 0 8px 24px rgba(251,191,36,0.35);
}

#nx-feat-{{ sid }} a:focus-visible {
  outline: 2px solid var(--nx-accent);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  #nx-feat-{{ sid }},
  #nx-feat-{{ sid }} * {
    transition: none !important;
    animation: none !important;
    transform: none !important;
  }
  #nx-feat-{{ sid }} .nx-grid:hover .nx-card:not(:hover) { opacity: 1; }
}
{%- endstyle -%}

<section id="nx-feat-{{ sid }}" aria-label="Products in focus">
  <h2>Current Product References</h2>
  <div class="nx-grid">
    {% for block in section.blocks %}
      {%- assign cap = block.settings.caps_product -%}
      {%- assign pow = block.settings.powder_product -%}
      {%- if cap.available or pow.available -%}
      <article class="nx-card" {{ block.shopify_attributes }}>
        <h3>{{ cap.title | default: pow.title }}</h3>
        <div class="nx-tags">Merchant-selected and currently available</div>
        <p>Review the live product page for the exact identity, formulation, directions, warnings, local-status context, and document availability.</p>
        <ul>
          <li><strong>Evidence:</strong> product- and outcome-specific; no benefit is guaranteed.</li>
          <li><strong>Use:</strong> follow the current label; this guide does not provide dosing or cycling instructions.</li>
          {% if block.settings.athlete_note %}<li><strong>Sport:</strong> check the current governing-body rules before use.</li>{% endif %}
        </ul>
        <div class="nx-btnrow">
          {% if cap.available %}<a class="nx-btn primary" href="{{ cap.url }}">Review {{ cap.title }}</a>{% endif %}
          {% if pow.available %}<a class="nx-btn" href="{{ pow.url }}">Review {{ pow.title }}</a>{% endif %}
        </div>
      </article>
      {%- endif -%}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "NX — Product Features",
  "settings": [],
  "blocks": [
    {
      "type": "racetam",
      "name": "Racetam Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Aniracetam" },
        { "type": "text", "id": "best_for", "label": "Legacy tagline (not displayed)" },
        { "type": "textarea", "id": "body", "label": "Legacy body (not displayed)" },
        { "type": "text", "id": "solubility", "label": "Legacy solubility note (not displayed)" },
        { "type": "text", "id": "onset", "label": "Legacy onset/duration (not displayed)" },
        { "type": "text", "id": "stack_tip", "label": "Legacy stack tip (not displayed)" },
        { "type": "checkbox", "id": "athlete_note", "label": "Show athlete note (Phenylpiracetam class)", "default": false },
        { "type": "product", "id": "caps_product", "label": "Capsules product (optional)" },
        { "type": "product", "id": "powder_product", "label": "Powder product (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NX — Product Features (In-Stock)",
      "blocks": [
        { "type": "racetam", "settings": { "title": "Product reference" } }
      ]
    }
  ]
}
{% endschema %}
