{% render 'nx01-launch-css' %}

{%- liquid
  assign fact_count = 0
  assign image_count = 0
  for block in section.blocks
    if block.type == 'fact'
      if block.settings.value != blank or block.settings.label != blank
        assign fact_count = fact_count | plus: 1
      endif
    endif
  endfor
  if section.settings.image_1 != blank
    assign image_count = image_count | plus: 1
  endif
  if section.settings.image_2 != blank
    assign image_count = image_count | plus: 1
  endif
  if section.settings.image_3 != blank
    assign image_count = image_count | plus: 1
  endif
  assign gallery_sizes = '(max-width: 767px) 88vw, 28vw'
  if image_count == 1
    assign gallery_sizes = '(max-width: 767px) 88vw, min(548px, 72vw)'
  elsif image_count == 2
    assign gallery_sizes = '(max-width: 767px) 88vw, min(548px, calc((100vw - 16rem) / 2))'
  endif
  assign nx01_anchor = section.settings.anchor_id | default: 'nx01-snapshot' | handleize
  assign nx01_intro_class = 'nx01__intro'
  if section.settings.heading_alignment == 'center'
    assign nx01_intro_class = 'nx01__intro nx01__intro--center'
  endif
-%}

<section
  id="{{ nx01_anchor }}"
  class="nx01 nx01-snapshot xo-section xo-section--{{ section.id }}{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  style="{% if section.settings.padding_top != blank %}--nx01-pad-block-start: {{ section.settings.padding_top }}px;{% endif %}{% if section.settings.padding_bottom != blank %} --nx01-pad-block-end: {{ section.settings.padding_bottom }}px;{% endif %}"
  aria-labelledby="nx01-snapshot-heading-{{ section.id }}"
>
  <div class="nx01__inner">
    <div class="{{ nx01_intro_class }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nx01__label">
          <span class="nx01__label-rule" aria-hidden="true"></span>
          <span>{{ section.settings.eyebrow | escape }}</span>
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="nx01__heading" id="nx01-snapshot-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="nx01__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_facts and fact_count > 0 -%}
      <ul class="nx01-snapshot__facts" aria-label="{{ 'sections.nx01_launch_snapshot.facts_label' | t }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'fact' -%}
            {%- if block.settings.value != blank or block.settings.label != blank -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.value != blank -%}
                  <p class="nx01-snapshot__value">{{ block.settings.value | escape }}</p>
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <p class="nx01-snapshot__fact-label">{{ block.settings.label | escape }}</p>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.image_1 != blank or section.settings.image_2 != blank or section.settings.image_3 != blank -%}
      <ul class="nx01-snapshot__gallery" style="--nx01-gallery-count: {{ image_count }};">
        {%- if section.settings.image_1 != blank -%}
          <li>
            {{
              section.settings.image_1
              | image_url: width: 1200
              | image_tag:
                class: 'nx01-snapshot__img',
                loading: 'lazy',
                widths: '360, 540, 720, 960, 1200',
                sizes: gallery_sizes,
                alt: section.settings.image_1_alt,
                width: section.settings.image_1.width,
                height: section.settings.image_1.height,
                decoding: 'async'
            }}
          </li>
        {%- endif -%}
        {%- if section.settings.image_2 != blank -%}
          <li>
            {{
              section.settings.image_2
              | image_url: width: 1200
              | image_tag:
                class: 'nx01-snapshot__img',
                loading: 'lazy',
                widths: '360, 540, 720, 960, 1200',
                sizes: gallery_sizes,
                alt: section.settings.image_2_alt,
                width: section.settings.image_2.width,
                height: section.settings.image_2.height,
                decoding: 'async'
            }}
          </li>
        {%- endif -%}
        {%- if section.settings.image_3 != blank -%}
          <li>
            {{
              section.settings.image_3
              | image_url: width: 1200
              | image_tag:
                class: 'nx01-snapshot__img',
                loading: 'lazy',
                widths: '360, 540, 720, 960, 1200',
                sizes: gallery_sizes,
                alt: section.settings.image_3_alt,
                width: section.settings.image_3.width,
                height: section.settings.image_3.height,
                decoding: 'async'
            }}
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% style %}
  .nx01-snapshot__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.4rem;
    margin: 0 0 2.4rem;
    padding: 2.4rem 1.6rem;
    list-style: none;
    background: rgb(var(--nx01-surface));
    border-radius: var(--nx01-radius);
  }

  .nx01-snapshot__facts li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
  }

  .nx01-snapshot__value {
    margin: 0;
    font-size: 3.2rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .nx01-snapshot__fact-label {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--nx01-body));
  }

  .nx01-snapshot__gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nx01-snapshot__gallery li {
    background: rgb(var(--nx01-surface));
    border-radius: var(--nx01-radius);
    overflow: hidden;
  }

  .nx01-snapshot__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }

  @media screen and (min-width: 768px) {
    .nx01-snapshot__facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding: 2.4rem 3.2rem;
    }

    .nx01-snapshot__gallery {
      grid-template-columns: repeat(var(--nx01-gallery-count, 3), minmax(0, 1fr));
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "NX-01 launch snapshot",
  "tag": "section",
  "class": "section-nx01-snapshot",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "header", "content": "Reuse" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "info": "Optional in-page link target. Leave blank to keep nx01-snapshot." },
    { "type": "select", "id": "heading_alignment", "label": "Heading alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "range", "id": "padding_top", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 24, "max": 120, "step": 8, "unit": "px", "label": "Padding bottom", "default": 48 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your daily serving" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "3 capsules a day. 30 days in the bottle." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "90 capsules. One month of the listed serving." },
    { "type": "checkbox", "id": "show_facts", "label": "Show product facts", "default": true },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "text", "id": "image_1_alt", "label": "Image 1 alt text" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "text", "id": "image_2_alt", "label": "Image 2 alt text" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "text", "id": "image_3_alt", "label": "Image 3 alt text" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "3" },
        { "type": "text", "id": "label", "label": "Label", "default": "capsules daily" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "NX-01 launch snapshot",
      "blocks": [
        { "type": "fact", "settings": { "value": "3", "label": "capsules daily" } },
        { "type": "fact", "settings": { "value": "9", "label": "actives" } },
        { "type": "fact", "settings": { "value": "30", "label": "daily servings" } },
        { "type": "fact", "settings": { "value": "0 mg", "label": "caffeine" } }
      ]
    }
  ]
}
{% endschema %}
