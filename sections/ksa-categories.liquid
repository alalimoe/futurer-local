{%- style -%}
  .xo-section--{{ section.id }} .ksa-categories__header {
    max-width: 74rem;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .xo-section--{{ section.id }} .ksa-categories__title {
    margin: 0 0 1.2rem;
    font-size: clamp(3.2rem, 5vw, 6.6rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .xo-section--{{ section.id }} .ksa-categories__intro {
    margin: 0;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.6rem;
    line-height: 1.7;
  }

  .xo-section--{{ section.id }} .ksa-categories__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-desktop-horizontal-spacing);
  }

  .xo-section--{{ section.id }} .ksa-categories__card {
    position: relative;
    display: flex;
    min-height: 24rem;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.8rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 18%, transparent);
    border-radius: 2.8rem;
    background: rgba(var(--color-background-2));
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .ksa-categories__eyebrow {
    margin-bottom: 3.2rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .xo-section--{{ section.id }} .ksa-categories__card-title {
    margin: 0 0 1rem;
    font-size: clamp(2.2rem, 2.8vw, 3.2rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .xo-section--{{ section.id }} .ksa-categories__description {
    margin: 0 0 2.4rem;
    color: color-mix(in srgb, rgba(var(--color-foreground)) 78%, transparent);
    font-size: 1.5rem;
    line-height: 1.65;
  }

  .xo-section--{{ section.id }} .ksa-categories__link {
    display: inline-flex;
    min-height: 4.4rem;
    align-items: center;
    align-self: flex-start;
    color: rgba(var(--color-foreground));
    font-size: 1.5rem;
    font-weight: 600;
    text-underline-offset: 0.4rem;
  }

  .xo-section--{{ section.id }} .ksa-categories__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .xo-section--{{ section.id }} .ksa-categories__card:has(.ksa-categories__link:focus-visible) {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 3px;
  }

  .xo-section--{{ section.id }} .ksa-categories__link:focus-visible {
    outline: none;
  }

  @media (max-width: 991px) {
    .xo-section--{{ section.id }} .ksa-categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .xo-section--{{ section.id }} .ksa-categories__grid {
      grid-template-columns: 1fr;
      gap: var(--grid-mobile-vertical-spacing);
    }

    .xo-section--{{ section.id }} .ksa-categories__card {
      min-height: 0;
    }
  }
{%- endstyle -%}

{%- assign category_blocks = section.blocks | where: 'type', 'category' -%}
{%- if category_blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": {{ section.settings.heading | json }},
    "itemListElement": [
      {%- for block in category_blocks -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "name": {{ block.settings.title | json }},
          "url": {{ block.settings.collection.url | default: block.settings.link | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

<section id="ksa-categories" {% render 'section-attr', section: section %} aria-labelledby="ksa-categories-title-{{ section.id }}">
  <xo-container>
    <header class="ksa-categories__header">
      <h2 id="ksa-categories-title-{{ section.id }}" class="ksa-categories__title">{{ section.settings.heading }}</h2>
      <div class="ksa-categories__intro">{{ section.settings.intro }}</div>
    </header>
    <div class="ksa-categories__grid">
      {%- for block in category_blocks -%}
        {%- assign category_url = block.settings.collection.url | default: block.settings.link -%}
        <article class="ksa-categories__card" {{ block.shopify_attributes }}>
          <span class="ksa-categories__eyebrow">{{ section.settings.card_label }}</span>
          <div>
            <h3 class="ksa-categories__card-title">{{ block.settings.title | default: block.settings.collection.title }}</h3>
            <p class="ksa-categories__description">{{ block.settings.description }}</p>
            {%- if category_url != blank -%}
              <a class="ksa-categories__link" href="{{ category_url }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </xo-container>
</section>

{% schema %}
{
  "name": "KSA categories",
  "tag": "section",
  "class": "section-ksa-categories",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop nootropics by goal" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Browse six clear categories and compare product labels before choosing what fits your routine.</p>" },
    { "type": "text", "id": "card_label", "label": "Card label", "default": "Browse by goal" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 80 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Goal category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Fallback link" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore category" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "KSA categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Focus & Deep Work", "description": "Explore products organized for focused work and demanding routines." } },
        { "type": "category", "settings": { "title": "Memory & Learning", "description": "Compare products commonly selected for study and learning routines." } },
        { "type": "category", "settings": { "title": "Mood & Stress", "description": "Browse products organized around calm and everyday balance." } },
        { "type": "category", "settings": { "title": "Energy & Wakefulness", "description": "Explore options for daytime energy and alertness routines." } },
        { "type": "category", "settings": { "title": "Sleep & Recovery", "description": "Browse products selected for evening and recovery routines." } },
        { "type": "category", "settings": { "title": "Neuroprotection & Longevity", "description": "Explore products organized for long-term wellness routines." } }
      ]
    }
  ]
}
{% endschema %}
