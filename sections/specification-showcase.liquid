{{ 'section-specification-showcase.css' | asset_url | stylesheet_tag }}

{% liquid
  assign image = section.settings.image
  assign overlay_opacity = section.settings.overlay_opacity | default: 20
  assign overlay = overlay_opacity | divided_by: 100.0
  assign heading = section.settings.heading
  assign heading_class = section.settings.font_size_heading | default: 'h1'
  assign point_size = section.settings.point_size

  assign aspect_ratio = section.settings.aspect_ratio
  if aspect_ratio == 'custom'
    assign aspect_ratio = section.settings.aspect_ratio_width | append: '/' | append: section.settings.aspect_ratio_height
  endif
%}

<section {% render 'section-attr' %}>
  <div class="specification-showcase" xo-popover-boundary>
    <xo-container class="specification-showcase__container">
      <div class="specification-showcase__media" style="--overlay: {{ overlay }}">
        <xo-animate xo-cascade class="specification-showcase__frame">
          {% render 'image',
            image: image,
            aspect_ratio: aspect_ratio,
            class: 'specification-showcase__media-el'
          %}
          <div class="specification-showcase__overlay" aria-hidden="true"></div>

          {% for block in section.blocks %}
            {% liquid
              assign color = block.settings.hotspot_color | default: '#ffffff'
              assign icon = block.settings.icon
              assign title = block.settings.title
              assign description = block.settings.description
              assign placement = block.settings.placement | default: 'right-center'
            %}
            <div
              class="specification-showcase__hotspot"
              style="--top_dt: {{ block.settings.top_dt }}; --left_dt: {{ block.settings.left_dt }}; --top_mb: {{ block.settings.top_mb }}; --left_mb: {{ block.settings.left_mb }}"
              {{ block.shopify_attributes }}
            >
              <div class="shop-look-2">
                <xo-popover-trigger
                  class="shop-look-2__trigger"
                  xo-name="spec-{{ block.id }}"
                  style="--color: {{ color }}"
                  tabindex="0"
                  role="button"
                  aria-label="{{ title | default: 'Specification' | escape }}"
                >
                  <div class="shop-look-2__container" style="--size: {{ point_size }}rem; --color: {{ color }}">
                    <div class="shop-look-2__point shop-look-2__point--1"></div>
                    <div class="shop-look-2__point shop-look-2__point--2"></div>
                    <div class="shop-look-2__point shop-look-2__point--3"></div>
                  </div>
                </xo-popover-trigger>

                <xo-popover
                  class="specification-showcase__popover"
                  xo-name="spec-{{ block.id }}"
                  xo-portal
                  xo-placement="{{ placement }}"
                >
                  <div class="specification-showcase__card">
                    {% if icon != blank %}
                      <div class="specification-showcase__card-icon">
                        {% render 'image', image: icon, aspect_ratio: '1', class: 'specification-showcase__card-icon-el' %}
                      </div>
                    {% endif %}
                    <div class="specification-showcase__card-body">
                      {% if title != blank %}
                        <p class="specification-showcase__card-title">{{ title }}</p>
                      {% endif %}
                      {% if description != blank %}
                        <p class="specification-showcase__card-desc">{{ description }}</p>
                      {% endif %}
                    </div>
                  </div>
                </xo-popover>
              </div>
            </div>
          {% endfor %}
        </xo-animate>
      </div>

      <div class="specification-showcase__content">
        {% if heading != blank %}
          <xo-animate xo-cascade>
            <h2 class="specification-showcase__heading {{ heading_class }}">{{ heading }}</h2>
          </xo-animate>
        {% endif %}
        {% if section.settings.button_text != blank %}
          <xo-animate xo-cascade class="specification-showcase__actions">
            {% render 'button',
              text: section.settings.button_text,
              link: section.settings.button_link,
              style: section.settings.button_style,
              size: section.settings.button_size
            %}
          </xo-animate>
        {% endif %}
      </div>
    </xo-container>
  </div>
</section>

