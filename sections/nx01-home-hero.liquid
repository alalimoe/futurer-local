{{ 'nx01-home-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = all_products['nx-01-baseline']
  endif

  assign heading = section.settings.heading | strip
  if heading == blank and product != blank
    assign heading = product.title
  endif
  if heading == blank
    assign heading = 'NX-01 Baseline'
  endif

  assign heading_tag = section.settings.heading_tag
  if heading_tag != 'h1' and heading_tag != 'h2'
    assign heading_tag = 'h1'
  endif

  assign eyebrow = section.settings.eyebrow | strip
  assign supporting = section.settings.supporting | strip
  assign meta_line = section.settings.meta_line | strip
  assign variant = product.selected_or_first_available_variant

  if meta_line == blank and variant != blank
    assign meta_price = variant.price | money | strip_html
    assign meta_daily = variant.price | divided_by: 30 | money | strip_html
    assign meta_line = 'sections.nx01_home_hero.dynamic_meta' | t: price: meta_price, daily_price: meta_daily
  endif

  assign primary_label = section.settings.primary_label | strip
  assign primary_link = section.settings.primary_link
  if primary_link == blank and product != blank
    assign primary_link = product.url
  endif

  assign secondary_label = section.settings.secondary_label | strip
  assign secondary_link = section.settings.secondary_link
  if secondary_link == blank and pages['nx-01'] != blank
    assign secondary_link = pages['nx-01'].url
  endif

  assign image_primary = section.settings.image
  assign image_secondary = section.settings.image_secondary
  if image_primary == blank and product != blank and product.featured_image != blank
    assign image_primary = product.featured_image
  endif

  assign image_alt = section.settings.image_alt | strip
  if image_alt == blank and product != blank
    if product.featured_image != blank and product.featured_image.alt != blank
      assign image_alt = product.featured_image.alt
    else
      assign image_alt = product.title
    endif
  endif

  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == blank or section.index <= 2
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif

  assign fact_count = 0
  for block in section.blocks
    if block.type == 'fact'
      if block.settings.value != blank or block.settings.label != blank
        assign fact_count = fact_count | plus: 1
      endif
    endif
  endfor

  assign scroll_label = section.settings.scroll_label | strip
  assign scroll_href = section.settings.scroll_href | strip
  assign heading_id = 'nx01-home-hero-heading-' | append: section.id
  assign facts_id = 'nx01-home-hero-facts-' | append: section.id
  assign media_pair = false
  if image_primary != blank and image_secondary != blank
    assign media_pair = true
  endif
  if image_primary == blank
    assign media_pair = true
  endif
-%}

<section
  id="nx01-home-hero-{{ section.id }}"
  class="nx01-home-hero xo-section xo-section--{{ section.id }}{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  style="--nx01hh-pad-start: {{ section.settings.padding_top }}px; --nx01hh-pad-end: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="{{ heading_id }}"
>
  <div class="nx01-home-hero__inner">
    <div class="nx01-home-hero__stage">
      <div class="nx01-home-hero__copy">
        {%- if eyebrow != blank -%}
          <p class="nx01-home-hero__eyebrow">{{ eyebrow | escape }}</p>
        {%- endif -%}

        <{{ heading_tag }} class="nx01-home-hero__heading" id="{{ heading_id }}">
          {{ heading | escape }}
        </{{ heading_tag }}>

        {%- if meta_line != blank -%}
          <p class="nx01-home-hero__meta">{{ meta_line | escape }}</p>
        {%- endif -%}

        {%- if supporting != blank -%}
          <p class="nx01-home-hero__supporting">{{ supporting | escape }}</p>
        {%- endif -%}

        {%- if primary_label != blank and primary_link != blank -%}
          <div class="nx01-home-hero__actions">
            <a class="nx01-home-hero__btn nx01-home-hero__btn--primary" href="{{ primary_link }}">
              {{ primary_label | escape }}
            </a>
            {%- if secondary_label != blank and secondary_link != blank -%}
              <a class="nx01-home-hero__btn nx01-home-hero__btn--secondary" href="{{ secondary_link }}">
                {{ secondary_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- elsif secondary_label != blank and secondary_link != blank -%}
          <div class="nx01-home-hero__actions">
            <a class="nx01-home-hero__btn nx01-home-hero__btn--secondary" href="{{ secondary_link }}">
              {{ secondary_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>

      <div class="nx01-home-hero__media{% if media_pair %} nx01-home-hero__media--pair{% endif %}">
        {%- if image_primary != blank -%}
          <div class="nx01-home-hero__figure nx01-home-hero__figure--primary">
            {{
              image_primary
              | image_url: width: 1200
              | image_tag:
                class: 'nx01-home-hero__img',
                loading: image_loading,
                fetchpriority: image_priority,
                widths: '200, 280, 360, 480, 640, 800, 1000, 1200',
                sizes: '(max-width: 749px) min(72vw, 320px), min(28vw, 420px)',
                alt: image_alt,
                width: image_primary.width,
                height: image_primary.height,
                decoding: 'async'
            }}
          </div>
        {%- else -%}
          <div class="nx01-home-hero__figure nx01-home-hero__figure--primary" aria-hidden="true">
            {{ 'product-1' | placeholder_svg_tag: 'nx01-home-hero__placeholder' }}
          </div>
        {%- endif -%}

        {%- if image_secondary != blank -%}
          <div class="nx01-home-hero__figure nx01-home-hero__figure--secondary">
            {{
              image_secondary
              | image_url: width: 1200
              | image_tag:
                class: 'nx01-home-hero__img',
                loading: image_loading,
                fetchpriority: 'auto',
                widths: '200, 280, 360, 480, 640, 800, 1000, 1200',
                sizes: '(max-width: 749px) min(78vw, 360px), min(34vw, 520px)',
                alt: '',
                width: image_secondary.width,
                height: image_secondary.height,
                decoding: 'async'
            }}
          </div>
        {%- elsif image_primary == blank -%}
          <div class="nx01-home-hero__figure nx01-home-hero__figure--secondary" aria-hidden="true">
            {{ 'product-2' | placeholder_svg_tag: 'nx01-home-hero__placeholder' }}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if fact_count > 0 -%}
      <ul class="nx01-home-hero__facts" id="{{ facts_id }}" aria-label="{{ 'sections.nx01_home_hero.facts_label' | t }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'fact' -%}
            {%- if block.settings.value != blank or block.settings.label != blank -%}
              <li class="nx01-home-hero__fact" {{ block.shopify_attributes }}>
                {%- if block.settings.value != blank -%}
                  <p class="nx01-home-hero__fact-value">{{ block.settings.value | escape }}</p>
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <p class="nx01-home-hero__fact-label">{{ block.settings.label | escape }}</p>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if scroll_label != blank and scroll_href != blank -%}
      <a class="nx01-home-hero__scroll" href="{{ scroll_href | escape }}">
        <span>{{ scroll_label | escape }}</span>
        <span class="nx01-home-hero__scroll-mark" aria-hidden="true"></span>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.nx01_home_hero.name",
  "tag": "div",
  "class": "section-nx01-home-hero",
  "limit": 1,
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.nx01_home_hero.settings.color_scheme",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.nx01_home_hero.settings.content_header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.nx01_home_hero.settings.eyebrow",
      "default": "Introducing NX-01 Baseline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.nx01_home_hero.settings.heading",
      "default": "Your daily nootropic stack, simplified."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.nx01_home_hero.settings.heading_tag",
      "info": "t:sections.nx01_home_hero.settings.heading_tag_info",
      "options": [
        { "value": "h1", "label": "t:sections.nx01_home_hero.settings.heading_h1" },
        { "value": "h2", "label": "t:sections.nx01_home_hero.settings.heading_h2" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "meta_line",
      "label": "t:sections.nx01_home_hero.settings.meta_line",
      "info": "t:sections.nx01_home_hero.settings.meta_line_info"
    },
    {
      "type": "text",
      "id": "supporting",
      "label": "t:sections.nx01_home_hero.settings.supporting",
      "default": "9 active nootropic ingredients in one daily serving."
    },
    {
      "type": "header",
      "content": "t:sections.nx01_home_hero.settings.buttons_header"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:sections.nx01_home_hero.settings.primary_label",
      "default": "Shop NX-01"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:sections.nx01_home_hero.settings.primary_link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:sections.nx01_home_hero.settings.secondary_label",
      "default": "View ingredients & amounts"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:sections.nx01_home_hero.settings.secondary_link"
    },
    {
      "type": "header",
      "content": "t:sections.nx01_home_hero.settings.media_header"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.nx01_home_hero.settings.image",
      "info": "t:sections.nx01_home_hero.settings.image_info"
    },
    {
      "type": "image_picker",
      "id": "image_secondary",
      "label": "t:sections.nx01_home_hero.settings.image_secondary",
      "info": "t:sections.nx01_home_hero.settings.image_secondary_info"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:sections.nx01_home_hero.settings.image_alt",
      "info": "t:sections.nx01_home_hero.settings.image_alt_info"
    },
    {
      "type": "header",
      "content": "t:sections.nx01_home_hero.settings.product_header"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.nx01_home_hero.settings.product",
      "info": "t:sections.nx01_home_hero.settings.product_info"
    },
    {
      "type": "header",
      "content": "t:sections.nx01_home_hero.settings.scroll_header"
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "t:sections.nx01_home_hero.settings.scroll_label",
      "default": "See what's inside"
    },
    {
      "type": "text",
      "id": "scroll_href",
      "label": "t:sections.nx01_home_hero.settings.scroll_href",
      "info": "t:sections.nx01_home_hero.settings.href_info",
      "default": "/pages/nx-01"
    },
    {
      "type": "header",
      "content": "t:sections.nx01_home_hero.settings.layout_header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 32,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.nx01_home_hero.settings.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "t:sections.nx01_home_hero.settings.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "t:sections.nx01_home_hero.blocks.fact.name",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.nx01_home_hero.blocks.fact.settings.value",
          "default": "9"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.nx01_home_hero.blocks.fact.settings.label",
          "default": "Actives"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.nx01_home_hero.presets.name",
      "blocks": [
        { "type": "fact", "settings": { "value": "9", "label": "Actives" } },
        { "type": "fact", "settings": { "value": "3", "label": "Capsules daily" } },
        { "type": "fact", "settings": { "value": "30", "label": "Daily servings" } },
        { "type": "fact", "settings": { "value": "0mg", "label": "Caffeine" } }
      ]
    }
  ]
}
{% endschema %}
