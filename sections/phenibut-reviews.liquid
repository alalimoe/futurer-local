{% comment %}
  Reviews — XO theme design system
  - Blockquote semantics, AggregateRating + Review JSON-LD, reduced-motion
{% endcomment %}

{%- comment -%} ── JSON-LD: AggregateRating + Reviews ── {%- endcomment -%}
{%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
{% if review_blocks.size > 0 %}
  {%- assign total_rating = 0 -%}
  {%- for block in review_blocks -%}
    {%- assign total_rating = total_rating | plus: block.settings.rating -%}
  {%- endfor -%}
  {%- assign avg_rating = total_rating | times: 1.0 | divided_by: review_blocks.size -%}
  {%- assign jsonld_product_name = section.settings.product_name | default: page.title -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ jsonld_product_name | json }},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ avg_rating | round: 1 }}",
    "reviewCount": "{{ review_blocks.size }}",
    "bestRating": "5"
  },
  "review": [
    {%- for block in review_blocks -%}
      {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "{{ block.settings.rating }}", "bestRating": "5" },
        "author": { "@type": "Person", "name": {{ block.settings.author | json }} },
        "reviewBody": {{ block.settings.text | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{% endif %}

{%- style -%}
.xo-section--{{ section.id }} xo-animate { display: block; }
.xo-section--{{ section.id }} { scroll-margin-top: 96px; }
@media (max-width: 768px) { .xo-section--{{ section.id }} { scroll-margin-top: 80px; } }
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .xo-section--{{ section.id }} .phb-kicker {
    display: block;
    margin: 0 0 1rem;
    color: rgba(var(--color-accent));
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .xo-section--{{ section.id }} .phb-reviews__title {
    font-size: clamp(2.8rem, 4vw, 4.8rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: rgba(var(--color-foreground));
    margin: 0 0 0.8rem;
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .phb-reviews__intro {
    color: rgba(var(--color-foreground));
    max-width: 72rem;
    margin-bottom: 1.2rem;
  }

  .xo-section--{{ section.id }} .phb-reviews__aggregate {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0 0 2rem;
    font-size: 1.5rem;
    font-weight: 600;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .phb-reviews__aggregate-stars {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .phb-reviews__carousel {
    position: relative;
  }

  .xo-section--{{ section.id }} .phb-review {
    background: rgba(var(--color-background));
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
    border-radius: var(--general-radius-3, 2rem);
    padding: 2rem;
    height: 100%;
  }

  .xo-section--{{ section.id }} .phb-review__rating {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: rgba(var(--color-accent));
  }

  .xo-section--{{ section.id }} .phb-review__text {
    color: rgba(var(--color-foreground));
    line-height: 1.6;
    margin: 0.6rem 0 0.8rem;
    padding: 0;
    border: none;
    font-style: normal;
    font-size: inherit;
  }

  .xo-section--{{ section.id }} .phb-review__meta {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
    font-size: 1.4rem;
    margin: 0;
    display: flex;
    gap: 0.8rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .xo-section--{{ section.id }} .phb-rv-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.8rem;
    font-size: 1.2rem;
    line-height: 1.4;
    border-radius: var(--button-radius, 10rem);
    background: rgba(var(--color-foreground));
    color: rgba(var(--color-background));
  }

  .xo-section--{{ section.id }} .phb-reviews__nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.6rem;
  }

  .xo-section--{{ section.id }} .phb-reviews__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 15%, transparent);
    background: rgba(var(--color-background));
    color: rgba(var(--color-foreground));
    cursor: pointer;
    transition: border-color 0.2s var(--out-soft, ease), background 0.2s var(--out-soft, ease);
  }

  .xo-section--{{ section.id }} .phb-reviews__nav-btn:hover {
    border-color: rgba(var(--color-accent));
    background: color-mix(in srgb, rgba(var(--color-accent)) 12%, rgba(var(--color-background)));
  }

  .xo-section--{{ section.id }} .phb-reviews__nav-btn:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  .xo-section--{{ section.id }} :focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ section.id }} *,
    .xo-section--{{ section.id }} *::before,
    .xo-section--{{ section.id }} *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
{%- endstyle -%}

<section {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id }}" {% endif %}{% render 'section-attr' %} aria-labelledby="phb-reviews-title-{{ section.id }}">
  <xo-container>
    <xo-animate xo-type="fade-up">
      {% if section.settings.kicker != blank %}
        <span class="phb-kicker">{{ section.settings.kicker | escape }}</span>
      {% endif %}
      <h2 id="phb-reviews-title-{{ section.id }}" class="phb-reviews__title">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.intro != blank %}
        <div class="phb-reviews__intro">{{ section.settings.intro }}</div>
      {% endif %}

      {% if review_blocks.size > 0 %}
        {%- assign avg_display = avg_rating | round: 1 -%}
        {%- assign avg_rounded = avg_rating | round -%}
        <p class="phb-reviews__aggregate" aria-label="Average rating {{ avg_display }} out of 5 from {{ review_blocks.size }} verified reviews">
          <span class="phb-reviews__aggregate-stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- if i <= avg_rounded -%}
                {% render 'icon', name: 'star-active', size: '1.6rem' %}
              {%- else -%}
                {% render 'icon', name: 'star', size: '1.6rem' %}
              {%- endif -%}
            {%- endfor -%}
          </span>
          <span aria-hidden="true">{{ avg_display }}/5 · {{ review_blocks.size }} verified reviews</span>
        </p>
      {% endif %}
    </xo-animate>

    {% if review_blocks.size > 0 %}
      <div class="phb-reviews__carousel">
        <xo-carousel
          xo-per-view="1"
          xo-per-move="1"
          xo-type="slide"
          xo-gap="16"
          xo-breakpoints='
            {
              "768": { "perView": 2, "perMove": 1, "gap": 20 },
              "992": { "perView": {{ section.settings.columns_desktop }}, "perMove": 1, "gap": 24 }
            }
          '
        >
          <xo-carousel-inner>
            <xo-carousel-list>
              {% for block in section.blocks %}
                {% if block.type == 'review' %}
                  <xo-carousel-slide {{ block.shopify_attributes }}>
                    <article class="phb-review">
                      <div class="phb-review__rating" aria-label="{{ block.settings.rating }} out of 5 stars">
                        {%- for i in (1..5) -%}
                          {%- if i <= block.settings.rating -%}
                            {% render 'icon', name: 'star-active', size: '1.5rem' %}
                          {%- else -%}
                            {% render 'icon', name: 'star', size: '1.5rem' %}
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                      <blockquote class="phb-review__text" dir="auto">"{{ block.settings.text | escape }}"</blockquote>
                      <p class="phb-review__meta" dir="auto">
                        — {{ block.settings.author | escape }}{% if block.settings.location != blank %}, {{ block.settings.location | escape }}{% endif %}
                        {% if block.settings.verified %}<span class="phb-rv-badge">{% render 'icon', name: 'verified-user', size: '1.2rem' %}Verified</span>{% endif %}
                      </p>
                    </article>
                  </xo-carousel-slide>
                {% endif %}
              {% endfor %}
            </xo-carousel-list>
          </xo-carousel-inner>
          {% if review_blocks.size > section.settings.columns_desktop %}
            <div class="phb-reviews__nav">
              <xo-carousel-prev class="phb-reviews__nav-btn" role="button" tabindex="0" aria-label="Previous reviews">
                {% render 'icon', name: 'arrow-left', size: '1.8rem' %}
              </xo-carousel-prev>
              <xo-carousel-next class="phb-reviews__nav-btn" role="button" tabindex="0" aria-label="Next reviews">
                {% render 'icon', name: 'arrow-right', size: '1.8rem' %}
              </xo-carousel-next>
            </div>
          {% endif %}
        </xo-carousel>
      </div>
    {% endif %}
  </xo-container>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "section-phenibut-reviews",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "reviews" },
    { "type": "text", "id": "product_name", "label": "Product name (structured data)", "default": "Phenibut", "info": "Used in the Product/AggregateRating JSON-LD. Set per compound." },
    { "type": "text", "id": "kicker", "label": "Kicker (eyebrow label)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Stories" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Real experiences from Dubai and beyond—fast delivery, consistent quality.</p>" },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "blocks": [
    { "type": "review", "name": "Review", "settings": [
      { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
      { "type": "text", "id": "text", "label": "Review text", "default": "Got my order the same day. Exactly what I needed to unwind." },
      { "type": "text", "id": "author", "label": "Author", "default": "A. R." },
      { "type": "text", "id": "location", "label": "Location", "default": "Dubai" },
      { "type": "checkbox", "id": "verified", "label": "Show Verified badge", "default": true }
    ] },
    { "type": "@app" }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Reviews (Curated)",
      "blocks": [
        { "type": "review", "settings": { "rating": 5, "text": "You can get this in a lot of places, but Nootropix's quality is so much better and their customer service is exceptional.", "author": "Anonymous", "location": "UAE", "verified": true } },
        { "type": "review", "settings": { "rating": 5, "text": "هدوء وراحة نفسية", "author": "A.", "location": "UAE", "verified": true } },
        { "type": "review", "settings": { "rating": 5, "text": "Hidden gem", "author": "M.", "location": "France", "verified": true } },
        { "type": "review", "settings": { "rating": 4, "text": "Motivating, relaxing, sleep friendly", "author": "M.T.", "location": "UAE", "verified": true } },
        { "type": "review", "settings": { "rating": 5, "text": "Good", "author": "O.A.", "location": "UAE", "verified": true } }
      ]
    }
  ]
}
{% endschema %}
