{%- liquid
  assign product = section.settings.product
  if product == blank
    assign product = all_products['nx-01-baseline']
  endif
  assign variant = product.selected_or_first_available_variant
  assign cta_label = section.settings.cta_label
  assign microcopy = section.settings.microcopy
  if variant != blank
    assign bottle_price = variant.price | money | strip_html
    assign microcopy = 'sections.nx01_launch_close.dynamic_microcopy' | t: price: bottle_price
    if variant.available == false
      assign cta_label = 'sections.nx01_launch_close.restock_cta' | t
    endif
  endif
  assign show_cta = false
  if cta_label != blank and section.settings.cta_href != blank
    assign show_cta = true
  endif
-%}

{% render 'nx01-launch-css' %}

<section
  id="nx01-close"
  class="nx01 nx01-close xo-section xo-section--{{ section.id }}{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }}{% endif %}"
  aria-labelledby="nx01-close-heading-{{ section.id }}"
>
  <div class="nx01__inner nx01-close__inner">
    <div class="nx01-close__stage">
      <div class="nx01-close__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="nx01__label">
            <span class="nx01__label-rule" aria-hidden="true"></span>
            <span>{{ section.settings.eyebrow | escape }}</span>
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="nx01__heading nx01-close__heading" id="nx01-close-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="nx01__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if show_cta -%}
          {% render 'button', style: 'primary', text: cta_label, link: section.settings.cta_href %}
        {%- endif -%}
        {%- if microcopy != blank -%}
          <p class="nx01-close__micro">{{ microcopy | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.image != blank -%}
        <div class="nx01-close__media">
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              class: 'nx01-close__img',
              loading: 'lazy',
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(max-width: 989px) min(640px, 80vw), min(640px, 50vw)',
              alt: section.settings.image_alt,
              width: section.settings.image.width,
              height: section.settings.image.height,
              decoding: 'async'
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .nx01-close__inner {
    display: flex;
    flex-direction: column;
    gap: 4.8rem;
  }

  .nx01-close__stage {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 3.2rem;
  }

  .nx01-close__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.6rem;
    max-width: 64rem;
  }

  .nx01-close__heading {
    font-size: clamp(2.8rem, 4vw, 5.6rem);
  }

  .nx01-close__media {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
  }

  .nx01-close__img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 28rem;
    height: auto;
    margin-inline: auto;
    object-fit: contain;
  }

  @media screen and (min-width: 990px) {
    .nx01-close__stage {
      grid-template-columns: minmax(0, 0.5fr) minmax(0, 0.5fr);
      column-gap: 4.8rem;
    }

    .nx01-close__img {
      max-height: min(56rem, 60vh);
    }
  }

  .nx01-close__micro {
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--nx01-body));
  }
{% endstyle %}

{% schema %}
{
  "name": "NX-01 launch close",
  "tag": "section",
  "class": "section-nx01-close",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },
    { "type": "product", "id": "product", "label": "Product used for live price and availability" },
    { "type": "image_picker", "id": "image", "label": "Bottle image" },
    { "type": "text", "id": "image_alt", "label": "Bottle image alt text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NX-01 · Baseline" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop rebuilding the foundation every morning." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "9 actives. 3 capsules. One daily formula. Zero daily friction." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start with NX-01 Baseline" },
    { "type": "text", "id": "cta_href", "label": "Button link", "default": "#nx01-buy" },
    { "type": "text", "id": "microcopy", "label": "Microcopy", "default": "30-day supply · caffeine-free" }
  ],
  "presets": [
    { "name": "NX-01 launch close" }
  ]
}
{% endschema %}
