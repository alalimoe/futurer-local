{{ 'section-shop-the-look-hotspot.css' | asset_url | stylesheet_tag }}

{% liquid
  assign image = section.settings.image

  assign aspect_ratio = section.settings.aspect_ratio
  if aspect_ratio == 'custom'
    assign aspect_ratio = section.settings.aspect_ratio_width | append: '/' | append: section.settings.aspect_ratio_height
  endif
  assign point_size = section.settings.point_size
%}

<div {% render 'section-attr' %}>
  <div class="shop-the-look-hotspot">
    <xo-container class="shop-the-look-hotspot__container">
      <xo-grid style='--xs: 1; --md: 1; --lg: 2'>
        <div class="shop-the-look-hotspot__image">
          {% render 'image', image: image, aspect_ratio: aspect_ratio %}
          {% for block in section.blocks %}
            {% liquid
              assign top_dt = block.settings.top_dt
              assign top_mb = block.settings.top_mb
              assign left_dt = block.settings.left_dt
              assign left_mb = block.settings.left_mb
              assign color = block.settings.hotspot_color
              assign timer_delay = block.settings.timer_delay
            %}
            <div class="shop-the-look-hotspot__hotspot" style="--top_dt: {{ top_dt }}; --left_dt: {{ left_dt }}; --top_mb: {{ top_mb }}; --left_mb: {{ left_mb }}">
              <xo-carousel-trigger 
                class="shop-the-look-hotspot__point-container" 
                style="--size: {{ point_size }}rem; --color: {{ color }}; --delay: {{ timer_delay }}s"
                xo-index="{{ forloop.index0 }}"
                tabindex="0"
                role="button"
                aria-label="{{ 'accessibility.carousel_trigger' | t }}"
              >
                <div class="shop-the-look-hotspot__point shop-the-look-hotspot__point--1"></div>
                <div class="shop-the-look-hotspot__point shop-the-look-hotspot__point--2"></div>
                <div class="shop-the-look-hotspot__point shop-the-look-hotspot__point--3"></div>
              </xo-carousel-trigger>
            </div>
          {% endfor %}
        </div>
        <div class="shop-the-look-hotspot__products">
          <div class="shop-the-look-hotspot__header">
            {% render 'text', context: section %}
          </div>
          <xo-carousel 
            xo-per-view="1" 
            xo-type="slide" 
            class="shop-the-look-hotspot__carousel"  
            xo-render-bullet="<span class='shop-the-look-hotspot__bullet'></span>"
          >
            <xo-carousel-prev class="shop-the-look-hotspot__carousel-prev" >
              {% render 'button-slide', icon: 'arrow-left', icon_size: '2rem', size: '4rem', direction: 'left', style: 'dark' %}
            </xo-carousel-prev>
            <xo-carousel-next class="shop-the-look-hotspot__carousel-next" >
              {% render 'button-slide', icon: 'arrow-right', icon_size: '2rem', size: '4rem', direction: 'right', style: 'dark' %}
            </xo-carousel-next>
            <xo-carousel-inner>
              <xo-carousel-list>
                {% for block in section.blocks %}
                  <xo-carousel-slide>
                    <div class="shop-the-look-hotspot__item">
                      {% render 'product-card',
                        product: block.settings.product,
                        show_image: settings.product_card_show_image,
                        show_secondary_image: settings.product_card_show_secondary_image,
                        show_vendor: settings.product_card_show_vendor,
                        show_description: settings.product_card_show_description,
                        show_quick_add: settings.product_card_show_quick_add,
                        show_quick_view: settings.product_card_show_quick_view,
                        show_favorite: settings.product_card_show_favorite,
                        show_price: settings.product_card_show_price,
                        show_badge: false,
                        media_aspect_ratio: section.settings.product_card_aspect_ratio,
                        color_scheme: section.settings.card_color_scheme,
                        animate_enabled: false
                      %}
                    </div>
                  </xo-carousel-slide>
                {% endfor %}
              </xo-carousel-list>
            </xo-carousel-inner>
            <div class="shop-the-look-hotspot__carousel-pagination">
              <xo-carousel-pagination class="shop-the-look-hotspot__pagination"></xo-carousel-pagination>
            </div>
          </xo-carousel>
        </div>
      </xo-grid>
    </xo-container>
  </div>
</div>

