{%- style -%}
  .xo-section--{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .dubai-hero__media {
    position: absolute;
    inset: 0;
  }

  .xo-section--{{ section.id }} .dubai-hero__media .xo-image,
  .xo-section--{{ section.id }} .dubai-hero__media img {
    width: 100%;
    height: 100%;
  }

  .xo-section--{{ section.id }} .dubai-hero__media img {
    object-fit: cover;
  }

  .xo-section--{{ section.id }} .dubai-hero__overlay {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, rgba(var(--color-foreground)) 72%, transparent);
  }

  .xo-section--{{ section.id }} .dubai-hero__content {
    position: relative;
    z-index: 1;
    max-width: 88rem;
    margin: 0 auto;
    padding: clamp(7.2rem, 10vw, 12rem) 0 clamp(5.6rem, 8vw, 9.6rem);
    text-align: center;
  }

  .xo-section--{{ section.id }} .dubai-hero__breadcrumb {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 2.4rem;
    color: rgba(var(--color-background));
    font-size: 1.4rem;
  }

  .xo-section--{{ section.id }} .dubai-hero__breadcrumb a {
    color: inherit;
  }

  .xo-section--{{ section.id }} .dubai-hero__title {
    max-width: 84rem;
    margin: 0 auto 2rem;
    color: rgba(var(--color-background));
    font-size: clamp(4rem, 7vw, 8.3rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .xo-section--{{ section.id }} .dubai-hero__intro {
    max-width: 70rem;
    margin: 0 auto 3.2rem;
    color: rgba(var(--color-background));
    font-size: clamp(1.7rem, 2vw, 2rem);
    line-height: 1.6;
  }

  .xo-section--{{ section.id }} .dubai-hero__facts {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0 0 3.2rem;
    padding: 0;
    list-style: none;
  }

  .xo-section--{{ section.id }} .dubai-hero__fact {
    padding: 0.8rem 1.6rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-background)) 45%, transparent);
    border-radius: 10rem;
    background: color-mix(in srgb, rgba(var(--color-background)) 14%, transparent);
    color: rgba(var(--color-background));
    font-size: 1.4rem;
    font-weight: 600;
  }

  .xo-section--{{ section.id }} .dubai-hero__actions {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .xo-section--{{ section.id }} .dubai-hero__button {
    display: inline-flex;
    min-height: 4.8rem;
    align-items: center;
    justify-content: center;
    padding: 1.2rem 2.4rem;
    border: 1px solid rgba(var(--color-accent));
    border-radius: 10rem;
    background: rgba(var(--color-accent));
    color: rgba(var(--color-foreground));
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  .xo-section--{{ section.id }} .dubai-hero__button--secondary {
    border-color: rgba(var(--color-background));
    background: transparent;
    color: rgba(var(--color-background));
  }

  .xo-section--{{ section.id }} .dubai-hero__nav {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 14%, transparent);
    background: rgba(var(--color-background));
  }

  .xo-section--{{ section.id }} .dubai-hero__nav-list {
    display: flex;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 1rem var(--page-gap);
    gap: 0.4rem;
    overflow-x: auto;
    list-style: none;
  }

  .xo-section--{{ section.id }} .dubai-hero__nav-link {
    display: inline-flex;
    min-height: 4.4rem;
    align-items: center;
    padding: 0.8rem 1.6rem;
    border-radius: 10rem;
    color: rgba(var(--color-foreground));
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .xo-section--{{ section.id }} a:focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .xo-section--{{ section.id }} .dubai-hero__content {
      padding-inline: var(--page-gap-mobile);
    }

    .xo-section--{{ section.id }} .dubai-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .xo-section--{{ section.id }} .dubai-hero__nav-list {
      padding-inline: var(--page-gap-mobile);
    }
  }
{%- endstyle -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "{{ canonical_url }}#webpage",
      "url": {{ canonical_url | json }},
      "name": {{ section.settings.heading | json }},
      "description": {{ section.settings.intro | strip_html | json }},
      "inLanguage": "en",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "{{ shop.url }}#website",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}
      },
      "breadcrumb": {
        "@id": "{{ canonical_url }}#breadcrumb"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ canonical_url }}#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ section.settings.heading | json }},
          "item": {{ canonical_url | json }}
        }
      ]
    },
    {
      "@type": "LocalBusiness",
      "@id": "{{ shop.url }}#localbusiness",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Dubai",
        "addressCountry": "AE"
      },
      "areaServed": ["Dubai", "Abu Dhabi", "Sharjah", "Ajman", "UAE"],
      "description": "Dubai-based store for nootropics with free local UAE delivery and quality documentation where available."
    }
  ]
}
</script>

<section {% render 'section-attr', section: section %} aria-labelledby="dubai-hero-title-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <div class="dubai-hero__media" aria-hidden="true">
      {% render 'image', image: section.settings.image, lazyload: false, class: 'dubai-hero__image', disable_alt: true %}
    </div>
    <div class="dubai-hero__overlay"></div>
  {%- endif -%}
  <xo-container>
    <div class="dubai-hero__content">
      <nav class="dubai-hero__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ section.settings.breadcrumb_label }}</span>
      </nav>
      <h1 id="dubai-hero-title-{{ section.id }}" class="dubai-hero__title">{{ section.settings.heading }}</h1>
      <div class="dubai-hero__intro">{{ section.settings.intro }}</div>
      <ul class="dubai-hero__facts" aria-label="Shipping highlights">
        {%- for block in section.blocks -%}
          {%- if block.type == 'fact' -%}
            <li class="dubai-hero__fact" {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="dubai-hero__actions">
        {%- if section.settings.primary_label != blank and section.settings.primary_url != blank -%}
          <a class="dubai-hero__button" href="{{ section.settings.primary_url }}">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_url != blank -%}
          <a class="dubai-hero__button dubai-hero__button--secondary" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </xo-container>
  <nav class="dubai-hero__nav" aria-label="On this page">
    <ul class="dubai-hero__nav-list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'jump_link' -%}
          <li {{ block.shopify_attributes }}>
            <a class="dubai-hero__nav-link" href="{{ block.settings.anchor }}">{{ block.settings.label }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </nav>
</section>

{% schema %}
{
  "name": "Dubai hero",
  "tag": "section",
  "class": "section-dubai-hero",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb label", "default": "Nootropics Dubai" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nootropics Dubai" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Explore nootropics by goal with free local delivery across the UAE. Orders ship from our Dubai warehouse with 4-hour delivery in Dubai and next-day delivery across the Emirates.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop all nootropics" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Learn about nootropics" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Trust fact",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "jump_link",
      "name": "Jump link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "anchor", "label": "Anchor", "default": "#dubai-categories" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Dubai hero",
      "blocks": [
        { "type": "fact", "settings": { "text": "Ships from Dubai" } },
        { "type": "fact", "settings": { "text": "Free local UAE delivery" } },
        { "type": "fact", "settings": { "text": "4-hour Dubai delivery" } },
        { "type": "jump_link", "settings": { "label": "Categories", "anchor": "#dubai-categories" } },
        { "type": "jump_link", "settings": { "label": "Guide", "anchor": "#dubai-guide" } },
        { "type": "jump_link", "settings": { "label": "Delivery", "anchor": "#dubai-delivery" } },
        { "type": "jump_link", "settings": { "label": "FAQ", "anchor": "#dubai-faq" } },
        { "type": "jump_link", "settings": { "label": "بالعربي", "anchor": "#dubai-arabic" } }
      ]
    }
  ]
}
{% endschema %}
