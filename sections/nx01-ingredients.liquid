{%- liquid
  assign heading_id = 'npx-ingredients-title-' | append: section.id
  assign serving_id = 'npx-ingredients-serving-' | append: section.id
  assign allowed_keys = 'alcar,citicoline,nmn,l-theanine,rhodiola,coq10,b6,b12,folate' | split: ','
  assign card_count = 0
  for block in section.blocks
    if block.type == 'ingredient'
      if block.settings.name != blank or block.settings.description != blank
        assign card_count = card_count | plus: 1
      endif
    endif
  endfor
-%}

<section
  id="nx01-ingredients-{{ section.id }}"
  class="npx-ing"
  style="--npx-ing-bg: {{ section.settings.background_color }}; --npx-ing-card: {{ section.settings.card_color }}; --npx-ing-title: {{ section.settings.heading_color }}; --npx-ing-text: {{ section.settings.text_color }}; --npx-ing-muted: {{ section.settings.muted_color }}; --npx-ing-accent: {{ section.settings.accent_color }}; --npx-ing-badge: {{ section.settings.badge_color }}; --npx-ing-max: 1360px; --npx-ing-cols: {{ section.settings.columns }}; --npx-ing-gap: 24px; --npx-ing-pad: 28px; --npx-ing-radius: 16px; --npx-ing-image: 144px; --npx-ing-heading-size: 42px; --npx-ing-body-size: 16px; --npx-ing-top: {{ section.settings.padding_top }}px; --npx-ing-bottom: {{ section.settings.padding_bottom }}px;"
  role="region"
  aria-labelledby="{{ heading_id }}"
>
  <div class="npx-ing__inner">
    <header class="npx-ing__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="npx-ing__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="npx-ing__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
      {%- else -%}
        <h2 class="npx-ing__heading xo-visually-hidden" id="{{ heading_id }}">
          {{ 'sections.nx01_ingredients.region_label' | t }}
        </h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="npx-ing__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
      {%- if section.settings.serving != blank -%}
        <p class="npx-ing__serving" id="{{ serving_id }}">{{ section.settings.serving | escape }}</p>
      {%- endif -%}
    </header>

    {%- if card_count > 0 -%}
      <ul
        class="npx-ing__grid"
        role="list"
        {% if section.settings.serving != blank %}
          aria-describedby="{{ serving_id }}"
        {% endif %}
      >
        {%- for block in section.blocks -%}
          {%- if block.type == 'ingredient' -%}
            {%- if block.settings.name != blank or block.settings.description != blank -%}
              {%- liquid
                assign card_image = block.settings.image
                assign fallback_key = block.settings.fallback_key
                assign fallback_ok = false
                for key in allowed_keys
                  if key == fallback_key
                    assign fallback_ok = true
                  endif
                endfor
                assign has_card_image = false
                if card_image != blank
                  assign has_card_image = true
                elsif fallback_ok
                  assign has_card_image = true
                  assign fallback_file = 'nx01-ing-' | append: fallback_key | append: '.webp'
                endif
              -%}
              <li
                class="npx-ing__card"
                {{ block.shopify_attributes }}
              >
                {%- if has_card_image -%}
                  <div class="npx-ing__media" aria-hidden="true">
                    {%- if card_image != blank -%}
                      {{
                        card_image
                        | image_url: width: 600
                        | image_tag:
                          class: 'npx-ing__image',
                          loading: 'lazy',
                          widths: '200, 300, 400, 600',
                          sizes: '144px',
                          alt: '',
                          width: card_image.width,
                          height: card_image.height,
                          decoding: 'async'
                      }}
                    {%- else -%}
                      <img
                        src="{{ fallback_file | asset_url }}"
                        class="npx-ing__image"
                        alt=""
                        width="600"
                        height="600"
                        loading="lazy"
                        decoding="async"
                      >
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <div class="npx-ing__card-head{% if has_card_image %} npx-ing__card-head--image{% endif %}">
                  {%- if block.settings.category != blank -%}
                    <p class="npx-ing__category">{{ block.settings.category | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.name != blank -%}
                    <h3 class="npx-ing__name">{{ block.settings.name | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.form != blank -%}
                    <p class="npx-ing__form">{{ block.settings.form | escape }}</p>
                  {%- endif -%}
                </div>
                {%- if block.settings.amount != blank -%}
                  <p class="npx-ing__amount">{{ block.settings.amount | escape }}</p>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <div class="npx-ing__description">{{ block.settings.description }}</div>
                {%- endif -%}
                {%- if block.settings.tag_1 != blank or block.settings.tag_2 != blank -%}
                  <ul class="npx-ing__tags" role="list">
                    {%- if block.settings.tag_1 != blank -%}
                      <li class="npx-ing__tag">
                        <svg class="npx-ing__check" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                          <path d="m4 10 4 4 8-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>{{ block.settings.tag_1 | escape }}</span>
                      </li>
                    {%- endif -%}
                    {%- if block.settings.tag_2 != blank -%}
                      <li class="npx-ing__tag">
                        <svg class="npx-ing__check" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
                          <path d="m4 10 4 4 8-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span>{{ block.settings.tag_2 | escape }}</span>
                      </li>
                    {%- endif -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.evidence != blank -%}
      <footer class="npx-ing__footer">
        <div class="npx-ing__evidence">{{ section.settings.evidence }}</div>
      </footer>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .npx-ing {
    background: var(--npx-ing-bg);
    color: var(--npx-ing-text);
    padding-block: var(--npx-ing-top) var(--npx-ing-bottom);
    padding-inline: 24px;
    font-family: var(--font-body-family, Arial, sans-serif);
    font-size: var(--npx-ing-body-size);
    line-height: 1.6;
  }

  .npx-ing *,
  .npx-ing *::before,
  .npx-ing *::after {
    box-sizing: border-box;
  }

  .npx-ing .npx-ing__inner {
    max-width: var(--npx-ing-max);
    margin-inline: auto;
  }

  .npx-ing .npx-ing__header {
    max-width: 790px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .npx-ing .npx-ing__eyebrow {
    margin: 0 0 12px;
    color: var(--npx-ing-accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    line-height: 1.5;
  }

  .npx-ing .npx-ing__heading {
    margin: 0;
    color: var(--npx-ing-title);
    font-family: var(--font-heading-family, var(--font-body-family, Arial, sans-serif));
    font-size: clamp(28px, 3vw, var(--npx-ing-heading-size));
    font-style: normal;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.15;
    text-transform: none;
    overflow-wrap: anywhere;
  }

  .npx-ing .npx-ing__intro {
    max-width: 720px;
    margin: 18px auto 0;
    font-size: 17px;
    line-height: 1.7;
  }

  .npx-ing .npx-ing__intro p {
    margin: 0;
  }

  .npx-ing .npx-ing__serving {
    display: inline-block;
    margin: 20px 0 0;
    padding: 7px 14px;
    border: 1px solid var(--npx-ing-badge);
    border-radius: 999px;
    color: var(--npx-ing-accent);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
  }

  .npx-ing .npx-ing__grid {
    display: grid;
    grid-template-columns: repeat(var(--npx-ing-cols), minmax(0, 1fr));
    gap: var(--npx-ing-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .npx-ing .npx-ing__card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    padding: var(--npx-ing-pad);
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--npx-ing-radius);
    background: var(--npx-ing-card);
    text-align: start;
  }

  .npx-ing .npx-ing__media {
    position: absolute;
    z-index: -1;
    inset-block-start: -10px;
    inset-inline-end: -10px;
    width: var(--npx-ing-image);
    aspect-ratio: 1;
    overflow: hidden;
    pointer-events: none;
    opacity: 0.95;
    mix-blend-mode: multiply;
    border-end-start-radius: 70%;
    -webkit-mask-image: linear-gradient(135deg, transparent 6%, #000 48%);
    mask-image: linear-gradient(135deg, transparent 6%, #000 48%);
  }

  .npx-ing .npx-ing__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .npx-ing .npx-ing__card-head {
    min-width: 0;
    min-height: 91px;
  }

  .npx-ing .npx-ing__card-head--image {
    padding-inline-end: calc(var(--npx-ing-image) * 0.55);
  }

  .npx-ing .npx-ing__category {
    margin: 0 0 9px;
    color: var(--npx-ing-muted);
    font-size: 10px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .npx-ing .npx-ing__name {
    margin: 0;
    color: var(--npx-ing-title);
    font-family: var(--font-heading-family, var(--font-body-family, Arial, sans-serif));
    font-size: 23px;
    font-weight: 600;
    line-height: 1.24;
    letter-spacing: -0.025em;
    text-transform: none;
    overflow-wrap: anywhere;
  }

  .npx-ing .npx-ing__form {
    margin: 7px 0 0;
    color: var(--npx-ing-muted);
    font-size: 12px;
    line-height: 1.55;
    overflow-wrap: anywhere;
  }

  .npx-ing .npx-ing__amount {
    align-self: flex-start;
    margin: 17px 0 0;
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--npx-ing-badge);
    color: var(--npx-ing-accent);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }

  .npx-ing .npx-ing__description {
    margin-block: 18px 24px;
    color: var(--npx-ing-text);
    font-size: var(--npx-ing-body-size);
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .npx-ing .npx-ing__description p {
    margin: 0;
  }

  .npx-ing .npx-ing__description p + p {
    margin-top: 0.75em;
  }

  .npx-ing .npx-ing__description a,
  .npx-ing .npx-ing__evidence a {
    color: var(--npx-ing-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .npx-ing .npx-ing__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    list-style: none;
    margin: auto 0 0;
    padding: 16px 0 0;
    border-block-start: 1px solid var(--npx-ing-badge);
  }

  .npx-ing .npx-ing__tag {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin: 0;
    padding: 0;
    color: var(--npx-ing-text);
    font-size: 11px;
    line-height: 1.5;
  }

  .npx-ing .npx-ing__tag span {
    overflow-wrap: anywhere;
  }

  .npx-ing .npx-ing__check {
    flex: 0 0 16px;
    margin-block-start: 0;
    color: var(--npx-ing-accent);
  }

  .npx-ing .npx-ing__footer {
    max-width: 890px;
    margin: 30px auto 0;
    text-align: center;
  }

  .npx-ing .npx-ing__evidence {
    color: var(--npx-ing-muted);
    font-size: 12px;
    line-height: 1.7;
  }

  .npx-ing .npx-ing__evidence p {
    margin: 0;
  }

  .npx-ing a:focus-visible {
    outline: 2px solid var(--npx-ing-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (max-width: 1100px) {
    .npx-ing .npx-ing__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .npx-ing {
      padding-inline: 18px;
      padding-block: min(var(--npx-ing-top), 48px) min(var(--npx-ing-bottom), 44px);
    }

    .npx-ing .npx-ing__header {
      margin-bottom: 28px;
    }

    .npx-ing .npx-ing__heading {
      font-size: min(var(--npx-ing-heading-size), 32px);
    }

    .npx-ing .npx-ing__intro {
      margin-top: 14px;
      font-size: 15px;
    }

    .npx-ing .npx-ing__serving {
      font-size: 11px;
      padding-inline: 10px;
    }

    .npx-ing .npx-ing__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .npx-ing .npx-ing__card {
      padding: min(var(--npx-ing-pad), 24px);
    }

    .npx-ing .npx-ing__media {
      width: min(var(--npx-ing-image), 128px);
    }

    .npx-ing .npx-ing__card-head--image {
      padding-inline-end: 68px;
    }

    .npx-ing .npx-ing__card-head {
      min-height: 84px;
    }

    .npx-ing .npx-ing__name {
      font-size: 22px;
    }

    .npx-ing .npx-ing__description {
      margin-block: 16px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .npx-ing *,
    .npx-ing *::before,
    .npx-ing *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "NX-01 ingredients",
  "tag": "div",
  "class": "section-nx01-ingredients",
  "enabled_on": {
    "templates": ["product", "page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE NX-01 FORMULA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every ingredient. A clear purpose."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Meet the nine ingredients in NX-01 Baseline, from amino acids and a botanical extract to coenzymes and B vitamins.</p>"
    },
    {
      "type": "text",
      "id": "serving",
      "label": "Serving note",
      "default": "All amounts per daily serving · 3 capsules"
    },
    {
      "type": "richtext",
      "id": "evidence",
      "label": "Evidence note",
      "default": "<p>Ingredient roles describe general biology or areas of research. Studies on individual ingredients do not establish the effects of the finished NX-01 formula. DFE = dietary folate equivalents.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" }
      ],
      "default": "3"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#F6F7FA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#142449"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#394154"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#647084"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#2447A5"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge color",
      "default": "#E9EEF9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "fallback_key",
          "label": "Theme image",
          "info": "Used when no image is uploaded.",
          "options": [
            { "value": "alcar", "label": "ALCAR" },
            { "value": "citicoline", "label": "Citicoline" },
            { "value": "nmn", "label": "NMN" },
            { "value": "l-theanine", "label": "L-Theanine" },
            { "value": "rhodiola", "label": "Rhodiola rosea" },
            { "value": "coq10", "label": "CoQ10" },
            { "value": "b6", "label": "Vitamin B6" },
            { "value": "b12", "label": "Vitamin B12" },
            { "value": "folate", "label": "Folate" }
          ],
          "default": "alcar"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "form",
          "label": "Form"
        },
        {
          "type": "text",
          "id": "amount",
          "label": "Amount"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "tag_1",
          "label": "Tag 1"
        },
        {
          "type": "text",
          "id": "tag_2",
          "label": "Tag 2"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "NX-01 ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "fallback_key": "alcar",
            "category": "Carnitine",
            "name": "ALCAR",
            "form": "Acetyl-L-carnitine",
            "amount": "500 mg",
            "description": "<p>An acetylated form of carnitine. Carnitine helps transport fatty acids into mitochondria, where cells use them to produce energy.</p>",
            "tag_1": "Acetylated form",
            "tag_2": "Energy metabolism"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "fallback_key": "citicoline",
            "category": "Choline compound",
            "name": "Citicoline",
            "form": "CDP-Choline",
            "amount": "250 mg",
            "description": "<p>Provides choline, which the body uses to make cell membranes and acetylcholine, a messenger involved in communication between nerve cells.</p>",
            "tag_1": "Choline source",
            "tag_2": "Cell membranes"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "fallback_key": "nmn",
            "category": "NAD+ precursor",
            "name": "NMN",
            "form": "Nicotinamide mononucleotide",
            "amount": "250 mg",
            "description": "<p>A building block for NAD+, a coenzyme involved in cellular metabolism. NAD+ helps cells carry out reactions that release energy from nutrients.</p>",
            "tag_1": "NAD+ precursor",
            "tag_2": "Cell metabolism"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "fallback_key": "l-theanine",
            "category": "Amino acid",
            "name": "L-Theanine",
            "form": "Amino acid",
            "amount": "200 mg",
            "description": "<p>An amino acid studied for relaxation, stress-related symptoms and aspects of cognitive function. Included as the formula’s ingredient for a calmer daily routine.</p>",
            "tag_1": "Amino acid",
            "tag_2": "Relaxation research"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "fallback_key": "rhodiola",
            "category": "Botanical extract",
            "name": "Rhodiola rosea",
            "form": "Root extract",
            "amount": "200 mg",
            "description": "<p>A plant that grows in cold, mountainous regions. Its extracts have been studied for fatigue and performance under stress; human evidence remains limited.</p>",
            "tag_1": "Botanical extract",
            "tag_2": "Stress research"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "fallback_key": "coq10",
            "category": "Coenzyme",
            "name": "CoQ10",
            "form": "Ubiquinol",
            "amount": "100 mg",
            "description": "<p>A coenzyme found throughout the body and involved in cellular energy production. Ubiquinol is the reduced form of CoQ10.</p>",
            "tag_1": "Coenzyme",
            "tag_2": "Energy pathways"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "fallback_key": "b6",
            "category": "B vitamin",
            "name": "Vitamin B6",
            "form": "Pyridoxal-5-phosphate (P-5-P)",
            "amount": "5 mg",
            "description": "<p>Supplied as P-5-P, a coenzyme form of vitamin B6. B6 participates in amino acid metabolism and the production of neurotransmitters.</p>",
            "tag_1": "P-5-P form",
            "tag_2": "Neurotransmitter synthesis"
          }
        },
        {
          "type": "ingredient",
          "settings": {
