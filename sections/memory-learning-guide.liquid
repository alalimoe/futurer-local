{%- liquid
  assign s = section.settings
  assign memory_collection = collections['memory-learning']
  if memory_collection == blank
    assign memory_collection = collections['nootropics']
  endif
  assign memory_href = routes.all_products_collection_url
  if memory_collection != blank
    assign memory_href = memory_collection.url
  endif

  comment
    Legacy handle settings remain for compatibility but are not resolved.
    Only merchant-selected, currently available product objects are displayed.
  endcomment
  assign memory_count = 0
  assign memory_seen = ''
-%}

{%- style -%}
  #memory-guide-{{ section.id }} {
    background: {{ s.background_color | default: '#ffffff' }};
    color: rgba(var(--color-foreground));
  }
  #memory-guide-{{ section.id }} .ml-inner {
    max-width: {{ s.max_width | default: 1180 }}px;
    margin: 0 auto;
    padding: {{ s.padding_y | default: 56 }}px var(--page-gutter);
  }
  #memory-guide-{{ section.id }} .ml-hero,
  #memory-guide-{{ section.id }} .ml-panel {
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
    margin-bottom: 1.5rem;
  }
  #memory-guide-{{ section.id }} .ml-hero { background: rgba(var(--color-background-2)); }
  #memory-guide-{{ section.id }} h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
  }
  #memory-guide-{{ section.id }} h2 { margin: 0 0 0.75rem; }
  #memory-guide-{{ section.id }} p,
  #memory-guide-{{ section.id }} li { line-height: 1.7; }
  #memory-guide-{{ section.id }} .ml-muted {
    color: color-mix(in srgb, rgba(var(--color-foreground)) 68%, transparent);
  }
  #memory-guide-{{ section.id }} .ml-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  #memory-guide-{{ section.id }} .ml-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    border-radius: var(--general-radius-1, 1rem);
  }
  #memory-guide-{{ section.id }} .ml-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }
  #memory-guide-{{ section.id }} .ml-card a,
  #memory-guide-{{ section.id }} .ml-collection-link {
    margin-top: auto;
    color: rgba(var(--color-foreground));
    font-weight: 600;
    text-underline-offset: 0.25em;
  }
  #memory-guide-{{ section.id }} details {
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 12%, transparent);
    padding: 0.8rem 0;
  }
  #memory-guide-{{ section.id }} summary { cursor: pointer; font-weight: 600; }
  #memory-guide-{{ section.id }} :focus-visible {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }
{%- endstyle -%}

<section id="memory-guide-{{ section.id }}" aria-labelledby="memory-title-{{ section.id }}">
  <div class="ml-inner">
    <header class="ml-hero">
      <h1 id="memory-title-{{ section.id }}">{{ s.hero_title | default: 'Memory & Learning: An Evidence-Aware Guide' }}</h1>
      <p class="ml-muted">{{ s.hero_subtitle | default: 'Separate reliable learning practices from uncertain supplement claims, then review labels and safety context before considering a product.' }}</p>
    </header>

    {% render 'guide-editorial-review' %}

    <section class="ml-panel" aria-labelledby="memory-foundations-{{ section.id }}">
      <h2 id="memory-foundations-{{ section.id }}">Start with learning conditions</h2>
      <p>Active recall, spaced practice, adequate sleep opportunity, and reduced distraction have clearer practical roles in learning than any universal supplement routine. Sleep loss can impair attention and consolidation, and a product should not be used to justify an all-nighter.</p>
    </section>

    <section class="ml-panel" aria-labelledby="memory-evidence-{{ section.id }}">
      <h2 id="memory-evidence-{{ section.id }}">Evidence limits</h2>
      <ul>
        <li>Research may involve a different dose, formulation, population, or outcome than the product being viewed.</li>
        <li>A change in alertness is not the same as improved learning, retention, or recall.</li>
        <li>Mechanistic, animal, or anecdotal findings do not establish a benefit in healthy learners.</li>
        <li>Racetam evidence, regulation, and product status vary; this guide does not establish legality or suitability.</li>
      </ul>
    </section>

    <section class="ml-panel" aria-labelledby="memory-safety-{{ section.id }}">
      <h2 id="memory-safety-{{ section.id }}">Contraindication and interaction cues</h2>
      <p>Ask a qualified healthcare professional or pharmacist before use if you take medication, manage a health condition, are pregnant or nursing, are under 18, or are considering a compound with uncertain local status. Consider stimulant exposure, sleep effects, mood or anxiety symptoms, and current sport rules.</p>
      <p><strong>No stack, dose, timing plan, or cycle is prescribed here. The current product label takes precedence.</strong></p>
    </section>

    <section class="ml-panel" aria-labelledby="memory-products-{{ section.id }}">
      <h2 id="memory-products-{{ section.id }}">Merchant-selected product references</h2>
      <p class="ml-muted">Only selected products that currently resolve as available are shown. Titles, prices, labels, warnings, and availability come from the live product object.</p>
      <div class="ml-grid">
        {%- assign memory_product = s.cdp_product -%}
        {%- if memory_product != blank and memory_product.available -%}
          {%- assign memory_count = memory_count | plus: 1 -%}
          {%- assign memory_seen = memory_seen | append: '|' | append: memory_product.id | append: '|' -%}
          <article class="ml-card">
            {%- if memory_product.featured_image -%}{{ memory_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: memory_product.title }}{%- endif -%}
            <h3>{{ memory_product.title }}</h3>
            <p class="ml-muted">Review the exact formulation, warnings, and page-specific evidence.</p>
            <a href="{{ memory_product.url }}">Review product label</a>
          </article>
        {%- endif -%}

        {%- comment -%} Render the remaining picker slots explicitly to avoid title or handle fallbacks. {%- endcomment -%}
        {%- assign memory_product = s.racetam_product -%}
        {%- assign memory_token = '|' | append: memory_product.id | append: '|' -%}
        {%- if memory_product != blank and memory_product.available -%}
          {%- unless memory_seen contains memory_token -%}
            {%- assign memory_count = memory_count | plus: 1 -%}
            {%- assign memory_seen = memory_seen | append: memory_token -%}
            <article class="ml-card">
              {%- if memory_product.featured_image -%}{{ memory_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: memory_product.title }}{%- endif -%}
              <h3>{{ memory_product.title }}</h3>
              <p class="ml-muted">Check evidence limitations, local status, contraindications, and the current label.</p>
              <a href="{{ memory_product.url }}">Review product label</a>
            </article>
          {%- endunless -%}
        {%- endif -%}

        {%- assign memory_product = s.lion_product -%}
        {%- assign memory_token = '|' | append: memory_product.id | append: '|' -%}
        {%- if memory_product != blank and memory_product.available -%}
          {%- unless memory_seen contains memory_token -%}
            {%- assign memory_count = memory_count | plus: 1 -%}
            {%- assign memory_seen = memory_seen | append: memory_token -%}
            <article class="ml-card">
              {%- if memory_product.featured_image -%}{{ memory_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: memory_product.title }}{%- endif -%}
              <h3>{{ memory_product.title }}</h3>
              <p class="ml-muted">Do not infer a memory outcome from the ingredient name; review the exact product and evidence.</p>
              <a href="{{ memory_product.url }}">Review product label</a>
            </article>
          {%- endunless -%}
        {%- endif -%}

        {%- assign memory_product = s.alpha_product -%}
        {%- assign memory_token = '|' | append: memory_product.id | append: '|' -%}
        {%- if memory_product != blank and memory_product.available -%}
          {%- unless memory_seen contains memory_token -%}
            {%- assign memory_count = memory_count | plus: 1 -%}
            {%- assign memory_seen = memory_seen | append: memory_token -%}
            <article class="ml-card">
              {%- if memory_product.featured_image -%}{{ memory_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: memory_product.title }}{%- endif -%}
              <h3>{{ memory_product.title }}</h3>
              <p class="ml-muted">Review total ingredient exposure and interaction questions on the current label.</p>
              <a href="{{ memory_product.url }}">Review product label</a>
            </article>
          {%- endunless -%}
        {%- endif -%}

        {%- assign memory_product = s.anira_product -%}
        {%- assign memory_token = '|' | append: memory_product.id | append: '|' -%}
        {%- if memory_product != blank and memory_product.available -%}
          {%- unless memory_seen contains memory_token -%}
            {%- assign memory_count = memory_count | plus: 1 -%}
            {%- assign memory_seen = memory_seen | append: memory_token -%}
            <article class="ml-card">
              {%- if memory_product.featured_image -%}{{ memory_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: memory_product.title }}{%- endif -%}
              <h3>{{ memory_product.title }}</h3>
              <p class="ml-muted">Check current local status, evidence limitations, and label warnings.</p>
              <a href="{{ memory_product.url }}">Review product label</a>
            </article>
          {%- endunless -%}
        {%- endif -%}

        {%- assign memory_product = s.bacopa_product -%}
        {%- assign memory_token = '|' | append: memory_product.id | append: '|' -%}
        {%- if memory_product != blank and memory_product.available -%}
          {%- unless memory_seen contains memory_token -%}
            {%- assign memory_count = memory_count | plus: 1 -%}
            <article class="ml-card">
              {%- if memory_product.featured_image -%}{{ memory_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: memory_product.title }}{%- endif -%}
              <h3>{{ memory_product.title }}</h3>
              <p class="ml-muted">Compare the exact extract and formulation with the cited evidence and current label.</p>
              <a href="{{ memory_product.url }}">Review product label</a>
            </article>
          {%- endunless -%}
        {%- endif -%}
      </div>
      {%- if memory_count == 0 -%}
        <p><a class="ml-collection-link" href="{{ memory_href }}">Browse the current nootropics collection</a></p>
      {%- endif -%}
    </section>

    {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
    {%- if faq_blocks.size > 0 -%}
      <section class="ml-panel" aria-labelledby="memory-faq-{{ section.id }}">
        <h2 id="memory-faq-{{ section.id }}">Frequently asked questions</h2>
        {%- for block in faq_blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.q }}</summary>
            <p>{{ block.settings.a }}</p>
          </details>
        {%- endfor -%}
      </section>
    {%- endif -%}

    <p class="ml-muted">Educational information only; not medical advice and not intended to diagnose, treat, cure, or prevent disease.</p>
  </div>
</section>

{% schema %}
{
  "name": "Memory & Learning Guide",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_title", "label": "Hero title", "default": "Memory & Learning: An Evidence-Aware Guide" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Hero subtitle", "default": "Separate reliable learning practices from uncertain supplement claims, then review labels and safety context before considering a product." },
    { "type": "image_picker", "id": "hero_image", "label": "Legacy hero image (not displayed)" },
    { "type": "header", "content": "Primary product references" },
    { "type": "product", "id": "cdp_product", "label": "Product reference 1" },
    { "type": "text", "id": "cdp_handle", "label": "Legacy backup handle (not used)" },
    { "type": "product", "id": "racetam_product", "label": "Product reference 2" },
    { "type": "text", "id": "racetam_handle", "label": "Legacy backup handle (not used)" },
    { "type": "text", "id": "racetam_title", "label": "Legacy title override (not used)" },
    { "type": "product", "id": "lion_product", "label": "Product reference 3" },
    { "type": "text", "id": "lion_handle", "label": "Legacy backup handle (not used)" },
    { "type": "header", "content": "Alternative product references" },
    { "type": "product", "id": "alpha_product", "label": "Product reference 4" },
    { "type": "text", "id": "alpha_handle", "label": "Legacy backup handle (not used)" },
    { "type": "product", "id": "anira_product", "label": "Product reference 5" },
    { "type": "text", "id": "anira_handle", "label": "Legacy backup handle (not used)" },
    { "type": "product", "id": "bacopa_product", "label": "Product reference 6" },
    { "type": "text", "id": "bacopa_handle", "label": "Legacy backup handle (not used)" },
    { "type": "header", "content": "Legacy alternative product" },
    { "type": "product", "id": "alt_stack_product", "label": "Optional product reference" },
    { "type": "text", "id": "alt_stack_handle", "label": "Legacy backup handle (not used)" },
    { "type": "text", "id": "alt_stack_title", "label": "Legacy title (not used)" },
    { "type": "textarea", "id": "alt_stack_blurb", "label": "Legacy description (not used)" },
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 800, "max": 1400, "step": 20, "default": 1180 },
    { "type": "range", "id": "padding_y", "label": "Vertical padding (px)", "min": 32, "max": 120, "step": 4, "default": 56 },
    { "type": "header", "content": "Legacy SEO" },
    { "type": "text", "id": "date_published", "label": "Legacy date (not used)", "info": "Use page custom.last_reviewed for a genuine review date." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "q", "label": "Question", "default": "Does alertness prove better learning?" },
        { "type": "textarea", "id": "a", "label": "Answer", "default": "No. Feeling more alert is not the same as improved encoding, consolidation, retention, or recall." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "Memory & Learning Guide", "category": "Nootropix Guides" }
  ]
}
{% endschema %}
