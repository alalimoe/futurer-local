{% render 'compound-guide-css' %}

{%- liquid
  assign cg_anchor = section.settings.anchor_id | default: 'compound-close' | handleize
  assign image = blank
  if section.settings.show_image
    assign image = section.settings.image
    if image == blank and section.settings.fallback_product != blank
      assign image = section.settings.fallback_product.featured_image
    endif
  endif
  assign image_alt = section.settings.image_alt | default: section.settings.heading
  assign show_primary = false
  if section.settings.primary_label != blank and section.settings.primary_href != blank
    assign show_primary = true
  endif
  assign show_secondary = false
  if section.settings.secondary_label != blank and section.settings.secondary_href != blank
    assign show_secondary = true
  endif
  assign guide_count = 0
  for block in section.blocks
    if block.type == 'guide' and block.settings.title != blank and block.settings.href != blank
      assign guide_count = guide_count | plus: 1
    endif
  endfor
-%}

{%- if section.settings.heading != blank -%}
{%- liquid
  assign extra_classes = ''
  if image == blank
    assign extra_classes = 'cg-close--strip'
  endif
-%}
<section
  id="{{ cg_anchor }}"
  {% render 'compound-section-attrs', section: section, base: 'cg-close', default_tone: 'dark', extra: extra_classes %}
  aria-labelledby="cg-close-heading-{{ section.id }}"
>
  <div class="cg__inner">
    <div class="cg-close__stage{% if section.settings.media_position == 'left' %} cg-close__stage--media-left{% endif %}">
      <div class="cg-close__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cg__kicker">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="cg__heading" id="cg-close-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="cg__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if show_primary or show_secondary -%}
          <div class="cg-close__actions">
            {%- if show_primary -%}
              {% render 'button', style: 'primary', text: section.settings.primary_label, link: section.settings.primary_href, attrs: 'data-cg-keep-filters' %}
            {%- endif -%}
            {%- if show_secondary -%}
              {% render 'button', style: 'secondary', text: section.settings.secondary_label, link: section.settings.secondary_href %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if image != blank -%}
        <div class="cg-close__media">
          {{
            image
            | image_url: width: 1200
            | image_tag:
              widths: '360, 540, 720, 960, 1200',
              sizes: '(max-width: 767px) 88vw, 42vw',
              alt: image_alt,
              width: image.width,
              height: image.height,
              loading: 'lazy',
              decoding: 'async'
          }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_guides and guide_count > 0 -%}
      <ul class="cg-close__guides"{% if section.settings.guides_columns != blank and section.settings.guides_columns != '3' %} style="--cg-close-cols: {{ section.settings.guides_columns }};"{% endif %}>
        {%- for block in section.blocks -%}
          {%- if block.type == 'guide' and block.settings.title != blank and block.settings.href != blank -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ block.settings.href }}" data-mark="{{ block.settings.mark | default: 'guide' }}">
                <span class="cg-close__mark" aria-hidden="true"></span>
                <h3>{{ block.settings.title | escape }}</h3>
                {%- if block.settings.body != blank -%}
                  <p>{{ block.settings.body | escape }}</p>
                {%- endif -%}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Compound close",
  "tag": "section",
  "class": "section-compound-close",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "compound-close" },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Next" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your next step." },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "View products" },
    { "type": "text", "id": "primary_href", "label": "Primary button link", "default": "#compound-products" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Review safety information" },
    { "type": "text", "id": "secondary_href", "label": "Secondary button link", "default": "#safety" },
    { "type": "checkbox", "id": "show_image", "label": "Show product image", "default": false, "info": "Off keeps the close as a compact decision strip. The hero already shows the product." },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "product", "id": "fallback_product", "label": "Fallback product image" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "media_position", "label": "Image position (desktop)", "options": [
      { "value": "right", "label": "Right" },
      { "value": "left", "label": "Left" }
    ], "default": "right", "info": "Applies when the product image is shown." },
    { "type": "checkbox", "id": "show_guides", "label": "Show related guide cards", "default": true },
    { "type": "select", "id": "guides_columns", "label": "Guide cards per row (desktop)", "options": [
      { "value": "2", "label": "2" },
      { "value": "3", "label": "3" },
      { "value": "4", "label": "4" }
    ], "default": "3" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [
      { "value": "small", "label": "Small" },
      { "value": "default", "label": "Default" },
      { "value": "large", "label": "Large" }
    ], "default": "default" },
    { "type": "select", "id": "content_width", "label": "Content width", "options": [
      { "value": "narrow", "label": "Narrow" },
      { "value": "default", "label": "Default" },
      { "value": "wide", "label": "Wide" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "info": "Scales the responsive section spacing. 100% is the theme default." },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "text", "id": "custom_class", "label": "Custom CSS class", "info": "Optional hook for bespoke styling." }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Related guide",
      "settings": [
        { "type": "select", "id": "mark", "label": "Mark", "options": [
          { "value": "guide", "label": "Guide" },
          { "value": "collection", "label": "Collection" },
          { "value": "quality", "label": "Quality" },
          { "value": "help", "label": "Help" }
        ], "default": "guide" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "body", "label": "One-line explanation" },
        { "type": "url", "id": "href", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Compound close" }]
}
{% endschema %}
