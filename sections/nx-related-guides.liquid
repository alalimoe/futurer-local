{%- style -%}
.xo-section--{{ section.id }} xo-animate { display: block; }
  .xo-section--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .xo-section--{{ section.id }} .rg__title {
    font-size: clamp(2.8rem, 3.4vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: rgba(var(--color-foreground));
    margin: 0 0 2.4rem;
  }

  .xo-section--{{ section.id }} .rg__grid {
    display: flex;
    flex-direction: column;
    border-top: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
  }

  .xo-section--{{ section.id }} .rg__card {
    position: relative;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
    border-radius: 0;
    padding: 2.4rem 0;
  }

  .xo-section--{{ section.id }} .rg__card:hover {
    border-color: color-mix(in srgb, rgba(var(--color-foreground)) 10%, transparent);
    transform: none;
  }

  .xo-section--{{ section.id }} .rg__card h3 {
    font-size: 1.8rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
    color: rgba(var(--color-foreground));
  }

  .xo-section--{{ section.id }} .rg__card a {
    text-decoration: none;
    color: inherit;
  }

  /* Stretched link: the whole card is the click target */
  .xo-section--{{ section.id }} .rg__card a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .xo-section--{{ section.id }} .rg__card a:focus-visible {
    outline: none;
  }

  .xo-section--{{ section.id }} .rg__card:has(a:focus-visible) {
    outline: 2px solid rgba(var(--color-accent));
    outline-offset: 2px;
  }

  .xo-section--{{ section.id }} .rg__card p {
    font-size: calc(var(--font-body-scale, 1) * 1.4rem);
    color: color-mix(in srgb, rgba(var(--color-foreground)) 75%, transparent);
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 768px) {
    .xo-section--{{ section.id }} .rg__grid {
      display: flex;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xo-section--{{ section.id }} .rg__card {
      transition: none;
    }
  }
{%- endstyle -%}

{%- liquid
  assign locale_code = request.locale.iso_code | default: shop.locale | downcase
  assign language_code = locale_code | split: '-' | first
  assign is_arabic = false
  if language_code == 'ar'
    assign is_arabic = true
  endif

  assign heading = section.settings.heading
  if is_arabic
    assign heading = section.settings.heading_ar | default: heading
  endif

  assign visible_guide_count = 0
  for block in section.blocks
    assign guide_title = block.settings.title
    if is_arabic
      assign guide_title = block.settings.title_ar | default: guide_title
    endif
    if block.settings.url != blank and guide_title != blank
      assign visible_guide_count = visible_guide_count | plus: 1
    endif
  endfor
-%}

{%- if visible_guide_count > 0 -%}
<section {% render 'section-attr', section: section %} aria-labelledby="rg-title-{{ section.id }}" lang="{{ locale_code }}">
  <xo-container>
    <xo-animate xo-type="fade-up">
      <h2 id="rg-title-{{ section.id }}" class="rg__title">{{ heading }}</h2>
    </xo-animate>
    <xo-animate xo-type="fade-up" xo-cascade class="rg__grid">
      {% for block in section.blocks %}
        {%- liquid
          assign guide_title = block.settings.title
          assign guide_desc = block.settings.desc
          if is_arabic
            assign guide_title = block.settings.title_ar | default: guide_title
            assign guide_desc = block.settings.desc_ar | default: guide_desc
          endif
        -%}
        {%- if block.settings.url != blank and guide_title != blank -%}
        <article class="rg__card" {{ block.shopify_attributes }}>
          <h3><a href="{{ block.settings.url }}">{{ guide_title }}</a></h3>
          {%- if guide_desc != blank -%}
            <p>{{ guide_desc }}</p>
          {%- endif -%}
        </article>
        {%- endif -%}
      {% endfor %}
    </xo-animate>
  </xo-container>
</section>
{%- endif -%}

{% schema %}
{
  "name": "NX — Related Guides",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "default" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Related Guides" },
    { "type": "text", "id": "heading_ar", "label": "Heading — Arabic" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 8 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 16 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Guide link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "url", "label": "URL" },
        { "type": "textarea", "id": "desc", "label": "Short description" },
        { "type": "text", "id": "title_ar", "label": "Title — Arabic" },
        { "type": "textarea", "id": "desc_ar", "label": "Short description — Arabic" }
      ]
    }
  ],
  "presets": [
    {
      "name": "NX — Related Guides",
      "blocks": [
        { "type": "link", "settings": { "title": "Piracetam vs Aniracetam", "url": "/blogs/posts/5-best-racetams", "desc": "Compare how the article describes the two compounds and its sources." } },
        { "type": "link", "settings": { "title": "Best Nootropics for Learning & Memory", "url": "/blogs/posts/best-nootropics-for-studying-guide", "desc": "Review labels, evidence limits and study foundations without assuming an outcome." } },
        { "type": "link", "settings": { "title": "The Science of Neuroplasticity", "url": "/blogs/posts/nootropics-101", "desc": "Read an introduction to the terminology and evidence boundaries." } }
      ]
    }
  ]
}
{% endschema %}
