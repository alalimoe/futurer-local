{%- unless template.name == 'product' and template.suffix == 'nx-01' -%}
{{ 'section-announcement-bar.css' | asset_url | stylesheet_tag }}
{{ 'announcement-text.css' | asset_url | stylesheet_tag }}
{{ 'countdown.css' | asset_url | stylesheet_tag }}

{% liquid
  assign announcement_bar_style = section.settings.announcement_style
  assign hide_button_close = section.settings.hide_button_close
  assign carousel_width = section.settings.carousel_width
  assign carousel_height = section.settings.carousel_height
  assign carousel_style = section.settings.carousel_style
  assign carousel_autoplay = section.settings.carousel_autoplay
  assign carousel_speed = section.settings.carousel_speed
  assign marquee_speed = section.settings.marquee_speed
  assign marquee_rtl = section.settings.marquee_rtl
  assign has_motion_control = false
  if announcement_bar_style == 'marquee'
    assign has_motion_control = true
  elsif announcement_bar_style == 'carousel' and carousel_autoplay
    assign has_motion_control = true
  endif
%}

{% if carousel_style == 'vertical' %}
  {% capture carousel_style %}
    xo-vertical
  {% endcapture %}
{% endif %}

{% if carousel_autoplay %}
  {% capture carousel_autoplay_time %}
    xo-autoplay="{{ carousel_speed }}"
  {% endcapture %}
{% endif %}

{% assign block_announcement_index = -1 %}
{% for block in section.blocks %}
  {% if block.type == 'announcement' %}
    {% assign block_announcement_index = forloop.index %}
    {% break %}
  {% endif %}
{% endfor %}

{% liquid
  assign show_weekend_promo = false
  if section.settings.enable_weekend_promo
    if section.settings.weekend_promo_code != blank and section.settings.weekend_discount_percent != blank
      if request.page_type == 'index' or request.page_type == 'collection' or request.page_type == 'product' or request.page_type == 'cart'
        assign show_weekend_promo = true
      endif
    endif
  endif
%}

<div
  class='xo-announcement-bar'
  id='xo-announcement-bar'
  data-announcement-motion
  data-carousel-autoplay='{% if carousel_autoplay %}true{% else %}false{% endif %}'
  data-carousel-speed='{{ carousel_speed }}'
>
  <section aria-label="{{ 'sections.header.announcement' | t }}" {% render 'section-attr' %}>
    <xo-animate xo-cascade xo-type='fade-down' class='xo-announcement-bar__body'>
      {% if show_weekend_promo %}
        {% liquid
          assign promo_message = 'general.weekend_promo.message' | t: percent: section.settings.weekend_discount_percent, code: section.settings.weekend_promo_code
        %}
        {% render 'announcement-weekend-promo', template: promo_message %}
      {% endif %}
      {% if announcement_bar_style != 'marquee' %}
        <xo-container class='xo-announcement-bar__container'>
      {% endif %}
      {% if announcement_bar_style == 'carousel' %}
        <div class='xo-announcement-bar__inline'>
          <div class='xo-announcement-bar__inner' style='--carousel-width: {{ carousel_width }}px; order: {{ block_announcement_index }}'>
            <xo-carousel
              xo-loop
              xo-per-view='1'
              class='xo-announcement-bar__carousel'
              aria-label="{{ 'sections.slideshow.carousel' | t }}"
              {{ carousel_style }}
              {{ carousel_autoplay_time }}
            >
              <xo-carousel-inner class='xo-announcement-bar__carousel-inner' style='--height-vertical: {{ carousel_height }}px'>
                <xo-carousel-list>
                  {% for block in section.blocks %}
                    {% case block.type %}
                      {% when 'announcement' %}
                        <xo-carousel-slide>
                          {% render 'announcement-text', block: block, announcement_bar_style: announcement_bar_style %}
                        </xo-carousel-slide>
                    {% endcase %}
                  {% endfor %}
                </xo-carousel-list>
              </xo-carousel-inner>
              <xo-carousel-prev class='xo-announcement-bar__prev'>
                <button type='button' class='xo-announcement-bar__nav-button' aria-label="{{ 'accessibility.previous' | t }}">
                  {% render 'icon', name: 'arrow-left', size: 24 %}
                </button>
              </xo-carousel-prev>
              <xo-carousel-next class='xo-announcement-bar__next'>
                <button type='button' class='xo-announcement-bar__nav-button' aria-label="{{ 'accessibility.next' | t }}">
                  {% render 'icon', name: 'arrow-right', size: 24 %}
                </button>
              </xo-carousel-next>
            </xo-carousel>
          </div>
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'button' %}
                <div class='xo-announcement-bar__item' style='order: {{ forloop.index }}' {{ block.shopify_attributes }}>
                  {% render 'button',
                    text: block.settings.button_text,
                    link: block.settings.button_link,
                    style: 'secondary',
                    size: 'xs',
                    radius: settings.button_radius,
                    padding: settings.button_padding
                  %}
                </div>
              {% when 'count-down' %}
                <div class='xo-announcement-bar__item' style='order: {{ forloop.index }}' {{ block.shopify_attributes }}>
                  {% render 'countdown', time: block.settings.time %}
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% elsif announcement_bar_style == 'marquee' %}
        <xo-marquee
          class='xo-announcement-bar__marquee'
          xo-speed='{{ marquee_speed }}'
          {% if marquee_rtl %}
            xo-rtl
          {% endif %}
          xo-pause-on-hover
        >
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'announcement' %}
                {% render 'announcement-text', block: block, announcement_bar_style: announcement_bar_style %}
            {% endcase %}
          {% endfor %}
        </xo-marquee>
      {% elsif announcement_bar_style == 'text-inline' %}
        <div class='xo-announcement-bar__inline'>
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'announcement' %}
                {% render 'announcement-text', block: block, announcement_bar_style: announcement_bar_style %}
              {% when 'button' %}
                <div class='xo-announcement-bar__item' {{ block.shopify_attributes }}>
                  {% render 'button',
                    text: block.settings.button_text,
                    link: block.settings.button_link,
                    style: 'secondary',
                    size: 'xs',
                    radius: settings.button_radius,
                    padding: settings.button_padding
                  %}
                </div>
              {% when 'count-down' %}
                <div class='xo-announcement-bar__item' {{ block.shopify_attributes }}>
                  {% render 'countdown', time: block.settings.time %}
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      {% endif %}
      {% if announcement_bar_style != 'marquee' %}
        </xo-container>
      {% endif %}
      {% if has_motion_control %}
        <button
          type='button'
          class='xo-announcement-bar__motion-toggle'
          aria-pressed='false'
          aria-label="{{ 'accessibility.pause' | t }}"
          data-announcement-motion-toggle
          data-label-pause="{{ 'accessibility.pause' | t | escape }}"
          data-label-play="{{ 'accessibility.play' | t | escape }}"
        >
          <span class='xo-announcement-bar__motion-icon xo-announcement-bar__motion-icon--pause' aria-hidden='true'>
            {% render 'icon', name: 'pause', size: 18 %}
          </span>
          <span class='xo-announcement-bar__motion-icon xo-announcement-bar__motion-icon--play' aria-hidden='true'>
            {% render 'icon', name: 'play', size: 18 %}
          </span>
        </button>
      {% endif %}
      {% if hide_button_close == 'on' %}
        <button
          type='button'
          class='xo-announcement-bar__button'
          id='xo-announcement-bar__button'
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class='xo-announcement-bar__icon' aria-hidden='true'>
            {% render 'icon', name: 'close', size: 24 %}
          </span>
        </button>
      {% endif %}
    </xo-animate>
  </section>
</div>

<script>
  (() => {
    const init = (root) => {
      if (root.dataset.announcementMotionReady === 'true') return;
      root.dataset.announcementMotionReady = 'true';

      const carousel = root.querySelector('.xo-announcement-bar__carousel');
      const marquee = root.querySelector('.xo-announcement-bar__marquee');
      const control = root.querySelector('[data-announcement-motion-toggle]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const autoplayEnabled = root.dataset.carouselAutoplay === 'true';
      const autoplaySpeed = root.dataset.carouselSpeed;
      let userPaused = reducedMotion.matches;
      let hoverPaused = false;
      let focusPaused = false;

      if (reducedMotion.matches) {
        carousel?.removeAttribute('xo-autoplay');
        marquee?.setAttribute('xo-paused', '');
      }

      const getCarouselList = () => carousel?.querySelector('xo-carousel-list');
      const isPaused = () => userPaused || hoverPaused || focusPaused;

      if (marquee) {
        new MutationObserver(() => {
          if (isPaused() && !marquee.hasAttribute('xo-paused')) {
            marquee.setAttribute('xo-paused', '');
          }
        }).observe(marquee, { attributes: true, attributeFilter: ['xo-paused'] });
      }

      const pause = () => {
        marquee?.setAttribute('xo-paused', '');
        if (typeof marquee?.handlePause === 'function') marquee.handlePause();
        const list = getCarouselList();
        if (typeof list?.pause === 'function') list.pause();
      };

      const play = () => {
        if (marquee) {
          marquee.removeAttribute('xo-paused');
          if (typeof marquee.handlePlay === 'function') marquee.handlePlay();
        }
        if (carousel && autoplayEnabled) {
          if (!carousel.hasAttribute('xo-autoplay')) {
            carousel.setAttribute('xo-autoplay', autoplaySpeed);
            if (typeof carousel.setOptions === 'function') carousel.setOptions();
            if (typeof carousel.setOptionsForStore === 'function') carousel.setOptionsForStore();
            const list = getCarouselList();
            if (typeof list?.setOptions === 'function') list.setOptions();
          }
          const list = getCarouselList();
          if (typeof list?.play === 'function') list.play();
        }
      };

      const sync = () => {
        const paused = isPaused();
        if (paused) {
          pause();
        } else {
          play();
        }
        if (control) {
          control.setAttribute('aria-pressed', String(paused));
          control.setAttribute('aria-label', paused ? control.dataset.labelPlay : control.dataset.labelPause);
          control.classList.toggle('is-paused', paused);
        }
      };

      control?.addEventListener('click', () => {
        userPaused = !userPaused;
        sync();
      });

      root.addEventListener('mouseenter', () => {
        hoverPaused = true;
        sync();
      });
      root.addEventListener('mouseleave', () => {
        hoverPaused = false;
        sync();
      });
      root.addEventListener('focusin', () => {
        focusPaused = true;
        sync();
      });
      root.addEventListener('focusout', (event) => {
        if (!root.contains(event.relatedTarget)) {
          focusPaused = false;
          sync();
        }
      });

      reducedMotion.addEventListener('change', (event) => {
        userPaused = event.matches;
        sync();
      });

      Promise.all([
        customElements.whenDefined('xo-carousel-list'),
        customElements.whenDefined('xo-marquee')
      ]).then(sync);
      sync();
    };

    document.querySelectorAll('[data-announcement-motion]').forEach(init);

    if (!window.nootropixAnnouncementMotionBound) {
      window.nootropixAnnouncementMotionBound = true;
      document.addEventListener('shopify:section:load', (event) => {
        event.target.querySelectorAll('[data-announcement-motion]').forEach(init);
      });
    }
  })();
</script>
{%- endunless -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "announcement_style",
      "label": "t:sections.announcement_bar.settings.announcement_style.label",
      "options": [
        {
          "value": "text-inline",
          "label": "t:sections.announcement_bar.settings.announcement_style.options_1.label"
        },
        {
          "value": "carousel",
          "label": "t:sections.announcement_bar.settings.announcement_style.options_2.label"
        },
        {
          "value": "marquee",
          "label": "t:sections.announcement_bar.settings.announcement_style.options_3.label"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "hide_button_close",
      "label": "t:sections.announcement_bar.settings.hide_button_close.label",
      "options": [
        {
          "value": "off",
          "label": "t:sections.announcement_bar.settings.hide_button_close.option__1.label"
        },
        {
          "value": "on",
          "label": "t:sections.announcement_bar.settings.hide_button_close.option__2.label"
        }
      ],
      "default": "off"
    },
    {
      "type": "header",
      "content": "t:sections.announcement_bar.settings.carousel_header.content"
    },
    {
      "type": "range",
      "id": "carousel_width",
      "label": "t:sections.announcement_bar.settings.carousel_width.label",
      "default": 400,
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "carousel_height",
      "label": "t:sections.announcement_bar.settings.carousel_height.label",
      "default": 24,
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "carousel_style",
      "label": "t:sections.announcement_bar.settings.carousel_style.label",
      "options": [
        {
          "value": "horizontal",
          "label": "t:sections.announcement_bar.settings.carousel_style.options_1.label"
        },
        {
          "value": "vertical",
          "label": "t:sections.announcement_bar.settings.carousel_style.options_2.label"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "t:sections.announcement_bar.settings.carousel_autoplay.label",
      "default": false
    },
    {
      "type": "number",
      "id": "carousel_speed",
      "label": "t:sections.announcement_bar.settings.carousel_speed.label",
      "default": 4000
    },
    {
      "type": "header",
      "content": "t:sections.announcement_bar.settings.marquee_header.content"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:sections.announcement_bar.settings.marquee_speed.label",
      "default": 6,
      "min": 1,
      "max": 20,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "marquee_rtl",
      "label": "t:sections.announcement_bar.settings.marquee_rtl.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "marquee_stop",
      "label": "t:sections.announcement_bar.settings.marquee_stop.label",
      "default": false,
      "visible_if": "{{ section.settings.announcement_style == 'legacy' }}"
    },
    {
      "type": "header",
      "content": "Weekend promo"
    },
    {
      "type": "checkbox",
      "id": "enable_weekend_promo",
      "label": "Enable weekend promo banner",
      "default": false
    },
    {
      "type": "text",
      "id": "weekend_promo_code",
      "label": "Promo code"
    },
    {
      "type": "text",
      "id": "weekend_discount_percent",
      "label": "Discount percent"
    },
    {
      "type": "header",
      "content": "General settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Section color scheme"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "number",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "default": 50
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement_bar.blocks.announcement.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.announcement_bar.blocks.announcement.settings.text.label",
          "default": "<p>Announce something here</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement_bar.blocks.announcement.settings.link.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.announcement_bar.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "default": "Button",
          "label": "t:sections.announcement_bar.blocks.button.settings.button_text.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.announcement_bar.blocks.button.settings.button_link.label"
        }
      ]
    },
    {
      "type": "count-down",
      "name": "t:sections.announcement_bar.blocks.count_down.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "time",
          "label": "t:sections.announcement_bar.blocks.count_down.settings.time.label",
          "info": "t:sections.announcement_bar.blocks.count_down.settings.time.info"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}