{% doc %}
  @prompt
    Design the final closing section for the NX-01 landing page.
    
    Use a large premium NX-01 bottle render with strong negative space.
    
    EYEBROW
    “NX-01 · BASELINE”
    
    HEADLINE
    “Stop rebuilding the foundation every morning.”
    
    SUBHEAD
    “9 actives. 3 capsules. One daily formula.”
    
    CTA
    “Start with NX-01”
    
    Secondary microcopy:
    30-day supply · caffeine-free
    
    This should visually echo the hero but feel like the conclusion of the page.
    
    Keep it minimal and confident.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-nx01-closing-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};overflow:hidden}
  .ai-nx01-closing-{{ ai_gen_id }}__inner{position:relative;min-height:{{ block.settings.section_height }}px;display:flex;align-items:center;justify-content:center;padding:80px 6vw}
  .ai-nx01-closing-{{ ai_gen_id }}__content{position:relative;z-index:2;width:min(100%,620px);margin-right:38%;text-align:{{ block.settings.text_alignment }}}
  .ai-nx01-closing-{{ ai_gen_id }}__eyebrow{margin:0 0 22px;color:{{ block.settings.eyebrow_color }};font-size:12px;font-weight:700;letter-spacing:.18em;line-height:1.4;text-transform:uppercase}
  .ai-nx01-closing-{{ ai_gen_id }}__heading{max-width:620px;margin:0;color:{{ block.settings.text_color }};font-size:clamp(38px,5vw,76px);font-weight:600;letter-spacing:-.055em;line-height:.98}
  .ai-nx01-closing-{{ ai_gen_id }}__subhead{margin:28px 0 0;color:{{ block.settings.subhead_color }};font-size:clamp(17px,1.6vw,23px);letter-spacing:-.02em;line-height:1.35}
  .ai-nx01-closing-{{ ai_gen_id }}__actions{display:flex;flex-wrap:wrap;align-items:center;gap:18px;margin-top:36px}
  .ai-nx01-closing-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:14px 26px;border:1px solid {{ block.settings.button_color }};border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font-size:14px;font-weight:700;letter-spacing:.02em;text-decoration:none;transition:opacity .2s ease}
  .ai-nx01-closing-{{ ai_gen_id }}__button:hover{opacity:.82}
  .ai-nx01-closing-{{ ai_gen_id }}__microcopy{margin:0;color:{{ block.settings.microcopy_color }};font-size:12px;letter-spacing:.08em;line-height:1.5;text-transform:uppercase}
  .ai-nx01-closing-{{ ai_gen_id }}__visual{position:absolute;top:50%;right:5%;z-index:1;width:min(48%,650px);transform:translateY(-50%)}
  .ai-nx01-closing-{{ ai_gen_id }}__visual img{display:block;width:100%;height:auto;max-height:{{ block.settings.image_max_height }}px;object-fit:contain;object-position:center}
  .ai-nx01-closing-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center;aspect-ratio:1 / 1.15;color:{{ block.settings.placeholder_color }}}
  .ai-nx01-closing-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;max-height:{{ block.settings.image_max_height }}px}
  @media screen and (max-width:749px){.ai-nx01-closing-{{ ai_gen_id }}__inner{min-height:0;padding:64px 24px 44px;display:flex;flex-direction:column}.ai-nx01-closing-{{ ai_gen_id }}__content{width:100%;margin-right:0;text-align:left}.ai-nx01-closing-{{ ai_gen_id }}__visual{position:relative;top:auto;right:auto;width:82%;margin:0 auto 34px;transform:none;order:-1}.ai-nx01-closing-{{ ai_gen_id }}__actions{align-items:flex-start;flex-direction:column}}
{% endstyle %}

<div class="ai-nx01-closing-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-nx01-closing-{{ ai_gen_id }}__inner">
    <div class="ai-nx01-closing-{{ ai_gen_id }}__visual">
      {% if block.settings.product_image %}<img src="{{ block.settings.product_image | image_url: width: 1400 }}" alt="{{ block.settings.product_image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.product_image.width }}" height="{{ block.settings.product_image.height }}">{% else %}<div class="ai-nx01-closing-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
    </div>
    <div class="ai-nx01-closing-{{ ai_gen_id }}__content">
      <p class="ai-nx01-closing-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>
      <h2 class="ai-nx01-closing-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
      <p class="ai-nx01-closing-{{ ai_gen_id }}__subhead">{{ block.settings.subhead }}</p>
      <div class="ai-nx01-closing-{{ ai_gen_id }}__actions">{% if block.settings.cta_link != blank %}<a class="ai-nx01-closing-{{ ai_gen_id }}__button" href="{{ block.settings.cta_link }}">{{ block.settings.cta_label }}</a>{% endif %}<p class="ai-nx01-closing-{{ ai_gen_id }}__microcopy">{{ block.settings.microcopy }}</p></div>
    </div>
  </div>
</div>

{% schema %}
{"name":"NX-01 closing section","settings":[{"type":"header","content":"Content"},{"type":"image_picker","id":"product_image","label":"Bottle render"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"NX-01 · BASELINE"},{"type":"text","id":"heading","label":"Headline","default":"Stop rebuilding the foundation every morning."},{"type":"text","id":"subhead","label":"Subhead","default":"9 actives. 3 capsules. One daily formula."},{"type":"text","id":"cta_label","label":"Button label","default":"Start with NX-01"},{"type":"url","id":"cta_link","label":"Button link"},{"type":"text","id":"microcopy","label":"Microcopy","default":"30-day supply · caffeine-free"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_height","label":"Section height","min":500,"max":1000,"step":50,"unit":"px","default":700},{"type":"range","id":"image_max_height","label":"Image height","min":300,"max":900,"step":50,"unit":"px","default":700},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#f9f9f9"},{"type":"color","id":"text_color","label":"Text","default":"#2a2a2a"},{"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#5a9d6f"},{"type":"color","id":"subhead_color","label":"Subhead","default":"#2a2a2a"},{"type":"color","id":"microcopy_color","label":"Microcopy","default":"#666666"},{"type":"color","id":"button_color","label":"Button","default":"#5a9d6f"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"placeholder_color","label":"Placeholder","default":"#d4d4d4"},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":30,"step":2,"unit":"px","default":6}],"presets":[{"name":"NX-01 closing section"}],"tag":null,"class":"nx01-closing-block"}
{% endschema %}