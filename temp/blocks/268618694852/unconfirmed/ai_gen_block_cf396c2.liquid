{% doc %}
  @prompt
    Design the primary NX-01 purchasing section.
    
    HEADLINE
    “Start with your baseline.”
    
    Create three purchase options:
    
    1 BOTTLE
    30 days
    Entry option
    
    2 BOTTLES
    60 days
    RECOMMENDED
    
    3 BOTTLES
    90 days
    BEST VALUE
    
    The 2-bottle option should be visually dominant.
    
    Each card should have:
    quantity
    days supplied
    price
    effective saving if applicable
    CTA
    
    Avoid aggressive discount styling.
    No bright red prices.
    No countdown clocks.
    
    Use subtle cobalt accents to indicate recommended / best value.
    
    Add:
    UAE delivery information
    return/support reassurance
    secure checkout cues
    
    Design sticky mobile add-to-cart behavior as part of this section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.nx-purchase-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;color:{{ block.settings.text_color }};background:{{ block.settings.background_color }};font-family:{{ block.settings.body_font.family }},sans-serif}.nx-purchase-{{ ai_gen_id }}__inner{max-width:1100px;margin:0 auto;padding:56px 24px 40px}.nx-purchase-{{ ai_gen_id }}__heading{margin:0 0 10px;font-family:{{ block.settings.heading_font.family }},sans-serif;font-size:clamp(32px,4vw,52px);line-height:1.05}.nx-purchase-{{ ai_gen_id }}__intro{margin:0 0 30px;color:{{ block.settings.muted_color }}}.nx-purchase-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.nx-purchase-{{ ai_gen_id }}__card{display:flex;flex-direction:column;padding:26px;border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.card_radius }}px;background:{{ block.settings.card_color }}}.nx-purchase-{{ ai_gen_id }}__card--featured{border:2px solid {{ block.settings.cobalt_color }};box-shadow:0 10px 28px rgba(20,64,140,.12);transform:translateY(-8px)}.nx-purchase-{{ ai_gen_id }}__badge{min-height:22px;margin:-8px 0 18px;color:{{ block.settings.cobalt_color }};font-size:12px;font-weight:700;text-transform:uppercase}.nx-purchase-{{ ai_gen_id }}__quantity{margin:0 0 7px;font-size:24px}.nx-purchase-{{ ai_gen_id }}__days{margin:0 0 24px;color:{{ block.settings.muted_color }}}.nx-purchase-{{ ai_gen_id }}__price{margin-top:auto;font-size:25px;font-weight:700}.nx-purchase-{{ ai_gen_id }}__saving{min-height:21px;margin:7px 0 20px;color:{{ block.settings.cobalt_color }};font-size:13px}.nx-purchase-{{ ai_gen_id }}__button{display:flex;align-items:center;justify-content:center;width:100%;min-height:50px;padding:12px 18px;border:0;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font:inherit;font-weight:700;cursor:pointer}.nx-purchase-{{ ai_gen_id }}__button:focus-visible{outline:3px solid {{ block.settings.cobalt_color }};outline-offset:3px}.nx-purchase-{{ ai_gen_id }}__trust{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px;padding-top:22px;border-top:1px solid {{ block.settings.border_color }};color:{{ block.settings.muted_color }};font-size:13px;text-align:center}.nx-purchase-{{ ai_gen_id }}__mobile-bar{display:none}@media(max-width:749px){.nx-purchase-{{ ai_gen_id }}__inner{padding:38px 16px 105px}.nx-purchase-{{ ai_gen_id }}__grid{grid-template-columns:1fr}.nx-purchase-{{ ai_gen_id }}__card--featured{transform:none}.nx-purchase-{{ ai_gen_id }}__trust{grid-template-columns:1fr;gap:9px}.nx-purchase-{{ ai_gen_id }}__mobile-bar{display:flex;position:fixed;z-index:20;right:0;bottom:0;left:0;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px calc(12px + env(safe-area-inset-bottom));background:{{ block.settings.card_color }};border-top:1px solid {{ block.settings.border_color }};box-shadow:0 -5px 18px rgba(0,0,0,.08)}.nx-purchase-{{ ai_gen_id }}__mobile-label{font-size:13px;font-weight:700}.nx-purchase-{{ ai_gen_id }}__mobile-bar .nx-purchase-{{ ai_gen_id }}__button{width:auto;min-width:150px}}{% endstyle %}
<nx-purchase-{{ ai_gen_id }} class="nx-purchase-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="nx-purchase-{{ ai_gen_id }}__inner"><h2 class="nx-purchase-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2><p class="nx-purchase-{{ ai_gen_id }}__intro">{{ block.settings.intro }}</p><div class="nx-purchase-{{ ai_gen_id }}__grid">{% for i in (1..3) %}{% assign product_key = 'product_' | append: i %}{% assign quantity_key = 'quantity_' | append: i %}{% assign days_key = 'days_' | append: i %}{% assign label_key = 'label_' | append: i %}{% assign saving_key = 'saving_' | append: i %}{% assign product = block.settings[product_key] %}<div class="nx-purchase-{{ ai_gen_id }}__card{% if i == 2 %} nx-purchase-{{ ai_gen_id }}__card--featured{% endif %}"><div class="nx-purchase-{{ ai_gen_id }}__badge">{{ block.settings[label_key] }}</div><h3 class="nx-purchase-{{ ai_gen_id }}__quantity">{{ block.settings[quantity_key] }}</h3><p class="nx-purchase-{{ ai_gen_id }}__days">{{ block.settings[days_key] }} days supplied</p>{% if product != blank %}<div class="nx-purchase-{{ ai_gen_id }}__price">{{ product.price | money_with_currency }}</div><div class="nx-purchase-{{ ai_gen_id }}__saving">{{ block.settings[saving_key] }}</div>{% form 'product', product %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="nx-purchase-{{ ai_gen_id }}__button" type="submit">{{ block.settings.cta_label }}</button>{% endform %}{% else %}<div class="nx-purchase-{{ ai_gen_id }}__price">Add a product</div><div class="nx-purchase-{{ ai_gen_id }}__saving">Configure this option in the editor.</div><button class="nx-purchase-{{ ai_gen_id }}__button" type="button" disabled>{{ block.settings.cta_label }}</button>{% endif %}</div>{% endfor %}</div><div class="nx-purchase-{{ ai_gen_id }}__trust"><span>{{ block.settings.delivery_text }}</span><span>{{ block.settings.support_text }}</span><span>{{ block.settings.checkout_text }}</span></div></div>{% assign featured_product = block.settings.product_2 %}{% if featured_product != blank %}<div class="nx-purchase-{{ ai_gen_id }}__mobile-bar"><span class="nx-purchase-{{ ai_gen_id }}__mobile-label">{{ block.settings.mobile_label }}</span>{% form 'product', featured_product %}<input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}"><button class="nx-purchase-{{ ai_gen_id }}__button" type="submit">{{ block.settings.cta_label }}</button>{% endform %}</div>{% endif %}</nx-purchase-{{ ai_gen_id }}>
{% schema %}{"name":"NX-01 purchase options","settings":[{"type":"text","id":"heading","label":"Headline","default":"Start with your baseline."},{"type":"textarea","id":"intro","label":"Intro","default":"Choose the supply that fits your routine."},{"type":"text","id":"cta_label","label":"CTA label","default":"Add to cart"},{"type":"text","id":"mobile_label","label":"Mobile label","default":"Recommended · 60 days"},{"type":"product","id":"product_1","label":"1 bottle product"},{"type":"text","id":"quantity_1","label":"Quantity 1","default":"1 bottle"},{"type":"text","id":"days_1","label":"Days 1","default":"30"},{"type":"text","id":"label_1","label":"Label 1","default":"Entry option"},{"type":"text","id":"saving_1","label":"Saving 1"},{"type":"product","id":"product_2","label":"2 bottle product"},{"type":"text","id":"quantity_2","label":"Quantity 2","default":"2 bottles"},{"type":"text","id":"days_2","label":"Days 2","default":"60"},{"type":"text","id":"label_2","label":"Label 2","default":"Recommended"},{"type":"text","id":"saving_2","label":"Saving 2","default":"Best balance for consistency"},{"type":"product","id":"product_3","label":"3 bottle product"},{"type":"text","id":"quantity_3","label":"Quantity 3","default":"3 bottles"},{"type":"text","id":"days_3","label":"Days 3","default":"90"},{"type":"text","id":"label_3","label":"Label 3","default":"Best value"},{"type":"text","id":"saving_3","label":"Saving 3","default":"Effective saving applied at checkout"},{"type":"text","id":"delivery_text","label":"Delivery","default":"UAE delivery available"},{"type":"text","id":"support_text","label":"Support","default":"Support and returns, made simple"},{"type":"text","id":"checkout_text","label":"Checkout","default":"Secure checkout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n6"},{"type":"font_picker","id":"body_font","label":"Body font","default":"inter_n4"},{"type":"color","id":"background_color","label":"Background","default":"#f9f9f9"},{"type":"color","id":"card_color","label":"Cards","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#1e1e1e"},{"type":"color","id":"muted_color","label":"Muted text","default":"#666666"},{"type":"color","id":"border_color","label":"Borders","default":"#e2e2e2"},{"type":"color","id":"cobalt_color","label":"Cobalt accent","default":"#135ab2"},{"type":"color","id":"button_color","label":"Button","default":"#1e1e1e"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"range","id":"card_radius","label":"Card radius","min":0,"max":24,"step":2,"unit":"px","default":8},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":4}],"presets":[{"name":"NX-01 purchase options"}],"tag":null,"class":"nx-01-purchase-block"}{% endschema %}