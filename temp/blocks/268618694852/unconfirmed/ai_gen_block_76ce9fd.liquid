{% doc %}
  @prompt
    Design a high-conversion comparison section for NX-01.
    
    HEADLINE
    “A good daily stack shouldn’t require a spreadsheet.”
    
    Create a premium comparison between assembling the foundation individually versus using NX-01.
    
    LEFT COLUMN
    “BUILD IT YOURSELF”
    
    Show:
    Acetyl-L-Carnitine
    CDP-Choline
    NMN
    L-Theanine
    Rhodiola
    Ubiquinol CoQ10
    active B vitamins
    
    Represent:
    multiple bottles
    multiple reorder points
    more complexity
    more decisions
    
    RIGHT COLUMN
    “NX-01”
    
    Show:
    9 actives
    3 capsules
    one daily formula
    one bottle
    30-day supply
    
    Do not turn this into a cheap red-X / green-check comparison table.
    
    Use sophisticated product imagery, typography and subtle line diagrams.
    
    Highlight the concept:
    “Same foundation. Less friction.”
    
    CTA below:
    “See What’s Inside”
    
    On mobile, stack the two states vertically as BEFORE → NX-01., i want to add a picture for the DIY/build it yourself as well 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-nx-comparison-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; padding:{{ block.settings.section_padding }}px 24px; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; }
  .ai-nx-comparison-{{ ai_gen_id }}__inner { max-width:1180px; margin:0 auto; }
  .ai-nx-comparison-{{ ai_gen_id }}__eyebrow { margin:0 0 18px; color:{{ block.settings.accent_color }}; font-size:12px; letter-spacing:.16em; text-transform:uppercase; font-weight:700; }
  .ai-nx-comparison-{{ ai_gen_id }}__heading { max-width:720px; margin:0 0 58px; font-family:{{ block.settings.heading_font.family }}; font-size:clamp(34px,5vw,68px); line-height:1.02; letter-spacing:-.045em; }
  .ai-nx-comparison-{{ ai_gen_id }}__states { display:grid; grid-template-columns:1fr 1fr; gap:24px; }
  .ai-nx-comparison-{{ ai_gen_id }}__state { position:relative; min-height:470px; padding:34px; overflow:hidden; border:1px solid {{ block.settings.border_color }}; border-radius:14px; }
  .ai-nx-comparison-{{ ai_gen_id }}__state--build { background:{{ block.settings.build_background }}; }
  .ai-nx-comparison-{{ ai_gen_id }}__state--nx { background:{{ block.settings.nx_background }}; border-color:{{ block.settings.accent_color }}; }
  .ai-nx-comparison-{{ ai_gen_id }}__label { display:flex; justify-content:space-between; gap:16px; align-items:center; margin-bottom:32px; font-size:12px; font-weight:700; letter-spacing:.13em; text-transform:uppercase; }
  .ai-nx-comparison-{{ ai_gen_id }}__label span:last-child { color:{{ block.settings.muted_color }}; font-size:11px; letter-spacing:.08em; }
  .ai-nx-comparison-{{ ai_gen_id }}__visual { height:190px; display:flex; align-items:center; justify-content:center; margin-bottom:28px; position:relative; }
  .ai-nx-comparison-{{ ai_gen_id }}__visual img { max-width:82%; max-height:190px; width:auto; height:auto; object-fit:contain; position:relative; z-index:2; }
  .ai-nx-comparison-{{ ai_gen_id }}__image-placeholder { width:100%; height:190px; display:flex; align-items:center; justify-content:center; background:#e7e4dc; color:#777; }
  .ai-nx-comparison-{{ ai_gen_id }}__image-placeholder svg { width:100%; height:100%; max-width:300px; }
  .ai-nx-comparison-{{ ai_gen_id }}__bottles { display:flex; align-items:end; gap:10px; height:150px; }
  .ai-nx-comparison-{{ ai_gen_id }}__bottle { width:42px; height:112px; background:linear-gradient(90deg,#b7b1a4,#f0ece2 48%,#a59e91); border-radius:5px 5px 11px 11px; box-shadow:8px 12px 20px rgba(42,42,42,.12); position:relative; }
  .ai-nx-comparison-{{ ai_gen_id }}__bottle:nth-child(2) { height:136px; }.ai-nx-comparison-{{ ai_gen_id }}__bottle:nth-child(3) { height:96px; }
  .ai-nx-comparison-{{ ai_gen_id }}__bottle:before { content:''; position:absolute; width:25px; height:16px; top:-12px; left:8px; border-radius:3px 3px 0 0; background:#6d6b64; }
  .ai-nx-comparison-{{ ai_gen_id }}__bottle:after { content:'NX'; position:absolute; left:7px; right:7px; top:44%; padding:4px 0; color:#5e5b54; background:#e8e1d4; text-align:center; font-size:9px; font-weight:700; }
  .ai-nx-comparison-{{ ai_gen_id }}__nx-mark { width:128px; height:168px; display:grid; place-items:center; border-radius:10px 10px 24px 24px; background:linear-gradient(90deg,#343b37,#68756d 48%,#252b28); color:#f7f4ec; font-family:{{ block.settings.heading_font.family }}; font-size:28px; box-shadow:18px 20px 30px rgba(42,42,42,.22); }
  .ai-nx-comparison-{{ ai_gen_id }}__lines { position:absolute; inset:20px 0; opacity:.45; background:linear-gradient(135deg,transparent 48%,{{ block.settings.accent_color }} 49%,transparent 50%),linear-gradient(35deg,transparent 48%,{{ block.settings.accent_color }} 49%,transparent 50%); background-size:100% 50%,100% 70%; }
  .ai-nx-comparison-{{ ai_gen_id }}__list { display:grid; gap:11px; margin:0; padding:0; list-style:none; }.ai-nx-comparison-{{ ai_gen_id }}__list li { display:flex; justify-content:space-between; gap:16px; padding-bottom:10px; border-bottom:1px solid {{ block.settings.border_color }}; font-size:14px; }.ai-nx-comparison-{{ ai_gen_id }}__list li span { color:{{ block.settings.muted_color }}; font-size:12px; }
  .ai-nx-comparison-{{ ai_gen_id }}__message { margin:44px 0 28px; text-align:center; font-family:{{ block.settings.heading_font.family }}; font-size:clamp(24px,3vw,38px); letter-spacing:-.035em; }.ai-nx-comparison-{{ ai_gen_id }}__cta-wrap { text-align:center; }.ai-nx-comparison-{{ ai_gen_id }}__cta { display:inline-flex; align-items:center; justify-content:center; min-height:52px; padding:0 28px; border-radius:999px; background:{{ block.settings.button_color }}; color:{{ block.settings.button_text_color }}; text-decoration:none; font-size:13px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  @media screen and (max-width:749px) { .ai-nx-comparison-{{ ai_gen_id }} { padding:56px 18px; }.ai-nx-comparison-{{ ai_gen_id }}__heading { margin-bottom:36px; }.ai-nx-comparison-{{ ai_gen_id }}__states { grid-template-columns:1fr; gap:14px; }.ai-nx-comparison-{{ ai_gen_id }}__state { min-height:auto; padding:26px; }.ai-nx-comparison-{{ ai_gen_id }}__visual { height:155px; }.ai-nx-comparison-{{ ai_gen_id }}__image-placeholder { height:155px; } }
{% endstyle %}

<div class="ai-nx-comparison-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-nx-comparison-{{ ai_gen_id }}__inner">
    <p class="ai-nx-comparison-{{ ai_gen_id }}__eyebrow">NX-01 / The daily foundation</p>
    <h2 class="ai-nx-comparison-{{ ai_gen_id }}__heading">{{ block.settings.headline }}</h2>
    <div class="ai-nx-comparison-{{ ai_gen_id }}__states">
      <article class="ai-nx-comparison-{{ ai_gen_id }}__state ai-nx-comparison-{{ ai_gen_id }}__state--build">
        <div class="ai-nx-comparison-{{ ai_gen_id }}__label"><span>Build it yourself</span><span>More moving parts</span></div>
        <div class="ai-nx-comparison-{{ ai_gen_id }}__visual">
          {% if block.settings.build_image %}<img src="{{ block.settings.build_image | image_url: width: 900 }}" alt="{{ block.settings.build_image.alt | escape }}" loading="lazy" width="900" height="600">{% else %}<div class="ai-nx-comparison-{{ ai_gen_id }}__image-placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
        </div>
        <ul class="ai-nx-comparison-{{ ai_gen_id }}__list"><li>Acetyl-L-Carnitine <span>one of many</span></li><li>CDP-Choline <span>another bottle</span></li><li>NMN <span>another reorder</span></li><li>L-Theanine <span>more decisions</span></li><li>Rhodiola + Ubiquinol CoQ10 <span>keep track</span></li><li>Active B vitamins <span>more complexity</span></li></ul>
      </article>
      <article class="ai-nx-comparison-{{ ai_gen_id }}__state ai-nx-comparison-{{ ai_gen_id }}__state--nx">
        <div class="ai-nx-comparison-{{ ai_gen_id }}__label"><span>NX-01</span><span>One considered formula</span></div>
        <div class="ai-nx-comparison-{{ ai_gen_id }}__visual">{% if block.settings.product != blank and block.settings.product.featured_image %}<img src="{{ block.settings.product.featured_image | image_url: width: 500 }}" alt="{{ block.settings.product.title | escape }}" loading="lazy" width="500" height="500">{% else %}<div class="ai-nx-comparison-{{ ai_gen_id }}__nx-mark">NX-01</div>{% endif %}</div>
        <ul class="ai-nx-comparison-{{ ai_gen_id }}__list"><li>9 actives <span>precisely assembled</span></li><li>3 capsules <span>one daily serving</span></li><li>One daily formula <span>less friction</span></li><li>One bottle <span>easy to keep close</span></li><li>30-day supply <span>simple rhythm</span></li></ul>
      </article>
    </div>
    <p class="ai-nx-comparison-{{ ai_gen_id }}__message">{{ block.settings.message }}</p>
    <div class="ai-nx-comparison-{{ ai_gen_id }}__cta-wrap"><a class="ai-nx-comparison-{{ ai_gen_id }}__cta" href="{{ block.settings.cta_link }}">{{ block.settings.cta_label }}</a></div>
  </div>
</div>

{% schema %}
{"name":"NX-01 comparison","settings":[{"type":"header","content":"Content"},{"type":"text","id":"headline","label":"Headline","default":"A good daily stack shouldn’t require a spreadsheet."},{"type":"text","id":"message","label":"Message","default":"Same foundation. Less friction."},{"type":"text","id":"cta_label","label":"Button label","default":"See What’s Inside"},{"type":"url","id":"cta_link","label":"Button link"},{"type":"image_picker","id":"build_image","label":"DIY image"},{"type":"product","id":"product","label":"NX-01 product"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding","label":"Section padding","min":20,"max":120,"step":10,"unit":"px","default":80},{"type":"header","content":"Style"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"inter_n6"},{"type":"color","id":"background_color","label":"Background","default":"#f9f9f9"},{"type":"color","id":"build_background","label":"Build panel","default":"#f0f0f0"},{"type":"color","id":"nx_background","label":"NX-01 panel","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#2a2a2a"},{"type":"color","id":"muted_color","label":"Muted text","default":"#666666"},{"type":"color","id":"border_color","label":"Border","default":"#e8e8e8"},{"type":"color","id":"accent_color","label":"Accent","default":"#5a9d6f"},{"type":"color","id":"button_color","label":"Button","default":"#5a9d6f"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"}],"presets":[{"name":"NX-01 comparison"}],"tag":null,"class":"nx-01-comparison-block"}
{% endschema %}