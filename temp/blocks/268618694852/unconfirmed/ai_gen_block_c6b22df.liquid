{% doc %}
  @prompt
    Design the hero section for the dedicated NX-01 launch landing page.
    
    PRIMARY OBJECTIVE
    Immediately communicate that NX-01 is Nootropix’s first flagship daily formula and make the product feel like a major brand milestone.
    
    EYEBROW
    “INTRODUCING NX-01 · BASELINE”
    
    HEADLINE
    “We finally built our own nootropic.”
    
    SUBHEAD
    “A caffeine-free daily cognitive foundation built from 9 complementary actives — in 3 capsules.”
    
    PRIMARY CTA
    “Shop NX-01”
    
    SECONDARY CTA
    “Explore the Formula”
    
    PRODUCT FACTS
    9 actives
    3 capsules daily
    30-day bottle
    0 mg caffeine
    
    VISUAL DIRECTION
    Feature a large photorealistic cobalt-blue NX-01 bottle as the dominant object.
    Use premium studio-product photography styling:
    - dark architectural background
    - controlled reflections
    - subtle depth
    - strong negative space
    - bottle should look tangible and premium rather than digitally futuristic
    
    Add a restrained scroll cue or formula preview below the fold.
    
    Desktop should use a strong asymmetric composition.
    Mobile should put headline first, bottle second, CTA immediately visible.
    
    Do not overcrowd the hero.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.nx-hero-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};overflow:hidden}.nx-hero-{{ ai_gen_id }}__inner{position:relative;display:grid;grid-template-columns:minmax(0,.92fr) minmax(360px,1.08fr);align-items:center;min-height:{{ block.settings.hero_height }}px;max-width:1600px;margin:0 auto;padding:72px 7vw 48px;isolation:isolate}.nx-hero-{{ ai_gen_id }}__inner:before{content:'';position:absolute;width:48%;aspect-ratio:1;right:4%;top:8%;border-radius:50%;background:{{ block.settings.glow_color }};opacity:.18;filter:blur(70px);z-index:-1}.nx-hero-{{ ai_gen_id }}__content{position:relative;z-index:2;max-width:620px;padding:32px 0}.nx-hero-{{ ai_gen_id }}__eyebrow{margin:0 0 24px;color:{{ block.settings.accent_color }};font-size:12px;font-weight:700;letter-spacing:.16em;line-height:1.4;text-transform:uppercase}.nx-hero-{{ ai_gen_id }}__heading{margin:0;max-width:650px;color:{{ block.settings.text_color }};font-size:clamp(42px,5.4vw,86px);font-weight:700;letter-spacing:-.055em;line-height:.98}.nx-hero-{{ ai_gen_id }}__subhead{max-width:500px;margin:28px 0 0;color:{{ block.settings.muted_text_color }};font-size:17px;line-height:1.55}.nx-hero-{{ ai_gen_id }}__actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}.nx-hero-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:13px 24px;border:1px solid {{ block.settings.primary_button_color }};border-radius:{{ block.settings.button_radius }}px;font-size:14px;font-weight:700;letter-spacing:.02em;text-decoration:none;transition:opacity .2s ease,transform .2s ease}.nx-hero-{{ ai_gen_id }}__button:hover{opacity:.82;transform:translateY(-1px)}.nx-hero-{{ ai_gen_id }}__button:focus-visible,.nx-hero-{{ ai_gen_id }}__scroll:focus-visible{outline:3px solid {{ block.settings.focus_color }};outline-offset:4px}.nx-hero-{{ ai_gen_id }}__button--primary{background:{{ block.settings.primary_button_color }};color:{{ block.settings.primary_button_text_color }}}.nx-hero-{{ ai_gen_id }}__button--secondary{background:transparent;border-color:{{ block.settings.secondary_button_border_color }};color:{{ block.settings.text_color }}.nx-hero-{{ ai_gen_id }}__facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;max-width:560px;margin-top:56px;padding-top:20px;border-top:1px solid {{ block.settings.divider_color }}}.nx-hero-{{ ai_gen_id }}__fact-value,.nx-hero-{{ ai_gen_id }}__fact-label{display:block}.nx-hero-{{ ai_gen_id }}__fact-value{color:{{ block.settings.text_color }};font-size:20px;font-weight:700;letter-spacing:-.02em}.nx-hero-{{ ai_gen_id }}__fact-label{margin-top:5px;color:{{ block.settings.muted_text_color }};font-size:11px;line-height:1.3;text-transform:uppercase;letter-spacing:.08em}.nx-hero-{{ ai_gen_id }}__visual{position:relative;display:flex;align-items:center;justify-content:center;min-height:560px}.nx-hero-{{ ai_gen_id }}__visual:after{content:'';position:absolute;bottom:12%;left:18%;width:64%;height:8%;border-radius:50%;background:#000;opacity:.6;filter:blur(24px)}.nx-hero-{{ ai_gen_id }}__image{position:relative;z-index:1;display:block;width:min(100%,570px);height:auto;max-height:650px;object-fit:contain}.nx-hero-{{ ai_gen_id }}__placeholder{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;width:min(100%,570px);aspect-ratio:4/5;border:1px solid #475569;background:#142033;color:#94a3b8}.nx-hero-{{ ai_gen_id }}__placeholder svg{width:55%;height:55%;opacity:.45}.nx-hero-{{ ai_gen_id }}__empty-state{position:absolute;bottom:24px;left:24px;right:24px;color:#cbd5e1;font-size:13px;text-align:center}.nx-hero-{{ ai_gen_id }}__scroll{position:absolute;right:7vw;bottom:30px;display:inline-flex;align-items:center;gap:9px;border:0;padding:5px;background:transparent;color:{{ block.settings.muted_text_color }};cursor:pointer;font-size:11px;letter-spacing:.12em;text-transform:uppercase}.nx-hero-{{ ai_gen_id }}__scroll-line{display:block;width:34px;height:1px;background:{{ block.settings.muted_text_color }}}
@media screen and (max-width:749px){.nx-hero-{{ ai_gen_id }}__inner{display:flex;flex-direction:column;align-items:stretch;min-height:auto;padding:48px 22px 34px}.nx-hero-{{ ai_gen_id }}__content{padding:0}.nx-hero-{{ ai_gen_id }}__eyebrow{margin-bottom:18px}.nx-hero-{{ ai_gen_id }}__heading{font-size:clamp(42px,12vw,64px)}.nx-hero-{{ ai_gen_id }}__subhead{margin-top:20px;font-size:16px}.nx-hero-{{ ai_gen_id }}__actions{margin-top:26px}.nx-hero-{{ ai_gen_id }}__button{flex:1 1 190px}.nx-hero-{{ ai_gen_id }}__visual{order:2;min-height:390px;margin-top:20px}.nx-hero-{{ ai_gen_id }}__image,.nx-hero-{{ ai_gen_id }}__placeholder{width:min(100%,390px)}.nx-hero-{{ ai_gen_id }}__facts{gap:12px;margin-top:36px}.nx-hero-{{ ai_gen_id }}__fact-value{font-size:16px}.nx-hero-{{ ai_gen_id }}__fact-label{font-size:9px}.nx-hero-{{ ai_gen_id }}__scroll{position:static;align-self:center;margin-top:18px}}
{% endstyle %}
<nx-hero-{{ ai_gen_id }} class="nx-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="nx-hero-{{ ai_gen_id }}__inner"><div class="nx-hero-{{ ai_gen_id }}__content"><p class="nx-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p><h1 class="nx-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h1><p class="nx-hero-{{ ai_gen_id }}__subhead">{{ block.settings.subhead }}</p><div class="nx-hero-{{ ai_gen_id }}__actions"><a class="nx-hero-{{ ai_gen_id }}__button nx-hero-{{ ai_gen_id }}__button--primary" href="{{ block.settings.primary_link }}">{{ block.settings.primary_label }}</a><a class="nx-hero-{{ ai_gen_id }}__button nx-hero-{{ ai_gen_id }}__button--secondary" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label }}</a></div><div class="nx-hero-{{ ai_gen_id }}__facts" aria-label="NX-01 product facts"><div><span class="nx-hero-{{ ai_gen_id }}__fact-value">9</span><span class="nx-hero-{{ ai_gen_id }}__fact-label">Actives</span></div><div><span class="nx-hero-{{ ai_gen_id }}__fact-value">3</span><span class="nx-hero-{{ ai_gen_id }}__fact-label">Capsules daily</span></div><div><span class="nx-hero-{{ ai_gen_id }}__fact-value">30</span><span class="nx-hero-{{ ai_gen_id }}__fact-label">Day bottle</span></div><div><span class="nx-hero-{{ ai_gen_id }}__fact-value">0 mg</span><span class="nx-hero-{{ ai_gen_id }}__fact-label">Caffeine</span></div></div></div><div class="nx-hero-{{ ai_gen_id }}__visual">{% if block.settings.product_image %}<img class="nx-hero-{{ ai_gen_id }}__image" src="{{ block.settings.product_image | image_url: width: 1200 }}" alt="{{ block.settings.product_image.alt | default: 'NX-01 cobalt-blue bottle' | escape }}" loading="eager" width="{{ block.settings.product_image.width }}" height="{{ block.settings.product_image.height }}">{% else %}<div class="nx-hero-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}<span class="nx-hero-{{ ai_gen_id }}__empty-state">Add the NX-01 bottle image in the block settings.</span></div>{% endif %}</div><a class="nx-hero-{{ ai_gen_id }}__scroll" href="{{ block.settings.scroll_link }}" aria-label="{{ block.settings.scroll_label }}"><span class="nx-hero-{{ ai_gen_id }}__scroll-line"></span>{{ block.settings.scroll_label }}</a></div></nx-hero-{{ ai_gen_id }}>
{% schema %}{"name":"NX-01 launch hero","tag":null,"class":"nx-01-launch-hero","settings":[{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"INTRODUCING NX-01 · BASELINE"},{"type":"text","id":"heading","label":"Headline","default":"We finally built our own nootropic"},{"type":"textarea","id":"subhead","label":"Subhead","default":"A caffeine-free daily cognitive foundation built from 9 complementary actives — in 3 capsules."},{"type":"text","id":"primary_label","label":"Primary label","default":"Shop NX-01"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary label","default":"Explore the Formula"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"scroll_label","label":"Scroll label","default":"Discover the formula"},{"type":"url","id":"scroll_link","label":"Scroll link"},{"type":"header","content":"Product visual"},{"type":"image_picker","id":"product_image","label":"NX-01 bottle image"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"hero_height","label":"Hero height","min":500,"max":900,"step":25,"unit":"px","default":725},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":2},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#0b111c"},{"type":"color","id":"text_color","label":"Text","default":"#f8fafc"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#cbd5e1"},{"type":"color","id":"accent_color","label":"Accent","default":"#7dd3fc"},{"type":"color","id":"glow_color","label":"Glow","default":"#2563eb"},{"type":"color","id":"divider_color","label":"Divider","default":"#334155"},{"type":"color","id":"primary_button_color","label":"Primary button","default":"#fbbf24"},{"type":"color","id":"primary_button_text_color","label":"Primary button text","default":"#1e1e1e"},{"type":"color","id":"secondary_button_border_color","label":"Secondary border","default":"#94a3b8"},{"type":"color","id":"focus_color","label":"Focus outline","default":"#fbbf24"}],"presets":[{"name":"NX-01 launch hero"}]}{% endschema %}